$PBExportHeader$get_max_code_datawindow.srf
global type get_max_code_datawindow from function_object
end type

forward prototypes
global function double get_max_code_datawindow (datawindow dw, string colonne)
end prototypes

global function double get_max_code_datawindow (datawindow dw, string colonne);

// Renvoie, en numérique, la valeur maximale trouver dans la colonne qui est en string

long nb_lig, cpt_lig
double valeur_max = 0

nb_lig = dw.rowcount()

for cpt_lig= 1 to nb_lig
	
	if not isnull (dw.getitemstring(cpt_lig,colonne)) then
		valeur_max = max ( valeur_max, double(dw.getitemstring(cpt_lig,colonne)) )
	end if
	
next

return valeur_max

end function

