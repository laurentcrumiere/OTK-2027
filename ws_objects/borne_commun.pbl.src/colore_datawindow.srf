$PBExportHeader$colore_datawindow.srf
global type colore_datawindow from function_object
end type

forward prototypes
global subroutine colore_datawindow (datawindow dw)
end prototypes

global subroutine colore_datawindow (datawindow dw);////////////////////////////////////////////////////////////////////////////////////////////////////

// Applique les couleurs utilisateurs à une datawindow



// On applique le brush et le dégradé que si le mot clef "BRUSH" dans le tag

if pos(dw.tag,"brush",1) > 0 and len(trim(dw.DataObject)) > 0 then
	dw.object.DataWindow.color = couleur_fond_datawindow
	dw.object.DataWindow.brushmode = brush_datawindow
	dw.object.DataWindow.gradient.color = couleur_degrade_datawindow
end if


return
end subroutine

