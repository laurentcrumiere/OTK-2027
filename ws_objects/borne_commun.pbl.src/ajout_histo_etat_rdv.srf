global subroutine ajout_histo_etat_rdv (double code_interne, string etat);


// Mise en historique des éditions
// Automatiquement nom de l'utilisateur


INSERT INTO "historique_etat_rdv"  
         ( "code_interne",              "etat",                "date_modif" , 			  "user_modif",			  )  
  VALUES ( :code_interne,   :etat,				 getdate(),						 :utilisateur_code			)  ;
			  			  
if sqlca.sqlcode <> 0 then
	MessageBox("Problème d'ajout dans Historique des Etats de RDV",Sqlca.sqlerrtext)	
	rollback ;

else
	commit ;
end if

// Envoi de l'information de l'état à my Orthokis si Dental SMS
