$PBExportHeader$centrer.srf
$PBExportComments$Shani 1.0 / Centre une fenêtre de type Message
global type centrer from function_object
end type

forward prototypes
global subroutine centrer (window fenetre)
end prototypes

global subroutine centrer (window fenetre);// Centre une fenêtre 

// pour eviter les pb de raffraissement
fenetre.hide()

double haut,larg
environment env

GetEnvironment(env)
	
// Récupération de la taille de l'écran
larg = PixelsToUnits(env.ScreenWidth,XPixelsToUnits!)
haut = PixelsToUnits(env.ScreenHeight,YPixelsToUnits!)



// Ajustement de la fenêtre au centre de l'écran
fenetre.x = (larg - fenetre.Width) / 2
fenetre.y = (haut - fenetre.Height) / 2


// pour eviter les pb de raffraissement
fenetre.show()


end subroutine

