table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(35) updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(6) updatewhereclause=yes name=pays_parent1 dbname="patient.pays_parent1" dbalias=".pays_parent1" )
 column=(type=char(1) updatewhereclause=yes name=sexe dbname="patient.sexe" dbalias=".sexe" values="Masculin	M/Féminin	F/" )
 column=(type=date updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=char(100) updatewhereclause=yes name=email dbname="patient.email" dbalias=".email" )
 column=(type=char(25) updatewhereclause=yes name=portable dbname="patient.portable" dbalias=".portable" )
 column=(type=char(25) updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(30) updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 retrieve="  SELECT ~"patient~".~"nom~",   
         ~"patient~".~"adr1_parent1~",   
         ~"patient~".~"codep_parent1~",   
         ~"patient~".~"ville_parent1~",   
         ~"patient~".~"pays_parent1~",   
         ~"patient~".~"sexe~",   
         ~"patient~".~"date_naissance~",   
         ~"patient~".~"email~",   
         ~"patient~".~"portable~",   
         ~"patient~".~"teldom_parent1~",   
         ~"patient~".~"prenom~"  
    FROM ~"patient~"  
   WHERE ~"patient~".~"code~" = :v_code_patient    
" arguments=(("v_code_patient", number)) )
