 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mutuelle~" ) COLUMN(NAME=~"mutuelle.code~") COLUMN(NAME=~"mutuelle.nom~") COLUMN(NAME=~"mutuelle.adr1~") COLUMN(NAME=~"mutuelle.adr2~") COLUMN(NAME=~"mutuelle.codep~") COLUMN(NAME=~"mutuelle.ville~") COLUMN(NAME=~"mutuelle.tel~") COLUMN(NAME=~"mutuelle.fax~") COLUMN(NAME=~"mutuelle.contact1~") COLUMN(NAME=~"mutuelle.contact2~") COLUMN(NAME=~"mutuelle.commentaires~") COLUMN(NAME=~"mutuelle.ordre_trie~") COLUMN(NAME=~"mutuelle.pays~") COLUMN(NAME=~"mutuelle.actif~") COLUMN(NAME=~"mutuelle.email1~") COLUMN(NAME=~"mutuelle.email2~")WHERE(    EXP1 =~"~~~"mutuelle~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) " update="mutuelle" updatewhere=1 updatekeyinplace=no  sort="ordre_trie A nom A " )
