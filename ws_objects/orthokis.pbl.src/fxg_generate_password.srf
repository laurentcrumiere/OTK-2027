global type fxg_generate_password from function_object
end type

forward prototypes
global function string fxg_generate_password ()
end prototypes

global function string fxg_generate_password ();string ls_chars, ls_password
long ll_len, ll_i, ll_pos, ll_char_count
double ld_rand

// Jeux de caractères autorisés
ls_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&*()_+"
ll_char_count = Len(ls_chars)

// Initialisation du générateur de nombres aléatoires
Randomize(0)

ls_password = ""
ll_len = 10 // Longueur souhaitée

for ll_i = 1 to ll_len
    // Génération d'une valeur aléatoire entre 1 et ll_char_count
    ld_rand = Rand(ll_char_count)
    ll_pos = Long(ld_rand)
    
    // Cas limite : Rand(n) peut renvoyer 0
    if ll_pos < 1 then ll_pos = 1
    
    // Concaténation du caractère sélectionné
    ls_password += Mid(ls_chars, ll_pos, 1)
next

return ls_password

end function

