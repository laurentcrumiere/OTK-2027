end prototypes

global function string string_to_rtf (string chaine_brute, double couleur_texte, double couleur_fond);// Convertit un texte brut en string au format RTF

string constante_rtf_totale = "{\rtf1\ansi\ansicpg1252\uc1\deff0{\fonttbl{\f0\fswiss\fcharset0\fprq2 Arial;}{\f1\fswiss\fcharset0\fprq2 Tahoma;}{\f2\froman\fcharset2\fprq2 Symbol;}}{\colortbl;\red0\green0\blue0;\red255\green255\blue255;}{\stylesheet{\s0\itap0\nowidctlpar\f0\fs24 [Normal];}{\*\cs10\additive Default Paragraph Font;}}{\*\generator TX_RTF32 13.0.501.502;}\deftab1134\paperw11580\paperh16838\margl0\margt0\margr0\margb0\widowctrl{\*\background{\shp{\*\shpinst\shpleft0\shptop0\shpright0\shpbottom0\shpfhdr0\shpbxmargin\shpbxignore\shpbymargin\shpbyignore\shpwr0\shpwrk0\shpfblwtxt1\shplid1025{\sp{\sn shapeType}{\sv 1}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn fillColor}{\sv 16777215}}{\sp{\sn fFilled}{\sv 1}}{\sp{\sn lineWidth}{\sv 0}}{\sp{\sn fLine}{\sv 0}}{\sp{\sn fBackground}{\sv 1}}{\sp{\sn fLayoutInCell}{\sv 1}}}}}\pard\itap0\nowidctlpar\plain\f1\fs20 "
string constante_rtf_part1 = "{\rtf1\ansi\ansicpg1252\uc1\deff0{\fonttbl{\f0\fswiss\fcharset0\fprq2 Arial;}{\f1\fswiss\fcharset0\fprq2 Tahoma;}{\f2\froman\fcharset2\fprq2 Symbol;}}{\colortbl;\red0\green0\blue0;\red255\green255\blue255;"
string constante_rtf_part2 = "}{\stylesheet{\s0\itap0\nowidctlpar\f0\fs24 [Normal];}{\*\cs10\additive Default Paragraph Font;}}{\*\generator TX_RTF32 13.0.501.502;}\deftab1134\paperw11580\paperh16838\margl0\margt0\margr0\margb0\widowctrl{\*\background{\shp{\*\shpinst\shpleft0\shptop0\shpright0\shpbottom0\shpfhdr0\shpbxmargin\shpbxignore\shpbymargin\shpbyignore\shpwr0\shpwrk0\shpfblwtxt1\shplid1025{\sp{\sn shapeType}{\sv 1}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn fillColor}{\sv 16777215}}{\sp{\sn fFilled}{\sv 1}}{\sp{\sn lineWidth}{\sv 0}}{\sp{\sn fLine}{\sv 0}}{\sp{\sn fBackground}{\sv 1}}{\sp{\sn fLayoutInCell}{\sv 1}}}}}"
string constante_rtf_part3 = " "



long v_r, v_g, v_b
string string_couleur1
string string_couleur2

string chaine_rtf

if isnull(chaine_rtf) then
	chaine_rtf = ''
end if

// Il faut remplacer les reoturs à la ligne et les "\"
chaine_rtf = gfx_tout_remplacer(chaine_brute,  "\" , "\\")
chaine_rtf = gfx_tout_remplacer(chaine_rtf,  char(10) , "\par ")
chaine_rtf = gfx_tout_remplacer(chaine_rtf,  char(13) , "")

// Ajout des constantes RTF pour la couleur de Texte
if couleur_texte = 0 then
	string_couleur1 = ""
	string_couleur2 = ""
else
	// faut transformer la coureur en RGB
	
	v_b = int(couleur_texte / 65536)
	v_g = int( (couleur_texte - v_b * 65536) / 256) 
	v_r = couleur_texte - v_b * 65536 - v_g * 256
	string_couleur1 = "\red"+string(v_r)+"\green"+string(v_g)+"\blue"+string(v_b)+";"
	string_couleur2 = "\cf3"
end if


// Ajout des constantes RTF pour la couleur de Fond
if couleur_fond <> 0 then
	// faut transformer la coureur en RGB
	v_b = int(couleur_fond / 65536)
	v_g = int( (couleur_fond - v_b * 65536) / 256) 
	v_r = couleur_fond - v_b * 65536 - v_g * 256
	string_couleur1 = string_couleur1 +  "\red"+string(v_r)+"\green"+string(v_g)+"\blue"+string(v_b)+";"
	if couleur_texte = 0 then
		string_couleur2 = "\cb3"
	else
		string_couleur2 = string_couleur2 + "\cb4"
	end if
end if



chaine_rtf  = constante_rtf_part1 + string_couleur1 + constante_rtf_part2 + string_couleur2 + constante_rtf_part3 + chaine_rtf + "}"

if isnull(chaine_rtf) then
	chaine_rtf = ''
end if


return chaine_rtf





end function

