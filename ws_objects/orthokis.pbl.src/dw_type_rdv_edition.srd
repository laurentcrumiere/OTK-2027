 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"famille_rdv~" )  TABLE(NAME=~"type_rdv~" ) COLUMN(NAME=~"type_rdv.code~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"type_rdv.duree~") COLUMN(NAME=~"type_rdv.fauteuil~") COLUMN(NAME=~"type_rdv.symbole~") COLUMN(NAME=~"famille_rdv.nom~") COMPUTE(NAME=~"cast ( ~~~"type_rdv~~~".~~~"couleur~~~" as double) as couleur_double~") COLUMN(NAME=~"type_rdv.ordre_trie~") COMPUTE(NAME=~"(select top 1 nom as nom_famille from famille_rdv,type_rdv_famille where type_rdv.code = type_rdv_famille.code_type_rdv and type_rdv_famille.code_famille_rdv = famille_rdv.code order by ordre_trie, nom )~") COMPUTE(NAME=~"(select top 1 couleur as couleur_famille from famille_rdv,type_rdv_famille where type_rdv.code = type_rdv_famille.code_type_rdv and type_rdv_famille.code_famille_rdv = famille_rdv.code order by ordre_trie, nom )~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"type_rdv.famille~") COLUMN(NAME=~"type_rdv.actif~") COLUMN(NAME=~"type_rdv.modif_auto_dossier~") COLUMN(NAME=~"type_rdv.etat_modif_dossier~") COLUMN(NAME=~"type_rdv.type_dossier~") COLUMN(NAME=~"type_rdv.envoi_sms~") COLUMN(NAME=~"type_rdv.message_sms~") COLUMN(NAME=~"type_rdv.duree_assistante_1~") COLUMN(NAME=~"type_rdv.duree_praticien_1~") COLUMN(NAME=~"type_rdv.duree_assistante_2~") COLUMN(NAME=~"type_rdv.supprime_auto_alerte~") COLUMN(NAME=~"type_rdv.etat_supprime_alerte~") COLUMN(NAME=~"type_rdv.alerte~") COLUMN(NAME=~"type_rdv.code_praticien~") COLUMN(NAME=~"type_rdv.nb_rdv_maxi~") COLUMN(NAME=~"type_rdv.nb_rdv_bloquant~") COLUMN(NAME=~"type_rdv.nb_rdv_pour_tous~") COLUMN(NAME=~"type_rdv.ajout_soin~") COLUMN(NAME=~"type_rdv.ajout_soin_code~") COLUMN(NAME=~"type_rdv.modif_auto_date~") COLUMN(NAME=~"type_rdv.etat_modif_date~") COLUMN(NAME=~"type_rdv.modif_date_moulage~") COLUMN(NAME=~"type_rdv.modif_date_premiere_demande~") COLUMN(NAME=~"type_rdv.modif_date_debut_traitement~") COLUMN(NAME=~"type_rdv.modif_date_interruption~") COLUMN(NAME=~"type_rdv.modif_date_reprise~") COLUMN(NAME=~"type_rdv.modif_date_fin_traitement~") COLUMN(NAME=~"type_rdv.message_salle_attente~") COLUMN(NAME=~"type_rdv.message_addulte_salle_attente~") COLUMN(NAME=~"type_rdv.modif_duree~") COLUMN(NAME=~"type_rdv.enfant_adulte~") COLUMN(NAME=~"type_rdv.nb_rdv_maxi_mensuel~") COLUMN(NAME=~"type_rdv.nb_rdv_maxi_jour~") COLUMN(NAME=~"type_rdv.modif_fauteuil~") COLUMN(NAME=~"type_rdv.alerte_modif_fauteuil~") COLUMN(NAME=~"type_rdv.unite_proc_rdv~") COLUMN(NAME=~"type_rdv.nb_proc_rdv~") COLUMN(NAME=~"type_rdv.blocages~") COLUMN(NAME=~"type_rdv.envoi_email~") COLUMN(NAME=~"type_rdv.message_email~") COLUMN(NAME=~"type_rdv.ajoute_auto_alerte~") COLUMN(NAME=~"type_rdv.etat_ajoute_auto_alerte~") COLUMN(NAME=~"type_rdv.alerte_ajoute~") COLUMN(NAME=~"type_rdv.nb_jour_alerte_ajoute~") COLUMN(NAME=~"type_rdv.interdit_1_lundi_de~") COLUMN(NAME=~"type_rdv.interdit_1_lundi_a~") COLUMN(NAME=~"type_rdv.interdit_2_lundi_de~") COLUMN(NAME=~"type_rdv.interdit_2_lundi_a~") COLUMN(NAME=~"type_rdv.interdit_1_mardi_de~") COLUMN(NAME=~"type_rdv.interdit_1_mardi_a~") COLUMN(NAME=~"type_rdv.interdit_2_mardi_de~") COLUMN(NAME=~"type_rdv.interdit_2_mardi_a~") COLUMN(NAME=~"type_rdv.interdit_1_mercredi_de~") COLUMN(NAME=~"type_rdv.interdit_1_mercredi_a~") COLUMN(NAME=~"type_rdv.interdit_2_mercredi_de~") COLUMN(NAME=~"type_rdv.interdit_2_mercredi_a~") COLUMN(NAME=~"type_rdv.interdit_1_jeudi_de~") COLUMN(NAME=~"type_rdv.interdit_1_jeudi_a~") COLUMN(NAME=~"type_rdv.interdit_2_jeudi_de~") COLUMN(NAME=~"type_rdv.interdit_2_jeudi_a~") COLUMN(NAME=~"type_rdv.interdit_1_vendredi_de~") COLUMN(NAME=~"type_rdv.interdit_1_vendredi_a~") COLUMN(NAME=~"type_rdv.interdit_2_vendredi_de~") COLUMN(NAME=~"type_rdv.interdit_2_vendredi_a~") COLUMN(NAME=~"type_rdv.interdit_1_samedi_de~") COLUMN(NAME=~"type_rdv.interdit_1_samedi_a~") COLUMN(NAME=~"type_rdv.interdit_2_samedi_de~") COLUMN(NAME=~"type_rdv.interdit_2_samedi_a~")    JOIN (LEFT=~"famille_rdv.code~"    OP =~"=~"RIGHT=~"type_rdv.famille~"    OUTER2 =~"type_rdv.famille~" )WHERE(    EXP1 =~"~~~"type_rdv~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) "  sort="type_rdv_ordre_trie A nom A " )
