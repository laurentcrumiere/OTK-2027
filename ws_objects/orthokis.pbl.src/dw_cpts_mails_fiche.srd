table(column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="email_comptes.nom" initial=" " validation="len(trim(gettext()))>0" validationmsg="~"Vous devez indiquer un nom de compte.~"" )
 column=(type=char(100) update=yes updatewhereclause=yes name=user dbname="email_comptes.user" initial=" " )
 column=(type=char(100) update=yes updatewhereclause=yes name=pwd dbname="email_comptes.pwd" )
 column=(type=char(100) update=yes updatewhereclause=yes name=smtp_host dbname="email_comptes.smtp_host" initial=" " )
 column=(type=long update=yes updatewhereclause=yes name=smtp_port dbname="email_comptes.smtp_port" initial="25" )
 column=(type=long update=yes updatewhereclause=yes name=ordre_tri dbname="email_comptes.ordre_tri" initial="100" )
 column=(type=long update=yes updatewhereclause=yes name=actif dbname="email_comptes.actif" initial="1" values="	1/	0" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=id dbname="email_comptes.id" )
 column=(type=char(100) update=yes updatewhereclause=yes name=my_alias dbname="email_comptes.my_alias" )
 column=(type=char(100) update=yes updatewhereclause=yes name=my_adr dbname="email_comptes.my_adr" initial=" " )
 column=(type=char(3000) update=yes updatewhereclause=yes name=texte_envoi_piece_jointe_html dbname="email_comptes.texte_envoi_piece_jointe_html" )
 column=(type=char(32766) update=yes updatewhereclause=yes name=texte_envoi_piece_jointe dbname="email_comptes.texte_envoi_piece_jointe" initial=" " )
 column=(type=char(300) update=yes updatewhereclause=yes name=email_objet_defaut dbname="email_comptes.email_objet_defaut" initial="De la part du Cabinet d'Orthodontie du Dr" )
 column=(type=char(100) update=yes updatewhereclause=yes name=pop3_host dbname="email_comptes.pop3_host" )
 column=(type=long update=yes updatewhereclause=yes name=pop3_port dbname="email_comptes.pop3_port" initial="995" )
 column=(type=char(1) update=yes updatewhereclause=yes name=secu dbname="email_comptes.secu" initial="N" values="Messagerie Sécurisée de Santé	O/Messagerie Sécurisée de Santé	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=smtp_ssl dbname="email_comptes.smtp_ssl" initial="N" values="SSL	O/SSL	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pop3_ssl dbname="email_comptes.pop3_ssl" initial="N" values="SSL	O/SSL	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=starttls dbname="email_comptes.starttls" initial="O" values="Start TLS	O/Start TLS	N" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"email_comptes~" ) COLUMN(NAME=~"email_comptes.nom~") COLUMN(NAME=~"email_comptes.user~") COLUMN(NAME=~"email_comptes.pwd~") COLUMN(NAME=~"email_comptes.smtp_host~") COLUMN(NAME=~"email_comptes.smtp_port~") COLUMN(NAME=~"email_comptes.ordre_tri~") COLUMN(NAME=~"email_comptes.actif~") COLUMN(NAME=~"email_comptes.id~") COLUMN(NAME=~"email_comptes.my_alias~") COLUMN(NAME=~"email_comptes.my_adr~") COLUMN(NAME=~"email_comptes.texte_envoi_piece_jointe_html~") COLUMN(NAME=~"email_comptes.texte_envoi_piece_jointe~") COLUMN(NAME=~"email_comptes.email_objet_defaut~") COLUMN(NAME=~"email_comptes.pop3_host~") COLUMN(NAME=~"email_comptes.pop3_port~") COLUMN(NAME=~"email_comptes.secu~") COLUMN(NAME=~"email_comptes.smtp_ssl~") COLUMN(NAME=~"email_comptes.pop3_ssl~") COLUMN(NAME=~"email_comptes.starttls~")WHERE(    EXP1 =~"~~~"email_comptes~~~".~~~"id~~~"~"   OP =~"=~"    EXP2 =~":v_code~" ) ) ARG(NAME = ~"v_code~" TYPE = number) " update="email_comptes" updatewhere=2 updatekeyinplace=no arguments=(("v_code", number))  sort="ordre_tri A nom A " )
