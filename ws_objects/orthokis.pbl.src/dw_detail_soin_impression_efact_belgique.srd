table(column=(type=date updatewhereclause=yes name=date_impr dbname="soins.date_impr" )
 column=(type=date updatewhereclause=yes name=date_donne dbname="soins.date_donne" )
 column=(type=date updatewhereclause=yes name=date_rapport dbname="soins.date_rapport" )
 column=(type=char(50) update=yes updatewhereclause=yes name=comment dbname="soins.comment" )
 column=(type=number updatewhereclause=yes key=yes name=cle dbname="soins.cle" )
 column=(type=number updatewhereclause=yes key=yes name=code dbname="soins.code" )
 column=(type=date update=yes updatewhereclause=yes name=date_exe dbname="soins.date_exe" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_facture dbname="soins.numero_facture" )
 column=(type=char(6) updatewhereclause=yes name=user_modif dbname="soins.user_modif" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="soins.date_modif" )
 column=(type=char(1) updatewhereclause=yes name=fse_edite dbname="soins.fse_edite" )
 column=(type=date updatewhereclause=yes name=date_fs dbname="soins.date_fs" )
 column=(type=date updatewhereclause=yes name=facture_date dbname="facture.date" )
 column=(type=char(50) update=yes updatewhereclause=yes name=soins_dent dbname="soins.dent" )
 column=(type=date updatewhereclause=yes name=date_accord dbname="soins.date_accord" initial="null" )
 column=(type=char(10) updatewhereclause=yes name=motif_depassement dbname="soins.motif_depassement" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_hn dbname="soins.hn" )
 column=(type=char(6) update=yes updatewhereclause=yes name=soins_code_praticien dbname="soins.code_praticien" )
 column=(type=char(3) updatewhereclause=yes name=soins_code_association dbname="soins.code_association" )
 column=(type=char(1) updatewhereclause=yes name=code_soins_nature dbname="code_soins.nature" )
 column=(type=char(15) updatewhereclause=yes name=numero_fse dbname="soins.numero_fse" )
 column=(type=char(100) updatewhereclause=yes name=ar_eattest dbname="soins.ar_eattest" values="Pas d'exo.	0/Soins % séjour > 30 jours	2/Soins particuliers exonérés	3/Soins ALD	4/Assuré ou bénéf. exonéré	5/Soins dispo. prévention	7/FSV ou FSI	9" )
 column=(type=char(1) updatewhereclause=yes name=exo dbname="soins.exo" values="Pas d'exonération	0/Soins particuliers exonérés	3/Régimes spéciaux	6/Soins dispo. prévention	7/Exonération CCAM	C/ 	 /" )
 column=(type=char(4) updatewhereclause=yes name=modificateurs dbname="soins.modificateurs" )
 column=(type=long updatewhereclause=yes name=quantite dbname="soins.quantite" initial="1" )
 column=(type=long updatewhereclause=yes name=denombrement dbname="soins.denombrement" initial="1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=soins_remboursement_exceptionnel dbname="soins.remboursement_exceptionnel" values="Remb. Excep. :	O/Remb. Excep. :	N" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=derniere_efacture dbname="soins.derniere_efacture" )
 column=(type=char(1) update=yes updatewhereclause=yes name=norme_prestation dbname="soins.norme_prestation" values="Interventions chirurgicales ...	5/Fabrication de prothèses dentaires	9/Autres	0/" )
 column=(type=date update=yes updatewhereclause=yes name=date_presciption dbname="soins.date_presciption" )
 column=(type=char(1) update=yes updatewhereclause=yes name=code_facturation_intervention_personnelle dbname="soins.code_facturation_intervention_personnelle" values="Prise en charge 	1/Ticket modérateur	2/Supplément d'honoraires attesté	5/Catégorie sociale spécifique	9/Autres cas	0/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=heures_non_ouvrees dbname="soins.heures_non_ouvrees" values="Heures ouvrées	0/Nuit	1/Week-end	2/Jour férié	3/" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_prescripteur dbname="soins.code_prescripteur" )
 column=(type=date updatewhereclause=yes name=efacture_belgique_date_facture dbname="efacture_belgique.date_facture" )
 column=(type=char(12) update=yes updatewhereclause=yes name=lieu_prestation dbname="soins.lieu_prestation" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=intervention_personnelle dbname="soins.intervention_personnelle" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=supplement dbname="soins.supplement" )
 column=(type=char(1) update=yes updatewhereclause=yes name=norme_prescripteur dbname="soins.norme_prescripteur" values="Pas de prescripteur	0/La prestation peut être attribuée à un presc.	1/Échelon. (prestation facturée avec interv. pers. réduite)	2/Prestation effectuée pour ses propres patients	3/Prestation ajoutée	4/Prestation d'un prescripteur et substituée	5/Prestation de plusieurs prescripteurs et substituée	6/Prestation prescrite par différents prescripteurs	9/" )
 column=(type=char(2) update=yes updatewhereclause=yes name=derogation dbname="soins.derogation" values="Dérogation au nombre maximal	01/Autre séance//prescription	02/2ème consult.//visite identique du jour	03/3ème ou + consult.//visite identique du jour	04/Dans les autres cas	00/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=norme_dispensateur dbname="soins.norme_dispensateur" values="Praticien	1/Hygiéniste	2/" )
 column=(type=char(6) update=yes updatewhereclause=yes name=dispensateur_auxiliaire dbname="soins.dispensateur_auxiliaire" )
 column=(type=char(6) update=yes updatewhereclause=yes name=prescription_de_renvoi_electronique dbname="soins.prescription_de_renvoi_electronique" )
 column=(type=char(1) updatewhereclause=yes name=statut_my_carenet dbname="efacture_belgique.statut_my_carenet" )
 column=(type=char(200) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins~" )  TABLE(NAME=~"facture~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"efacture_belgique~" ) COLUMN(NAME=~"soins.date_impr~") COLUMN(NAME=~"soins.date_donne~") COLUMN(NAME=~"soins.date_rapport~") COLUMN(NAME=~"soins.comment~") COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"soins.date_exe~") COLUMN(NAME=~"soins.numero_facture~") COLUMN(NAME=~"soins.user_modif~") COLUMN(NAME=~"soins.date_modif~") COLUMN(NAME=~"soins.fse_edite~") COLUMN(NAME=~"soins.date_fs~") COLUMN(NAME=~"facture.date~") COLUMN(NAME=~"soins.dent~") COLUMN(NAME=~"soins.date_accord~") COLUMN(NAME=~"soins.motif_depassement~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.code_praticien~") COLUMN(NAME=~"soins.code_association~") COLUMN(NAME=~"code_soins.nature~") COLUMN(NAME=~"soins.numero_fse~") COLUMN(NAME=~"soins.ar_eattest~") COLUMN(NAME=~"soins.exo~") COLUMN(NAME=~"soins.modificateurs~") COLUMN(NAME=~"soins.quantite~") COLUMN(NAME=~"soins.denombrement~") COLUMN(NAME=~"soins.remboursement_exceptionnel~") COLUMN(NAME=~"soins.derniere_efacture~") COLUMN(NAME=~"soins.norme_prestation~") COLUMN(NAME=~"soins.date_presciption~") COLUMN(NAME=~"soins.code_facturation_intervention_personnelle~") COLUMN(NAME=~"soins.heures_non_ouvrees~") COLUMN(NAME=~"soins.code_prescripteur~") COLUMN(NAME=~"efacture_belgique.date_facture~") COLUMN(NAME=~"soins.lieu_prestation~") COLUMN(NAME=~"soins.intervention_personnelle~") COLUMN(NAME=~"soins.supplement~") COLUMN(NAME=~"soins.norme_prescripteur~") COLUMN(NAME=~"soins.derogation~") COLUMN(NAME=~"soins.norme_dispensateur~") COLUMN(NAME=~"soins.dispensateur_auxiliaire~") COLUMN(NAME=~"soins.prescription_de_renvoi_electronique~") COLUMN(NAME=~"efacture_belgique.statut_my_carenet~") COLUMN(NAME=~"code_soins.nom~")    JOIN (LEFT=~"soins.numero_facture~"    OP =~"=~"RIGHT=~"facture.numero~"    OUTER1 =~"soins.numero_facture~" )    JOIN (LEFT=~"soins.derniere_efacture~"    OP =~"=~"RIGHT=~"efacture_belgique.numero_facture~"    OUTER1 =~"soins.derniere_efacture~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )WHERE(    EXP1 =~"~~~"soins~~~".~~~"cle~~~"~"   OP =~"=~"    EXP2 =~":cle~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":code~" ) ) ARG(NAME = ~"cle~" TYPE = number)  ARG(NAME = ~"code~" TYPE = number)  ARG(NAME = ~"v_pays~" TYPE = string) " update="soins" updatewhere=0 updatekeyinplace=no arguments=(("cle", number),("code", number),("v_pays", string)) )
