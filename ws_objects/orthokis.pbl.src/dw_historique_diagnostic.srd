 retrieve="  SELECT ~"historique_traitement~".~"traitement_effectue~",   
         ~"historique_traitement~".~"plan_traitement~",   
         ~"historique_traitement~".~"code~",   
         ~"historique_traitement~".~"basal_max_pro~",   
         ~"historique_traitement~".~"basal_max_retro~",   
         ~"historique_traitement~".~"basal_mand_pro~",   
         ~"historique_traitement~".~"basal_mand_retro~",   
         ~"historique_traitement~".~"basal_max_endo~",   
         ~"historique_traitement~".~"basal_max_exo~",   
         ~"historique_traitement~".~"basal_mand_endo~",   
         ~"historique_traitement~".~"basal_mand_exo~",   
         ~"historique_traitement~".~"hypodivergence~",   
         ~"historique_traitement~".~"hyperdivergence~",   
         ~"historique_traitement~".~"alveo_max_pro~",   
         ~"historique_traitement~".~"alveo_max_retro~",   
         ~"historique_traitement~".~"alveo_mand_pro~",   
         ~"historique_traitement~".~"alveo_mand_retro~",   
         ~"historique_traitement~".~"alveo_max_endo~",   
         ~"historique_traitement~".~"alveo_max_exo~",   
         ~"historique_traitement~".~"alveo_mand_endo~",   
         ~"historique_traitement~".~"alveo_mand_exo~",   
         ~"historique_traitement~".~"supraclusion~",   
         ~"historique_traitement~".~"infraclusion~",   
         ~"historique_traitement~".~"mol_cl1~",   
         ~"historique_traitement~".~"mol_cl2~",   
         ~"historique_traitement~".~"mol_cl3~",   
         ~"historique_traitement~".~"can_cl1~",   
         ~"historique_traitement~".~"can_cl2~",   
         ~"historique_traitement~".~"can_cl3~",   
         ~"historique_traitement~".~"molaire~",   
         ~"historique_traitement~".~"canine~",   
         ~"historique_traitement~".~"dento_max~",   
         ~"historique_traitement~".~"dento_dent~",   
         ~"historique_traitement~".~"date_sauvegarde~",   
         ~"historique_traitement~".~"agenesie~",   
         ~"historique_traitement~".~"surnum~",   
         ~"historique_traitement~".~"malposition~",   
         ~"historique_traitement~".~"occl_dte~",   
         ~"historique_traitement~".~"occl_gche~",   
         ~"historique_traitement~".~"occl_ant~",   
         ~"historique_traitement~".~"facteur~",   
         ~"historique_traitement~".~"commentaire~",   
         ~"historique_traitement~".~"titre~"   
    FROM ~"historique_traitement~"  
   WHERE ( ~"historique_traitement~".~"code~" = :var_code ) AND  
         ( ~"historique_traitement~".~"date_sauvegarde~" = :var_date )    
" update="historique_traitement" updatewhere=0 updatekeyinplace=no arguments=(("var_code", number),("var_date", date)) )
