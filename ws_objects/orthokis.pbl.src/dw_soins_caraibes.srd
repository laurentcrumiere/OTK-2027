table(column=(type=number update=yes updatewhereclause=yes name=cle dbname="soins.cle" initial="zero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=numero dbname="soins.numero" )
 column=(type=date update=yes updatewhereclause=yes name=date_demande dbname="soins.date_demande" initial="" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=scp_demande dbname="soins.scp_demande" )
 column=(type=date update=yes updatewhereclause=yes name=date_accord dbname="soins.date_accord" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=scp_accord dbname="soins.scp_accord" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=hn dbname="soins.hn" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=total dbname="soins.total" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tp dbname="soins.tp" )
 column=(type=char(30) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=date updatewhereclause=yes name=date_cara dbname="soins.date_cara" )
 column=(type=decimal(2) updatewhereclause=yes name=cdoit dbname="doit" )
 column=(type=decimal(2) updatewhereclause=yes name=cpaye dbname="paye" )
