 column=(type=decimal(0) update=yes updatewhereclause=yes name=soins_code dbname="soins.code" )
 column=(type=char(10) update=yes updatewhereclause=yes name=type dbname="soins.type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"code_soins~" ) COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.date_accord~") COLUMN(NAME=~"soins.scp_accord~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"soins.tp~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"soins.date_cara~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS doit FROM ligne_soins WHERE ligne_soins.code = soins.code and ligne_soins.cle = soins.cle and ~~~"date~~~" <= cast(getdate() as date))~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS paye FROM paye WHERE paye.code = soins.code and paye.cle = soins.cle)~") COMPUTE(NAME=~"(SELECT min(~~~"ligne_soins~~~".~~~"date~~~") AS date_ligne FROM ligne_soins WHERE ligne_soins.code = soins.code and ligne_soins.cle = soins.cle)~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.code~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"patient.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )WHERE(    EXP1 =~"~~~"soins~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " arguments=(("nocode", number))  sort="date_demande A type A numero A " )
