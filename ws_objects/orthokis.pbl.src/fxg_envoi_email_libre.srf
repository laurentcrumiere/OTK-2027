$PBExportHeader$fxg_envoi_email_libre.srf
global type fxg_envoi_email_libre from function_object
end type

forward prototypes
global function boolean fxg_envoi_email_libre (double var_code_passe, datawindow dw_liste, integer desti)
end prototypes

global function boolean fxg_envoi_email_libre (double var_code_passe, datawindow dw_liste, integer desti);
// envoi d'un email simple (pas un courrier) à un patient

// soit utilisée de manière unitaire (en passant un var_code_passe <> 0)
// soit en emailing ( var_code_passe = 0 mais en passsant dw_liste et desti) 

// dans ce cas l'interface est différente car on ne demande rien ... on envoi à desti (0 pour patient, 1 pour parent 1, 9 pour parent 2)

// si desti = 2 ... c'est un ticket de rdv : interface avec texte Ticket pré chargé ou pas d'interface si mode automatique
// si desti = 3 ... c'est un rappel de rdv par email => pas d'interface du tout ... 
// si desti = 4 ... c'est un ticket de rdv sans interface, pour forcer le mode automatique ponctuellement si non configuré pour tous
// si desti = 5 ... c'est un rappel de rdv par email mais avec interface pour pouvoir ajouter une PJ (clic doit sur bouton envoyer dans la fonction de rappel).. 
// si desti = 6 ... c'est en envoi de mail selon le type de rdv, selon un changement d'état de rendez-vous - param_win[8] = email du patient, param_win[9] = email du parent1, param_win[10] = en string le code du texte email à envoyer
							// Pour Notez Nous on utilise également desti = 6 avec EN PLUS  a variable globale param_win[1] pour passer le code du formulaire 
// si desti = 7 ... c'est un envoi pour signature en ligne ... pour le signataire 1 
// si desti = 8 ... c'est un envoi pour signature en ligne ... pour le signataire 2 

// si desti = 9  .. envoi au parent2 
// si desti = 10  ... envoi d'un document après signature (PDF en PJ)   ... param_win[10] contient le fichier PDF à mettre en PJ
// si desti = 11 ... envoi de mail pour absence à un rdv - uniquement utilisée en planificateur de tache => pas d'interface du tout 


open(w_patience)

uo_smtp					smtp
uo_email_compte		cpt_email
uo_email_email 		email
str_email_frm_output		frm_output
security_attributes	sa			// pour compatibilité winNT lors de création de rep
string chemindossier
string v_titre_email = ""
string fichier_signature_en_ligne_ini = "signature_en_ligne.ini"

string fichier_texte_origine, fichier_texte_envoye, fichier_texte_patient
integer num_fichier_texte_avec_adresses
string fichier_texte_avec_adresses
string v_texte, v_objet, v_emapat, v_emapar
double v_code_texte 
boolean v_suite
string local_objet
RichTextEdit v_rte

string v_rappel_rdv_email_patient, v_rappel_rdv_email_parent1, v_rappel_rdv_email_parent2, v_emapar2

boolean avec_pj = false	// pour indiquer si Pièce jointe ou pas, pour le libellé qui sera stocké dans l'historique
boolean historiser_pj	= false	// pour historiser un PJ uniquement en envoi unitaire
string v_fichier_pj,  v_fichier_pj_type_rdv
string v_code_interne_historique_editions
boolean masquer_adresses = false			// sera possiblement à true utilisé uniquement si desti = 3 (rappel de rendez-vous)

double var_code_local

integer id_cpt

string ls_rdv_email_joindre_fichier_ics
boolean var_retour = false

var_code_local = var_code_passe

zeroi(desti)

// Dossier de destination (du patient) ... utile si envoi unique 
// Si passage d'une liste de patient par la DW, chemin dossier sera remis à jour plus tard
chemindossier = dir_photos + string(var_code_local) 


id_cpt = compte_email_a_utiliser(utilisateur_code, var_code_local)

if id_cpt = -1 then
	
	MessageBox("ATTENTION","Vous devez définir des Comptes Emails pour chaque praticien avant d'envoyer des emails (menu 'Tables', 'Administratif').~n~nCeci ne semble pas être le cas.~n~nL'envoi de l'email ne peut avoir lieu.")
	
else
	trace(" - Début fxg_envoi_email_libre")
	if OUTIL_ENVOI_EMAIL = "O" then
		// Utilisation de Chillkat
		// init cpt mail et affection au mail manager
		cpt_email = create uo_email_compte
		cpt_email.charger(id_cpt)
		email_manager.set_compte(cpt_email)
		email_manager.propos_objet = cpt_email.email_objet_defaut
		
		
		// Test 2026 - MULTI FACTEUR
		if right(cpt_email.nom ,3) = "MFA" then 
			/*
			string ls_json
			ls_json = '{' + &
			'"client_id":"ab136763-9623-45b3-afd9-2758f45ed11d",' + &
			'"client_secret":"0b5da574-22fe-4784-b3d0-3e0e0c8eaef6",' + &
			'"token_endpoint":"https://login.microsoftonline.com/34ede239-1aad-41ca-818f-cd24c5635f23/oauth2/v2.0/token",' + &
			'"scope":"https://outlook.office365.com/.default"' + &
			'}'
			
			email_manager.set_OAuth2AccessToken ( ls_json )

*/

/*
			integer li_rc
			integer li_Success
			oleobject loo_Oauth2
			string ls_Url
			integer li_NumMsWaited
			oleobject loo_Json
			oleobject loo_Fac, loo_Glob
			
			
			loo_Glob = create oleobject
			li_rc = loo_Glob.ConnectToNewObject("Chilkat_9_5_0.Global")
			if li_rc < 0 then
			    destroy loo_Glob
			    MessageBox("Error","Connecting to COM object failed")
			end if
			
			string unlock_code = "ARAKISFRMAILQ_hUaUqXhO1ZpE"

			loo_Glob.UnlockBundle(unlock_code) 
			
			
