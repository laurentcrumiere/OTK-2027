global type gfx_suppr_rep_bis from function_object
end type

forward prototypes
global function integer gfx_suppr_rep_bis (string str_path_rep)
end prototypes

global function integer gfx_suppr_rep_bis (string str_path_rep);// fx qui suprime un rep et les dosier qu'il contient
// ATTENTION : pas du récursif (donc pas fait pour de multiples sous rep)
// return 1 si OK
//			-1 si pb

int val_retour = -1

// si chemin se termine par un \ --> on l'enlève localement pour les besoins de la fx de scripting DeleteFolder
if right(str_path_rep, 1) = "\" then str_path_rep = left(str_path_rep, len(str_path_rep) -1)

if DirectoryExists(str_path_rep) then
	// utilisation du moteur de scripting windows !
	oleobject fso
	if gfx_open_connection_ole(fso, "Scripting.FileSystemObject") <> 1 then return val_retour
	try
		fso.DeleteFolder(str_path_rep)
	catch (runtimeerror err)
	end try
	gfx_close_connection_ole(fso)
	if not DirectoryExists(str_path_rep) then val_retour = 1
else
	// le rep n'existe pas --> pas une erreur --> maj val retour
	val_retour = 1
end if
//// on liste les fichiers
//listbox	lb_fichiers
//lb_fichiers = create listbox
//lb_fichiers.reset()
//boolean test
//test = lb_fichiers.DirList(str_path_rep + "*.*", 32)	// uniquement les fichiers avec aucun attribut et/ou attribut archive
//
//integer	tot_items
//tot_items = lb_fichiers.TotalItems()
//if tot_items > 0 then
//	integer i
//	for i = 1 to tot_items
//	// pour chacun d'eux : on les suppr
//		DeleteFileA(str_path_rep + lb_fichiers.text(i))
//	next
//end if
//
//// pour libérer les fichiers de la mem
//lb_fichiers.reset()
//lb_fichiers.DirList(DIR_INI +"*.*", 0+1+32)
//destroy lb_fichiers
//
//// on supr le rep vide
//RemoveDirectoryA(str_path_rep)

return val_retour
end function

