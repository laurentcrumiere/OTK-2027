global function string format_secu (string secu);Return (mid(secu,1,1)+" "+mid(secu,2,2)+" "+mid(secu,4,2)+" "+mid(secu,6,2)+" "+mid(secu,8,3)+" "+mid(secu,11,3)+" / "+mid(secu,14,2))

end function

