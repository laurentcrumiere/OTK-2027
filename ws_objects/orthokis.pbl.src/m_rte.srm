this.Item[UpperBound(this.Item)+1]=this.m_nompraticien5
this.Item[UpperBound(this.Item)+1]=this.m_rendez_prenompraticien
this.Item[UpperBound(this.Item)+1]=this.m_entte4
this.Item[UpperBound(this.Item)+1]=this.m_basdepage4
this.Item[UpperBound(this.Item)+1]=this.m_signaturepraticien5
this.Item[UpperBound(this.Item)+1]=this.m_39
this.Item[UpperBound(this.Item)+1]=this.m_datederendez-vous
this.Item[UpperBound(this.Item)+1]=this.m_datedujour10
