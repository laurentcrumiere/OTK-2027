this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_nom3=create m_nom3
this.m_prnom4=create m_prnom4
this.m_titreparent13=create m_titreparent13
this.m_nomparent13=create m_nomparent13
this.m_adresse1parent13=create m_adresse1parent13
this.m_adresse2parent13=create m_adresse2parent13
this.m_codepostalparent13=create m_codepostalparent13
this.m_villeparent13=create m_villeparent13
this.m_paysparent10=create m_paysparent10
this.m_ndossier4=create m_ndossier4
this.m_38=create m_38
this.m_nompraticien5=create m_nompraticien5
this.m_rendez_prenompraticien=create m_rendez_prenompraticien
this.m_entte4=create m_entte4
this.m_basdepage4=create m_basdepage4
this.m_signaturepraticien5=create m_signaturepraticien5
this.m_39=create m_39
this.m_datederendez-vous=create m_datederendez-vous
this.m_datedujour10=create m_datedujour10
this.Item[UpperBound(this.Item)+1]=this.m_nom3
this.Item[UpperBound(this.Item)+1]=this.m_prnom4
this.Item[UpperBound(this.Item)+1]=this.m_titreparent13
this.Item[UpperBound(this.Item)+1]=this.m_nomparent13
this.Item[UpperBound(this.Item)+1]=this.m_adresse1parent13
this.Item[UpperBound(this.Item)+1]=this.m_adresse2parent13
