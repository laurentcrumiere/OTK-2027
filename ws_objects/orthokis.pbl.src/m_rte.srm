type m_search from menu within m_rte
m_find m_find
m_findnext m_findnext
m_remplacer m_remplacer
end type

on m_search.create
call super::create
this.text = "&Recherche"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_find=create m_find
this.m_findnext=create m_findnext
this.m_remplacer=create m_remplacer
this.Item[UpperBound(this.Item)+1]=this.m_find
this.Item[UpperBound(this.Item)+1]=this.m_findnext
this.Item[UpperBound(this.Item)+1]=this.m_remplacer
end on

on m_search.destroy
call super::destroy
destroy(this.m_find)
destroy(this.m_findnext)
destroy(this.m_remplacer)
end on

