table(column=(type=number update=yes updatewhereclause=yes key=yes identity=yes name=id dbname="taches.id" )
 column=(type=datetime update=yes updatewhereclause=yes name=saisie dbname="taches.saisie" )
 column=(type=datetime update=yes updatewhereclause=yes name=date_echeance dbname="taches.date_echeance" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=texte dbname="taches.texte" )
 column=(type=char(6) update=yes updatewhereclause=yes name=utilisateur_emetteur dbname="taches.utilisateur_emetteur" )
 column=(type=char(6) update=yes updatewhereclause=yes name=utilisateur_destinataire dbname="taches.utilisateur_destinataire" )
 column=(type=char(1) update=yes updatewhereclause=yes name=confidentiel dbname="taches.confidentiel" initial="N" values="Confidentielle :	O/Confidentielle :	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=statut dbname="taches.statut" initial="N" values="Réalisée : 	O/Réalisée : 	N" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=code dbname="taches.code" )
 column=(type=char(98) updatewhereclause=yes name=nom_patient dbname="nom_patient" )
 column=(type=char(1) update=yes updatewhereclause=yes name=notification dbname="taches.notification" initial="N" values="Notification :	O/Notification :	N" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=minutes_notification dbname="taches.minutes_notification" initial="0" )
 column=(type=number update=yes updatewhereclause=yes name=groupe_destinataire dbname="taches.groupe_destinataire" )
 column=(type=char(1) update=yes updatewhereclause=yes name=type_destinataire dbname="taches.type_destinataire" initial="U" values="Utilisateur	U/Groupe	G/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"taches~" ) COLUMN(NAME=~"taches.id~") COLUMN(NAME=~"taches.saisie~") COLUMN(NAME=~"taches.date_echeance~") COLUMN(NAME=~"taches.texte~") COLUMN(NAME=~"taches.utilisateur_emetteur~") COLUMN(NAME=~"taches.utilisateur_destinataire~") COLUMN(NAME=~"taches.confidentiel~") COLUMN(NAME=~"taches.statut~") COLUMN(NAME=~"taches.code~") COMPUTE(NAME=~"(select isnull(nom + ' '+ prenom + ' (' + cast(numero_dossier as varchar)+ ')', '') from patient where taches.code = patient.code) as nom_patient~") COLUMN(NAME=~"taches.notification~") COLUMN(NAME=~"taches.minutes_notification~") COLUMN(NAME=~"taches.groupe_destinataire~") COLUMN(NAME=~"taches.type_destinataire~")WHERE(    EXP1 =~"~~~"taches~~~".~~~"id~~~"~"   OP =~"=~"    EXP2 =~":v_id~" ) ) ARG(NAME = ~"v_id~" TYPE = number) " update="taches" updatewhere=1 updatekeyinplace=no arguments=(("v_id", number)) )
