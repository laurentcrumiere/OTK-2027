 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"adresses~" ) COLUMN(NAME=~"adresses.code~") COLUMN(NAME=~"adresses.nom~") COLUMN(NAME=~"adresses.adr1~") COLUMN(NAME=~"adresses.adr2~") COLUMN(NAME=~"adresses.codep~") COLUMN(NAME=~"adresses.ville~") COLUMN(NAME=~"adresses.tel~") COLUMN(NAME=~"adresses.fax~") COLUMN(NAME=~"adresses.contact1~") COLUMN(NAME=~"adresses.contact2~") COLUMN(NAME=~"adresses.pays~") COLUMN(NAME=~"adresses.commentaires~") COLUMN(NAME=~"adresses.email1~") COLUMN(NAME=~"adresses.email2~") COLUMN(NAME=~"adresses.tel1~") COLUMN(NAME=~"adresses.tel2~")WHERE(    EXP1 =~"~~~"adresses~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code~" ) ) ARG(NAME = ~"var_code~" TYPE = string) " update="adresses" updatewhere=1 updatekeyinplace=no arguments=(("var_code", string)) )
