table(column=(type=date update=yes updatewhereclause=yes name=date_impr dbname="soins.date_impr" )
 column=(type=date update=yes updatewhereclause=yes name=date_donne dbname="soins.date_donne" )
 column=(type=date update=yes updatewhereclause=yes name=date_rapport dbname="soins.date_rapport" )
 column=(type=char(50) update=yes updatewhereclause=yes name=comment dbname="soins.comment" )
 column=(type=number updatewhereclause=yes key=yes name=cle dbname="soins.cle" )
 column=(type=number updatewhereclause=yes key=yes name=code dbname="soins.code" )
 column=(type=date update=yes updatewhereclause=yes name=date_exe dbname="soins.date_exe" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_facture dbname="soins.numero_facture" )
 column=(type=char(6) updatewhereclause=yes name=user_modif dbname="soins.user_modif" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="soins.date_modif" )
 column=(type=char(1) updatewhereclause=yes name=fse_edite dbname="soins.fse_edite" )
 column=(type=date updatewhereclause=yes name=date_fs dbname="soins.date_fs" )
 column=(type=date updatewhereclause=yes name=facture_date dbname="facture.date" )
 column=(type=char(50) update=yes updatewhereclause=yes name=soins_dent dbname="soins.dent" )
 column=(type=date update=yes updatewhereclause=yes name=date_accord dbname="soins.date_accord" initial="null" )
 column=(type=char(10) update=yes updatewhereclause=yes name=motif_depassement dbname="soins.motif_depassement" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_hn dbname="soins.hn" )
 column=(type=char(6) update=yes updatewhereclause=yes name=soins_code_praticien dbname="soins.code_praticien" )
 column=(type=char(3) update=yes updatewhereclause=yes name=soins_code_association dbname="soins.code_association" )
 column=(type=char(1) updatewhereclause=yes name=code_soins_nature dbname="code_soins.nature" )
 column=(type=char(15) updatewhereclause=yes name=numero_fse dbname="soins.numero_fse" )
 column=(type=char(100) update=yes updatewhereclause=yes name=ar_eattest dbname="soins.ar_eattest" values="Pas d'exo.	0/Soins % séjour > 30 jours	2/Soins particuliers exonérés	3/Soins ALD	4/Assuré ou bénéf. exo	5/Soins dispo. prévention	7/FSV ou FSI	9/Soins CCAM exo	C/" )
 column=(type=decimal(0) updatewhereclause=yes name=derniere_efacture dbname="soins.derniere_efacture" )
 column=(type=date updatewhereclause=yes name=ememoire_luxembourg_date dbname="ememoire_luxembourg.date" )
 column=(type=char(1) updatewhereclause=yes name=ememoire_luxembourg_etat dbname="ememoire_luxembourg.etat" values="Non simulé	N/Simulation OK	S/Simulation non OK	K/Validation OK	V/Valdation non OK	L/Annnulation Auto.	A/Constesté	C/" )
 column=(type=long update=yes updatewhereclause=yes name=quantite dbname="soins.quantite" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins~" )  TABLE(NAME=~"facture~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"ememoire_luxembourg~" ) COLUMN(NAME=~"soins.date_impr~") COLUMN(NAME=~"soins.date_donne~") COLUMN(NAME=~"soins.date_rapport~") COLUMN(NAME=~"soins.comment~") COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"soins.date_exe~") COLUMN(NAME=~"soins.numero_facture~") COLUMN(NAME=~"soins.user_modif~") COLUMN(NAME=~"soins.date_modif~") COLUMN(NAME=~"soins.fse_edite~") COLUMN(NAME=~"soins.date_fs~") COLUMN(NAME=~"facture.date~") COLUMN(NAME=~"soins.dent~") COLUMN(NAME=~"soins.date_accord~") COLUMN(NAME=~"soins.motif_depassement~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.code_praticien~") COLUMN(NAME=~"soins.code_association~") COLUMN(NAME=~"code_soins.nature~") COLUMN(NAME=~"soins.numero_fse~") COLUMN(NAME=~"soins.ar_eattest~") COLUMN(NAME=~"soins.derniere_efacture~") COLUMN(NAME=~"ememoire_luxembourg.date~") COLUMN(NAME=~"ememoire_luxembourg.etat~") COLUMN(NAME=~"soins.quantite~")    JOIN (LEFT=~"soins.numero_facture~"    OP =~"=~"RIGHT=~"facture.numero~"    OUTER1 =~"soins.numero_facture~" )    JOIN (LEFT=~"soins.derniere_efacture~"    OP =~"=~"RIGHT=~"ememoire_luxembourg.numero_memoire~"    OUTER1 =~"soins.derniere_efacture~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )WHERE(    EXP1 =~"~~~"soins~~~".~~~"cle~~~"~"   OP =~"=~"    EXP2 =~":cle~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":code~" ) ) ARG(NAME = ~"cle~" TYPE = number)  ARG(NAME = ~"code~" TYPE = number)  ARG(NAME = ~"pays~" TYPE = string) " update="soins" updatewhere=0 updatekeyinplace=no arguments=(("cle", number),("code", number),("pays", string)) )
