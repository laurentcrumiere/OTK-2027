 column=(type=char(30) update=yes updatewhereclause=yes name=adr1 dbname="caisse.adr1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=adr2 dbname="caisse.adr2" )
 column=(type=char(5) update=yes updatewhereclause=yes name=codep dbname="caisse.codep" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville dbname="caisse.ville" )
