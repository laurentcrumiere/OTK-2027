 column=(type=long update=yes updatewhereclause=yes name=ordre_trie dbname="caisse.ordre_trie" initial="100" )
 column=(type=char(100) update=yes updatewhereclause=yes name=email1 dbname="caisse.email1" )
 column=(type=char(100) update=yes updatewhereclause=yes name=email2 dbname="caisse.email2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"caisse~" ) COLUMN(NAME=~"caisse.code~") COLUMN(NAME=~"caisse.nom~") COLUMN(NAME=~"caisse.adr1~") COLUMN(NAME=~"caisse.adr2~") COLUMN(NAME=~"caisse.codep~") COLUMN(NAME=~"caisse.ville~") COLUMN(NAME=~"caisse.tel~") COLUMN(NAME=~"caisse.fax~") COLUMN(NAME=~"caisse.contact1~") COLUMN(NAME=~"caisse.contact2~") COLUMN(NAME=~"caisse.commentaires~") COLUMN(NAME=~"caisse.pays~") COLUMN(NAME=~"caisse.actif~") COLUMN(NAME=~"caisse.ordre_trie~") COLUMN(NAME=~"caisse.email1~") COLUMN(NAME=~"caisse.email2~")WHERE(    EXP1 =~"~~~"caisse~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code~" ) ) ARG(NAME = ~"var_code~" TYPE = string) " update="caisse" updatewhere=0 updatekeyinplace=yes arguments=(("var_code", string)) )
