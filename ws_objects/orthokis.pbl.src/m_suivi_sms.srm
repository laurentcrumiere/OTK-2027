m_0 m_0
m_statutdusms m_statutdusms
m_statutsdessmsdecettedate m_statutsdessmsdecettedate
end type
global m_suivi_sms m_suivi_sms

type variables


datawindow dw_clic

w_sms_histo w_clic
end variables

on m_suivi_sms.create
m_suivi_sms=this
call super::create
this.text = "m_suivi_sms"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_texteenvoyé=create m_texteenvoyé
this.m_0=create m_0
this.m_statutdusms=create m_statutdusms
this.m_statutsdessmsdecettedate=create m_statutsdessmsdecettedate
this.Item[UpperBound(this.Item)+1]=this.m_texteenvoyé
this.Item[UpperBound(this.Item)+1]=this.m_0
this.Item[UpperBound(this.Item)+1]=this.m_statutdusms
this.Item[UpperBound(this.Item)+1]=this.m_statutsdessmsdecettedate
end on

on m_suivi_sms.destroy
call super::destroy
destroy(this.m_texteenvoyé)
destroy(this.m_0)
destroy(this.m_statutdusms)
destroy(this.m_statutsdessmsdecettedate)
end on

