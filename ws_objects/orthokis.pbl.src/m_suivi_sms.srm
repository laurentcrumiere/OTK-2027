event clicked;
long row

row = w_sms_histo.dw_liste.getrow()

if w_sms_histo.dw_liste.getItemString(row,"historique_sms_type_sms") = "L" then
	string v_texte
	v_texte = gfx_tout_remplacer (w_sms_histo.dw_liste.getItemString(row,"historique_sms_texte_message"), "\n", char(13)+char(10))
	
	
	Messagebox("Message envoyé", v_texte )
else
	Messagebox("Message envoyé","Message référencé : " +  w_sms_histo.dw_liste.getItemString(row,"historique_sms_code_message"))
end if

end event

