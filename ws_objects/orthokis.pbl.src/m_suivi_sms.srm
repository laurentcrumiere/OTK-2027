type m_statutdusms from menu within m_suivi_sms
end type

on m_statutdusms.create
call super::create
this.text = "Statut du SMS"
this.menuimage = "lc_sms_statut.png"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.menuanimation = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_statutdusms.destroy
call super::destroy
end on

event clicked;
// récupération de l'id ...

string v_id, v_id_resultat, v_statut_resultat
v_id = dw_clic.GetItemString(dw_clic.getrow(), "historique_sms_id_message_pocket")


if w_clic.uo_poc.get_message("M",  v_id , true) = 0 then
	// Y a des résultats trouvés
	long cpt
	
	for cpt = 1 to w_clic.uo_poc.nb_resultats
		v_id_resultat =  w_clic.uo_poc.resultats[1, cpt]
		v_statut_resultat =  w_clic.uo_poc.resultats[2, cpt]
		if v_id_resultat = v_id then
			dw_clic.SetItem(dw_clic.getrow(), "historique_sms_statut", left(v_statut_resultat,1))
		end if
	next
	
	if dw_clic.update() = 1 then
		commit ;
	else
		Messagebox("ATTENTION","Une erreur s'est produite durant la mémorisation en base de données.")
		rollback ;
	end if
end if

end event

type m_statutsdessmsdecettedate from menu within m_suivi_sms
end type

on m_statutsdessmsdecettedate.create
call super::create
this.text = "Statuts des SMS à une date d~'envoi"
this.menuimage = "lc_sms_statut.png"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.menuanimation = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_statutsdessmsdecettedate.destroy
call super::destroy
end on

event clicked;
// récupération de la date ...

string v_id, v_id_resultat, v_statut_resultat
date v_date_check
long lig

v_date_check = dw_clic.GetItemDate(dw_clic.getrow(), "historique_sms_date")

openWithParm (w_sms_saisie_date_envoi , string(v_date_check))

// La date peut être mise à jour

v_date_check = date(message.StringParm)

if w_clic.uo_poc.get_message("D",  string(v_date_check, "yyyy-mm-dd"), true) = 0 then
	// Y a des résultats trouvés
	long cpt
	
	for cpt = 1 to w_clic.uo_poc.nb_resultats
		v_id_resultat =  w_clic.uo_poc.resultats[1, cpt]
		v_statut_resultat =  w_clic.uo_poc.resultats[2, cpt]
		
		lig = dw_clic.Find("historique_sms_id_message_pocket='"+v_id_resultat+"'", 0, 99999)
		if lig > 0 then
			dw_clic.SetItem(lig, "historique_sms_statut", left(v_statut_resultat,1))
		end if
	next
	
	if dw_clic.update() = 1 then
		commit ;
	else
		Messagebox("ATTENTION","Une erreur s'est produite durant la mémorisation en base de données.")
		rollback ;
	end if
end if

end event

