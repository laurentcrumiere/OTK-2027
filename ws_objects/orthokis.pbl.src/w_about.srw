event rbuttondown;call super::rbuttondown;

// Raz des options dynamiques pour forcer le chargement au prochain reboot


update param set options_dynamiques = '' ;
commit ;

Messagebox("Information","Remise à zéro des options dynamimques effectué !")
end event

type p_1 from picture within w_about
integer x = 105
integer y = 40
integer width = 1161
integer height = 504
boolean bringtotop = true
string picturename = "logo_arakis.png"
boolean focusrectangle = false
end type

event doubleclicked;// Permet de modifier une clef d'Authenticité ...
// même SignalError que First Init
if MessageBox("ATTENTION ...","Pour prendre en compte un nouveau Numéro d'Authenticité,~nORTHOkis(r) a besoin de se fermer.~n~nAussi, avant de poursuivre, veillez à bien avoir enregistré votre travail en cours.~n~nPour saisir votre nouveau Numéro d'Authenticité, cliquez sur 'OUI'.  ", Exclamation!,YesNo!,2) = 1 then
	// si l'utilisateur accèpte de continuer
	open(w_initialisation)
	
	// Actualisation des éléments si besoin
	string v_code_postal
	select top 1 isnull(nom_licence,'') , isnull(code_postal,'') l into :licence, :v_code_postal from param ;
	tab_1.tabpage_licence.st_licence.text = ":  " + Licence+" ("+v_code_postal+")"
	tab_1.tabpage_licence.st_serie.text = ":  " + serial

	if message.doubleparm = 3218 then
		// si un bon num a été rentré
		Messagebox("INFORMATION ...","Afin d'achever la prise en compte de ce ~nNuméro d'Authenticité,~nORTHOkis(r) a besoin de se fermer.~n~nBien entendu, vous pouvez ensuite le relancer !")
		Halt close
	end if
end if

end event

