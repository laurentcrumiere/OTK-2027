type prototypes
Function long GetSystemMetrics(long nIndex) Library "User32.dll"


end prototypes

type variables
integer xdep,ydep, xarr,yarr, nbboucle


string v_prog_ortho_report = ''


// Arguments to GetSystemMetrics
constant int SM_CXSCREEN = 0
constant int SM_CYSCREEN = 1

string is_key = "0408196630101985"
string is_iv = "27071992"

end variables

forward prototypes
public subroutine uf_screen_info (ref long statedwidth, ref long statedheight, ref long scalingpercent, ref long logicalwidth, ref long logicalheight)
public function string encrypt_dm (string v_string_a_crypter, string v_type)
end prototypes

public subroutine uf_screen_info (ref long statedwidth, ref long statedheight, ref long scalingpercent, ref long logicalwidth, ref long logicalheight);// Return a bunch of details about the main/default screen.
// The stated dimensions are what the user sees them being set to in Control Panel's Display Settings, like 1920 x 1080.
// The scalePercent is the DPI scaling, usually 100, 125 or 150.
// The logical dimensions are the effective usable pixels based on that scaling - and what env.ScreenWidth and env.ScreenHeight
// return. So for instance at 1920 x 1080, with 125% scaling, the logical dimensions are 1536 x 864.
// Note: Calculations done with the UnitsToPixels and PixelsToUnits functions are also in logical dimensions.

ulong ll_dpi = 96 // default if no results
string ls_dpi
Environment env

GetEnvironment(env)

// GET THE DPI

// the following setting works on at least Windows 10 - only changed, if you change the scaling, after a reboot or log off and on
if RegistryGet("HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics", "AppliedDPI", ReguLong!, ll_dpi) <> 1 then
	// the following setting works on Windows NT and 2000 (though it may not be present if the
	// machine has never been switched from small to large fonts, but that's OK)
	if RegistryGet("HKEY_CURRENT_CONFIG\Software\Fonts", "LogPixels", ReguLong!, ll_dpi) <> 1 then
		// the following setting works on Windows 95 and 98
		if RegistryGet("HKEY_CURRENT_CONFIG\Display\Settings", "DPILogicalX", RegString!, ls_dpi) = 1 	then
			ll_dpi = Long(ls_dpi)
		end if
	end if
end if

scalingPercent = Round(ll_dpi * 100 / 96.0, 0)

/* A user with dual monitors gets the incorrect (too small) results from env.ScreenWidth and env.ScreenHight,
* try double-checking the primary monitor's dimensions directly with the Windows API,
* and then use the max answer, from that, or from GetEnvironment's settings.
*/
logicalWidth = GetSystemMetrics(SM_CXSCREEN)
logicalHeight = GetSystemMetrics(SM_CYSCREEN)
if logicalWidth <> env.ScreenWidth or logicalHeight <> env.ScreenHeight then
	logicalWidth = Max(logicalWidth, env.ScreenWidth)
	logicalHeight = Max(logicalHeight, env.ScreenHeight)
end if

statedWidth = Round(logicalWidth * scalingPercent / 100.0, 0)
statedHeight = Round(logicalHeight * scalingPercent / 100.0, 0)
end subroutine

public function string encrypt_dm (string v_string_a_crypter, string v_type);// v_type = "E" pour Encryptr ou "D" pour décrypterBlob lblb_data


blob lblb_data
Blob lblb_key
Blob lblb_iv
Blob lblb_encrypt

string v_string_cryptee


lblb_data = Blob(v_string_a_crypter , EncodingANSI!)
lblb_key = Blob(is_key, EncodingANSI!)
lblb_iv = Blob(is_iv, EncodingANSI!)

CrypterObject lnv_CrypterObject
lnv_CrypterObject = Create CrypterObject

if v_type = "E" then 
	lblb_encrypt = lnv_CrypterObject.SymmetricEncrypt(AES!, lblb_data, lblb_key, 	OperationModeCBC!, lblb_iv, PKCSPadding!)
else
	lblb_encrypt = lnv_CrypterObject.SymmetricDecrypt(AES!, lblb_data, lblb_key, 	OperationModeCBC!, lblb_iv, PKCSPadding!)
end if
	
v_string_cryptee = string(lblb_encrypt, EncodingANSI!)


return v_string_cryptee
end function

event open;double v_version_base
string v_code_postal

//colore_tous_objets_window(this, couleur_fond_fenetre)
//colore_tous_objets_tab(tab_1, couleur_fond_datawindow)

//uo_logo.of_LoadImage(dir_ini + dir_fonds + "logo_arakis.png")

// Recherche de la version de la base de données 
SELECT version_base, code_postal INTO :v_version_base, :v_code_postal FROM "param";

tab_1.tabpage_licence.st_licence.text = ":  " + Licence+" ("+v_code_postal+")"
tab_1.tabpage_licence.st_serie.text = ":  " + serial



double v_patch = 0

select isnull(min(patch_version_base),0) into :v_patch from param ;
if v_patch > v_version_base then
	tab_1.tabpage_licence.st_version_base.text = ":  " + string(v_patch)
else
	tab_1.tabpage_licence.st_version_base.text = ":  " + string(v_version_base)
end if


if Multi then
	tab_1.tabpage_licence.st_type.text = ":  Multipraticiens"
else
	tab_1.tabpage_licence.st_type.text = ":  Monopraticien"
end if

tab_1.tabpage_licence.st_utilisateur.text = ":  " + utilisateur_nom

tab_1.tabpage_licence.st_version.text = ":  " + version 
tab_1.tabpage_licence.st_postes.text = ":  " + String(nombre_postes_autorises)


 




// maj des modules acquis
tab_1.tabpage_extensions.cbx_money.checked = money
tab_1.tabpage_extensions.cbx_ciel.checked = ciel
tab_1.tabpage_extensions.cbx_rdv.checked = rdv_graph

tab_1.tabpage_extensions.cbx_ccvitale.checked = ccvitale
tab_1.tabpage_extensions.cbx_doctolib.checked = doctolib
tab_1.tabpage_extensions.cbx_dental_monitoring.checked = dental_monitoring
tab_1.tabpage_extensions.cbx_noteznous.checked = noteznous
tab_1.tabpage_extensions.cbx_myray_as.checked = myray_as
tab_1.tabpage_extensions.cbx_dental_design.checked = orthup
tab_1.tabpage_extensions.cbx_module_rdv.checked = module_rdv
tab_1.tabpage_extensions.cbx_module_clinique.checked = module_clinique
tab_1.tabpage_extensions.cbx_replication.checked = replication
tab_1.tabpage_extensions.cbx_kitview.checked = kitview
tab_1.tabpage_extensions.cbx_PDA.checked = pda
tab_1.tabpage_extensions.cbx_planmeca.checked = planmeca
tab_1.tabpage_extensions.cbx_soredex.checked = DIGORA
tab_1.tabpage_extensions.cbx_stock.checked = stock
tab_1.tabpage_extensions.cbx_odrade.checked = odr
tab_1.tabpage_extensions.cbx_trophy.checked = trophy
tab_1.tabpage_extensions.cbx_centre_sante.checked = centre_sante
tab_1.tabpage_extensions.cbx_vixwin.checked = vixwin
tab_1.tabpage_extensions.cbx_mediadent.checked = mediadent
tab_1.tabpage_extensions.cbx_durr.checked = durrdental
tab_1.tabpage_extensions.cbx_instrumentarium.checked = instrumentarium
tab_1.tabpage_extensions.cbx_sidexis.checked = sidexis
tab_1.tabpage_extensions.cbx_cti.checked = cti
tab_1.tabpage_extensions.cbx_dolphin.checked = dolphin
if shape or shape_2026 then 
	tab_1.tabpage_extensions.cbx_3shape.checked = true
	if shape_2026 then 
		tab_1.tabpage_extensions.cbx_3shape.text = "3Shape Cloud"
	end if
else
	tab_1.tabpage_extensions.cbx_3shape.checked = false
end if
	
tab_1.tabpage_extensions.cbx_invisalign.checked = INVISALIGN
tab_1.tabpage_extensions.cbx_insignia.checked = INSIGNIA
tab_1.tabpage_extensions.cbx_qm.checked = QUESTIONNAIRE_MEDICAL
tab_1.tabpage_extensions.cbx_orthomoov.checked = ORTHOMOOV
tab_1.tabpage_extensions.cbx_eConnector.checked = ECONNECTOR
tab_1.tabpage_extensions.cbx_dtx.checked = DTX
tab_1.tabpage_extensions.cbx_Photo_Light.checked = PHOTO_LIGHT
tab_1.tabpage_extensions.cbx_DENTALEYEPAD.checked = DENTALEYEPAD
tab_1.tabpage_extensions.cbx_esante_luxembourg.checked = eConnector



tab_1.tabpage_extensions.cbx_deepsmile.checked = deepsmile
tab_1.tabpage_extensions.cbx_video.checked = video

if VIDEO and WAIT_AND_SMILE then
	tab_1.tabpage_extensions.cbx_video.text  = "Wait and Smile"
end if

tab_1.tabpage_extensions.cbx_monorthodontiste.checked = MON_ORTHODONTISTE

if TEA then
	tab_1.tabpage_extensions.cbx_monorthodontiste.checked = true
	tab_1.tabpage_extensions.cbx_monorthodontiste.text = "Téa (" + version_dsapi +")"
else
	if MON_ORTHODONTISTE then 
		tab_1.tabpage_extensions.cbx_monorthodontiste.checked = true
		tab_1.tabpage_extensions.cbx_monorthodontiste.text = "Mon Orthodontiste"
	else
		if DENTAPOCHE then 
			tab_1.tabpage_extensions.cbx_monorthodontiste.checked = true
			tab_1.tabpage_extensions.cbx_monorthodontiste.text = "Dentapoche (" + version_dsapi +")"
		end if
	end if
end if

tab_1.tabpage_extensions.cbx_orthoconcept.checked = Orthoconcept
tab_1.tabpage_extensions.cbx_portail_patient.checked = WEBCOMMUNICATION
tab_1.tabpage_extensions.cbx_tridim.checked = TRIDIM

if SIGNATURE_DENTALSIGN  or SIGNATURE_NUMERIQUE then 
	if SIGNATURE_DENTALSIGN then
		tab_1.tabpage_extensions.cbx_signature_numerique.text = "Signature DentalSign"
	end if
	tab_1.tabpage_extensions.cbx_signature_numerique.checked = true
else
	tab_1.tabpage_extensions.cbx_signature_numerique.checked = false
end if
tab_1.tabpage_extensions.cbx_myray.checked = MYRAY
tab_1.tabpage_extensions.cbx_rayscan.checked = RAYSCAN
tab_1.tabpage_extensions.cbx_vatech.checked = VATECH
tab_1.tabpage_extensions.cbx_owandy.checked = OWANDY

tab_1.tabpage_extensions.cbx_borne.checked =   BORNE
tab_1.tabpage_extensions.cbx_smartphone.checked =  h.options_41_50(47)
tab_1.tabpage_extensions.cbx_tablette.checked =  h.options_41_50(48)
tab_1.tabpage_extensions.cbx_apps.checked = h.options_41_50(50)

Choose case OPERATEUR_SMS
	case 0
		tab_1.tabpage_extensions.st_operateur_SMS.text = "Pas d'opérateur SMS"
	case 1
		tab_1.tabpage_extensions.st_operateur_SMS.text = "Opérateur SMS : Pocket"
	case 2
		tab_1.tabpage_extensions.st_operateur_SMS.text = "Opérateur SMS : Dental SMS"
end choose

// Infos systèmes

tab_1.tabpage_systeme.st_nom_serveur.text = ": " + fxg_get_infos_sybase('name')
//tab_1.tabpage_systeme.st_os_du_poste.text = ": " +fxg_get_infos_sybase('platformVer')
tab_1.tabpage_systeme.st_os_du_poste.text = ": " + fxg_get_infos_os()
tab_1.tabpage_systeme.st_version_sybase.text = ": " +fxg_get_infos_sybase('ProductVersion')
//tab_1.tabpage_systeme.st_serveur.text = ": " +fxg_get_infos_sybase('IsNetworkServer')
tab_1.tabpage_systeme.st_nom_du_poste.text = ": " +fxg_get_infos_sybase('MachineName')
tab_1.tabpage_systeme.st_nom_du_poste_local.text = ": " +get_nom_ordinateur()

// Verif clef : 
if NO_HASP then
	tab_1.tabpage_systeme.st_hasp.text = ": Authentification logicielle"
else
	if  h.rwnochp(1) = 65535 then
		// Pas Odrade
		tab_1.tabpage_systeme.st_hasp.text = ": Clef Orthokis seul"
	else
		tab_1.tabpage_systeme.st_hasp.text = ": Clef Orthokis et Odrade"
	end if
	 if profilestring(dir_ini+inifile_orthokis,"hasp","4net","N") = "O" then 
		tab_1.tabpage_systeme.st_hasp.text = tab_1.tabpage_systeme.st_hasp.text + " (Clef Réseau)"
	else
		tab_1.tabpage_systeme.st_hasp.text = tab_1.tabpage_systeme.st_hasp.text + " (Clef Locale)"
	end if
end if

// runtime Powerbuilder
string ls_version
environment env
integer rtn

rtn = GetEnvironment(env)

IF rtn <> 1 THEN RETURN
ls_version = ": Version : "+ string(env.pbmajorrevision)
ls_version += "." + string(env.pbminorrevision)
ls_version += "." + string(env.pbfixesrevision)
ls_version += " - Build : " + string(env.pbbuildnumber)

tab_1.tabpage_systeme.st_runtime.text = ls_version
 
 
// Détection si OrthoReport installé ou pas
string dir_or = ""
RegistryGet("HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\OrthoReport.exe","path",dir_or)


if len(trim(dir_or)) > 0 then
	// c'est good
	v_prog_ortho_report = dir_or+"\OrthoReport.exe"
else
	// c'est pas good 
	tab_1.tabpage_licence.pb_orthoreport.visible = false
end if


// uniquement pour les tests
if serial = "87001" or serial = "88005" then 
	cb_dumu.visible = true
	
end if
end event

on w_about.create
int iCurrent
call super::create
this.shl_1=create shl_1
this.tab_1=create tab_1
this.cb_1=create cb_1
this.p_1=create p_1
this.st_16=create st_16
this.st_10=create st_10
this.st_8=create st_8
this.cb_dumu=create cb_dumu
this.gb_5=create gb_5
iCurrent=UpperBound(this.Control)
this.Control[iCurrent+1]=this.shl_1
this.Control[iCurrent+2]=this.tab_1
this.Control[iCurrent+3]=this.cb_1
this.Control[iCurrent+4]=this.p_1
this.Control[iCurrent+5]=this.st_16
this.Control[iCurrent+6]=this.st_10
this.Control[iCurrent+7]=this.st_8
this.Control[iCurrent+8]=this.cb_dumu
this.Control[iCurrent+9]=this.gb_5
end on

on w_about.destroy
call super::destroy
destroy(this.shl_1)
destroy(this.tab_1)
destroy(this.cb_1)
destroy(this.p_1)
destroy(this.st_16)
destroy(this.st_10)
