 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"historique_messages_winpopup~" )  TABLE(NAME=~"utilisateurs~" ALIAS=~"utilisateurs_a~" )  TABLE(NAME=~"utilisateurs~" ALIAS=~"utilisateurs_b~" ) COLUMN(NAME=~"historique_messages_winpopup.poste_emetteur~") COLUMN(NAME=~"historique_messages_winpopup.poste_recepteur~") COLUMN(NAME=~"historique_messages_winpopup.message~") COLUMN(NAME=~"historique_messages_winpopup.date_heure_emission~") COLUMN(NAME=~"historique_messages_winpopup.date_heure_reception~") COLUMN(NAME=~"utilisateurs_a.nom~") COLUMN(NAME=~"utilisateurs_b.nom~") COLUMN(NAME=~"historique_messages_winpopup.user_emetteur~") COLUMN(NAME=~"historique_messages_winpopup.user_recepteur~") COLUMN(NAME=~"historique_messages_winpopup.confidentiel~")    JOIN (LEFT=~"historique_messages_winpopup.user_emetteur~"    OP =~"=~"RIGHT=~"utilisateurs_a.code~"    OUTER1 =~"historique_messages_winpopup.user_emetteur~" )    JOIN (LEFT=~"historique_messages_winpopup.user_recepteur~"    OP =~"=~"RIGHT=~"utilisateurs_b.code~"    OUTER1 =~"historique_messages_winpopup.user_recepteur~" )WHERE(    EXP1 =~"~~~"historique_messages_winpopup~~~".~~~"poste_emetteur~~~"~"   OP =~"between~"    EXP2 =~":emission_poste_min and :emission_poste_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"historique_messages_winpopup~~~".~~~"date_heure_emission~~~"~"   OP =~"between~"    EXP2 =~":emission_date_heure_min and :emission_date_heure_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"historique_messages_winpopup~~~".~~~"user_emetteur~~~"~"   OP =~"between~"    EXP2 =~":emission_user_min and :emission_user_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"historique_messages_winpopup~~~".~~~"message~~~"~"   OP =~"like~"    EXP2 =~":v_message~" ) ) ARG(NAME = ~"emission_poste_min~" TYPE = string)  ARG(NAME = ~"emission_poste_max~" TYPE = string)  ARG(NAME = ~"emission_user_min~" TYPE = string)  ARG(NAME = ~"emission_user_max~" TYPE = string)  ARG(NAME = ~"emission_date_heure_min~" TYPE = datetime)  ARG(NAME = ~"emission_date_heure_max~" TYPE = datetime)  ARG(NAME = ~"v_message~" TYPE = string) " arguments=(("emission_poste_min", string),("emission_poste_max", string),("emission_user_min", string),("emission_user_max", string),("emission_date_heure_min", datetime),("emission_date_heure_max", datetime),("v_message", string))  sort="date_heure_emission A poste_emetteur A utilisateurs_emetteur A " )
