table(column=(type=char(255) updatewhereclause=yes name=poste_emetteur dbname="historique_messages_winpopup.poste_emetteur" )
 column=(type=char(255) updatewhereclause=yes name=poste_recepteur dbname="historique_messages_winpopup.poste_recepteur" )
