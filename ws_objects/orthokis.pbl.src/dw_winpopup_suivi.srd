 column=(type=char(30) updatewhereclause=yes name=utilisateurs_emetteur dbname="utilisateurs.nom" )
 column=(type=char(30) updatewhereclause=yes name=utilisateurs_recepteur dbname="utilisateurs.nom" )
 column=(type=char(6) updatewhereclause=yes name=user_emetteur dbname="historique_messages_winpopup.user_emetteur" )
