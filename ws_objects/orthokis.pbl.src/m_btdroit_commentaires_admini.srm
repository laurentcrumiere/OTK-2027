end on

on m_générerunealerte.destroy
call super::destroy
end on

event clicked;
double v_code_patient , v_code_alerte
string v_commentaire = ""

select top 1 isnull(code,0) into :v_code_alerte from alertes where actif = 1 order by ordre_trie, nom ;

if v_code_alerte > 0 then
	
		if w_click_coment_admini.dw_coment.rowcount() > 0 then
			w_click_coment_admini.dw_coment.accepttext()
			v_commentaire = w_click_coment_admini.dw_coment.GetItemString(w_click_coment_admini.dw_coment.getrow(), "prevu_brut")
		end if

		
		// Ajout de l'alerte dans la table
		v_code_patient = w_click_coment_admini.var_code_local
		
		insert into patient_alertes (code_patient , code_alerte , "date",  commentaire , realisee )
		values (:v_code_patient ,  :v_code_alerte,  cast(getdate() as date), :v_commentaire , 'N' ) ;
		
		if sqlca.sqlcode = 0 then
			commit ;
			ajout_histo_alertes(v_code_patient, v_code_alerte, today(), 'A', 'N' )
		else
			rollback ; 
			Messagebox("ATTENTION", "Erreur dans l'ajout de l'alerte.")
		end if
		
		// Ajout de la fenêtre de gestion
		OpenWithParm(w_patient_alertes, v_code_patient)
else
	
	MessageBox("ATTENTION","Vous devez d'abord définir des types d'Alertes avant de pouvoir générer des alertes pour les patients.")
end if
end event

