on m_btdroit_commentaires_admini.create
m_btdroit_commentaires_admini=this
call super::create
this.text = "m_btdroit_commentaires_admini"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_couper=create m_couper
this.m_copier=create m_copier
this.m_coller=create m_coller
this.m_-1=create m_-1
this.m_générerunealerte=create m_générerunealerte
this.m_0=create m_0
this.m_informationsdemodifications=create m_informationsdemodifications
this.Item[UpperBound(this.Item)+1]=this.m_couper
this.Item[UpperBound(this.Item)+1]=this.m_copier
this.Item[UpperBound(this.Item)+1]=this.m_coller
this.Item[UpperBound(this.Item)+1]=this.m_-1
this.Item[UpperBound(this.Item)+1]=this.m_générerunealerte
this.Item[UpperBound(this.Item)+1]=this.m_0
this.Item[UpperBound(this.Item)+1]=this.m_informationsdemodifications
end on

on m_btdroit_commentaires_admini.destroy
call super::destroy
destroy(this.m_couper)
destroy(this.m_copier)
destroy(this.m_coller)
destroy(this.m_-1)
destroy(this.m_générerunealerte)
destroy(this.m_0)
destroy(this.m_informationsdemodifications)
end on

