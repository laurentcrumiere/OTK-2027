on m_générerunealerte.create
call super::create
this.text = "Générer une alerte"
this.menuimage = "lc_alerte_verte_petit.png"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
