 column=(type=decimal(2) updatewhereclause=yes name=scp_accord dbname="soins.scp_accord" dbalias=".scp_accord" )
 column=(type=decimal(2) updatewhereclause=yes name=hn dbname="soins.hn" dbalias=".hn" )
