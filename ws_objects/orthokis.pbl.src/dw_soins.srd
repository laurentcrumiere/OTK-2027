 column=(type=char(1) update=yes updatewhereclause=yes name=soins_fse_edite dbname="soins.fse_edite" dbalias=".fse_edite" )
 column=(type=char(20) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" dbalias=".code" )
