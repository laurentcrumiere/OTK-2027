 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" )
 column=(type=date updatewhereclause=yes name=soins_transfert dbname="soins.transfert" dbalias=".transfert" )
 column=(type=char(3) updatewhereclause=yes name=soins_code_association dbname="soins.code_association" dbalias=".code_association" )
