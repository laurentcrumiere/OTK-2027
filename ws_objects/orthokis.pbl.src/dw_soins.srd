 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.date_accord~") COLUMN(NAME=~"soins.scp_accord~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"soins.tp~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"patient.nom~") COMPUTE(NAME=~"dba.paye_un_soin(soins.code, soins.cle, 'O') AS paye~") COMPUTE(NAME=~"(SELECT isnull(min(~~~"ligne_soins~~~".~~~"date~~~"), soins.date_demande) FROM ligne_soins WHERE ligne_soins.code = soins.code and ligne_soins.cle = soins.cle) AS date_ligne~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"soins.date_exe~") COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"code_soins.valeur~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins.fse_edite~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"soins.numero_facture~") COLUMN(NAME=~"soins.date_impr~") COLUMN(NAME=~"soins.user_modif~") COLUMN(NAME=~"soins.date_modif~") COLUMN(NAME=~"soins.date_fs~") COLUMN(NAME=~"code_soins.nature~") COMPUTE(NAME=~"dba.lignes_soins_dues_un_soin (soins.code, soins.cle, cast(getdate() as date), 'O') as doit~") COLUMN(NAME=~"soins.dent~") COLUMN(NAME=~"code_soins.renouvt~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.motif_depassement~") COMPUTE(NAME=~"dba.paye_un_soin(soins.code, soins.cle, 'N') AS paye_patient~") COMPUTE(NAME=~"dba.lignes_soins_dues_un_soin (soins.code, soins.cle, cast(getdate() as date), 'N') as doit_patient~") COLUMN(NAME=~"soins.code_praticien~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"soins.transfert~") COLUMN(NAME=~"soins.code_association~") COLUMN(NAME=~"code_soins.duree~") COLUMN(NAME=~"soins.ar_eattest~") COLUMN(NAME=~"code_soins.couleur_fond~") COLUMN(NAME=~"soins.numero_fse~") COLUMN(NAME=~"soins.derniere_efacture~") COLUMN(NAME=~"soins.comment~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )WHERE(    EXP1 =~"soins.code~"   OP =~"=~"    EXP2 =~":nocode~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " update="soins" updatewhere=0 updatekeyinplace=no arguments=(("nocode", number))  sort="date_demande A date_ligne A code_soins_nom A numero A cle A " )
