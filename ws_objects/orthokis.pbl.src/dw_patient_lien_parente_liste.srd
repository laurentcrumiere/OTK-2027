table(column=(type=char(40) updatewhereclause=yes name=lien_parente_libelle_relation dbname="lien_parente.libelle_relation" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(1) updatewhereclause=yes name=patient_lien_parente_liaison_financiere dbname="patient_lien_parente.liaison_financiere" values="	O/	N/	D" )
 column=(type=char(1) updatewhereclause=yes name=patient_lien_parente_synchroniser dbname="patient_lien_parente.synchroniser" values="	O/	N" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" )
 column=(type=decimal(2) updatewhereclause=yes name=due dbname="due" )
 column=(type=char(1) updatewhereclause=yes name=patient_lien_parente_meme_assure dbname="patient_lien_parente.meme_assure" values="	O/	N" )
 retrieve="  SELECT ~"lien_parente~".~"nom_sens1~" as libelle_relation,   
         ~"patient~".~"nom~",   
         ~"patient~".~"prenom~",   
         ~"patient~".~"numero_dossier~",   
         ~"patient_lien_parente~".~"liaison_financiere~" ,
         ~"patient_lien_parente~".~"synchroniser~" ,
		~"patient~".~"code~",
		dba.somme_due_patient (~"patient~".~"code~", cast(getdate() as date), 'N') as due, 
         ~"patient_lien_parente~".~"meme_assure~" 
    FROM ~"lien_parente~",   
         ~"patient~",   
         ~"patient_lien_parente~"  
   WHERE ( ~"patient_lien_parente~".~"code_patient2~" = ~"patient~".~"code~" ) and  
         ( ~"patient_lien_parente~".~"code_lien_parente~" = ~"lien_parente~".~"code~" ) and  
         ( ( ~"patient_lien_parente~".~"code_patient1~" = :v_code ) )    

UNION

  SELECT ~"lien_parente~".~"nom_sens2~" as libelle_relation,   
         ~"patient~".~"nom~",   
         ~"patient~".~"prenom~",   
         ~"patient~".~"numero_dossier~",   
         ~"patient_lien_parente~".~"liaison_financiere~"   ,
         ~"patient_lien_parente~".~"synchroniser~" ,
		~"patient~".~"code~",
		dba.somme_due_patient (~"patient~".~"code~", cast(getdate() as date), 'N') as due, 
         ~"patient_lien_parente~".~"meme_assure~" 
    FROM ~"lien_parente~",   
         ~"patient~",   
         ~"patient_lien_parente~"  
   WHERE ( ~"patient_lien_parente~".~"code_patient1~" = ~"patient~".~"code~" ) and  
         ( ~"patient_lien_parente~".~"code_lien_parente~" = ~"lien_parente~".~"code~" ) and  
         ( ( ~"patient_lien_parente~".~"code_patient2~" = :v_code ) )    
" arguments=(("v_code", number))  sort="lien_parente_libelle_relation A patient_nom A patient_prenom A patient_numero_dossier A " )
