table(column=(type=char(6) updatewhereclause=yes key=yes name=code dbname="correspondants.code" dbalias=".code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) updatewhereclause=yes name=nom dbname="correspondants.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=prenom dbname="correspondants.prenom" dbalias=".prenom" )
 column=(type=long update=yes updatewhereclause=yes name=actif dbname="correspondants.actif" dbalias=".actif" initial="1" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=ordre_trie dbname="correspondants.ordre_trie" dbalias=".ordre_trie" initial="100" )
 column=(type=char(5) updatewhereclause=yes name=correspondants_codep dbname="correspondants.codep" dbalias=".codep" )
 column=(type=char(30) updatewhereclause=yes name=correspondants_ville dbname="correspondants.ville" dbalias=".ville" )
 column=(type=char(100) updatewhereclause=yes name=email dbname="correspondants.email" dbalias=".email" )
 column=(type=char(50) updatewhereclause=yes name=categories_nom dbname="categories.nom" dbalias=".nom" )
 column=(type=long updatewhereclause=yes name=nb_cor dbname="nb_cor" )
 column=(type=long updatewhereclause=yes name=nb_den dbname="nb_den" )
 column=(type=long updatewhereclause=yes name=nb_aut dbname="nb_aut" )
 column=(type=long updatewhereclause=yes name=nb_aut2 dbname="nb_aut2" )
 column=(type=long updatewhereclause=yes name=nb_aut3 dbname="nb_aut3" )
 column=(type=long updatewhereclause=yes name=nb_aut4 dbname="nb_aut4" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"correspondants~" )  TABLE(NAME=~"categories~" ) COLUMN(NAME=~"correspondants.code~") COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"correspondants.prenom~") COLUMN(NAME=~"correspondants.actif~") COLUMN(NAME=~"correspondants.ordre_trie~") COLUMN(NAME=~"correspondants.codep~") COLUMN(NAME=~"correspondants.ville~") COLUMN(NAME=~"correspondants.email~") COLUMN(NAME=~"categories.nom~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient where code_correspondant = correspondants.code and patient.numero_dossier <= 99999999) as nb_cor~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient where code_dentiste = correspondants.code and patient.numero_dossier <= 99999999) as nb_den~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient where code_medecin = correspondants.code and patient.numero_dossier <= 99999999) as nb_aut~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient where code_medecin2 = correspondants.code and patient.numero_dossier <= 99999999) as nb_aut2~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient where code_medecin3 = correspondants.code and patient.numero_dossier <= 99999999) as nb_aut3~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient where code_medecin4 = correspondants.code and patient.numero_dossier <= 99999999) as nb_aut4~")    JOIN (LEFT=~"correspondants.categorie~"    OP =~"=~"RIGHT=~"categories.code~"    OUTER1 =~"correspondants.categorie~" )WHERE(    EXP1 =~"~~~"correspondants~~~".~~~"nom~~~" + (case when ~~~"correspondants~~~".~~~"prenom~~~" is null then '' else ' ' + ~~~"correspondants~~~".~~~"prenom~~~" end)~"   OP =~"like~"    EXP2 =~":cherche~" ) ) ARG(NAME = ~"cherche~" TYPE = string) " update="correspondants" updatewhere=0 updatekeyinplace=no arguments=(("cherche", string))  sort="ordre_trie A nom A " )
