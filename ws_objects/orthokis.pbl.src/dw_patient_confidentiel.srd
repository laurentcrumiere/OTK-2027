 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.confidentiel~") COLUMN(NAME=~"patient.alerte_confidentiel~") COLUMN(NAME=~"patient.confidentiel_html~") COLUMN(NAME=~"patient.alerte_confidentiel_adm~") COLUMN(NAME=~"patient.alerte_confidentiel_rdv~") COLUMN(NAME=~"patient.alerte_confidentiel_soins~") COLUMN(NAME=~"patient.alerte_confidentiel_com_adm~") COLUMN(NAME=~"patient.alerte_confidentiel_synthese~") COLUMN(NAME=~"patient.alerte_confidentiel_img~")WHERE(    EXP1 =~"( ~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code )~" ) ) ARG(NAME = ~"var_code~" TYPE = number) " update="patient" updatewhere=0 updatekeyinplace=yes arguments=(("var_code", number)) )
