 column=(type=char(20) updatewhereclause=yes name=type dbname="soins_prevus.type" )
 column=(type=char(20) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" )
 column=(type=date updatewhereclause=yes name=date_impr dbname="soins_prevus.date_impr" )
 column=(type=char(6) updatewhereclause=yes name=user_modif dbname="soins_prevus.user_modif" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="soins_prevus.date_modif" )
 column=(type=char(1) updatewhereclause=yes name=fse dbname="table_vide.v1" values="	O/	N" )
 column=(type=char(1) updatewhereclause=yes name=code_soins_nature dbname="code_soins.nature" )
 column=(type=char(1) updatewhereclause=yes name=code_soins_renouvt dbname="code_soins.renouvt" )
 column=(type=long updatewhereclause=yes name=code_devis dbname="soins_prevus.code_devis" )
 column=(type=decimal(1) updatewhereclause=yes name=numero dbname="soins_prevus.numero" )
 column=(type=decimal(0) updatewhereclause=yes name=code_soins_duree dbname="code_soins.duree" )
 column=(type=number updatewhereclause=yes name=couleur_fond dbname="code_soins.couleur_fond" )
 column=(type=char(3) updatewhereclause=yes name=code_association dbname="soins_prevus.code_association" )
 column=(type=long updatewhereclause=yes name=nb_code_association dbname="nb_code_association" )
 column=(type=char(50) update=yes updatewhereclause=yes name=dent dbname="soins_prevus.dent" )
 column=(type=char(1) update=yes updatewhereclause=yes name=exo dbname="soins_prevus.exo" values="Pas d'exonération	0/Soins particuliers exonérés	3/Régimes spéciaux	6/Soins dispo.prévention	7/Exonération CCAM	C/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=remboursement_exceptionnel dbname="soins_prevus.remboursement_exceptionnel" values="Remb. Excep. : 	O/Remb. Excep. : 	N" )
 column=(type=char(4) updatewhereclause=yes name=modificateurs dbname="soins_prevus.modificateurs" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins_prevus~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"soins_prevus.date_demande~") COLUMN(NAME=~"soins_prevus.scp_demande~") COLUMN(NAME=~"soins_prevus.hn~") COLUMN(NAME=~"soins_prevus.total~") COLUMN(NAME=~"soins_prevus.tp~") COLUMN(NAME=~"soins_prevus.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"soins_prevus.cle~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"code_soins.valeur~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins_prevus.transfert~") COLUMN(NAME=~"soins_prevus.date_accord~") COLUMN(NAME=~"soins_prevus.scp_accord~") COMPUTE(NAME=~"(SELECT min(~~~"ligne_soins_prevus~~~".~~~"date~~~") AS date_ligne FROM ligne_soins_prevus WHERE ligne_soins_prevus.code = soins_prevus.code and ligne_soins_prevus.cle = soins_prevus.cle)~") COLUMN(NAME=~"soins_prevus.type~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"soins_prevus.date_impr~") COLUMN(NAME=~"soins_prevus.user_modif~") COLUMN(NAME=~"soins_prevus.date_modif~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"code_soins.nature~") COLUMN(NAME=~"code_soins.renouvt~") COLUMN(NAME=~"soins_prevus.code_devis~") COLUMN(NAME=~"soins_prevus.numero~") COLUMN(NAME=~"code_soins.duree~") COLUMN(NAME=~"code_soins.couleur_fond~") COLUMN(NAME=~"soins_prevus.code_association~") COMPUTE(NAME=~"(select isnull(count(*), 0) from soins_prevus where  soins_prevus.code = :nocode and  soins_prevus.~~~"code_devis~~~" = :nodevis and trim(isnull(code_association, '')) <> '')  as nb_code_association~") COLUMN(NAME=~"soins_prevus.dent~") COLUMN(NAME=~"soins_prevus.exo~") COLUMN(NAME=~"soins_prevus.remboursement_exceptionnel~") COLUMN(NAME=~"soins_prevus.modificateurs~")    JOIN (LEFT=~"soins_prevus.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins_prevus.type~" )WHERE(    EXP1 =~"~~~"soins_prevus~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"soins_prevus~~~".~~~"code_devis~~~"~"   OP =~"=~"    EXP2 =~":nodevis~" ) ) ARG(NAME = ~"nocode~" TYPE = number)  ARG(NAME = ~"nodevis~" TYPE = number) " update="soins_prevus" updatewhere=0 updatekeyinplace=no arguments=(("nocode", number),("nodevis", number))  sort="date_demande A date_ligne A code_soins_nom A numero A " )
