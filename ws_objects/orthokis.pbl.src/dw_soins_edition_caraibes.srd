 column=(type=char(10) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_soins~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"code_soins~" ) COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.date_accord~") COLUMN(NAME=~"soins.scp_accord~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"soins.tp~") COLUMN(NAME=~"ligne_soins.date~") COLUMN(NAME=~"ligne_soins.montant~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"prati.typort~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"ligne_soins.tp~") COLUMN(NAME=~"soins.date_cara~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"prati.cadre_bas_page~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.code~")    JOIN (LEFT=~"ligne_soins.cle~"    OP =~"=~"RIGHT=~"soins.cle~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"ligne_soins.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )WHERE(    EXP1 =~"( ( ~~~"soins~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~"~~~"prati~~~".~~~"code~~~"~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " arguments=(("nocode", number))  sort="date_demande A type A numero A ligne_soins_date A " )
