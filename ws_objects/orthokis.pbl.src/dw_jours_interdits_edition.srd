$PBExportHeader$dw_jours_interdits_edition.srd
release 7;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 HTMLDW=no print.documentname="Liste Jours Interdits" print.orientation = 2 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 9 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=280 color="536870912" )
summary(height=0 color="536870912" )
footer(height=108 color="536870912" )
detail(height=76 color="536870912"  height.autosize=yes)
table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_debut dbname="jours_interdits.date_debut" initial="now()" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_fin dbname="jours_interdits.date_fin" initial="now()" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=fauteuil_debut dbname="jours_interdits.fauteuil_debut" initial="0" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=fauteuil_fin dbname="jours_interdits.fauteuil_fin" initial="99" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code_praticien dbname="jours_interdits.code_praticien" )
 column=(type=char(50) updatewhereclause=yes name=commentaire dbname="jours_interdits.commentaire" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"jours_interdits~" ) COLUMN(NAME=~"jours_interdits.date_debut~") COLUMN(NAME=~"jours_interdits.date_fin~") COLUMN(NAME=~"jours_interdits.fauteuil_debut~") COLUMN(NAME=~"jours_interdits.fauteuil_fin~") COLUMN(NAME=~"jours_interdits.code_praticien~") COLUMN(NAME=~"jours_interdits.commentaire~")WHERE(    EXP1 =~"date(~~~"jours_interdits~~~".~~~"date_debut~~~")~"   OP =~">=~"    EXP2 =~":limite~" ) ) ARG(NAME = ~"limite~" TYPE = date) " update="jours_interdits" updatewhere=1 updatekeyinplace=no arguments=(("limite", date))  sort="code_praticien A date_debut A date_fin A " )
group(level=1 header.height=76 trailer.height=16 by=("code_praticien" ) header.color="536870912" trailer.color="536870912" )
