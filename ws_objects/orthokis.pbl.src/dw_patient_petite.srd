 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"mise_en_evidence~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.prochain_rdv~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.prochain_rdv_nb~") COLUMN(NAME=~"patient.prochain_rdv_tps~") COLUMN(NAME=~"patient.somme_due~") COLUMN(NAME=~"patient.date_proc_reglt~") COLUMN(NAME=~"patient.mont_proc_reglt~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.classe~") COLUMN(NAME=~"patient.type~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.code_dentiste~") COLUMN(NAME=~"patient.duree_traitement_surveillance~") COLUMN(NAME=~"patient.duree_traitement_apres~") COLUMN(NAME=~"patient.date_reprise~") COLUMN(NAME=~"patient.date_validite_cmu~") COLUMN(NAME=~"patient.cmu~") COLUMN(NAME=~"patient.ecole~") COLUMN(NAME=~"patient.classe_scolaire~") COLUMN(NAME=~"patient.prochain_rdv_t_ou_s~") COLUMN(NAME=~"patient.prochain_rdv_serie~") COLUMN(NAME=~"patient.remarques~") COLUMN(NAME=~"patient.remarques_html~") COLUMN(NAME=~"patient.mise_en_evidence~") COLUMN(NAME=~"patient.duree_traitement_unite~") COLUMN(NAME=~"patient.sexe~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"mise_en_evidence.date_validite~") COLUMN(NAME=~"patient.remarques_cliniques~") COLUMN(NAME=~"patient.remarques_cliniques_html~") COLUMN(NAME=~"patient.vaccine_covid_19~") COLUMN(NAME=~"patient.date_vaccine_covid_19~") COLUMN(NAME=~"patient.langue1~") COLUMN(NAME=~"patient.langue2~") COMPUTE(NAME=~"(select isnull(langue.flag, '') from langue where patient.langue1 = langue.code) as flag1~") COMPUTE(NAME=~"(select isnull(langue.flag, '') from langue where patient.langue2 = langue.code) as flag2~") COLUMN(NAME=~"patient.duree_traitement~")    JOIN (LEFT=~"patient.mise_en_evidence~"    OP =~"=~"RIGHT=~"mise_en_evidence.code~"    OUTER1 =~"patient.mise_en_evidence~" )WHERE(    EXP1 =~"( ~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode )~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " update="patient" updatewhere=0 updatekeyinplace=yes arguments=(("nocode", number)) )
