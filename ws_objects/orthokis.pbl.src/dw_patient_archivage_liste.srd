table(column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.numero_dossier~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"<~"    EXP2 =~"100000000~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":v_prat1 and :v_prat2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"type_dossier~~~"~"   OP =~"=~"    EXP2 =~":v_type~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":v_numero1 and :v_numero2~" ) ) ORDER(NAME=~"patient.code~" ASC=yes ) ARG(NAME = ~"v_numero1~" TYPE = number)  ARG(NAME = ~"v_numero2~" TYPE = number)  ARG(NAME = ~"v_type~" TYPE = string)  ARG(NAME = ~"v_prat1~" TYPE = string)  ARG(NAME = ~"v_prat2~" TYPE = string) " update="patient" updatewhere=1 updatekeyinplace=no arguments=(("v_numero1", number),("v_numero2", number),("v_type", string),("v_prat1", string),("v_prat2", string))  sort="numero_dossier A " )
