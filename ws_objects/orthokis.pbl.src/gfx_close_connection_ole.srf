global function integer gfx_close_connection_ole (ref oleobject ole_obj);// fx générale qui permet de déconnecter un objet ole
// pas de gestion d'erreur


//deconnection au serveur OLE
ole_obj.disconnectobject()

// libération de la mémoire
destroy ole_obj

// pas de gestion d'erreur
return 1
end function

