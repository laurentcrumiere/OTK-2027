m_0 m_0
m_restaurationdescolonnes m_restaurationdescolonnes
end type
global m_cherche m_cherche

on m_cherche.create
m_cherche=this
call super::create
this.text = "m_cherche"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_numero_dossier=create m_numero_dossier
this.m_nom_prenom_patient=create m_nom_prenom_patient
this.m_date_naissance=create m_date_naissance
this.m_code_praticien=create m_code_praticien
this.m_nom_parent1=create m_nom_parent1
this.m_adr1_parent1=create m_adr1_parent1
this.m_codep_parent1=create m_codep_parent1
this.m_ville_parent1=create m_ville_parent1
this.m_nom_dossier=create m_nom_dossier
this.m_moulage=create m_moulage
this.m_portable=create m_portable
this.m_teldom_parent1=create m_teldom_parent1
this.m_teltra_parent1=create m_teltra_parent1
this.m_0=create m_0
this.m_restaurationdescolonnes=create m_restaurationdescolonnes
this.Item[UpperBound(this.Item)+1]=this.m_numero_dossier
this.Item[UpperBound(this.Item)+1]=this.m_nom_prenom_patient
this.Item[UpperBound(this.Item)+1]=this.m_date_naissance
this.Item[UpperBound(this.Item)+1]=this.m_code_praticien
this.Item[UpperBound(this.Item)+1]=this.m_nom_parent1
this.Item[UpperBound(this.Item)+1]=this.m_adr1_parent1
this.Item[UpperBound(this.Item)+1]=this.m_codep_parent1
this.Item[UpperBound(this.Item)+1]=this.m_ville_parent1
this.Item[UpperBound(this.Item)+1]=this.m_nom_dossier
this.Item[UpperBound(this.Item)+1]=this.m_moulage
this.Item[UpperBound(this.Item)+1]=this.m_portable
this.Item[UpperBound(this.Item)+1]=this.m_teldom_parent1
this.Item[UpperBound(this.Item)+1]=this.m_teltra_parent1
this.Item[UpperBound(this.Item)+1]=this.m_0
this.Item[UpperBound(this.Item)+1]=this.m_restaurationdescolonnes
end on

on m_cherche.destroy
call super::destroy
destroy(this.m_numero_dossier)
destroy(this.m_nom_prenom_patient)
destroy(this.m_date_naissance)
destroy(this.m_code_praticien)
destroy(this.m_nom_parent1)
destroy(this.m_adr1_parent1)
destroy(this.m_codep_parent1)
destroy(this.m_ville_parent1)
destroy(this.m_nom_dossier)
destroy(this.m_moulage)
destroy(this.m_portable)
destroy(this.m_teldom_parent1)
destroy(this.m_teltra_parent1)
destroy(this.m_0)
destroy(this.m_restaurationdescolonnes)
end on

