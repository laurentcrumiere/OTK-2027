event clicked;// Visibilité et largeur
for w_cherche.cpt_colonnes = 1 to upperbound(w_cherche.tab_colonnes)
	w_cherche.dw_liste.modify(w_cherche.tab_colonnes[w_cherche.cpt_colonnes]+".visible=1")
	w_cherche.dw_liste.modify(w_cherche.tab_colonnes[w_cherche.cpt_colonnes]+".width=" + string( w_cherche.tab_largeur_defaut[w_cherche.cpt_colonnes]))
next


// RAZ de l'ordre des colonnes
Setprofilestring(dir_ini+inifile_orthokis,"Recherche","ordre_colonnes","RAZ")
// On met la valeur "RAZ" pour que le RAZ se fasse au moment du close de la fenetre mère

Messagebox("ATTENTION","Les colonnes ont été remises avec leur largeur et leur ordre par défaut ! Nous vous conseillons de fermer cette fenêtre puis la rouvrir pour retrouver une apparence normale !")
end event

