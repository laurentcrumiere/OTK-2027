				if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T") = "C" then
					tab_param.tabpage_rmu.rb_un_rmu.checked = false
					tab_param.tabpage_rmu.rb_chacun_rmu.checked = true
					tab_param.tabpage_rmu.rb_tous_rmu.checked = false
					tab_param.tabpage_rmu.dw_prati_rmu.visible = false
				else
					tab_param.tabpage_rmu.rb_un_rmu.checked = true
					tab_param.tabpage_rmu.rb_chacun_rmu.checked = false
					tab_param.tabpage_rmu.rb_tous_rmu.checked = false
					tab_param.tabpage_rmu.dw_prati_rmu.visible = true
					tab_param.tabpage_rmu.dw_prati_rmu.Setitem(1,"code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien",""))
				end if
			end if

			// utilisateurs
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_users","T") = "T" then
				tab_param.tabpage_rmu.rb_un_user_rmu.checked = false
				tab_param.tabpage_rmu.rb_tous_users_rmu.checked = true
				tab_param.tabpage_rmu.dw_user_rmu.visible = false
			else
				tab_param.tabpage_rmu.rb_un_user_rmu.checked = true
				tab_param.tabpage_rmu.rb_tous_users_rmu.checked = false
				tab_param.tabpage_rmu.dw_user_rmu.visible = true
				tab_param.tabpage_rmu.dw_user_rmu.SetItem(1, "code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_user",""))
			end if
			tab_param.tabpage_rmu.em_jours.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_nb_jours", "3")


		case "RRV" 			// Rappel de RDV par email

		
			tab_param.tabpage_rrv.text = "Paramètres pour le rappel des RDV par email"
			tab_param.tabpage_rrv.visible = true
			tab_param.SelectTab ( 9 )
			
			// praticiens ...
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T") = "T" then
				tab_param.tabpage_rrv.rb_un_rrv.checked = false
				tab_param.tabpage_rrv.rb_chacun_rrv.checked = false
				tab_param.tabpage_rrv.rb_tous_rrv.checked = true
				tab_param.tabpage_rrv.dw_prati_rrv.visible = false
			else
				if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T") = "C" then
					tab_param.tabpage_rrv.rb_un_rrv.checked = false
					tab_param.tabpage_rrv.rb_chacun_rrv.checked = true
					tab_param.tabpage_rrv.rb_tous_rrv.checked = false
					tab_param.tabpage_rrv.dw_prati_rrv.visible = false
				else
					tab_param.tabpage_rrv.rb_un_rrv.checked = true
					tab_param.tabpage_rrv.rb_chacun_rrv.checked = false
					tab_param.tabpage_rrv.rb_tous_rrv.checked = false
					tab_param.tabpage_rrv.dw_prati_rrv.visible = true
					tab_param.tabpage_rrv.dw_prati_rrv.Setitem(1,"code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien",""))
				end if
			end if

			tab_param.tabpage_rrv.em_j1.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_j1", "1")
			tab_param.tabpage_rrv.em_j2.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_j2", "3")
			
			// Praticien à exclure 
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_exclusion","N") = "O" then
				tab_param.tabpage_rrv.cbx_exclus.checked = true
				tab_param.tabpage_rrv.dw_prati2_rrv.visible = true
				tab_param.tabpage_rrv.dw_prati2_rrv.Setitem(1,"code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticien_exclus",""))
			else
				tab_param.tabpage_rrv.cbx_exclus.checked = false
				tab_param.tabpage_rrv.dw_prati2_rrv.visible = false
			end if
			
			
			// Fichier en PJ
			tab_param.tabpage_rrv.sle_rrv_fichier_pj.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_fichier_pj","")
			
			if  ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_maquer_adresse","N") = "O" then
				tab_param.tabpage_rrv.cbx_masquer_email.checked = true
			else 
				tab_param.tabpage_rrv.cbx_masquer_email.checked = false
			end if
			
		case "QMV" 			// Questionnaires non validés

		
			tab_param.tabpage_qmv.text = "Paramètres pour la Liste des Questionnaires non validés"
			tab_param.tabpage_qmv.visible = true
			tab_param.SelectTab ( 10 )
			
			// praticiens ...
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T") = "T" then
				tab_param.tabpage_qmv.rb_un_qmv.checked = false
				tab_param.tabpage_qmv.rb_chacun_qmv.checked = false
				tab_param.tabpage_qmv.rb_tous_qmv.checked = true
				tab_param.tabpage_qmv.dw_prati_qmv.visible = false
			else
				if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T") = "C" then
					tab_param.tabpage_qmv.rb_un_qmv.checked = false
					tab_param.tabpage_qmv.rb_chacun_qmv.checked = true
					tab_param.tabpage_qmv.rb_tous_qmv.checked = false
					tab_param.tabpage_qmv.dw_prati_qmv.visible = false
				else
					tab_param.tabpage_qmv.rb_un_qmv.checked = true
					tab_param.tabpage_qmv.rb_chacun_qmv.checked = false
					tab_param.tabpage_qmv.rb_tous_qmv.checked = false
					tab_param.tabpage_qmv.dw_prati_qmv.visible = true
					tab_param.tabpage_qmv.dw_prati_qmv.Setitem(1,"code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien",""))
				end if
			end if

			tab_param.tabpage_qmv.em_j1_qmv.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_j1", "0")
			tab_param.tabpage_qmv.em_j2_qmv.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_j2", "7")

		case "MAJDOS" 			// Mise à jour des types de dossiers

		
			tab_param.tabpage_majdos.text = "Paramètres pour la Correction des Types de Dossiers"
			tab_param.tabpage_majdos.visible = true
			tab_param.SelectTab ( 11 )
			
			// praticiens ...
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T") = "T" then
				tab_param.tabpage_majdos.rb_un_majdos.checked = false
				tab_param.tabpage_majdos.rb_tous_majdos.checked = true
				tab_param.tabpage_majdos.dw_prati_majdos.visible = false
			else
				tab_param.tabpage_majdos.rb_un_majdos.checked = true
				tab_param.tabpage_majdos.rb_tous_majdos.checked = false
				tab_param.tabpage_majdos.dw_prati_majdos.visible = true
				tab_param.tabpage_majdos.dw_prati_majdos.Setitem(1,"code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien",""))
			end if

		case "ARCDOS" 			// Archivage automatique des dossiers

		
			tab_param.tabpage_arcdos.text = "Paramètres pour l'Archivage Automatique des Dossiers"
			tab_param.tabpage_arcdos.visible = true
			tab_param.SelectTab ( 12 )
			
			// praticiens ...
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T") = "T" then
				tab_param.tabpage_arcdos.rb_un_arcdos.checked = false
				tab_param.tabpage_arcdos.rb_tous_arcdos.checked = true
				tab_param.tabpage_arcdos.dw_prati_arcdos.visible = false
			else
				tab_param.tabpage_arcdos.rb_un_arcdos.checked = true
				tab_param.tabpage_arcdos.rb_tous_arcdos.checked = false
				tab_param.tabpage_arcdos.dw_prati_arcdos.visible = true
				tab_param.tabpage_arcdos.dw_prati_arcdos.Setitem(1,"code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien",""))
			end if
			
			
		case "ARV" 			// Patiens selon l'état du rezndez-vous => email absents 

		
			tab_param.tabpage_arv.text = "Paramètres pour emailing des patients selon l'état du RDV"
			tab_param.tabpage_arv.visible = true
			tab_param.SelectTab ( 13 )

			// praticiens ...
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T") = "T" then
				tab_param.tabpage_arv.rb_un_arv.checked = false
				tab_param.tabpage_arv.rb_tous_arv.checked = true
				tab_param.tabpage_arv.dw_prati_arv.visible = false
			else
				tab_param.tabpage_arv.rb_un_arv.checked = true
				tab_param.tabpage_arv.rb_tous_arv.checked = false
				tab_param.tabpage_arv.dw_prati_arv.visible = true
				tab_param.tabpage_arv.dw_prati_arv.Setitem(1,"code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien",""))
			end if
	
			// Jours 
			tab_param.tabpage_arv.em_j1_arv.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_j1", "1")
			tab_param.tabpage_arv.em_j2_arv.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_j2", "1")
			
		
			// Elimination prochains rdv
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_absence_next","O") = "O"  then 
				tab_param.tabpage_arv.cbx_arv_next.checked = true
			else
				tab_param.tabpage_arv.cbx_arv_next.checked = false
			end if

			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_absence_next_2","O") = "O"  then 
				tab_param.tabpage_arv.cbx_arv_next_2.checked = true
			else
				tab_param.tabpage_arv.cbx_arv_next_2.checked = false
			end if

			

			// Adresses mail masquées ?
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_maquer_adresse","N") = "O" then 
				tab_param.tabpage_arv.cbx_masquer_email_arv.checked = true
			else
				tab_param.tabpage_arv.cbx_masquer_email_arv.checked = false
			end if

			
			// Destinataires
			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_destinataire_patient","O") = "O" then 
				tab_param.tabpage_arv.cbx_arv_patient.checked = true
			else
				tab_param.tabpage_arv.cbx_arv_patient.checked = false
			end if
			

			if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_destinataire_parent1","O") = "O" then
				tab_param.tabpage_arv.cbx_arv_parent1.checked = true
			else
				tab_param.tabpage_arv.cbx_arv_parent1.checked = false
			end if
		
			
			// texte de mail
			tab_param.tabpage_arv.dw_texte_email_arv.SetItem ( 1 , "id", double(ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_texte_email","1")))
			
			// Etat de rendez-vous
			tab_param.tabpage_arv.dw_etat_arv.SetItem ( 1 , "code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_absence_etat","N"))



end choose
	


end subroutine

on w_planification.create
int iCurrent
call super::create
this.pb_fermer=create pb_fermer
this.dw_config=create dw_config
this.pb_annuler=create pb_annuler
this.pb_enregistrer=create pb_enregistrer
this.uo_1=create uo_1
this.st_1=create st_1
this.em_heure=create em_heure
this.tab_param=create tab_param
this.pb_journal=create pb_journal
this.cbx_planification=create cbx_planification
this.pb_aide=create pb_aide
this.gb_activation=create gb_activation
iCurrent=UpperBound(this.Control)
this.Control[iCurrent+1]=this.pb_fermer
this.Control[iCurrent+2]=this.dw_config
this.Control[iCurrent+3]=this.pb_annuler
this.Control[iCurrent+4]=this.pb_enregistrer
this.Control[iCurrent+5]=this.uo_1
this.Control[iCurrent+6]=this.st_1
this.Control[iCurrent+7]=this.em_heure
this.Control[iCurrent+8]=this.tab_param
this.Control[iCurrent+9]=this.pb_journal
this.Control[iCurrent+10]=this.cbx_planification
this.Control[iCurrent+11]=this.pb_aide
this.Control[iCurrent+12]=this.gb_activation
end on

on w_planification.destroy
call super::destroy
destroy(this.pb_fermer)
destroy(this.dw_config)
destroy(this.pb_annuler)
destroy(this.pb_enregistrer)
destroy(this.uo_1)
destroy(this.st_1)
destroy(this.em_heure)
destroy(this.tab_param)
destroy(this.pb_journal)
destroy(this.cbx_planification)
destroy(this.pb_aide)
destroy(this.gb_activation)
end on

