global type w_planification from w_fenetre_arakis
integer width = 4503
integer height = 2592
string title = "Planification de Tâches"
pb_fermer pb_fermer
dw_config dw_config
pb_annuler pb_annuler
pb_enregistrer pb_enregistrer
uo_1 uo_1
st_1 st_1
em_heure em_heure
tab_param tab_param
pb_journal pb_journal
cbx_planification cbx_planification
pb_aide pb_aide
gb_activation gb_activation
end type
global w_planification w_planification

forward prototypes
public subroutine actualise_parametres (long row)
end prototypes

public subroutine actualise_parametres (long row);
string v_code_planification

	
v_code_planification = dw_config.getItemString(row, "code")

tab_param.tabpage_rdv.visible = false
tab_param.tabpage_dep.visible = false
tab_param.tabpage_tp.visible = false
tab_param.tabpage_rel.visible = false
tab_param.tabpage_app.visible = false
tab_param.tabpage_sms.visible = false
tab_param.tabpage_rmr.visible = false
tab_param.tabpage_rmu.visible = false
tab_param.tabpage_rrv.visible = false
tab_param.tabpage_qmv.visible = false
tab_param.tabpage_majdos.visible = false
tab_param.tabpage_arcdos.visible = false
tab_param.tabpage_arv.visible = false


	choose case v_code_planification
	case "FTJ", "FTF", "PLA", "FTP"			// Les 4 sont sur le même modèles !!

		choose case v_code_planification
			case "FTJ"
				tab_param.tabpage_rdv.text = "Paramètres pour la Feuille de Travail Journalière"
			case "FTF"
				tab_param.tabpage_rdv.text = "Paramètres pour la Feuille de Travail Financière"
			case "PLA"
				tab_param.tabpage_rdv.text = "Paramètres pour le Planning d'une Journée"
			case "FTP"	
				tab_param.tabpage_rdv.text = "Paramètres pour la Feuille de Travail Personalisée"
		end choose
		
		tab_param.tabpage_rdv.visible = true
		tab_param.SelectTab ( 1 )
		
		// Lecture des paramètres
