pb_annuler.triggerevent(clicked!)

colore_tous_objets_tab(tab_param, couleur_fond_datawindow)
gb_activation.backcolor = couleur_fond_fenetre
cbx_planification.backcolor = couleur_fond_fenetre

if dw_config.rowcount() > 0 then
	dw_config.scrollTorow(1)
	actualise_parametres(1)
	
	//On supprime les SMS si pas d'opérateur
	if OPERATEUR_SMS = 0 then 
		dw_config.setfilter("code <> 'SMS'")
		dw_config.filter()
		
	end if
else
	Messagebox("ATTENTION","Problème pour lire la Table des Calculs.~n~nAccès impossble.~n~nVeuillez avertir Arakis.")
	fermer_fenetre(this)
end if



end event

event resize;call super::resize;

uo_1.retaille(this)
end event

type p_fond from w_fenetre_arakis`p_fond within w_planification
end type

type pb_fermer from uo_picturebutton_390x120_fermer within w_planification
integer x = 2880
integer y = 2308
integer width = 489
integer height = 152
integer taborder = 10
boolean bringtotop = true
end type

event clicked;fermer_fenetre(parent)
end event

type dw_config from datawindow within w_planification
string tag = "no resize brush"
integer x = 242
integer y = 184
integer width = 3927
integer height = 884
integer taborder = 20
boolean bringtotop = true
boolean titlebar = true
string title = "Configuration des périodicités"
string dataobject = "dw_planification_config"
boolean vscrollbar = true
boolean livescroll = true
end type

event dberror;
db_erreur(dw_config,sqldbcode,sqlerrtext)
return 1
end event

event clicked;


// Mise à jour des paramètres ...


if row > 0 then

	actualise_parametres(row)
	
	
end if
end event

type pb_annuler from uo_picturebutton_390x120 within w_planification
integer x = 1737
integer y = 2308
integer width = 489
integer height = 152
integer taborder = 40
boolean bringtotop = true
string text = "&Annuler"
string iconname = "ACTIONS_annuler.png"
end type

event clicked;call super::clicked;
long ligne_courante 

ligne_courante =  dw_config.getrow()

dw_config.retrieve()

em_heure.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","heure","22:00")


 
actualise_parametres(ligne_courante)

end event

type pb_enregistrer from uo_picturebutton_390x120 within w_planification
integer x = 2313
integer y = 2308
integer width = 489
integer height = 152
integer taborder = 60
boolean bringtotop = true
string text = "&Enregistrer"
boolean default = true
string iconname = "ACTIONS_enregistrer.png"
end type

event clicked;call super::clicked;
long ligne_courante

ligne_courante = dw_config.getrow()

// Partie .INI
SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","heure",em_heure.text)

if cbx_planification.checked then 
	w_mdi_2020.planification(true)
else
	w_mdi_2020.planification(false)
end if

if PLANIFICATION then
	SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","active","O")
else
	SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","active","N")
end if

string v_code_planification

v_code_planification = dw_config.getItemString(dw_config.getrow(), "code")

choose case v_code_planification
		
	case "FTJ", "FTF", "PLA", "FTP"			// Feuilles de W journalières - Les 4 sont sur le même modèles !!
		
		SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION",v_code_planification + "_fauteuil1",tab_param.tabpage_rdv.em_faut_min.text)
		SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION",v_code_planification + "_fauteuil2",tab_param.tabpage_rdv.em_faut_max.text)
		
		if tab_param.tabpage_rdv.rb_tous.checked then
			SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION",v_code_planification + "_praticiens","T")
			SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien","")
		else
			if tab_param.tabpage_rdv.rb_chacun.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","C")
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien","")
			else
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","U")
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien", tab_param.tabpage_rdv.dw_prati.GetItemString( tab_param.tabpage_rdv.dw_prati.getrow() , "code")  )
			end if
		end if
		SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION",v_code_planification + "_exemplaires",tab_param.tabpage_rdv.em_nb_exemplaires.text)
		
		
	Case "DEP"
		if tab_param.tabpage_dep.rb_tous_dep.checked then
			SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION",v_code_planification + "_praticiens","T")
			SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien","")
		else
			if tab_param.tabpage_dep.rb_chacun_dep.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","C")
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien","")
