			if tab_param.tabpage_majdos.rb_tous_majdos.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T")
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien","")
			else
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","U") 
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien",tab_param.tabpage_majdos.dw_prati_majdos.GetItemString(1,"code"))
			end if

	Case "ARCDOS"	// Archivage des dossiers
			// praticiens ...

			if tab_param.tabpage_arcdos.rb_tous_arcdos.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T")
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien","")
			else
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","U") 
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien",tab_param.tabpage_arcdos.dw_prati_arcdos.GetItemString(1,"code"))
			end if
			
		Case "ARV"	// Rendez-vous selon l'état => Absence rdv

			// praticiens ...
			if tab_param.tabpage_arv.rb_tous_arv.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","T")
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien","")
			else
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_praticiens","U") 
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_code_praticien",tab_param.tabpage_arv.dw_prati_arv.GetItemString(1,"code"))
			end if
			
			// Jours 
			SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_j1", tab_param.tabpage_arv.em_j1_arv.text)
			SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_j2", tab_param.tabpage_arv.em_j2_arv.text)
			
		
			// Elimination prochains rdv
			if tab_param.tabpage_arv.cbx_arv_next.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_absence_next","O")
			else
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_absence_next","N")
			end if
			if tab_param.tabpage_arv.cbx_arv_next_2.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_absence_next_2","O")
			else
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_absence_next_2","N")
			end if
		
			// Adresses mail masquées ?
			if tab_param.tabpage_arv.cbx_masquer_email_arv.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_maquer_adresse","O")
			else
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_maquer_adresse","N")
			end if
			
			// Destinataires
			if tab_param.tabpage_arv.cbx_arv_patient.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_destinataire_patient","O")
			else
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_destinataire_patient","N")
			end if
			if tab_param.tabpage_arv.cbx_arv_parent1.checked then
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_destinataire_parent1","O")
			else
				SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification + "_destinataire_parent1","N")
			end if			
			
			// texte de mail
			SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_texte_email", tab_param.tabpage_arv.dw_texte_email_arv.GetText())

			
			// Etat de rendez-vous
			SetProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code_planification+"_absence_etat", tab_param.tabpage_arv.dw_etat_arv.GetText())
			
end choose




// Partie Base de données
dw_config.accepttext()

if dw_config.update() = 1 then
	commit ;
else
	rollback ;
end if

// repositionnement

dw_config.scrolltorow(ligne_courante)
dw_config.setrow(ligne_courante)

end event

