on tabpage_tp.create
this.rb_tp_jour=create rb_tp_jour
this.rb_tp_un=create rb_tp_un
this.cbx_tp_que_fs=create cbx_tp_que_fs
this.cbx_tp_imprimer_lettres=create cbx_tp_imprimer_lettres
this.cbx_tp_imprimer_liste=create cbx_tp_imprimer_liste
this.dw_prati_tp=create dw_prati_tp
this.rb_tous_tp=create rb_tous_tp
this.rb_un_tp=create rb_un_tp
this.rb_chacun_tp=create rb_chacun_tp
this.gb_10=create gb_10
this.gb_7=create gb_7
this.gb_12=create gb_12
this.Control[]={this.rb_tp_jour,&
this.rb_tp_un,&
this.cbx_tp_que_fs,&
this.cbx_tp_imprimer_lettres,&
this.cbx_tp_imprimer_liste,&
this.dw_prati_tp,&
this.rb_tous_tp,&
this.rb_un_tp,&
this.rb_chacun_tp,&
this.gb_10,&
this.gb_7,&
this.gb_12}
end on

on tabpage_tp.destroy
destroy(this.rb_tp_jour)
destroy(this.rb_tp_un)
destroy(this.cbx_tp_que_fs)
destroy(this.cbx_tp_imprimer_lettres)
destroy(this.cbx_tp_imprimer_liste)
destroy(this.dw_prati_tp)
destroy(this.rb_tous_tp)
destroy(this.rb_un_tp)
destroy(this.rb_chacun_tp)
destroy(this.gb_10)
destroy(this.gb_7)
destroy(this.gb_12)
end on

