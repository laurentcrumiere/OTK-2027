table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=numero_memoire dbname="ememoire_luxembourg.numero_memoire" )
 column=(type=char(1) update=yes updatewhereclause=yes name=etat dbname="ememoire_luxembourg.etat" values="Saisi	N/Simulation OK	S/Validation OK	V/Annulation auto	A/Simulation non OK	K/Validation non OK	L/Contestation	C/Annulation man.	M/" )
 column=(type=date updatewhereclause=yes name=date dbname="ememoire_luxembourg.date" )
 column=(type=char(8) updatewhereclause=yes name=identifiant_facturier dbname="ememoire_luxembourg.identifiant_facturier" )
 column=(type=char(81) updatewhereclause=yes name=nom_patient_complet dbname="nom_patient_complet" )
 column=(type=char(82) updatewhereclause=yes name=nom_praticien_complet dbname="nom_praticien_complet" )
 column=(type=number updatewhereclause=yes name=code_patient dbname="ememoire_luxembourg.code_patient" )
 column=(type=char(36) updatewhereclause=yes name=numero_memoire_uuid dbname="ememoire_luxembourg.numero_memoire_uuid" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="ememoire_luxembourg.code_praticien" )
 column=(type=char(14) updatewhereclause=yes name=matricule_patient dbname="ememoire_luxembourg.matricule_patient" )
 column=(type=char(1) update=yes updatewhereclause=yes name=validation_praticien dbname="ememoire_luxembourg.validation_praticien" values="Validation Praticien 	O/Validation Praticien 	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=validation_patient dbname="ememoire_luxembourg.validation_patient" values="Validation Patient	O/Validation Patient	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=paiement_patient dbname="ememoire_luxembourg.paiement_patient" values="Paiement Patient	O/Paiement Patient	N" )
 column=(type=char(36) updatewhereclause=yes name=reponse_simulation_uuid dbname="ememoire_luxembourg.reponse_simulation_uuid" )
 column=(type=char(36) updatewhereclause=yes name=identifiant_externe_document dbname="ememoire_luxembourg.identifiant_externe_document" )
 column=(type=char(1) update=yes updatewhereclause=yes name=etat_rd dbname="ememoire_luxembourg.etat_rd" values="Non envoyé	N/Envoyé	E/Annulé	A/" )
 column=(type=char(3) update=yes updatewhereclause=yes name=complement_information dbname="ememoire_luxembourg.complement_information" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ememoire_luxembourg~" ) COLUMN(NAME=~"ememoire_luxembourg.numero_memoire~") COLUMN(NAME=~"ememoire_luxembourg.etat~") COLUMN(NAME=~"ememoire_luxembourg.date~") COLUMN(NAME=~"ememoire_luxembourg.identifiant_facturier~") COMPUTE(NAME=~"(select nom + ifnull(prenom, '', ' ' + prenom) from patient where code = code_patient) as nom_patient_complet~") COMPUTE(NAME=~"(select nom + ifnull(prenom, '', '  ' + prenom) from prati where code = code_praticien) as nom_praticien_complet~") COLUMN(NAME=~"ememoire_luxembourg.code_patient~") COLUMN(NAME=~"ememoire_luxembourg.numero_memoire_uuid~") COLUMN(NAME=~"ememoire_luxembourg.code_praticien~") COLUMN(NAME=~"ememoire_luxembourg.matricule_patient~") COLUMN(NAME=~"ememoire_luxembourg.validation_praticien~") COLUMN(NAME=~"ememoire_luxembourg.validation_patient~") COLUMN(NAME=~"ememoire_luxembourg.paiement_patient~") COLUMN(NAME=~"ememoire_luxembourg.reponse_simulation_uuid~") COLUMN(NAME=~"ememoire_luxembourg.identifiant_externe_document~") COLUMN(NAME=~"ememoire_luxembourg.etat_rd~") COLUMN(NAME=~"ememoire_luxembourg.complement_information~")WHERE(    EXP1 =~"~~~"ememoire_luxembourg~~~".~~~"numero_memoire~~~"~"   OP =~"=~"    EXP2 =~":v_numero~" ) ) ARG(NAME = ~"v_numero~" TYPE = number) " update="ememoire_luxembourg" updatewhere=1 updatekeyinplace=no arguments=(("v_numero", number)) )
