 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"efacture_belgique~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"efacture_belgique.numero_facture~") COLUMN(NAME=~"efacture_belgique.date_facture~") COLUMN(NAME=~"efacture_belgique.code_patient~") COLUMN(NAME=~"efacture_belgique.code_oa_affiliation~") COLUMN(NAME=~"efacture_belgique.niss~") COLUMN(NAME=~"efacture_belgique.codes_titulaires~") COLUMN(NAME=~"efacture_belgique.cause_traitement~") COLUMN(NAME=~"efacture_belgique.type_facturation~") COLUMN(NAME=~"efacture_belgique.numero_facture_precedente~") COLUMN(NAME=~"efacture_belgique.date_facture_precedente~") COLUMN(NAME=~"efacture_belgique.numero_envoi_precedent~") COLUMN(NAME=~"efacture_belgique.mois_facture_precedente~") COLUMN(NAME=~"efacture_belgique.annee_facture_precedente~") COLUMN(NAME=~"efacture_belgique.numero_compte_financier~") COLUMN(NAME=~"efacture_belgique.identite_type_support~") COLUMN(NAME=~"efacture_belgique.identite_raison_encodage_manuel~") COLUMN(NAME=~"efacture_belgique.identite_date_heure_lecture~") COLUMN(NAME=~"efacture_belgique.identite_raison_utilisation_vignette~") COLUMN(NAME=~"efacture_belgique.identite_numero_serie_support~") COLUMN(NAME=~"efacture_belgique.numero_document_justificatif~") COLUMN(NAME=~"efacture_belgique.statut_my_carenet~") COLUMN(NAME=~"efacture_belgique.sexe~") COLUMN(NAME=~"efacture_belgique.identite_type_saisie~") COLUMN(NAME=~"efacture_belgique.code_oa_destination~") COLUMN(NAME=~"efacture_belgique.etablissement_de_sejour~") COLUMN(NAME=~"efacture_belgique.levee_delai_de_prescription~") COLUMN(NAME=~"efacture_belgique.code_praticien~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"efacture_belgique.mutualite_precedente~") COLUMN(NAME=~"efacture_belgique.type_facture~")    JOIN (LEFT=~"efacture_belgique.code_patient~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"efacture_belgique~~~".~~~"numero_facture~~~"~"   OP =~"=~"    EXP2 =~":l_num ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"efacture_belgique~~~".~~~"type_facture~~~"~"   OP =~"=~"    EXP2 =~":c_type_facture~" ) ) ARG(NAME = ~"l_num~" TYPE = number)  ARG(NAME = ~"c_type_facture~" TYPE = string) " update="efacture_belgique" updatewhere=0 updatekeyinplace=no arguments=(("l_num", number),("c_type_facture", string)) )
