 column=(type=char(10) update=yes updatewhereclause=yes name=codes_titulaires dbname="efacture_belgique.codes_titulaires" )
 column=(type=char(4) update=yes updatewhereclause=yes name=cause_traitement dbname="efacture_belgique.cause_traitement" values="Traitement chimiothérapeutique ambulant	0050/Maladies professionnelles	0060/Accidents de travail	0070/Accidents - droits communs (responsabilité de tiers)	0080/Autres accidents	0090/Autres ou non communiquées	0000/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=type_facturation dbname="efacture_belgique.type_facturation" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=numero_facture_precedente dbname="efacture_belgique.numero_facture_precedente" )
 column=(type=date update=yes updatewhereclause=yes name=date_facture_precedente dbname="efacture_belgique.date_facture_precedente" )
