 column=(type=decimal(0) update=yes updatewhereclause=yes name=annee_facture_precedente dbname="efacture_belgique.annee_facture_precedente" )
 column=(type=char(22) update=yes updatewhereclause=yes name=numero_compte_financier dbname="efacture_belgique.numero_compte_financier" )
 column=(type=char(1) update=yes updatewhereclause=yes name=identite_type_support dbname="efacture_belgique.identite_type_support" values="CI belge (ou Kids-id)	1/CI étranger	2/Carte ISI+	4/Vignette avec code-à-barres	7/Attestation d'assuré social	8/Attestation de perte ou de vol	9/Saisie electronique	A/Pas de document d’identité	0/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=identite_raison_encodage_manuel dbname="efacture_belgique.identite_raison_encodage_manuel" values="Utilisation d'un document d'identité sans puce	1/Indisponibilité du lecteur de carte	2/Panne du système informatique	3/Vérification différée (pas de document)	4/Vérification différée (oubli)	5/Absence d'interconnectivité entre logiciels	6/Pas de document d'identité	7/" )
 column=(type=datetime update=yes updatewhereclause=yes name=identite_date_heure_lecture dbname="efacture_belgique.identite_date_heure_lecture" )
 column=(type=char(1) update=yes updatewhereclause=yes name=identite_raison_utilisation_vignette dbname="efacture_belgique.identite_raison_utilisation_vignette" values="Bénéficiaire pas présent	1/Bénéficiaire ne dispose pas de document d'identité	2/" )
 column=(type=char(15) update=yes updatewhereclause=yes name=identite_numero_serie_support dbname="efacture_belgique.identite_numero_serie_support" )
 column=(type=char(25) update=yes updatewhereclause=yes name=numero_document_justificatif dbname="efacture_belgique.numero_document_justificatif" )
 column=(type=char(1) update=yes updatewhereclause=yes name=statut_my_carenet dbname="efacture_belgique.statut_my_carenet" values="Non envoyée	 /Envoyée	E/Validée	V/Refusée	R/A renvoyer	A/Reçue par l'OA	U/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sexe dbname="efacture_belgique.sexe" values="Masculin	1/Féminin	2/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=identite_type_saisie dbname="efacture_belgique.identite_type_saisie" values="Lecture puce	1/Lecture code-à-barres	2/Lecture QR-code	3/Encodage manuel	4/Saisie électronique	A/Aucune lecture 	Z/" )
