 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"taches~" ) COLUMN(NAME=~"taches.date_echeance~") COLUMN(NAME=~"taches.texte~") COLUMN(NAME=~"taches.utilisateur_emetteur~") COLUMN(NAME=~"taches.utilisateur_destinataire~") COLUMN(NAME=~"taches.confidentiel~") COLUMN(NAME=~"taches.statut~") COLUMN(NAME=~"taches.id~") COLUMN(NAME=~"taches.saisie~") COMPUTE(NAME=~"date(date_echeance) as que_date_echeance~")WHERE(    EXP1 =~"date(~~~"taches~~~".~~~"date_echeance~~~")~"   OP =~"<=~"    EXP2 =~":date_limite~" ) ) ARG(NAME = ~"date_limite~" TYPE = date) " update="taches" updatewhere=0 updatekeyinplace=no arguments=(("date_limite", date))  sort="date_echeance A texte A saisie A " )
