forward
global type w_video_cachee from window
end type
type ole_windows_media_player from olecustomcontrol within w_video_cachee
end type
type cb_fermer from uo_picturebutton_390x120 within w_video_cachee
end type
end forward

global type w_video_cachee from window
integer x = 402
integer y = 24
integer width = 3840
integer height = 2812
boolean titlebar = true
string title = "Félicitations !"
boolean resizable = true
windowtype windowtype = child!
long backcolor = 16777215
boolean center = true
windowanimationstyle openanimation = centeranimation!
windowanimationstyle closeanimation = centeranimation!
integer animationtime = 500
ole_windows_media_player ole_windows_media_player
cb_fermer cb_fermer
end type
global w_video_cachee w_video_cachee

type variables
integer xdep,ydep, xarr,yarr, nbboucle

end variables

event open;string v_nom_fichier_video

if version_ce_logiciel < "36.90" then
	v_nom_fichier_video = dir_ini + "V2026.mp4"
else
	v_nom_fichier_video = dir_ini + "V2027.mp4"
end if

if not fileexists(v_nom_fichier_video) then 
	Messagebox("ATTENTION", "Impossible de localiser le fichier vidéo : " + v_nom_fichier_video)
	close(this)
else
	if isvalid(ole_windows_media_player) then
		ole_windows_media_player.object.url = v_nom_fichier_video
	else
		if messageBox("ERREUR","Cette fenêtre nécessite Window Média Player !~n~nIl ne semble pas installé.~n~nSouhaitez-vous ouvrir la vidéo votre logiciel de lecture vidéo ?" , Question!, YesNo!, 2) = 1 then 
			fxg_ouvrir_fichier_shell(v_nom_fichier_video)
			close(this)
		else
			close(this)
		end if
	end if
end if
end event

on w_video_cachee.create
this.ole_windows_media_player=create ole_windows_media_player
this.cb_fermer=create cb_fermer
this.Control[]={this.ole_windows_media_player,&
this.cb_fermer}
end on

on w_video_cachee.destroy
destroy(this.ole_windows_media_player)
destroy(this.cb_fermer)
end on

event resize;



cb_fermer.x = (this.width - cb_fermer.width) / 2
cb_fermer.y = this.height - cb_fermer.height - 200


ole_windows_media_player.x = 0
ole_windows_media_player.y = 0
ole_windows_media_player.width = this.width - 80
ole_windows_media_player.height = cb_fermer.y - 20 
end event

