table(column=(type=date updatewhereclause=yes name=date_ligne dbname="date_ligne" )
 column=(type=number updatewhereclause=yes name=cle dbname="soins_prevus.cle" initial="zero" )
 column=(type=decimal(1) updatewhereclause=yes name=numero dbname="soins_prevus.numero" )
 column=(type=date updatewhereclause=yes name=date_demande dbname="soins_prevus.date_demande" initial="" )
 column=(type=decimal(2) updatewhereclause=yes name=scp_demande dbname="soins_prevus.scp_demande" )
 column=(type=decimal(2) updatewhereclause=yes name=hn dbname="soins_prevus.hn" )
 column=(type=decimal(2) updatewhereclause=yes name=total dbname="soins_prevus.total" )
 column=(type=decimal(0) updatewhereclause=yes name=tp dbname="soins_prevus.tp" )
 column=(type=number updatewhereclause=yes name=soins_prevus_code dbname="soins_prevus.code" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=char(80) updatewhereclause=yes name=prati_entete dbname="prati.entete" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_cadre_entete dbname="prati.cadre_entete" initial="0" values="Aucun	0/Ombré	1/Rectangle	2/Ligne	4/3D en creux	5/3D en relief	6/" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_cadre_bas_page dbname="prati.cadre_bas_page" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_titre_parent1 dbname="patient.titre_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(1) updatewhereclause=yes name=param_edition_entete_visible dbname="param.edition_entete_visible" )
 column=(type=char(1) updatewhereclause=yes name=param_edition_baspage_visible dbname="param.edition_baspage_visible" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" )
 column=(type=decimal(6) updatewhereclause=yes name=code_soins_valeur dbname="code_soins.valeur" )
 column=(type=char(200) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=char(20) updatewhereclause=yes name=type dbname="soins_prevus.type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=char(20) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" )
 column=(type=decimal(5) updatewhereclause=yes name=param_euro dbname="param.euro" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(500) updatewhereclause=yes name=prati_chemin_complet_signature dbname="prati.chemin_complet_signature" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins_prevus~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"param~" ) COMPUTE(NAME=~"(SELECT min(~~~"ligne_soins_prevus~~~".~~~"date~~~") AS date_ligne FROM ligne_soins_prevus WHERE ligne_soins_prevus.code = soins_prevus.code and ligne_soins_prevus.cle = soins_prevus.cle)~") COLUMN(NAME=~"soins_prevus.cle~") COLUMN(NAME=~"soins_prevus.numero~") COLUMN(NAME=~"soins_prevus.date_demande~") COLUMN(NAME=~"soins_prevus.scp_demande~") COLUMN(NAME=~"soins_prevus.hn~") COLUMN(NAME=~"soins_prevus.total~") COLUMN(NAME=~"soins_prevus.tp~") COLUMN(NAME=~"soins_prevus.code~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"prati.cadre_bas_page~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"param.edition_entete_visible~") COLUMN(NAME=~"param.edition_baspage_visible~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"code_soins.valeur~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"soins_prevus.type~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"param.euro~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"prati.chemin_complet_signature~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins_prevus.type~" )    JOIN (LEFT=~"soins_prevus.code~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"soins_prevus~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins_prevus~~~".~~~"date_demande~~~"~"   OP =~">=~"    EXP2 =~":date_debut~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"soins_prevus~~~".~~~"code_devis~~~"~"   OP =~"=~"    EXP2 =~":devis~" ) ) ARG(NAME = ~"nocode~" TYPE = number)  ARG(NAME = ~"date_debut~" TYPE = date)  ARG(NAME = ~"monnaie~" TYPE = string)  ARG(NAME = ~"devis~" TYPE = number) " arguments=(("nocode", number),("date_debut", date),("monnaie", string),("devis", number))  sort="date_demande A date_ligne A code_soins_nom A numero A " )
