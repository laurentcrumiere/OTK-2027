		~"patient~".~"sms_depart_p2_parent1~" ,
		~"patient~".~"sms_depart_p1_parent2~" ,
		~"patient~".~"sms_depart_p2_parent2~",
		~"patient~".~"langue1~",
		~"patient~".~"langue2~",
          (select isnull(langue.flag, '') as flag1 from langue where langue1 = langue.code),
          (select isnull(langue.flag, '') as flag2 from langue where langue2 = langue.code) 



    FROM {oj ~"correspondants~" ~"correspondants_a~" LEFT OUTER JOIN ~"categories~" ~"categories_a~" ON ~"correspondants_a~".~"categorie~" = ~"categories_a~".~"code~"}, {oj ~"correspondants~" ~"correspondants_b~" LEFT OUTER JOIN ~"categories~" ~"categories_b~" ON ~"correspondants_b~".~"categorie~" = ~"categories_b~".~"code~"}, {oj ~"correspondants~" ~"correspondants_c~" LEFT OUTER JOIN ~"categories~" ~"categories_c~" ON ~"correspondants_c~".~"categorie~" = ~"categories_c~".~"code~"},   
         ~"patient~"  
   WHERE ( ~"patient~".~"code_correspondant~" = ~"correspondants_a~".~"code~" ) and  
         ( ~"patient~".~"code_dentiste~" = ~"correspondants_b~".~"code~" ) and  
         ( ~"patient~".~"code_medecin~" = ~"correspondants_c~".~"code~" ) and  
         ( (  ~"patient~".~"code~" = :var_code  ) )    
" update="patient" updatewhere=0 updatekeyinplace=no arguments=(("var_code", number)) )
