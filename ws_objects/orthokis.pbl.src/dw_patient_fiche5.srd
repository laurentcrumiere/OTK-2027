 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"codes_editions~" )  TABLE(NAME=~"historique_editions~" )  TABLE(NAME=~"table_vide~" )  TABLE(NAME=~"categorie_courrier_word_favoris~" ) COLUMN(NAME=~"codes_editions.nom~") COLUMN(NAME=~"historique_editions.date_document~") COLUMN(NAME=~"historique_editions.libelle~") COLUMN(NAME=~"historique_editions.code_courrier~") COLUMN(NAME=~"historique_editions.code~") COLUMN(NAME=~"historique_editions.nom_courrier~") COLUMN(NAME=~"historique_editions.user_modif~") COLUMN(NAME=~"historique_editions.date_modif~") COLUMN(NAME=~"codes_editions.module~") COLUMN(NAME=~"historique_editions.public_web_patient~") COLUMN(NAME=~"historique_editions.invisible~") COLUMN(NAME=~"historique_editions.nature~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"historique_editions.a_lire~") COLUMN(NAME=~"historique_editions.public_web_correspondant~") COLUMN(NAME=~"historique_editions.statut_signature~") COLUMN(NAME=~"historique_editions.id_doc_cloud~") COLUMN(NAME=~"historique_editions.code_interne~") COLUMN(NAME=~"historique_editions.id_categorie~") COLUMN(NAME=~"categorie_courrier_word_favoris.categorie~")    JOIN (LEFT=~"historique_editions.id_categorie~"    OP =~"=~"RIGHT=~"categorie_courrier_word_favoris.id~"    OUTER1 =~"historique_editions.id_categorie~" )   JOIN (LEFT=~"historique_editions.code_courrier~"    OP =~"=~"RIGHT=~"codes_editions.code~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"historique_editions~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"historique_editions~~~".~~~"nature~~~"~"   OP =~"=~"    EXP2 =~":v_nature~" ) ) ARG(NAME = ~"nocode~" TYPE = number)  ARG(NAME = ~"v_nature~" TYPE = string) " update="historique_editions" updatewhere=1 updatekeyinplace=yes filter="historique_editions_invisible <> 'O' or isnull(historique_editions_invisible)"arguments=(("nocode", number),("v_nature", string))  sort="historique_editions_date_modif D historique_editions_date_document A historique_editions_code_courrier A " )
