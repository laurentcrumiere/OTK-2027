$PBExportHeader$fxg_maj_titre_fenetre.srf
global type fxg_maj_titre_fenetre from function_object
end type

forward prototypes
global subroutine fxg_maj_titre_fenetre (window v_fenetre, string v_titre)
end prototypes

global subroutine fxg_maj_titre_fenetre (window v_fenetre, string v_titre);
// Mise à jour du titre d'une fenetre

// Attention ! En ui_v2020 ça met à jour le tab actif ! 

integer res 

if ui_v2020 then
	//v_fenetre.title = v_titre
	res = w_mdi_2020.uo_powerDock.of_setdocumenttext (v_fenetre, v_titre)
else
	v_fenetre.title = v_titre
end if


return
end subroutine

