 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_soins_auto~" )  TABLE(NAME=~"soins_auto~" )  TABLE(NAME=~"titres_soins_auto~" )  TABLE(NAME=~"code_soins~" ) COLUMN(NAME=~"soins_auto.cle~") COLUMN(NAME=~"soins_auto.numero~") COLUMN(NAME=~"soins_auto.date_demande~") COLUMN(NAME=~"soins_auto.scp_demande~") COLUMN(NAME=~"soins_auto.date_accord~") COLUMN(NAME=~"soins_auto.scp_accord~") COLUMN(NAME=~"soins_auto.hn~") COLUMN(NAME=~"soins_auto.total~") COLUMN(NAME=~"soins_auto.tp~") COLUMN(NAME=~"ligne_soins_auto.date~") COLUMN(NAME=~"ligne_soins_auto.montant~") COLUMN(NAME=~"soins_auto.code~") COLUMN(NAME=~"ligne_soins_auto.tp~") COLUMN(NAME=~"titres_soins_auto.nom~") COLUMN(NAME=~"soins_auto.mode_decalage~") COLUMN(NAME=~"soins_auto.nombre_decalage~") COLUMN(NAME=~"ligne_soins_auto.mode_decalage~") COLUMN(NAME=~"ligne_soins_auto.nombre_decalage~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"soins_auto.type~") COLUMN(NAME=~"code_soins.nom~")    JOIN (LEFT=~"ligne_soins_auto.cle~"    OP =~"=~"RIGHT=~"soins_auto.cle~"    OUTER2 =~"soins_auto.cle~" )    JOIN (LEFT=~"ligne_soins_auto.code~"    OP =~"=~"RIGHT=~"soins_auto.code~"    OUTER2 =~"soins_auto.code~" )    JOIN (LEFT=~"titres_soins_auto.code~"    OP =~"=~"RIGHT=~"soins_auto.code~" )    JOIN (LEFT=~"soins_auto.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )WHERE(    EXP1 =~"~~~"soins_auto~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ORDER(NAME=~"soins_auto.date_demande~" ASC=yes )  ORDER(NAME=~"ligne_soins_auto.date~" ASC=yes ) ARG(NAME = ~"numero~" TYPE = number) " arguments=(("numero", number))  sort="soins_auto_date_demande A ligne_soins_auto_date A code_soins_nom A soins_auto_numero A " )
