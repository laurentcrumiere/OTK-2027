table(column=(type=char(100) updatewhereclause=yes name=produit_designation dbname="produit.designation" dbalias=".designation" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_quantite dbname="stock_produit.quantite" dbalias=".quantite" )
 column=(type=char(30) updatewhereclause=yes name=fournisseur_nom dbname="fournisseur.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_code_barre dbname="stock_produit.code_barre" dbalias=".code_barre" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_numero_commande dbname="stock_produit.numero_commande" dbalias=".numero_commande" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produit~" )  TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"fournisseur~" ) COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"stock_produit.quantite~") COLUMN(NAME=~"fournisseur.nom~") COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"stock_produit.numero_commande~")    JOIN (LEFT=~"stock_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"fournisseur.code~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"stock_produit.code_produit~" )WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_patient~~~"~"   OP =~"=~"    EXP2 =~":v_patient~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"quantite_colisee~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"v_patient~" TYPE = number) " arguments=(("v_patient", number)) )
