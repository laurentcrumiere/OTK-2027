 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.nom_payeur~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.date_naissance~") COMPUTE(NAME=~"(select nom from dossier where patient.type_dossier = code ) as nom_dossier~")) " update="patient" updatewhere=0 updatekeyinplace=no  sort="nouv_nom A numero_dossier A " )
