table(column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(30) updatewhereclause=yes name=historique_sms_numero_envoi dbname="historique_sms.numero_envoi" )
 column=(type=char(3) updatewhereclause=yes name=historique_sms_code_message dbname="historique_sms.code_message" )
 column=(type=char(1) updatewhereclause=yes name=historique_sms_type_sms dbname="historique_sms.type_sms" values="Rappel RDV	R/Anniversaire	A/Tous Patients	T/Recontact	C/Absence	B/Libre	L/" )
 column=(type=char(500) updatewhereclause=yes name=historique_sms_texte_message dbname="historique_sms.texte_message" )
 column=(type=datetime updatewhereclause=yes name=historique_sms_date_envoi dbname="historique_sms.date_envoi" )
 column=(type=char(1) update=yes updatewhereclause=yes name=historique_sms_statut dbname="historique_sms.statut" values="??	/Envoyé	S/Reçu	D/Rejeté	R/Attente	W/" )
 column=(type=date updatewhereclause=yes name=historique_sms_date dbname="historique_sms.date" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(100) updatewhereclause=yes name=historique_sms_id_message_pocket dbname="historique_sms.id_message_pocket" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=historique_sms_code_interne dbname="historique_sms.code_interne" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"historique_sms~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"historique_sms.numero_envoi~") COLUMN(NAME=~"historique_sms.code_message~") COLUMN(NAME=~"historique_sms.type_sms~") COLUMN(NAME=~"historique_sms.texte_message~") COLUMN(NAME=~"historique_sms.date_envoi~") COLUMN(NAME=~"historique_sms.statut~") COLUMN(NAME=~"historique_sms.date~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"historique_sms.id_message_pocket~") COLUMN(NAME=~"historique_sms.code_interne~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"historique_sms.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"historique_sms.code_patient~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"historique_sms~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":v_prat_min and :v_prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":v_code_min and :v_code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"historique_sms~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":v_date_min and :v_date_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"date(~~~"historique_sms~~~".~~~"date_envoi~~~")~"   OP =~"between~"    EXP2 =~":v_date_envoi_min and :v_date_envoi_max~" ) ) ARG(NAME = ~"v_prat_min~" TYPE = string)  ARG(NAME = ~"v_prat_max~" TYPE = string)  ARG(NAME = ~"v_code_min~" TYPE = number)  ARG(NAME = ~"v_code_max~" TYPE = number)  ARG(NAME = ~"v_date_min~" TYPE = date)  ARG(NAME = ~"v_date_max~" TYPE = date)  ARG(NAME = ~"v_date_envoi_min~" TYPE = date)  ARG(NAME = ~"v_date_envoi_max~" TYPE = date) " update="historique_sms" updatewhere=0 updatekeyinplace=no arguments=(("v_prat_min", string),("v_prat_max", string),("v_code_min", number),("v_code_max", number),("v_date_min", date),("v_date_max", date),("v_date_envoi_min", date),("v_date_envoi_max", date))  sort="prati_nom A historique_sms_date A patient_nom A patient_prenom A historique_sms_type_sms A historique_sms_date_envoi A " )
