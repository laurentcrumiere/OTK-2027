 retrieve="  SELECT ~"diagnostic~".~"code~",   
         ~"diagnostic~".~"basal_max_pro~",   
         ~"diagnostic~".~"basal_max_retro~",   
         ~"diagnostic~".~"basal_mand_pro~",   
         ~"diagnostic~".~"basal_mand_retro~",   
         ~"diagnostic~".~"basal_max_endo~",   
         ~"diagnostic~".~"basal_max_exo~",   
         ~"diagnostic~".~"basal_mand_endo~",   
         ~"diagnostic~".~"basal_mand_exo~",   
         ~"diagnostic~".~"hypodivergence~",   
         ~"diagnostic~".~"hyperdivergence~",   
         ~"diagnostic~".~"alveo_max_pro~",   
         ~"diagnostic~".~"alveo_max_retro~",   
         ~"diagnostic~".~"alveo_mand_pro~",   
         ~"diagnostic~".~"alveo_mand_retro~",   
         ~"diagnostic~".~"alveo_max_endo~",   
         ~"diagnostic~".~"alveo_max_exo~",   
         ~"diagnostic~".~"alveo_mand_endo~",   
         ~"diagnostic~".~"alveo_mand_exo~",   
         ~"diagnostic~".~"supraclusion~",   
         ~"diagnostic~".~"infraclusion~",   
         ~"diagnostic~".~"mol_cl1~",   
         ~"diagnostic~".~"mol_cl2~",   
         ~"diagnostic~".~"mol_cl3~",   
         ~"diagnostic~".~"can_cl1~",   
         ~"diagnostic~".~"can_cl2~",   
         ~"diagnostic~".~"can_cl3~",   
         ~"diagnostic~".~"molaire~",   
         ~"diagnostic~".~"canine~",   
         ~"diagnostic~".~"dento_max~",   
         ~"diagnostic~".~"dento_dent~",   
         ~"diagnostic~".~"agenesie~",   
         ~"diagnostic~".~"surnum~",   
         ~"diagnostic~".~"malposition~",   
         ~"diagnostic~".~"occl_dte~",   
         ~"diagnostic~".~"occl_gche~",   
         ~"diagnostic~".~"occl_ant~",   
         ~"diagnostic~".~"facteur~",   
         ~"diagnostic~".~"commentaire~",   
         ~"diagnostic~".~"commentaire_html~"   
    FROM ~"diagnostic~"  
   WHERE ~"diagnostic~".~"code~" = :nocode    
" update="diagnostic" updatewhere=1 updatekeyinplace=yes arguments=(("nocode", string)) )
