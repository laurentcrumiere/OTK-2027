table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" dbalias=".date_demande" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_scp_demande dbname="soins.scp_demande" dbalias=".scp_demande" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" dbalias=".numero" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=number updatewhereclause=yes key=yes name=soins_cle dbname="soins.cle" dbalias=".cle" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=number updatewhereclause=yes key=yes name=soins_code dbname="soins.code" dbalias=".code" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(1) updatewhereclause=yes name=code_soins_renouvt dbname="code_soins.renouvt" dbalias=".renouvt" )
 column=(type=char(20) updatewhereclause=yes name=soins_type dbname="soins.type" dbalias=".type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=char(20) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" dbalias=".code" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=char(200) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" dbalias=".nom" )
 column=(type=char(1) updatewhereclause=yes name=soins_fse_edite dbname="soins.fse_edite" dbalias=".fse_edite" )
 column=(type=date update=yes updatewhereclause=yes name=soins_date_exe dbname="soins.date_exe" dbalias=".date_exe" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" dbalias=".total" )
 column=(type=date updatewhereclause=yes name=soins_date_fs dbname="soins.date_fs" dbalias=".date_fs" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" dbalias=".com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" dbalias=".secu_parent1" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=soins_numero_facture dbname="soins.numero_facture" dbalias=".numero_facture" )
 column=(type=char(6) updatewhereclause=yes name=soins_code_praticien dbname="soins.code_praticien" dbalias=".code_praticien" )
 column=(type=date updatewhereclause=yes name=soins_date_accord dbname="soins.date_accord" dbalias=".date_accord" initial="null" )
 column=(type=date updatewhereclause=yes name=soins_date_impr dbname="soins.date_impr" dbalias=".date_impr" )
 column=(type=decimal(0) updatewhereclause=yes name=derniere_efacture dbname="derniere_efacture" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"code_soins~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"code_soins.renouvt~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins.fse_edite~") COLUMN(NAME=~"soins.date_exe~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"soins.date_fs~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"soins.numero_facture~") COLUMN(NAME=~"soins.code_praticien~") COLUMN(NAME=~"soins.date_accord~") COLUMN(NAME=~"soins.date_impr~") COMPUTE(NAME=~"isnull(~~~"soins~~~".~~~"derniere_efacture~~~", 0) as ~~~"derniere_efacture~~~"~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_exe~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" isnull(~~~"soins~~~".~~~"numero_facture~~~", 0)~"   OP =~"=~"    EXP2 =~"0 ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"total~~~"~"   OP =~">~"    EXP2 =~"0 ~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " update="soins" updatewhere=0 updatekeyinplace=no arguments=(("date_min", date),("date_max", date))  sort="nom A patient_prenom A numero_dossier A soins_date_exe A code_soins_nom A code_soins_code A " )
