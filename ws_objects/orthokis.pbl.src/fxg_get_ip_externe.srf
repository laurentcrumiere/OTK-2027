$PBExportHeader$fxg_get_ip_externe.srf
global type fxg_get_ip_externe from function_object
end type

forward prototypes
global function string fxg_get_ip_externe ()
end prototypes

global function string fxg_get_ip_externe ();HttpClient lhc_client
string ls_ip, ls_response
integer li_ret

lhc_client = create HttpClient

// Envoi de la requête GET vers un service d'adresse IP
li_ret = lhc_client.SendRequest("GET", "https://api.ipify.org")

if li_ret = 1 and lhc_client.GetResponseStatusCode() = 200 then
    // Récupération de l'IP sous forme de chaîne de caractères
    lhc_client.GetResponseBody(ls_response)
    ls_ip = Trim(ls_response)
    
    //MessageBox("Adresse IP Externe", "Votre IP publique est : " + ls_ip)
else
    //MessageBox("Erreur", "Impossible de récupérer l'IP externe. Code HTTP : " + string(lhc_client.GetResponseStatusCode()))
	 ls_ip = "?"
end if

destroy lhc_client

return ls_ip

