$PBExportHeader$sup_caractere.srf
$PBExportComments$Supprime les espaces dans une chaîne de caractères
global type sup_caractere from function_object
end type

forward prototypes
global function string sup_caractere (character car, string chaine)
end prototypes

global function string sup_caractere (character car, string chaine);// Retourne une chaine qui enlève le premier caractère car trouvé dans la string chaine
// Utile pour virer un " au milieu d'une string pour lien Word



integer l,i
string retour = ""
boolean premier_trouve = false

l = len(trim(chaine))

for i = 1 to l

	if mid(chaine, i ,1) = car  then 
		if premier_trouve then 
			retour = retour + mid(chaine,i,1)
		else
			premier_trouve = true
		end if
	else
		retour = retour + mid(chaine,i,1)
	end if
next

return retour
end function

