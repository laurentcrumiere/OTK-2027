table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(10) updatewhereclause=yes name=soins_type dbname="soins.type" dbalias=".type" )
 column=(type=decimal(0) updatewhereclause=yes name=facture_numero dbname="facture.numero" dbalias=".numero" )
 column=(type=date updatewhereclause=yes name=facture_date dbname="facture.date" dbalias=".date" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" dbalias=".numero" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" dbalias=".date_demande" initial="null" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_scp_demande dbname="soins.scp_demande" dbalias=".scp_demande" initial="null" )
 column=(type=char(1) updatewhereclause=yes name=patient_adulte dbname="patient.adulte" dbalias=".adulte" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" dbalias=".nom" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" dbalias=".lettre" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" dbalias=".total" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_hn dbname="soins.hn" dbalias=".hn" )
 column=(type=number updatewhereclause=yes key=yes name=soins_cle dbname="soins.cle" dbalias=".cle" initial="zero" )
 column=(type=number updatewhereclause=yes key=yes name=soins_code dbname="soins.code" dbalias=".code" )
 column=(type=date update=yes updatewhereclause=yes name=soins_transfert dbname="soins.transfert" dbalias=".transfert" )
 column=(type=char(20) updatewhereclause=yes name=patient_code_comptable dbname="patient.code_comptable" dbalias=".code_comptable" )
 column=(type=char(20) updatewhereclause=yes name=prati_code_comptable dbname="prati.code_comptable" dbalias=".code_comptable" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"facture~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"facture.numero~") COLUMN(NAME=~"facture.date~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"patient.adulte~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"soins.transfert~") COLUMN(NAME=~"patient.code_comptable~") COLUMN(NAME=~"prati.code_comptable~")    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"facture.numero~"    OP =~"=~"RIGHT=~"soins.numero_facture~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"patient.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )WHERE(    EXP1 =~"~~~"facture~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":v_date1 and :v_date2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(case when ~~~"soins~~~".~~~"transfert~~~"  is null then 1 else 2 end)~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":v_praticien~" ) ) ARG(NAME = ~"v_praticien~" TYPE = string)  ARG(NAME = ~"v_date1~" TYPE = date)  ARG(NAME = ~"v_date2~" TYPE = date) " update="soins" updatewhere=0 updatekeyinplace=no arguments=(("v_praticien", string),("v_date1", date),("v_date2", date))  sort="facture_numero A facture_date A code A " )
