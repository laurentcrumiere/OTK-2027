 column=(type=decimal(5) updatewhereclause=yes name=param_euro dbname="param.euro" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(500) updatewhereclause=yes name=prati_chemin_complet_signature dbname="prati.chemin_complet_signature" )
 column=(type=char(1) updatewhereclause=yes name=fse_edite dbname="soins.fse_edite" )
 column=(type=date updatewhereclause=yes name=date_fs dbname="soins.date_fs" )
 column=(type=char(15) updatewhereclause=yes name=numero_fse dbname="soins.numero_fse" )
 column=(type=char(100) updatewhereclause=yes name=ar_eattest dbname="soins.ar_eattest" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"param~" ) COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.date_accord~") COLUMN(NAME=~"soins.scp_accord~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"soins.tp~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"prati.typort~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"prati.cadre_bas_page~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"soins.date_impr~") COLUMN(NAME=~"soins.date_donne~") COLUMN(NAME=~"soins.date_rapport~") COLUMN(NAME=~"soins.comment~") COLUMN(NAME=~"param.edition_entete_visible~") COLUMN(NAME=~"param.edition_baspage_visible~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"code_soins.valeur~") COLUMN(NAME=~"soins.date_exe~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"code_soins.nom~") COMPUTE(NAME=~"(SELECT min(~~~"ligne_soins~~~".~~~"date~~~")  FROM ligne_soins WHERE ligne_soins.code = soins.code and ligne_soins.cle = soins.cle) AS date_ligne~") COLUMN(NAME=~"param.euro~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"prati.chemin_complet_signature~") COLUMN(NAME=~"soins.fse_edite~") COLUMN(NAME=~"soins.date_fs~") COLUMN(NAME=~"soins.numero_fse~") COLUMN(NAME=~"soins.ar_eattest~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~" ~~~"soins~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_demande~~~"~"   OP =~">=~"    EXP2 =~":date_debut~" ) ) ARG(NAME = ~"nocode~" TYPE = number)  ARG(NAME = ~"date_debut~" TYPE = date)  ARG(NAME = ~"monnaie~" TYPE = string) " arguments=(("nocode", number),("date_debut", date),("monnaie", string))  sort="date_demande A date_ligne A code_soins_nom A numero A " )
