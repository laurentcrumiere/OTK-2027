 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_prelevements~" )  TABLE(NAME=~"prelevements~" )  TABLE(NAME=~"utilisateurs~" ) COLUMN(NAME=~"prelevements.date_generation~") COLUMN(NAME=~"prelevements.commentaire~") COLUMN(NAME=~"prelevements.user_modif~") COLUMN(NAME=~"ligne_prelevements.date_prelevement~") COLUMN(NAME=~"ligne_prelevements.montant_prelevement~") COLUMN(NAME=~"utilisateurs.nom~")    JOIN (LEFT=~"prelevements.user_modif~"    OP =~"=~"RIGHT=~"utilisateurs.code~"    OUTER1 =~"prelevements.user_modif~" )    JOIN (LEFT=~"prelevements.code~"    OP =~"=~"RIGHT=~"ligne_prelevements.code_prelevement~" )WHERE(    EXP1 =~"~~~"ligne_prelevements~~~".~~~"code_prelevement~~~"~"   OP =~"=~"    EXP2 =~":v_code_prelevement~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ligne_prelevements~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":v_code_patient~" ) ) ARG(NAME = ~"v_code_prelevement~" TYPE = number)  ARG(NAME = ~"v_code_patient~" TYPE = number) " arguments=(("v_code_prelevement", number),("v_code_patient", number))  sort="prelevements_date_generation A prelevements_commentaire A prelevements_user_modif A ligne_prelevements_date_prelevement A ligne_prelevements_montant_prelevement A " )
