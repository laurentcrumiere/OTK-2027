public subroutine get_infos ();// recupère les données d'Orthokis.ini


// Recto Haut
renouv_identification_x.text = profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_identification_x", "0")
renouv_identification_y.text = profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_identification_y", "0")

renouv_r_x.text = profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_r_x", "0")
renouv_r_y.text = profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_r_y", "0")

renouv_hr_x.text = profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_hr_x", "0")
renouv_hr_y.text = profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_hr_y", "0")

