 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient_lien_parente~" )  TABLE(NAME=~"patient~" ALIAS=~"patient_a~" )  TABLE(NAME=~"patient~" ALIAS=~"patient_b~" ) COLUMN(NAME=~"patient_lien_parente.code_patient1~") COLUMN(NAME=~"patient_lien_parente.code_lien_parente~") COLUMN(NAME=~"patient_lien_parente.code_patient2~") COLUMN(NAME=~"patient_a.nom~") COLUMN(NAME=~"patient_a.prenom~") COLUMN(NAME=~"patient_b.nom~") COLUMN(NAME=~"patient_b.prenom~") COMPUTE(NAME=~"patient_a.nom + (case when ~~~"patient_a~~~".~~~"prenom~~~" is null then '' else ' ' + ~~~"patient_a~~~".~~~"prenom~~~" end) as nom_complet_patient1~") COMPUTE(NAME=~"patient_b.nom + (case when ~~~"patient_b~~~".~~~"prenom~~~" is null then '' else ' ' + ~~~"patient_b~~~".~~~"prenom~~~" end) as nom_complet_patient2~") COLUMN(NAME=~"patient_lien_parente.liaison_financiere~") COLUMN(NAME=~"patient_lien_parente.synchroniser~") COLUMN(NAME=~"patient_lien_parente.meme_assure~")    JOIN (LEFT=~"patient_lien_parente.code_patient1~"    OP =~"=~"RIGHT=~"patient_a.code~" )    JOIN (LEFT=~"patient_lien_parente.code_patient2~"    OP =~"=~"RIGHT=~"patient_b.code~" )WHERE(    EXP1 =~"~~~"patient_lien_parente~~~".~~~"code_patient1~~~"~"   OP =~"=~"    EXP2 =~":v_patient1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient_lien_parente~~~".~~~"code_patient2~~~"~"   OP =~"=~"    EXP2 =~":v_patient2~" ) ) ARG(NAME = ~"v_patient1~" TYPE = number)  ARG(NAME = ~"v_patient2~" TYPE = number) " update="patient_lien_parente" updatewhere=0 updatekeyinplace=no arguments=(("v_patient1", number),("v_patient2", number)) )
