type variables
double 		var_code_local
datawindow 	dw_locale		// Contient la dw des éditions ou des documents
datawindow 	dw_locale_reference	// Idem la précédente - pour servir de référence à la mise à jour de Téa ... si on retrieve dw_locale faut retrieve dw_locale_reference
w_patient_ged 	w_locale
string var_type_histo

private constant string col_dw_histo_code = "historique_editions_code"
private constant string col_dw_histo_date_docu = "historique_editions_date_document"
private constant string col_dw_histo_date_histo = "historique_editions_date_modif"
private constant string col_dw_histo_libelle = "historique_editions_libelle"
private constant string col_dw_histo_fichier = "historique_editions_nom_courrier"
private constant string col_dw_histo_type = "historique_editions_code_courrier"
private constant string col_dw_histo_nature = "historique_editions_nature"

integer i_type_moulage = 1		// 1 = moulage normal ; 2 = moulage myray_as

string type_gestion	


end variables

