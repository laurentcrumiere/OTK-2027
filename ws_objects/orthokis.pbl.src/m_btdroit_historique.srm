event clicked;string fichier_pdf

string chemin_complet_courrier

string v_path, v_nom_fichier_avec_extention, v_nom_fichier_sans_extention, v_nouveau_fichier_pdf

boolean v_suite

long row

row = dw_locale.getSelectedRow( 0 )

if row > 0 then
	open(w_patience)
	
	// fichier Word !
	
	v_path = dir_photos + string(var_code_local)+"\"
	chemin_complet_courrier = v_path + dw_locale.getItemString( dw_locale.getSelectedRow( 0 )  , "historique_editions_nom_courrier")
	v_nom_fichier_avec_extention = gfx_extraire_nom_fichier(chemin_complet_courrier)
	
	v_nom_fichier_sans_extention = gfx_fichier_sans_extension(v_nom_fichier_avec_extention)
	
	// On récupère la catégorie du document pour que le PDF généré la reprenent ...
	integer v_id_categorie 
	 v_id_categorie = dw_locale.getitemNumber(row, "historique_editions_id_categorie")

	// Conversion en PDF !!!
	fichier_pdf = fxg_get_nom_fic_document_orthokis_pdf()
	
	// On vire le précédent si ...
	FileDelete(fichier_pdf)
	
	fxg_conversion_word_to_pdf(chemin_complet_courrier, fichier_pdf )

	
	If FileExists(fichier_pdf) then
		// La converion a réussie
		// Copie du fichier dans le dossier du patient
		v_nouveau_fichier_pdf = v_path + v_nom_fichier_sans_extention  + ".pdf"
		
		v_suite = true
		if FileExists(v_nouveau_fichier_pdf) then
			if Messagebox("ATTENTION", "Le fichier " + v_nouveau_fichier_pdf + " existe déjà.~n~nVoulez-vous poursuivre et le remplacer ?", Question!, YesNo!, 2) = 1 then
				v_suite = true
			else
				v_suite = false
			end if
		else
			v_suite = true
		end if
				
		// Mémoridsation
		if v_suite then
			if FileCopy(fichier_pdf , v_nouveau_fichier_pdf, true) <> 1 then
				Messagebox("ATTENTION", "Une erreur s'est produite dans le recopie du fichier : " + fichier_pdf + "~n~nvers le fichier : "+ v_nouveau_fichier_pdf)
			else
				// la copie est OK, on génère la liste en historique
				// 
				fxg_enregcourrierhisto (var_code_local , 'WORPDF' , today() ,  dw_locale.getItemString( dw_locale.getSelectedRow( 0 )  , "historique_editions_libelle")  ,v_nouveau_fichier_pdf , type_gestion, "N" , "O", "", v_id_categorie)
				if utilisation_distante then
					// Mémo du fichier en vue du retour au cabinet
					fxg_ajout_acquis_distante ( var_code_local , v_nouveau_fichier_pdf ) 
				end if
				
				// Raffraichissement de la liste
				w_locale.pb_rafraichir_courrier.triggerEvent(clicked!)
			end if
		end if
		
	else
		Messagebox("ATTENTION","La conversion du document en PDF a échoué.")
	end if
	
	close(w_patience)
end if
end event

type m_a_lire from menu within m_btdroit_historique
end type

on m_a_lire.create
call super::create
this.text = "Important - A lire"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.menuanimation = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_a_lire.destroy
call super::destroy
end on

event clicked;long 		ligne_selectionnee

ligne_selectionnee = dw_locale.getSelectedRow( 0 )


if ligne_selectionnee > 0 then
	
	if dw_locale.GetItemString( ligne_selectionnee , "a_lire" ) = 'O' then
		dw_locale.SetItem( ligne_selectionnee , "a_lire", "N" )
	else
		dw_locale.SetItem( ligne_selectionnee , "a_lire", "O" )
	end if
	dw_locale.update()
	commit ;

end if

end event

