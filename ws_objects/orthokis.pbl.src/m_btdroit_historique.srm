event clicked;string		recup_libelle_courrier, libelle_courrier
date	 	recup_date
string 	recup_type_document
string 	recup_fichier_document
integer 	resultat_copy
string 	recup_effacer_fichier
integer   recup_nb_acquisitions, cpt_acquisition, recup_categorie
string fichier_depart, fichier_arrivee, dossier_arrivee
string aleatoire, garder_nom_fichier

openWithParm (w_patient_ajout_courrier_word, 3)



if var_suite then
	
	open(w_patience)
	
	// les fichiers à acquerir sont dans      fichiers_a_acquerir[]   variable globale
	recup_date = date(param_win[1])
	recup_libelle_courrier = param_win[2]
	recup_type_document = param_win[3]
	recup_fichier_document = param_win[4]
	recup_effacer_fichier = param_win[5]
	recup_categorie = integer( param_win[8] )
	garder_nom_fichier = param_win[9]
	
	recup_nb_acquisitions =  integer( param_win[6] )
	
		
	
	for cpt_acquisition = 1 to recup_nb_acquisitions
	
		
		fichier_depart = fichiers_a_acquerir[cpt_acquisition]
		
		if fileExists(fichier_depart) then
			dossier_arrivee = fxg_get_rep_photos( ) + string(var_code_local)
			// on rajoute un élément alétoire pour rendre unique le nom
			Randomize(minute(now()) * second(now()))
			aleatoire = string(rand(65000))
			fichier_arrivee =  dossier_arrivee + win_delimiter +aleatoire+ gfx_extraire_nom_fichier(fichier_depart)
			
			// Test de l'existence du dossier de destination
			if not DirectoryExists( dossier_arrivee ) then
				// faut le créér
				if gfx_creer_rep( dossier_arrivee ) <> 1 then 
					MessageBox("ERREUR DANS LA CREATION DU DOSSIER DE DESTINATION","Impossible de créer le dossier : "+dossier_arrivee)
					var_suite = false
				end if
			end if
		else
			var_suite = false
			MessageBox("ERREUR DANS RECUPERATION DU FICHIER","Le fichier à ajouter n'existe pas (ou plus) : "+fichier_depart)
		end if

		if var_suite then		
		
			var_suite = false
			resultat_copy = FileCopy (fichier_depart,fichier_arrivee, false ) 
			
			choose case resultat_copy
				case 1 
					// La copie a marché
					var_suite = true
					if utilisation_distante then
						// Mémo du fichier en vue du retour au cabinet
						fxg_ajout_acquis_distante ( var_code_local , fichier_arrivee ) 
					end if
					
					if recup_effacer_fichier = "O" and fileExists(fichier_depart) then
						FileDelete(fichier_depart)
					end if

				case -1
					MessageBox("ERREUR DANS LA COPIE DU FICHIER","Impossible de trouver le fichier : "+fichier_depart)
				case -2
					MessageBox("ERREUR DANS LA COPIE DU FICHIER","Impossible d'écrire le fichier : " + fichier_arrivee + "~n~nIl est possible que vous n'ayez pas les droits nécessaires ou que le fichier existe déjà")
			end choose
		end if
		
		if var_suite then
			if garder_nom_fichier = "O" then
				recup_libelle_courrier = gfx_extraire_nom_fichier(fichier_depart) 
			end if
			fxg_enregcourrierhisto(var_code_local, recup_type_document, recup_date, recup_libelle_courrier,  aleatoire + gfx_extraire_nom_fichier(fichier_depart) , 'D', "N", 'N', '', recup_categorie)
		end if
	next

	
	dw_locale.AcceptText()
	if dw_locale.update() = 1 then
		commit ;
	else
		rollback ;
	end if
	dw_locale.retrieve( var_code_local,'D' )
	if TEA then
		dw_locale_reference.retrieve( var_code_local, "D" )
	end if

	close(w_patience)

end if

end event

type m_ajouterunmoulage from menu within m_btdroit_historique
end type

event clicked;string		recup_libelle_courrier, libelle_courrier
date	 	recup_date
string 	recup_type_document
string 	recup_fichier_document
integer 	resultat_copy
string 	recup_effacer_fichier
integer   recup_nb_acquisitions, cpt_acquisition, recup_categorie, nb_acquisition_ok
string 	recup_fichier_document2 
boolean  ok_fichier_depart

var_suite = false

openWithParm(w_patient_ajout_courrier_word, i_type_moulage)


if var_suite then
	
	recup_date = date(param_win[1])
	recup_libelle_courrier = param_win[2]
	recup_type_document = param_win[3]
	recup_fichier_document = param_win[4]
	recup_effacer_fichier = param_win[5]
	
	recup_nb_acquisitions = integer(param_win[6])
	var_suite  = true
	
	recup_fichier_document2 = param_win[7]
	recup_categorie = integer(param_win[8])

	if len(trim(recup_fichier_document)) > 0 or len(trim(recup_fichier_document2)) > 0 then
		
		// Y a un nom de fichier 
		// Recopie du fichier 
		string fichier_depart, fichier_arrivee, dossier_arrivee

		// on rajoute un élément alétoire pour rendre unique le nom - idem si 2 fichiers STL 
		string aleatoire
		Randomize ( Minute ( now() ) * second ( now() ) )
		aleatoire = string(rand(65000))

		nb_acquisition_ok = 0 
		
		for cpt_acquisition = 1 to recup_nb_acquisitions
		
			ok_fichier_depart = false
			var_suite = true
			
			dossier_arrivee = fxg_get_rep_photos( ) + string(var_code_local)
			fichier_depart = trim(recup_fichier_document)
			if cpt_acquisition = 1 and len(fichier_depart) > 0 then
				ok_fichier_depart  = fileExists(fichier_depart)
				fichier_depart = trim(recup_fichier_document)
				libelle_courrier = recup_libelle_courrier
				//fichier_arrivee =  dossier_arrivee + win_delimiter +aleatoire+ "mandibular." + gfx_extraire_extension_fichier(fichier_depart)
				fichier_arrivee =  dossier_arrivee + win_delimiter +aleatoire+ "lower." + gfx_extraire_extension_fichier(fichier_depart)
			else
				fichier_depart = trim(recup_fichier_document2)
				if cpt_acquisition = 2 and len(fichier_depart) > 0 then
					ok_fichier_depart  = fileExists(fichier_depart)
					libelle_courrier = recup_libelle_courrier
					fichier_arrivee =  dossier_arrivee + win_delimiter +aleatoire + "upper." + gfx_extraire_extension_fichier(fichier_depart)
				end if
			end if

			if ok_fichier_depart then
				
				// Test de l'existence du dossier de destination
				if not DirectoryExists( dossier_arrivee ) then
					// faut le créér
					if gfx_creer_rep( dossier_arrivee ) <> 1 then 
						MessageBox("ERREUR DANS LA CREATION DU DOSSIER DE DESTINATION","Impossible de créer le dossier : "+dossier_arrivee)
						var_suite = false
					end if
				end if
			else
				var_suite = false
				// Il peut y avoir fichier_depart = "" dans l'acquisition myRay AS si on ne recupère que le bas => pas d'erreur
				//MessageBox("ERREUR DANS RECUPERATION DU FICHIER","Le fichier à ajouter n'existe pas (ou plus) : "+fichier_depart)
			end if
	
			if var_suite then		
			
				var_suite = false
				resultat_copy = FileCopy (fichier_depart,fichier_arrivee, false ) 
				
				choose case resultat_copy
					case 1 
						// La copie a marché
						var_suite = true
						if utilisation_distante then
							// Mémo du fichier en vue du retour au cabinet
							fxg_ajout_acquis_distante ( var_code_local , fichier_arrivee ) 
						end if
						
						if recup_effacer_fichier = "O" and fileExists(fichier_depart) then
							FileDelete(fichier_depart)
						end if
						
						nb_acquisition_ok = nb_acquisition_ok + 1 
						
						if i_type_moulage = 2  then
							// Ajout my Ray / As connect => message car on est pas sur la fenetre classique
							if (cpt_acquisition = recup_nb_acquisitions) or (nb_acquisition_ok = 1 and ( trim(recup_fichier_document) = "" or  trim(recup_fichier_document2) = "" ))  then
								if nb_acquisition_ok = 1 then 
									Messagebox("INFORMATION","1 fichier a été acquis avec succés !")
								else
									Messagebox("INFORMATION", string(nb_acquisition_ok) + " fichiers ont été acquis avec succés !")
								end if
							end if
						end if
	
					case -1
						MessageBox("ERREUR DANS LA COPIE DU FICHIER","Impossible de trouver le fichier : "+fichier_depart)
					case -2
						MessageBox("ERREUR DANS LA COPIE DU FICHIER","Impossible d'écrire le fichier : " + fichier_arrivee + "~n~nIl est possible que vous n'ayez pas les droits nécessaires ou que le fichier existe déjà")
				end choose
			end if
			
			if var_suite then
				fxg_enregcourrierhisto(var_code_local, recup_type_document, recup_date, libelle_courrier, gfx_extraire_nom_fichier(fichier_arrivee) , 'D', "N", "N", "", recup_categorie)
			end if
		next
	end if
	
	
	dw_locale.AcceptText()
	if	dw_locale.update() = 1 then
		commit ;
	else
		rollback ;
	end if
	dw_locale.retrieve( var_code_local,'D' )
	if TEA then
