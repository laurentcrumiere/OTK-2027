event clicked;string		recup_libelle_courrier, libelle_courrier
date	 	recup_date
string 	recup_type_document
string 	recup_fichier_document
integer 	resultat_copy
string 	recup_effacer_fichier
integer   recup_nb_acquisitions, cpt_acquisition, recup_categorie


var_suite = false

openWithParm (w_patient_ajout_courrier_word, 0)


if var_suite then
	var_suite = false
	
	recup_date = date(param_win[1])
	recup_libelle_courrier = param_win[2]
	recup_type_document = param_win[3]
	recup_fichier_document = param_win[4]
	recup_effacer_fichier = param_win[5]
	recup_categorie = integer( param_win[8] )
	
	recup_nb_acquisitions = integer(param_win[6])
	var_suite  = true
	
	if len(trim(recup_fichier_document)) > 0 then
		
		// Y a un nom de fichier 
		// Recopie du fichier 
		string fichier_depart, fichier_arrivee, dossier_arrivee
		
		
		for cpt_acquisition = 1 to recup_nb_acquisitions
		
			
			if recup_nb_acquisitions = 1 then 
				fichier_depart = trim(recup_fichier_document)
				libelle_courrier = recup_libelle_courrier
			else
				fichier_depart = trim(recup_fichier_document)+"-"+string(cpt_acquisition)+".jpg"
				libelle_courrier = recup_libelle_courrier+ " ("+string(cpt_acquisition)+"/"+string(recup_nb_acquisitions)+")"
			end if
			
			if fileExists(fichier_depart) then
				dossier_arrivee = fxg_get_rep_photos( ) + string(var_code_local)
				// on rajoute un élément alétoire pour rendre unique le nom
				string aleatoire
				Randomize(minute(now()) * second(now()))
				aleatoire = string(rand(65000))
				fichier_arrivee =  dossier_arrivee + win_delimiter +aleatoire+ gfx_extraire_nom_fichier(fichier_depart)
				
				// Test de l'existence du dossier de destination
				if not DirectoryExists( dossier_arrivee ) then
					// faut le créér
					if gfx_creer_rep( dossier_arrivee ) <> 1 then 
						MessageBox("ERREUR DANS LA CREATION DU DOSSIER DE DESTINATION","Impossible de créer le dossier : "+dossier_arrivee)
						var_suite = false
					end if
				end if
			else
				var_suite = false
				MessageBox("ERREUR DANS RECUPERATION DU FICHIER","Le fichier à ajouter n'existe pas (ou plus) : "+fichier_depart)
			end if
	
			if var_suite then		
			
				var_suite = false
				resultat_copy = FileCopy (fichier_depart,fichier_arrivee, false ) 
				
				choose case resultat_copy
					case 1 
						// La copie a marché
						var_suite = true
						if utilisation_distante then
							// Mémo du fichier en vue du retour au cabinet
							fxg_ajout_acquis_distante ( var_code_local , fichier_arrivee ) 
						end if
						
						if recup_effacer_fichier = "O" and fileExists(fichier_depart) then
							FileDelete(fichier_depart)
						end if
	
					case -1
						MessageBox("ERREUR DANS LA COPIE DU FICHIER","Impossible de trouver le fichier : "+fichier_depart)
					case -2
						MessageBox("ERREUR DANS LA COPIE DU FICHIER","Impossible d'écrire le fichier : " + fichier_arrivee + "~n~nIl est possible que vous n'ayez pas les droits nécessaires ou que le fichier existe déjà")
				end choose
			end if
			
			if var_suite then
				fxg_enregcourrierhisto(var_code_local, recup_type_document, recup_date, libelle_courrier,  aleatoire + gfx_extraire_nom_fichier(fichier_depart) , 'D', "N", 'N', '', recup_categorie)
			end if
		next
	end if
	
	
	dw_locale.AcceptText()
	if	dw_locale.update() = 1 then
		commit ;
	else
		rollback ;
	end if
	dw_locale.retrieve( var_code_local,'D' )
	if TEA then
		dw_locale_reference.retrieve( var_code_local, "D" )
	end if

end if

end event

