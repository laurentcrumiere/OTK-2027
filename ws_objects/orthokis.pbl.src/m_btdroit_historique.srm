event clicked;


string	chemin_complet_courrier, rep_photo
long lig, nb_fichier_a_envoyer, tot
string fichiers_a_envoyer[]
boolean v_suite
long taille_totale, i

// Depuis 2016, on peut sélectionner plusieurs lignes
v_suite = true
lig = dw_locale.Find("Selection = 'O'", 0, 99999)

if lig = 0 then
	if dw_locale.getSelectedRow( 0 )> 0 then
		// ligne courrante
		nb_fichier_a_envoyer = 1
		fichiers_a_envoyer[1] = dir_photos + string( var_code_local ) + win_delimiter + dw_locale.getItemString( dw_locale.getSelectedRow( 0 ), "historique_editions_nom_courrier")
		if FileExists(fichiers_a_envoyer[1]) then
			v_suite = true
		else
			v_suite = false
			Messagebox("ATTENTION","La ligne que vous avez sélectionnée ne contient pas de document à joindre !")
		end if
	else
		nb_fichier_a_envoyer =  0
		v_suite = false
	end if
else
	// 1 ou plusieurs lignes
	tot = dw_locale.rowcount() 
	nb_fichier_a_envoyer = 0
	for lig = 1 to tot
		if dw_locale.GetItemString(lig, "Selection") = "O" then
			nb_fichier_a_envoyer = nb_fichier_a_envoyer + 1
			fichiers_a_envoyer[nb_fichier_a_envoyer] = dir_photos + string( var_code_local ) + win_delimiter + dw_locale.getItemString( lig, "historique_editions_nom_courrier")
			if not FileExists(fichiers_a_envoyer[nb_fichier_a_envoyer]) then
				fichiers_a_envoyer[nb_fichier_a_envoyer] = ""
				nb_fichier_a_envoyer = nb_fichier_a_envoyer - 1 
			end if
		end if
	next
	if nb_fichier_a_envoyer > 0 then
		v_suite = true
	else
		v_suite = false
			Messagebox("ATTENTION","Les lignes que vous avez sélectionnées ne contiennent pas de document à joindre !")
	end if
end if
	

if v_suite then


	open(w_patience)

	uo_email_compte		cpt_email
	uo_email_email 		email
	str_email_frm_output		frm_output
	
	
	
	integer id_cpt
	
	id_cpt = compte_email_a_utiliser(utilisateur_code, var_code_local)

	if id_cpt = -1 then
		
		MessageBox("ATTENTION","Vous devez définir des Comptes Emails pour chaque praticien avant d'envoyer des emails (menu 'Tables', 'Administratif').~n~nCeci ne semble pas être le cas.~n~nL'envoi de l'email ne peut avoir lieu.")
		
	else
		
		taille_totale = 0
		if nb_fichier_a_envoyer > 1 then
			for lig = 1 to nb_fichier_a_envoyer
				taille_totale = taille_totale +  FileLength(fichiers_a_envoyer[lig])
			next
		end if
		
		v_suite = false
		
		// on convertit en Mo
		taille_totale = taille_totale / 1024 / 1024
		
		if taille_totale > 3 then 
			if Messagebox("ATTENTION","Vous allez envoyer "+string(nb_fichier_a_envoyer)+" documents en Pièces Jointes.~nTaille des fichiers : " + string(taille_totale , "0.0") +" Mo~n~nConfirmez-vous ?",Question!,YesNo!,2) = 2 then 
				v_suite = false
			else
				v_suite = true
			end if
		else
			v_suite = true
		end if

		if v_suite then
			// init cpt mail et affection au mail manager
			cpt_email = create uo_email_compte
			cpt_email.charger(id_cpt)
			email_manager.set_compte(cpt_email)
			
			// Envoi unitaire
			email_manager.propos_objet = cpt_email.email_objet_defaut
			email_manager.mode_choix_adr_courant = email_manager.mode_choix_adr_unitaire
			
			
			// Fenetre de choix du destinataire
			
			// Génératon du fichier rtf pour passage en paramètre
			string is_FileName, fichier_pdf
			integer num_fichier_texte
		
			is_FileName = dir_ini + "texte_email_tmp.rtf"
			num_fichier_texte = FileOpen( is_FileName, StreamMode! , Write! , LockWrite! , replace!)
			FileWrite(num_fichier_texte, cpt_email.texte_brut_defaut)
			FileClose(num_fichier_texte)
			
			
			// pour les fichiers joints
			
			str_patient v_patient
			v_patient.code = var_code_local
			
			if nb_fichier_a_envoyer = 1 then
				// on permettra le PDF uniquement si 1 fichier Word ... sinon, on fait comme si Powerpoint pour ne pas proposer PDF
				string extension 
				extension = upper(gfx_extraire_extension_fichier ( fichiers_a_envoyer[1] ) )
				
				if extension = "DOC" or extension = "DOCX" then
					v_patient.appelant = 'W'	// courrier Word 
				else
					if extension = "PDF" then
						v_patient.appelant = 'D'	// Doc PPT
					else
						if extension = "PPT" or extension = "PPTX" then 
							v_patient.appelant = 'P'	// Doc PPT
						else
							v_patient.appelant = 'O'	// Doc autre
						end if
					end if
				end if
			else
					v_patient.appelant = 'P'	// Doc PPT
			end if
			
			openwithparm(w_email_choix_adr_pat, v_patient)
			
			
			//cpt_email.texte_brut_defaut = param_win[1]
			
			// réception des éléments de la fenêtre précédente
			frm_output = message.PowerObjectParm
			
			// Sécurité pour éviter de renvoyer du vide
			if upperbound( frm_output.a_adrs_cci ) = 0 then
				frm_output.a_adrs_cci[1] = ""
			end if
			
			if upperbound( frm_output.a_adrs ) = 0 then
				frm_output.a_adrs[1] = ""
			end if
			

									
			if frm_output.a_adrs[1] <> ''  or frm_output.a_adrs_cci[1] <> '' then			// correspond au bouton annuler de la fenêtre de choix d'adresse
			
			
				if frm_output.envoi_securise then
					
					// 2024
					// il faut ajouter les fichier supplémentaires 
					for i = 1 to upperbound(frm_output.pj_supplementaires)
						fichiers_a_envoyer[upperbound(fichiers_a_envoyer) + 1 ] = frm_output.pj_supplementaires[i]
					next

					
					if Belgique then
						// envoi messagerie spéciale via myOrthokis
						// Envoi unitaire
						fxg_envoi_mail_securise_ehealth(frm_output , var_code_local, email, fichiers_a_envoyer)
					else
						if France then 
							fxg_envoi_mail_securise_france(frm_output , var_code_local, email, fichiers_a_envoyer)
						end if
					end if
				
				else
	
					// Envoi normal
					string fichier_texte, fichier_texte_patient
					integer num_fichier_texte_avec_adresses
					string fichier_texte_avec_adresses
					
					fichier_texte = dir_ini + "texte_email_tmp.html"
					fichier_texte_avec_adresses = dir_ini + "texte_email_adresses_tmp.text"
					fichier_texte_patient = dir_photos + string(var_code_local) + win_delimiter + string(today(), "yyyy-mm-dd")+" "+string(now(),"hh-mm-ss") + " - Texte email.html"
					
					//creation et envoie email
					email = create uo_email_email
					email.set_patient(var_code_local)
					email.add_destinataire_a(frm_output.a_adrs[1], false)
					email.set_from(cpt_email.my_alias,cpt_email.my_adr)
					email_manager.propos_objet = frm_output.objet 
					email.set_sujet(email_manager.propos_objet)
					if frm_output.cc then 
						email.set_cc(cpt_email.my_alias, cpt_email.my_adr)
					end if
					
					if trim(frm_output.a_adrs_cci[1])  <> "" then
						// Il y a des destinataires CCi 
						string s_cci
						
						s_cci = frm_output.a_adrs_cci[1]
						
						if frm_output.cci then 
							s_cci = s_cci + ";" +  cpt_email.my_adr
						end if
						
						email.add_destinataire_a(s_cci, true)
					else
						if frm_output.cci then 
							email.set_cci(cpt_email.my_alias, cpt_email.my_adr)
						end if
					end if
					

//					if frm_output.cci then 
//						email.set_cci(cpt_email.my_alias, cpt_email.my_adr)
//					end if
//					
					if frm_output.pdf then
						// il faut envoyer le fichier en PDF 
						// Faut d'abord le convertir !!!
						fichier_pdf = fxg_get_nom_fic_document_orthokis_pdf()
					
						fxg_conversion_word_to_pdf(fichiers_a_envoyer[1] , fichier_pdf )
						

						// On mémorise désormais le PDF en PJ pour pouvoir le revoir ensuite
						string fichier_pdf_patient 
						fichier_pdf_patient = dir_photos + string(var_code_local) + win_delimiter + string(today(), "yyyy-mm-dd")+" "+string(now(),"hh-mm-ss") + " - Document_Orthokis.pdf" 
						FileCopy(fichier_pdf , fichier_pdf_patient)
						email.add_fichier_joint(fichier_pdf_patient)
						
					else
						// On envoie les fichiers en tant que Pièce jointe !!!
						
						for lig = 1 to nb_fichier_a_envoyer
							email.add_fichier_joint(fichiers_a_envoyer[lig])
						next
					end if
					
					
					// On ajoute les éventuelles PJ supplémentares ... 
					for lig = 1 to upperbound(frm_output.pj_supplementaires[])
						email.add_fichier_joint(frm_output.pj_supplementaires[lig])
					next
								
					email.set_body_html(fichier_texte)
												
					if email_manager.envoyer_email(email.get_email()) then
						
						// On génère un fichier texte contenant la liste des destinataires ... meme nom que le fichier en PJ avec .dest comme extension
						email.generer_fichier_adresses(fichier_texte_avec_adresses, fichier_texte_patient, frm_output)
						
						
						// Copy du fichier pour mémo
						FileCopy(fichier_texte, fichier_texte_patient)
		
						string libelle_sup = ""
						if frm_output.pdf then 
							libelle_sup = " - Format PDF"
						end if
		
						string v_code_interne_historique_editions
						if nb_fichier_a_envoyer = 1 then
							v_code_interne_historique_editions = fxg_enregcourrierhisto ( var_code_local , "EMAIPJ" , today() , "Envoi fichier : " + gfx_extraire_nom_fichier(fichiers_a_envoyer[1]) + libelle_sup , fichier_texte_patient , 'E' , "N", "N", "", frm_output.categorie)
						else
							v_code_interne_historique_editions = fxg_enregcourrierhisto ( var_code_local , "EMAIPJ" , today() , "Envois de "+ string(nb_fichier_a_envoyer) + " fichiers dont " + gfx_extraire_nom_fichier(fichiers_a_envoyer[1]) , fichier_texte_patient , 'E' , "N", "N", "", frm_output.categorie)
						end if
						
						fxg_memorisation_pieces_jointes(var_code_local, v_code_interne_historique_editions,   email.fichiers_joints, false )
						
						// Raffraichissement de la liste
						if isvalid(w_locale) then
							// w_locale contient en principe la fenetre w_patient_maj mais on peut récupérer le code pour envoyer autres documents par email => pas de w_locale
							w_locale.pb_rafraichir_courrier.triggerEvent(clicked!)
						end if
			
						// Le fichier est parti
						MessageBox("INFORMATION","L'email a été correctement envoyé.")
						
						
					else
						MessageBox("ATTENTION","Une erreur s'est produite dans l'envoi de l'email !")
					end if
				end if
				
				if frm_output.pdf then
					// on efface de suite le temporaire !
					FileDelete(fichier_pdf)
				end if
			end if
		end if
	end if
	close(w_patience)

end if
end event

