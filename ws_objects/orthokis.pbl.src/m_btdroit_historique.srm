private function integer recup_nom_courrier (ref string nom_courrier);// fx qui recup de la datawin le nom du fichier du courrier et le teste
// return 1 si string valide + nom du courrier ds param en ref
//		-1 si pb


// recup du nom du courrier de la datawin
nom_courrier = dw_locale.GetItemString( dw_locale.getSelectedRow( 0 ), col_dw_histo_fichier )
if len(nom_courrier) > 0 then  return 1

return -1

end function

private function integer courrier_valide (ref string chemin_complet_courrier);// fx qui construit le chemin d'accès complet au courrier de 
// la ligne d'historique sélectionner et en vérifie son existance
// retrun 1 si ok + ds param passer en ref le chemin complet
//		-1 si pb


string	nom_courrier,  rep_photo
int		return_val = -1


rep_photo = fxg_get_rep_photos()

if rep_photo <> "" then
 //si recup du rep photos = OK
 	if recup_nom_courrier( nom_courrier ) = 1 then
	// si recup du nom du courrier = OK
		// transfo en rep courrier patient + rajout du nom du courrier
		chemin_complet_courrier = rep_photo + string( var_code_local ) + win_delimiter + nom_courrier
//		if lower(right(chemin_complet_courrier,3))="doc"then
			if FileExists( chemin_complet_courrier ) then
				// maj val retour
				return_val = 1
			else
				messagebox("INFORMATION ...", "Répertoire photo non valide ou libellé du courrier erroné. ~n~nOpération annulée.")
			end if
//		else
//			messagebox("ERREUR ...", "Libellé du courrier erroné ou courrier inexistant. ~n~nOpération annulée.", StopSign!)
//		end if
	end if
else
	messagebox("ERREUR ...", "Impossible de déterminer l'emplacement de sauvegarde des courriers. ~n~nOpération annulée.", StopSign!)
end if

return return_val

end function

public function integer rafraichir_lignes (ref datawindow dw, double num_patient, string tab_nom_fichier[]);// lance une synchronisation lignes historiques/courriers word présent sur DD pour correc le lien si ce dernier est ds les choux !
// suite à bug ds changement num dossier --> on perdait le lien entre courrier sur DD et la ligne
// renvoie 1 si ok , -1 si erreur

if isnull(dw) then return -1
dw_locale	= dw

if isnull(num_patient) or num_patient = 0 then return -1
var_code_local = num_patient

if isnull(tab_nom_fichier) then return -1
long nbr_fichier
nbr_fichier = upperbound(tab_nom_fichier)
if not nbr_fichier > 0 then return -1

string nom_fichier_dw
datetime	date_today
date_today = datetime(today(),now())
string	str_date_time_fichier
string	str_date_time_dw
datetime date_time_fichier
boolean traite
long nbr_dw_row
long dw_ligne_trouve
date date_a_trouver
long new_row
long index_fichier

date v_date_docu
time v_time_docu

dw_locale.retrieve(num_patient, "E")

for index_fichier = 1 to nbr_fichier
	nbr_dw_row = dw_locale.RowCount()
	
	long lig
	
	lig = dw_locale.find(col_dw_histo_fichier + ' =  "'+ tab_nom_fichier[index_fichier] + '"', 1, nbr_dw_row)
	
	if not ( lig  > 0) then
		// lien a retrouver
		// par convention, en prenant les 10 premiers carac du nom d'un fichier courrier enreg
		// on retrouve une date que l'on peut caster (ex = 2006-12-01)
		date_a_trouver = date(left(tab_nom_fichier[index_fichier], 10))
		if not (isnull(date_a_trouver) or date_a_trouver = 1900-01-01) then 
			// c bien un fichier d'historique valide (il commmence par une date)
			traite = false
			dw_ligne_trouve = 1
			dw_ligne_trouve = dw_locale.find(col_dw_histo_date_docu + " = " + string(date_a_trouver,"yyyy-mm-dd"), dw_ligne_trouve, nbr_dw_row)
//			messagebox("trace après",col_dw_histo_date_docu + " = " + string(date_a_trouver,"yyyy-mm-dd"))
			do while dw_ligne_trouve > 0
				// une ligne existante avec cette date de document
				nom_fichier_dw = dw_locale.GetItemString( dw_ligne_trouve, col_dw_histo_fichier)
				if isnull(nom_fichier_dw) or not (len(nom_fichier_dw) > 0) then
					// aucun courrier n'est encore indiqué
					// par convention, en prenant les 17 premiers carac du nom d'un fichier courrier enreg
					// on retrouve la date, les heures et minutes (ex = 2006-12-01  13-51)
					str_date_time_fichier = left(tab_nom_fichier[index_fichier], 17)
					str_date_time_dw = string(dw_locale.GetItemDateTime( dw_ligne_trouve, col_dw_histo_date_histo), "yyyy-mm-dd  hh-mm")
					if str_date_time_fichier = str_date_time_dw then
						// la date de l'historique est identique
						dw_locale.setitem(dw_ligne_trouve,col_dw_histo_fichier  ,tab_nom_fichier[index_fichier])
						traite = true
						exit
					end if
				end if	
				
				// ligne suivante
				dw_ligne_trouve++
				if dw_ligne_trouve > nbr_dw_row then exit
				dw_ligne_trouve = dw_locale.find(col_dw_histo_date_docu + " = " + string(date_a_trouver,"yyyy-mm-dd"), dw_ligne_trouve, nbr_dw_row)
			loop
			if not traite then
				// on insere une nouvelle ligne avec le courrier 'étudié'
				new_row = dw_locale.insertrow(0)
				if new_row >0 then
					dw_locale.setitem(new_row, col_dw_histo_code ,var_code_local)
					
					if right(tab_nom_fichier[index_fichier], 3) = "doc" or right(tab_nom_fichier[index_fichier], 4) = "docx" then
						dw_locale.setitem(new_row, col_dw_histo_type, "WORD")
					else
						if right(tab_nom_fichier[index_fichier], 3) = "ppt" or right(tab_nom_fichier[index_fichier], 4) = "pptx" then
							dw_locale.setitem(new_row, col_dw_histo_type, "DOCPPT")
						else
							// pdf
							dw_locale.setitem(new_row, col_dw_histo_type, "SIGNE")
						end if
					end if
					
					
					dw_locale.setitem(new_row,col_dw_histo_date_docu, date_a_trouver)
					
					// récupération de la date et heure inscrite dans le nom du fichier !!!
					v_date_docu = date(left(tab_nom_fichier[index_fichier], 10))
					v_time_docu = time(trim(mid(tab_nom_fichier[index_fichier], 11, 9))) // on prend une marge car 1 seul espace entre date et heure pour les ppt et 2 espaces pour les autres
					
					dw_locale.setitem(new_row,col_dw_histo_date_histo, datetime(v_date_docu, v_time_docu))
					//dw_locale.setitem(new_row,col_dw_histo_date_histo  ,date_today)
					// en supprimant les 23 premier carac --> on retrouve le nom de fichier orignel
					dw_locale.setitem(new_row,col_dw_histo_libelle  ,trim(right(tab_nom_fichier[index_fichier], len(tab_nom_fichier[index_fichier]) -22 )))
					dw_locale.setitem(new_row,col_dw_histo_fichier ,tab_nom_fichier[index_fichier])
					dw_locale.setitem(new_row,col_dw_histo_nature ,'E')
				end if
			end if
			dw_locale.AcceptText()
			dw_locale.update()
		end if
	end if

next

dw_locale.retrieve( var_code_local, "E" )
if TEA then
	dw_locale_reference.retrieve( var_code_local, "E" )
end if
return 1

end function

public function integer popup (integer x, integer y, ref datawindow dw, double num_patient, string type_histo);// fx qui ouvre en popup menu ce menu (pour la fiche ad, onglet edition)


// type_histo vaut "E" pour Edition, "D" pour Documents, "A" pour actions  .. 


string	nom_courrier

// recup des param en ref
dw_locale	= dw
var_code_local = num_patient
var_type_histo = type_histo


// init du menu
if dw_locale.getSelectedRow( 0 ) > 0 then
	if droits_acces[80] = "O" then
		m_supprimer.enabled = true
	end if
	if var_type_histo = "D" then
		// Documents 
		m_ajouter.enabled = true
		m_ajouterplusieurslignes.enabled = true
		m_ajouterunmoulage.enabled = true
		m_copierledocumentversunautrepatient.enabled = true
		m_copierledocumentverstoutelafratrie.enabled = true
	else
		m_ajouter.enabled = false
		m_ajouterplusieurslignes.enabled = false
		m_ajouterunmoulage.enabled = false
		m_copierledocumentversunautrepatient.enabled = false
		m_copierledocumentverstoutelafratrie.enabled = false
		if SIGNATURE_DENTALSIGN and var_type_histo = "E" then
			m_signaturenumerique.visible = true
		end if
	end if
	if recup_nom_courrier( nom_courrier ) = 1 then
		// si bien un courrier rataché à cette ligne d'histo
		m_visualiserlecourrier.enabled = true
		m_envoyerparemailpiècejointe.enabled = true
		string v_extension
		v_extension = gfx_extraire_extension_fichier(nom_courrier) 
		// Si c'est un courrier Word
		if  v_extension = "doc" or v_extension = "docx" then
			m_imprimerledocument.enabled = true
		else
			m_imprimerledocument.enabled = false
		end if
	else
		m_imprimerledocument.enabled = false
	end if
	
	m_dupliquerledocument.visible = true
end if

// on affiche le menu en popup
this.popmenu(x,y)

// pas de gestion d'erreur
return 1

end function

public subroutine copier_document (string a_qui);

// Copie de document(s) pour un Patient ou une Fratrie, ou duplication pour lui meme

// A_qui = "P" ou "F" ou "D"



string	chemin_complet_courrier, rep_photo
long lig, nb_fichier_a_envoyer, tot
string fichiers_a_envoyer[]
boolean v_suite
string v_libelle1, v_libelle2
double var_code_local_arrivee, var_code_depart
double patients_destination[], nb_patients_destination, cpt
string nom_patients_destination[], var_nom_complet

string fichier_depart, fichier_arrivee, dossier_arrivee
integer resultat_copy
string nom_fichier_seul, s_debut_fichier, nom_fichier_seul_destination
string v_code_interne

// Depuis 2016, on peut sélectionner plusieurs lignes
v_suite = true
lig = dw_locale.Find("Selection = 'O'", 0, 99999)

if lig = 0 then
	if dw_locale.getSelectedRow( 0 )> 0 then
		// ligne courrante
		nb_fichier_a_envoyer = 1
		fichiers_a_envoyer[1] = dir_photos + string( var_code_local ) + win_delimiter + dw_locale.getItemString( dw_locale.getSelectedRow( 0 ), "historique_editions_nom_courrier")
		if FileExists(fichiers_a_envoyer[1]) then
			v_suite = true
		else
			v_suite = false
			Messagebox("ATTENTION","La ligne que vous avez sélectionnée ne contient pas de document à copier !")
		end if
	else
		nb_fichier_a_envoyer =  0
		v_suite = false
	end if
else
	// 1 ou plusieurs lignes
	tot = dw_locale.rowcount() 
	nb_fichier_a_envoyer = 0
	for lig = 1 to tot
		if dw_locale.GetItemString(lig, "Selection") = "O" then
			nb_fichier_a_envoyer = nb_fichier_a_envoyer + 1
			fichiers_a_envoyer[nb_fichier_a_envoyer] = dir_photos + string( var_code_local ) + win_delimiter + dw_locale.getItemString( lig, "historique_editions_nom_courrier")
			if not FileExists(fichiers_a_envoyer[nb_fichier_a_envoyer]) then
				fichiers_a_envoyer[nb_fichier_a_envoyer] = ""
				nb_fichier_a_envoyer = nb_fichier_a_envoyer - 1 
			end if
		end if
	next
	if nb_fichier_a_envoyer > 0 then
		if nb_fichier_a_envoyer = 1 then 
			v_suite = true
		end if
	else
		v_suite = false
		Messagebox("ATTENTION","Les lignes que vous avez sélectionnées ne contiennent pas de document à copier !")
	end if
end if
	

if v_suite then

	choose case a_qui 
			
		Case "P" 
			// Copie vers un autre patient
			Messagebox("DOSSIER PATIENT DE DESTINATION","Vous devez indiquer à présent le dossier du patient de destination.")
	
			//open(w_cherche)
			guo_fenetre_modale.wf_ouvrir(w_cherche)
			
			if var_suite then
				patients_destination[1] = var_code
				nom_patients_destination[1] = var_nom
				nb_patients_destination = 1
			end if
		case "F" 
			// Copie vers Fratrie
			// récupération des membres de la famille avec synchronisation activée
		
			DECLARE cur1 CURSOR FOR SELECT code_patient1, isnull(nom,'') + (case when "prenom" is null then '' else ' ' + "prenom" end)
			from patient_lien_parente , patient 
			where  code_patient2 = :var_code_local and synchroniser = 'O' and patient.code = code_patient1 ;
			
			DECLARE cur2 CURSOR FOR SELECT code_patient2 , isnull(nom,'') + (case when "prenom" is null then '' else ' ' + "prenom" end)
			from patient_lien_parente , patient  
			where  code_patient1 = :var_code_local and synchroniser = 'O' and patient.code = code_patient2 ; 
			nb_patients_destination = 0
			
			open cur1 ; 
			fetch cur1 into :var_code_depart, :var_nom_complet ;
			do while sqlca.sqlcode = 0
				nb_patients_destination = nb_patients_destination + 1
				patients_destination[nb_patients_destination] = var_code_depart
				nom_patients_destination[nb_patients_destination] = var_nom_complet
				fetch cur1 into :var_code_depart, :var_nom_complet ;
			loop
			close cur1 ;
			
			open cur2 ; 
			fetch cur2 into :var_code_depart, :var_nom_complet ;
			do while sqlca.sqlcode = 0
				nb_patients_destination = nb_patients_destination + 1
				patients_destination[nb_patients_destination] = var_code_depart
				nom_patients_destination[nb_patients_destination] = var_nom_complet
				fetch cur2 into :var_code_depart, :var_nom_complet ;
			loop
			close cur2 ;
			
			if nb_patients_destination > 0 then 
				var_suite = true
			else
				var_suite = false
			end if
		Case "D" 
			// Duplcation
			
			var_suite = true
			patients_destination[1] = var_code_local
			nom_patients_destination[1] = ""
			nb_patients_destination = 1

	end choose
		
	
	if var_suite then
		
		if nb_fichier_a_envoyer = 1 then 
			v_libelle1 = "du document"
			v_libelle2 = "La ligne sera conservée"
		else
			v_libelle1 = "des " + string(nb_fichier_a_envoyer) + " documents"
			v_libelle2 = "Les " + string(nb_fichier_a_envoyer) + " lignes seront conservées"
		end if
		
		choose case a_qui 
			case "P" 
				// Autre patient
				if Messagebox("CONFIRMATION","Confirmez-vous la copie " + v_libelle1 + " dans le dossier de " + var_nom +" ?~n~n"+ v_libelle2 + " dans le dossier actuel.", Question!, YesNo!, 2) = 1 then
					var_suite = true
				else
					var_suite = false
				end if 
			case "F"
				// Fratrie
				if Messagebox("CONFIRMATION","Confirmez-vous la copie " + v_libelle1 + " dans le dossier de(s) " + string(nb_patients_destination) +" autre(s) dossier(s) de la fratrie ?~n~n"+ v_libelle2 + " dans le dossier actuel.", Question!, YesNo!, 2) = 1 then
					var_suite = true
				else
					var_suite = false
				end if 
			case "D"
				// Duplication 
				if Messagebox("CONFIRMATION","Confirmez-vous la duplication " + v_libelle1 + " dans ce dossier ?", Question!, YesNo!, 2) = 1 then
					var_suite = true
				else
					var_suite = false
				end if 
		end choose
	
		if var_suite then
			
			for cpt = 1 to nb_patients_destination

			
				var_code_local_arrivee = patients_destination[cpt]
				dossier_arrivee = fxg_get_rep_photos( ) + string(var_code_local_arrivee)
	
				var_suite = true
				// Test de l'existence du dossier de destination
				if not DirectoryExists( dossier_arrivee ) then
					// faut le créér
					if gfx_creer_rep( dossier_arrivee ) <> 1 then 
							MessageBox("ERREUR DANS LA CREATION DU DOSSIER DE DESTINATION","Impossible de créer le dossier : "+dossier_arrivee)
							var_suite = false
					end if
				end if
				
				if var_suite then
	
					open(w_patience)
	
					// On envoie les fichiers
					
					var_suite = true
					
					for lig = 1 to nb_fichier_a_envoyer
						
						nom_fichier_seul = gfx_extraire_nom_fichier(fichiers_a_envoyer[lig])
						fichier_depart = fichiers_a_envoyer[lig]
						
						if a_qui = "D" then
							// Duplication => on reste dans le meme dossier => faut renommer le fichier de destinantion
							
							// Si le début du nom du fichier est sous la forme  aaaa-mm-jj-hh-mm-ss - ... on actualise, sinon, on ajoute
							if isdate(left(nom_fichier_seul, 10)) then
								nom_fichier_seul_destination = string(today(), "yyyy-mm-dd")+" "+string(now(), "hh-mm-ss")+  " - " + trim(right(nom_fichier_seul, len(nom_fichier_seul) -  22))
							else
								nom_fichier_seul_destination =  string(today(), "yyyy-mm-dd")+" "+string(now(), "hh-mm-ss")+  " - " + nom_fichier_seul
							end if
						else
							nom_fichier_seul_destination = nom_fichier_seul
						end if
						
						fichier_arrivee =  dossier_arrivee + win_delimiter + nom_fichier_seul_destination
	
						resultat_copy = FileCopy (fichier_depart,fichier_arrivee, false ) 
								
						choose case resultat_copy
						case 1 
							// La copie a marché
							if utilisation_distante then
								// Mémo du fichier en vue du retour au cabinet
								fxg_ajout_acquis_distante ( var_code_local_arrivee , fichier_arrivee ) 
							end if
							
							// Copie de l'infos en base de données
							datetime dt_today
							dt_today = datetime(today(),  now())
							
							v_code_interne = fxg_get_clef_historique_editions()
							
							insert into "historique_editions" (code, code_courrier, date_document, libelle, nom_courrier, user_modif, date_modif, nature, public_web_patient, invisible, a_lire, id_categorie, code_interne)
							select :var_code_local_arrivee, code_courrier, date_document, libelle, :nom_fichier_seul_destination, :utilisateur_code, :dt_today, nature , public_web_patient, invisible, a_lire , id_categorie, :v_code_interne 
							from historique_editions 
							where code = :var_code_local and nom_courrier = :nom_fichier_seul ;
							
							
							
							if sqlca.sqlcode <> 0 then
								MessageBox("ERREUR DANS MEMORISATION","Impossible de mémoriser le fichier : " + fichier_arrivee + "~n~n" + sqlca.sqlerrtext)
								rollback ;
								var_suite = false
							else
								commit ;
								string publication_patient
								select isnull(public_web_patient, 'N' ) into :publication_patient from historique_editions 
								where code = :var_code_local and code_interne = :v_code_interne ;
								if TEA and publication_patient = "O" then
									fxg_lancer_commande_dsapi("document/create/" + v_code_interne, "", "D", "G", var_code_local  )
								end if
							end if
		
						case -1
							MessageBox("ERREUR DANS LA COPIE DU FICHIER","Impossible de trouver le fichier : "+fichier_depart)
							var_suite = false
						case -2
							MessageBox("ERREUR DANS LA COPIE DU FICHIER","Impossible d'écrire le fichier : " + fichier_arrivee + "~n~nIl est possible que vous n'ayez pas les droits nécessaires ou que le fichier existe déjà")
							var_suite = false
						end choose
					
						
					next
				
					close(w_patience)

					if var_suite  then
						// Pas eu d'erreur
						MessageBox("INFORMATION","La duplication a été correctement réalisée !")
						// Si duplication, on raffraichit
						if a_qui = "D" then
							dw_locale.retrieve( var_code_local,var_type_histo)
							if TEA then
								dw_locale_reference.retrieve( var_code_local,  var_type_histo )
							end if
						end if
					end if
				end if
			next
		end if
	end if
end if

end subroutine

