type m_renomerfichierphysique from menu within m_btdroit_historique
end type

event clicked;
long 		ligne_selectionnee
string v_ancien_nom_fichier, v_nouveau_nom_fichier, v_nouveau_nom_fichier_simple
string dir_patient

ligne_selectionnee = dw_locale.getSelectedRow( 0 )

string v_extension_ancien, v_extension_nouveau

if dw_locale.getSelectedRow( 0 )> 0 then
	
	if courrier_valide( v_ancien_nom_fichier ) = 1 then
		
		v_ancien_nom_fichier = trim(gfx_extraire_nom_fichier(v_ancien_nom_fichier))
		
		// Si le fichier est sous la forme nnnnnAAAAA : on vire les 5 premiers chiffres (pour fichiers STL venant de chez 3Shape)
		if long(left(v_ancien_nom_fichier,5)) > 0 and long(mid(v_ancien_nom_fichier, 6, 2)) = 0 then
			v_nouveau_nom_fichier = mid(v_ancien_nom_fichier, 6, len(v_ancien_nom_fichier) - 5)
		else
			v_extension_nouveau = gfx_extraire_extension_fichier(v_ancien_nom_fichier)
			v_nouveau_nom_fichier = gfx_fichier_sans_extension(v_ancien_nom_fichier)
		end if
		
		var_suite = false
		
		OpenWithParm(w_patient_modification_libelle_courrier_word, v_nouveau_nom_fichier ) 
		
		v_nouveau_nom_fichier = Message.StringParm + "." + v_extension_nouveau
		
		if var_suite then
			
			// On a validé la modif du libellé 
			// Le nouveau libelle est retourné par la fenêtre
			
			// On essaie de renommer aussi le fichier physique
			// mémorisation du nom court
			v_nouveau_nom_fichier_simple = v_nouveau_nom_fichier
			
			// On convertit en nom complet
			v_ancien_nom_fichier = dir_photos + string( var_code_local ) + win_delimiter + v_ancien_nom_fichier
			v_nouveau_nom_fichier = dir_photos + string( var_code_local ) + win_delimiter + v_nouveau_nom_fichier
		
			
			if MoveFileA ( v_ancien_nom_fichier , v_nouveau_nom_fichier ) = 1 then
				dw_locale.SetItem( ligne_selectionnee , "historique_editions_nom_courrier", v_nouveau_nom_fichier_simple )
				dw_locale.update()
				commit ;
				
				fxg_modification_pieces_jointes(var_code_local, v_nouveau_nom_fichier, "Fichier renommé le " + string(today()) + " -> " + v_nouveau_nom_fichier )
			else
				Messagebox("ATTENTION","Erreur dans le renommage du fichier.")
			end if
		end if
	end if
end if	
end event

