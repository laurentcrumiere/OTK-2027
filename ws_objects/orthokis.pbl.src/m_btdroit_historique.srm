event clicked;uo_lien_word		uo_word
string	chemin_complet_courrier

string v_nom_document

recup_nom_courrier (v_nom_document)

if dw_locale.getSelectedRow( 0 )> 0 then
	if courrier_valide( chemin_complet_courrier ) = 1 then
		if lower(right(chemin_complet_courrier,4)) = ".doc" or lower(right(chemin_complet_courrier,5)) = ".docx" then
			// c'est un courrier Word
			// On se sert de nos outils pour le mettre en avant plan
			
			w_locale.ouvrir_document_word(chemin_complet_courrier)
			//fxg_ouvrir_fichier_shell(chemin_complet_courrier)
			
			fxg_modification_pieces_jointes(var_code_local, v_nom_document, "Fichier ouvert le " + string(today()) )
		else
			if lower(right(chemin_complet_courrier,4)) = ".ppt" or lower(right(chemin_complet_courrier,5)) = ".pptx" then
				// c'est un document PowerPoint
				// On se sert de nos outils pour le mettre en avant plan
				
				//w_locale.ouvrir_document_powerpoint(chemin_complet_courrier)
				fxg_ouvrir_fichier_shell(chemin_complet_courrier)
				fxg_modification_pieces_jointes(var_code_local, v_nom_document, "Fichier ouvert le " + string(today()) )
				
			else
				if lower(right(chemin_complet_courrier,4)) = ".mht"  then
					// c'est un email venant d'une boite mail
					// on l'ouvre avec Internet Explorel
					//lance_url_avec_ie(chemin_complet_courrier)
					
					fxg_ouvrir_fichier_shell(chemin_complet_courrier)
	
					
				else
					// Si c'est un email, on cherche si on a un fichier de destintaires
					
					string c
					c =  dw_locale.GetItemString( dw_locale.getrow() , "historique_editions_code_courrier" ) 
					
					 if dw_locale.GetItemString( dw_locale.getrow() , "historique_editions_code_courrier" ) = "EMAIPJ" or dw_locale.GetItemString( dw_locale.getrow() , "historique_editions_code_courrier" ) = "EMAILL" or dw_locale.GetItemString( dw_locale.getrow() , "historique_editions_code_courrier" ) = "EMARDV"   then
						string fichier_destinataires, destinataires, emetteur
						integer num_fichier_destinataires
						fichier_destinataires = chemin_complet_courrier + ".dest"
						if fileExists(fichier_destinataires) then
							destinataires = ""
							 num_fichier_destinataires = FileOpen(fichier_destinataires, LineMode! , read!)
							 FileRead(num_fichier_destinataires, destinataires)
							 emetteur = ""
							 FileRead(num_fichier_destinataires, emetteur)
							 
							 if len(trim(emetteur)) > 0 then
								destinataires = destinataires + "~n~nEnvoyé depuis : " + emetteur
							else
								destinataires = destinataires + "~n~nEnvoyé depuis le compte mail du praticien."
							end if
							 fileclose(num_fichier_destinataires)
							 
							 if destinataires <> "" then
								Messagebox("DESTINATAIRES",destinataires)
							end if
							
						end if
					end if	
	
					fxg_ouvrir_fichier_shell(chemin_complet_courrier)
	
				
				end if
			end if
		end if
		
		// Attribut à Lire ?
		if dw_locale.GetItemString( dw_locale.getrow() , "a_lire" ) = "O" then
			If Messagebox("ATTENTION","Souhaitez-vous supprimer l'attribut 'Important - A lire' de cette ligne ?",Question!, YesNo!, 2) = 1 then 
				dw_locale.SetItem( dw_locale.getrow()  , "a_lire", "N" )
				dw_locale.update()
				commit ;
			end if
		end if
	end if
end if
end event

