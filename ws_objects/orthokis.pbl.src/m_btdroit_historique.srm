type m_signatureenligne from menu within m_btdroit_historique
end type

event clicked;string v_statut_signature
string v_fichier_pdf
string v_fichier_qm
double row


row = dw_locale.getSelectedRow( 0 )

if row > 0 then
	
	if  dw_locale.getitemstring(row, "historique_editions_code_courrier") = "WORPDF" then
		// Document Word passé en PDF => déjà prêt 
		v_statut_signature	= dw_locale.getitemstring (row , "historique_editions_statut_signature")
		v_fichier_pdf	= dw_locale.getitemstring (row , "historique_editions_nom_courrier")
	
		if v_statut_signature = "A1" or v_statut_signature = "A2" or v_statut_signature = "A3" then
	
			param_win[1] = v_statut_signature
			param_win[2] = v_fichier_pdf
			param_win[3] = dw_locale.getitemstring (row , "historique_editions_code_interne")
			OpenWithParm(w_signature_en_ligne, var_code_local )
		end if
	else
		if  dw_locale.getitemstring(row, "historique_editions_code_courrier") = "QM" or dw_locale.getitemstring(row, "historique_editions_code_courrier") = "WORD" then
			// QM en Word => faut d'abord le passé en en PDF => déjà prêt 
			w_courriers_word_invisible  ww
			// On récupère la catégorie du document pour que le PDF généré la reprenent ... on pas par VAR19 par convention, utilisé lors de la génération du document WORD
			integer v_id_categorie 
			 v_id_categorie = dw_locale.getitemNumber(row, "historique_editions_id_categorie")
			SetProfilestring(dir_ini+inifile_orthokis,"Macros","var19",string(v_id_categorie)) 
			open(ww)
			hide(ww)
			v_fichier_qm= dw_locale.getitemstring (row , "historique_editions_nom_courrier")
			// Pour la signature en ligne, par construction, on se sert forcement de VAR_CODE (variable globale), on la préserve !
			double var_code_sauve
			var_code_sauve = var_code
			var_code = var_code_local
			ww.signature_en_ligne (true, false, true, dir_photos + string(var_code_local) + "\", v_fichier_qm)
			var_code = var_code_sauve
			close(ww)
			
		end if
		
	end if
end if
end event

