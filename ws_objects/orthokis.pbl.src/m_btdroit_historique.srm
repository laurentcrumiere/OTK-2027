event clicked;
long 		ligne_selectionnee
string v_ancien_libelle, v_nouveau_libelle
string v_ancien_nom_fichier, v_nouveau_nom_fichier, v_nouveau_nom_fichier_simple
string dir_patient
ligne_selectionnee = dw_locale.getSelectedRow( 0 )

string v_extension_ancien, v_extension_nouveau

if ligne_selectionnee > 0 then

	v_ancien_libelle = dw_locale.getItemString( ligne_selectionnee , "historique_editions_libelle")
	var_suite = false
	OpenWithParm(w_patient_modification_libelle_courrier_word, v_ancien_libelle ) 
	v_nouveau_libelle = Message.StringParm
	if var_suite then
		
		// On a validé la modif du libellé 
		// Le nouveau libelle est retourné par la fenêtre
		
		dw_locale.SetItem( ligne_selectionnee , "historique_editions_libelle", v_nouveau_libelle)
		
		if dw_locale.update() = 1 then
			
			// On essaie de renommer aussi le fichier physique
			v_ancien_nom_fichier = dw_locale.getItemString( ligne_selectionnee , "historique_editions_nom_courrier")
			v_extension_ancien = gfx_extraire_extension_fichier(v_ancien_nom_fichier)
			
			// Nouveau nom du fichier
			v_nouveau_nom_fichier = gfx_tout_remplacer(v_ancien_nom_fichier, v_ancien_libelle, v_nouveau_libelle)
			v_extension_nouveau = gfx_extraire_extension_fichier(v_nouveau_nom_fichier)
			
			// Si le renommage a bousillé l'extension, on la remet
			if v_extension_ancien <> v_extension_nouveau then
				v_nouveau_nom_fichier = v_nouveau_nom_fichier + "." + v_extension_ancien
			end if
			
			// mémorisation du nom court
			v_nouveau_nom_fichier_simple = v_nouveau_nom_fichier
			
			// On convertit en nom complet
			v_ancien_nom_fichier = dir_photos + string( var_code_local ) + win_delimiter + v_ancien_nom_fichier
			v_nouveau_nom_fichier = dir_photos + string( var_code_local ) + win_delimiter + v_nouveau_nom_fichier
			
			if MoveFileA ( v_ancien_nom_fichier , v_nouveau_nom_fichier ) = 1 then
				dw_locale.SetItem( ligne_selectionnee , "historique_editions_nom_courrier", v_nouveau_nom_fichier_simple )
				dw_locale.update()
			end if

			
			commit ;
		else
			rollback ;
		end if
		
	end if
end if	
end event

