event clicked;string		nom_courrier
boolean	stop = false
boolean	fichier_a_supprimer = false
string		chemin_complet_courrier, v_libelle
long 		ligne_selectionnee
string 	v_invisible


if dw_locale.getSelectedRow( 0 )> 0 then
	
	// On est dans la suppression de documents ... il peut y avoir plusieurs lignes de sélectionnées
	dw_locale.AcceptText()

	long lig, tot
	
	// Y a t il une ligne cochée
	tot = dw_locale.rowcount()
	lig = dw_locale.find("selection = 'O'", 1, tot + 1)

	if lig = 0 then 
		// On coche la ligne en cours
		dw_locale.setitem(dw_locale.getrow() , "selection",  "O")
	end if

	// On va supprimer des lignes ..on part de la fin !
	for lig = tot to 1 step -1 
		
		stop = false
		fichier_a_supprimer = false
		
		if dw_locale.getitemString(lig, "selection") = "O" then
			
			// pour assurer la compatibilité avec une sous fonction, on sélectionne la ligne à supprimer 
			dw_locale.SelectRow(0, false)
			dw_locale.SelectRow(lig, true)
			
			chemin_complet_courrier = dw_locale.getitemString(lig, "historique_editions_nom_courrier")
			v_libelle = dw_locale.getitemstring(lig, "historique_editions_libelle")
	
			if courrier_valide( chemin_complet_courrier ) = 1 then 
				if messagebox("ATTENTION", dw_locale.getitemstring(lig, "historique_editions_libelle") + "~n~nLa suppression de cette ligne entraînera également la suppression du document qui s'y rattache. ~n~nSouhaitez-vous continuer ?", Question!, YesNo!) = 1 then
					// si l'utilisateur souhaite bien suppr cette ligne
					fichier_a_supprimer = true
				else
					stop = true
				end if
			end if
			
			if not stop then
				// Vérification si signature 
				double id_doc_cloud
				id_doc_cloud = dw_locale.getItemNumber( lig , "historique_editions_id_doc_cloud")
				if id_doc_cloud > 0 then
					if dw_locale.getItemString( lig,  "historique_editions_statut_signature") = "S" then
						// Le document a été signé .. on empeche sa suppression
						messagebox("ATTENTION", "Ce document a été signé numériquement !~n~nSa suppression n'est pas autorisée.", StopSign!)
						stop=true
					end if
				end if
			end if

			if not stop and TEA then
				// Vérification si signature en attente dans TEA
				if dw_locale.getItemString( lig,  "historique_editions_statut_signature") = "A1"or dw_locale.getItemString( lig,  "historique_editions_statut_signature") = "A2" then
					// Le document est en attente de signature
					messagebox("ATTENTION", "Ce document est en attente de signatrure Téa !~n~nSi besoin, vous devez également le supprimer dans la console d'administation de Téa !", StopSign!)
				end if
			end if	
			
			if not stop then
				
				// avant de supprimer on mémorise pour supprimer les PJ ensuite
				string v_code_interne, v_code_courrier
				v_code_interne = dw_locale.getitemstring(lig , "historique_editions_code_interne")
				v_code_courrier = dw_locale.getitemstring(lig , "historique_editions_code_courrier")
				
				if dw_locale.deleterow( lig ) = 1 then
					if fichier_a_supprimer then 
						if DeleteFileA( chemin_complet_courrier ) = 0 then
							messagebox("ERREUR", "Impossible de supprimer le courrier qui s'y rattache, opération annulée.", StopSign!)
							stop=true
						else
							// Vérification si par aussi fichier .dest si envoi d'un email
							if FileExists( chemin_complet_courrier+ ".dest" )	then
								 FileDelete( chemin_complet_courrier+ ".dest" )
							end if
							
							if upper(v_code_courrier) = "EMAIPJ" then 
								// Si c'est un envoi d'email avec PJ, suppression de l'historique des PJ ...
								delete from "historique_editions_pieces_jointes" where
								code_patient = :var_code_local and code_interne_historique_editions = :v_code_interne ;
								
								if sqlca.sqlcode <> 0 then
									messagebox("ATTENTION", "Erreur dans la suppression de la mémorisation des pièces jointes !~n~n" + sqlca.sqlerrtext )
									rollback ;
								else
									commit ;
								end if
							end if
							
							
						end if
					end if
					if not stop then
						dw_locale.AcceptText()
						if dw_locale.update() = 1 then
							commit ;
							ajout_histo_actions(var_code_local,"SUPDOC",today(),v_libelle)
							if MON_ORTHODONTISTE or TEA then
								if MON_ORTHODONTISTE then
									// La ligne a été supprimée et le document qui s'y rattache aussi ... si on a une id Cloud, on envoi à Mon Orthodonsite
									if id_doc_cloud > 0 then
										// Pas de gestion d'erreur
										fxg_lancer_commande_myorthokis_simple("action?type=deleteDocumentCloud&id=" + string(id_doc_cloud ) , true, "A"  )
									end if
								else
									// Suppression dans DSAPI
									fxg_lancer_commande_dsapi("document/delete/" + v_code_interne, "",  "D", "G", var_code_local  )
								end if
							end if
					
						else
							rollback ;
						end if
					end if
					
				else
				// si un pb lors de la suppr de la ligne
					messagebox("ERREUR ...", "Impossible de supprimer cette ligne, opération annulée.", StopSign!)
				end if
			end if
		end if
	next

	dw_locale.retrieve( var_code_local,var_type_histo)
	if TEA then
		dw_locale_reference.retrieve( var_code_local, var_type_histo )
	end if
		
end if


end event

