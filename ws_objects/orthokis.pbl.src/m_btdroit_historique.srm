event clicked;long  ligne_selectionnee
string v_code_interne_historique_editions

ligne_selectionnee = dw_locale.getSelectedRow( 0 )

if ligne_selectionnee > 0 then 
	v_code_interne_historique_editions = dw_locale.getItemString( ligne_selectionnee, "historique_editions_code_interne") 
	
	// On se sert d'une structure patient pour passer en paramètres ... Pas très propre mais cela évite de créer une autre structure
	str_patient v_patient
	v_patient.code = var_code_local
	v_patient.nom = v_code_interne_historique_editions
	
	openwithparm(w_patient_ged_pieces_jointes, v_patient)
	
	
end if
end event

