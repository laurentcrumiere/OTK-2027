		v_taille = FileLength64(chemin_complet_courrier)	
		MessageBox("Informations sur le fichier","Nom du fichier : "+chemin_complet_courrier+"~n~nTaille : " + string (v_taille / 1024 / 1024 , "0.00")+" Mo~n~nDate de dernière modification : " + string(fxg_get_file_date(chemin_complet_courrier) ,"dd/mm/yyyy à hh:mm"))
	end if
end if

end event

