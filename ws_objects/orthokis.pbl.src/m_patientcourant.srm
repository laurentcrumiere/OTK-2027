event clicked;	long lig , tot
	boolean tout_selectionne
	
	tout_selectionne = w_clic.tout_selectionne
	
	tot = dw_clic.rowcount()
	
	for lig = 1 to tot
		if tout_selectionne then
			dw_clic.setItem(lig, nom_colonne_selection, "N")
		else
			dw_clic.setItem(lig, nom_colonne_selection, "O")
		end if
	next
	
		
	w_clic.tout_selectionne = not tout_selectionne

end event

