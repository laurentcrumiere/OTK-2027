event clicked;string v_statut_signature
string v_fichier_pdf
string v_fichier_qm
double row


row = dw_clic.getSelectedRow( 0 )

if row > 0 then
	
	if  dw_clic.getitemstring(row, "historique_editions_code_courrier") = "WORPDF" then
		// Document Word passé en PDF => déjà prêt 
		v_statut_signature	= dw_clic.getitemstring (row , "historique_editions_statut_signature")
		v_fichier_pdf	= dw_clic.getitemstring (row , "historique_editions_nom_courrier")
	
		if v_statut_signature = "A1" or v_statut_signature = "A2" or v_statut_signature = "A3" then
	
			param_win[1] = v_statut_signature
			param_win[2] = v_fichier_pdf
			param_win[3] = dw_clic.getitemstring (row , "historique_editions_code_interne")
			OpenWithParm(w_signature_en_ligne, CodePatientCourant )
		end if
	else
		if  dw_clic.getitemstring(row, "historique_editions_code_courrier") = "QM" or dw_clic.getitemstring(row, "historique_editions_code_courrier") = "WORD" then
			// QM en Word => faut d'abord le passé en en PDF => déjà prêt 
			w_courriers_word_invisible  ww
			
			open(ww)
			hide(ww)
			v_fichier_qm= dw_clic.getitemstring (row , "historique_editions_nom_courrier")
			
			ww.signature_en_ligne (true, false, true, dir_photos + string(CodePatientCourant) + "\", v_fichier_qm)
			close(ww)
			
		end if
		
	end if
end if
end event

