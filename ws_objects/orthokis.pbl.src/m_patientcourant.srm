type m_télévital from menu within m_patientcourant
event clicked ( )
end type

event clicked;
if CodePatientCourant < 0 then 
	if Doctolib then
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous Doctolib pour un patient non validé par Orthokis !")
	else
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous pris en ligne pour un patient non validé par Orthokis !")
	end if
else
	// pour TV et pour CC Vitale
	fxg_suivi_tv_eid_belgique(CodePatientCourant)
end if





end event

