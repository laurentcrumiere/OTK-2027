public function integer gestion_des_droits ()
end prototypes

public function integer gestion_des_droits ();//fx publique qui gère les droit utilisateur
//ainsi que la possession des divers modules
//

// Gestion des icones ...
	
m_administratif.MenuImage 					=  icone_fiche_admini_16 
m_commentairesadministratifs.MenuImage =  icone_coment_admini_16
m_soinsprévisionnel.MenuImage 				=  icone_soins_prevus_16 
m_soinsencours.MenuImage 					=  icone_soins_16 
m_rêglement.MenuImage 						=  icone_regl_16 
m_pagescliniques.MenuImage					=   icone_clinique_16 
m_commentairescliniques.MenuImage 		=  icone_coment_16 
m_imagerie.MenuImage 							=  icone_imagerie_16 
m_rendez-vous.MenuImage 					=   icone_rdv_16 	




// Gestion de l'accés aux modules en fonction des menus !!



m_administratif.enabled = m_orthokis_2020.m_patients.m_miseàjour.enabled 
m_administratif.enabled = m_orthokis_2020.m_patients.m_courriersactionsdocuments.enabled 
m_commentairesadministratifs.enabled = m_orthokis_2020.m_patients.m_commentaires.enabled


// module Sesam Vitale
if France then 
	m_télévital.enabled = m_orthokis_2020.m_patients.m_suivitelevitale.enabled
else
	m_télévital.visible = false
end if


m_soinsprévisionnel.enabled = m_orthokis_2020.m_patients.m_soinsprevus.enabled
m_soinsencours.enabled = m_orthokis_2020.m_patients.m_soins.enabled
m_rêglement.enabled = m_orthokis_2020.m_patients.m_reglements.enabled


m_rendez-vous.enabled = m_orthokis_2020.m_patients.m_miseàjour0.enabled



// le clinique
if not m_orthokis_2020.m_patients.m_commentairescliniques.enabled then
	m_commentairescliniques.enabled = false
end if 
if not m_orthokis_2020.m_patients.m_pagescliniques.enabled then
	m_pagescliniques.enabled = module_clinique
end if

m_imagerie.enabled = m_orthokis_2020.m_patients.m_imagerie.enabled


//lien ODRADE
if not m_orthokis_2020.m_patients.m_lienodrade.enabled then
	m_lienodrade.enabled = odr
end if

///////////////////////////////////////////////////////////////////////////

//gestion des droits utilisateurs

// Fiche administrative 
if droits_acces[10] = 'N' then
	m_administratif.enabled = false
end if
// Commentaires Administratifs
if droits_acces[18] = 'N' then
	m_commentairesadministratifs.enabled = false
end if
// Soins prévisionnels 
if droits_acces[17] = 'N' then
	m_soinsprévisionnel.enabled = false
end if
// Soins 
if droits_acces[11] = 'N' then
	m_soinsencours.enabled = false
end if
// Règlements 
if droits_acces[12] = 'N' then
	m_rêglement.enabled = false
end if
// Suivi Télévitale 
if droits_acces[13] = 'N' or not CCVITALE then
	m_télévital.enabled = false
else
	if CCVITALE then
		m_télévital.text = "Suivi CC-Vitale"
	end if
end if
// Rendez-vous 
if droits_acces[16] = 'N' then
	m_rendez-vous.enabled = false
end if
// Commentaires-cliniques 
if droits_acces[14] = 'N' or not module_clinique then
	m_commentairescliniques.enabled = false
end if
// Pages-cliniques  
if droits_acces[15] = 'N' or not module_clinique then
	m_pagescliniques.enabled = false
end if	


//// Envoi de SMS uniquement si Dental SMS de configuré
//uo_pocket uo_p
//uo_p = create uo_pocket
//uo_p.triggerevent(constructor!) 	// pour initialisation
//if uo_p.is_dentalsms() then
////	m_envoidesms.visible = true
//end if

if OPERATEUR_SMS = 2 then
	m_envoyersmsunitaire.enabled = true
	m_envoyersmsliste.enabled = true
else
	m_envoyersmsunitaire.enabled = false
	m_envoyersmsliste.enabled = false
end if



//pas de gestion d'erreur
return 1
end function

