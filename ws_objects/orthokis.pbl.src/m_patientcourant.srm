this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_etiquettes.destroy
call super::destroy
end on

event clicked;
// replissage de la liste des adresse


long tot, lig
double v_code

datastore dw_liste
dw_liste = create datastore
dw_liste.DataObject = "dw_etiquettes"

tot = dw_clic.rowcount()

for lig = 1 to tot
	
	v_code = dw_clic.getItemNumber(lig, "code")
	
	dw_liste.insertrow(0)
	
	// recherche des éléments à partir du code du patient pour être sûr du coup !!!
	string v_nom, v_adr1, v_adr2, v_codep, v_ville, v_titre
	
	select isnull(titre_personnes.nom, ''), nom_parent1, adr1_parent1, adr2_parent1, codep_parent1, ville_parent1
	into :v_titre, :v_nom, :v_adr1, :v_adr2, :v_codep, :v_ville 
	from patient, titre_personnes 
	where patient.code = :v_code and titre_parent1 = titre_personnes.code ;
	
	if len(trim(v_titre)) = 0 then
		dw_liste.setitem(lig, "ligne1", v_nom)
	else
		dw_liste.setitem(lig, "ligne1", trim(v_titre) + " "+ v_nom)
	end if
	dw_liste.setitem(lig, "ligne2",v_adr1)
	dw_liste.setitem(lig, "ligne3", v_adr2)
	dw_liste.setitem(lig, "ligne4", v_codep +" "+v_ville ) 
	
	
next

OpenWithParm (w_etiquettes, dw_liste)
end event

