table(column=(type=decimal(2) updatewhereclause=yes name=scp_demande dbname="soins.scp_demande" initial="null" )
 column=(type=decimal(2) updatewhereclause=yes name=hn dbname="soins.hn" )
 column=(type=decimal(2) updatewhereclause=yes name=total dbname="soins.total" )
 column=(type=char(1) updatewhereclause=yes name=titre dbname="table_vide.v1" )
 column=(type=char(20) updatewhereclause=yes name=type dbname="soins.type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=char(200) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 column=(type=char(3) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" )
 column=(type=char(30) updatewhereclause=yes name=caisse_nom dbname="caisse.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=char(30) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent2 dbname="patient.secu_parent2" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_payeur dbname="patient.secu_payeur" )
 column=(type=char(1) updatewhereclause=yes name=patient_assure dbname="patient.assure" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=decimal(2) updatewhereclause=yes name=code_soins_valeur dbname="code_soins.valeur" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"table_vide~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"caisse~" ) COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"caisse.nom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.secu_parent2~") COLUMN(NAME=~"patient.secu_payeur~") COLUMN(NAME=~"patient.assure~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"code_soins.valeur~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )    JOIN (LEFT=~"caisse.code~"    OP =~"=~"RIGHT=~"patient.code_caisse~" )WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_exe~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("prat_min", string),("prat_max", string),("date_min", date),("date_max", date))  sort="caisse_nom A code_soins_nom A scp_demande A " )
