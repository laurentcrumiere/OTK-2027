 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_ememoire_luxembourg~" )  TABLE(NAME=~"ememoire_luxembourg~" ) COLUMN(NAME=~"ligne_ememoire_luxembourg.code_acte~") COLUMN(NAME=~"ligne_ememoire_luxembourg.date_execution~") COLUMN(NAME=~"ligne_ememoire_luxembourg.montant_caisse~") COLUMN(NAME=~"ligne_ememoire_luxembourg.dent~") COLUMN(NAME=~"ligne_ememoire_luxembourg.part_statutaire~") COLUMN(NAME=~"ligne_ememoire_luxembourg.participation_personnelle~") COLUMN(NAME=~"ligne_ememoire_luxembourg.montant_opposable~") COLUMN(NAME=~"ligne_ememoire_luxembourg.prestation_uuid~") COLUMN(NAME=~"ligne_ememoire_luxembourg.montant_patient~") COLUMN(NAME=~"ligne_ememoire_luxembourg.montant_total~") COLUMN(NAME=~"ligne_ememoire_luxembourg.cle~") COLUMN(NAME=~"ligne_ememoire_luxembourg.sufix~") COLUMN(NAME=~"ligne_ememoire_luxembourg.numero_memoire~") COLUMN(NAME=~"ligne_ememoire_luxembourg.identifiant_executant~") COLUMN(NAME=~"ligne_ememoire_luxembourg.lieu_execution~") COLUMN(NAME=~"ligne_ememoire_luxembourg.nombre_acte~") COLUMN(NAME=~"ligne_ememoire_luxembourg.numero_seance~") COLUMN(NAME=~"ligne_ememoire_luxembourg.identifiant_prescripteur~") COMPUTE(NAME=~"(select nom from code_soins where code_acte = code_soins.code) as libelle_soin~") COMPUTE(NAME=~"(select isnull(count(*),0) from ememoire_luxembourg_anomalie where ememoire_luxembourg_anomalie.numero_memoire = ligne_ememoire_luxembourg.numero_memoire and ememoire_luxembourg_anomalie.cle = ligne_ememoire_luxembourg.cle) as cpt_anomalie~") COLUMN(NAME=~"ememoire_luxembourg.etat~") COMPUTE(NAME=~"(select isnull(sum(montant),0) from paye where paye.code = ememoire_luxembourg.code_patient and paye.cle = ligne_ememoire_luxembourg.cle) as montant_paye_soin~")    JOIN (LEFT=~"ligne_ememoire_luxembourg.numero_memoire~"    OP =~"=~"RIGHT=~"ememoire_luxembourg.numero_memoire~" )WHERE(    EXP1 =~"( ~~~"ligne_ememoire_luxembourg~~~".~~~"numero_memoire~~~"~"   OP =~"=~"    EXP2 =~":v_numero )~" ) ) ARG(NAME = ~"v_numero~" TYPE = number) " update="ligne_ememoire_luxembourg" updatewhere=0 updatekeyinplace=no arguments=(("v_numero", number))  sort="date_execution A cle A code_acte A " )
