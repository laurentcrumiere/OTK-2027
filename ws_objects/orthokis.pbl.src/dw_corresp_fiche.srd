table(column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code dbname="correspondants.code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="correspondants.nom" initial=" " )
 column=(type=char(30) update=yes updatewhereclause=yes name=adr1 dbname="correspondants.adr1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=adr2 dbname="correspondants.adr2" )
 column=(type=char(5) update=yes updatewhereclause=yes name=codep dbname="correspondants.codep" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville dbname="correspondants.ville" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sexe dbname="correspondants.sexe" initial="M" values="Masculin	M/Féminin	F/" )
 column=(type=char(15) update=yes updatewhereclause=yes name=tel dbname="correspondants.tel" )
 column=(type=char(15) update=yes updatewhereclause=yes name=fax dbname="correspondants.fax" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=titre dbname="correspondants.titre" initial="4" )
 column=(type=char(6) update=yes updatewhereclause=yes name=categorie dbname="correspondants.categorie" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="correspondants.prenom" )
 column=(type=char(15) update=yes updatewhereclause=yes name=tel2 dbname="correspondants.tel2" )
 column=(type=char(1) update=yes updatewhereclause=yes name=relation dbname="correspondants.relation" initial="V" values="Vous	V/Tu	T/Ami	A/Confrère	C/" )
 column=(type=char(6) update=yes updatewhereclause=yes name=pays dbname="correspondants.pays" )
 column=(type=long update=yes updatewhereclause=yes name=actif dbname="correspondants.actif" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=ordre_trie dbname="correspondants.ordre_trie" initial="100" )
 column=(type=char(100) update=yes updatewhereclause=yes name=email dbname="correspondants.email" )
 column=(type=char(6) update=yes updatewhereclause=yes name=mdp_correspondant dbname="correspondants.mdp_correspondant" )
 column=(type=datetime updatewhereclause=yes name=derniere_connexion_web dbname="derniere_connexion_web" )
 column=(type=char(500) update=yes updatewhereclause=yes name=formule_politesse dbname="correspondants.formule_politesse" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=commentaires dbname="correspondants.commentaires" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=zone_portail dbname="correspondants.zone_portail" )
 column=(type=char(12) update=yes updatewhereclause=yes name=numero_id dbname="correspondants.numero_id" )
 column=(type=char(11) update=yes updatewhereclause=yes name=numero_inami dbname="correspondants.numero_inami" )
 column=(type=char(100) update=yes updatewhereclause=yes name=email_secu dbname="correspondants.email_secu" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"correspondants~" ) COLUMN(NAME=~"correspondants.code~") COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"correspondants.adr1~") COLUMN(NAME=~"correspondants.adr2~") COLUMN(NAME=~"correspondants.codep~") COLUMN(NAME=~"correspondants.ville~") COLUMN(NAME=~"correspondants.sexe~") COLUMN(NAME=~"correspondants.tel~") COLUMN(NAME=~"correspondants.fax~") COLUMN(NAME=~"correspondants.titre~") COLUMN(NAME=~"correspondants.categorie~") COLUMN(NAME=~"correspondants.prenom~") COLUMN(NAME=~"correspondants.tel2~") COLUMN(NAME=~"correspondants.relation~") COLUMN(NAME=~"correspondants.pays~") COLUMN(NAME=~"correspondants.actif~") COLUMN(NAME=~"correspondants.ordre_trie~") COLUMN(NAME=~"correspondants.email~") COLUMN(NAME=~"correspondants.mdp_correspondant~") COMPUTE(NAME=~"(select max(date_heure) as derniere_connexion_web from myo_histo_connect where code_correspondant = correspondants.code)~") COLUMN(NAME=~"correspondants.formule_politesse~") COLUMN(NAME=~"correspondants.commentaires~") COLUMN(NAME=~"correspondants.zone_portail~") COLUMN(NAME=~"correspondants.numero_id~") COLUMN(NAME=~"correspondants.numero_inami~") COLUMN(NAME=~"correspondants.email_secu~")WHERE(    EXP1 =~"~~~"correspondants~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code~" ) ) ARG(NAME = ~"var_code~" TYPE = string) " update="correspondants" updatewhere=0 updatekeyinplace=yes arguments=(("var_code", string)) )
