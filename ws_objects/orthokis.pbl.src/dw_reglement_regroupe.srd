table(column=(type=decimal(2) update=yes updatewhereclause=yes name=montant dbname="paye.montant" )
 column=(type=char(40) update=yes updatewhereclause=yes name=commentaire dbname="paye.commentaire" )
 column=(type=char(50) update=yes updatewhereclause=yes name=payeur dbname="paye.payeur" )
 column=(type=date update=yes updatewhereclause=yes name=dateremise dbname="paye.dateremise" initial="today" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tp dbname="paye.tp" initial="N" values="	O/	N" )
 column=(type=date update=yes updatewhereclause=yes name=date dbname="paye.date" initial="today" )
 column=(type=number update=yes updatewhereclause=yes name=cle dbname="paye.cle" )
 column=(type=date update=yes updatewhereclause=yes name=transfert dbname="paye.transfert" )
 column=(type=number update=yes updatewhereclause=yes name=code dbname="paye.code" )
 column=(type=char(1) updatewhereclause=yes name=origine_tp dbname="paye.origine_tp" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_monnaie dbname="paye.montant_monnaie" )
 column=(type=char(1) updatewhereclause=yes name=monnaie dbname="paye.monnaie" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=char(50) updatewhereclause=yes name=banque_ident dbname="banque.ident" )
 column=(type=char(6) updatewhereclause=yes name=user_modif dbname="paye.user_modif" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="paye.date_modif" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mode dbname="paye.mode" values="Chèque	C/Espèces	E/Virement 	V/CCP	P/Carte Bancaire	B/Solde	S/Mandat Postal	M/" )
 column=(type=char(20) updatewhereclause=yes name=mode_reglement_nom dbname="mode_reglement.nom" )
 column=(type=char(1) updatewhereclause=yes name=selection dbname="table_vide.v1" values="	O/	N" )
 column=(type=char(6) updatewhereclause=yes name=paye_code_praticien dbname="paye.code_praticien" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_barre_couleur_code dbname="prati.barre_couleur_code" )
 column=(type=char(81) updatewhereclause=yes name=nom_patient dbname="nom_patient" )
 column=(type=decimal(0) updatewhereclause=yes name=soins_numero dbname="soins.numero" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" initial="null" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"paye~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"banque~" )  TABLE(NAME=~"mode_reglement~" )  TABLE(NAME=~"table_vide~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"soins~" ) COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.tp~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.cle~") COLUMN(NAME=~"paye.transfert~") COLUMN(NAME=~"paye.code~") COLUMN(NAME=~"paye.origine_tp~") COLUMN(NAME=~"paye.montant_monnaie~") COLUMN(NAME=~"paye.monnaie~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"banque.ident~") COLUMN(NAME=~"paye.user_modif~") COLUMN(NAME=~"paye.date_modif~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"mode_reglement.nom~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"paye.code_praticien~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.barre_couleur_code~") COMPUTE(NAME=~"patient.nom + ' ' + isnull(patient.prenom, '') as nom_patient~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"code_soins.nom~")    JOIN (LEFT=~"banque.code~"    OP =~"=~"RIGHT=~"paye.banque~"    OUTER2 =~"paye.banque~" )    JOIN (LEFT=~"paye.mode~"    OP =~"=~"RIGHT=~"mode_reglement.code~" )    JOIN (LEFT=~"paye.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"paye.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"paye.cle~"    OP =~"=~"RIGHT=~"soins.cle~" )    JOIN (LEFT=~"paye.code~"    OP =~"=~"RIGHT=~"soins.code~" )WHERE(    EXP1 =~"~~~"paye~~~".~~~"date~~~"~"   OP =~"=~"    EXP2 =~":v_date~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"dateremise~~~"~"   OP =~"=~"    EXP2 =~":v_dateremise~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"commentaire~~~"~"   OP =~"=~"    EXP2 =~":v_commentaire~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"payeur~~~"~"   OP =~"=~"    EXP2 =~":v_payeur~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"mode~~~"~"   OP =~"=~"    EXP2 =~":v_mode~" ) ) ARG(NAME = ~"v_date~" TYPE = date)  ARG(NAME = ~"v_dateremise~" TYPE = date)  ARG(NAME = ~"v_commentaire~" TYPE = string)  ARG(NAME = ~"v_payeur~" TYPE = string)  ARG(NAME = ~"v_mode~" TYPE = string) " arguments=(("v_date", date),("v_dateremise", date),("v_commentaire", string),("v_payeur", string),("v_mode", string))  sort="nom_patient A code_soins_nom A soins_numero A soins_date_demande A date A dateremise A tp D origine_tp A " )
