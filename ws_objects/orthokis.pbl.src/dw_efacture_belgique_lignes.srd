 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_efacture_belgique~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"efacture_belgique~" )  TABLE(NAME=~"soins~" ) COLUMN(NAME=~"ligne_efacture_belgique.date_engagement_tarif~") COLUMN(NAME=~"ligne_efacture_belgique.numero_facture~") COLUMN(NAME=~"ligne_efacture_belgique.cle~") COLUMN(NAME=~"ligne_efacture_belgique.norme_prestation~") COLUMN(NAME=~"ligne_efacture_belgique.code_nomenclature~") COLUMN(NAME=~"ligne_efacture_belgique.prestation_relative~") COLUMN(NAME=~"ligne_efacture_belgique.date_prestation~") COLUMN(NAME=~"ligne_efacture_belgique.heures_non_ouvrees~") COLUMN(NAME=~"ligne_efacture_belgique.identification_prestataire~") COLUMN(NAME=~"ligne_efacture_belgique.prestataire_conventionne~") COLUMN(NAME=~"ligne_efacture_belgique.norme_prescripteur~") COLUMN(NAME=~"ligne_efacture_belgique.identification_prescripteur~") COLUMN(NAME=~"ligne_efacture_belgique.date_prescription~") COLUMN(NAME=~"ligne_efacture_belgique.montant_rembourse_oa~") COLUMN(NAME=~"ligne_efacture_belgique.intervention_personnelle~") COLUMN(NAME=~"ligne_efacture_belgique.numero_engagement_tarif~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"ligne_efacture_belgique.lieu_prestation~") COLUMN(NAME=~"ligne_efacture_belgique.derogation~") COLUMN(NAME=~"ligne_efacture_belgique.code_facturation_intervention_personnelle~") COLUMN(NAME=~"ligne_efacture_belgique.type_facture~") COLUMN(NAME=~"ligne_efacture_belgique.prescription_de_renvoi_electronique~") COLUMN(NAME=~"ligne_efacture_belgique.dispensateur_auxiliaire~") COLUMN(NAME=~"ligne_efacture_belgique.norme_dispensateur~") COLUMN(NAME=~"ligne_efacture_belgique.dent~") COLUMN(NAME=~"ligne_efacture_belgique.supplement~")    JOIN (LEFT=~"ligne_efacture_belgique.numero_facture~"    OP =~"=~"RIGHT=~"efacture_belgique.numero_facture~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"ligne_efacture_belgique.cle~"    OP =~"=~"RIGHT=~"soins.cle~" )    JOIN (LEFT=~"efacture_belgique.code_patient~"    OP =~"=~"RIGHT=~"soins.code~" )WHERE(    EXP1 =~"~~~"ligne_efacture_belgique~~~".~~~"numero_facture~~~"~"   OP =~"=~"    EXP2 =~":v_numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ligne_efacture_belgique~~~".~~~"type_facture~~~"~"   OP =~"=~"    EXP2 =~":c_type_facture~" ) ) ARG(NAME = ~"v_numero~" TYPE = number)  ARG(NAME = ~"c_type_facture~" TYPE = string) " update="ligne_efacture_belgique" updatewhere=0 updatekeyinplace=no arguments=(("v_numero", number),("c_type_facture", string))  sort="date_prestation A code_nomenclature A " )
