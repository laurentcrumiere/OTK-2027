 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.pays_parent1~") COLUMN(NAME=~"patient.pays_parent2~") COLUMN(NAME=~"patient.pays_payeur~") COMPUTE(NAME=~"isnull(portable, '') as portable~") COMPUTE(NAME=~"isnull(portable_patient, '') as portable_patient~") COMPUTE(NAME=~"isnull(portable2_parent1, '') as portable2_parent1~") COMPUTE(NAME=~"isnull(portable1_parent2, '') as portable1_parent2~") COMPUTE(NAME=~"isnull(portable2_parent2, '') as portable2_parent2~") COMPUTE(NAME=~"isnull(portable1_payeur, '') as portable1_payeur~") COMPUTE(NAME=~"isnull(portable2_payeur, '') as portable2_payeur~") COMPUTE(NAME=~"(select top 1  isnull(v1, 'N') from table_vide ) as sel_portable~") COMPUTE(NAME=~"(select top 1  isnull(v1, 'N') from table_vide ) as sel_portable_patient~") COMPUTE(NAME=~"(select top 1  isnull(v1, 'N') from table_vide ) as sel_portable2_parent1~") COMPUTE(NAME=~"(select top 1  isnull(v1, 'N') from table_vide ) as sel_portable1_parent2~") COMPUTE(NAME=~"(select top 1  isnull(v1, 'N') from table_vide ) as sel_portable1_payeur~") COMPUTE(NAME=~"(select top 1  isnull(v1, 'N') from table_vide ) as sel_portable2_parent2~") COMPUTE(NAME=~"(select top 1  isnull(v1, 'N') from table_vide ) as sel_portable2_payeur~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":v_code~" ) ) ARG(NAME = ~"v_code~" TYPE = number) " arguments=(("v_code", number)) )
