export.xml(usetemplate="bibli_export" headgroups="1" includewhitespace="0" metadatatype=1 savemetadata=1  template=(comment="" encoding="UTF-16LE" name="bibli_export" xml="<?xml version=~"1.0~" encoding=~"UTF-16LE~" standalone=~"no~"?><bibli_export><patient __pbband=~"detail~"><patient_code>patient_code</patient_code><patient_nom>patient_nom</patient_nom><patient_prenom>patient_prenom</patient_prenom><patient_date_naissance>patient_date_naissance</patient_date_naissance><prati_nom>prati_nom</prati_nom></patient></bibli_export>"))
