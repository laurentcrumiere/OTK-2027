global function integer fxg_positions_charger (string clef_prefixe, ref long win_x, ref long win_y, ref long win_w, ref long win_h);// fx qui charge les coordonnées de l'élément dont le préfixe (une simple string) est passé en param
// la sauvegarde des coordonnées est faite ds le fichier orthokis.ini
// return 1 si des coordonnées sont récup + maj des var en ref
//		-1 si pb

int		returnval = -1
string	tmp_recup


if fxg_ini_local_lire( win_positions, clef_prefixe + "_x", tmp_recup ) = 1 then
	win_x = long( tmp_recup )
	if fxg_ini_local_lire( win_positions, clef_prefixe + "_y", tmp_recup ) = 1 then
		win_y = long( tmp_recup )
		if fxg_ini_local_lire( win_positions, clef_prefixe + "_w", tmp_recup ) = 1 then
			win_w = long( tmp_recup )
			if fxg_ini_local_lire( win_positions, clef_prefixe + "_h", tmp_recup ) = 1 then
				win_h = long( tmp_recup )
				returnval = 1
			end if
		end if
	end if
end if

return returnval 
end function

