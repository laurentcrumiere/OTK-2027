table(column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code dbname="planification.code" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=ordre dbname="planification.ordre" )
 column=(type=char(200) update=yes updatewhereclause=yes name=libelle dbname="planification.libelle" )
