 column=(type=decimal(0) update=yes updatewhereclause=yes name=jour_semaine dbname="planification.jour_semaine" values="Dimanche	1/Lundi	2/Mardi	3/Mercredi	4/Jeudi	5/Vendredi	6/Samedi	7/" )
