table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_debut dbname="jours_interdits.date_debut" dbalias=".date_debut" initial="now()" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_fin dbname="jours_interdits.date_fin" dbalias=".date_fin" initial="now()" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=fauteuil_debut dbname="jours_interdits.fauteuil_debut" dbalias=".fauteuil_debut" initial="1" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=fauteuil_fin dbname="jours_interdits.fauteuil_fin" dbalias=".fauteuil_fin" initial="99" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code_praticien dbname="jours_interdits.code_praticien" dbalias=".code_praticien" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(9) updatewhereclause=yes name=cmois dbname="mois" )
 column=(type=char(50) update=yes updatewhereclause=yes name=jours_interdits_commentaire dbname="jours_interdits.commentaire" dbalias=".commentaire" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="jours_interdits.user_modif" dbalias=".user_modif" )
 column=(type=datetime update=yes updatewhereclause=yes name=date_modif dbname="jours_interdits.date_modif" dbalias=".date_modif" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=couleur dbname="jours_interdits.couleur" dbalias=".couleur" initial="0" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"jours_interdits~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"jours_interdits.date_debut~") COLUMN(NAME=~"jours_interdits.date_fin~") COLUMN(NAME=~"jours_interdits.fauteuil_debut~") COLUMN(NAME=~"jours_interdits.fauteuil_fin~") COLUMN(NAME=~"jours_interdits.code_praticien~") COLUMN(NAME=~"prati.nom~") COMPUTE(NAME=~"cast(month(date_debut) as char(2))+' / '+cast(year(date_debut) as char(4)) as Mois~") COLUMN(NAME=~"jours_interdits.commentaire~") COLUMN(NAME=~"jours_interdits.user_modif~") COLUMN(NAME=~"jours_interdits.date_modif~") COLUMN(NAME=~"prati.prenom~") COLUMN(NAME=~"jours_interdits.couleur~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"jours_interdits.code_praticien~" )) " update="jours_interdits" updatewhere=0 updatekeyinplace=no  sort="code_praticien A date_debut A date_fin A " )
