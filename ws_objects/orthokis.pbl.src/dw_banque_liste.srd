table(column=(type=char(50) update=yes updatewhereclause=yes name=ident dbname="banque.ident" dbalias=".ident" )
 column=(type=char(26) update=yes updatewhereclause=yes name=rib dbname="banque.rib" dbalias=".rib" )
 column=(type=char(50) update=yes updatewhereclause=yes name=banq1 dbname="banque.banq1" dbalias=".banq1" )
 column=(type=char(50) update=yes updatewhereclause=yes name=banq2 dbname="banque.banq2" dbalias=".banq2" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code dbname="banque.code" dbalias=".code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Le CODE doit être obligatoirement saisi !~"" )
