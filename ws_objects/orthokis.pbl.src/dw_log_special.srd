table(column=(type=char(200) updatewhereclause=yes name=log_special_action dbname="log_special.action" )
 column=(type=char(81) updatewhereclause=yes name=nom_patient dbname="nom_patient" )
 column=(type=datetime updatewhereclause=yes name=log_special_date_heure dbname="log_special.date_heure" )
 column=(type=char(30) updatewhereclause=yes name=log_special_user_nom dbname="log_special.user_nom" )
 column=(type=number updatewhereclause=yes name=log_special_code dbname="log_special.code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"log_special~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"log_special.action~") COMPUTE(NAME=~"patient.nom + ' '+  isnull(patient.prenom, '') as nom_patient~") COLUMN(NAME=~"log_special.date_heure~") COLUMN(NAME=~"log_special.user_nom~") COLUMN(NAME=~"log_special.code~")    JOIN (LEFT=~"log_special.code~"    OP =~"=~"RIGHT=~"patient.code~"    OUTER1 =~"log_special.code~" )WHERE(    EXP1 =~"date(~~~"log_special~~~".~~~"date_heure~~~")~"   OP =~">=~"    EXP2 =~":v_date_limite~" ) ) ARG(NAME = ~"v_date_limite~" TYPE = date) " arguments=(("v_date_limite", date))  sort="log_special_date_heure A log_special_action A log_special_user_nom A " )
