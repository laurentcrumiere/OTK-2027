table(column=(type=char(6) updatewhereclause=yes key=yes name=code dbname="mutuelle.code" dbalias=".code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce Code doit être obligatoirement saisi~"" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="mutuelle.nom" dbalias=".nom" )
