 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mutuelle~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"mutuelle.code~") COLUMN(NAME=~"mutuelle.nom~") COLUMN(NAME=~"mutuelle.actif~") COLUMN(NAME=~"mutuelle.ordre_trie~") COLUMN(NAME=~"table_vide.v1~")WHERE(    EXP1 =~"~~~"mutuelle~~~".~~~"nom~~~"~"   OP =~"like~"    EXP2 =~":cherche~" ) ) ARG(NAME = ~"cherche~" TYPE = string) " update="mutuelle" updatewhere=0 updatekeyinplace=yes arguments=(("cherche", string))  sort="ordre_trie A nom A " )
