event clicked;if w_click_soins_reg.impression_integre then
	
	// Impression du Versio
	
	string v_imprim_defaut
	long num_job
	
	v_imprim_defaut = change_imprimante(var_code_local)
	
	num_job = printopen("Feuille Soins 2014")
	//w_click_soins_reg.dw_fs2014_verso.retrieve(1)
	//Printdatawindow(num_job,w_click_soins_reg.dw_fs2014_verso)
	//printclose(num_job)
	
	remet_imprimante_defaut(v_imprim_defaut)
else
	
	// Modification du docu fs2014.doc
	
	if FileExists(dir_ini + fxg_nom_fichier_fs2014_doc_ou_docx()) then
		
		// ouvre un fichier word 
		uo_lien_word uo_word
		
		uo_word = create uo_lien_word
		
		uo_word.traiter_avec_word(Service_EditerCourrier, dir_ini, fxg_nom_fichier_fs2014_doc_ou_docx(), false) 
		
	else
		Messagebox("ATTENTION","Le fichier d'impression de la Feuille de Soins est introuvable.~n~nVeuillez contacter ARAKIS.")
	end if
end if
end event

