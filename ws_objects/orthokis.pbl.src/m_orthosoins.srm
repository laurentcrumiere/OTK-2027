		chg_coord(dw_recto,"nom_praticien_1",dx,dy)	
		chg_coord(dw_recto,"prati_numero_structure_1",dx,dy)	

	end if
	
end if
end subroutine

public function boolean prepa_recto_feuille_soin (datawindow dw_paye);	// On va se service de la table feuille_soins en tant que temporaire
	
	long nb		// Dans la table feuille de soins
	long ligtot,lig, cpttp // Lignes de soins
	boolean 	date_exe_ok = true
	date date_temp

 	fs2014_tp_caisse = false
	fs2014_tp_mutuelle = false
	setnull(date_ep_fs2014)

	setnull(date_paiement_honoraires)
	
	// Pour se repérer dans les actes
	double code_patient,cle_soin,nb_lettre_soin,montant_soin
	date date_exe
	string code_soin,lettre_soin,v_ep,v_motif,v_nom_soin, v_libelle
	integer v_duree
	
	select count(*) into :nb from "feuille_soins" ;
	
	// Y a t il quelqu'un qui l'utilise ?
	if nb > 0 then
		MessageBox("ATTENTION","Un autre utilisateur imprime une feuille. ~n~nVeuillez renouveler votre demande.~n~n(Si aucun utilisateur n'imprime, utilisez la fonction 'Déblocage impression' de ce menu)")
		return (false)
	else
		
		// On ajoute tous les soins sélectionnés dans la DW ...
		// On se sert de la zone FSE

		if dw_paye.find("fse = 'O'",0,dw_paye.rowcount()) > 0 then

			// Balayage des actes
			ligtot = dw_paye.rowcount()
			for lig = 1 to ligtot
				if dw_paye.getitemstring(lig,"fse") = 'O' and date_exe_ok then
					// Ligne de soins
					code_patient = dw_paye.getitemnumber(lig,"soins_code")
					cle_soin 		 = dw_paye.getitemnumber(lig,"cle")
					date_exe 	 = dw_paye.getitemdate(lig,"soins_date_exe")
				
					// Si la date d'exécution du soin est nulle => On empêche d'aller plus loin
					// (On mettra, dans les soins, la date d'exécution par défaut pour les actes non soumis à entente)
					If isnull(date_exe) then
						MessageBox("ATTENTION !","Au moins un des actes sélectionné n'a pas de date d'exécution !")
						date_exe_ok = false
					else

						code_soin = dw_paye.getitemstring(lig,"code_soins_code")
						nb_lettre_soin = dw_paye.getitemnumber(lig,"scp_demande")
						montant_soin = dw_paye.getitemnumber(lig,"total")
						
						// on met un motif lorsqu'il y a déplassement 
						if dw_paye.getitemnumber(lig,"hn") > 0 then
							v_motif = "ED"
						else
							v_motif = ''
						end if
						
						
						SELECT "lettre" , "renouvt", "nom" , "duree"	
						INTO :lettre_soin , :v_ep, :v_nom_soin 	, :v_duree 
						FROM "code_soins" WHERE code = :code_soin ;

						// On mémorise le soin dans la table "temporaire"
						v_libelle = ""
						if v_ep = "O" then
							// Pour les actes avec ententes, on va en plus regarder le libellé du soin
							// Pas pour les autres
							v_libelle = "("+v_nom_soin + " "+string(dw_paye.getitemnumber(lig,"numero"))+")"
							date_ep_fs2014 =  dw_paye.getitemdate(lig,"date_demande")
						else
							v_libelle = "("+v_nom_soin+")"
						end if
						
						// Depuis V2014, pour l'impression dans le cadre du haut ou du bas on se base sur la durée et non le renouvellement (cas des FDO et des Trimestre)
						if v_duree > 0 then
							v_ep ='O'
						end if
						
						  INSERT INTO "feuille_soins"   ( "date",   "dent",   "lettre",   "nb_lettre",   "motif",    "montant",   "ep", "libelle" )  
						  VALUES ( :date_exe,   'ODF',   :lettre_soin,   :nb_lettre_soin,   :v_motif,   :montant_soin,   :v_ep, :v_libelle )  ;
						  
							fs2014_tp_caisse = false
							fs2014_tp_mutuelle = false

						// Tiers payants ?
						select isnull(count(*), 0) into :cpttp from ligne_soins where code = :code_patient and cle = :cle_soin  and origine_tp = 'C' ;
						if cpttp > 0 then
							fs2014_tp_caisse = true
						end if
						select isnull(count(*), 0) into :cpttp from ligne_soins where code = :code_patient and cle = :cle_soin  and origine_tp = 'M' ;
						if cpttp > 0 then
							fs2014_tp_mutuelle = true
						end if
						
						
						
						// Calcul de la date de paiement des honoraires (en bas du recto)					
				
						// on prend la date maxi de règlement
						select max("date") into :date_temp from "paye" where code = :code_patient and cle = :cle_soin ;  
						
						if isnull(date_paiement_honoraires) and not isnull(date_temp) then
							date_paiement_honoraires = date_temp
						else 
							if not isnull(date_paiement_honoraires) and  not isnull(date_temp) then
								if date_paiement_honoraires < date_temp then
									date_paiement_honoraires = date_temp
								end if
							end if
						end if
					
					end if
				end if
			next
			
			commit ;

			if date_exe_ok then
				return(true)
			else
				// On vide la table 
				delete from "feuille_soins" ;
				commit ;
				return(false)
			end if
				
		else
			if not Belgique then
				MessageBox("ATTENTION","Vous devez sélectionner (au moins) un soin avant de réaliser une Feuille de Soin.")
			end if
			return (false)
		end if
	end if

end function

public subroutine maj_tableaux_recto_feuille_soins (datawindow dw_recto);//
//
//   Remplissage manuel des "tableaux" depuis 14.01m car ça merde avec PB 10.5.2
//
//


string v_ep 
string v_dent, v_lettre,  v_libelle, v_motif 
decimal {2} v_nb_lettre
date v_dat
integer lig, nb_lig

// Remplissage manuel des "tableaux" depuis 14.01m car ça merde avec PB 10.5.2
DECLARE cur CURSOR FOR SELECT "date", dent, lettre, nb_lettre, libelle, motif 
from feuille_soins 
where ep = :v_ep 
order by lettre, "date", nb_lettre ;


// Cadre 1
v_ep = 'N'
open cur ;
fetch cur into :v_dat, :v_dent, :v_lettre, :v_nb_lettre, :v_libelle, :v_motif ;
lig = 1

// On vierge les ZONES
	
	// Cadre du haut
	nb_lig = 9
	for lig = 1 to nb_lig
		dw_recto.modify("tab1_lig"+string(lig)+"_date.text = ''") 
		dw_recto.modify("tab1_lig"+string(lig)+"_dent.text = ''") 
		dw_recto.modify("tab1_lig"+string(lig)+"_lettre.text = ''") 
		dw_recto.modify("tab1_lig"+string(lig)+"_nb_lettre.text = ''") 
		dw_recto.modify("tab1_lig"+string(lig)+"_libelle.text = ''") 
		dw_recto.modify("tab1_lig"+string(lig)+"_motif.text = ''") 
	next
	dw_recto.modify("tab1_total_lettres.text = ''") 
	dw_recto.modify("tab1_total_euros.text = ''") 
	dw_recto.modify("tab1_nombre_en_lettres.text = ''") 

// On limite à 9 lignes !!!
lig = 1
do while sqlca.sqlcode = 0 and lig <= nb_lig
	
	// Mise à jour des valeurs
	dw_recto.modify("tab1_lig"+string(lig)+"_date.text = '"+string(v_dat,"dd/mm/yyyy")+"'")
	dw_recto.modify("tab1_lig"+string(lig)+"_dent.text = '"+v_dent+"'")
	dw_recto.modify("tab1_lig"+string(lig)+"_lettre.text = '"+v_lettre+"'")
	dw_recto.modify("tab1_lig"+string(lig)+"_nb_lettre.text = '"+string(v_nb_lettre)+"'")
	dw_recto.modify("tab1_lig"+string(lig)+"_libelle.text = '"+v_libelle+"'")
	dw_recto.modify("tab1_lig"+string(lig)+"_motif.text = '"+v_motif+"'")
	
	lig = lig + 1
	
	fetch cur into :v_dat, :v_dent, :v_lettre, :v_nb_lettre, :v_libelle, :v_motif ;
loop

close cur ;


// Cadre 2

// On vierge les ZONES
	// Cadre du bas
	nb_lig = 5
	for lig = 1 to nb_lig
		dw_recto.modify("tab2_lig"+string(lig)+"_date.text = ''") 
		dw_recto.modify("tab2_lig"+string(lig)+"_dent.text = ''") 
		dw_recto.modify("tab2_lig"+string(lig)+"_lettre.text = ''") 
		dw_recto.modify("tab2_lig"+string(lig)+"_nb_lettre.text = ''") 
		dw_recto.modify("tab2_lig"+string(lig)+"_libelle.text = ''") 
		dw_recto.modify("tab2_lig"+string(lig)+"_motif.text = ''") 
	next
	dw_recto.modify("tab2_total_lettres.text = ''") 
	dw_recto.modify("tab2_total_euros.text = ''") 
	dw_recto.modify("tab2_nombre_en_lettres.text = ''") 


v_ep = 'O'
open cur ;
fetch cur into :v_dat, :v_dent, :v_lettre, :v_nb_lettre, :v_libelle, :v_motif ;
lig = 1
// On limite à 5 lignes !!!
do while sqlca.sqlcode = 0 and lig < 6
	
	// Mise à jour des valeurs
	dw_recto.modify("tab2_lig"+string(lig)+"_date.text = '"+string(v_dat,"dd/mm/yyyy")+"'")
	dw_recto.modify("tab2_lig"+string(lig)+"_dent.text = '"+v_dent+"'")
	dw_recto.modify("tab2_lig"+string(lig)+"_lettre.text = '"+v_lettre+"'")
	dw_recto.modify("tab2_lig"+string(lig)+"_nb_lettre.text = '"+string(v_nb_lettre)+"'")
	dw_recto.modify("tab2_lig"+string(lig)+"_libelle.text = '"+v_libelle+"'")
	dw_recto.modify("tab2_lig"+string(lig)+"_motif.text = '"+v_motif+"'")
	
	lig = lig + 1
	
	fetch cur into :v_dat, :v_dent, :v_lettre, :v_nb_lettre, :v_libelle, :v_motif ;
loop

close cur ;
end subroutine

public subroutine decalage_partiel (character mode, boolean avec_confirmation, double cle_a_ne_pas_modifier);// Décalage partiel par rapport à une date de soin

// L'argument mode sert à savoir ce qu'on décale :
//    Mode = 'E' : on ne décale que les échéances
//    Mode = 'D' : on ne décale que les dates de soins (demande)
//    Mode = 'T' :  on décale toutes les dates


// Avec_confirmation : pour savoir si on pose ou pas la question AVANT de décaler
// cle_a_ne_pas_modifier : vaudra -1 dans les cas décalages par le user (on modifie toutes les clefs) - vaudra une valeur si on est en insertion d'un soin et qu'on décale la suite


boolean v_suite


If dw_click.rowCount() > 0 Then
	date dt,dd
	string cde
	integer ecart, numero
	string libelle_decalage, v_id_tea
	long ligne_courante 
	decimal{2} v_total
	double v_cle
	
	ligne_courante = dw_click.GetRow()
	
	var_code_local = dw_click.getitemnumber(ligne_courante,"soins_code")
	
	v_date_soin = dw_click.GetItemDate(ligne_courante,"date_demande")
	
	if avec_confirmation then
		open(w_soin_date_decalage)
	else

		var_suite = true
		
		// recherche de la date de fin du soin   "cle_a_ne_pas_modifier" 
		select dateadd (month , code_soins.duree, soins.date_demande ) into :v_date_soin 
		from soins, code_soins 
		where soins.code = :var_code_local and cle = :cle_a_ne_pas_modifier and soins."type" = code_soins.code ;
				
	end if
	
	IF var_suite THEN
		dd = dw_click.GetItemDate(dw_click.GetRow(),"date_demande")
		numero = dw_click.GetItemNumber(dw_click.GetRow(),"numero")
		dt = v_date_soin
		ecart = daysafter(dd,dt) 
		
		libelle_decalage = ''
		// Libellé en fonction du mode de décalage
		CHOOSE CASE mode
		CASE 'E'
			libelle_decalage ='(Décalage des Echéances)'
		CASE 'D'
			libelle_decalage ='(Décalage des Dates de Demandes)'
		CASE 'T'
			libelle_decalage ='(Décalage des Echéances et des Dates de Demandes)'
		END CHOOSE

		
		
		v_suite = true
		
		if avec_confirmation then
			If not MessageBox("Actualisation partielle de dates","L'ancienne date de demande était le "+string(dd)+"~nLa nouvelle date de demande sera le "+string(dt)+"~n~nSoit un écart de "+string(ecart)+" jour(s)~n~nVoulez-vous décaler d'autant les semestres et contentions suivants "+ libelle_decalage+" ?~n~n(Attention, cette actualisation est irréversible !)",Question!,YesNo!,2) = 1 then
				v_suite = false
			end if
		end if
		
		
		if v_suite then
			open(w_patience)
	
			if mode = 'E' or mode = 'T' then
				// On actualise les dates d'échéances
//				cde = 'UPDATE ligne_soins,soins,code_soins SET "date" = days("date",'+string(ecart)+') WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins"."code" = "ligne_soins"."code" 	and "soins"."cle" <> ' + string(cle_a_ne_pas_modifier)+ 'and "soins"."cle" = "ligne_soins"."cle" and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(dd,'yyyy-mm-dd') +"'"
				cde = 'UPDATE ligne_soins,soins,code_soins SET "date" =  dateadd(day,'+string(ecart)+', "date")  WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins"."code" = "ligne_soins"."code" 	and "soins"."cle" <> ' + string(cle_a_ne_pas_modifier)+ 'and "soins"."cle" = "ligne_soins"."cle" and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(dd,'yyyy-mm-dd') +"'"
				EXECUTE IMMEDIATE :cde ;
				if sqlca.sqlcode <> 0 then
					messagebox("Problème dans l'actualisation 1",sqlca.sqlerrtext)
				end if
				w_patience.Wf_SetValue(50)
			end if
			
			
			if mode = 'D' or mode = 'T' then
				// On actualise les Dates d'execution depuis la V10 .. y compris le premier
//				cde = 'UPDATE soins,code_soins SET "date_exe" = days("date_exe",'+string(ecart)+') WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(dd,'yyyy-mm-dd') +"' and date_exe is not null and soins.cle <> "+string(cle_a_ne_pas_modifier)
				cde = 'UPDATE soins,code_soins SET "date_exe" = dateadd(day,'+string(ecart)+', "date_exe") WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(dd,'yyyy-mm-dd') +"' and date_exe is not null and soins.cle <> "+string(cle_a_ne_pas_modifier)
				EXECUTE IMMEDIATE :cde ;
				if sqlca.sqlcode <> 0 then
					messagebox("Problème dans l'actualisation 3",sqlca.sqlerrtext)
				end if

				// On actualise les dates de demandes
//				cde = 'UPDATE soins,code_soins SET "date_demande" = days("date_demande",'+string(ecart)+') WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(dd,'yyyy-mm-dd') +"'"+ "  and soins.cle <> "+string(cle_a_ne_pas_modifier)
				cde = 'UPDATE soins,code_soins SET "date_demande" = dateadd(day,'+string(ecart)+', "date_demande")  WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(dd,'yyyy-mm-dd') +"'"+ "  and soins.cle <> "+string(cle_a_ne_pas_modifier)
				EXECUTE IMMEDIATE :cde ;
				if sqlca.sqlcode <> 0 then
					messagebox("Problème dans l'actualisation 2",sqlca.sqlerrtext)
				end if

			end if
			
			commit ;
			
			if APPEL_VISIODENT and NOT VISIODENT_LIMITE then
				// Il y a eu actualisation, on renvoie tous les soins
				fxg_ods_envoi_soins_date(var_code_local, v_date_soin )
			end if
			
			IF TEA then
				// On parcours les soins modifiés pour actualiser Téa
				declare cur_soins cursor for select soins.cle, soins.total from soins  ,code_soins WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = :var_code_local  and "date_demande" >= :dd and soins.cle <> :cle_a_ne_pas_modifier ;
				open cur_soins ;
				fetch cur_soins into :v_cle, :v_total ;
				do while sqlca.sqlcode = 0  
					if  v_total  > 0 then
						v_id_tea = string(var_code_local) + "-" + string(v_cle)
						//fxg_lancer_commande_dsapi("payment/update/" + v_id_tea, "",  "S", "G", var_code_local )
						fxg_maj_soins_tea(var_code_local, v_cle, "U")
					end if
					fetch cur_soins into :v_cle , :v_total  ;
				loop
				close cur_soins ;
			end if

			dw_click.retrieve(var_code_local)
			dw_click.scrolltorow(99999)
			close(w_patience)
   
		end if			

	end if
End If

end subroutine

public subroutine utiliser_courrier_word (string type_courrier, double numero);
// Type courrier :
// S : soins classiques (pour devis ou autres)
// F : spécial feuille de soins FRANCE .. pas le choix du docu word ....
// A : spécial attestation de soins Belge feuille de soin .. pas le choix du docu word ....
// FF : spécial Facture France .. pas le choix du docu word ....
// J : spécial Justificatif Belgique .. pas le choix du docu word ....
// R : spécial Reçu ... pas le choix de docu word ....


// Numero : contient numero de facture si besoin (FF), 0 sinon




// Principe identique à l'imagerie
// Centralisation du code là bas ... sauf pour la sélection des actes


// uniquement pour utiliser la fonction
m_btdroit_gearbox m_menu


m_menu = create m_btdroit_gearbox

// Repérage des soins sélectionnés et exportation des valeurs en vue du publipostage !
long nb_soins_max
long nb_echeance_max = 12
long cpt_soins, cpt_ech, cpt_soins_general
long nb_lig, lig
string v_libelle, v_nature, v_renouvt
double  v_cle
double v_numero

date v_date_eche, v_date_demande, v_date_cour
double v_montant_eche, v_code_local, v_nb_lettres

string inifile_echeancier = "echeancier.ini"
string v_coment,  v_date_exe, v_nb_lettres_string, v_dent

date v_fin_soin
string v_code_soin
long v_duree


date v_date_paye
decimal {2} v_montant_paye
string v_mode_reglement

boolean v_suite = false


nb_soins_max= integer(profilestring(dir_ini+inifile_orthokis,"WORD","nb_lignes_soins","10"))
 
//Création du fichier si n'existe pas ... sera temporaire
if fileexists(dir_ini + inifile_echeancier) then
	v_suite = FileDelete(dir_ini + inifile_echeancier)
else
	v_suite = true
end if
	


if v_suite then

	open(w_patience)

	integer v_file
	v_file = FileOpen(dir_ini + inifile_echeancier, linemode!, Write!)
	 FileWrite(v_file, "")
	 FileClose(v_file)
	 

	
	
	
	// Curseur sur les échéances de reglements des soins
	declare cur cursor for select "date", montant from ligne_soins where code = :v_code_local and cle = :v_cle order by "date" asc, tp desc, origine_tp asc, montant desc ;
	
	// Curseur sur les échéances de reglements des soins prévus
	declare curprev cursor for select "date", montant from ligne_soins_prevus where code = :v_code_local and cle = :v_cle order by "date" asc, tp desc, origine_tp asc, montant desc ;
	
	
	// Curseur sur les règlements
	declare curreg cursor for select "date", montant, mode_reglement.nom from paye, mode_reglement where paye.code = :v_code_local and cle = :v_cle and paye."mode" = mode_reglement.code  
	order by "date" asc, tp desc, origine_tp asc, montant desc ;
	
	
	
	// Ecriture des valeurs sélectionnées
	
	v_code_local = w_click_soins_reg.var_code_local
	
	// Faut mettre à jour la variable globale pour compatibilité
	// sera ensuite remise à jour par la fonction Utiliser_Office
	var_code = v_code_local
	
	decimal {2} total_honoraires = 0
	decimal {2} total_honoraires_pc = 0
	decimal {2} total_base = 0
	decimal {2} total_depassement = 0
	decimal {2} total_paye = 0
	decimal {2} total_paye_pc = 0
	decimal {2} total_paye_du_jour = 0
	decimal {2} total_paye_sans_virement = 0
	decimal {2} total_paye_du_jour_sans_virement = 0
	decimal {2} montant_paye_soin = 0
	decimal {2} inter_inami_avec , inter_inami_sans
	
	
	integer nb_echeances_patient, nb_echeances_mutuelle, nb_echeances_caisse
	
	string v_symbole_euro
	select top 1 isnull(symbole_euro, '€') into :v_symbole_euro from param ;
	
	String v_croix_part_obligatoire = ""
	String v_croix_part_complementaire = ""
	string v_code_association
	
	double v_part_patient, v_part_caisse, v_part_mutuelle
	
	//--------------------------- GESTION DES PSEUDOCODES -----------------------------------------------------------------------
	// Prefixe .. correspond à la catégorie du pseudo code ... Catégorie de 1 à 15
	string s_prefixe = ""
	boolean b_pseudocode
	if Belgique and type_courrier = 'J' then
		string v_pseudocode, v_categorie_pseudocode
		integer tab_cpt_pc[]	// compteur de pseudocodes 
		integer i_cpt_pc
		for i_cpt_pc = 1 to 15
			tab_cpt_pc[i_cpt_pc] = 0
		next
	end if
	
	//------------------------------------------------------------------------------------------------------------------------------------
	
	nb_lig = dw_click.rowcount()
	cpt_soins_general = 0
		
	for lig = 1 to nb_lig
		if dw_click.getItemString(lig, "fse")  = "O" then
			
			cpt_soins_general = cpt_soins_general + 1
			
			if BELGIQUE and type_courrier = "J" then 
				// pour le justificatif belge, si quelque chise de dnotee dans le commentaire onle prend pour spécifiquer les soins spéciaux Orthodontie
				
				if trim (dw_click.getItemString(lig, "soins_comment") ) <> "" then
					v_libelle = trim (dw_click.getItemString(lig, "soins_comment") )
				else
					v_libelle = trim (dw_click.getItemString(lig, "code_soins_nom") )
				end if
			else
				v_libelle = trim (dw_click.getItemString(lig, "code_soins_nom") )
			end if
			v_numero  = dw_click.getItemNumber(lig, "numero") 
			v_cle = dw_click.getItemNumber(lig, "cle") 
			v_nature = dw_click.getItemString(lig, "code_soins_nature") 
			v_renouvt = dw_click.getItemString(lig, "code_soins_renouvt")  
			
			select isnull(count(*), 0), isnull(sum(montant),0) into :nb_echeances_patient, :v_part_patient from ligne_soins where code = :v_code_local and cle = :v_cle and tp = 'N' ;
			select isnull(count(*), 0), isnull(sum(montant),0) into :nb_echeances_caisse, :v_part_caisse from ligne_soins where code = :v_code_local and cle = :v_cle and tp = 'O' and origine_tp = 'C' ;
			select isnull(count(*), 0), isnull(sum(montant),0) into :nb_echeances_mutuelle, :v_part_mutuelle from ligne_soins where code = :v_code_local and cle = :v_cle and tp = 'O' and origine_tp = 'M' ;
			
			if v_numero > 0 then
				v_libelle = v_libelle + " N°"+string(v_numero)
			end if
			
			if w_click_soins_reg.type_gestion = 'S'  or w_click_soins_reg.type_gestion = 'R' then
				// recherche du commentaire du soin directement en BD
				if LUXEMBOURG then
					// Format de date spécial
					SELECT isnull("soins"."comment",''), dateformat("soins"."date_exe", 'ddmmyy'), isnull(dent,'') , code_association     
					INTO :v_coment, :v_date_exe , :v_dent  , :v_code_association   
					FROM "soins"     
					WHERE ( "soins"."code" = :v_code_local ) AND ( "soins"."cle" = :v_cle )   ;
				else
					// format de date normal
					SELECT isnull("soins"."comment",''), dateformat("soins"."date_exe", 'dd/mm/yyyy'), isnull(dent,'') , code_association     
					INTO :v_coment, :v_date_exe , :v_dent  , :v_code_association   
					FROM "soins"     
					WHERE ( "soins"."code" = :v_code_local ) AND ( "soins"."cle" = :v_cle )   ;
				end if
				
			else
				// Pas de commentaire en soins 
				v_coment = ""
				v_date_exe = ""
				v_dent=''
				v_code_association=""
			end if
	
			v_code_soin = dw_click.getItemString(lig, "type")
	
			//--------------------------- GESTION DES PSEUDOCODES -----------------------------------------------------------------------
			b_pseudocode = false
			
			if Belgique and type_courrier = 'J' then
				// Uniquement pour les justificatifs Belges, on doit gérer les pseudocodes
				select isnull(pseudocode, 'N'), trim(isnull(categorie_pseudocode, ''))
				into :v_pseudocode, :v_categorie_pseudocode 
				from code_soins where code = :v_code_soin ;  
				i_cpt_pc =  integer(v_categorie_pseudocode)
				if v_pseudocode = "O" and 1 <= i_cpt_pc  and  i_cpt_pc <= 15   then
					// Pseudo code
					b_pseudocode = true
					s_prefixe = "PC_" + trim(v_categorie_pseudocode) + "_"
					tab_cpt_pc[i_cpt_pc] = tab_cpt_pc[i_cpt_pc] + 1 
					cpt_soins = tab_cpt_pc[i_cpt_pc]
					cpt_soins_general = cpt_soins_general - 1 // pour ne pas avancer le compte de soins "normaux"
					if len(trim(v_code_soin)) = 13 then 
						// Les pseudocodes doivent etre sous la forme xxxxxx-yyyyyy => on découpe
						SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Code_soin_courant"  + string(cpt_soins) , left(v_code_soin, 6) )
						SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Code_pc_soin_courant"  + string(cpt_soins) , right(v_code_soin, 6) )
					else
						// on ne découpe pas
						SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Code_soin_courant"  + string(cpt_soins) , v_code_soin )
						SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Code_pc_soin_courant"  + string(cpt_soins) , "" )
					end if
				else
					// Soin normal
					s_prefixe = ""
					cpt_soins = cpt_soins_general
					SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Code_soin_courant"  + string(cpt_soins) , v_code_soin )
				end if 
			else
				s_prefixe = ""
				cpt_soins = cpt_soins_general
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Code_soin_courant"  + string(cpt_soins) , v_code_soin )
			end if
			//------------------------------------------------------------------------------------------------------------------------------------------
			
			
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Libelle_soin_courant" + string(cpt_soins) , v_libelle )
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Du_Debut_soin_courant"  + string(cpt_soins) , "Du" )
			if LUXEMBOURG then 
				// Format de date spécial
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Debut_soin_courant"  + string(cpt_soins) , string(dw_click.getItemDate(lig, "date_demande") , "ddmmyy" ))
			else
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Debut_soin_courant"  + string(cpt_soins) , string(dw_click.getItemDate(lig, "date_demande") ))
			end if
			
			
			// Eléments de la fiche code_soins
			select isnull(duree, 0), isnull(inter_inami_sans, 0), isnull(inter_inami_avec, 0)
			into :v_duree , :inter_inami_sans, :inter_inami_avec
			from code_soins where code = :v_code_soin ;
			
			if v_duree > 0 then 
				if v_date_exe = "" then 
					v_fin_soin = ajout_x_mois(dw_click.getItemDate(lig, "date_demande"), v_duree)
				else
					v_fin_soin = date(v_date_exe)
				end if
				
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Au_Fin_soin_courant"  + string(cpt_soins) , "au" )
	
				if LUXEMBOURG then 
					// Format de date spécial
					SetProfileString( dir_ini + inifile_echeancier, s_prefixe + "Admini",s_prefixe + "Fin_soin_courant"  + string(cpt_soins) , string(v_fin_soin , "ddmmyy" ))
				else
					SetProfileString( dir_ini + inifile_echeancier, s_prefixe + "Admini",s_prefixe + "Fin_soin_courant"  + string(cpt_soins) , string(v_fin_soin ))
				end if
			end if
			
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Date_execution_soin_courant"  + string(cpt_soins) , v_date_exe)
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Nature_soin_courant"  + string(cpt_soins) , v_nature)
			
			if v_renouvt = "O" then
				if LUXEMBOURG then 
					// Format de date spécial
					SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Date_demande_soin_courant" , string(dw_click.getItemDate(lig, "date_demande"), "ddmmyy" ) )
				else
					SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Date_demande_soin_courant" , string(dw_click.getItemDate(lig, "date_demande") ) )
				end if
			else
				// Si pas de renouvellement, on regarde si TO 45 ou TO 90 et on recherche une demande sur une autre ligne.. idem pour TO 50 et TO 100 pour fentes palatines
				if dw_click.getItemNumber(lig, "scp_demande") = 45 or dw_click.getItemNumber(lig, "scp_demande") = 90 or dw_click.getItemNumber(lig, "scp_demande") = 50 or dw_click.getItemNumber(lig, "scp_demande") = 100 then
	
					// recherche de la demande précédent 
					v_date_cour = dw_click.getItemDate(lig, "date_demande")
					if w_click_soins_reg.type_gestion = 'S'  or w_click_soins_reg.type_gestion = 'R' then
						// soins
						select max(date_demande) into :v_date_demande from soins, code_soins
						where  ( "soins"."code" = :v_code_local ) and "soins"."type" = "code_soins"."code" and "code_soins"."renouvt" = 'O' and "soins"."date_demande" <= :v_date_cour ;
					else
						// soins prévus
						select max(date_demande) into :v_date_demande from soins_prevus, code_soins
						where  ( "soins_prevus"."code" = :v_code_local ) and "soins_prevus"."type" = "code_soins"."code" and "code_soins"."renouvt" = 'O' and "soins_prevus"."date_demande" <= :v_date_cour ;
					end if
					if LUXEMBOURG then 
						// Format de date spécial
						SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Date_demande_soin_courant" , string(v_date_demande, "ddmmyy") )
					else
						SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Date_demande_soin_courant" , string(v_date_demande) )
					end if
				end if
			end if
				
			
			if v_nature = "C" then
				// CCAM
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Code_ccam_soin_courant"  + string(cpt_soins) , trim(dw_click.getItemString(lig, "code_soins_lettre")) )
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Code_association_soin_courant"  + string(cpt_soins) , v_code_association )
				
			else
				// NGAP
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Cotation_soin_courant"  + string(cpt_soins) , trim(dw_click.getItemString(lig, "code_soins_lettre"))+" "+string(dw_click.getItemNumber(lig, "scp_demande")) )
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Lettre_soin_courant"  + string(cpt_soins) , trim(dw_click.getItemString(lig, "code_soins_lettre")) )
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Nombre_lettres_soin_courant"  + string(cpt_soins) , string(dw_click.getItemNumber(lig, "scp_demande")) )
			end if
			
			
			// Total
			if dw_click.getItemNumber(lig, "total") <> 0 then
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Montant_soin_courant"  + string(cpt_soins) , string(dw_click.getItemNumber(lig, "total"), "0.00" ) + " " + v_symbole_euro)
			else
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Montant_soin_courant"  + string(cpt_soins) , "")
			end if
			// Base sécu
			if dw_click.getItemNumber(lig, "scp_demande") * dw_click.getItemNumber(lig, "code_soins_valeur") <> 0 then
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Base_soin_courant"  + string(cpt_soins) , string(dw_click.getItemNumber(lig, "scp_demande") * dw_click.getItemNumber(lig, "code_soins_valeur") , "0.00" )  + " " + v_symbole_euro )
			else
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Base_soin_courant"  + string(cpt_soins) ,"")
			end if
			
			// Depassement 
			if dw_click.getItemNumber(lig, "hn")  <> 0  then
				
				// Cas du dépassement négatif pour la CCAM
				if dw_click.getItemNumber(lig, "hn")  < 0 then
					SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Depassement_soin_courant"  + string(cpt_soins) ,"")
					// hn est négatif
					SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Base_soin_courant"  + string(cpt_soins) , string(dw_click.getItemNumber(lig, "scp_demande") * dw_click.getItemNumber(lig, "code_soins_valeur") + dw_click.getItemNumber(lig, "hn") , "0.00" )  + " " + v_symbole_euro )
				else
					SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Depassement_soin_courant"  + string(cpt_soins) , string(dw_click.getItemNumber(lig, "hn"), "0.00" )  + " " + v_symbole_euro)
					// On peut pas prendre dw_click car mis à jour ailleurs
					// pour être sûr, on prend en base (compatibilité avec liste des fse à faire
					//SetProfileString( dir_ini + inifile_echeancier, "Admini","Motif_depassement_soin_courant"  + string(cpt_soins) , w_click_soins_reg.tab_1.tabpage_soins.dw_impression.getItemString(1, "motif_depassement"))
					
					string v_motif
					select motif_depassement into  :v_motif from soins where code = :v_code_local and cle = :v_cle ;
					SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Motif_depassement_soin_courant"  + string(cpt_soins) , v_motif )
				end if
			else
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Depassement_soin_courant"  + string(cpt_soins) ,"")
			end if
			
			
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Commentaire_soin_courant"  + string(cpt_soins) ,v_coment )
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Dents_soin_courant"  + string(cpt_soins) ,v_dent )
			
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Part_patient_soin_courant" + string(cpt_soins) , string(v_part_patient, '0.00') )
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Part_caisse_soin_courant" + string(cpt_soins) , string(v_part_caisse, '0.00') )
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Part_mutuelle_soin_courant" + string(cpt_soins) , string(v_part_mutuelle, '0.00') )
			
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Inter_Inami_Avec_Pref_soin_courant" + string(cpt_soins), string(inter_inami_avec, '0.00') )
			SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Inter_Inami_sans_Pref_soin_courant" + string(cpt_soins), string(inter_inami_sans, '0.00') )
	
	
			if type_menu <> "P" then
				// Pas dispo dans les soins Prévisionnel
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Date_Feuille_Soins_soin_courant" + string(cpt_soins) , string(dw_click.getItemDate(lig, "soins_date_fs") , "dd/mm/yyyy") )
			end if
					
			if nb_echeances_caisse > 0 then
				v_croix_part_obligatoire = "X"
			end if
			if nb_echeances_mutuelle > 0 then
				v_croix_part_complementaire = "X"
			end if
	
			
			if not isnull(dw_click.getItemNumber(lig, "total")) then 
				if not b_pseudocode then
					total_honoraires = total_honoraires + dw_click.getItemNumber(lig, "total")
				else
					total_honoraires_pc = total_honoraires_pc + dw_click.getItemNumber(lig, "total")
				end if
			end if
			
			if not isnull(dw_click.getItemNumber(lig, "scp_demande") * dw_click.getItemNumber(lig, "code_soins_valeur")) then
				total_base = total_base + dw_click.getItemNumber(lig, "scp_demande") * dw_click.getItemNumber(lig, "code_soins_valeur")
			end if
			
			if not isnull(dw_click.getItemNumber(lig, "hn")) and not b_pseudocode then			// on ne tient pas compte des pseucode pour ces totaux là
				if dw_click.getItemNumber(lig, "hn") > 0 then
					total_depassement = total_depassement + dw_click.getItemNumber(lig, "hn")
				else
					// on enlève les HN négatifs du total base (cas des 2ème radio CCAM)
					total_base = total_base + dw_click.getItemNumber(lig, "hn")
				end if
			end if
			
			// règlements
			Select isnull(sum (montant), 0) into :montant_paye_soin  from paye where code = :v_code_local and cle = :v_cle ;
			if montant_paye_soin <> 0 then
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Montant_paye_soin_courant"  + string(cpt_soins) , string(montant_paye_soin, "0.00" ) + " " + v_symbole_euro)
			else
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Montant_paye_soin_courant"  + string(cpt_soins) , "")
			end if
			
			if b_pseudocode then
				total_paye_pc  = total_paye_pc + montant_paye_soin
			else
				total_paye  = total_paye + montant_paye_soin
			end if
			
				
			
	//		2025
	//		Select isnull(sum (montant), 0) into :montant_paye_soin  from paye where code = :v_code_local and cle = :v_cle and "date" = getdate();
	//		if montant_paye_soin <> 0 then
	//			SetProfileString( dir_ini + inifile_echeancier, "Admini","Montant_paye_du_jour_soin_courant"  + string(cpt_soins) , string(montant_paye_soin, "0.00" ) + " " + v_symbole_euro)
	//		else
	//			SetProfileString( dir_ini + inifile_echeancier, "Admini","Montant_paye_du_jour_soin_courant"  + string(cpt_soins) , "")
	//		end if
	//		total_paye_du_jour  = total_paye_du_jour + montant_paye_soin
	//		
	
			// Sans virement
			Select isnull(sum (montant), 0) into :montant_paye_soin  from paye where code = :v_code_local and cle = :v_cle and "mode" <> 'V';
	//		if montant_paye_soin <> 0 then
	//			SetProfileString( dir_ini + inifile_echeancier, "Admini","Montant_paye_sans_virement_soin_courant"  + string(cpt_soins) , string(montant_paye_soin, "0.00" ) + " " + v_symbole_euro)
	//		else
	//			SetProfileString( dir_ini + inifile_echeancier, "Admini","Montant_paye_sans_virement_soin_courant"  + string(cpt_soins) , "")
	//		end if
			total_paye_sans_virement  = total_paye_sans_virement + montant_paye_soin
			
			
	//		Select isnull(sum (montant), 0) into :montant_paye_soin  from paye where code = :v_code_local and cle = :v_cle and "mode" <> 'V' and "date" = getdate();
	//		if montant_paye_soin <> 0 then
	//			SetProfileString( dir_ini + inifile_echeancier, "Admini","Montant_paye_du_jour_sans_virement_soin_courant"  + string(cpt_soins) , string(montant_paye_soin, "0.00" ) + " " + v_symbole_euro)
	//		else
	//			SetProfileString( dir_ini + inifile_echeancier, "Admini","Montant_paye_du_jour_sans_virement_soin_courant"  + string(cpt_soins) , "")
	//		end if
	//		total_paye_du_jour_sans_virement  = total_paye_du_jour_sans_virement + montant_paye_soin
	//		
			
			// lignes d'échéances
			if w_click_soins_reg.type_gestion = "P" then
				open curprev ;
				fetch curprev into  :v_date_eche, :v_montant_eche ;
			else
				open cur ;
				fetch cur into  :v_date_eche, :v_montant_eche ;
			end if
			cpt_ech = 1
			do while sqlca.sqlcode = 0
				if LUXEMBOURG then 
					// Format de date spécial
					SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Date_echeance"+ string(cpt_ech)+"_soin_courant" + string(cpt_soins) , string(v_date_eche, "ddmmyy" ))
				else
					SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Date_echeance"+ string(cpt_ech)+"_soin_courant" + string(cpt_soins) , string(v_date_eche) )
				end if
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Montant_echeance"+ string(cpt_ech)+"_soin_courant" + string(cpt_soins) , string(v_montant_eche, "0.00" )  + " " + v_symbole_euro)
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Mois_echeance"+ string(cpt_ech)+"_soin_courant" + string(cpt_soins) , mois[month(v_date_eche)] )
				SetProfileString( dir_ini + inifile_echeancier, "Admini",s_prefixe + "Annee_echeance"+ string(cpt_ech)+"_soin_courant" + string(cpt_soins) , string(year(v_date_eche)) )
				if w_click_soins_reg.type_gestion = "P" then
					fetch curprev into  :v_date_eche, :v_montant_eche ;
				else
					fetch cur into  :v_date_eche, :v_montant_eche ;
				end if
				cpt_ech = cpt_ech + 1
			loop
			if w_click_soins_reg.type_gestion = "P" then
				close curprev ;
			else
				close cur ;
			end if
			
			
	
			
	//		2025
	// 		Lignes de règlements
	//		if w_click_soins_reg.type_gestion <> "P" then
	//			open curreg ;
	//			fetch curreg into  :v_date_paye , :v_montant_paye , :v_mode_reglement ;
	//			do while sqlca.sqlcode = 0 
	//				SetProfileString( dir_ini + inifile_echeancier, "Admini","Montant_reglement"+ string(cpt_ech)+"_soin_courant" + string(cpt_soins) , string(v_montant_paye, "0.00" )  + " " + v_symbole_euro)
	//				SetProfileString( dir_ini + inifile_echeancier, "Admini","Date_reglement"+ string(cpt_ech)+"_soin_courant" + string(cpt_soins) , string(v_date_paye) )
	//				SetProfileString( dir_ini + inifile_echeancier, "Admini","Mode_reglement"+ string(cpt_ech)+"_soin_courant" + string(cpt_soins) , v_mode_reglement )
	//				fetch curreg into  :v_date_paye , :v_montant_paye , :v_mode_reglement ;
	//			loop
	//			
	//			close curreg ;
	//
	//		
	//		end if
			
			
		end if
	next
	
	// Totaux soins
	if total_honoraires <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_honoraires" , string(total_honoraires, "0.00" ) + " " + v_symbole_euro)
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_honoraires" , "")
	end if
	if total_honoraires_pc <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_honoraires_pc" , string(total_honoraires_pc, "0.00" ) + " " + v_symbole_euro)
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_honoraires_pc" , "")
	end if
	if total_honoraires_pc + total_honoraires <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_honoraires_justif" , string(total_honoraires_pc + total_honoraires, "0.00" ) + " " + v_symbole_euro)
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_honoraires_justif" , "")
	end if

	if Total_base <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_base" , string(total_base, "0.00" )+ " " + v_symbole_euro )
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_base" , "")
	end if
	if Total_depassement <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_depassement" , string(total_depassement, "0.00" )+ " " + v_symbole_euro )
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_depassement" , "")
	end if

	// Totaux paiements
	if Total_paye <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye" , string(Total_paye, "0.00" )+ " " + v_symbole_euro )
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye" , "")
	end if
	if Total_paye_pc <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_pc" , string(Total_paye_pc, "0.00" )+ " " + v_symbole_euro )
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_pc" , "")
	end if
	if Total_paye_pc + Total_paye <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_justif" , string(Total_paye_pc + Total_paye, "0.00" )+ " " + v_symbole_euro )
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_justif" , "")
	end if
	if Total_paye_sans_virement <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_sans_virement" , string(Total_paye_sans_virement, "0.00" )+ " " + v_symbole_euro )
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_sans_virement" , "")
	end if
	if Total_paye_du_jour <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_du_jour" , string(Total_paye, "0.00" )+ " " + v_symbole_euro )
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_du_jour" , "")
	end if
	if Total_paye_du_jour_sans_virement <> 0 then
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_du_jour_sans_virement" , string(Total_paye_sans_virement, "0.00" )+ " " + v_symbole_euro )
	else
		SetProfileString( dir_ini + inifile_echeancier, "Admini","Total_paye_du_jour_sans_virement" , "")
	end if
	
	
	SetProfileString( dir_ini + inifile_echeancier, "Admini","Croix_part_obligatoire" , v_croix_part_obligatoire )
	SetProfileString( dir_ini + inifile_echeancier, "Admini","Croix_part_complementaire" , v_croix_part_complementaire )
	
	// Spécial pour la Facture France
	if type_courrier = "FF" then
		
		double v_numero_facture
		date v_date_facture
		
		v_numero_facture = numero
		
		select "date" into :v_date_facture from facture where numero = :v_numero_facture ;
		
		// Bloc facture
		SetProfileString( dir_ini + inifile_echeancier, "Facture","Numero_Facture" , string(v_numero_facture)) 
		SetProfileString( dir_ini + inifile_echeancier, "Facture","Date_Facture" , string(v_date_facture)) 
		
		// Vérification si la facture est acquittée ou pas ?
		decimal {2} v_total_paye, v_total_soins
		v_total_paye =  fxg_get_paiements_facture(v_numero_facture, today())
		
		select isnull(sum(total),0) into :v_total_soins from soins where code = :v_code_local and numero_facture =  :v_numero_facture ;
		
		if v_total_soins <= v_total_paye then
			// facture totalement payée
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Acquittement_Facture" , "FACTURE ACQUITTEE") 
		else
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Acquittement_Facture" , "") 
		end if
	
	
		// Uniquement pour la France
		if FRANCE then
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Titre_Facture" , w_facture_impression.v_titre) 
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Nom_Facture" , w_facture_impression.v_nomp ) 
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Adresse1_Facture" , w_facture_impression.v_adr1 ) 
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Adresse2_Facture" , w_facture_impression.v_adr2 ) 
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Code_postal_Facture" , w_facture_impression.v_codep ) 
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Ville_Facture" , w_facture_impression.v_ville ) 
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Pays_Facture" , w_facture_impression.v_pays ) 
			SetProfileString( dir_ini + inifile_echeancier, "Facture","Numero_Secu_Facture" , w_facture_impression.v_numero_secu ) 
		end if
	
		
	end if
	
	
	// Spécial pour le reçu
	if type_courrier = "R" then
	
			// Il a y eu passage de paramètres dans w_soins_reg_maj
			//param_win[1] = string(montant_total_soins )
			//param_win[2] = string(montant_total_reglements) 
			//param_win[3] = string(v_montant_recu) 
			//param_win[4] = libelle_du_soin
			//param_win[5] = string(montant_total_soins_hn )
			//param_win[6] = v_mode
			//param_win[7] = string(v_date)
			// param_win[8] = v_comment  commentaire du règlement
			// param_win[9] = ls_payeur payeur de règlement
			
			SetProfileString( dir_ini + inifile_echeancier, "Recu","Date_reglement" , param_win[7]  ) 
			SetProfileString( dir_ini + inifile_echeancier, "Recu","Montant_reglement" , param_win[3]  ) 
			SetProfileString( dir_ini + inifile_echeancier, "Recu","Mode_reglement" , param_win[6]  ) 
			SetProfileString( dir_ini + inifile_echeancier, "Recu","Commentaire_Reglement" , param_win[8]  ) 
			SetProfileString( dir_ini + inifile_echeancier, "Recu","Payeur_Reglement" , param_win[9]  ) 

	end if

	close(w_patience)

	m_menu.utiliser_office(type_courrier, numero)
	
else
	Messagebox("ATTENTION","Impossible de supprimer le fichier temporaire de liaison (" + dir_ini + inifile_echeancier + ").~n~nOpéarion annulée")

end if 


end subroutine

public function string getimprimspecif (double v_code_patient);
if type_menu = 'R' then
	return profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","feuilles_soins","") 
else
	//return profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","dep","") 
	string v_code_praticien
	var_code_local = v_code_patient
	select code_praticien into :v_code_praticien from patient where code = :var_code_local ;
	return get_imprimante_dep(v_code_praticien)
end if
end function

public function string change_imprimante (double v_code_patient);
// Permet de changer l'imprimante par défaut par l'imprimante spécifique désignée pour les DEP et feuillees de soins
// La fonction renvoie l'imprimante par défaut AVANT pour permettre de la remettre par défaut APRES



// on vérifie si on a activé ou pas l'imprimante
if (type_menu = 'R' and profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","feuilles_soins_active","N")  = 'O') or &
((type_menu = 'S' or type_menu = 'P')  and profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","dep_active","N")  = 'O') then

	
	//	Instance de la liste pour utiliser les fonctions ad'hoc
	uo_liste_imprimantes  imprim
	imprim = CREATE uo_liste_imprimantes  
	// pour mise à jour des valeurs
	imprim.triggerevent(constructor!)
		
	
		
	// Mémo de l'imprimante par défaut
	string v_imprim_defaut, v_imprim_specif
		
	v_imprim_defaut = imprim.getImprimanteDefaut()
	
	
	// recherche de l'imprimante spécifique pour les dep et feuilles de soins
//	if type_menu = 'R' then
//		v_imprim_specif = profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","feuilles_soins","") 
//	else
//		v_imprim_specif = profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","dep","") 
//	end if
	v_imprim_specif =  getimprimspecif(v_code_patient)
	
	imprim.setImprimanteDefaut(v_imprim_specif)
//	PrintSetPrinter ( printername )
		
	destroy imprim
end if

return v_imprim_defaut
end function

