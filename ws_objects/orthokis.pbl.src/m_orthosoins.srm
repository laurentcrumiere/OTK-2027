event clicked;


if w_click_soins_reg.impression_integre then
	// Impression intégrée 
	datawindow dw_nulle
	setnull(dw_nulle) 

	//impression_fs2014_recto (w_click_soins_reg.dw_fs2014_recto, dw_nulle)
else
	
	long lig, ligtot, ligcour
	double code_patient, cle_soin
	boolean b_ok_imprime
	
	integer i_cpt_deja_fs = 0
	ligtot = dw_click.rowcount()

	// Si pas de soins sélectionné ... on prend le soin courant
	if dw_click.find("fse = 'O'",0,ligtot) = 0 then
		dw_click.SetItem(dw_click.getrow(), "fse", "O")
	end if


	lig = dw_click.find("fse = 'O'",0,ligtot)
	if  lig > 0 then

		// Verification si même praticien pour tous les soins ....
		string v_code_praticien_soin, v_code_praticien_fs, v_code_praticien_patient
		boolean praticien_ok = true
		
		code_patient = dw_click.getitemnumber(lig,"soins_code")
		v_code_praticien_soin = dw_click.getitemString(lig,"soins_code_praticien")
		
		select code_praticien into :v_code_praticien_patient from patient where code = :code_patient ;
	
		// Praticien de la feuille de soin
		if isnull(v_code_praticien_soin) then 
			v_code_praticien_fs = v_code_praticien_patient
		else
			v_code_praticien_fs = v_code_praticien_soin
		end if
		
		for lig = 1 to ligtot
			if dw_click.getitemstring(lig,"fse") = 'O'  then
				v_code_praticien_soin = dw_click.getitemString(lig,"soins_code_praticien")
				
				// Pour détecter les soins qui on déjà été sur une FS
				if trim(string_non_nulle(dw_click.getitemString(lig,"soins_fse_edite"))) <> "" then 
					i_cpt_deja_fs = i_cpt_deja_fs + 1
				end if
				
				if isnull(v_code_praticien_soin) then
					if v_code_praticien_fs <> v_code_praticien_patient then
						praticien_ok = false
					end if
				else
					if v_code_praticien_fs <> v_code_praticien_soin then
						praticien_ok = false
					end if
				end if

			end if
		next
		
		if not praticien_ok then
			Messagebox("ATTENTION", "Les actes sélectionnés ne sont pas tous du même praticien. Vous ne pouvez pas les inclure dans la même feuille de soins.")
		else
			b_ok_imprime = true

			if i_cpt_deja_fs > 0 then 
				if messagebox("ATTENTION", "Au moins un soin ("+string(i_cpt_deja_fs)+") a déjà fait l'objet d'une feuille de soins !~n~nConfirmez-vous l'impression ?", Question!, YesNo!, 2) = 2 then 
					b_ok_imprime = false
				end if
			end if

			
			if b_ok_imprime then 
				// impression avec un document Word
				utiliser_courrier_word("F", 0)
			
				for lig = 1 to ligtot
					if dw_click.getitemstring(lig,"fse") = 'O'  then
						// Mise à jour des lignes comme quoi FS editée
						cle_soin 		 = dw_click.getitemnumber(lig,"cle")
						UPDATE "soins" SET "soins"."fse_edite" = 'M'  ,  "soins"."date_fs" = cast(getdate() as date)  
						WHERE code = :code_patient and cle = :cle_soin ;
					end if
				next
				commit ;
				
				ajout_histo_actions(var_code_local,"AJOFS", today(), 'Feuille manuelle' )

			end if
			
			dw_click.retrieve(code_patient)	
		end if
	else
		MessageBox("ATTENTION","Vous devez sélectionner (au moins) un soin avant de réaliser une Feuille de Soin.")
	end if

end if


end event

