event clicked;date date_soin

If dw_click.rowCount() > 0 Then
	
	date_soin = dw_click.GetItemDate(dw_click.GetRow(),"date_demande")

	choose case w_click_soins_reg.type_gestion
		case 'P'
			w_click_soins_reg.imprimer_soins (date_soin,monnaie_base,w_click_soins_reg.dw_edition_soins_prevus, "I")
		case 'S'
			w_click_soins_reg.imprimer_soins (date_soin,monnaie_base,w_click_soins_reg.dw_edition, "I")
		case 'R'
			w_click_soins_reg.imprimer_soins (date_soin,monnaie_base,w_click_soins_reg.dw_edition_reglements, "I")
		end choose
end if
end event

