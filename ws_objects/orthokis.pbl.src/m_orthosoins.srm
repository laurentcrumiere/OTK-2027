event clicked;

//cpaye >= cdoit

date date_soin
long cpt, tot

tot = dw_click.rowCount()

for cpt = 1 to tot
	dw_click.SetItem(cpt,"fse", "N")
Next

for cpt = 1 to tot
	if dw_click.GetItemNumber(cpt,"cpaye") < dw_click.GetItemNumber(cpt,"cdoit") then
