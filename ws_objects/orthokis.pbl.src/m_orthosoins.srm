event clicked;date date_soin
long cpt, tot


If dw_click.rowCount() > 0 Then
	
	date_soin = dw_click.GetItemDate(dw_click.GetRow(),"date_demande")

	tot = dw_click.rowCount()
	
	for cpt = 1 to tot
		dw_click.SetItem(cpt,"fse", "N")
	Next
	
	for cpt = 1 to tot
		if date_soin = dw_click.GetItemDate(cpt,"date_demande")  then
			dw_click.SetItem(cpt,"fse", "O")
		end if
	next
end if
end event

