event clicked;if type_menu = 'R' then
	// Appel depuis les reglements
	
	// ANCIENNES FEUILLES DE SOINS ... PLUS UTILISE !!!!!!!!!!!!!!!!!!!!!!!!!

//	if prepa_recto_feuille_soin(w_click_soins_reg.dw_soins) then
//		// La dw_impression n'est pas utilisée lors de l'impression de ce recto
//		// On la meme DW 2eme paramètre : ne sera pas utilisée par la fonction mais sert à détecter si impression UNITAIRE
//		// ou dans le cadre de la fonction d'impression groupée
//		impression_recto (w_click_soins_reg.dw_recto,w_click_soins_reg.dw_recto)
//	end if

	if Belgique then
		w_click_soins_reg.tab_1.tabpage_reglements.cb_facture.triggerevent(clicked!)
	end if


else
	
	if type_menu = "S" then
		// Appeler depuis les soins
		impression_recto (w_click_soins_reg.dw_recto,w_click_soins_reg.tab_1.tabpage_soins.dw_impression)
	else
		if type_menu = "P" then
			// Appeler depuis les soins prévus
			impression_recto (w_click_soins_reg.dw_recto,w_click_soins_reg.dw_soins_prevus)
		end if
	end if
end if

end event

on m_imprimerrecto.destroy
call super::destroy
end on

type m_ouvrirleattest from menu within m_soins
end type

event clicked;

// Ouvre le fichier PDF contenant l'e-Attest
string chemin_complet_courrier, v_eattest
double v_cle_soin, v_code_local

v_cle_soin = dw_click.GetItemNumber(dw_click.GetRow(),"cle")
v_code_local = dw_click.GetItemNumber(dw_click.GetRow(),"soins_code")

select trim(ar_eattest) into :v_eattest from soins 
where code = :v_code_local and cle = :v_cle_soin ;

chemin_complet_courrier = dir_photos + string(v_code_local) + win_delimiter + v_eattest + ".pdf"

if not fileExists(chemin_complet_courrier) then
	Messagebox("ATTENTION", "Impossible de localiser le fichier : " + chemin_complet_courrier)
else
	fxg_ouvrir_fichier_shell(chemin_complet_courrier)
end if
end event

