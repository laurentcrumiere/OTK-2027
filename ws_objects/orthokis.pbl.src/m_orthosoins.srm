event clicked;
string chaine_nulle 
date date_nulle , nouvelle_date, v_date_fse
long row 
string v_fse_edite
boolean v_suite = true
boolean b_suppression_fse  = false
string s_numero_fse
double db_numero_fse
string v_version_ccvitale, ls_numero_fse

string s_code_praticien_fse
ls_numero_fse = ''

If dw_click.rowCount() > 0 Then
	
	row = dw_click.GetRow()
	var_code_local = w_click_soins_reg.var_code_local
	
	v_fse_edite = dw_click.getItemString(row,"soins_fse_edite")
	
	
	if belgique then
		if v_fse_edite = "J" then 
			if messagebox("ATTENTION !","Vous allez annuler l'information de réalisation d'un Justificatif.~n~nCeci ne supprimera pas le Justificatif.~n~nConfirmez-vous ?"	,Question!,Yesno!,2) = 1 then
			
				setnull(chaine_nulle)
				setnull(date_nulle)
				dw_click.setItem(row,"soins_fse_edite",chaine_nulle)
				dw_click.setItem(row,"soins_date_fs",date_nulle)
				
	
				if dw_click.update() = 1 then
					commit ;
				else
					rollback ;
				end if
			end if
		else
			Messagebox("ATTENTION","Ce soin n'a pas fait l'objet d'un justificatif !")
		end if
		
	else
	
		// On est en France
		s_numero_fse = dw_click.getItemString(row,"soins_numero_fse")
		v_date_fse	= dw_click.getItemDate(row,"soins_date_fs")
	
		if not isnull(v_fse_edite) then
			if messagebox("ATTENTION !","Vous allez annuler l'information de réalisation d'une Feuille de Soins.~n~nConfirmez-vous ?"	,Question!,Yesno!,2) = 1 then
				
				if v_fse_edite = "V" and CCVITALE then
					if messagebox("ATTENTION !","Souhaitez-vous également supprimer la FSE N°"+ s_numero_fse +" dans CC-Vitale ?~n~nConfirmez-vous ?"	,Question!,Yesno!,2) = 1 then
						b_suppression_fse = true
					end if
				end if
				setnull(nouvelle_date)
				setnull(v_fse_edite)
				v_suite = true
			end if
		else
			
			v_suite = true
		
			string code_soin_fact, fs_necessaire
			code_soin_fact = dw_click.getitemstring(row,"code_soins_code")
			
			// Recherche des caractéristiques du soin
			SELECT isnull("fs", 'O') INTO :fs_necessaire 	FROM "code_soins" WHERE code = :code_soin_fact ;

			// On verifie si feuille de soin nécessaire
			if fs_necessaire = "N" then
				MessageBox("ATTENTION !","Le type de soin " + dw_click.getitemstring(row,"code_soins_nom") + " ne nécessite pas de Feuille de soins !~n~nAction impossible !")
				v_suite = false
			end if
			
				
			if v_suite then
				if messagebox("ATTENTION !","Vous allez inscrire l'information de réalisation d'une Feuille de Soins.~n~nConfirmez-vous ?"	,Question!,Yesno!,2) = 1 then
					nouvelle_date = today()
					v_fse_edite = "V"
					v_suite = true
				end if
			end if
		end if
			
		if v_suite then
			setnull(chaine_nulle)
			dw_click.setItem(row,"soins_fse_edite",v_fse_edite)
			dw_click.setItem(row,"soins_date_fs",nouvelle_date)
			
			if isnull(v_fse_edite) then
				// mémorisation pour mise en histo
				ls_numero_fse = string_non_nulle(trim(dw_click.GetItemString(row,"soins_numero_fse")))
				dw_click.setItem(row,"soins_numero_fse",chaine_nulle)
			end if
	
	
			if dw_click.update() = 1 then
				commit ;
				
				if isnull(v_fse_edite) then
					// on vient d'annuler la feuille de soins => mémo de l'action en historique
					string s_libelle
					s_libelle = dw_click.GetItemString(row,"code_soins_nom") 
					if dw_click.GetItemNumber(row,"numero") > 0 then
						s_libelle = s_libelle + " N°" + string( dw_click.GetItemNumber(row,"numero") )
					else
						s_libelle = s_libelle + " du " + string( dw_click.GetItemDate(row,"date_demande") )
					end if

						
					if ls_numero_fse <> "" then
						s_libelle = "FSE N°" + ls_numero_fse + " - Soin : " + s_libelle
					else
						s_libelle = "FS " + " - Soin : " + s_libelle
					end if
					ajout_histo_actions(var_code_local,"SUPFS", today(), s_libelle )
	
				end if
				
				if b_suppression_fse and CCVITALE then
					// Il faut aussi supprimer la FSE dans CC Vitale ... et annuler les "V" des autres lignes de soins ... 
					
					// Praticien ?
					s_code_praticien_fse  = dw_click.GetItemString(row ,"soins_code_praticien") 
					s_code_praticien_fse = string_non_nulle(s_code_praticien_fse)
					if s_code_praticien_fse = "" then
						select code_praticien into :s_code_praticien_fse from patient where code = :var_code_local ;
					end if
				
					// Nouveau mécanisme de communication => version CC Obligatoire
					v_version_ccvitale = fxg_get_version_ccvitale() 
					if v_version_ccvitale >= "4.10" then
						// Suppression effective de la facture
						
						param_win[1] = '10'
						param_win[2] = s_code_praticien_fse
						param_win[3] = string(var_code_local)
						param_win[4] = s_numero_fse
						Trace("ouverture de w_cc_vitale")
						Open (w_cc_vitale)
						
	
						// la fenetre renvoie 1 si Ok ou 0 sinon
						if message.doubleparm = 1 then
							// La facture a été supprimée
							// Faut effacer éventellement les infos des autres soins de la facture
							
							db_numero_fse = double (s_numero_fse)
							
							update soins set numero_fse = null, fse_edite = null, date_fs = null 
							where code = :var_code_local and numero_fse = :db_numero_fse ;
							
							if sqlca.sqlcode = 0 then
								
								if sqlca.sqlnrows > 0 then
									if sqlca.sqlnrows = 1 then
										Messagebox("INFORMATION !", string(sqlca.sqlnrows) + " autre soin figure dans la facture.~nSes informations de FSE ont été supprimées !")
									else
										Messagebox("INFORMATION !", string(sqlca.sqlnrows) + " autres soins figurent dans la facture.~nLeurs informations de FSE ont été supprimées !")
									end if
									
								end if
								commit ;
								
								// Retrieve pour actuliser les infos ...
								dw_click.retrieve(var_code_local)
								dw_click.scrollToRow(row)
								
							else
								Messagebox("ATTENTION !","Erreur dans la mise à jour des informations de suppression de FSE !~n~n" + sqlca.sqlerrtext)
								rollback ;
							end if
						else
							
							// La suppression dans CC Vitale c'est mal passée 
							
							
							// On remet les informations dans le soin
							dw_click.SetItem(row,"soins_fse_edite", "V")
							dw_click.SetItem(row,"soins_numero_fse", s_numero_fse)
							dw_click.SetItem(row,"soins_date_fs", v_date_fse)
							
							if dw_click.update() = 1 then
								commit ;
								Messagebox("ATTENTION !", "Les informations de la FSE dans Orthokis n'ont pas été mises à jour !")
							else
								rollback ;
								Messagebox("ATTENTION !", "Erreur dans la remise en place des informations de la FSE dans Orthokis.~n~nVous devez les réinscrire.~n~nErreur : " + sqlca.sqlerrtext)
							end if
							
							// Retrieve pour actuliser les infos ...
							dw_click.retrieve(var_code_local)
							dw_click.scrollToRow(row)
	
	
							
						end if
	
					else
						if v_version_ccvitale = '' then 
							MessageBox("ATTENTION", "CC-Vitale n'est pas installé sur ce poste !~n~nIl est donc impossible de supprimer la FSE. Vous devez le faire depuis CC-Vitale, sur un poste équipé de ce logiciel !")
						else
							Messagebox("ATTENTION","Cette version d'Orthokis fonctionne avec CC-Vitale version 4.10 ou supérieure or vous êtes actuellement en " + v_version_ccvitale + ".~n~nVeuillez faire la mise à jour de CC-Vitale !")
						end if
					end if
	
				end if
				
				
			else
				Messagebox("ERREUR","Problème dans la mise à jour de la base de données !~n~nVeuillez fermer le dossier et renouveler l'opération.")
				rollback ;
			end if
			
			dw_click.retrieve(var_code_local)
			dw_click.scrolltorow(row)
	
			
		end if
	end if

end if




end event

