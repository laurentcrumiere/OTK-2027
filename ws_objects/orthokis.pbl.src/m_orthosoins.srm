on m_annulerleattest.destroy
call super::destroy
end on

event clicked;
// Fonction rendue invisble dans Orthokis ... 

// Effacement des informations dans le soin et du fichier PDF
long row
double v_code_local, v_cle_soin 

string chemin_complet_courrier, v_eattest

row = dw_click.GetRow()
v_code_local = dw_click.GetItemNumber(dw_click.GetRow(),"soins_code")
v_cle_soin = dw_click.GetItemNumber(dw_click.GetRow(),"cle")

select trim(ar_eattest) into :v_eattest from soins 
where code = :v_code_local and cle = :v_cle_soin ;

if Messagebox("ATTENTION", "Vous allez annuler la mémorisation de l'e-Attest " + v_eattest + " dans Orthokis.~n~nCela n'entrainera cependant pas sa suppression dans le système eHealth national.~n~nConfirmez-vous cette suppression ?", Question!, YesNo!, 2) = 1 then
	
	update soins set ar_eattest = null , fse_edite = null, date_fs = null
	where code = :v_code_local and ar_eattest = :v_eattest ;
	
	if sqlca.sqlcode = 0 then 
	
		commit ;

		// Suppression du fichier PDF physique 
		chemin_complet_courrier = dir_photos + string(v_code_local) + win_delimiter + v_eattest + ".pdf"
	
		if not fileExists(chemin_complet_courrier) then
			Messagebox("ATTENTION", "Impossible de localiser le fichier : " + chemin_complet_courrier)
		else
			if FileDelete(chemin_complet_courrier) then
				Messagebox("INFORMATION", "L'e-Attest a été annulée avec succès !")
				
				// On actualise l'affichage
				dw_click.retrieve(v_code_local)
				dw_click.scrolltorow(row)


			else
				Messagebox("ATTENTION", "Impossible de supprimer le fichier : " + chemin_complet_courrier)
			end if
		end if
	else
		Messagebox("ATTENTION","Erreur N°1 dans l'annulation de l'e-Attest.~n~n" + sqlca.sqlerrtext)
		rollback ;
	end if
end if

end event

