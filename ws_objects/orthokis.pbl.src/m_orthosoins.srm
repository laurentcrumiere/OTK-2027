event clicked;if w_click_soins_reg.impression_integre then
	if prepa_recto_feuille_soin(w_click_soins_reg.dw_soins) then
	
			//impression_fs2014_recto (w_click_soins_reg.dw_fs2014_recto,w_click_soins_reg.dw_fs2014_verso)
	
	end if
else
	
	// recopie du document Word 
	If Messagebox("ATTENTION","Vous allez reinitialiser le document d'impression de la Feuille de Soins.~nVous serez peut-être amené à le recadrer ensuite.~n~nConfirmez-vous ?", Question!, Yesno!, 2) = 1 then
		string doc_temp, doc_doc
		
		doc_doc =  dir_ini + fxg_nom_fichier_fs2014_doc_ou_docx()
		doc_temp = doc_doc + ".origine"
		
		if FileCopy(doc_temp, doc_doc, true) = 1 then 
			MessageBox("INFORMATION","La réinitilisation a été réalisée avec succès.")
		else
			MessageBox("ATTENTION","Une erreur s'est produite durant la réinitilisation . Elle n'a pas été réalisée.")
		end if
		
	end if
	
end if
end event

