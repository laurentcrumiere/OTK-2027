			w_click_soins_reg.imprimer_soins (date_soin,monnaie_base,w_click_soins_reg.dw_edition_soins_prevus, "E")
		case 'S'
			w_click_soins_reg.imprimer_soins (date_soin,monnaie_base,w_click_soins_reg.dw_edition, "E")
		case 'R'
			w_click_soins_reg.imprimer_soins (date_soin,monnaie_base,w_click_soins_reg.dw_edition_reglements, "E")
		end choose
end if
end event

