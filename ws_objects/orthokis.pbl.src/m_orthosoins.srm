date v_date_demande

If dw_click.rowCount() > 0 and not VISIODENT_LIMITE Then
	
	v_clef = dw_click.GetItemNumber(dw_click.GetRow(),"cle")
	v_code_patient = dw_click.GetItemNumber(dw_click.GetRow(),"soins_code")
	v_nom_soins = dw_click.GetItemString(dw_click.GetRow(),"code_soins_nom")
	v_date_demande = dw_click.GetItemDate(dw_click.GetRow(),"date_demande")
	
	// On ne doit pas envoyer les soins FDO 
	if upper(trim(dw_click.GetItemString(dw_click.GetRow(),"code_soins_lettre"))) = "FDO" then
			MessageBox("ATTENTION","Les soins FDO n'ont pas besoin d'être envoyés à Veasy. Ils sont automatiquement intégrés lors de l'envoi du Semestre.") 
	else			
		if true then
//		if not fxg_ods_envoi_soin(v_code_patient, v_clef, true) then
			MessageBox("ERREUR","Le soin " + v_nom_soins + " du " + string(v_date_demande) + " n'a pas été correctement mis à jour dans Visiodent !") 
		end if
	end if

end if
