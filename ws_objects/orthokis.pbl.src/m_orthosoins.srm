public subroutine decalage_total (character mode);// Décalage total par rapport à la date de début de traitement

// L'argument mode sert à savoir ce qu'on décale :
//    Mode = 'E' : on ne décale que les échéances
//    Mode = 'D' : on ne décale que les dates de soins (demande)
//    Mode = 'T' :  on décale toutes les dates


If dw_click.rowCount() > 0 Then


	var_code_local = dw_click.getitemnumber(dw_click.GetRow(),"soins_code")
	
	date dt,dd
	string cde
	integer ecart
	string libelle_decalage, v_id_tea
	double v_cle
	decimal{2} v_total
	
	select debut_traitement INTO :dt FROM "patient"  WHERE code = :var_code_local ;
	
	if isnull(dt) then
		Messagebox("ATTENTION","La date de début de traitement n'est pas renseignée !")
	else
//		select min(date_demande) INTO :dd FROM soins  
//		WHERE code = :var_code and type = 'S' and numero = 1 ;
		
		// On recherche la première date de demande dans les soins
		Select min(date_demande) INTO :dd  
		FROM "soins","code_soins"
		WHERE soins.code = :var_code_local and soins."type" = code_soins.code 
		and "code_soins"."duree" > 0 ;
		
		
		if isnull(dd) then
			Messagebox("ATTENTION","Il n'y a pas de date de première demande !")
		else
			ecart = daysafter(dd,dt)

			
			libelle_decalage = ''
			// Libellé en fonction du mode de décalage
			CHOOSE CASE mode
			CASE 'E'
				libelle_decalage ='(Décalage des Echéances)'
			CASE 'D'
				libelle_decalage ='(Décalage des Dates de Demandes)'
			CASE 'T'
				libelle_decalage ='(Décalage des Echéances et des Dates de Demandes)'
			END CHOOSE

			
			
			If MessageBox("Actualisation totale de dates","La 1ère demande a été effectuée le "+string(dd)+"~nLe début de traitement est le "+string(dt)+"~n~nSoit un écart de "+string(ecart)+" jour(s)~n~nVoulez-vous décaler d'autant les semestres et contention suivants " + libelle_decalage+" ?~n~n(Attention, cette actualisation est irréversible !)",Question!,YesNo!,2) = 1 then
				
				open(w_patience)
				
				
				if mode = 'E' or mode = 'T' then
					// On actualise les Echeances !!
//					cde = 'UPDATE ligne_soins,soins,code_soins SET "date" = days("date",'+string(ecart)+') WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins"."code" = "ligne_soins"."code" 	and "soins"."cle" = "ligne_soins"."cle" and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(dd,'yyyy-mm-dd') +"'"
					cde = 'UPDATE ligne_soins,soins,code_soins SET "date" = dateadd(day,'+string(ecart)+', "date") WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins"."code" = "ligne_soins"."code" 	and "soins"."cle" = "ligne_soins"."cle" and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(dd,'yyyy-mm-dd') +"'"
					EXECUTE IMMEDIATE :cde ;
					if sqlca.sqlcode <> 0 then
						messagebox("Problème dans l'actualisation 1",sqlca.sqlerrtext)
					end if
					w_patience.Wf_SetValue(50)
				end if
				
				if mode = 'D' or mode = 'T' then
					// On actualise les Dates de demandes  !!
//					cde = 'UPDATE soins,code_soins SET "date_demande" = days("date_demande",'+string(ecart)+') WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = '+string(var_code_local) + ' and "date_demande" > '+"'"+string(dd,'yyyy-mm-dd') +"'"
					cde = 'UPDATE soins,code_soins SET "date_demande" = dateadd(day,'+string(ecart)+', "date_demande") WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = '+string(var_code_local) + ' and "date_demande" > '+"'"+string(dd,'yyyy-mm-dd') +"'"
					EXECUTE IMMEDIATE :cde ;
					if sqlca.sqlcode <> 0 then
						messagebox("Problème dans l'actualisation 2",sqlca.sqlerrtext)
					end if
					// On actualise les Dates d'execution depuis la V10
//					cde = 'UPDATE soins,code_soins SET "date_exe" = days("date_exe",'+string(ecart)+') WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = '+string(var_code_local) + " and date_exe is not null "
					cde = 'UPDATE soins,code_soins SET "date_exe" = dateadd(day,'+string(ecart)+', "date_exe")  WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = '+string(var_code_local) + " and date_exe is not null "
					EXECUTE IMMEDIATE :cde ;
					if sqlca.sqlcode <> 0 then
						messagebox("Problème dans l'actualisation 3",sqlca.sqlerrtext)
					end if
				end if
				
				Commit ;
				
				if APPEL_VISIODENT and NOT VISIODENT_LIMITE then
					// Il y a eu actualisation, on renvoie tous les soins
					fxg_ods_envoi_soins_date(var_code_local, date('1900-01-01'))
				end if
				
				IF TEA then
					// On parcours les soins modifiés pour actualiser Téa
					declare cur_soins cursor for select soins.cle, soins.total from soins  ,code_soins WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0 and "soins"."code" = :var_code_local ;
					open cur_soins ;
					fetch cur_soins into :v_cle, :v_total ;
					do while sqlca.sqlcode = 0  
						if v_total > 0 then
							v_id_tea = string(var_code_local) + "-" + string(v_cle)
							//fxg_lancer_commande_dsapi("payment/update/" + v_id_tea, "",  "S", "G", var_code_local )
							fxg_maj_soins_tea(var_code_local, v_cle, "U")
						end if
						fetch cur_soins into :v_cle, :v_total ;
					loop
					close cur_soins ;
				end if
				
				close(w_patience)
				dw_click.retrieve(var_code_local)
				dw_click.scrolltorow(99999)

			end if
		end if
	end if
End If

end subroutine

protected subroutine ajustement_verso (ref datawindow dw_verso);//fx protected qui fait les ajustement pour les imprimantes avant impression DEP
//renvoie rien


double dx,dy

if type_menu = 'R' then
	// remboursement
	
	
	// N° Sécu et date de naissance de l'assuré
	SELECT remb_secu_verso_x,remb_secu_verso_y INTO :dx,:dy FROM param_secu ;
	chg_coord(dw_verso,"secu",dx,dy)
	chg_coord(dw_verso,"naissance_assure",dx,dy)
	
	// Nom
	SELECT remb_nom_verso_x,remb_nom_verso_y INTO :dx,:dy FROM param_secu ;
	chg_coord(dw_verso,"nom",dx,dy)
	// Adresse Zone N°1
	SELECT remb_adr1_verso_x,remb_adr1_verso_y INTO :dx,:dy FROM param_secu ;
	chg_coord(dw_verso,"adr1",dx,dy)
	// Adresse Zone N°2
	SELECT remb_adr2_verso_x,remb_adr2_verso_y INTO :dx,:dy FROM param_secu ;
	chg_coord(dw_verso,"adr2",dx,dy)
	// Code Postal
	SELECT remb_codep_verso_x,remb_codep_verso_y INTO :dx,:dy FROM param_secu ;
	chg_coord(dw_verso,"codep",dx,dy)
	// Ville
	SELECT remb_ville_verso_x,remb_ville_verso_y INTO :dx,:dy FROM param_secu ;
	chg_coord(dw_verso,"ville",dx,dy)
	// Nom du patient
	SELECT remb_nom2_verso_x,remb_nom2_verso_y INTO :dx,:dy FROM param_secu ;
	chg_coord(dw_verso,"nom2",dx,dy)
	chg_coord(dw_verso,"prenom2",dx,dy)
	// Date de naissance
	SELECT remb_dtenais2_verso_x,remb_dtenais2_verso_y INTO :dx,:dy FROM param_secu ;
	chg_coord(dw_verso,"naissance",dx,dy)
	
else
	
	// Demande d'entente 
	//------------------------------

	boolean v_dep_utiliser_cadagre_local
	
	if profilestring(dir_ini+inifile_orthokis,"DEP-FSE","dep_utiliser_cadagre_local", "N") = "O" then
		v_dep_utiliser_cadagre_local = true
	else
		v_dep_utiliser_cadagre_local = false
	end if
	
	
	// N° Sécu et date de naissance de l'assuré
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_secu_ital_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_secu_ital_y", "0"))
	else
		SELECT renouv_secu_ital_x,renouv_secu_ital_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_verso,"secu",dx,dy)
	chg_coord(dw_verso,"naissance_assure",dx,dy)
	
	// Nom
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_nom_ital_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_nom_ital_y", "0"))
	else
		SELECT renouv_nom_ital_x,renouv_nom_ital_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_verso,"nom",dx,dy)
	
	// Adresse Zone N°1
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_adr1_ital_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_adr1_ital_y", "0"))
	else
		SELECT renouv_adr1_ital_x,renouv_adr1_ital_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_verso,"adr1",dx,dy)

	// Adresse Zone N°2
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_adr2_ital_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_adr2_ital_y", "0"))
	else
		SELECT renouv_adr2_ital_x,renouv_adr2_ital_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_verso,"adr2",dx,dy)

	// Code Postal
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_codep_ital_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_codep_ital_y", "0"))
	else
		SELECT renouv_codep_ital_x,renouv_codep_ital_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_verso,"codep",dx,dy)
	
	// Ville
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_ville_ital_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_ville_ital_y", "0"))
	else
		SELECT renouv_ville_ital_x,renouv_ville_ital_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_verso,"ville",dx,dy)
	
	// Nom du patient
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_nom2_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_nom2_y", "0"))
	else
		SELECT renouv_nom2_x,renouv_nom2_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_verso,"nom2",dx,dy)
	chg_coord(dw_verso,"prenom2",dx,dy)
	
	// Date de naissance
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_dtenais2_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_dtenais2_y", "0"))
	else
		SELECT renouv_dtenais2_x,renouv_dtenais2_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_verso,"naissance",dx,dy)
end if
end subroutine

public subroutine mise_jour_total_date (datawindow dw_recto);	
	// Mise à jour des éléments non mis dans la table ....
	
	integer cpt,tot
	decimal {2} nb_lettre
	string lettre_prec, lettre_cour, libelle
	decimal {2} total_euros
	
	// Total par lette 
	
	// CADRE 1
	//----------------

	// Pour obtenir le nombre le ligne dans la Dw Cadre1
	SELECT count(*) into :tot FROM feuille_soins WHERE ep= 'N' ;
	lettre_prec = '-*/-'
	libelle = ""
	nb_lettre = 0
	
	// Les lignes de la DW sont classées par lettre
	for cpt = 1 to tot 
		//if lettre_prec <> dw_recto.object.cadre1.object.lettre[cpt]  then
		lettre_cour = dw_recto.describe("tab1_lig"+string(cpt)+"_lettre.text") 
		if lettre_prec <> lettre_cour  then
			// C'est un nouvelle lettre
			if nb_lettre > 0 then
				// y avait une lettre avant !!
				if libelle <> "" then
					libelle = libelle + " + " 
				end if
				libelle = libelle + lettre_prec + " " + string(nb_lettre)
				// remise à jour pour le soin suivant
				nb_lettre = 0
			end if
			lettre_prec = lettre_cour
		end if
		nb_lettre = nb_lettre + double (dw_recto.describe("tab1_lig"+string(cpt)+"_nb_lettre.text"))
	next
	
	if libelle <> "" then
		libelle = libelle + " + " 
	end if
	// Libelle ne contient pas les éléments de la dernière lettre
	if tot > 0 then
		dw_recto.Modify("tab1_total_lettres.text = '"+ libelle + lettre_prec + " " + string(nb_lettre)+"'")
	end if
	
	select sum (montant) into :total_euros from feuille_soins where ep = 'N' ;
	if total_euros > 0 then
		dw_recto.Modify("tab1_total_euros.text = '"+ string(total_euros,"0.00")+" €'")
		dw_recto.Modify("tab1_nombre_en_lettres.text = '"+nombre_en_lettres( total_euros , 'euros' )+"'")
	end if
	

	// CADRE 2
	//----------------

	// Pour obtenir le nombre le ligne dans la Dw Cadre1
	SELECT count(*) into :tot FROM feuille_soins WHERE ep= 'O' ;
	lettre_prec = '-*/-'
	libelle = ""
	nb_lettre = 0
	

	// Les lignes de la DW sont classées par lettre
	for cpt = 1 to tot 
		//if lettre_prec <> dw_recto.object.cadre2.object.lettre[cpt]  then
		lettre_cour = dw_recto.describe("tab2_lig"+string(cpt)+"_lettre.text") 
		if lettre_prec <> lettre_cour  then
			// C'est un nouvelle lettre
			if nb_lettre > 0 then
				// y avait une lettre avant !!
				if libelle <> "" then
					libelle = libelle + " + " 
				end if
				libelle = libelle + lettre_prec + " " + string(nb_lettre)
				// remise à jour pour le soin suivant
				nb_lettre = 0
			end if
			lettre_prec = lettre_cour
		end if
		nb_lettre = nb_lettre + double (dw_recto.describe("tab2_lig"+string(cpt)+"_nb_lettre.text"))
	next
	
	if libelle <> "" then
		libelle = libelle + " + " 
	end if
	 
	// Libelle ne contient pas les éléments de la dernière lettre
	if tot > 0 then
		dw_recto.Modify("tab2_total_lettres.text = '"+ libelle + lettre_prec + " " + string(nb_lettre)+"'")
	end if
	
	select sum (montant) into :total_euros from feuille_soins where ep = 'O' ;
	if total_euros > 0 then
		dw_recto.Modify("tab2_total_euros.text = '"+ string(total_euros,"0.00")+" €'")
		dw_recto.Modify("tab2_nombre_en_lettres.text = '"+nombre_en_lettres( total_euros , 'euros' )+"'")
	end if 

	
	//------------------------------------------------------------------------------------------------------------------------------

	
	// Mise à jour de la date de la feuille
	
	if isnull(date_paiement_honoraires) or date_paiement_honoraires = date('1900-1-1') then
		date date_max
		select max("date") into :date_max from "feuille_soins" ;
		dw_recto.modify("date.text='"+string(date_max,"dd/mm/yyyy")+"'")
	else
		dw_recto.modify("date.text='"+string(date_paiement_honoraires,"dd/mm/yyyy")+"'")
	end if
	
	

end subroutine

public subroutine impression_verso (datawindow dw_verso, datawindow dw_impression);double cle,code
boolean ok_suite


if BELGIQUE then
		
		// Impression de la demane d'intervention : c'est un docu Word nommé "Annexe 60.doc"
		// On passe par une prévisualisation impression
		
		
		uo_lien_word		wrd
		string				propoNom

		// on instancie wrd
		wrd = create uo_lien_word
		
		// on a bien récup l'élément
		propoNom = "Annexe 61.doc"
		if wrd.traiter_avec_word(Service_MajEtVisualise, fxg_get_rep_courriers(),  propoNom, false) <> 1 then
		// si pb sur le job WORD : msg d'erreur
			messagebox("ERREUR","Un problème est survenu durant l'exécution, ~nImpossible de poursuivre !",StopSign!)
		end if
		
		// on libère la mémoire
		destroy wrd
		
	
else
	// FRANCE

		ok_suite = true
		
		// 1ère verif pour ceux qui n'ont pas le droit de refaire des FS
		if not w_click_soins_reg.multi_fs_autorise and  type_menu = 'R' then 
			if w_click_soins_reg.verif_si_deja_fs(dw_click) then
					ok_suite = false
			end if
		end  if
	
		if not ok_suite then
			Messagebox("ATTENTION","Au moins un des soins sélectionnés a déjà fait l'objet d'une Feuille de Soin. Vous devez le désélectionner pour poursuivre.")
		else



			// pas de cadrage si impression intégrée 
			if not w_click_soins_reg.impression_integre then
				//réalise les ajustement suivant les valeurs de décalage entrées ds param généraux
				if not ajustement_verso_effectue then
					ajustement_verso(dw_verso)
					ajustement_verso_effectue = true
				end if
			end if
			
			//trouve le code et la cle du soins en question
			code = dw_click.getitemnumber(dw_click.GetRow(),"soins_code")
			cle = dw_click.getitemnumber(dw_click.GetRow(),"cle")
			
			//rerieve les données de la datawindow
			dw_verso.retrieve(code,cle)
			
			//si qqch ds datawin verso alors on continue .... :-)
			if dw_verso.rowcount() > 0 then
				//impression verso DEP
				string v_imprim_defaut
				
					// si impression intégrée gestion de l'image de fond ODF ou MEDECIN
					if w_click_soins_reg.impression_integre then
						if (type_menu = 'S' or type_menu = 'P' ) then
							if dw_verso.getitemstring( 1, "prati_typort") = "TO" then
								dw_verso.Object.p_fond.Filename = "cerfa_10518_verso.jpg"
							else
								dw_verso.Object.p_fond.Filename = "cerfa_10522_verso.jpg"
							end if
						else
							// Pour les règlements ... RAS
							
						end if
					end if
		
				// recherche de l'imprimante spécifique pour les dep et feuilles de soins
				if (  (type_menu = 'S' or type_menu = 'P' ) and profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","dep_active","N") = "O") or & 
					(type_menu = 'R' and profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","feuilles_soins_active","N") = "O") then 
					dw_verso.Modify ('DataWindow.Printer="'+getimprimspecif(code)+'" ')
				end if
		
				dw_verso.print()
				
				// Si la date d'impression est vide, on la met à jour
				if type_menu = 'P' then
					UPDATE "soins_prevus"  SET "date_impr" = cast(getdate() as date)  
					WHERE ( "soins"."cle" = :cle ) AND  ( "soins"."code" = :code )  AND ( "soins_prevus"."date_impr" is null ) ;
					COMMIT ;
				else
					UPDATE "soins"  SET "date_impr" = cast(getdate() as date)  
					WHERE ( "soins"."cle" = :cle ) AND  ( "soins"."code" = :code ) AND ( "soins"."date_impr" is null ) ;
					COMMIT ;
				end if

				// Actualisation
				dw_impression.retrieve(cle,code,'F')

				// véritable datawindow des soins ... pas de retrieve sur la cle
				// depuis 21.00g on ne retrive plus .. quel intérêt pour le version ... rien n'est mis à jour dans la dw ?
				//dw_click.retrieve(code)

				//remet_imprimante_defaut(v_imprim_defaut)
			end if // ok_suite
			
	end if
end if
end subroutine

public subroutine impression_recto_verso (datawindow dw_recto, datawindow dw_verso, datawindow dw_impression);string	rc
double	cle, code
long		num_job
boolean ok_suite
string v_fichier_destination_complet, lib_histo, v_dir_patient

ok_suite = false

if not w_click_soins_reg.impression_integre then
	// Ajustement des coordonnées pour le recto !
	if not ajustement_recto_effectue then
		ajustement_recto(dw_recto)
		//maj du boolean
		ajustement_recto_effectue = true
	end if

	// Ajustement des coordonnées pour verso !
	if not ajustement_verso_effectue then
		ajustement_verso(dw_verso)
		//maj du boolean
		ajustement_verso_effectue = true
	end if
end if


var_suite = true

if type_menu = 'R' then	

	var_suite = true
	
	// 1ère verif pour ceux qui n'ont pas le droit de refaire des FS
	if not w_click_soins_reg.multi_fs_autorise then 
		if w_click_soins_reg.verif_si_deja_fs(dw_click) then
				var_suite = false
		end if
	end  if

	if not var_suite then
		Messagebox("ATTENTION","Au moins un des soins sélectionnés a déjà fait l'objet d'une Feuille de Soin. Vous devez le désélectionner pour poursuivre.")
	else
		
		// Saisie / modification des totaux !!
		// si dw_impression
		
		if dw_recto = dw_impression then
			open(w_feuille_soins_saisie_actes)
			if Message.DoubleParm = 1 then
				ok_suite = true
			end if
		else
			ok_suite = true
		end if
	
		if ok_suite then
			var_suite = true
		else
			var_suite = false
			delete from "feuille_soins" ;
			commit ;
		end if
	end if
else

	var_suite = true
end if

if var_suite then
	//maj des code et cle du soins en question
	code = dw_click.getitemnumber(dw_click.GetRow(),"soins_code")
	cle = dw_click.getitemnumber(dw_click.GetRow(),"cle")
	
	//retrieve des datawindows
	dw_recto.retrieve(code,cle)
	dw_verso.retrieve(code,cle)
	
	boolean date_modifiee = false
		
	if (type_menu = 'S' or type_menu = 'P') and dw_recto.rowcount() > 0 then
		
		// pour DEP
	
		// Spécifique Simon Pierson et Darmon Soulié .. la date de début de traitement est invisible
		If serial = "87612" or serial = "87623" then
			dw_recto.object.debtrai.visible = 0
		end if
	
		// Spécifique Simon Pierson ..la demande est surchargée par la date du jour .... 
		If serial = "87623" then
			dw_recto.setitem(1, "dtedem_bd", today())
		end if
	end if
	
	IF APPEL_VISIODENT then
		// uniquement pour l'impression normal ... spécificité pour les centre dentaires ... Visiodent ...
		dw_recto.Object.nom_praticien.visible = true
		dw_recto.Object.prati_numero_structure.visible = true
				
		dw_recto.Object.nom_praticien_1.visible = true
		dw_recto.Object.prati_numero_structure_1.visible = true
	end if
			
	if  serial = "87879" or serial = "87880" or serial = "87881" then
		// Exclusivement pour les caisses Mutualité Grand sud .. on ajoute la caisse
		dw_recto.Object.caisse_nom.visible = true
	end if


	date v_date_deja_impr
	date v_date_impr
	// recherche si déjà imprimée 
	if type_menu = 'S' then
		// soins "normaux
		select "date_impr" into :v_date_deja_impr from "soins"  where ( "soins"."cle" = :cle ) AND  ( "soins"."code" = :code );
	else
		// soins prévus
		select "date_impr" into :v_date_deja_impr from "soins_prevus"  where ( "soins_prevus"."cle" = :cle ) AND  ( "soins_prevus"."code" = :code );
	end if

	v_date_impr = date(dw_recto.getItemString(1, "date_imp"))

	
	// Spécifique Barloy : si DEP déjà imprimée, on proposer de la réimprimer à la bonne date
	if serial = "87639"  then
		if not isnull(	v_date_deja_impr ) then
			v_date_impr = date(dw_recto.getItemString(1, "date_imp"))
			
			if Messagebox("ATTENTION","La DEP de soin a déjà été imprimée le "+string(	v_date_deja_impr) + ".~n~nSi vous cliquez sur OUI, vous allez imprimer la DEP datée du "+string(v_date_impr) + ".~n~nSi vous cliquez sur NON, vous allez imprimer la DEP en conservant la date du "+string(v_date_deja_impr)+".", Question!, YesNo!, 2 )	= 2 then
				// on remet la date d'impression à la 1ère date
				dw_recto.object.date_imp_modifiee.text = string(v_date_deja_impr)
				dw_recto.Object.date_imp_modifiee.visible = 1
				dw_recto.Object.date_imp.visible = 0
				dw_recto.Object.date_imp_modifiee.x = dw_recto.Object.date_imp.x
				dw_recto.Object.date_imp_modifiee.y = dw_recto.Object.date_imp.y
				date_modifiee = true
			else
				// remise en état au cas où
				dw_recto.Object.date_imp_modifiee.visible = 0
				dw_recto.Object.date_imp.visible = 1
			end if
			
		end if
	end if	
	
	// si impression intégrée gestion de l'image de fond ODF ou MEDECIN
	if w_click_soins_reg.impression_integre then
		if type_menu = 'S' or type_menu = 'P'  then 
			if dw_recto.getitemstring( 1, "prati_typort") = "TO" then
				dw_recto.Object.p_fond.Filename = "cerfa_10518_recto.jpg"
				dw_verso.Object.p_fond.Filename = "cerfa_10518_verso.jpg"
			else
				dw_recto.Object.p_fond.Filename = "cerfa_10522_recto.jpg"
				dw_recto.Object.p_fond.Filename = "cerfa_10522_verso.jpg"
			end if
		else
			// reglements : RAS
		end if
	end if
	
	//si qqch ds les datawin recto et verso alors on continue
	if (dw_recto.rowcount() > 0) AND (dw_verso.rowcount() > 0) then
		//maj de la var globale
		print_ok = false


		//si on est ds gestion rglts
		if type_menu = 'R' then 
			maj_tableaux_recto_feuille_soins(dw_recto)
			mise_jour_total_date(dw_recto)
		end if
	
		string v_imprim_defaut
		
		v_imprim_defaut = change_imprimante(code)
		
		// recherche de l'imprimante spécifique pour les dep et feuilles de soins
		// ne marche pas en print job
		//dw_recto.Modify ('DataWindow.Printer="'+getimprimspecif()+'" ')
		//dw_verso.Modify ('DataWindow.Printer="'+getimprimspecif()+'" ')

		//lance les impressions ds un seul "job"
		num_job = printopen("DEP recto/verso")
		Printdatawindow(num_job,dw_recto)
		Printdatawindow(num_job,dw_verso)
		printclose(num_job)

		remet_imprimante_defaut(v_imprim_defaut)

		if 	type_menu = 'R' then
			//ajoute à l'histo du patient cette impression
			lib_histo = ""
			
			if 	trim(dw_recto.object.tab1_total_lettres.text) <> "" then
				lib_histo = dw_recto.object.tab1_total_lettres.text+" "
			end if
			
			
			if 	trim(dw_recto.object.tab2_total_lettres.text) <> "" then
				if lib_histo <> "" then
					lib_histo = lib_histo +" + "
				end if
				lib_histo = lib_histo + dw_recto.object.tab2_total_lettres.text
			end if
			
		
			ajout_histo_editions(code,"FEUSOI",today(),lib_histo)
		
			
			double code_patient
			long cle_soin, lig, ligtot
			ligtot = dw_click.rowcount()
	
			for lig = 1 to ligtot
				if dw_click.getitemstring(lig,"fse") = 'O'  then
					// Ligne de soins
					code_patient = dw_click.getitemnumber(lig,"soins_code")
					cle_soin = dw_click.getitemnumber(lig,"cle")
					UPDATE "soins" SET "soins"."fse_edite" = 'M'  ,  "soins"."date_fs" = cast(getdate() as date) 
					WHERE code = :code_patient and cle = :cle_soin ;
				end if
			next
			commit ;
			dw_click.retrieve(code)

			//si impression =Ok alors suite ...
			delete from "feuille_soins" ;
			commit ;
		else
			
			// On est dans les renouvellements de DEP
			
			//ajoute une ligne à hito des éditions
			
			lib_histo = trim(left(dw_click.getitemstring(dw_click.getrow(),"code_soins_nom"),14)) 
			
			if dw_click.getitemnumber(dw_click.getrow(),"numero") > 0 then
				lib_histo = lib_histo + " N°"+string(dw_click.getitemnumber(dw_click.getrow(),"numero"))
			end if
	
			lib_histo = lib_histo + " : "	+ dw_recto.getitemstring(1,"dem")+" au "+dw_recto.getitemstring(1,"dtedem")
	
			//ajout_histo_editions(code,"RENSEC",today(),lib_histo)
			

			// Mémo du PDF
			v_dir_patient = dir_photos + string(code) + win_delimiter 
			if not DirectoryExists(v_dir_patient) then
				CreateDirectory(v_dir_patient)
			end if

			v_fichier_destination_complet =  string(today(), "yyyy-mm-dd")+" "+string(now(), "hh-mm-ss")+ " - DEP.pdf"
			v_fichier_destination_complet = v_dir_patient + v_fichier_destination_complet
			dw_recto.saveas(v_fichier_destination_complet, PDF!, false)


			//Depuis 22.00h on met la date réellement imprimée sur le doc ...
			integer categorie_nulle
			setnull(categorie_nulle)
			if date_modifiee then
				fxg_enregcourrierhisto ( code, "RENSEC" , v_date_deja_impr ,lib_histo , v_fichier_destination_complet , 'E', 'N', 'N', '', categorie_nulle )
			else
				fxg_enregcourrierhisto ( code, "RENSEC" , v_date_impr ,lib_histo , v_fichier_destination_complet , 'E', 'N', 'N', '' , categorie_nulle)
			end if	
			
			
			
			//On ne met à jour la date d'impression de la DEP
			//pour les soins ET pour les soins prévus
			if type_menu = 'S' or type_menu = 'P' then
					if type_menu = 'S' then
						if not date_modifiee then
							UPDATE "soins"  SET "date_impr" = cast(getdate() as date)  
							WHERE ( "soins"."cle" = :cle ) AND  ( "soins"."code" = :code );
							COMMIT ;
						end if
						// "petite" datawindow en bas à droite
						if belgique then
							dw_impression.retrieve(cle,code,'B')
						else
							if france then
								dw_impression.retrieve(cle,code,'F')
							else
								dw_impression.retrieve(cle,code,'')
							end if
						end if
					else
						if not date_modifiee then
							UPDATE "soins_prevus"  SET "date_impr" = cast(getdate() as date)  
							WHERE ( "soins_prevus"."cle" = :cle ) AND  ( "soins_prevus"."code" = :code );
							COMMIT ;
						end if
						// véritable datawindow des soins ... pas de retrieve sur la cle
						dw_impression.retrieve(code)
					end if
			end if
		end if
	end if
end if

end subroutine

public subroutine impression_recto (ref datawindow dw_recto, datawindow dw_impression);//string plan
string rc
double cle,code
boolean ok_suite
string lib_histo, v_imprim_defaut, v_type_soins

long ligtot, lig
boolean date_exe_ok
double code_patient, cle_soin
date date_exe

string v_fichier_destination_complet, v_dir_patient


// REGLEMENTS
if type_menu = 'R' then
	
	if BELGIQUE then

		// open(w_attestation_impression)
		w_click_soins_reg.tab_1.tabpage_reglements.cb_facture.triggerevent(clicked!)
	else
		// FRANCE : Feuille de soins AVANT 2017
	
		ok_suite = true
		
		// 1ère verif pour ceux qui n'ont pas le droit de refaire des FS
		if not w_click_soins_reg.multi_fs_autorise then 
			if w_click_soins_reg.verif_si_deja_fs(dw_click) then
					ok_suite = false
			end if
		end  if
	
		if not ok_suite then
			Messagebox("ATTENTION","Au moins un des soins sélectionnés a déjà fait l'objet d'une Feuille de Soin. Vous devez le désélectionner pour poursuivre.")
		else
	
			// Pour les règlement => feuille de soins
			code = dw_click.getitemnumber(dw_click.GetRow(),"soins_code")
			cle = dw_click.getitemnumber(dw_click.GetRow(),"cle")
			
		
			ok_suite = false
			
			// Saisie / modification des totaux !!
			// on ne lance la mise à jour que lorsqu'on est en impression UNITAIRE de feuille de soin
			// par convention, quand on passe 2 fois la même datawindow en entrée
			if dw_recto = dw_impression then
				open(w_feuille_soins_saisie_actes)
				if Message.DoubleParm = 1 then
					ok_suite = true
				end if
			else
				ok_suite = true
			end if
		end if
		
		if ok_suite then
			
					
			// IMPORTANT
			// L'Ajustement DOIT SE FAIRE AVANT LE RETIEVE ... sinon, pb dans les dw filles
			
			// pas de cadrage si impression intégrée 
			if not w_click_soins_reg.impression_integre then
				// Ajustement
				if not ajustement_recto_effectue then
					ajustement_recto(dw_recto)
					ajustement_recto_effectue = true
				end if
			end if

		
			//	retrieve de la datawin
			dw_recto.retrieve(code)
			
			maj_tableaux_recto_feuille_soins(dw_recto)
			
			mise_jour_total_date(dw_recto)
		
	
			//v_imprim_defaut = change_imprimante()
			
			// recherche de l'imprimante spécifique pour les dep et feuilles de soins
			if profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","feuilles_soins_active","N") = "O" then 
				dw_recto.Modify ('DataWindow.Printer="'+getimprimspecif(code)+'" ')
			end if
	
			dw_recto.print()
			
			//remet_imprimante_defaut(v_imprim_defaut)
		
			//ajoute à l'histo du patient cette impression
			lib_histo = ""
		
			if 	trim(dw_recto.object.tab1_total_lettres.text) <> "" then
				lib_histo = dw_recto.object.tab1_total_lettres.text+" "
			end if
			
			
			if 	trim(dw_recto.object.tab2_total_lettres.text) <> "" then
				if lib_histo <> "" then
					lib_histo = lib_histo +" + "
				end if
				lib_histo = lib_histo + dw_recto.object.tab2_total_lettres.text
			end if
		
	
			ajout_histo_editions(code,"FEUSOI",today(),lib_histo)
	
			ligtot = dw_click.rowcount()
		
			for lig = 1 to ligtot
				if dw_click.getitemstring(lig,"fse") = 'O'  then
					// Ligne de soins
					code_patient = dw_click.getitemnumber(lig,"soins_code")
					cle_soin 		 = dw_click.getitemnumber(lig,"cle")
					UPDATE "soins" SET "soins"."fse_edite" = 'M'  ,  "soins"."date_fs" = cast(getdate() as date)  
					WHERE code = :code_patient and cle = :cle_soin ;
				end if
			next
			commit ;
			dw_click.retrieve(code)
	
		
		end if
	end if
//************************************************
	delete from "feuille_soins" ;
	commit ;
//************************************************

else
	//---------------------------------------------------------------------------------------- 
	// Demande Ententes Préalables
	// GESTION DES SOINS ou SOINS PREV !!!
	
	if BELGIQUE then
		
		// Impression de la demande d'intervention : c'est un docu Word nommé "Annexe 60.doc"
		// On passe par une prévisualisation impression
		
		
		uo_lien_word		wrd
		string				propoNom

		// on instancie wrd
		wrd = create uo_lien_word
		
		// on a bien récup l'élément
		propoNom = "Annexe 60.doc"
		if wrd.traiter_avec_word(Service_MajEtVisualise, fxg_get_rep_courriers(),  propoNom, false) <> 1 then
		// si pb sur le job WORD : msg d'erreur
			messagebox("ERREUR","Un problème est survenu durant l'exécution, ~nImpossible de poursuivre !",StopSign!)
		end if
		
		// on libère la mémoire
		destroy wrd
		
	
	else
		// DEP Française
		
		// pas de cadrage si impression intégrée 
		if not w_click_soins_reg.impression_integre then 
	
			// Pour les feuille de renouvellement
			//les ajustement suivant les chiffres ds params généreaux
			if not ajustement_recto_effectue then
				ajustement_recto(dw_recto)
				ajustement_recto_effectue = true
			end if
		end if

		//on retrouve le code et la cle pour ce patient
		code = dw_click.getitemnumber(dw_click.GetRow(),"soins_code")
		cle = dw_click.getitemnumber(dw_click.GetRow(),"cle")
		
		
		//retrieve de la datawin
		dw_recto.retrieve(code,cle)

	
		//si qqch ds datawin recto alors on continue ...
		if dw_recto.rowcount() > 0 then
			print_ok = false
			
			boolean date_modifiee = false
			
			// Spécifique Simon Pierson et Sarmon Soulié .. la date de début de traitement est invisible
			If serial = "87612"  then
				dw_recto.object.debtrai.visible = 0
			end if
	
			// Spécifique Soulié et Poncet ..la demande est surchargée par la date du jour .... 
			If serial = "87623" then
				dw_recto.setitem(1, "dtedem_bd", today())
			end if
			
			// pour mémorisation de la date réelle d'impression
			date v_date_deja_impr
			date v_date_impr
			// recherche si déjà imprimée 
			if type_menu = 'S' then
				// soins "normaux
				select "date_impr" into :v_date_deja_impr from "soins"  where ( "soins"."cle" = :cle ) AND  ( "soins"."code" = :code );
			else
				// soins prévus
				select "date_impr" into :v_date_deja_impr from "soins_prevus"  where ( "soins_prevus"."cle" = :cle ) AND  ( "soins_prevus"."code" = :code );
			end if
			
			v_date_impr = date(dw_recto.getItemString(1, "date_imp"))

			
			// Spécifique Barloy : si DEP déjà imprimée, on propose de la réimprimer à la bonne date
			if serial = "87639"  then
				if not isnull(	v_date_deja_impr ) then
	
					if Messagebox("ATTENTION","La DEP de soin a déjà été imprimée le "+string(	v_date_deja_impr) + ".~n~nSi vous cliquez sur OUI, vous allez imprimer la DEP datée du "+string(v_date_impr) + ".~n~nSi vous cliquez sur NON, vous allez imprimer la DEP en conservant la date du "+string(v_date_deja_impr)+".", Question!, YesNo!, 2 )	= 2 then
						// on remet la date d'impression à la 1ère date
						dw_recto.object.date_imp_modifiee.text = string(v_date_deja_impr)
						dw_recto.Object.date_imp_modifiee.visible = 1
						dw_recto.Object.date_imp.visible = 0
						dw_recto.Object.date_imp_modifiee.x = dw_recto.Object.date_imp.x
						dw_recto.Object.date_imp_modifiee.y = dw_recto.Object.date_imp.y
						date_modifiee = true
					else
						// remise en état au cas où
						dw_recto.Object.date_imp_modifiee.visible = 0
						dw_recto.Object.date_imp.visible = 1
					end if
					
				end if
			end if
		
			// si impression intégrée gestion de l'image de fond ODF ou MEDECIN
			if w_click_soins_reg.impression_integre then
				if dw_recto.getitemstring( 1, "prati_typort") = "TO" then
					dw_recto.Object.p_fond.Filename = "cerfa_10518_recto.jpg"
				else
					dw_recto.Object.p_fond.Filename = "cerfa_10522_recto.jpg"
				end if
				
			else
				
				IF APPEL_VISIODENT then
					// uniquement pour l'impression normal ... spécificité pour les centre dentaires ... Visiodent ...
					dw_recto.Object.nom_praticien.visible = true
					dw_recto.Object.prati_numero_structure.visible = true
					
					dw_recto.Object.nom_praticien_1.visible = true
					dw_recto.Object.prati_numero_structure_1.visible = true
				end if
				
				if  serial = "87879" or serial = "87880" or serial = "87881" then
					// Exclusivement pour les caisses Mutualité Grand sud .. on ajoute la caisse
					dw_recto.Object.caisse_nom.visible = true
				end if
			end if

	
			
			//v_imprim_defaut = change_imprimante()
			
			// recherche de l'imprimante spécifique pour les dep et feuilles de soins
			if profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","dep_active","N") = "O" then 
				dw_recto.Modify ('DataWindow.Printer="'+getimprimspecif(code)+'" ')
			end if
	
			//envoie l'impression
			if dw_recto.print() = 1 then
				print_ok = true
			end if
	
			// Mémo du PDF
			v_dir_patient = dir_photos + string(code) + win_delimiter 
			if not DirectoryExists(v_dir_patient) then
				CreateDirectory(v_dir_patient)
			end if
			v_fichier_destination_complet =  string(today(), "yyyy-mm-dd")+" "+string(now(), "hh-mm-ss")+ " - DEP.pdf"
			v_fichier_destination_complet = v_dir_patient + v_fichier_destination_complet
			dw_recto.saveas(v_fichier_destination_complet, PDF!, false)
		
			//remet_imprimante_defaut(v_imprim_defaut)
		
			
			//si impresion OK alors ...
			if print_ok then
				//ajoute à l'histo du patient cette impression
	
					lib_histo = trim(left(dw_click.getitemstring(dw_click.getrow(),"code_soins_nom"),14)) 
					
					if dw_click.getitemnumber(dw_click.getrow(),"numero") > 0 then
						lib_histo = lib_histo + " N°"+string(dw_click.getitemnumber(dw_click.getrow(),"numero"))
					end if
	
					lib_histo = lib_histo + " : "	+ dw_recto.getitemstring(1,"dem")+" au "+dw_recto.getitemstring(1,"dtedem")
				
				//ajout_histo_editions(code,"RENSEC",today(),lib_histo)
				
				//Depuis 22.00h on met la date réellement imprimée sur le doc ...
				integer categorie_nulle
				setnull(categorie_nulle)
				if date_modifiee then
					//ajout_histo_editions(code,"RENSEC",v_date_deja_impr,lib_histo)
					fxg_enregcourrierhisto ( code, "RENSEC" , v_date_deja_impr ,lib_histo , v_fichier_destination_complet , 'E', 'N', 'N', '', categorie_nulle )
				else
					//ajout_histo_editions(code,"RENSEC",v_date_impr,lib_histo)
					fxg_enregcourrierhisto ( code, "RENSEC" , v_date_impr ,lib_histo , v_fichier_destination_complet , 'E', 'N', 'N', '', categorie_nulle )
				end if
				//On ne met à jour la date d'impression de la DEP
				//pour les soins ET pour les soins prévus
				if type_menu = 'S' or type_menu = 'P' then
						if type_menu = 'S' then
							if not date_modifiee then
								UPDATE "soins"  SET "date_impr" = cast(getdate() as date)  
								WHERE ( "soins"."cle" = :cle ) AND  ( "soins"."code" = :code );
								COMMIT ;
							end if
							// "petite" datawindow en bas à droite
							if belgique then
								dw_impression.retrieve(cle,code,'B')
							else
								if france then
									dw_impression.retrieve(cle,code,'F')
								else
									dw_impression.retrieve(cle,code,'')
								end if
							end if
						else
							if not date_modifiee then
								UPDATE "soins_prevus"  SET "date_impr" = cast(getdate() as date)  
								WHERE ( "soins_prevus"."cle" = :cle ) AND  ( "soins_prevus"."code" = :code );
								COMMIT ;
							end if
							// véritable datawindow des soins ... pas de retrieve sur la cle
							dw_impression.retrieve(code, w_click_soins_reg.var_code_devis_local)
						end if
				end if
			end if
		else
			Messagebox("INFORMATION","Pas de DEP pour ce soin ! Le type de soin est paramétré sans renouvellement (Cf. table des Types de soins).")
		end if
	end if
end if
end subroutine

public subroutine remet_imprimante_defaut (string v_imprim);
// Permet de remettre l'imprimante passée en paramètre par défaut



// On vérifie si on a activée l'imprimante ou pas !!
if profileString(dir_ini+inifile_orthokis,"IMPRIMANTES","dep_active","N")  = 'O' then

	
	//	Instance de la liste pour utiliser les fonctions ad'hoc
	uo_liste_imprimantes  imprim
	imprim = CREATE uo_liste_imprimantes  
	// pour mise à jour des valeurs
	imprim.triggerevent(constructor!)
		
	
	
	imprim.setImprimanteDefaut(v_imprim)
	
		
		
	
	
	destroy imprim 
	
end if
end subroutine

public subroutine ajustement_recto (ref datawindow dw_recto);//fx protected qui permet de faire les ajustements d'impression seulon imprimante
//renvoie rien

long dx,dy
string plan


if type_menu = 'R' then
	
	if Belgique then
		
		// C'est l'Attestation de Soins Donnés
		SELECT remb_retro_x,remb_retro_y INTO :dx,:dy FROM param_secu ;
		chg_coord(dw_recto,"nom_parent1",dx,dy)
		chg_coord(dw_recto,"nom_caisse",dx,dy)
		chg_coord(dw_recto,"num_secu",dx,dy)
		chg_coord(dw_recto,"adr1_parent1",dx,dy)
		chg_coord(dw_recto,"adr2_parent1",dx,dy)
		chg_coord(dw_recto,"codep_parent1",dx,dy)
		chg_coord(dw_recto,"ville_parent1",dx,dy)

		
		
		SELECT remb_pano_x,remb_pano_y INTO :dx,:dy FROM param_secu ;
		chg_coord(dw_recto,"nom_patient",dx,dy)
		chg_coord(dw_recto,"prenom_patient",dx,dy)


		SELECT remb_nom_x,remb_nom_y INTO :dx,:dy FROM param_secu ;
		chg_coord(dw_recto,"nom_praticien",dx,dy)
		chg_coord(dw_recto,"numero_inami",dx,dy)

		// imprime t on le remboursement sur l'attestation ?
		string v_attestation_remboursement
		select top 1 attestation_remboursement into :v_attestation_remboursement from param ;
		
		if v_attestation_remboursement = 'O' then 
			chg_coord(dw_recto,"total_montant_rembourse",dx,dy)
			dw_recto.object.total_montant_rembourse.visible = 1
		else
			dw_recto.object.total_montant_rembourse.visible = 0
		end if
		
		SELECT remb_date_x,remb_date_y INTO :dx,:dy FROM param_secu ;
		if dx = -999 and dy = -999 then
			// Rendre invisible 
			dw_recto.modify("date.visible = 0")
		else
			chg_coord(dw_recto,"date",dx,dy)
		end if

		if profilestring(dir_ini+inifile_orthokis,"DEP-FSE","attestations_2016","N")  ="O" then 
			// modèle attestation 2016
			SELECT remb_cadre2_x,remb_cadre2_y INTO :dx,:dy FROM param_secu ;
			chg_coord(dw_recto,"numero_bce",dx,dy)
			chg_coord(dw_recto,"montant_recu",dx,dy)
			chg_coord(dw_recto,"date_1",dx,dy)
			dw_recto.object.numero_bce.visible = 1
			dw_recto.object.montant_recu.visible = 1
			dw_recto.object.date_1.visible = 1
		else
			// Attestation AVANT 2016
			SELECT remb_cadre1_x,remb_cadre1_y INTO :dx,:dy FROM param_secu ;
			dw_recto.modify("date_1.visible = 0")
			chg_coord(dw_recto,"institution_perceptrice",dx,dy)
			dw_recto.object.institution_perceptrice.visible = 1
		end if
		

		
		
		
		SELECT remb_tele_x,remb_tele_y INTO :dx,:dy FROM param_secu ;
		
		// L'horizontalement de règle classique
		chg_coord(dw_recto,"date_exe",dx,0)
		chg_coord(dw_recto,"soins",dx,0)
		chg_coord(dw_recto,"dent",dx,0)
		
		// Le verticlament c'est la hauteur du Header du Group 1
		dy = dy + 1204
		dw_recto.modify ("Datawindow.header.1.height = "+ string(dy) ) 
		
	else
		// FRANCE !!
		
		// C'est une feuille de soins

		// Cadre1
		SELECT remb_cadre1_x,remb_cadre1_y INTO :dx,:dy FROM param_secu ;
		//chg_coord(dw_recto,"cadre1",dx,dy)
		
		integer lig, nb_lig
		
		// Cadre du haut
		nb_lig = 9
		for lig = 1 to nb_lig
			chg_coord(dw_recto,"tab1_lig"+string(lig)+"_date",dx,dy)
			chg_coord(dw_recto,"tab1_lig"+string(lig)+"_dent",dx,dy)
			chg_coord(dw_recto,"tab1_lig"+string(lig)+"_lettre",dx,dy)
			chg_coord(dw_recto,"tab1_lig"+string(lig)+"_nb_lettre",dx,dy)
			chg_coord(dw_recto,"tab1_lig"+string(lig)+"_libelle",dx,dy)
			chg_coord(dw_recto,"tab1_lig"+string(lig)+"_motif",dx,dy)
		next

		chg_coord(dw_recto,"tab1_total_lettres",dx,dy)
		chg_coord(dw_recto,"tab1_total_euros",dx,dy)
		chg_coord(dw_recto,"tab1_nombre_en_lettres",dx,dy)

		
		// identification (zone du haut)
		SELECT remb_identification_x,remb_identification_y INTO :dx,:dy FROM param_secu ;
		if dx = -999 and dy = -999 then
			dw_recto.modify("prati_institution_perceptrice.visible = 0")
		else
			chg_coord(dw_recto,"prati_institution_perceptrice",dx,dy)
		end if
		
	
		// Rétroalvéolie
		SELECT remb_retro_x,remb_retro_y INTO :dx,:dy FROM param_secu ;
		chg_coord(dw_recto,"retro",dx,dy)
		// Panoramique
		SELECT remb_pano_x,remb_pano_y INTO :dx,:dy FROM param_secu ;
		chg_coord(dw_recto,"pano",dx,dy)
		// Téléradiographique
		SELECT remb_tele_x,remb_tele_y INTO :dx,:dy FROM param_secu ;
		chg_coord(dw_recto,"tele",dx,dy)

		// Nom du patient
		SELECT remb_nom_x,remb_nom_y INTO :dx,:dy FROM param_secu ;
		chg_coord(dw_recto,"nom_complet",dx,dy)

		// Cadre2
		SELECT remb_cadre2_x,remb_cadre2_y INTO :dx,:dy FROM param_secu ;
//		chg_coord(dw_recto,"cadre2",dx,dy)

		// Cadre du bas
		nb_lig = 5
		for lig = 1 to nb_lig
			chg_coord(dw_recto,"tab2_lig"+string(lig)+"_date",dx,dy)
			chg_coord(dw_recto,"tab2_lig"+string(lig)+"_dent",dx,dy)
			chg_coord(dw_recto,"tab2_lig"+string(lig)+"_lettre",dx,dy)
			chg_coord(dw_recto,"tab2_lig"+string(lig)+"_nb_lettre",dx,dy)
			chg_coord(dw_recto,"tab2_lig"+string(lig)+"_libelle",dx,dy)
			chg_coord(dw_recto,"tab2_lig"+string(lig)+"_motif",dx,dy)
		next
		chg_coord(dw_recto,"tab2_total_lettres",dx,dy)
		chg_coord(dw_recto,"tab2_total_euros",dx,dy)
		chg_coord(dw_recto,"tab2_nombre_en_lettres",dx,dy)

		// Date
		SELECT remb_date_x,remb_date_y INTO :dx,:dy FROM param_secu ;
		chg_coord(dw_recto,"date",dx,dy)
	end if
		
else
	// C'est une feuille d'entente

	boolean v_dep_utiliser_cadagre_local
	
	// plan de traitement
	SELECT plan_traitement_renouv
	INTO :plan FROM param ;
	
	if profilestring(dir_ini+inifile_orthokis,"DEP-FSE","dep_utiliser_cadagre_local", "N") = "O" then
		v_dep_utiliser_cadagre_local = true
	else
		v_dep_utiliser_cadagre_local = false
	end if
	
	
	// identification (zone du haut)
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_identification_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_identification_y", "0"))
	else
		SELECT renouv_identification_x,renouv_identification_y INTO :dx,:dy FROM param_secu ;
	end if
	if dx = -999 and dy = -999 then
		dw_recto.modify("prati_institution_perceptrice.visible = 0")
	else
		chg_coord(dw_recto,"prati_institution_perceptrice",dx,dy)
	end if
	
	// identification (zone du bas)
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_identification2_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_identification2_y", "0"))
	else
		SELECT renouv_identification2_x,renouv_identification2_y INTO :dx,:dy FROM param_secu ;
	end if
	if dx = -999 and dy = -999 then
		dw_recto.modify("prati_institution_perceptrice_1.visible = 0")
	else
		chg_coord(dw_recto,"prati_institution_perceptrice_1",dx,dy)
	end if
		

	// Références nationales R
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_r_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_r_y", "0"))
	else
		SELECT renouv_r_x,renouv_r_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"r",dx,dy)
	
	// Références nationales HR
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_hr_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_hr_y", "0"))
	else
		SELECT renouv_hr_x,renouv_hr_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"hr",dx,dy)

	// date proposition
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_dtepropo_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_dtepropo_y", "0"))
	else
		SELECT renouv_dtepropo_x,renouv_dtepropo_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"dtedem",dx,dy)
	
	// date début de traitement
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_debtrai_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_debtrai_y", "0"))
	else
		SELECT renouv_debtrai_x,renouv_debtrai_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"debtrai",dx,dy)
	
	// Cotation 
	// ATTENTION ! Gestion spéciale car plus de variables disponibles
	// dans table param_secu
	chg_coord(dw_recto,"cotation",dx,0)
	dy = (2 * double(dw_recto.describe("debtrai.y")) - double(dw_recto.describe("dtedem.y")))
	dw_recto.modify("cotation.y = "+string(dy))
	
	
	// Devis oui
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_oui_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_oui_y", "0"))
	else
		SELECT renouv_oui_x,renouv_oui_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"oui",dx,dy)
	
	// Devis non
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_non_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_non_y", "0"))
	else
		SELECT renouv_non_x,renouv_non_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"non",dx,dy)
	
	// Nom du patient 
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_nom1_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_nom1_y", "0"))
	else
		SELECT renouv_nom1_x,renouv_nom1_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"patient_nom_1",dx,dy)
	
	// Date de naissance
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_dtenais_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_dtenais_y", "0"))
	else
		SELECT renouv_dtenais_x,renouv_dtenais_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"patient_date_naissance",dx,dy)
	
	// N° Sécu de l'assuré
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_secu_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_secu_y", "0"))
	else
		SELECT renouv_secu_x,renouv_secu_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"secu",dx,dy)

	// Début de traitement
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_semestre_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_semestre_y", "0"))
	else
		SELECT renouv_semestre_x,renouv_semestre_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"sem1",dx,dy)
	// Surveillance
	chg_coord(dw_recto,"surv",dx,dy)
	
	// Suite
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_contention_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_contention_y", "0"))
	else
		SELECT renouv_contention_x,renouv_contention_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"suite",dx,dy)
	// Contention
	chg_coord(dw_recto,"cont",dx,dy)
	
	// N° semestre
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_nosem_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_nosem_y", "0"))
	else
		SELECT renouv_nosem_x,renouv_nosem_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"semno",dx,dy)
	// N° contention
	chg_coord(dw_recto,"an",dx,dy)

	// Autres
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_autres_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_autres_y", "0"))
	else
		SELECT renouv_autres_x,renouv_autres_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"autres",dx,dy)	
	
	// Lesquels
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_lesquels_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_lesquels_y", "0"))
	else
		SELECT renouv_lesquels_x,renouv_lesquels_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"lesquels",dx,dy)	
	
	// Basal max pro
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_basal_max_pro_x", "0"))
		dy = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_basal_max_pro_y", "0"))
	else
		SELECT renouv_basal_max_pro_x,renouv_basal_max_pro_y INTO :dx,:dy FROM param_secu ;
	end if
	chg_coord(dw_recto,"basal_max_pro",dx,dy)	
	// Basal max endo
	chg_coord(dw_recto,"basal_max_endo",dx,dy)			
	// Hypodivergence
	chg_coord(dw_recto,"hypodivergence",dx,dy)	
	
	// Basal max retro
	if v_dep_utiliser_cadagre_local then
		dx = long(profilestring(dir_ini+inifile_orthokis,"DEP-FSE","renouv_basal_max_retro_x", "0"))
