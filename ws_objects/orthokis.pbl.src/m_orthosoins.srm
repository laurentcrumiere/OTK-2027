type m_inscriptioneattest from menu within m_soins
end type

event clicked;

// Visible uniquement pour la Belgique, dans les soins ou les règlements



string chaine_nulle 
date date_nulle , nouvelle_date, v_date_fse
long row 
string v_fse_edite, v_ar_eattest
boolean v_suite = true



If dw_click.rowCount() > 0 Then
	
	row = dw_click.GetRow()
	var_code_local = w_click_soins_reg.var_code_local
	
	v_fse_edite = string_non_nulle(dw_click.getItemString(row,"soins_fse_edite"))
	
	v_date_fse = dw_click.getItemDate(row,"soins_date_fs")
	
	if v_fse_edite = "" then 
		if messagebox("ATTENTION !","Vous allez inscrire l'information de réalisation d'une eAttest.~n~nConfirmez-vous ?"	,Question!,Yesno!,2) = 1 then
			dw_click.setItem(row,"soins_fse_edite","E")
			dw_click.setItem(row,"soins_date_fs",today())
			
			v_ar_eattest = inputboxWithPropo("Inscription d'eAttest", "Veuillez indiquer le N° de l'eAttest à inscrire :" , "Inscription Manuelle", false)

			dw_click.setItem(row,"ar_eattest",v_ar_eattest)
			
			
			if dw_click.update() = 1 then
				commit ;
			else
				rollback ;
			end if
			
			// Retrieve pour actualiser les infos ... cadre des soins
			dw_click.retrieve(var_code_local)
			dw_click.scrollToRow(row)

		end if
	else
		
		Messagebox("ATTENTION","Vous ne pouvez mettre à jour que des lignes sans eAttest ni Justificatif !")
	end if
	
end if
end event

