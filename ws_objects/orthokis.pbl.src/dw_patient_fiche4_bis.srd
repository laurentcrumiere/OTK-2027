		~"patient~".~"secu_patient~",
         (select isnull(categories.nom, '') as categories_nom_4 from categories, correspondants where code_medecin2 = correspondants.code and correspondants.categorie = categories.code),   
         (select isnull(categories.nom, '') as categories_nom_5 from categories, correspondants where code_medecin3 = correspondants.code and correspondants.categorie = categories.code),   
         (select isnull(categories.nom, '') as categories_nom_6 from categories, correspondants where code_medecin4 = correspondants.code and correspondants.categorie = categories.code),
		~"patient~".~"barre_avancement~" ,
		~"patient~".~"autor_rdv_portail_patient~",
		~"patient~".~"rum~",
		~"patient~".~"date_mandat~",
		~"patient~".~"code_mutuelle2~",
		~"patient~".~"autor_cloud~",
		~"patient~".~"autor_appli_patient~",
		~"patient~".~"autor_appli_parent11~", 
		~"patient~".~"autor_appli_parent12~",
		~"patient~".~"autor_appli_parent21~",
		~"patient~".~"autor_appli_parent22~",
		~"patient~".~"autor_appli_payeur1~",
		~"patient~".~"autor_appli_payeur2~", 
		~"patient~".~"numero_piece_identite~" ,
(SELECT v1 from table_vide) as fichier_photo_identite ,
		~"patient~".~"dents_soins~" 

    FROM {oj ~"correspondants~" ~"correspondants_a~" LEFT OUTER JOIN ~"categories~" ~"categories_a~" ON ~"correspondants_a~".~"categorie~" = ~"categories_a~".~"code~"}, {oj ~"correspondants~" ~"correspondants_b~" LEFT OUTER JOIN ~"categories~" ~"categories_b~" ON ~"correspondants_b~".~"categorie~" = ~"categories_b~".~"code~"}, {oj ~"correspondants~" ~"correspondants_c~" LEFT OUTER JOIN ~"categories~" ~"categories_c~" ON ~"correspondants_c~".~"categorie~" = ~"categories_c~".~"code~"},   
         ~"patient~"  
   WHERE ( ~"patient~".~"code_correspondant~" = ~"correspondants_a~".~"code~" ) and  
         ( ~"patient~".~"code_dentiste~" = ~"correspondants_b~".~"code~" ) and  
         ( ~"patient~".~"code_medecin~" = ~"correspondants_c~".~"code~" ) and  
         ( (  ~"patient~".~"code~" = :var_code  ) )    
" update="patient" updatewhere=0 updatekeyinplace=no arguments=(("var_code", number)) )
