 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"connexions~" ) COLUMN(NAME=~"connexions.code_interne~") COLUMN(NAME=~"connexions.adresse_mac~") COLUMN(NAME=~"connexions.premiere_connexion~") COLUMN(NAME=~"connexions.derniere_connexion~") COLUMN(NAME=~"connexions.adresse_ip~") COLUMN(NAME=~"connexions.nom_poste~") COLUMN(NAME=~"connexions.derniere_deconnexion~") COLUMN(NAME=~"connexions.derniere_savedb~") COLUMN(NAME=~"connexions.user_windows~") COLUMN(NAME=~"connexions.user_orthokis~") COLUMN(NAME=~"connexions.version_orthokis~") COLUMN(NAME=~"connexions.dir_installation~") COLUMN(NAME=~"connexions.dir_photos~") COLUMN(NAME=~"connexions.dir_photos_itinerant~") COLUMN(NAME=~"connexions.dir_courriers~") COLUMN(NAME=~"connexions.dir_sauvegarde_base~") COLUMN(NAME=~"connexions.odrade_installe~") COLUMN(NAME=~"connexions.dir_odrade_patients~") COLUMN(NAME=~"connexions.televitale_installe~") COLUMN(NAME=~"connexions.sauvegarde_base_auto~") COLUMN(NAME=~"connexions.page_clinique_commentaires_cliniques~") COLUMN(NAME=~"connexions.infos_os~") COLUMN(NAME=~"connexions.type_machine~") COLUMN(NAME=~"connexions.numero_clef_hasp~")WHERE(    EXP1 =~"date(~~~"connexions~~~".~~~"derniere_connexion~~~")~"   OP =~">=~"    EXP2 =~":v_date_limite~" ) ) ARG(NAME = ~"v_adresse_mac~" TYPE = string)  ARG(NAME = ~"v_date_limite~" TYPE = date) " update="connexions" updatewhere=1 updatekeyinplace=no arguments=(("v_adresse_mac", string),("v_date_limite", date))  sort="nom_poste A " )
