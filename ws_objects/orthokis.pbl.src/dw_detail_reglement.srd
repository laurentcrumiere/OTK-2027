table(column=(type=decimal(2) update=yes updatewhereclause=yes key=yes name=montant dbname="paye.montant" )
 column=(type=char(40) update=yes updatewhereclause=yes key=yes name=commentaire dbname="paye.commentaire" )
 column=(type=char(50) update=yes updatewhereclause=yes name=payeur dbname="paye.payeur" )
 column=(type=date update=yes updatewhereclause=yes key=yes name=dateremise dbname="paye.dateremise" initial="today" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tp dbname="paye.tp" initial="N" values="	O/	N" )
 column=(type=date update=yes updatewhereclause=yes key=yes name=date dbname="paye.date" initial="today" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=cle dbname="paye.cle" )
 column=(type=date update=yes updatewhereclause=yes name=transfert dbname="paye.transfert" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="paye.code" )
 column=(type=char(1) updatewhereclause=yes name=origine_tp dbname="paye.origine_tp" )
 column=(type=decimal(2) updatewhereclause=yes name=doit dbname="doit" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_monnaie dbname="paye.montant_monnaie" )
 column=(type=char(1) updatewhereclause=yes name=monnaie dbname="paye.monnaie" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=char(50) updatewhereclause=yes name=banque_ident dbname="banque.ident" )
 column=(type=decimal(2) updatewhereclause=yes name=total_soin dbname="total_soin" )
 column=(type=char(6) updatewhereclause=yes name=user_modif dbname="paye.user_modif" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="paye.date_modif" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=mode dbname="paye.mode" values="Chèque	C/Espèces	E/Virement 	V/CCP	P/Carte Bancaire	B/Solde	S/Mandat Postal	M/" )
 column=(type=char(20) updatewhereclause=yes name=mode_reglement_nom dbname="mode_reglement.nom" )
 column=(type=char(1) updatewhereclause=yes name=selection dbname="table_vide.v1" values="	O/	N" )
 column=(type=char(6) updatewhereclause=yes name=paye_code_praticien dbname="paye.code_praticien" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_barre_couleur_code dbname="prati.barre_couleur_code" )
 column=(type=number updatewhereclause=yes name=code_remise dbname="paye.code_remise" )
 column=(type=datetime updatewhereclause=yes name=remises_date_generation dbname="remises.date_generation" )
 column=(type=datetime updatewhereclause=yes name=heure_saisie dbname="paye.heure_saisie" )
 column=(type=char(6) updatewhereclause=yes name=banque_code dbname="banque.code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"paye~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"banque~" )  TABLE(NAME=~"mode_reglement~" )  TABLE(NAME=~"table_vide~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"remises~" ) COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.tp~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.cle~") COLUMN(NAME=~"paye.transfert~") COLUMN(NAME=~"paye.code~") COLUMN(NAME=~"paye.origine_tp~") COMPUTE(NAME=~"dba.lignes_soins_dues_un_soin (paye.code, paye.cle, cast(getdate() as date), 'O') as doit~") COLUMN(NAME=~"paye.montant_monnaie~") COLUMN(NAME=~"paye.monnaie~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"banque.ident~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS total_soin FROM ligne_soins WHERE paye.code = ligne_soins.code and ligne_soins.cle = paye.cle )~") COLUMN(NAME=~"paye.user_modif~") COLUMN(NAME=~"paye.date_modif~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"mode_reglement.nom~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"paye.code_praticien~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.barre_couleur_code~") COLUMN(NAME=~"paye.code_remise~") COLUMN(NAME=~"remises.date_generation~") COLUMN(NAME=~"paye.heure_saisie~") COLUMN(NAME=~"banque.code~")    JOIN (LEFT=~"banque.code~"    OP =~"=~"RIGHT=~"paye.banque~"    OUTER2 =~"paye.banque~" )    JOIN (LEFT=~"paye.code_remise~"    OP =~"=~"RIGHT=~"remises.code~"    OUTER1 =~"paye.code_remise~" )    JOIN (LEFT=~"paye.mode~"    OP =~"=~"RIGHT=~"mode_reglement.code~" )    JOIN (LEFT=~"paye.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"paye.code~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"paye~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"cle~~~"~"   OP =~"=~"    EXP2 =~":cle~" ) ) ARG(NAME = ~"nocode~" TYPE = number)  ARG(NAME = ~"cle~" TYPE = number) " update="paye" updatewhere=0 updatekeyinplace=no arguments=(("nocode", number),("cle", number))  sort="date A dateremise A tp D origine_tp A " )
