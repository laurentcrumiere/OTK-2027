table(column=(type=datetime update=yes updatewhereclause=yes name=date_echeance dbname="taches.date_echeance" dbalias=".date_echeance" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=texte dbname="taches.texte" dbalias=".texte" )
 column=(type=char(6) update=yes updatewhereclause=yes name=utilisateur_emetteur dbname="taches.utilisateur_emetteur" dbalias=".utilisateur_emetteur" )
 column=(type=char(6) update=yes updatewhereclause=yes name=utilisateur_destinataire dbname="taches.utilisateur_destinataire" dbalias=".utilisateur_destinataire" )
 column=(type=char(1) update=yes updatewhereclause=yes name=confidentiel dbname="taches.confidentiel" dbalias=".confidentiel" values="	O/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=statut dbname="taches.statut" dbalias=".statut" values="	O/	N" )
 column=(type=number updatewhereclause=yes key=yes identity=yes name=id dbname="taches.id" dbalias=".id" )
 column=(type=datetime updatewhereclause=yes name=saisie dbname="taches.saisie" dbalias=".saisie" )
 column=(type=char(98) updatewhereclause=yes name=nom_patient dbname="nom_patient" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="taches.code" dbalias=".code" )
 column=(type=date updatewhereclause=yes name=que_date_echeance dbname="que_date_echeance" )
 column=(type=char(1) update=yes updatewhereclause=yes name=notification dbname="taches.notification" dbalias=".notification" values="	O/	N" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=minutes_notification dbname="taches.minutes_notification" dbalias=".minutes_notification" )
 column=(type=number updatewhereclause=yes name=groupe_destinataire dbname="taches.groupe_destinataire" dbalias=".groupe_destinataire" )
 column=(type=char(1) updatewhereclause=yes name=type_destinataire dbname="taches.type_destinataire" dbalias=".type_destinataire" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"taches~" ) COLUMN(NAME=~"taches.date_echeance~") COLUMN(NAME=~"taches.texte~") COLUMN(NAME=~"taches.utilisateur_emetteur~") COLUMN(NAME=~"taches.utilisateur_destinataire~") COLUMN(NAME=~"taches.confidentiel~") COLUMN(NAME=~"taches.statut~") COLUMN(NAME=~"taches.id~") COLUMN(NAME=~"taches.saisie~") COMPUTE(NAME=~"(select isnull(nom + ' '+ prenom + ' (' + cast(numero_dossier as varchar) + ')', '') from patient where taches.code = patient.code) as nom_patient~") COLUMN(NAME=~"taches.code~") COMPUTE(NAME=~"cast(date_echeance as date) as que_date_echeance~") COLUMN(NAME=~"taches.notification~") COLUMN(NAME=~"taches.minutes_notification~") COLUMN(NAME=~"taches.groupe_destinataire~") COLUMN(NAME=~"taches.type_destinataire~")WHERE(    EXP1 =~"date(~~~"taches~~~".~~~"date_echeance~~~")~"   OP =~"<=~"    EXP2 =~":date_limite~" ) ) ARG(NAME = ~"date_limite~" TYPE = date) " update="taches" updatewhere=0 updatekeyinplace=no arguments=(("date_limite", date))  sort="date_echeance A texte A saisie A " )
