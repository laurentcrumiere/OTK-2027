$PBExportHeader$verif_change_dossier_auto_rdv.srf
global type verif_change_dossier_auto_rdv from function_object
end type

forward prototypes
global function boolean verif_change_dossier_auto_rdv (double v_code, string v_type, string v_etat)
end prototypes

global function boolean verif_change_dossier_auto_rdv (double v_code, string v_type, string v_etat);

// Fonction qui vérifie et modifie si besoin le type de dossier du patient en fonction des automatismes dans les types de rendez-vous

// v_code : code du patient
// v_type : type du rdv
// v_etat : etat du rdv qui vient d'être saisi

// depuis 2014, elle met aussi éventuellement à jour les dates qui doivent l'être

// depsuis 2026, elle met aussi éventuellement à jour les pastilles de couleurs

// La fonction renvoit VRAIE Si une valeur est modifiée, quelle qu'elle soit, on revoit VRAI même si pas forcément utile


string v_modif, v_etat_modif, v_dossier_modif
string v_type_dossier
integer v_numero_pastille_couleur
long v_couleur_pastille
string v_modif_date_moulage, v_modif_date_premiere_demande, v_modif_date_debut_traitement, v_modif_date_interruption, v_modif_date_reprise, v_modif_date_fin_traitement, v_modif_date_debut_contention, v_modif_date_fin_contention

boolean modif_realisee

modif_realisee = false

// Recheche si on a un automatisme ou pas sur la modification du type de dossier
select modif_auto_dossier, etat_modif_dossier, type_dossier  into :v_modif, :v_etat_modif, :v_dossier_modif from type_rdv where code = :v_type ;

if v_modif = 'O' then
	// modification automatique 
	
	// Verif de l'état déclenchant la modif
	if v_etat = v_etat_modif and not isnull(v_etat_modif) then
		
		// C'est l'état déclenchant
		
		
		// vérif du type de dossier actuel du patient
		select type_dossier into :v_type_dossier from patient where code = :v_code ;
		
		
		// les types sont différents, alors seulement on met à jour 
		
		if v_type_dossier <> v_dossier_modif and not isnull(v_dossier_modif) then
			
				update patient set type_dossier = :v_dossier_modif where code = :v_code ;
				
				// Mise à jour de l'historique des dossiers
				INSERT INTO histo_dossier (code, date_heure, type_dossier) 
				VALUES (:v_code, getdate(), :v_dossier_modif) ;
				COMMIT ;
				
				modif_realisee = true

		end if		
	end if
		
end if

// Recherche si on a un automatisme ou pas sur la mise à jour des dates selon le type de rdv
select modif_auto_date , modif_date_moulage, modif_date_premiere_demande, modif_date_debut_traitement, modif_date_interruption, modif_date_reprise, modif_date_fin_traitement,  modif_debut_contention, modif_fin_contention
into  :v_modif, :v_modif_date_moulage, :v_modif_date_premiere_demande, :v_modif_date_debut_traitement, :v_modif_date_interruption, :v_modif_date_reprise, :v_modif_date_fin_traitement,
 :v_modif_date_debut_contention, :v_modif_date_fin_contention
from type_rdv where code = :v_type and etat_modif_date = :v_etat ;

if v_modif = 'O' then

	if v_modif_date_moulage = 'O' then 
		update patient set date_moulage = cast(getdate() as date) where code = :v_code and date_moulage is null ;
		COMMIT ;
		modif_realisee = true
	end if
	
	if v_modif_date_premiere_demande = 'O' then 
		update patient set date_prem_demande = cast(getdate() as date) where code = :v_code and date_prem_demande is null ;
		COMMIT ;
		modif_realisee = true
	end if
	
	if v_modif_date_debut_traitement = 'O' then 
		update patient set debut_traitement = cast(getdate() as date) where code = :v_code and debut_traitement is null ;
		COMMIT ;
		modif_realisee = true
	end if
	
	if v_modif_date_interruption = 'O' then 
		update patient set date_interruption = cast(getdate() as date) where code = :v_code and date_interruption is null;
		COMMIT ;
		modif_realisee = true
	end if
	
	if v_modif_date_reprise = 'O' then 
		update patient set date_reprise = cast(getdate() as date) where code = :v_code and date_reprise is null  ;
		COMMIT ;
		modif_realisee = true
	end if
	
	if v_modif_date_fin_traitement = 'O' then 
		update patient set fin_traitement = cast(getdate() as date) where code = :v_code and fin_traitement is null ;
		COMMIT ;
		modif_realisee = true
	end if

	if v_modif_date_debut_contention = 'O' then 
		update patient set debut_contention = cast(getdate() as date) where code = :v_code and debut_contention is null ;
		COMMIT ;
		modif_realisee = true
	end if

	if v_modif_date_fin_contention = 'O' then 
		update patient set fin_contention = cast(getdate() as date) where code = :v_code and fin_contention is null ;
		COMMIT ;
		modif_realisee = true
	end if
	

end if


// Recheche si on a un automatisme ou pas sur la modification d'une pastille de couleur
select maj_pastille_couleur, etat_maj_pastille_couleur, numero_pastille_couleur, couleur_pastille  
into :v_modif, :v_etat_modif, :v_numero_pastille_couleur, :v_couleur_pastille 
from type_rdv where code = :v_type ;

if v_modif = "O" and v_etat_modif = v_etat then
	
	choose case v_numero_pastille_couleur
		case 1
			update patient set couleur1 = :v_couleur_pastille where code = :v_code ;
		case 2
			update patient set couleur2 = :v_couleur_pastille where code = :v_code ;
		case 3
			update patient set couleur3 = :v_couleur_pastille where code = :v_code ;
	case 4
			update patient set couleur4 = :v_couleur_pastille where code = :v_code ;
	end choose
	
	modif_realisee = true
	
end if


return modif_realisee




end function

