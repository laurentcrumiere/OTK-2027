$PBExportHeader$place.srf
global type place from function_object
end type

forward prototypes
global subroutine place (string chaine1, ref string chaine2, int position)
end prototypes

global subroutine place (string chaine1, ref string chaine2, int position);// Place Chaine1 dans Chaine2 à la position Position


integer l1,l2



l1 = len(chaine1)
l2 = len(chaine2)


chaine2 = left(chaine2,position - 1) + chaine1 + right(chaine2, l2 - l1 - position + 1)







end subroutine

