table(column=(type=decimal(2) update=yes updatewhereclause=yes name=montant dbname="paye.montant" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mode dbname="paye.mode" values="Chèque	C/Espèces	E/Virement 	V/CCP	P/Carte Bancaire	B/Solde	S/Mandat Postal	M/" )
 column=(type=char(40) update=yes updatewhereclause=yes name=commentaire dbname="paye.commentaire" )
 column=(type=char(40) update=yes updatewhereclause=yes name=payeur dbname="paye.payeur" )
 column=(type=date update=yes updatewhereclause=yes name=dateremise dbname="paye.dateremise" initial="today" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tp dbname="paye.tp" initial="N" values="	O/	N" )
 column=(type=date update=yes updatewhereclause=yes name=date dbname="paye.date" initial="today" )
 column=(type=number update=yes updatewhereclause=yes name=cle dbname="paye.cle" )
 column=(type=date update=yes updatewhereclause=yes name=transfert dbname="paye.transfert" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" )
 column=(type=decimal(2) updatewhereclause=yes name=cdoit dbname="doit" )
 column=(type=number update=yes updatewhereclause=yes name=code dbname="paye.code" )
 column=(type=char(1) update=yes updatewhereclause=yes name=paye_origine_tp dbname="paye.origine_tp" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_monnaie dbname="paye.montant_monnaie" )
 column=(type=char(1) updatewhereclause=yes name=monnaie dbname="paye.monnaie" )
 column=(type=char(20) updatewhereclause=yes name=mode_reglement_nom dbname="mode_reglement.nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"paye~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"mode_reglement~" ) COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.tp~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.cle~") COLUMN(NAME=~"paye.transfert~") COLUMN(NAME=~"soins.total~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS doit FROM ligne_soins WHERE soins.code = ligne_soins.code and ligne_soins.cle = soins.cle and ligne_soins.~~~"date~~~" <= cast(getdate() as date) )~") COLUMN(NAME=~"paye.code~") COLUMN(NAME=~"paye.origine_tp~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"paye.montant_monnaie~") COLUMN(NAME=~"paye.monnaie~") COLUMN(NAME=~"mode_reglement.nom~")    JOIN (LEFT=~"paye.mode~"    OP =~"=~"RIGHT=~"mode_reglement.code~"    OUTER1 =~"paye.mode~" )   JOIN (LEFT=~"paye.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"paye.cle~"    OP =~"=~"RIGHT=~"soins.cle~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"cle~~~"~"   OP =~"=~"    EXP2 =~":cle~" ) ) ARG(NAME = ~"nocode~" TYPE = number)  ARG(NAME = ~"cle~" TYPE = number)  ARG(NAME = ~"reg_avec_mode~" TYPE = number) " arguments=(("nocode", number),("cle", number),("reg_avec_mode", number))  sort="date A tp D dateremise A " )
