table(column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code dbname="ecole.code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce Code doit être obligatoirement saisi~"" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="ecole.nom" initial=" " )
 column=(type=char(30) update=yes updatewhereclause=yes name=adr1 dbname="ecole.adr1" )
