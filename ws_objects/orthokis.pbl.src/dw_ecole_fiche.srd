 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ecole~" ) COLUMN(NAME=~"ecole.code~") COLUMN(NAME=~"ecole.nom~") COLUMN(NAME=~"ecole.adr1~") COLUMN(NAME=~"ecole.adr2~") COLUMN(NAME=~"ecole.codep~") COLUMN(NAME=~"ecole.ville~") COLUMN(NAME=~"ecole.tel~") COLUMN(NAME=~"ecole.fax~") COLUMN(NAME=~"ecole.contact1~") COLUMN(NAME=~"ecole.contact2~") COLUMN(NAME=~"ecole.commentaires~") COLUMN(NAME=~"ecole.pays~") COLUMN(NAME=~"ecole.actif~") COLUMN(NAME=~"ecole.ordre_trie~")WHERE(    EXP1 =~"~~~"ecole~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code~" ) ) ARG(NAME = ~"var_code~" TYPE = string) " update="ecole" updatewhere=0 updatekeyinplace=yes arguments=(("var_code", string)) )
