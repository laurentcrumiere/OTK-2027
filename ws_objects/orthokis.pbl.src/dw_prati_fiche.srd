table(column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code dbname="prati.code" initial="      " validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="prati.nom" )
 column=(type=char(3) update=yes updatewhereclause=yes name=typort dbname="prati.typort" initial="TO" values="TO	TO/ORT	ORT/" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=pxcons dbname="prati.pxcons" validation="double(gettext())>=0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=sc dbname="prati.sc" validation="double(gettext())>=0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=char(26) update=yes updatewhereclause=yes name=rib dbname="prati.rib" )
 column=(type=char(50) update=yes updatewhereclause=yes name=ident dbname="prati.ident" )
 column=(type=char(50) update=yes updatewhereclause=yes name=banq1 dbname="prati.banq1" )
 column=(type=char(50) update=yes updatewhereclause=yes name=banq2 dbname="prati.banq2" )
 column=(type=char(6) update=yes updatewhereclause=yes name=pasfin dbname="prati.pasfin" )
 column=(type=char(6) update=yes updatewhereclause=yes name=pasreg dbname="prati.pasreg" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=radio dbname="prati.radio" validation="double(gettext())>=0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=char(80) update=yes updatewhereclause=yes name=entete dbname="prati.entete" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=cadre_entete dbname="prati.cadre_entete" values="Aucun	0/Ombré	1/Rectangle	2/Ligne	4/3D en creux	5/3D en relief	6/" )
 column=(type=char(80) update=yes updatewhereclause=yes name=bas_page dbname="prati.bas_page" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=cadre_bas_page dbname="prati.cadre_bas_page" values="Aucun	0/Ombré	1/Rectangle	2/Ligne	4/3D en creux	5/3D en relief	6/" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=hn dbname="prati.hn" validation="double(gettext())>=0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=char(54) update=yes updatewhereclause=yes name=nom_carte_cps dbname="prati.nom_carte_cps" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_defaut dbname="prati.prati_defaut" initial="0" )
 column=(type=char(6) update=yes updatewhereclause=yes name=banque dbname="prati.banque" )
 column=(type=char(500) update=yes updatewhereclause=yes name=chemin_complet_entete dbname="prati.chemin_complet_entete" )
 column=(type=char(500) update=yes updatewhereclause=yes name=chemin_complet_bas_page dbname="prati.chemin_complet_bas_page" )
 column=(type=long update=yes updatewhereclause=yes name=actif dbname="prati.actif" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=ordre_trie dbname="prati.ordre_trie" initial="100" )
 column=(type=long update=yes updatewhereclause=yes name=cpt_mail dbname="prati.cpt_mail" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=institution_perceptrice dbname="prati.institution_perceptrice" )
 column=(type=char(6) update=yes updatewhereclause=yes name=specialite dbname="prati.specialite" )
 column=(type=char(1) update=yes updatewhereclause=yes name=barre_afficher_code dbname="prati.barre_afficher_code" initial="N" values="Afficher le code praticien dans les fenêtres principales	O/Afficher le code praticien dans les fenêtres principales	N" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=barre_couleur_code dbname="prati.barre_couleur_code" initial="0" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=nom_structure dbname="prati.nom_structure" )
 column=(type=char(200) update=yes updatewhereclause=yes name=duree_validite_devis dbname="prati.duree_validite_devis" )
 column=(type=char(20) update=yes updatewhereclause=yes name=numero_structure dbname="prati.numero_structure" )
 column=(type=char(20) update=yes updatewhereclause=yes name=identifiant_rpps dbname="prati.identifiant_rpps" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=delai_mdp_financier dbname="prati.delai_mdp_financier" initial="7" )
 column=(type=char(1) update=yes updatewhereclause=yes name=convention_secu dbname="prati.convention_secu" values="Conventionné	1/Conventionné avec Dépassement	2/Conventionné avec Honoraires Libres	3/Non Conventionné	0/" )
 column=(type=char(20) update=yes updatewhereclause=yes name=code_comptable dbname="prati.code_comptable" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nom_remplacant dbname="prati.nom_remplacant" )
 column=(type=char(30) update=yes updatewhereclause=yes name=identifiant_remplacant dbname="prati.identifiant_remplacant" )
 column=(type=char(500) update=yes updatewhereclause=yes name=chemin_complet_logo dbname="prati.chemin_complet_logo" )
 column=(type=char(500) update=yes updatewhereclause=yes name=chemin_complet_signature dbname="prati.chemin_complet_signature" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prati~" ) COLUMN(NAME=~"prati.code~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.typort~") COLUMN(NAME=~"prati.pxcons~") COLUMN(NAME=~"prati.sc~") COLUMN(NAME=~"prati.rib~") COLUMN(NAME=~"prati.ident~") COLUMN(NAME=~"prati.banq1~") COLUMN(NAME=~"prati.banq2~") COLUMN(NAME=~"prati.pasfin~") COLUMN(NAME=~"prati.pasreg~") COLUMN(NAME=~"prati.radio~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"prati.cadre_bas_page~") COLUMN(NAME=~"prati.hn~") COLUMN(NAME=~"prati.nom_carte_cps~") COLUMN(NAME=~"prati.prati_defaut~") COLUMN(NAME=~"prati.banque~") COLUMN(NAME=~"prati.chemin_complet_entete~") COLUMN(NAME=~"prati.chemin_complet_bas_page~") COLUMN(NAME=~"prati.actif~") COLUMN(NAME=~"prati.ordre_trie~") COLUMN(NAME=~"prati.cpt_mail~") COLUMN(NAME=~"prati.institution_perceptrice~") COLUMN(NAME=~"prati.specialite~") COLUMN(NAME=~"prati.barre_afficher_code~") COLUMN(NAME=~"prati.barre_couleur_code~") COLUMN(NAME=~"prati.nom_structure~") COLUMN(NAME=~"prati.duree_validite_devis~") COLUMN(NAME=~"prati.numero_structure~") COLUMN(NAME=~"prati.identifiant_rpps~") COLUMN(NAME=~"prati.delai_mdp_financier~") COLUMN(NAME=~"prati.convention_secu~") COLUMN(NAME=~"prati.code_comptable~") COLUMN(NAME=~"prati.nom_remplacant~") COLUMN(NAME=~"prati.identifiant_remplacant~") COLUMN(NAME=~"prati.chemin_complet_logo~") COLUMN(NAME=~"prati.chemin_complet_signature~")WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":codpra~" ) ) ARG(NAME = ~"codpra~" TYPE = string) " update="prati" updatewhere=0 updatekeyinplace=yes arguments=(("codpra", string)) )
