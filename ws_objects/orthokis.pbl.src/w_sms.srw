forward prototypes
public subroutine ajouter_patient (double v_code_patient, string v_type_code, string v_type_nom, datetime v_rdv, string v_code_message, string v_prati_code, double v_code_interne_rdv, string v_type_sms)
public subroutine generation_envoi (string type_envoi)
end prototypes

public subroutine ajouter_patient (double v_code_patient, string v_type_code, string v_type_nom, datetime v_rdv, string v_code_message, string v_prati_code, double v_code_interne_rdv, string v_type_sms);// On va ajouter autant de ligne que nécessaire, selon la configuration de la fiche patient
//--------------------------------------------------------------------------------------------------------

string v_nom, v_prenom, v_parent, v_prati_nom, v_titre_patient
date v_date_naissance
long lig, lig2


// pour les SMS
string v_portable_patient_sms ,   v_portable_sms ,   v_portable2_parent1_sms , 	v_portable1_parent2_sms , 	v_portable2_parent2_sms ,  v_portable1_payeur_sms ,  v_portable2_payeur_sms 
string v_portable_patient,   v_portable ,   v_portable2_parent1 , 	v_portable1_parent2 , 	v_portable2_parent2 ,  v_portable1_payeur ,  v_portable2_payeur 

integer cpt_sms, nb_sms

string numeros_sms[]

string nature_numero[]	// servira à compléter le code du rdv pour éviter les doublons
// p : patient - p11, P12 : portables 1 et 2 du parent1, p21, P22 : idem pour parent2, p31, p32 : idem pour payeur

string v_id_new_message, v_id_unique_message
		  

// Recherche des éléments fixes de la fiche patient 

select nom, prenom, date_naissance, nom_parent1 into :v_nom, :v_prenom, :v_date_naissance, :v_parent 
from patient where code = :v_code_patient ;

select nom into :v_prati_nom from prati where code = :v_prati_code ;

select isnull(titre_personnes.nom,'') into :v_titre_patient from titre_personnes, patient 
where patient.code = :v_code_patient and patient.titre_patient = titre_personnes.code ;

// Recherche des éléments liés à la config des SMS ...
select 	portable_patient_sms ,   		portable_sms ,   			portable2_parent1_sms , 	portable1_parent2_sms , 
  			portable2_parent2_sms ,  	portable1_payeur_sms ,  portable2_payeur_sms , 
			portable_patient,   portable ,   portable2_parent1 , 	portable1_parent2 , 	
			portable2_parent2 ,  portable1_payeur ,  portable2_payeur

into  :v_portable_patient_sms ,   :v_portable_sms ,   :v_portable2_parent1_sms , 	:v_portable1_parent2_sms , 
	:v_portable2_parent2_sms ,  :v_portable1_payeur_sms ,  :v_portable2_payeur_sms ,
	:v_portable_patient,   :v_portable ,   :v_portable2_parent1 , 	:v_portable1_parent2 , 	
	:v_portable2_parent2 ,  :v_portable1_payeur ,  :v_portable2_payeur 

from patient where code = :v_code_patient ;

nb_sms = 0

// Depuis 32.00c on ne prend en compte que les N° de puis de 6 chiffres !

// Le portable de l'enfant ?
if len(trim(v_portable_patient)) > 6 and (v_portable_patient_sms = 'O' or v_portable_patient_sms = '?') then
	nb_sms = nb_sms + 1
	numeros_sms[nb_sms] = v_portable_patient
	nature_numero[nb_sms] = 'P'
end if

// Le portable du parent1 ?
if len(trim(v_portable)) > 6 and (v_portable_sms = 'O' or (v_portable_sms = '?' and nb_sms = 0)) then
	nb_sms = nb_sms + 1
	numeros_sms[nb_sms] = v_portable
	nature_numero[nb_sms] = 'P11'
end if

// Le portable 2 du parent1 ?
if len(trim(v_portable2_parent1)) > 6 and (v_portable2_parent1_sms = 'O' or (v_portable2_parent1_sms = '?' and nb_sms = 0)) then
	nb_sms = nb_sms + 1
	numeros_sms[nb_sms] = v_portable2_parent1
	nature_numero[nb_sms] = 'P12'
end if

// Plus de mode automatique à partir de là
//--------------------------------------------------

// Le portable 1 du parent2 ?
if len(trim(v_portable1_parent2)) > 6 and v_portable1_parent2_sms = 'O'  then
	nb_sms = nb_sms + 1
	numeros_sms[nb_sms] = v_portable1_parent2
	nature_numero[nb_sms] = 'P21'
end if
// Le portable 2 du parent2 ?
if len(trim(v_portable2_parent2)) > 6 and v_portable2_parent2_sms = 'O'  then
	nb_sms = nb_sms + 1
	numeros_sms[nb_sms] = v_portable2_parent2
	nature_numero[nb_sms] = 'P22'
end if

// Le portable 1 du payeur ?
if len(trim(v_portable1_payeur)) > 6 and v_portable1_payeur_sms = 'O'  then
	nb_sms = nb_sms + 1
	numeros_sms[nb_sms] = v_portable1_payeur
	nature_numero[nb_sms] = 'P31'
end if
// Le portable 2 du parent2 ?
if len(trim(v_portable2_payeur)) > 6 and v_portable2_payeur_sms = 'O'  then
	nb_sms = nb_sms + 1
	numeros_sms[nb_sms] = v_portable2_payeur
	nature_numero[nb_sms] = 'P32'
end if



// Génération de la liste

for cpt_sms = 1 to nb_sms

	dw_liste.insertrow(0)
	lig = dw_liste.rowcount()
	dw_liste.setitem(lig, "nom_patient", v_nom)
	dw_liste.setitem(lig, "prenom_patient", v_prenom)
	dw_liste.setitem(lig, "date_naissance", v_date_naissance)
	dw_liste.setitem(lig, "nom_parent", v_parent)
	dw_liste.setitem(lig, "portable", numeros_sms[cpt_sms])
	dw_liste.setitem(lig, "type_rdv_code", v_type_code)
	dw_liste.setitem(lig, "type_rdv_nom", v_type_nom)
//	dw_liste.setitem(lig, "rdv", v_rdv)
	dw_liste.setitem(lig, "rdv", string(v_rdv, "dd/mm/yyyy hh:mm:ss"))
	dw_liste.setitem(lig, "code_praticien", v_prati_code)
	dw_liste.setitem(lig, "nom_praticien", v_prati_nom)
	dw_liste.setitem(lig, "code_message", v_code_message)
	dw_liste.setitem(lig, "dms_id", string(v_code_patient))
	dw_liste.setitem(lig, "civilite_patient", v_titre_patient)
	dw_liste.SetItem(lig, "cle_rdv", string(v_code_interne_rdv ))


	// ajout dans l'historique au cas ou envoi automatique !!!
	dw_maj_histo.insertrow(0)
	lig2 = dw_maj_histo.rowcount()
	dw_maj_histo.SetItem(lig2, "code_patient", v_code_patient)
	dw_maj_histo.SetItem(lig2, "numero_envoi", numeros_sms[cpt_sms])
	dw_maj_histo.SetItem(lig2, "type_sms", v_type_sms)
	dw_maj_histo.SetItem(lig2, "date_envoi", datetime(today(), now()))
	dw_maj_histo.SetItem(lig2, "code_praticien", v_prati_code)
	dw_maj_histo.SetItem(lig2, "code_message", v_code_message)

	v_id_new_message = uo_poc.get_id_new_message()+string(lig)

	if v_type_sms = "R" or v_type_sms = "B" then
		// rappel de rendez-vous et rendez vous absent => on prend le code interne de RDV pour ne garder qu'une 
		v_id_unique_message =  v_type_sms + string(v_code_interne_rdv ) + nature_numero[cpt_sms]
		
		dw_liste.setitem(lig, "rdv_id", v_id_unique_message)
		dw_maj_histo.SetItem(lig2, "id_message_pocket",v_id_unique_message)
		dw_maj_histo.SetItem(lig2, "date", date(v_rdv))
	else
		v_id_unique_message = v_id_new_message + nature_numero[cpt_sms]
		dw_liste.setitem(lig, "rdv_id", v_id_unique_message)
		dw_maj_histo.SetItem(lig2, "id_message_pocket", v_id_unique_message)
	end if
	

	 
	
next	
				
return
end subroutine

public subroutine generation_envoi (string type_envoi);// Type envoi vaut
// A pour envoi automatique
// M pour envoi manuel


// Type de message :
// R : rappel de rendez-vous
// B : Absence à un rendez-vous
// U : sms unitaire
// C : recontact de patient
// A : Anniversaire

dw_liste.reset()



// fourchettes de dates et de prat
date da1, da2
string prat1, prat2



if rb_un.checked then 
	prat1 = dw_prati.gettext()
	prat2 = prat1
else
	prat1 = '      '
	prat2 = 'ZZZZZZ'
end if


string v_nom, v_prenom,v_parent, v_portable, v_type_code, v_type_nom, v_prati_code, v_prati_nom, v_cmu
date v_date_naissance
string v_adulte

datetime v_rdv
long v_message
long lig, tot

double v_min, v_max, v_code, v_code_interne_rdv
double v_numero_dossier_min, v_numero_dossier_max
string v_dos_min, v_dos_max
string str_message, v_id_pocket
string v_email_patient, v_email_parent1


boolean v_suite
long nb_rdv
integer li_cpt


open(w_patience)

// RAPPEL DE RENDEZ-VOUS
//--------------------------------------------------------------------------------------------------------------------
if cbx_rdv.checked then

	da1 = date(em_date_rdv_min.text)
	da2 = date(em_date_rdv_max.text)

	// recherche des rendez-vous
	// On enlève les rendez-vous qui ne sont pas dans l'agenda (etat de rdv)
	declare cur_rdv cursor for  
	select 	patient.code, 
				patient.nom, 
				patient.prenom , 
				patient.date_naissance, 
				patient.nom_parent1, 
				isnull(patient.portable_patient, patient.portable, patient.portable2_parent1) , 
				rdv."type", 
				type_rdv.nom, 
				rdv.rdv, rdv.code_praticien  , 
				prati.nom , 
				type_rdv.message_sms , 
				rdv.code_interne, 
				isnull(patient.email_patient, ''),
				isnull(patient.email, '')
	
	from patient, rdv, type_rdv , prati , etat_rdv 
	where prati.code = rdv.code_praticien and type_rdv.code = rdv.type and 
	patient.code = rdv.code and cast (rdv.rdv as date)  between :da1 and :da2 and rdv.code_praticien between :prat1 and :prat2 and 
	type_rdv.envoi_sms = 'O' and etat_rdv.code = rdv.absent and etat_rdv.elimine_agenda <> 'O' and patient.envoi_sms = 'O' 
	order by rdv.rdv, patient.nom, patient.prenom ;
	
	open cur_rdv ;
	
	fetch cur_rdv into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message, :v_code_interne_rdv, :v_email_patient, :v_email_parent1 ;
	
	
	do while sqlca.sqlcode = 0
		
		
		v_suite = true
		
		// Elimination ou pas selon email
		if (cbx_rdv_eliminer_email_patient.checked and v_email_patient <> "") or (cbx_rdv_eliminer_email_parent1.checked and v_email_parent1 <> "") then
			v_suite = false
		else
			// Elimination si présent est dans téa 
			if TEA and cbx_eliminer_tea.checked then 
				select isnull(count(*), 0) into :li_cpt from patient_mon_orthodontiste where code = :v_code ;
				if li_cpt > 0 then 
					v_suite = false
				end if
			end if
		end if
				
		if v_suite then
			ajouter_patient (v_code, v_type_code, v_type_nom, v_rdv,   "R"+string(v_message), v_prati_code , v_code_interne_rdv, 'R' )
		end if
		
		
		fetch cur_rdv into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message, :v_code_interne_rdv, :v_email_patient, :v_email_parent1 ;

	loop
	
	
	close cur_rdv ;

end if

// RECHERCHE DES ANNIVERSAIRES
//--------------------------------------------------------------------------------------------------------------------
if cbx_anniversaire.checked and not PLANIFICATION_EN_COURS then
	
	v_min = double(em_min.text)
	v_max = double(em_max.text)
	
	da1 = date(em_date_anni_min.text)
	da2 = date(em_date_anni_max.text)
	
	if rb_tous_dos.checked then
		v_dos_min="  "
		v_dos_max="ZZZZZ"
	else
		v_dos_min =dw_dossier.getitemstring(dw_dossier.getrow(),"code")
		v_dos_max = v_dos_min
	end if
	
	// pour la date minimale de l'anniv, on recule d'un jour pour bien le prendre en compte
	da1 = RelativeDate(da1, -1)
	long delai_min, delai_max, delai_temp
	long delai_1, delai_2, delai_3, delai_4

	delai_min = month(da1) * 100 + day(da1)
	delai_max = month(da2) * 100 + day(da2)
	
	
	// Gestion des cas ou la date max et sur l'année N+1
	if year(da1) = year(da2) then
		delai_1 = delai_min
		delai_2 = delai_max
		// pour que la 2ème condition soit fausse
		delai_3 = delai_max
		delai_4 = delai_min
	else
		if year(da1) + 1 = year(da2) then
			// année n+1
			delai_1 = delai_min
			delai_2 = 1231
			delai_3 = 0101
			delai_4 = delai_max
		else
			// année n+2 ou + => tous les patients !!!
			delai_1 = 0101
			delai_2 = 1231
			delai_3 = 0101
			delai_4 = 1231
		end if
	end if


	declare cur_anni cursor for select 	patient.code, 
												patient.nom, 
												patient.prenom , 
												patient.date_naissance, 
												patient.nom_parent1, 
												isnull(patient.portable_patient, patient.portable, patient.portable2_parent1) , 
												null, 
												null, 
												null, 
												patient.code_praticien  , 
												prati.nom , 
												null  ,
												patient.adulte 
	from patient, prati 
	where prati.code = patient.code_praticien 
	and ( (month("patient"."date_naissance") * 100 + day("patient"."date_naissance") between :delai_1 and :delai_2 )   or (month("patient"."date_naissance") * 100 + day("patient"."date_naissance") between :delai_3 and :delai_4 ) )
	and patient.code_praticien between :prat1 and :prat2  and patient.numero_dossier between :v_min and :v_max 
	and type_dossier between :v_dos_min and :v_dos_max and patient.envoi_sms = 'O' 
	order by patient.nom, patient.prenom ;
	
	
	open cur_anni ;
	
	fetch cur_anni into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message, :v_adulte ;
	
	
	do while sqlca.sqlcode = 0
		
		if cbx_eliminer_adultes.checked and v_adulte = "O" then
			// On le prend pas
		else
			ajouter_patient (v_code, v_type_code, v_type_nom, v_rdv,   "A" , v_prati_code, 0 , "A" )
		end if

		fetch cur_anni into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message, :v_adulte ;
	loop
	
	
	close cur_anni ;
end if


// ENVOI D'UN SMS A TOUS LES PATIENTS
//--------------------------------------------------------------------------------------------------------------------
if cbx_envoi_tous.checked and not PLANIFICATION_EN_COURS then
	
	str_message = trim(sle_code_message_envoi_tous.text)

	if len(str_message) > 0 then
		v_min = double(em_min_tous.text)
		v_max = double(em_max_tous.text)
		
	
		if rb_tous_dos_tous.checked then
			v_dos_min="  "
			v_dos_max="ZZZZZ"
		else
			v_dos_min =dw_dossier_tous.getitemstring(dw_dossier_tous.getrow(),"code")
			v_dos_max = v_dos_min
		end if
		
		
		
		declare cur_envoi_tous cursor for select	patient.code, 
															patient.nom, 
															patient.prenom , 
															patient.date_naissance, 
															patient.nom_parent1, 
															isnull(patient.portable_patient, patient.portable, patient.portable2_parent1) , 
															null, 
															null, 
															null, 
															patient.code_praticien  , 
															prati.nom , 
															null  , 
															mise_en_evidence 
		from patient, prati 
		where prati.code = patient.code_praticien 
		and patient.code_praticien between :prat1 and :prat2  and patient.numero_dossier between :v_min and :v_max 
		and type_dossier between :v_dos_min and :v_dos_max and patient.envoi_sms = 'O' 
		order by patient.nom, patient.prenom ;
		
		
		open cur_envoi_tous ;
		
		fetch cur_envoi_tous into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message , :v_cmu;
		
		
		do while sqlca.sqlcode = 0
			
			if v_cmu = "C" then 
				// Patient CMU 
				if cbx_cmu.checked then
					ajouter_patient (v_code, v_type_code, v_type_nom, v_rdv,   str_message , v_prati_code, 0  , "T")
				end if
			else
				if v_cmu  = "M" then
					// MGEN
					if cbx_mgen.checked then 
						ajouter_patient (v_code, v_type_code, v_type_nom, v_rdv,   str_message , v_prati_code, 0 , "T" )
					end if
				else
					if cbx_autres.checked then
						ajouter_patient (v_code, v_type_code, v_type_nom, v_rdv,   str_message , v_prati_code, 0 , "T" )
					end if
				end if
			end if

							

			fetch cur_envoi_tous into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message, :v_cmu ;
		loop
		
		
		close cur_envoi_tous ;
	else
		
		if not PLANIFICATION_EN_COURS then
			// En principe pas possible mais ...
			Messagebox("ATTENTION !","Vous n'avez pas indiqué de code de message pour l'envoi à tous les patients.~n~nCet envoi n'a pas été généré !")
		end if

	end if
end if






// ABSENCE A UN RDV
//--------------------------------------------------------------------------------------------------------------------
if cbx_absent_rdv.checked then
	

	str_message = trim(sle_code_message_absent.text)

	
	if len(str_message) > 0 then
	
	
		//Etat
		string v_etat
		v_etat = dw_etat.gettext()
	
		boolean ajout
		integer cpt
		
		
		da1 = date(em_date_absent_min.text)
		da2 = date(em_date_absent_max.text)

		v_numero_dossier_min = double(em_min_absent.text)
		v_numero_dossier_max = double(em_max_absent.text)


		// recherche des rendez-vous
		// On enlève les rendez-vous qui ne sont pas dans l'agenda (etat de rdv)
		declare cur_rdv_absent cursor for  select 	patient.code , 
																patient.nom, 
																patient.prenom , 
																patient.date_naissance, 
																patient.nom_parent1, 
																isnull(patient.portable_patient, patient.portable, patient.portable2_parent1) , 
																rdv."type", 
																type_rdv.nom, 
																rdv.rdv, 
																rdv.code_praticien  , 
																prati.nom , 
																type_rdv.message_sms ,
																rdv.code_interne
		from patient, rdv, type_rdv , prati 
		where prati.code = rdv.code_praticien and type_rdv.code = rdv.type and 
		patient.code = rdv.code and cast (rdv.rdv as date)  between :da1 and :da2 and rdv.code_praticien between :prat1 and :prat2 and 
		 rdv.absent = :v_etat  and patient.envoi_sms = 'O'  and patient.numero_dossier between :v_numero_dossier_min and :v_numero_dossier_max

		order by rdv.rdv, patient.nom, patient.prenom ;

	
	
		open cur_rdv_absent ;
	
		fetch cur_rdv_absent into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message, :v_code_interne_rdv ;
	
	
		do while sqlca.sqlcode = 0
			
			ajout = true
			if cbx_next.checked then
				// On élimine ceux qui ont un rdv dans le futur
				cpt = 0
				select count(*) into :cpt 
				from rdv, etat_rdv 
				where rdv.code = :v_code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' and cast (rdv.rdv as date)  > cast(getdate() as date) ; 
				if cpt > 0 then
					ajout = false
				end if
			end if
			if cbx_next.checked then
				// On élimine ceux qui ont un rdv postérieur au rdv absent .. dans le passé
				cpt = 0
				select count(*) into :cpt 
				from rdv, etat_rdv 
				where rdv.code = :v_code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' and rdv.rdv > :v_rdv and cast (rdv.rdv as date)  < cast(getdate() as date) ; 
				if cpt > 0 then
					ajout = false
				end if
			end if
			
			if ajout then
				
				ajouter_patient (v_code, v_type_code, v_type_nom, v_rdv,   str_message , v_prati_code, v_code_interne_rdv , "B" )

			end if
			
			fetch cur_rdv_absent into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message, :v_code_interne_rdv ;
		loop
		
		
		close cur_rdv_absent ;
		
	

	else
		if not PLANIFICATION_EN_COURS then
			Messagebox("ATTENTION !","Vous n'avez pas indiqué de code de message pour l'absence à un rendez-vous.~n~nCet envoi n'a pas été généré !")
		end if
	end if
end if




// PATIENTS A RECONTACTER
//--------------------------------------------------------------------------------------------------------------------
if cbx_patients_a_recontacter.checked and not PLANIFICATION_EN_COURS then
	

	str_message = trim(sle_code_message_recontact.text)

	
	if len(str_message) > 0 then
		
		v_min = double(em_min_recontact.text)
		v_max = double(em_max_recontact.text)
	
		da1 = date(em_date_recontact_min.text)
		da2 = date(em_date_recontact_max.text)
	
	if rb_tous_recontact.checked then
		v_dos_min="  "
		v_dos_max="ZZZZZ"
	else
		v_dos_min =dw_dossier_recontact.getitemstring(dw_dossier_recontact.getrow(),"code")
		v_dos_max = v_dos_min
	end if
	
	
	
	declare cur_recontact cursor for select 	patient.code, 
												patient.nom, 
												patient.prenom , 
												patient.date_naissance, 
												patient.nom_parent1, 
												isnull(patient.portable_patient, patient.portable, patient.portable2_parent1) , 
												null, 
												null, 
												null, 
												patient.code_praticien  , 
												prati.nom , 
												null  
	from patient, prati 
	where prati.code = patient.code_praticien and patient.relance between :da1 and :da2  
	and patient.code_praticien between :prat1 and :prat2  and patient.numero_dossier between :v_min and :v_max 
	and type_dossier between :v_dos_min and :v_dos_max and patient.envoi_sms = 'O' 
	order by patient.nom, patient.prenom ;
	
	
	open cur_recontact ;
	
	fetch cur_recontact into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message ;
	
	
	do while sqlca.sqlcode = 0
		
		v_suite = true
		
		if cbx_eliminer_recontact.checked then
		
			nb_rdv = 0
			SELECT count(*) into :nb_rdv FROM rdv, etat_rdv  WHERE cast(rdv as date) >= cast(getdate() as date) and rdv.code = :v_code 
			and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O'  ;

			if nb_rdv > 0 then
				v_suite = false
			end if
		end if
		
		if v_suite then
			
			// On va rechercher dans date du dernier RDV pour la passer en infos
			SELECT rdv into :v_rdv FROM rdv, etat_rdv  WHERE cast(rdv as date) < cast(getdate() as date) and rdv.code = :v_code 
			and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O'  ;
			
			// On recherche aussi la date de recontact prévue .. on se sert du type de rdv pour passer le paramètre
			SELECT string(dateformat(patient.relance,'dd/mm/yyyy'))  into :v_type_nom FROM patient  WHERE code = :v_code  ;
			
			ajouter_patient (v_code, v_type_code, v_type_nom, v_rdv,   str_message , v_prati_code , 0, "C" )
		end if

		fetch cur_recontact into :v_code, :v_nom, :v_prenom, :v_date_naissance, :v_parent, :v_portable, :v_type_code, :v_type_nom, :v_rdv, :v_prati_code, :v_prati_nom, :v_message ;
	loop
	
	
	close cur_recontact ;

		
		
	

	else
		if not PLANIFICATION_EN_COURS then
			// En principe pas possible mais ...
			Messagebox("ATTENTION !","Vous n'avez pas indiqué de code de message pour le recontact des patients.~n~nCet envoi n'a pas été généré !")
		end if
	end if
end if


close(w_patience)


//---------------------------------------------------------------------------------------------------------------------------------------------



// Fichier text
if dw_liste.rowcount() > 0 then
	if dw_liste.saveas(sle_fichier.text,  text!  , true    ) = 1 then

		
		// A la fin, mémorisation des infos dans le fichie Orthokis.ini .. sauf si on est en planificateur de tache !!!
		
		if not PLANIFICATION_EN_COURS then
			if cbx_rdv.checked then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","RDV","true")
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","RDV","false")
			end if
			
			if cbx_rdv_eliminer_email_patient.checked then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","RDV_eliminer_email_patient","true") 
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","RDV_eliminer_email_patient","false") 
			end if
			
			if cbx_rdv_eliminer_email_parent1.checked then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","RDV_eliminer_email_parent1","true") 
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","RDV_eliminer_email_parent1","false") 
			end if
	
	
			if cbx_eliminer_tea.checked then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","RDV_eliminer_tea","true") 
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","RDV_eliminer_tea","false") 
			end if
			
			if cbx_anniversaire.checked  then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Anniversaire", "true")
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Anniversaire", "false")
			end if
			
	
			
			if cbx_patients_a_recontacter.checked  then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Recontact", "true")
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Recontact", "false")
			end if
			if cbx_envoi_tous.checked  then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Envoi_Tous", "true")
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Envoi_Tous", "false")
			end if
			if cbx_absent_rdv.checked  then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Absents", "true")
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Absents", "false")
			end if
			
			Setprofilestring(dir_ini+inifile_orthokis,"SMS","Absents_etat", dw_etat.gettext())
			if cbx_next.checked  then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Absents_next", "true")
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Absents_next", "false")
			end if
			if cbx_next_2.checked  then
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Absents_next_2", "true")
			else
				Setprofilestring(dir_ini+inifile_orthokis,"SMS","Absents_next_2", "false")
			end if
			
			Setprofilestring(dir_ini+inifile_orthokis,"SMS","Fichier",sle_fichier.text)
			Setprofilestring(dir_ini+inifile_orthokis,"SMS","code_message_envoi_tous",sle_code_message_envoi_tous.text)
			Setprofilestring(dir_ini+inifile_orthokis,"SMS","code_message_absent",sle_code_message_absent.text)
			Setprofilestring(dir_ini+inifile_orthokis,"SMS","code_message_recontact",sle_code_message_recontact.text)
		end if
		


		if type_envoi = 'M' then 
			// envoi manuel  ... on s'arrête là !

			if not PLANIFICATION_EN_COURS then
				// En principe pas possible mais ...
				Messagebox("ATTENTION !","Le fichier a été correctement généré !")
			end if
		else
			
			if uo_poc.update_planning(sle_fichier.text, true) = 1 then
				// On élimine de l'historique les SMS qui concerne des Rappels de RDV ou des RDV abents de cet envoi
				dw_maj_histo.setfilter("type_sms = 'R' or type_sms = 'B'")
				dw_maj_histo.filter()

				tot = dw_maj_histo.rowcount()
				for lig = 1 to tot
					v_id_pocket = dw_maj_histo.GetItemString(lig, "id_message_pocket")
					delete from historique_sms where id_message_pocket = :v_id_pocket ;
				next
				
				// ne fera le commit que si la MAJ de la DW est OK !
				
				// Enregistrement de l'historique 
				dw_maj_histo.setfilter("")
				dw_maj_histo.filter()
				
				// Pour rappels de rendez-vous, il faut supprimer les précédents envoi ...
				if dw_maj_histo.update() = 1 then
					commit ;
				else
					rollback ;
					if not PLANIFICATION_EN_COURS then
						Messagebox("ATTENTION","Une erreur s'est produite dans la mise à jour de l'historique de l'envoi des SMS.")
					else
						fxg_ajout_journal_planification("SMS", "Une erreur s'est produite dans la mise à jour de l'historique de l'envoi des SMS")
					end if 
				end if
					
			end if
		end if
	else
		if not PLANIFICATION_EN_COURS then
			Messagebox("ATTENTION !","Erreur dans la génération du fichier !~n~nVeuillez vérifier les nom et chemin du fichier et renouveler l'opération.")
		else
			fxg_ajout_journal_planification("SMS", "Erreur dans la génération du fichier !")
		end if
	end if
else
	if not PLANIFICATION_EN_COURS then
		Messagebox("ATTENTION !","Il y a aucun éléments pour ces critères !")
	else
			fxg_ajout_journal_planification("SMS", "Il y a aucun éléments pour les critères demandés")
	end if
end if



end subroutine

