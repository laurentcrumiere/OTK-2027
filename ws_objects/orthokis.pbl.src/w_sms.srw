event open;call super::open;
open(w_patience)

uo_resize.taille(this)


dw_prati.settransobject(sqlca)
dw_prati.retrieve()

dw_etat.settransobject(sqlca)
dw_etat.retrieve()


dw_dossier.settransobject(sqlca)
dw_dossier.retrieve()
dw_dossier_tous.settransobject(sqlca)
dw_dossier_tous.retrieve()
dw_dossier_recontact.settransobject(sqlca)
dw_dossier_recontact.retrieve()

dw_code_sms.settransobject(sqlca)

// Lecture des informations par défaut dans Orthokis.ini

if profilestring(dir_ini+inifile_orthokis,"SMS","RDV","true") = "true" then
	cbx_rdv.checked = true
else
	cbx_rdv.checked = false
end if

if profilestring(dir_ini+inifile_orthokis,"SMS","RDV_eliminer_email_patient","false") = "true" then
	cbx_rdv_eliminer_email_patient.checked = true
else
	cbx_rdv_eliminer_email_parent1.checked = false
end if
if profilestring(dir_ini+inifile_orthokis,"SMS","RDV_eliminer_email_parent1","false") = "true" then
	cbx_rdv_eliminer_email_parent1.checked = true
else
	cbx_rdv_eliminer_email_parent1.checked = false
end if

if version_ce_logiciel >= "36.90" then 
	if TEA then
		cbx_eliminer_tea.visible = true
		if profilestring(dir_ini+inifile_orthokis,"SMS","RDV_eliminer_tea","false") = "true" then
			cbx_eliminer_tea.checked = true
		else
			cbx_eliminer_tea.checked = false
		end if
	end if
end if
	

if profilestring(dir_ini+inifile_orthokis,"SMS","Anniversaire","true") = "true" then
	cbx_anniversaire.checked = true
else
	cbx_anniversaire.checked = false
end if

if Profilestring(dir_ini+inifile_orthokis,"SMS","Recontact", "false") = "true" then
	cbx_patients_a_recontacter.checked  = true
else
	cbx_patients_a_recontacter.checked  = false
end if

if Profilestring(dir_ini+inifile_orthokis,"SMS","Envoi_Tous", "false") = "true" then
	cbx_envoi_tous.checked = true
else
	cbx_envoi_tous.checked = false
end if
if Profilestring(dir_ini+inifile_orthokis,"SMS","Absents", "false") = "true" then
	cbx_absent_rdv.checked = true
else
	cbx_absent_rdv.checked = false
end if


profilestring(dir_ini+inifile_orthokis,"SMS","Absents_etat", dw_etat.gettext())

string v_find 
v_find =  "code = '"+	profilestring(dir_ini+inifile_orthokis,"SMS","Absents_etat", dw_etat.gettext()) +"'"
dw_etat.ScrollToRow(dw_etat.Find(v_find ,1,999))

			
if profilestring(dir_ini+inifile_orthokis,"SMS","Absents_next", "true") = "true" then
	cbx_next.checked  = true
else
	cbx_next.checked  = false
end if
if profilestring(dir_ini+inifile_orthokis,"SMS","Absents_next_2", "true") = "true" then
	cbx_next_2.checked  = true
else
	cbx_next_2.checked  = false
end if



long max , min

SELECT min(numero_dossier), max(numero_dossier) INTO :min, :max FROM patient WHERE numero_dossier < 100000000 ;

em_max.text = string(max)
em_max_tous.text = em_max.text
em_max_absent.text = em_max.text
em_max_recontact.text = em_max.text


// pour le recontacts, on prend les négatifs
em_min_recontact.text = string(min)
// pour les absents aussi
em_min_absent.text = string(min)


// Code d'envoi de message à tous les patients
sle_code_message_envoi_tous.text =  profilestring(dir_ini+inifile_orthokis,"SMS","code_message_envoi_tous","")
// Code d'envoi de message aux absents
sle_code_message_absent.text =  profilestring(dir_ini+inifile_orthokis,"SMS","code_message_absent","")
// Code d'envoi de message aux absents
sle_code_message_recontact.text =  profilestring(dir_ini+inifile_orthokis,"SMS","code_message_recontact","")


// Mise par défaut des dates à la semaine prochaine

// recherche du prochain luindi

date da

da = today()

do while daynumber(da) <> 2
	da = relativedate(da,1)
loop


em_date_anni_min.SetDate(da)
em_date_anni_max.SetDate(relativedate(da,6))

// Rappel de RDV
em_date_rdv_min.SetDate(today())
em_date_rdv_max.SetDate(ajout_x_mois(da,1))

// Absents
em_date_absent_min.SetDate(RelativeDate(today(), -7))
em_date_absent_max.SetDate(relativeDate(today(), -1))

// Recontact
em_date_recontact_min.setDate(today())
em_date_recontact_max.SetDate(date(year(today()),12,31))


// Liste pour mise en histo si envoi auto
dw_maj_histo.settransobject(sqlca)

if OPERATEUR_SMS = 2 then 
	dental_sms = true
else
	dental_sms = false
end if

if dental_sms then
	gb_manuel.text = "Dental SMS"
	st_fichier_destinatation.visible = false
	sle_fichier.visible = false
	pb_explorer.visible = false
	cb_lancer.visible = false
	cb_dental_config.visible = true
	cb_dental_histo.visible = true
	cb_dental_prog.visible = true
	
	// listes des codes SMS
	uo_poc.get_liste_codes(dw_code_sms)
	
	st_ds1.visible = true
	st_ds2.visible = true
	st_ds3.visible = true

else
	
	gb_manuel.text = "Manuel"
	st_fichier_destinatation.visible = true
	sle_fichier.visible = true
	pb_explorer.visible = true
	cb_lancer.visible = true
	cb_dental_config.visible = false
	cb_dental_histo.visible = false
	cb_dental_prog.visible = false
end if

// nom du fichier
if not dental_sms then 
	// choix du nom de fichier
 	sle_fichier.text = profilestring(dir_ini+inifile_orthokis,"SMS","Fichier",dir_ini+"envoi_sms.txt")
else
	// On impose le nom du fichier ... sle_fichier est non visible
 	sle_fichier.text = dir_ini+"envoi_sms.txt"
end if


colore_tous_objets_window(this, couleur_fond_datawindow)

gb_manuel.backcolor = couleur_transparente
gb_direct.backcolor = couleur_transparente

if dental_sms then 

	if dw_code_sms.rowcount() = 0 then
	
		MessageBox("ATTENTION", "Il n'y a aucun texte de SMS configuré !")

	end if
end if



close(w_patience)


end event

event resize;uo_resize.retaille(this)


pb_explorer.x = sle_fichier.x +  sle_fichier.width + 50
end event

event scroll_molette;
//
end event

