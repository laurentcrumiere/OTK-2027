this.em_date_absent_max=create em_date_absent_max
this.st_fichier_destinatation=create st_fichier_destinatation
this.cbx_cmu=create cbx_cmu
this.cbx_mgen=create cbx_mgen
this.cbx_autres=create cbx_autres
this.pb_envoi=create pb_envoi
this.pb_config=create pb_config
this.pb_suivi=create pb_suivi
this.pb_explorer=create pb_explorer
