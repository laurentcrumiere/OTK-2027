this.em_min_absent=create em_min_absent
this.st_10=create st_10
this.st_9=create st_9
this.cbx_absent_rdv=create cbx_absent_rdv
this.sle_code_message_envoi_tous=create sle_code_message_envoi_tous
this.st_8=create st_8
this.rb_un_dos_tous=create rb_un_dos_tous
this.rb_tous_dos_tous=create rb_tous_dos_tous
