type dw_code_sms from datawindow within w_sms
string tag = "no resize all brush"
boolean visible = false
integer x = 229
integer y = 212
integer width = 2450
integer height = 1144
integer taborder = 40
boolean bringtotop = true
boolean titlebar = true
string title = "Liste des Messages Dental SMS"
string dataobject = "dw_code_sms_ddlb"
boolean vscrollbar = true
borderstyle borderstyle = styleraised!
end type

event clicked;If row > 0 Then
	This.SelectRow(0,False)
	This.SelectRow(row,True)
	This.setrow(row)
End If

end event

event doubleclicked;

v_zone_saisie.text = string(dw_code_sms.getitemnumber(dw_code_sms.getrow(), "code"))
dw_code_sms.visible = false

end event

event rbuttondown;if dw_code_sms.visible then
	dw_code_sms.visible = false
else
	dw_code_sms.visible = true
end if

end event

