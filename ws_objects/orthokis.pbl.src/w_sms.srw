type pb_envoi from uo_picturebutton_390x120 within w_sms
integer x = 2226
integer y = 2248
integer taborder = 40
boolean bringtotop = true
fontcharset fontcharset = ansi!
string text = "&Envoi"
string iconname = "ACTIONS_sms_envoi_direct.png"
end type

event clicked;call super::clicked;

// Vérification config pocket 
string v_rep
boolean ok_suite

v_rep = string_non_nulle(uo_poc.get_repertoire_pocket())
if len(trim(v_rep)) > 0 and DirectoryExists(v_rep) then
	// Vérification des codes SMS
	ok_suite = true
	if dental_sms then
		
		if trim(sle_code_message_recontact.text) <> "" then
			if dw_code_sms.find("code = " + sle_code_message_recontact.text, 0, 9999) <= 0 then
				MessageBox("ATTENTION", "Le code de message que vous avez indiqué pour les Patients à recontacter est inconnu dans Dental SMS !")
				ok_suite = false
			end if
		end if
		if trim(sle_code_message_envoi_tous.text) <> "" then
			if dw_code_sms.find("code = " + sle_code_message_envoi_tous.text, 0, 9999) <= 0 then
				MessageBox("ATTENTION", "Le code de message que vous avez indiqué pour l'envoi de sms à TOUS les Patients est inconnu dans Dental SMS !")
				ok_suite = false
			end if
		end if
		if trim(sle_code_message_absent.text) <> "" then
			if dw_code_sms.find("code = " + sle_code_message_absent.text, 0, 9999) <= 0 then
				MessageBox("ATTENTION", "Le code de message que vous avez indiqué pour les Absences de rendez-vous est inconnu dans Dental SMS !")
				ok_suite = false
			end if
		end if
	end if

	
	if ok_suite then
		generation_envoi("A")
	end if
else
	Messagebox("ATTENTION","Envoi impossible.~n~nIl semblerait que votre paramétrage d'envoi des SMS ne soit pas correct. Vous allez accéder à la fenêtre de configuration.")
	pb_config.triggerevent(clicked!)
end if
end event

