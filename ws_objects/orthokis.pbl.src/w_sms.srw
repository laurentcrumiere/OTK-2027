this.em_min_tous=create em_min_tous
this.st_7=create st_7
this.st_6=create st_6
this.cbx_envoi_tous=create cbx_envoi_tous
this.rb_tous_dos=create rb_tous_dos
this.rb_un_dos=create rb_un_dos
this.em_min=create em_min
this.em_max=create em_max
this.st_min=create st_min
this.st_max=create st_max
