this.gb_1=create gb_1
this.gb_dos=create gb_dos
this.gb_2=create gb_2
this.gb_4=create gb_4
this.gb_5=create gb_5
this.gb_6=create gb_6
this.gb_recontact=create gb_recontact
this.dw_dossier=create dw_dossier
this.dw_dossier_tous=create dw_dossier_tous
this.rb_tous_recontact=create rb_tous_recontact
this.rb_un_recontact=create rb_un_recontact
this.dw_dossier_recontact=create dw_dossier_recontact
this.st_16=create st_16
this.st_15=create st_15
this.cbx_eliminer_recontact=create cbx_eliminer_recontact
this.st_17=create st_17
this.st_18=create st_18
this.em_min_recontact=create em_min_recontact
this.em_max_recontact=create em_max_recontact
this.sle_code_message_recontact=create sle_code_message_recontact
this.st_19=create st_19
this.em_date_anni_min=create em_date_anni_min
this.em_date_anni_max=create em_date_anni_max
this.em_date_recontact_min=create em_date_recontact_min
this.em_date_recontact_max=create em_date_recontact_max
this.em_date_rdv_min=create em_date_rdv_min
this.em_date_rdv_max=create em_date_rdv_max
