type m_analysedessoinsencours from menu within m_divers
end type

event clicked;if isvalid(w_liste_analyse_soins_en_cours) then
	// on selectionne
	w_mdi_2020.uo_powerdock.of_activatedocument (w_liste_analyse_soins_en_cours)
else
	if fxg_ouverture_onglet_possible() then
		//l'analyse des soins en cours  prend en cpt
		//  * le praticien sélectionné
		//  * une date de référence
		//
		//le soft va chercher à regrouper les soins selon 3 grps
		// 1) le mot "semestre" ds la dénomination du soin
		//    ET la date_référence entre date_demande du soin et date_demande + (nbr lettres *2)
		//    -> un semestre est un TO90, hors 90*2 = 180 et 180jours = 1 semestre
		// 2) le mot "contention" ds la dénomination du soin
		//    ET un nbr de lettre = 75
		//    ET date_référence entre date_demande du soin et date_demande + 365j
		// 3) le mot "contention" ds la dénomination du soin
		//    ET un nbr de lettre = 37.5
		//    ET date_référence entre date_demande du soin et date_demande + 152j (càd 1/2 année)
		
		//opensheet(w_liste_analyse_soins_en_cours,w_mdi_2020,0,layered!)
		w_mdi_2020.uo_powerdock.of_openDocument(w_liste_analyse_soins_en_cours, "Analyse des Soins en Cours", image_menu_listes_admini)
	end if
end if
end event

