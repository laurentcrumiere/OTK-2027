type m_mediadent from menu within m_logicielsexternes
end type

event clicked;// Lancement de médiadent pour le patient courant
if not isnull(var_code) and var_code <> 0 then

	// On se sert de uo_mediadent dans w_mdi _2020 (non visuel) car sinon, Mediadent se referme de suite
	
	string		rep_radio
	
	
	rep_radio = w_mdi_2020.uo_mediadent.get_rep_radio( )
	
	if rep_radio <> "" then
		
		if w_mdi_2020.uo_mediadent.connection_mediadent() = 1 then
			// info patient
			w_mdi_2020.uo_mediadent.set_info_patient_to_mediadent(var_code , rep_radio )
			
		end if
	else
		messagebox("ATTENTION ...", "Impossible de poursuivre ! ~n~nConfiguration du lien non effectuée, ~nou répertoire photo d'Orthokis mal indiqué, ~nou problème de réseau.", Exclamation! )
	end if
else
	son(5)
	MessageBox("ATTENTION","Aucun patient courant !",Exclamation!)
end if
end event

