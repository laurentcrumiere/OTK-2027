event clicked;//opensheet(w_table_type_produit,w_mdi_2020,0,layered!)

long  v_cpt2

select isnull(count(*),0) into :v_cpt2 from categorie_produit where actif = 1;

if  v_cpt2 = 0 then
	MessageBox("Attention","Vous devez saisir des Catégories de produit avant de saisir des Types")
else
	if isvalid(w_table_type_produit) then
		// on selectionne
		w_mdi_2020.uo_powerdock.of_activatedocument (w_table_type_produit)
	else
		if fxg_ouverture_onglet_possible() then
			w_mdi_2020.uo_powerdock.of_openDocument(w_table_type_produit, "Types de Produits", this.toolbarItemName)
