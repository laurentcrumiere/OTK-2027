type m_nouveaudossiersimplifié from menu within m_patients
end type

event clicked;
if fxg_ouverture_onglet_possible() then

	// Pour passage de paramètre car idem que depuis l'agenda
	
	rdv param_rdv
	
	param_rdv.date_debut = datetime(today(), now())
	param_rdv.date_fin = param_rdv.date_debut
	
	
	// PRATICIEN
	string var_praticien
	long v_ordre
	
	SELECT code INTO :var_praticien FROM prati where prati_defaut = '1';
	if isnull(var_praticien) then
		SELECT min(ordre_trie) INTO :v_ordre FROM prati where actif = 1;
		SELECT min(code)  INTO :var_praticien FROM prati where ordre_trie = :v_ordre and  actif = 1 ;
	end if
	
	
	param_rdv.praticien_de = var_praticien
	param_rdv.praticien_a = param_rdv.praticien_de
	
	
	//création rapide d'un nouveau patient
	openwithparm(w_creation_patient_rapide,param_rdv)
end if

end event

