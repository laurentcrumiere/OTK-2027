type m_produits from menu within m_gestion_de_stock
end type

event clicked;//opensheet(w_table_produit,w_mdi_2020,0,layered!)

// On teste avant car plante sion


long v_cpt1, v_cpt2, v_cpt3

select isnull(count(*),0) into :v_cpt1 from type_produit where actif = 1;
select isnull(count(*),0) into :v_cpt2 from categorie_produit where actif = 1;
select isnull(count(*),0) into :v_cpt3 from fournisseur where actif = 1;

if v_cpt1 = 0 or v_cpt2 = 0 or v_cpt3 = 0 then
	MessageBox("Attention","Vous devez saisir une classification de produit (Catégories / Types) et des Fournisseurs avant de saisir un produit")
else
	if isvalid(w_table_produit) then
		// on selectionne
		w_mdi_2020.uo_powerdock.of_activatedocument (w_table_produit)
	else
		if fxg_ouverture_onglet_possible() then
			w_mdi_2020.uo_powerdock.of_openDocument(w_table_produit, "Produits", this.toolbarItemName)
		end if
	end if
end if



end event

