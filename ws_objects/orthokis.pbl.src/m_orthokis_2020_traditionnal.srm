type m_salledattente0 from menu within m_patients
end type

event clicked;if fxg_ouverture_onglet_possible() then
	long win_x, win_y 
	integer trouve
	
	// ATTENTION ... FAIRE AUSSI MODIFICATION DANS SALLE ATTENTE INDEPENDANTE AU CHANGEMENT DE VERSION
	
	// V 2026 ou > 
	// fenêtre à part ?
	if profilestring(dir_ini+inifile_orthokis,"rendez-vous","ouverture_fenetre_a_part","false") = "true" then
		
		// lecture du dernier emplacement de la fenêtre
		win_x = profileint(dir_ini+inifile_orthokis,"rendez-vous","salle_attente_a_part_x",0)
		win_y = profileint(dir_ini+inifile_orthokis,"rendez-vous","salle_attente_a_part_y",0)
		
		open(w_rdv_salle_attente)
	
		// Possitionnement de retaillage de la fenêtre
		
		w_rdv_salle_attente.move( PixelsToUnits( win_x, xPixelsToUnits!) , PixelsToUnits( win_y, YPixelsToUnits!))
		w_rdv_salle_attente.width = profileint(dir_ini+inifile_orthokis,"rendez-vous","salle_attente_a_part_width", 1943)
		w_rdv_salle_attente.height = profileint(dir_ini+inifile_orthokis,"rendez-vous","salle_attente_a_part_height", 1240)

	
	
	else
		// ouverture normale
		
		trouve = is_fenetre_2020_ouverte("Salle d'Attente", w_rdv_salle_attente) 
	
		if trouve = 0 then
			trace("before  of_openDocument " + string(now() ))
			w_mdi_2020.uo_powerdock.of_openDocument(w_rdv_salle_attente, "Salle d'Attente", icone_salle_attente_24)
		else
			w_mdi_2020.uo_powerdock.of_activatedocument (trouve)
		end if
	end if

end if
end event

