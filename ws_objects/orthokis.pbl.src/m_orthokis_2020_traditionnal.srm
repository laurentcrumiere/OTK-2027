end type

event clicked;
if isvalid(w_prati) then
	// on selectionne
	w_mdi_2020.uo_powerdock.of_activatedocument (w_prati)
else

	string v_mot_de_passe_acces_table_praticiens
	
	// Faut il un mot de passe ?
	select top 1 isnull(mot_de_passe_acces_table_praticiens,'N') into :v_mot_de_passe_acces_table_praticiens from param ;
	if v_mot_de_passe_acces_table_praticiens = "O" then 
		ok_mdp = false
		guo_fenetre_modale.wf_ouvrir(w_mot_passe_administrateur)	
		//guo_fenetre_modale.wf_ouvrir(w_mot_passe_administrateur)
	else
		ok_mdp = true
	end if
			
	if ok_mdp then
		if fxg_ouverture_onglet_possible() then
			w_mdi_2020.uo_powerdock.of_openDocument(w_prati, "Praticiens", m_orthokis_2020.m_tables.m_tables_administratif.toolbarItemName)
