forward prototypes
public subroutine fermer_mdi ()
public subroutine fermer_toutes_fenetres ()
public function window ouvrir_mdi (decimal partie_a_ouvrir)
end prototypes

public subroutine fermer_mdi ();

// Ferme la fenêtre MDI patient courant

// recherche de la fenêtre qu'on veut fermer ... 

window sheet, sheet_prec
w_mdi_patient sheet_mdi_patient
integer trouve

string titre_cherche,titre


titre_cherche = var_nom+" ("+string(var_numero_dossier)+")"+var_cmu

trouve = is_fenetre_2020_ouverte(titre_cherche, sheet_mdi_patient)


if trouve = 0 then
	// On fait rien
else
	
	 sheet_mdi_patient.fermer_mdi_patient(true)
	
end if

return
end subroutine

public subroutine fermer_toutes_fenetres ();
w_mdi_2020.uo_powerdock.of_closealldocuments ()


end subroutine

public function window ouvrir_mdi (decimal partie_a_ouvrir);// Ouvre la fenêtre MDI patient ou l'active si celle-ci est déjà ouverte .. et la renvoie

// recherche de la fenêtre qu'on veut ouvrir ... 

w_mdi_patient w_fenetre_a_ouvrir, fenetre_ouverte

trace("========== DEBUT OUVRIR MDI =====================")
trace("Partie à ouvrir : " + string(partie_a_ouvrir))
Trace("Patient : " + string (var_code ))

integer trouve

string titre_cherche,titre

if partie_a_ouvrir = 20 then
	// Création d'un nouveau dossier
	trouve = 0
	titre_cherche = "Création de Patient"
else
	titre_cherche = titre_onglet_patient(var_code)
	// ui_2020
	trouve = is_fenetre_2020_ouverte(titre_cherche, w_fenetre_a_ouvrir) 
end if

if trouve = 0 then
	// faut ouvrir une new fenetre
	// Mode 1 fenêtre par client
	w_mdi_patient w3
	// Le param pour ouvrir par défaut
	str_param_string param_passe  
	param_passe.param = string(partie_a_ouvrir)

	w_mdi_2020.uo_powerdock.of_openDocument(w3, param_passe, titre_cherche,  icone_fiche_admini_16 )
	
	if partie_a_ouvrir = 20 then 
		// il est possible que l'utilisateur annule la création => la fenetre w2 de la mdi n'est pas ouverte => on terme tout
		if not isvalid(w3.w2) then
			fermer_fenetre(w3)
		end if
	else
		fenetre_ouverte = w3
	end if
else
	w_mdi_2020.uo_powerdock.of_activatedocument (w_fenetre_a_ouvrir)
	w_fenetre_a_ouvrir.ouvre_partie(partie_a_ouvrir)
	fenetre_ouverte = w_fenetre_a_ouvrir
	
end if


trace("========== FIN OUVRIR MDI =====================")

return fenetre_ouverte
end function

on m_orthokis_2020_traditionnal.create
m_orthokis_2020_traditionnal=this
call super::create
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217731
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_edition=create m_edition
this.m_patients=create m_patients
this.m_listes=create m_listes
this.m_tables=create m_tables
this.m_gestion_de_stock=create m_gestion_de_stock
this.m_outils=create m_outils
this.m_aide=create m_aide
this.Item[UpperBound(this.Item)+1]=this.m_edition
this.Item[UpperBound(this.Item)+1]=this.m_patients
this.Item[UpperBound(this.Item)+1]=this.m_listes
this.Item[UpperBound(this.Item)+1]=this.m_tables
this.Item[UpperBound(this.Item)+1]=this.m_gestion_de_stock
this.Item[UpperBound(this.Item)+1]=this.m_outils
this.Item[UpperBound(this.Item)+1]=this.m_aide
end on

on m_orthokis_2020_traditionnal.destroy
call super::destroy
destroy(this.m_edition)
destroy(this.m_patients)
destroy(this.m_listes)
destroy(this.m_tables)
destroy(this.m_gestion_de_stock)
destroy(this.m_outils)
destroy(this.m_aide)
end on

event clicked;

open(w_requetes_sql)
end event

