type m_sauvegarderlabasededonnées from menu within m_autres
end type

event clicked;sauvegarde_base	sbd
string	msg


sbd = create sauvegarde_base

if messagebox("ATTENTION","Vous allez faire une sauvegarde de votre Base de Données,~nnotez que cette opération ne remplace nullement une véritable sauvegarde sur un support externe.",Exclamation!,OKCancel!) = 1 then
	choose case sbd.sauvegarder_base()
		case -1
			messagebox("ATTENTION","Le chemin de sauvegarde n'est pas configuré,~nLa sauvegarde a échouée.")
		case -2
			messagebox("ATTENTION","Le programme externe de sauvegarde est introuvable,~nVeuillez en avertir ARAKIS.~nLa sauvegarde est impossible.")
		//case 1		//pour l'instant inutile car impossible de récup l'handle de dbbackup
		//	MessageBox("INFORMATION","La sauvegarde s'est terminée avec succés")
	end choose
end if

destroy sbd
end event

