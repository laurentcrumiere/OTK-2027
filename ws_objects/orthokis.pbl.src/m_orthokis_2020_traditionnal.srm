type m_dolphinimaging from menu within m_logicielsexternes
end type

event clicked;
// Lance dolphin pour le patient courant

if var_code <> 0 then


	string rep 
	rep = profilestring(dir_ini+inifile_orthokis,"dolphin","dir","c:\dolphin\")
	
	string dolctrl 

	dolctrl = rep + "dolctrl.exe"
	
	string commande 
	double v_numero_dossier
	
	// Le lien se fait sur le N° de dossier
	select numero_dossier into :v_numero_dossier from patient where code = :var_code ;
	
	
	if fileexists(dolctrl) then
			commande = dolctrl +" "+ string(v_numero_dossier)
			runwait(commande,1)
	else
		MessageBox("ATTENTION !","Impossible de localiser le fichier DOLCTRL.EXE. ~n~nLiaison impossible !")
	end if

else
	MessageBox("ATTENTION !","Il n'y a pas de patient courant !")
end if


end event

