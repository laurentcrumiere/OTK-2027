		w_mdi_2020.uo_powerdock.of_activatedocument (w_sms)
	else
		if fxg_ouverture_onglet_possible() then
			w_mdi_2020.uo_powerdock.of_openDocument(w_sms, "Envois de SMS", m_orthokis_2020.m_outils.m_traitements.toolbarItemName)
		end if
	end if
else
	
	// Pas d'opérateur ... on ouvre la config
	
	Messagebox("ATTENTION","Dental SMS n'est pas configuré !~n~nVous allez accèder à sa configuration.")
	ok_mdp = false

	guo_fenetre_modale.wf_ouvrir(w_mot_passe_administrateur)
	
	if ok_mdp then
		open(w_sms_config)
	end if

end if

end event

