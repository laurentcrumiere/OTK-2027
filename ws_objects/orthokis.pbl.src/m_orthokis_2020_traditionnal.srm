event clicked;
string s_prog

s_prog = dir_ini + "salle_attente.exe"

if fileExists( s_prog) then
	SetProfileString(dir_ini+inifile_orthokis,"rendez-vous","sa_indep_premiere_ouverture","O")
	if trace then
		run (s_prog + " #" + utilisateur_code+"#"+ version_ce_logiciel + "#"+"TRACE")
	else
		run (s_prog + " #" + utilisateur_code+"#" + version_ce_logiciel + "#")
	end if
	
else
	
	Messagebox ("ERREUR", "Impossible de localiser le programme de Salle d'Attente indépendante.~n~nVeuillez contacter DentalSoft !")
	
end if
end event

