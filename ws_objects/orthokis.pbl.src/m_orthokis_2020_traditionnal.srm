end type

on m_tables_rendezvous.create
call super::create
this.tag = "group:RDV;size:Large"
this.text = "Rendez-vous"
this.toolbaritemname = "lc_rdv.png"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.menutitletext = "Rendez-vous"
this.titlebackcolor = 134217731
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_etatsdesrendez-vous=create m_etatsdesrendez-vous
this.m_famillesderendez-vous=create m_famillesderendez-vous
this.m_journéestypedéfinition=create m_journéestypedéfinition
this.m_messagesbornesalledattente=create m_messagesbornesalledattente
this.m_joursinterdits=create m_joursinterdits
this.m_affectationdessemainestypes=create m_affectationdessemainestypes
this.m_definitiondessemainestypes=create m_definitiondessemainestypes
this.m_seriesderendezvous=create m_seriesderendezvous
this.m_typesderendez-vous=create m_typesderendez-vous
this.m_vacancesscolaires=create m_vacancesscolaires
this.Item[UpperBound(this.Item)+1]=this.m_etatsdesrendez-vous
this.Item[UpperBound(this.Item)+1]=this.m_famillesderendez-vous
this.Item[UpperBound(this.Item)+1]=this.m_journéestypedéfinition
this.Item[UpperBound(this.Item)+1]=this.m_messagesbornesalledattente
this.Item[UpperBound(this.Item)+1]=this.m_joursinterdits
this.Item[UpperBound(this.Item)+1]=this.m_affectationdessemainestypes
this.Item[UpperBound(this.Item)+1]=this.m_definitiondessemainestypes
this.Item[UpperBound(this.Item)+1]=this.m_seriesderendezvous
this.Item[UpperBound(this.Item)+1]=this.m_typesderendez-vous
this.Item[UpperBound(this.Item)+1]=this.m_vacancesscolaires
end on

on m_tables_rendezvous.destroy
call super::destroy
destroy(this.m_etatsdesrendez-vous)
destroy(this.m_famillesderendez-vous)
destroy(this.m_journéestypedéfinition)
destroy(this.m_messagesbornesalledattente)
destroy(this.m_joursinterdits)
destroy(this.m_affectationdessemainestypes)
destroy(this.m_definitiondessemainestypes)
destroy(this.m_seriesderendezvous)
destroy(this.m_typesderendez-vous)
destroy(this.m_vacancesscolaires)
end on

