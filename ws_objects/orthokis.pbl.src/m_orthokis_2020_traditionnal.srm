// Lance la commande de messagerie, hector


string url_wb, url_hec
inet iinet_base




// myo ?

select top 1 isnull(url_hector,'') into :url_hec from param ;
//

if url_hec = "" then
	
	Messagebox("ATTENTION","Pour accéder à cette fonction vous devez utiliser le connecteur Hector et définir son url dans les paramètres généraux d'Orthokis.")
	
else
	
	open(w_patience)

	// Construction de l'URL complète
	url_wb = url_hec + "mybox"
	
	openurl ( url_wb)
	
	close(w_patience)
end if
return
end event

