type m_miseajour from menu within m_aide
end type

event clicked;
string last_build, nom_fichier_attendu, url_complete, url_arakis

// Version_base_autorisee peut avoir des décimales
url_arakis = "https://www.arakis.fr/fr/telecha/Orthokis_" + string(integer(Version_base_autorisee))+ "/"

if pos(version, "Evolution") > 0 then
	url_arakis = url_arakis + "Evolution/"
end if

last_build = fxg_get_last_build(true)

if last_build > version_ce_logiciel then
	
// pour les test	
//if last_build > version_ce_logiciel or true then
//	last_build = "31.00j"


	nom_fichier_attendu = "Orthokis-maj-" + last_build +".exe"
			
	// Téléchargement FTP
	if messagebox("INFORMATION !","Une mise à jour d'Orthokis est disponible.~n~nPassage de " + version_ce_logiciel + " à " + last_build + "~n~nSouhaitez-vous la télécharger ?~n~nIMPORTANT !~n~n- Le téléchargement peut prendre plusieurs minutes selon votre connexion Internet.~n~n- Orthokis ne sera pas disponible sur ce poste durant le téléchargement.~n~n- Vous devez avoir enregistrer votre travail car Orthokis se fermera pour lancer la mise à jour une fois téléchargée.", Question!, YesNo!, 1) = 1 then
		openWithParm(w_maj_ftp, nom_fichier_attendu)
	end if

else
	messagebox("INFORMATION !","Vous possédez la dernière version d'Orthokis. Aucune mise à jour n'est nécessaire.")		
end if
	




end event

