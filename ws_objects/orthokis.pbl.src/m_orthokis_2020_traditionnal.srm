event clicked;if fxg_ouverture_onglet_possible() then
	long v_cpt
	
	select count(*) into :v_cpt from categorie_commentaire where type_com = 'C' ;
	
	if v_cpt = 0 then
	
		MessageBox("Attention","Vous devez entrer des Categories de Commentaires Prédéfinis avant de saisir des Commentaires Prédéfinis")
	
	else
		w_commentaires_predefinis w1
		//opensheetWithParm(w1, "C" ,w_mdi_2020,0,layered!)
		
		str_param_string param_passe  
