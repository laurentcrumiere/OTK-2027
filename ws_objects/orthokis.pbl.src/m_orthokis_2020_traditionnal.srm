event clicked;if not isnull(VAR_CODE) and var_code <> 0 then
	string v_fichier_moulage
	select top 1 isnull(nom_courrier,'') into :v_fichier_moulage  from historique_editions where nature = 'D' and code_courrier = 'DOCMOU' and code = :var_code order by date_document desc  ;
	
	if v_fichier_moulage = "" then
		
		Messagebox("ATTENTION","Ce patient n'a pas de Moulage Numérique.")
		
	else
		
		string rep_photo, chemin_complet
		
		rep_photo = fxg_get_rep_photos()
		chemin_complet = rep_photo + string( var_code ) + win_delimiter + v_fichier_moulage
		
		if fileExists(chemin_complet) then
		
				fxg_ouvrir_fichier_shell(chemin_complet)
		else
			
			Messagebox("ATTENTION",'Le fichier "' + chemin_complet + '" est introuvable.')
	
		
		end if
	
	end if
else
	Messagebox("ATTENTION","Aucun patient courant !")
end if

end event

