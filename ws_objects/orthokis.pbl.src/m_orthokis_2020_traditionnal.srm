type m_odrade from menu within m_logicielsexternes
end type

event clicked;constant string reg_path = "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\Odrade.exe"

string 	dir_odrade 			// Répertoire d'installation de Odrade
string 	exe_odrade			// Fichier complet  à lancer depuis PWO
string 	argument				// argument passé à Odrade


//récup le rép d'install d'ODRADE et y ajoute odrade.exe
RegistryGet(reg_path,"path",dir_odrade)
exe_odrade = dir_odrade +"\odrade.exe"

// voici la syntaxe des arguments a passer en param à l'ouverture d'Odrade
// --> PWO#identifiant_odrade#
// Attention, PWO doit être en MAJUSCULES

if not isnull(VAR_CODE) and var_code <> 0 then
	
	
	// recherche des éléments à passer à Odrade
	string v_num_dossier, v_nom, v_prenom,  v_sexe, v_str_date_naissance
	date v_date_naissance
	
	select isnull(string(numero_dossier),''), isnull(nom,''), isnull(prenom,''), date_naissance, isnull(sexe,'F')
	into :v_num_dossier, :v_nom, :v_prenom, :v_date_naissance , :v_sexe
	from patient 
	where code = :var_code ;
	
	
	if not isnull(v_date_naissance) then
		v_str_date_naissance = string(v_date_naissance, 'dd/mm/yyyy')
	else
		v_str_date_naissance = ''
	end if
	
	//construit la ligne d'arguments
	argument = "ORTHOKIS#" + string(var_code) + "#" + v_num_dossier + "#" + v_nom + "#" + v_prenom + "#" + v_str_date_naissance + "#" + v_sexe + "#" 

/*
Param0 : ORTHOKIS
Param1 : code_patient
Param2 : num_dossier
Param3 : nom
Param4 : prenom
Param5 : date de naissance dans le système de symbole de date courte de l’ordi
Param6 : F ou M pour Female ou Male (en fait, on teste le F car Female ou Femme ou Fille, c’est avec un F …)


Exemple :
ORTHOKIS#1#1234#DURAND#Pierre#15/09/1999#M#
*/





	//lance odrade
		
	if run(exe_odrade + ' "' + argument + '"') <> 1 then
		MessageBox("ATTENTION !","Impossible de lancer le logiciel Odrade !~n~nVeuillez vérifier son installation.")
	end if
else
	son(5)
	MessageBox("ATTENTION","Aucun patient courant !",Exclamation!)
end if

end event

