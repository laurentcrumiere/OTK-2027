type m_prochainrendez-vousdu from menu within m_autres
end type

event clicked;// Calcul du prochain rendez-vous
// Patient courant est dans var_code

string nom, prenom
integer tot
datetime prdv

Select count("code"),nom, isnull(prenom, '') INTO :tot,:nom, :prenom FROM Patient WHERE code = :var_code GROUP BY nom, prenom ;

if tot = 0 then
	 son(5)
	 MessageBox("ATTENTION !","Aucun patient courant !")
else

	prdv = proc_rdv(var_code)

	if isnull(prdv) then
		MessageBox("Prochain rendez-vous pour le patient courant","Patient courant : "+nom+ " "+ prenom + "~n~nCe patient n'a pas de rendez-vous prévu !")
	else
		MessageBox("Prochain rendez-vous pour le patient courant","Patient courant : "+nom+ " "+ prenom + "~n~nRendez-vous le "+string(date(prdv),'dd/mm/yy')+" à "+string(time(prdv),'hh:mm'))
	end if
end if



end event

