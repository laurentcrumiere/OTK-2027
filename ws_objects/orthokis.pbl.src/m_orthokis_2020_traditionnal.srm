type m_minisalledattente from menu within m_patients
end type

event clicked;
// lecture du dernier emplacement de la fenêtre
long win_x, win_y 
win_x = profileint(dir_ini+inifile_orthokis,"rendez-vous","mini_salle_attente_x",0)
win_y = profileint(dir_ini+inifile_orthokis,"rendez-vous","mini_salle_attente_y",0)

w_rdv_salle_attente_mini w1
openwithparm(w1, 1)

// Possitionnement de retaillage de la fenêtre

w1.move( PixelsToUnits( win_x, xPixelsToUnits!) , PixelsToUnits( win_y, YPixelsToUnits!))
w1.width = profileint(dir_ini+inifile_orthokis,"rendez-vous","mini_salle_attente_width", 1943)
w1.height = profileint(dir_ini+inifile_orthokis,"rendez-vous","mini_salle_attente_height", 1240)

// Au cas ou .... pour etre sur que ...
if w1.x < 0 or w1.y < 0 or w1.width <= 0 or w1.height <= 0 &
or w1.x >= w_mdi_2020.width - 50 or w1.y >= w_mdi_2020.height - 10 then
	w1.x = 100
	w1.y = 100
	w1.width = 1943
	w1.height = 1240
end if

// Positionnement
if profilestring(dir_ini+inifile_orthokis,"rendez-vous","mini_salle_attente_on_top","False") = "true" then
	w1.setPosition(TopMost!)
else
	w1.setPosition(ToTop!)
end if
end event

