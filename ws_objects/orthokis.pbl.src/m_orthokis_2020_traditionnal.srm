type m_affectationdessemainestypes from menu within m_tables_rendezvous
end type

event clicked;
// on teste avant l'existence des semaines sinon ça plante
integer v_cpt

select isnull(count(*),0)   into :v_cpt 
	 FROM "semaine_type"  
	WHERE "semaine_type"."actif" = 1   ;
	
if v_cpt = 0 then
	MessageBox("ATTENTION ","Vous devez d'abord définir des semaines types avant des les affecter !")
else
	if isvalid(w_planning) then
		// on selectionne
		w_mdi_2020.uo_powerdock.of_activatedocument (w_planning)
	else
		if fxg_ouverture_onglet_possible() then
			w_mdi_2020.uo_powerdock.of_openDocument(w_planning, "Semaines Types - Affectation", m_orthokis_2020.m_tables.m_tables_rendezvous.toolbarItemName)
		end if
	end if
end if
end event

