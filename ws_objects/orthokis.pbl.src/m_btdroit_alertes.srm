event clicked;
	
	w_mdi_2020.uo_powerdock.of_openDocument(w_alertes_historique, "Historique des Alertes", image_menu_listes_admini)
		

string var_nom_local
double var_numero_dossier_local

select nom + ' ' + isnull(prenom, ''), numero_dossier into :var_nom_local, :var_numero_dossier_local from patient where code = :var_code_local ;

w_alertes_historique.rb_tous_pat.checked = false
w_alertes_historique.rb_un_pat.checked = true

w_alertes_historique.sle_pat.text = var_nom_local
w_alertes_historique.sle_pat.visible = true

w_alertes_historique.var_numero_dossier_local = var_numero_dossier_local

w_alertes_historique.em_min.text = "01/01/1900 00:00"

w_alertes_historique.cb_ecran.triggerevent(clicked!)



end event

