$PBExportHeader$m_btdroit_alertes.srm
forward
global type m_btdroit_alertes from menu
end type
type m_ouvrirhistoriquedesalertes from menu within m_btdroit_alertes
end type
type m_creationdunetachepourlepatient from menu within m_btdroit_alertes
end type
global type m_btdroit_alertes from menu
m_ouvrirhistoriquedesalertes m_ouvrirhistoriquedesalertes
m_creationdunetachepourlepatient m_creationdunetachepourlepatient
end type
end forward

global type m_btdroit_alertes from menu
m_ouvrirhistoriquedesalertes m_ouvrirhistoriquedesalertes
m_creationdunetachepourlepatient m_creationdunetachepourlepatient
end type
global m_btdroit_alertes m_btdroit_alertes

type variables
double var_code_local
end variables

on m_btdroit_alertes.create
m_btdroit_alertes=this
call super::create
this.text = "m_btdroit_alertes"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_ouvrirhistoriquedesalertes=create m_ouvrirhistoriquedesalertes
this.m_creationdunetachepourlepatient=create m_creationdunetachepourlepatient
this.Item[UpperBound(this.Item)+1]=this.m_ouvrirhistoriquedesalertes
this.Item[UpperBound(this.Item)+1]=this.m_creationdunetachepourlepatient
end on

on m_btdroit_alertes.destroy
call super::destroy
destroy(this.m_ouvrirhistoriquedesalertes)
destroy(this.m_creationdunetachepourlepatient)
end on

type m_ouvrirhistoriquedesalertes from menu within m_btdroit_alertes
end type

