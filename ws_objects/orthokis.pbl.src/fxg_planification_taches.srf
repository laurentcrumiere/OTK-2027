$PBExportHeader$fxg_planification_taches.srf
global type fxg_planification_taches from function_object
end type

forward prototypes
global subroutine fxg_planification_taches ()
end prototypes

global subroutine fxg_planification_taches ();
// PLANIFICATION DES TACHES 
//--------------------------------------

// verification si on doit la faire ou pas 
if not PLANIFICATION_EN_COURS then
	
	date date_courante, date_prochaine
	time heure_courante, heure_prochaine 
	integer nb_exemplaires, cpt
	boolean v_suite
	
	date_courante = today()
	heure_courante = now()
	
	date_prochaine = date( profileString(dir_ini + inifile_orthokis , "PLANIFICATION","prochaine","01/01/1900"))
	heure_prochaine = time( profileString(dir_ini + inifile_orthokis , "PLANIFICATION","heure","00:00"))

	if  date_prochaine < date_courante or (date_courante = date_prochaine and  heure_prochaine <= heure_courante) then 
		
		
		// Si on a dépassée le jour prévu, on pose la question !!! 
		
		if  date_prochaine < date_courante then
			if messagebox("ATTENTION", "La planification aurait dû se lancer le " + string(date_prochaine, "dd/mm/yyyy") + " à " + string(heure_prochaine, "hh:mm") +".~nOr nous sommes le " + string(date_courante) +".~n~nConfirmez-vous l'exécution des tâches planifiées ?", Question!, YesNo!, 2) = 1 then
				v_suite = true
			else
				v_suite = false
			end if
		else
			v_suite = true
		end if
		
		
		if v_suite then 
			// On passe au jour suivant pour la next fois de suite pour éviter qu'on relance
			
			SetprofileString(dir_ini + inifile_orthokis , "PLANIFICATION","prochaine",string( relativedate(date_courante,1), "dd/mm/yyyy"))
			
	
			
			// On lance la planification !!!!!!!!!!!!!!!!!!!!!
			PLANIFICATION_EN_COURS = true
			
			// Par sécurité on ferme toutes les fenêtres
			m_orthokis_2020.fermer_toutes_fenetres()
			
			datastore dw_config				// Liste des actions à mener
			dw_config = CREATE DataStore
			dw_config.DataObject = "dw_planification_config"
			dw_config.SetTransObject(SQLCA)
			dw_config.retrieve()
			
			
			datastore dw_prati		// servira à boucler sur tous les pracitiens
			dw_prati = CREATE DataStore
			dw_prati.DataObject = "dw_prati_liste"
			dw_prati.SetTransObject(SQLCA)
			dw_prati.SetFilter("actif = 1")
			dw_prati.filter()
			dw_prati.retrieve()
	
			string v_code, v_periodicite, v_code_praticien, v_libelle
			integer v_jour_semaine, v_jour_mois, lig, tot, ligpra, totpra
			boolean on_doit_faire
			integer v_j1, v_j2
	
	
			tot = dw_config.rowcount()

			trace ( "*** DEBUT DE L'EXAMEN DE LA PLANIFICATION ***")
			
			fxg_ajout_journal_planification('******', "*** DEBUT DE L'EXAMEN DE LA PLANIFICATION ***")
			
			// ce qu'il y a a faire ...
			for lig = 1 to tot
			
				v_code = dw_config.getItemString(lig, "code")
				v_libelle = dw_config.getItemString(lig, "libelle")
				v_periodicite = dw_config.getItemString(lig, "periodicite")
				v_jour_semaine = dw_config.getItemnumber(lig, "jour_semaine")
				v_jour_mois   = dw_config.getItemnumber(lig, "jour_mois")
				
				zeroi(v_jour_semaine)
				zeroi(v_jour_mois)
				
				Trace ( "- Code : " + v_code +  " - Libellé : " + v_libelle  + " - Périodicité : " + v_periodicite + " - Jour semaine : " + string(v_jour_semaine) +  " - Jour mois : " + string(v_jour_mois) )
	
				// test pour savoir si on doit ou non faire le truc 
				on_doit_faire = false
				
				choose case v_periodicite
					case 'N'
						// Jamais
						on_doit_faire = false
					case 'J'
						// toujours
						on_doit_faire = true
					case 'S'
						if daynumber(today()) = v_jour_semaine then
							on_doit_faire = true
						end if
					case 'M'
						if day(today()) = v_jour_mois then
							on_doit_faire = true
						end if
				end choose
				
				Trace ( "- Code : " + v_code + " - Périodicité : " + v_periodicite + " - Jour semaine : " + string(v_jour_semaine) +  " - Jour mois : " + string(v_jour_mois)  + " - On doit faire ? " + string(on_doit_faire) )
	
				
				if on_doit_faire then 
			
					choose case v_code 
									
						case 'FTJ'					// Feuille de Travail Journalière
							
							open(w_rdv_feuille_travail)

							
							// lecture des paramètres
							w_rdv_feuille_travail.em_faut_min.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTJ_fauteuil1","0")
							w_rdv_feuille_travail.em_faut_max.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTJ_fauteuil2","99")
	
							nb_exemplaires = integer(ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTJ_exemplaires","1"))
							
							if hour(now()) >= 12 then
								// si lancé l'AM ou le soir, c'est pour le lendemain, 
								w_rdv_feuille_travail.em_date.SetDate( relativedate(today() , 1 ))
							else
								w_rdv_feuille_travail.em_date.SetDate( today() )
							end if
							
							
							if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTJ_praticiens","T") =  "C"  then 
								// On doit boucler sur tous les praticiens !!!
								
								totpra = dw_prati.rowcount()
								w_rdv_feuille_travail.rb_un.checked = true
								w_rdv_feuille_travail.rb_un.triggerevent(clicked!)
	
								for ligpra = 1 to totpra
								
									v_code_praticien = dw_prati.GetItemString(ligpra, "code")
									w_rdv_feuille_travail.dw_prati.Setitem(1,"code", v_code_praticien)
	
									w_rdv_feuille_travail.cb_ecran.triggerevent(clicked!)
									
									if w_rdv_feuille_travail.dw_liste.rowcount() > 0 then
										for cpt = 1 to nb_exemplaires 
											w_rdv_feuille_travail.cb_imprimer.triggerevent(clicked!)
										next
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour le code praticien : " + v_code_praticien)
									end if
									
								next
	
							else
								
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTJ_praticiens","T") = "T" then
									w_rdv_feuille_travail.rb_tous.checked = true
									w_rdv_feuille_travail.rb_tous.triggerevent(clicked!)
								else
									w_rdv_feuille_travail.rb_un.checked = true
									w_rdv_feuille_travail.rb_un.triggerevent(clicked!)
									v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTJ_code_praticien","")
									w_rdv_feuille_travail.dw_prati.Setitem(1,"code",v_code_praticien )
								end if
								
								w_rdv_feuille_travail.cb_ecran.triggerevent(clicked!)
								
								if w_rdv_feuille_travail.dw_liste.rowcount() > 0 then
									for cpt = 1 to nb_exemplaires 
										w_rdv_feuille_travail.cb_imprimer.triggerevent(clicked!)
									next
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTJ_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour le code praticien : " + v_code_praticien)
									end if
								else
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTJ_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour le code praticien : " + v_code_praticien)
									end if
								end if
							end if
							
							w_rdv_feuille_travail.cb_fermer.triggerevent(clicked!)
							
						//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
						
						case 'FTF'					// Feuille de Travail Financière
							
							open(w_rdv_feuille_travail_financiere)

							// lecture des paramètres
							w_rdv_feuille_travail_financiere.em_faut_min.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTF_fauteuil1","0")
							w_rdv_feuille_travail_financiere.em_faut_max.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTF_fauteuil2","99")
							
							nb_exemplaires = integer(ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTF_exemplaires","1"))
	
							if hour(now()) >= 12 then
								// si lancé l'AM ou le soir, c'est pour le lendemain, 
								w_rdv_feuille_travail_financiere.em_date.SetDate( relativedate(today() , 1 ))
							else
								w_rdv_feuille_travail_financiere.em_date.SetDate( today() )
							end if
							
							
							if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTF_praticiens","T") =  "C"  then 
								// On doit boucler sur tous les praticiens !!!
								
								totpra = dw_prati.rowcount()
								
								w_rdv_feuille_travail_financiere.rb_un.checked = true
								w_rdv_feuille_travail_financiere.rb_un.triggerevent(clicked!)
	
								for ligpra = 1 to totpra
								
									v_code_praticien = dw_prati.GetItemString(ligpra, "code")
									w_rdv_feuille_travail_financiere.dw_prati.Setitem(1,"code", v_code_praticien)
	
									w_rdv_feuille_travail_financiere.cb_ecran.triggerevent(clicked!)
									
									if w_rdv_feuille_travail_financiere.dw_liste.rowcount() > 0 then
										for cpt = 1 to nb_exemplaires 
											w_rdv_feuille_travail_financiere.cb_imprimer.triggerevent(clicked!)
										next
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour le code praticien : " + v_code_praticien)
									else
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour le code praticien : " + v_code_praticien)
									end if
									
								next
	
							else
								
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTF_praticiens","T") = "T" then
									w_rdv_feuille_travail_financiere.rb_tous.checked = true
									w_rdv_feuille_travail_financiere.rb_tous.triggerevent(clicked!)
								else
									w_rdv_feuille_travail_financiere.rb_un.checked = true
									w_rdv_feuille_travail_financiere.rb_un.triggerevent(clicked!)
									v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTF_code_praticien","")
									w_rdv_feuille_travail_financiere.dw_prati.Setitem(1,"code", v_code_praticien)
								end if
								
								w_rdv_feuille_travail_financiere.cb_ecran.triggerevent(clicked!)
								
								if w_rdv_feuille_travail_financiere.dw_liste.rowcount() > 0 then
									for cpt = 1 to nb_exemplaires 
										w_rdv_feuille_travail_financiere.cb_imprimer.triggerevent(clicked!)
									next
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTF_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour le code praticien : " + v_code_praticien)
									end if
								else
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTF_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour le code praticien : " + v_code_praticien)
									end if
								end if
							end if
							
							w_rdv_feuille_travail_financiere.cb_fermer.triggerevent(clicked!)
							
						//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
						
						case 'FTP'					// Feuille de Travail Personnalisée
							
							open(w_rdv_feuille_perso)

							// lecture des paramètres
							w_rdv_feuille_perso.em_faut_min.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTP_fauteuil1","0")
							w_rdv_feuille_perso.em_faut_max.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTP_fauteuil2","99")
	
							nb_exemplaires = integer(ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTP_exemplaires","1"))
	
							if hour(now()) >= 12 then
								// si lancé l'AM ou le soir, c'est pour le lendemain, 
								w_rdv_feuille_perso.em_date.SetDate( relativedate(today() , 1 ))
							else
								w_rdv_feuille_perso.em_date.SetDate( today() )
							end if
							
							
							if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTP_praticiens","T") =  "C"  then 
								// On doit boucler sur tous les praticiens !!!
								
								totpra = dw_prati.rowcount()
								
								w_rdv_feuille_perso.rb_un.checked = true
								w_rdv_feuille_perso.rb_un.triggerevent(clicked!)
	
								for ligpra = 1 to totpra
								
									v_code_praticien = dw_prati.GetItemString(ligpra, "code")
									w_rdv_feuille_perso.dw_prati.Setitem(1,"code", v_code_praticien)
	
									w_rdv_feuille_perso.cb_ecran.triggerevent(clicked!)
									
									if w_rdv_feuille_perso.dw_liste.rowcount() > 0 then
										for cpt = 1 to nb_exemplaires 
											w_rdv_feuille_perso.cb_imprimer.triggerevent(clicked!)
										next
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour le code praticien : " + v_code_praticien)
									else
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour le code praticien : " + v_code_praticien)
									end if
									
								next
	
							else
								
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTP_praticiens","T") = "T" then
									w_rdv_feuille_perso.rb_tous.checked = true
									w_rdv_feuille_perso.rb_tous.triggerevent(clicked!)
								else
									w_rdv_feuille_perso.rb_un.checked = true
									w_rdv_feuille_perso.rb_un.triggerevent(clicked!)
									v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTP_code_praticien","")
									w_rdv_feuille_perso.dw_prati.Setitem(1,"code", v_code_praticien)
								end if
								
								w_rdv_feuille_perso.cb_ecran.triggerevent(clicked!)
								
								if w_rdv_feuille_perso.dw_liste.rowcount() > 0 then
									for cpt = 1 to nb_exemplaires 
										w_rdv_feuille_perso.cb_imprimer.triggerevent(clicked!)
									next
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTP_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour le code praticien : " + v_code_praticien)
									end if
								else
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTP_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour le code praticien : " + v_code_praticien)
									end if
								end if
							end if
							
							w_rdv_feuille_perso.cb_fermer.triggerevent(clicked!)
							
						//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
						case 'PLA'					// Planning d'une journée
							
							open(w_rdv_planning)
							
							// lecture des paramètres
							w_rdv_planning.em_faut_min.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","PLA_fauteuil1","0")
							w_rdv_planning.em_faut_max.text = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","PLA_fauteuil2","99")
	
							nb_exemplaires = integer(ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","FTA_exemplaires","1"))
	
							if hour(now()) >= 12 then
								// si lancé l'AM ou le soir, c'est pour le lendemain, 
								w_rdv_planning.em_date.SetDate( relativedate(today() , 1 ))
							else
								w_rdv_planning.em_date.SetDate( today() )
							end if
							
							
							if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","PLA_praticiens","T") =  "C"  then 
								// On doit boucler sur tous les praticiens !!!
								
								totpra = dw_prati.rowcount()
								
								w_rdv_planning.rb_un.checked = true
								w_rdv_planning.rb_un.triggerevent(clicked!)
	
								for ligpra = 1 to totpra
								
									v_code_praticien = dw_prati.GetItemString(ligpra, "code")
									w_rdv_planning.dw_prati.Setitem(1,"code", v_code_praticien)
	
									w_rdv_planning.cb_ecran.triggerevent(clicked!)
									
									if w_rdv_planning.dw_liste.rowcount() > 0 then
										for cpt = 1 to nb_exemplaires 
											w_rdv_planning.cb_imprimer.triggerevent(clicked!)
										next
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour le code praticien : " + v_code_praticien)
									else
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour le code praticien : " + v_code_praticien)
									end if
									
								next
	
							else
								
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","PLA_praticiens","T") = "T" then
									w_rdv_planning.rb_tous.checked = true
									w_rdv_planning.rb_tous.triggerevent(clicked!)
								else
									w_rdv_planning.rb_un.checked = true
									w_rdv_planning.rb_un.triggerevent(clicked!)
									v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","PLA_code_praticien","")
									w_rdv_planning.dw_prati.Setitem(1,"code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","PLA_code_praticien",""))
								end if
								
								w_rdv_planning.cb_ecran.triggerevent(clicked!)
								
								if w_rdv_planning.dw_liste.rowcount() > 0 then
									for cpt = 1 to nb_exemplaires 
										w_rdv_planning.cb_imprimer.triggerevent(clicked!)
									next
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","PLA_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Liste imprimée pour le code praticien : " + v_code_praticien)
									end if
								else
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","PLA_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Aucune liste à imprimer pour le code praticien : " + v_code_praticien)
									end if
								end if
							end if
							
							w_rdv_planning.cb_fermer.triggerevent(clicked!)
	
	
	
						//------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
						case 'DEP'					// Renouvellement des DEP
							
							open(w_liste_patients_renouve_nvlle)
	
							// pour les dates ...
							if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", "DEP_periode","M") = "M" then
								// Mois prochain ...
								w_liste_patients_renouve_nvlle.em_date_min.SetDate(debut_mois_suivant(today()))
								w_liste_patients_renouve_nvlle.em_date_max.SetDate(fin_mois_suivant(today()))
							else
								// Semaine prochaine
								integer numjour 
								date lundi_prochain
								numjour = daynumber(today())
								lundi_prochain = relativedate(today() , 7 - numjour + 1)
								w_liste_patients_renouve_nvlle.em_date_min.SetDate( lundi_prochain )
								w_liste_patients_renouve_nvlle.em_date_max.SetDate(relativedate( lundi_prochain, 6))
							end if
							
	
							// Options
	
							// le reste
							if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", "DEP_commentaire","N") = "O" then
								w_liste_patients_renouve_nvlle.cbx_commentaire.checked = true
							else
								w_liste_patients_renouve_nvlle.cbx_commentaire.checked = false
							end if
							if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", "DEP_prochain_rdv","N") = "O" then
								w_liste_patients_renouve_nvlle.cbx_prochain_rdv.checked = true
							else
								w_liste_patients_renouve_nvlle.cbx_prochain_rdv.checked = false
							end if
							if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", "DEP_deja_imprime","O") = "O" then
								w_liste_patients_renouve_nvlle.cbx_deja_imprime.checked = true
							else
								w_liste_patients_renouve_nvlle.cbx_deja_imprime.checked = false
							end if
							
							if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", "DEP_tri","P") = "P" then
								w_liste_patients_renouve_nvlle.rb_patient.checked = true
								w_liste_patients_renouve_nvlle.rb_caisse.checked = false
							else
