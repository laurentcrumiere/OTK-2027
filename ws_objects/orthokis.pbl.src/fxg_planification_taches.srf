										v_code_praticien = dw_prati.GetItemString(ligpra, "code")
										
										if v_exclus = "N" or (v_exclus = "O" and v_praticien_exclus <> v_code_praticien) then 
											w_liste_patients_rappel_rdv_email.dw_prati.Setitem(1,"code", v_code_praticien)
											w_liste_patients_rappel_rdv_email.prepa_faite = false
											w_liste_patients_rappel_rdv_email.cb_ecran.triggerevent(clicked!)
											
										
											if w_liste_patients_rappel_rdv_email.dw_liste.rowcount() > 0 then
												// Envoi des emails
												w_liste_patients_rappel_rdv_email.pb_envoyer.triggerEvent(clicked!)
												fxg_ajout_journal_planification(v_code, "Envoi des emails pour le code praticien : " + v_code_praticien)
												w_liste_patients_rappel_rdv_email.cb_autre.triggerEvent(clicked!)
											end if
										end if
									next
								else
									// pour 1 ou tous les praticiens
									if v_exclus = "O" then
										w_liste_patients_rappel_rdv_email.cbx_exclus.checked = true
										w_liste_patients_rappel_rdv_email.dw_prati2.Setitem(1,"code", v_praticien_exclus )
									end if
									
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","rrv_praticiens","T") = "T" then
										w_liste_patients_rappel_rdv_email.rb_tous.checked = true
										w_liste_patients_rappel_rdv_email.rb_tous.triggerevent(clicked!)
									else
										w_liste_patients_rappel_rdv_email.rb_un.checked = true
										
//										v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","rmu_code_praticien","")
//										w_liste_patients_rappel_rdv_email.dw_prati.Setitem(1,"code", v_code_praticien )
//										w_liste_patients_rappel_rdv_email.rb_un.triggerevent(clicked!)
	
										v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","rrv_code_praticien","")
										w_liste_patients_rappel_rdv_email.dw_prati.Setitem(1,"code", v_code_praticien )
										w_liste_patients_rappel_rdv_email.rb_un.triggerevent(clicked!)
									end if
									
									// La gestion de la pièce jointe est faite directement dans fxg_envoi_email_libre
									
									
									w_liste_patients_rappel_rdv_email.cb_ecran.triggerevent(clicked!)
									
									if w_liste_patients_rappel_rdv_email.dw_liste.rowcount() > 0 then
										// Envoi des email
										w_liste_patients_rappel_rdv_email.pb_envoyer.triggerEvent(clicked!)
										if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","rrv_praticiens","T") = "T" then
											fxg_ajout_journal_planification(v_code, "Envoi des emails pour tous les praticiens")
										else
											fxg_ajout_journal_planification(v_code, "Envoi des emails pour le code praticien : " + v_code_praticien)
										end if
									end if
								
								end if
								
								close(w_liste_patients_rappel_rdv_email)
								
							Case "QMV"
								
								// Liste des Questionnaires Médicaaux non validés
								open(w_liste_patients_questionnaire_medical_non_valide)
								
								// pour les dates ...
								v_j1 = integer(ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", "qmv_j1","1"))
								v_j2 = integer(ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", "qmv_j2","1"))
								
								w_liste_patients_questionnaire_medical_non_valide.em_date_min.setDate ( Relativedate(today(), v_j1) )
								w_liste_patients_questionnaire_medical_non_valide.em_date_max.setDate ( Relativedate(today(), v_j2) )
	
						
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","qmv_praticiens","T") =  "C"  then 
									// On doit boucler sur tous les praticiens !!!
									
									totpra = dw_prati.rowcount()
									
									w_liste_patients_questionnaire_medical_non_valide.rb_un.checked = true
									w_liste_patients_questionnaire_medical_non_valide.rb_un.triggerevent(clicked!)
	
									for ligpra = 1 to totpra
									
										v_code_praticien = dw_prati.GetItemString(ligpra, "code")
										w_liste_patients_questionnaire_medical_non_valide.dw_prati.Setitem(1,"code", v_code_praticien)
										w_liste_patients_questionnaire_medical_non_valide.prepa_faite = false
										w_liste_patients_questionnaire_medical_non_valide.cb_ecran.triggerevent(clicked!)
										
									
										if w_liste_patients_questionnaire_medical_non_valide.dw_liste.rowcount() > 0 then
											// Impression de la liste
											w_liste_patients_questionnaire_medical_non_valide.cb_imprimer.triggerEvent(clicked!)
											fxg_ajout_journal_planification(v_code, "Liste imprimée pour le code praticien : " + v_code_praticien)
											w_liste_patients_questionnaire_medical_non_valide.cb_autre.triggerEvent(clicked!)
										end if
									next
								else
									// pour 1 ou tous les praticiens
																		
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","qmv_praticiens","T") = "T" then
										w_liste_patients_questionnaire_medical_non_valide.rb_tous.checked = true
										w_liste_patients_questionnaire_medical_non_valide.rb_tous.triggerevent(clicked!)
									else
										w_liste_patients_questionnaire_medical_non_valide.rb_un.checked = true
										w_liste_patients_questionnaire_medical_non_valide.rb_un.triggerevent(clicked!)
										v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","qmv_code_praticien","")
										w_liste_patients_questionnaire_medical_non_valide.dw_prati.Setitem(1,"code", v_code_praticien )
									end if
									
									w_liste_patients_questionnaire_medical_non_valide.cb_ecran.triggerevent(clicked!)
									
									if w_liste_patients_questionnaire_medical_non_valide.dw_liste.rowcount() > 0 then
										// Impression
										w_liste_patients_questionnaire_medical_non_valide.cb_imprimer.triggerEvent(clicked!)
										if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","qmv_praticiens","T") = "T" then
											fxg_ajout_journal_planification(v_code, "Liste imprimée pour tous les praticiens")
										else
											fxg_ajout_journal_planification(v_code, "Liste imprimée pour le code praticien : " + v_code_praticien)
										end if
									end if
								
								end if
								
								close(w_liste_patients_questionnaire_medical_non_valide)
								
								
							Case "MAJDOS"
								
								// Correction des types de dossiers
								open(w_liste_patients_incoherence_type_dossier)
								
								// pour 1 ou tous les praticiens
																	
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","majdos_praticiens","T") = "T" then
									w_liste_patients_incoherence_type_dossier.rb_tous.checked = true
									w_liste_patients_incoherence_type_dossier.rb_tous.triggerevent(clicked!)
								else
									w_liste_patients_incoherence_type_dossier.rb_un.checked = true
									w_liste_patients_incoherence_type_dossier.rb_un.triggerevent(clicked!)
									v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","majdos_code_praticien","")
									w_liste_patients_incoherence_type_dossier.dw_prati.Setitem(1,"code", v_code_praticien )
								end if
								
								w_liste_patients_incoherence_type_dossier.cb_ecran.triggerevent(clicked!)
								
								if w_liste_patients_incoherence_type_dossier.dw_liste.rowcount() > 0 then
									// correction
									w_liste_patients_incoherence_type_dossier.pb_corriger.triggerEvent(clicked!)
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","majdos_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Correction pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Correction pour le code praticien : " + v_code_praticien)
									end if
								end if
								
								
								close(w_liste_patients_incoherence_type_dossier)
								
							Case "ARCDOS"
								
								// Archivage automatique des dossiers
								open(w_archivage_automatique)
								
								// pour 1 ou tous les praticiens
																	
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","arcdos_praticiens","T") = "T" then
									w_archivage_automatique.rb_tous.checked = true
									w_archivage_automatique.rb_tous.triggerevent(clicked!)
								else
									w_archivage_automatique.rb_un.checked = true
									w_archivage_automatique.rb_un.triggerevent(clicked!)
									v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","arcdos_code_praticien","")
									w_archivage_automatique.dw_prati.Setitem(1,"code", v_code_praticien )
								end if
								
								w_archivage_automatique.cb_ecran.triggerevent(clicked!)
								
								if w_archivage_automatique.dw_liste.rowcount() > 0 then
									// archivage
									w_archivage_automatique.cb_archivage.triggerEvent(clicked!)
									if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","arcdos_praticiens","T") = "T" then
										fxg_ajout_journal_planification(v_code, "Archivage pour tous les praticiens")
									else
										fxg_ajout_journal_planification(v_code, "Archivage pour le code praticien : " + v_code_praticien)
									end if
								end if
								
								
								close(w_archivage_automatique)							
								
						case 'ARV'  // Patient selon l'état de rdv => envoi de mail absents
	
								open(w_liste_patients_absents_rdv)
								
								// pour 1 ou tous les praticiens
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code + "_praticiens","T") = "T" then
									w_liste_patients_absents_rdv.rb_tous.checked = true
									w_liste_patients_absents_rdv.rb_tous.triggerevent(clicked!)
								else
									w_liste_patients_absents_rdv.rb_un.checked = true
									w_liste_patients_absents_rdv.rb_un.triggerevent(clicked!)
									v_code_praticien = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION",v_code  + "_code_praticien","")
									w_liste_patients_absents_rdv.dw_prati.Setitem(1,"code", v_code_praticien )
								end if 
							
							
								// pour les dates ...
								v_j1 =  - integer(ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code + "_j1","1"))
								v_j2 = - integer(ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code + "_j2","1"))
								
								w_liste_patients_absents_rdv.em_date_min.setDate ( Relativedate(today(), v_j1) )
								w_liste_patients_absents_rdv.em_date_max.setDate ( Relativedate(today(), v_j2) )
								
					
								// Elimination prochains rdv
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code + "_absence_next","O") = "O"  then 
									w_liste_patients_absents_rdv.cbx_next.checked = true
								else
									w_liste_patients_absents_rdv.cbx_next.checked = false
								end if
					
								if ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code + "_absence_next_2","O") = "O"  then 
									w_liste_patients_absents_rdv.cbx_next_2.checked = true
								else
									w_liste_patients_absents_rdv.cbx_next_2.checked = false
								end if

								// Etat de rendez-vous
								w_liste_patients_absents_rdv.dw_etat.SetItem ( 1 , "code", ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION", v_code +"_absence_etat","N"))
								
								// Liste à l''écran
								w_liste_patients_absents_rdv.cb_ecran.triggerevent(clicked!)
							
								// Envoi du mail
								fxg_envoi_email_libre(0, w_liste_patients_absents_rdv.dw_liste, 11)
								
								close(w_liste_patients_absents_rdv)
	
	
						end choose
				
				end if		
			
			next
			
			trace ( "*** FIN DE LA PLANIFICATION ***")
			
			if SERIAL = '87432' then 
				trace ( "*** DEBUT DE L'EXAMEN DE LA PLANIFICATION SPECIFIQUE POUR 87432 ***")
				
				fxg_ajout_journal_planification('******', "*** DEBUT DE L'EXAMEN DE LA PLANIFICATION POUR 87432 ***")
				
				
				// Variables spécifiques pour le paramétrages
			
				integer i_jour_semaine_87432 = 2		// Exécution tous les lundi

				
				string s_nom_fichier_pdf_87432 , s_nom_fichier_xls_87432
				string s_objet_email_87432  = "Envoi automatique - Livre de recettes S-1"
 				string s_texte_email_87432  = "Bonjour,~n~nVeuillez trouver ci-joint le livre de recettes de la semaine précédente.~n~nCordialement,~n~nLe Cabinet du Dr Fazaiee"
 				string s_adresse_email_destination_87432 = "vbonnefond@cabinetalcyon.fr; docteur@fazaiee.fr"
			
				// pour les tests
				//	s_adresse_email_destination_87432 = "laurent.crumiere@arakis.fr"
				//i_jour_semaine_87432 = 5
				
				integer i_compte_email_depart_87432 = 2	// compte en dur de cabinet_fin@fazaiee.fr
				uo_email_compte cpt_email_87432
				uo_email_manager email_manager_87432
				uo_email_email email_email_87432
				
				s_nom_fichier_pdf_87432 = dir_ini + string(today(), "yyyy-mm-dd") + "-Livre_recettes_Dr_Fazaie.pdf"
				s_nom_fichier_xls_87432 = dir_ini + string(today(), "yyyy-mm-dd") + "-Livre_recettes_Dr_Fazaie.xls"

				if daynumber(today()) = i_jour_semaine_87432 then 
					
					
					// Génération du livre de recettes en PDF
					w_liste_patients_livre_recettes w1
					open(w1)
					w1.hide()
					
					// tous les praticiens
					w1.rb_tous.checked = true
					w1.rb_un.checked = false
					
					// Options d'impressions
					w1.cbx_nom.checked = true
					w1.cbx_dos.checked = true
					w1.cbx_nom_payeur.checked = true
					w1.cbx_moulage.checked = false
					w1.cbx_facture.checked = false
					w1.cbx_nomen.checked = false
					w1.cbx_commentaire.checked = false
					
					
					// type de soins
					w1.rb_toussoins.checked = true
					w1.rb_unsoin.checked = false
					
					// banque
					w1.rb_toutes_banques.checked = true
					w1.rb_une_banque.checked = false
					
					// Ordre de tri
					w1.rb_tri_payeur.checked = true
					w1.rb_tri_saisie.checked = false
					
					// Modes de paiement
					w1.rb_tous_modes.checked = true
					w1.rb_un_mode.checked = false
					
					// Dates .. de J-7 à J-1
					w1.em_date_min.text = string(relativedate(today() ,  - 7))
					w1.em_date_max.text = string(relativedate(today() ,  - 1))

					w1.cb_ecran.triggerevent(clicked!)
					FileDelete (s_nom_fichier_pdf_87432)
					w1.dw_liste.saveas(s_nom_fichier_pdf_87432, pdf!, true )
					if not FileExists(s_nom_fichier_pdf_87432) then 
						
						Messagebox("ATTENTION", "Erreur dans la génération du fichier PDF : " + s_nom_fichier_pdf_87432 )
						fxg_ajout_journal_planification('******', "*** Erreur dans la génération du fichier PDF : " + s_nom_fichier_pdf_87432 +" ***")
						trace("*** Erreur dans la génération du fichier PDF : " + s_nom_fichier_pdf_87432 +" ***")
						
					else
						// Préparation de l'email 
						
						// on ajouter aussi une version Excel
						w1.dw_liste.saveas(s_nom_fichier_xls_87432, Excel8!, true )
						
						cpt_email_87432 = create uo_email_compte
						cpt_email_87432.charger(i_compte_email_depart_87432)
						
						email_manager_87432 = create uo_email_manager
						email_manager_87432.set_compte(cpt_email_87432)
						email_manager_87432.propos_objet = s_objet_email_87432
						
						// Initialisation du mail
						email_email_87432 = create uo_email_email	
						email_email_87432.add_destinataire_a(s_adresse_email_destination_87432, false)
						email_email_87432.set_from(cpt_email_87432.my_alias,cpt_email_87432.my_adr)
						email_email_87432.set_sujet(email_manager_87432.propos_objet)
						email_email_87432.set_body(s_texte_email_87432)						
						email_email_87432.add_fichier_joint(s_nom_fichier_pdf_87432)
						email_email_87432.add_fichier_joint(s_nom_fichier_xls_87432)

						// Envoi effectif du mail
						if email_manager_87432.envoyer_email(email_email_87432.get_email()) then 
								fxg_ajout_journal_planification('******', "*** Envoi livre de recettes par mail : " + s_nom_fichier_pdf_87432 +" ***")
								trace("*** Envoi du livre de recettes par mail : " + s_nom_fichier_pdf_87432 +" ***")
						else
								fxg_ajout_journal_planification('******', "*** Erreur d'en l'envoi du livre de recettes par mail ! ***")
								trace("*** Erreur d'en l'envoi du livre de recettes par mail ! ***")
						
						end if
						
						
						// Suppression des fichiers PDF er Excel
						FileDelete(s_nom_fichier_pdf_87432)
						FileDelete(s_nom_fichier_xls_87432)
						
					end if
					
					close(w_liste_patients_livre_recettes)
					
				end if
					
				
				
				trace ( "*** FIN DE L'EXAMEN DE LA PLANIFICATION SPECIFIQUE POUR 87432 ***")
				
				fxg_ajout_journal_planification('******', "*** FIN DE L'EXAMEN DE LA PLANIFICATION POUR 87432 ***")

			end if

			
			
			// Fin de la planification !!!!!!!!!!!!!!!!!!!!!
			PLANIFICATION_EN_COURS = false
			
			// On examine le journal pour réperer d'éventuelles erreurs ...
			long nb_erreurs
			string s_libelle_fin = 	"*** FIN DE L'EXAMEN DE LA PLANIFICATION ***"
			string s_poste
			datetime dt_derniere_fin
			s_poste = get_nom_ordinateur()
			
			// Recherche de la date de fin de la dernière planification sur ce poste
			select isnull(max("debut"), getdate()) into :dt_derniere_fin from "planification_journal" where commentaire = :s_libelle_fin and nom_poste = :s_poste ;
			
			
			// Recherche des erreurs produits depuis la denière, sur ce poste
			select isnull(count(*),0) into :nb_erreurs from "planification_journal" where cast(debut as date) > :dt_derniere_fin and commentaire like '%erreur%' and nom_poste = :s_poste ;

			// Ajout de l'info pour ce traitement ....
			fxg_ajout_journal_planification('******', s_libelle_fin )

			if nb_erreurs > 0 then
				if Messagebox("ATTENTION","Des erreurs se sont produites durant l'exécution des taches planifiées !~n~nSouhaitez-vous ouvrir le Journal d'Historisation des Actions ?", Question!, YesNo!, 1) = 1 then
					w_mdi_2020.uo_powerdock.of_openDocument(w_planification_journal, "Journal de la planification", m_orthokis_2020.m_outils.m_traitements.toolbarItemName)
				end if
			end if
		end if
	end if
end if

end subroutine

