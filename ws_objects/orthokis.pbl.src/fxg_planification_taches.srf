								 v_exclus =  ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","rrv_exclus","N") 
								 v_praticien_exclus = ProfileString(dir_ini + inifile_orthokis , "PLANIFICATION","rrv_praticien_exclus","") 
								 
