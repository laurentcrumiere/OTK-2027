table(column=(type=number update=yes updatewhereclause=yes key=yes name=cle dbname="paye.cle" )
 column=(type=date update=yes updatewhereclause=yes key=yes name=date dbname="paye.date" initial="today" )
 column=(type=decimal(2) update=yes updatewhereclause=yes key=yes name=montant dbname="paye.montant" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=mode dbname="paye.mode" )
 column=(type=char(40) update=yes updatewhereclause=yes key=yes name=commentaire dbname="paye.commentaire" )
 column=(type=char(50) update=yes updatewhereclause=yes name=payeur dbname="paye.payeur" )
 column=(type=date update=yes updatewhereclause=yes key=yes name=dateremise dbname="paye.dateremise" initial="today" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tp dbname="paye.tp" initial="N" values="Tiers Payant	O/Tiers Payant	N" )
 column=(type=date updatewhereclause=yes name=transfert dbname="paye.transfert" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="paye.code" )
 column=(type=char(1) update=yes updatewhereclause=yes name=origine_tp dbname="paye.origine_tp" initial=" " values="Patient	 /Caisse	C/Mutuelle	M/" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="paye.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=montant_monnaie dbname="paye.montant_monnaie" )
 column=(type=char(1) update=yes updatewhereclause=yes name=monnaie dbname="paye.monnaie" values="Franc	F/Euro	E/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sur_place dbname="paye.sur_place" initial="O" values="Sur Place	O/Sur Place	N" )
 column=(type=char(6) update=yes updatewhereclause=yes name=banque dbname="paye.banque" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="paye.user_modif" )
 column=(type=datetime update=yes updatewhereclause=yes name=date_modif dbname="paye.date_modif" )
 column=(type=datetime update=yes updatewhereclause=yes name=heure_saisie dbname="paye.heure_saisie" initial="today" )
 column=(type=datetime updatewhereclause=yes name=remises_date_generation dbname="remises.date_generation" )
 column=(type=number update=yes updatewhereclause=yes name=code_remise dbname="paye.code_remise" )
 column=(type=char(50) updatewhereclause=yes name=paye_id_transaction_payline dbname="paye.id_transaction_payline" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"paye~" )  TABLE(NAME=~"remises~" ) COLUMN(NAME=~"paye.cle~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.tp~") COLUMN(NAME=~"paye.transfert~") COLUMN(NAME=~"paye.code~") COLUMN(NAME=~"paye.origine_tp~") COLUMN(NAME=~"paye.code_praticien~") COLUMN(NAME=~"paye.montant_monnaie~") COLUMN(NAME=~"paye.monnaie~") COLUMN(NAME=~"paye.sur_place~") COLUMN(NAME=~"paye.banque~") COLUMN(NAME=~"paye.user_modif~") COLUMN(NAME=~"paye.date_modif~") COLUMN(NAME=~"paye.heure_saisie~") COLUMN(NAME=~"remises.date_generation~") COLUMN(NAME=~"paye.code_remise~") COLUMN(NAME=~"paye.id_transaction_payline~")    JOIN (LEFT=~"paye.code_remise~"    OP =~"=~"RIGHT=~"remises.code~"    OUTER1 =~"paye.code_remise~" )WHERE(    EXP1 =~"~~~"paye~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"cle~~~"~"   OP =~"=~"    EXP2 =~":var_cle~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"montant~~~"~"   OP =~"=~"    EXP2 =~":var_mon~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"date~~~"~"   OP =~"=~"    EXP2 =~":var_date~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"dateremise~~~"~"   OP =~"=~"    EXP2 =~":var_date_rem~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"mode~~~"~"   OP =~"=~"    EXP2 =~":var_mode~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"commentaire~~~"~"   OP =~"=~"    EXP2 =~":var_comment~" ) ) ARG(NAME = ~"var_cle~" TYPE = number)  ARG(NAME = ~"var_code~" TYPE = number)  ARG(NAME = ~"var_mon~" TYPE = number)  ARG(NAME = ~"var_date~" TYPE = date)  ARG(NAME = ~"var_date_rem~" TYPE = date)  ARG(NAME = ~"var_mode~" TYPE = string)  ARG(NAME = ~"var_comment~" TYPE = string) " update="paye" updatewhere=0 updatekeyinplace=no arguments=(("var_cle", number),("var_code", number),("var_mon", number),("var_date", date),("var_date_rem", date),("var_mode", string),("var_comment", string)) )
