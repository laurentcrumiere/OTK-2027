table(column=(type=char(200) update=yes updatewhereclause=yes name=nom dbname="code_soins.nom" initial=" " )
 column=(type=char(10) update=yes updatewhereclause=yes name=lettre dbname="code_soins.lettre" initial=" " )
 column=(type=char(1) update=yes updatewhereclause=yes name=renouvt dbname="code_soins.renouvt" initial="N" values="Oui	O/Non	N/" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=depasse dbname="code_soins.depasse" initial="0" )
 column=(type=char(1) update=yes updatewhereclause=yes name=date_dem dbname="code_soins.date_dem" initial="N" values="Oui	O/Non	N/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tp dbname="code_soins.tp" initial="O" values="Oui	O/Non	N/" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=nb_lettre dbname="code_soins.nb_lettre" initial="1" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=duree dbname="code_soins.duree" initial="0" )
 column=(type=char(1) update=yes updatewhereclause=yes name=barre_avancement dbname="code_soins.barre_avancement" initial="N" values="Oui	O/Non	N/" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=code dbname="code_soins.code" )
 column=(type=long update=yes updatewhereclause=yes name=actif dbname="code_soins.actif" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=ordre_trie dbname="code_soins.ordre_trie" initial="100" )
 column=(type=char(1) update=yes updatewhereclause=yes name=nature dbname="code_soins.nature" initial="N" values="NGAP	N/CCAM	C/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=execution_immediate dbname="code_soins.execution_immediate" initial="O" values="Exécution immédiate	O/Exécution immédiate	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pour_qui dbname="code_soins.pour_qui" initial="D" values="un Enfant	E/un Adulte	A/les Deux	D/" )
 column=(type=long update=yes updatewhereclause=yes name=coefficient_p dbname="code_soins.coefficient_p" initial="0" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=valeur dbname="code_soins.valeur" initial="0" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=total dbname="code_soins.total" initial="0" )
 column=(type=char(1) update=yes updatewhereclause=yes name=type_maj dbname="code_soins.type_maj" values="Mise à jour Internet	I/Mise à jour Manuelle	M/" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="code_soins.user_modif" )
 column=(type=date update=yes updatewhereclause=yes name=date_modif dbname="code_soins.date_modif" )
 column=(type=char(30) updatewhereclause=yes name=utilisateurs_nom dbname="utilisateurs.nom" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=inter_inami_avec dbname="code_soins.inter_inami_avec" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=inter_inami_sans dbname="code_soins.inter_inami_sans" )
 column=(type=number update=yes updatewhereclause=yes name=couleur_barre_avancement dbname="code_soins.couleur_barre_avancement" )
 column=(type=number update=yes updatewhereclause=yes name=couleur_fond_barre_avancement dbname="code_soins.couleur_fond_barre_avancement" )
 column=(type=char(3) update=yes updatewhereclause=yes name=code_soins_code_association dbname="code_soins.code_association" )
 column=(type=char(2) update=yes updatewhereclause=yes name=code_soins_type_dossier_attendu dbname="code_soins.type_dossier_attendu" )
 column=(type=char(1) update=yes updatewhereclause=yes name=code_soins_decomposition dbname="code_soins.decomposition" values="Décomposition 2 parties	O/Décomposition 2 parties	N" )
 column=(type=number update=yes updatewhereclause=yes name=couleur_fond dbname="code_soins.couleur_fond" )
 column=(type=char(1) update=yes updatewhereclause=yes name=fs dbname="code_soins.fs" initial="O" values="Oui	O/Non	N/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=exo_defaut dbname="code_soins.exo_defaut" values="Pas d'exonération	0/Soins particuliers exonérés	3/Soins dispo. prévention	7/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=remboursement_exceptionnel_defaut dbname="code_soins.remboursement_exceptionnel_defaut" initial="N" values="Remb. Exceptionnel par défaut :	O/Remb. Exceptionnel par défaut :	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pseudocode dbname="code_soins.pseudocode" initial="N" values="	O/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=categorie_pseudocode dbname="code_soins.categorie_pseudocode" values="1. Consultations	1/2. Soins préventifs	2/3. Extractions	3/4. Parodontologie	4/5. Soins conservateurs	5/6. Orthodontie	6/7. Prothèses	7/8. Implants Oraux	8/9. Radiologie	9/10. Stomatologie	10/11. Honor. pour prestations tech. urgentes	11/12. Couronnes et bridges	12/13. Trauma	13/14. Divers	14/15. Traitements de l’appareil masticatoire	15/" )
 column=(type=char(4) update=yes updatewhereclause=yes name=modificateurs_defaut dbname="code_soins.modificateurs_defaut" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"utilisateurs~" ) COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"code_soins.renouvt~") COLUMN(NAME=~"code_soins.depasse~") COLUMN(NAME=~"code_soins.date_dem~") COLUMN(NAME=~"code_soins.tp~") COLUMN(NAME=~"code_soins.nb_lettre~") COLUMN(NAME=~"code_soins.duree~") COLUMN(NAME=~"code_soins.barre_avancement~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"code_soins.actif~") COLUMN(NAME=~"code_soins.ordre_trie~") COLUMN(NAME=~"code_soins.nature~") COLUMN(NAME=~"code_soins.execution_immediate~") COLUMN(NAME=~"code_soins.pour_qui~") COLUMN(NAME=~"code_soins.coefficient_p~") COLUMN(NAME=~"code_soins.valeur~") COLUMN(NAME=~"code_soins.total~") COLUMN(NAME=~"code_soins.type_maj~") COLUMN(NAME=~"code_soins.user_modif~") COLUMN(NAME=~"code_soins.date_modif~") COLUMN(NAME=~"utilisateurs.nom~") COLUMN(NAME=~"code_soins.inter_inami_avec~") COLUMN(NAME=~"code_soins.inter_inami_sans~") COLUMN(NAME=~"code_soins.couleur_barre_avancement~") COLUMN(NAME=~"code_soins.couleur_fond_barre_avancement~") COLUMN(NAME=~"code_soins.code_association~") COLUMN(NAME=~"code_soins.type_dossier_attendu~") COLUMN(NAME=~"code_soins.decomposition~") COLUMN(NAME=~"code_soins.couleur_fond~") COLUMN(NAME=~"code_soins.fs~") COLUMN(NAME=~"code_soins.exo_defaut~") COLUMN(NAME=~"code_soins.remboursement_exceptionnel_defaut~") COLUMN(NAME=~"code_soins.pseudocode~") COLUMN(NAME=~"code_soins.categorie_pseudocode~") COLUMN(NAME=~"code_soins.modificateurs_defaut~")    JOIN (LEFT=~"code_soins.user_modif~"    OP =~"=~"RIGHT=~"utilisateurs.code~"    OUTER1 =~"code_soins.user_modif~" )WHERE(    EXP1 =~"~~~"code_soins~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":code~" ) ) ARG(NAME = ~"code~" TYPE = string) " update="code_soins" updatewhere=0 updatekeyinplace=no arguments=(("code", string)) )
