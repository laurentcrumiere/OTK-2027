table(column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(20) update=yes updatewhereclause=yes name=dossier_nom dbname="dossier.nom" dbalias=".nom" )
 column=(type=long updatewhereclause=yes name=cnombre dbname="nombre" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 column=(type=char(6) updatewhereclause=yes name=prati_code dbname="prati.code" dbalias=".code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dossier~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"dossier.nom~") COMPUTE(NAME=~"(SELECT count(*) AS nombre FROM patient WHERE code_praticien = prati.code and type_dossier = dossier.code  and  patient.code > 0)~") COLUMN(NAME=~"prati.prenom~") COLUMN(NAME=~"prati.code~")WHERE(    EXP1 =~"~~~"prati~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) "  sort="prati_nom A prati_prenom A prati_code A dossier_nom A " )
