on m_btdroit_reglements.create
m_btdroit_reglements=this
call super::create
this.text = "m_btdroit_reglements"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_reportertroppercupatient=create m_reportertroppercupatient
this.m_reportertroppercucaisse=create m_reportertroppercucaisse
this.m_reportertroppercumutuelle=create m_reportertroppercumutuelle
this.m_reportertroppercupatientfratrie=create m_reportertroppercupatientfratrie
this.m_0=create m_0
this.m_déplacerlerèglement=create m_déplacerlerèglement
this.m_informationsdemodifications=create m_informationsdemodifications
this.Item[UpperBound(this.Item)+1]=this.m_reportertroppercupatient
this.Item[UpperBound(this.Item)+1]=this.m_reportertroppercucaisse
this.Item[UpperBound(this.Item)+1]=this.m_reportertroppercumutuelle
this.Item[UpperBound(this.Item)+1]=this.m_reportertroppercupatientfratrie
this.Item[UpperBound(this.Item)+1]=this.m_0
this.Item[UpperBound(this.Item)+1]=this.m_déplacerlerèglement
this.Item[UpperBound(this.Item)+1]=this.m_informationsdemodifications
end on

on m_btdroit_reglements.destroy
call super::destroy
destroy(this.m_reportertroppercupatient)
destroy(this.m_reportertroppercucaisse)
destroy(this.m_reportertroppercumutuelle)
destroy(this.m_reportertroppercupatientfratrie)
destroy(this.m_0)
destroy(this.m_déplacerlerèglement)
destroy(this.m_informationsdemodifications)
end on

type m_reportertroppercupatient from menu within m_btdroit_reglements
end type

event clicked;// reporte le trop perçu du soins sur le prochain soin qui reste dû

datawindow dw_reg, dw_soins, dw_reglements
long lig_reg,  lig_soins, tot_soins, v_cle_soin, totlig

string v_user_modif
datetime v_date_modif
datetime v_heure_saisie
double v_code_remise
date v_transfert

decimal {2} v_montant_soins, v_montant_paye, v_montant_trop, due_soin, v_paye_soins, v_total_soins, v_montant_ajout

// tous les reglements du soins
dw_reglements = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements

// reglementds qu'on va ajouter
dw_reg = w_click_soins_reg.dw_reg

// tous les soins
dw_soins = w_click_soins_reg.dw_soins
lig_reg = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getrow()


v_cle_regl =  w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemNumber(lig_reg, "cle") 
v_code_regl =  w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemNumber(lig_reg, "code") 
v_mon = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemNumber(lig_reg, "montant") 
v_date = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemDate(lig_reg, "date") 
v_date_rem = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemDate(lig_reg, "dateremise") 
v_mode = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemString(lig_reg, "mode") 
v_comment = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemString(lig_reg, "commentaire") 

v_user_modif = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemString(lig_reg, "user_modif") 
v_date_modif = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemDatetime(lig_reg, "date_modif") 
v_code_remise = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemNumber(lig_reg, "code_remise") 
v_transfert = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemDate(lig_reg, "transfert") 
v_heure_saisie = w_click_soins_reg.tab_1.tabpage_reglements.dw_reglements.getitemDatetime(lig_reg, "heure_saisie") 




dw_reg.settransobject(sqlca)
dw_reg.retrieve(v_cle_regl,v_code_regl,v_mon,v_date,v_date_rem,v_mode,v_comment)

if dw_reg.rowcount() < 1 then
	
	Messagebox("ATTENTION", "Problème dans l'identification du règlement.")
	
else
	
	
	// Y a t il un trop perçu ?
	
	// Montant dû à ce jour
	SELECT isnull(sum(montant),0) into :v_montant_soins FROM ligne_soins 
	WHERE ligne_soins.code = :v_code_regl and ligne_soins.cle = :v_cle_regl and ligne_soins.tp <> 'O' and ligne_soins."date" <= cast(getdate() as date) ;
	
	// Montant payé sur le soin - On limite pas la date si saisie des chèque à l'avance (meme si pas conseillé)
	SELECT isnull(sum(montant),0) into :v_montant_paye FROM paye 
	WHERE paye.code = :v_code_regl and paye.cle = :v_cle_regl and paye.tp <> 'O'  ;

	
	
	if v_montant_paye > v_montant_soins then
		
		
		v_montant_trop = min( v_mon, v_montant_paye - v_montant_soins )
		
	
		// Y a t il une ligne suivante ?
		lig_soins = dw_soins.getrow()
		
		if lig_soins = dw_soins.rowcount() then
			MessageBox("ATTENTION", "Il n'y a pas de soin suivant pour pouvoir affecter le trop perçu.")
		else
			
			if MessageBox("ATTENTION", "Confirmez-vous le report de "+ string(v_montant_trop) + " € sur les soins suivants ?", Question!, YesNo!, 2) = 1 then
			
				// soins suivants
				lig_soins = lig_soins + 1
				do while lig_soins <= dw_soins.rowcount() and v_montant_trop > 0 
					
					// Somme due sur ce soins 
					v_cle_soin = dw_soins.getitemNumber(lig_soins, "cle") 
					v_total_soins = dw_soins.getitemNumber(lig_soins, "total") 
					
					// On considère le montant total du soin, pas que à ce jour ...
					select isnull(sum(montant),0) into :v_paye_soins from paye where paye.code = :v_code_regl and paye.cle = :v_cle_soin and paye.tp <> 'O'  ;
					
					due_soin = v_total_soins - v_paye_soins
					
					if due_soin > 0 then
							// Ajout du règlement 
							v_montant_ajout = min(due_soin, v_montant_trop)
							dw_reg.insertrow(0)
							
							totlig = dw_reg.rowcount()
							dw_reg.setitem(totlig,"code",v_code_regl)
							dw_reg.setitem(totlig,"cle",v_cle_soin)
							dw_reg.setitem(totlig,"date",dw_reg.getitemdate(1,"date"))
							dw_reg.setitem(totlig,"monnaie",dw_reg.getitemstring(1,"monnaie"))
							dw_reg.setitem(totlig,"origine_tp",dw_reg.getitemstring(1,"origine_tp"))
							dw_reg.setitem(totlig,"tp",dw_reg.getitemstring(1,"tp"))
							dw_reg.setitem(totlig,"mode",dw_reg.getitemstring(1,"mode"))
							dw_reg.setitem(totlig,"commentaire",dw_reg.getitemstring(1,"commentaire"))
							dw_reg.setitem(totlig,"payeur",dw_reg.getitemstring(1,"payeur"))
							dw_reg.setitem(totlig,"dateremise",dw_reg.getitemdate(1,"dateremise"))
							dw_reg.setitem(totlig,"sur_place",dw_reg.getitemstring(1,"sur_place"))
							dw_reg.setitem(totlig,"code_praticien",dw_reg.getitemstring(1,"code_praticien"))
							dw_reg.setitem(totlig,"banque",dw_reg.getitemstring(1,"banque"))
	
							dw_reg.setitem(totlig,"montant_monnaie", v_montant_ajout)
							dw_reg.setitem(totlig,"montant", v_montant_ajout)
							
							dw_reg.setitem(totlig,"user_modif", v_user_modif)
							dw_reg.setitem(totlig,"date_modif", v_date_modif)
							dw_reg.setitem(totlig,"code_remise", v_code_remise)
							dw_reg.setitem(totlig,"transfert", v_transfert)
//							dw_reg.setitem(totlig,"heure_saisie", v_heure_saisie)

							
							v_montant_trop = v_montant_trop - v_montant_ajout
							
							// On déduie du montant de la 1ère ligne
							
							dw_reg.setitem(1,"montant", dw_reg.GetitemNumber(1,"montant") - v_montant_ajout )
							dw_reg.setitem(1,"montant_monnaie", dw_reg.GetitemNumber(1,"montant_monnaie") - v_montant_ajout )
					end if
					
					lig_soins = lig_soins + 1
				loop
				
				if dw_reg.GetitemNumber(1,"montant") = 0 then 
					// Le 1er règlement devient inutile	=> on supprime
					dw_reg.deleterow(1)
				end if
				
				// On mémorise
				if dw_reg.update() = 1 then
					commit ;
				else
					rollback ; 
					Messagebox("ATTENTION", "Erreur dans la mémorisation du trop perçu.")
				end if
				
				// on régénère 
				w_click_soins_reg.cb_rafraichir.triggerevent(clicked!)
			end if
			
		end if
		
		
	else
		Messagebox("ATTENTION", "Il n'y a pas de trop perçu par le Patient sur ce soin.")
	end if
end if

end event

