type pb_visiodent from uo_picturebutton_390x120 within tabpage_reglements
integer x = 1609
integer y = 544
integer width = 416
integer taborder = 400
string text = "Veasy"
end type

event clicked;call super::clicked;

// Envoie tous les soins sélectionnés à VISIODENT

long lig, tot, ligne_courante
double v_code_patient, v_clef
string v_nom_soins
date v_date_demande
integer cpt_ok

tot =  dw_soins.rowcount()
ligne_courante = dw_soins.getrow()

if tot > 0 then
	// Si pas de soins sélectionné on prend le soin courant
	if dw_soins.find("fse = 'O'",0,dw_soins.rowcount()) = 0  and dw_soins.rowcount() > 0 then
		dw_soins.SetItem(dw_soins.getrow(), "fse", "O")
	end if
	
	cpt_ok = 0
	
	for lig = 1 to tot 
		
		if dw_soins.GetItemString(lig, "fse") = "O" then		
			
			v_clef = dw_soins.GetItemNumber(lig,"cle")
			v_code_patient = dw_soins.GetItemNumber(lig,"soins_code")
			v_nom_soins = dw_soins.GetItemString(lig,"code_soins_nom")
			v_date_demande = dw_soins.GetItemDate(lig,"date_demande")
			
			// On ne doit pas envoyer les soins FDO 
			if upper(trim(dw_soins.GetItemString(lig,"code_soins_lettre"))) = "FDO" then
					MessageBox("ATTENTION","Les soins FDO n'ont pas besoin d'être envoyés à Veasy. Ils sont automatiquement intégrés lors de l'envoi du Semestre.") 
				
			else
			
				if not fxg_ods_envoi_soin(v_code_patient, v_clef, true) then
					MessageBox("ERREUR","Le soin " + v_nom_soins + " du " + string(v_date_demande) + " n'a pas été correctement mis à jour dans Visiodent !") 
				else
					cpt_ok = cpt_ok + 1
					v_nom_soins = dw_soins.GetItemString(lig,"code_soins_nom")
					v_date_demande = dw_soins.GetItemDate(lig,"date_demande")
					UPDATE "soins" SET "soins"."fse_edite" = 'V'  ,  "soins"."date_fs" = cast(getdate() as date)  ,  "soins"."numero_fse" = 1 
					WHERE code = :v_code_patient and cle = :v_clef ;
	
				end if
			end if
		end if
	next
	
	if cpt_ok > 0 then
		commit ;
		if cpt_ok = 1 then
			Messagebox("ATTENTION", "1 ligne a été correctement envoyée à Visiodent !")
		else
			Messagebox("ATTENTION", string(cpt_ok) + " lignes ont été correctement envoyées à Visiodent !")
		end if
		
		// Raffraichissement et repositionnement 
		dw_soins.retrieve(v_code_patient)
			
		// repositionnement sur la ligne courante AVANT ....
		if ligne_courante > 0 then
			dw_soins.selectrow(0,false)
			dw_soins.selectrow(ligne_courante,true)
			dw_soins.scrolltorow(ligne_courante)
		end if

	end if
	
	
end if
end event

