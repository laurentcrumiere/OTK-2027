type cb_pid from uo_picturebutton_390x120 within tabpage_reglements
integer x = 2679
integer y = 716
integer width = 242
integer taborder = 340
fontcharset fontcharset = ansi!
string text = "eMém."
string tiptext = "eMémoire - Paiement Immédiat Direct - Remboursement Digitalisé"
end type

event clicked;call super::clicked;long ll_numero_memoire
string v_code_praticien_patient, v_code_praticien_soin, v_code_praticien_courant
string v_matricule_patient
double cle_soin
boolean meme_praticien , deja_facture, ok_tp, ok_facture

string s_type_soins, ls_identifiant_externe_document
date d_date_prestation

long l_premier_soin , lig, ligtot, cpt, ligne_courante

decimal{2} d_montant_caisse, d_montant_patient, d_montant_total
integer v_cpt


// Mémoire
string ls_numero_memoire_uuid

// infos patient
//string v_nom, v_prenom, v_sexe, v_niss, v_adulte
//date v_date_naissance 
string v_secu_patient, v_secu_parent1, v_secu_parent2, v_secu_payeur
integer v_assure


// praticien 
string ls_code_prestataire



// infos soins
string ls_prestation_uuid
date d_exe
string s_dent, s_sufix
integer li_numero_seance

string s_commande, ls_libelle_erreur_suppémentaire

ligne_courante = dw_soins.getrow()


open(w_patience)


// Si pas de soins sélectionné ... on prend le soin courant
l_premier_soin = dw_soins.find("fse = 'O'",0,dw_soins.rowcount())
if  l_premier_soin = 0  and dw_soins.rowcount() > 0 then
	l_premier_soin = dw_soins.getrow()
	dw_soins.SetItem(l_premier_soin, "fse", "O")
end if


// si on est sur un emémoireexistant ... on l'affiche en consultation
// on se sert de la zone derniere efacture de la belgique histoire d'optimiser !!
if l_premier_soin > 0 then
	
	cle_soin  = dw_soins.getitemnumber(l_premier_soin,"cle")
	select isnull(derniere_efacture, 0) 
	into  :ll_numero_memoire from soins where code = :var_code_local and cle = :cle_soin ;
	
	if ll_numero_memoire > 0 then 
		if not ib_correction_ememoire_luxembourg then 
			param_win[1] = "M"
		else
			// demande de simulation automatique
			param_win[1] = "S"
		end if
		il_dernier_numero_memoire = ll_numero_memoire
		openwithparm(w_ememoire_luxembourg_maj, ll_numero_memoire)
		
		if message.DoubleParm = -1 then 
				// demande de correction automatique
				fxg_correction_soins_ememoire_simule(w_click_soins_reg, ll_numero_memoire)
		else
			ib_correction_ememoire_luxembourg = false
			dw_soins.retrieve(var_code_local)
			
			// repositionnement sur la ligne courante AVANT ....
			if ligne_courante > 0 then
				dw_soins.setrow(ligne_courante)
				dw_soins.scrolltorow(ligne_courante)
			end if
		end if
		
	else
		
		// Création du eMémoire
		
		select code_praticien, isnull(secu_patient, ''), isnull(secu_parent1, ''), isnull(secu_parent2, ''), isnull(secu_payeur, ''), assure 
		into :v_code_praticien_patient, :v_secu_patient, :v_secu_parent1, :v_secu_parent2, :v_secu_payeur, :v_assure
		from patient where code = :var_code_local ;
		
		choose case v_assure
			case  1
				v_matricule_patient = v_secu_parent1
			case 2
				v_matricule_patient = v_secu_parent2
			case 3
				v_matricule_patient = v_secu_payeur
			case else
				v_matricule_patient = v_secu_patient
		end choose
		
		if v_matricule_patient = "" then 
			Messagebox("ATTENTION","Impossible de saisir ce eMémoire : vous devez indiquer un numéro de matricule pour l'assuré du patient !")
		else
		
			// Parmi les lignes sélectionnées, on repère s'il y a eu déjà des eMémoires... 
			ligtot = dw_soins.rowcount()
			cpt = 0
			v_code_praticien_soin = ""
			
			deja_facture = false
			meme_praticien = true
			ok_tp = true
			
			
			
			for lig = 1 to ligtot
				if dw_soins.getitemstring(lig,"fse") = 'O' then
					
					cpt = cpt + 1
					
					// verification du praticien et de la facturation
					cle_soin  = dw_soins.getitemnumber(lig,"cle")
					select isnull(code_praticien, :v_code_praticien_patient) , isnull(derniere_efacture, 0) 
					into :v_code_praticien_courant, :ll_numero_memoire from soins where code = :var_code_local and cle = :cle_soin ;
					
					if v_code_praticien_soin = "" then
						// c'est le premier soin
						v_code_praticien_soin = v_code_praticien_courant
					end if
					
					if v_code_praticien_courant <> v_code_praticien_soin then 
						meme_praticien = false
					end if
					
					if ll_numero_memoire > 0 then
						deja_facture = true
						// on désactive la ligne
						dw_soins.Setitem(lig,"fse", "N")
					end if
					
						
	//				// Tiers payant ?
	//				select isnull(sum(montant),0) into :d_montant_caisse
	//				from ligne_soins where code = :var_code_local and cle = :cle_soin and tp = 'O' and origine_tp = 'C';
					
	//				if d_montant_caisse = 0 then
	//					// on désactive la ligne
	//					dw_soins.Setitem(lig,"fse", "N")
	//					Messagebox("ATTENTION","Il n'y a pas de Tiers Payant demandé sur la ligne sélectionnée N°" + string(cpt) + ". Elle sera désélectionnée.")
	//				end if
					
							
				end if
				
			next
			
			if cpt > 20 then 
				messagebox("ATTENTION", "Vous ne pouvez pas mettre plus de 20 lignes dans un eMémoire (or il y a " + string(cpt) +" lignes selectionnées) !")
			else
				if not meme_praticien then
			
				MessageBox("ATTENTION","Vous avez sélectionné des soins devant être facturés par des praticiens différents ; veuillez corriger avant de renouveler votre demande.")
				
			else
				
				// est ce qui'il y a toujours des lignes à facturer ?
				
				if dw_soins.find("fse = 'O'",0,dw_soins.rowcount()) =  0 then
					
					Messagebox("ATTENTION", "Vous n'avez plus de soin à mettre dans le eMémoire !")
					
				else
			
					// Si on corrige un ememoire, on garde le même numéro et on ne passe pas par la fenêtre
					if not ib_correction_ememoire_luxembourg then 
						// La fenetre renvoie un numéro de mémoire  à créer ... -1 si abandon
	
						open(w_ememoire_luxembourg_numero)
					
						ll_numero_memoire = Message.DoubleParm
					else
						ll_numero_memoire = il_dernier_numero_memoire 
					end if
				
					w_click_soins_reg = tab_1.getparent()
					
					// création de la facture !
					if ll_numero_memoire > 0 then 
						
	
						// Infos praticien
						select isnull(trim(Identifiant_rpps ), '') into :ls_code_prestataire from prati where code = :v_code_praticien_courant ;
						
						// Récupéation d'un uuid
						ls_numero_memoire_uuid = fxg_get_uuid_luxembourg()
						
						if ls_numero_memoire_uuid <> "?" then
						
							// pour RA 
							ls_identifiant_externe_document =  fxg_get_uuid_luxembourg()
							
							insert into ememoire_luxembourg ("numero_memoire", "code_praticien", "code_patient", "etat", "numero_memoire_uuid", "date", "identifiant_facturier", "matricule_patient", "validation_praticien", "validation_patient", "paiement_patient" , "identifiant_externe_document", "etat_rd") 
							values (:ll_numero_memoire, :v_code_praticien_courant, :var_code_local, 'N', :ls_numero_memoire_uuid, getdate() , :ls_code_prestataire , :v_matricule_patient, 'O', 'O', 'O' , :ls_identifiant_externe_document, 'N') ;
						
						
							if sqlca.sqlcode = 0 then 
								commit ;
								
					
								// Ajout des lignes de l'ememoire
								
								for lig = 1 to ligtot
									if dw_soins.getitemstring(lig,"fse") = 'O' then
										cle_soin  = dw_soins.getitemnumber(lig,"cle")
										
										// récupération des éléments des lignes de soins
										ls_prestation_uuid = fxg_get_uuid_luxembourg()
						
										if ls_numero_memoire_uuid <> "?" then
											select trim("type") , "date_exe",  isnull("dent", ''), total, isnull(code_association, ''), isnull(quantite, 0)
											into :s_type_soins, :d_date_prestation, :s_dent , :d_montant_total, :s_sufix , :li_numero_seance
											from soins 
											where code = :var_code_local and cle = :cle_soin ;
											
																		
											// Montant PID
											select isnull(sum(montant),0) into :d_montant_caisse
											from ligne_soins where code = :var_code_local and cle = :cle_soin and tp = 'O' and origine_tp = 'C';	
											
											// Montant patient
											select isnull(sum(montant),0) into :d_montant_patient
											from ligne_soins where code = :var_code_local and cle = :cle_soin and tp = 'N' ;
					
											insert into ligne_ememoire_luxembourg ("numero_memoire", "cle", "prestation_uuid", "numero_seance", "lieu_execution", "identifiant_executant", "date_execution", "code_acte", "nombre_acte", "montant_total", "montant_caisse" , "montant_patient", "dent", "sufix") 
											values (:ll_numero_memoire, :cle_soin, :ls_prestation_uuid, :li_numero_seance, '01', :ls_code_prestataire, :d_date_prestation,  :s_type_soins , 1, :d_montant_total, :d_montant_caisse, :d_montant_patient , :s_dent, :s_sufix) ;
											
											if sqlca.sqlcode = 0 then 
												commit ;
												
												update soins set derniere_efacture = :ll_numero_memoire where code = :var_code_local and cle = :cle_soin ;
												commit ;
												
											else
												Messagebox("ATTENTION", "Erreur dans l'ajout de la ligne pour le soin : " + s_type_soins + " du " + string(s_type_soins) + "~n~n" + sqlca.sqlerrtext)
											end if
									else
										
									end if
										
									end if
								next
					
								
								// Vérification s'il reste encore au moins une ligne dans l'ememoire 
								select isnull(count(*),0) into :v_cpt from 	ligne_ememoire_luxembourg 	where numero_memoire = :ll_numero_memoire  ; 
								
								
								if v_cpt > 0 then 
									// mise à jour du ememoire
									if not ib_correction_ememoire_luxembourg then 
										param_win[1] = "M"
									else
										// demande de simulation automatique
										param_win[1] = "S"
									end if
									il_dernier_numero_memoire = ll_numero_memoire
									openwithparm(w_ememoire_luxembourg_maj, ll_numero_memoire)	
									
									if message.doubleparm = -1 then
										// demande de correction automatique
										fxg_correction_soins_ememoire_simule(w_click_soins_reg, ll_numero_memoire)
									else
										// tout est normal
										ib_correction_ememoire_luxembourg = false
										dw_soins.retrieve(var_code_local)
										
										// repositionnement sur la ligne courante AVANT ....
										if ligne_courante > 0 then
											dw_soins.setrow(ligne_courante)
											dw_soins.scrolltorow(ligne_courante)
										end if
						
									end if
								else
									
									// plus de ligne dans l'ememoire
									delete from ememoire_luxembourg 	where numero_memoire = :ll_numero_memoire  ; 
									commit ; 
									
									messagebox("ATTENTION","Erreur N°3 - Il n'y a plus de ligne dans l'eMémoire !~n~nIl est supprimé !")
									
								end if
		
								
								
							else
								messagebox("ATTENTION","Erreur N°1 - Impossible de créer cette facture !~n~n" + sqlca.sqlerrtext)
								rollback ;
							end if
							
						else
							Messagebox("ATTENTION", "Impossible de générer un code UUID pour le mémoire : opération annulée ")
						end if
						
					end if
				end if
			end if
			end if
		end if
	end if
end if

close(w_patience)
end event

type cb_efact from uo_picturebutton_390x120 within tabpage_reglements
integer x = 2679
integer y = 716
integer width = 242
integer taborder = 330
string text = "eFact"
string tiptext = "eFacturation"
end type

event clicked;call super::clicked;
long l_numero_facture
string s_niss, s_sexe
string v_code_praticien_patient, v_code_praticien_soin, v_code_praticien_courant
double cle_soin
boolean meme_praticien , deja_facture, ok_tp, ok_facture

string s_type_soins, s_code_nomenclature, s_prestation_relative, s_heures_non_ouvrees
date d_date_prestation
string s_identification_prestataire, s_prestataire_conventionne
string  s_norme_prestation, s_code_facturation_intervention_personnelle
string s_norme_prescripteur, s_derogation
long l_premier_soin , lig, ligtot, cpt, ligne_courante
decimal{2} d_montant_rembourse_oa, d_montant_tp_caisse, d_intervention_personnelle
integer v_cpt
string s_norme_dispensateur, s_dispensateur_auxiliaire 

// infos patient
string v_nom, v_prenom, v_sexe, v_niss, v_adulte
date v_date_naissance 
string v_libelle_erreur
string s_ct1, s_ct2, s_code_oa_affiliation, s_code_oa_destination
boolean b_nom_different, b_prenom_different, b_date_naissance_different, b_sexe_different, b_niss_different
string s_sexe_compare, s_montant_rembourse_oa , s_intervention_personnelle

// Lecture Identité 
string v_identite_numero_serie, v_identite_type_support, v_identite_type_saisie, v_identite_raison_encodage_manuel
datetime v_identite_date_heure_lecture
integer v_mode_verification_identite
uo_lire_eid_belgique uo_valeur_retour
						
// infos soins
date d_soins_min, d_soins_max, d_exe
string s_dent, s_prescription_de_renvoi_electronique

string s_nom_member_data, s_prenom_member_data, s_gender_member_data
date d_date_naissance_member_data

string s_commande, ls_libelle_erreur_suppémentaire

ligne_courante = dw_soins.getrow()


open(w_patience)


// Si pas de soins sélectionné ... on prend le soin courant
l_premier_soin = dw_soins.find("fse = 'O'",0,dw_soins.rowcount())
if  l_premier_soin = 0  and dw_soins.rowcount() > 0 then
	l_premier_soin = dw_soins.getrow()
	dw_soins.SetItem(l_premier_soin, "fse", "O")
end if


// si on est sur une facture existante ... on l'affiche en consultation
if l_premier_soin > 0 then
	
	cle_soin  = dw_soins.getitemnumber(l_premier_soin,"cle")
	select isnull(derniere_efacture, 0) 
	into  :l_numero_facture from soins where code = :var_code_local and cle = :cle_soin ;
	
	if l_numero_facture > 0 then 
		// Mise à jour de la facture
		param_win[1] = "M"
		// type de facture
		param_win[2] = "F"
		openwithparm(w_efacturation_belgique_maj, l_numero_facture)
		
		if message.DoubleParm = 1 then
			// la facture a été supprimée on raffraichit
			dw_soins.retrieve(var_code_local)
			
			// repositionnement sur la ligne courante AVANT ....
			if ligne_courante > 0 then
				dw_soins.setrow(ligne_courante)
				dw_soins.scrolltorow(ligne_courante)
			end if
		end if
		
	else
		
		// Création de la facture
		
		select code_praticien into :v_code_praticien_patient from patient where code = :var_code_local ;
		
		// Parmi les lignes sélectionnées, on repère s'il y a eu déjà des factures ... et si toutes les lignes on bien une ligne TP Caisse
		ligtot = dw_soins.rowcount()
		cpt = 0
		v_code_praticien_soin = ""
		
		deja_facture = false
		meme_praticien = true
		ok_tp = true
		
		setnull(d_soins_min)
		setnull(d_soins_max)
		
		
		for lig = 1 to ligtot
			if dw_soins.getitemstring(lig,"fse") = 'O' then
				
				cpt = cpt + 1
				
				// verification du praticien et de la facturation
				cle_soin  = dw_soins.getitemnumber(lig,"cle")
				select isnull(code_praticien, :v_code_praticien_patient) , isnull(derniere_efacture, 0) 
				into :v_code_praticien_courant, :l_numero_facture from soins where code = :var_code_local and cle = :cle_soin ;
				
				if v_code_praticien_soin = "" then
					// c'est le premier soin
					v_code_praticien_soin = v_code_praticien_courant
				end if
				
				if v_code_praticien_courant <> v_code_praticien_soin then 
					meme_praticien = false
				end if
				
				if l_numero_facture > 0 then
					deja_facture = true
					// on désactive la ligne
					dw_soins.Setitem(lig,"fse", "N")
				end if
				
				
				
				// Tiers payant ?
				select isnull(sum(montant),0) into :d_montant_tp_caisse
				from ligne_soins where code = :var_code_local and cle = :cle_soin and tp = 'O' and origine_tp = 'C';
				
				if d_montant_tp_caisse = 0 then
					ok_tp = false
					// on désactive la ligne
					dw_soins.Setitem(lig,"fse", "N")
					Messagebox("ATTENTION","Il n'y a pas de Tiers Payant demandé sur la ligne sélectionnée N°" + string(cpt) + ". Elle sera désélectionnée.")
				end if
			
				if dw_soins.getitemstring(lig,"fse") = 'O' then
					// La ligne est toujours sélectionnée ... on va la facturer ... on répère les dates de soins mini et maxi pour intérroger member data
					
					d_exe = dw_soins.getitemDate(lig, "soins_date_exe")
					if isnull(d_soins_min) then
						d_soins_min = d_exe
					else
						if d_exe < d_soins_min then
							d_soins_min = d_exe
						end if
					end if
					
					if isnull(d_soins_max) then
						d_soins_max = d_exe
					else
						if  d_exe > d_soins_max  then
							d_soins_max = d_exe
						end if
					end if
				end if
		
			end if
			
		next
		
		
		if not meme_praticien then
		
			MessageBox("ATTENTION","Vous avez sélectionné des soins devant être facturés par des praticiens différents ; veuillez corriger avant de renouveler votre demande.")
			
		else
			
			// est ce qui'il y a toujours des lignes à facturer ?
			
			if dw_soins.find("fse = 'O'",0,dw_soins.rowcount()) =  0 then
				
				Messagebox("ATTENTION", "Vous n'avez plus de soin à facturer !")
				
			else
				
				ok_facture = true
				v_identite_numero_serie = ""
				v_identite_type_support = "8"	// attestation assuré
				v_identite_type_saisie = "4"		// encodage manuel
				v_identite_raison_encodage_manuel = ""
				
				setnull(v_identite_date_heure_lecture)
				
				// 5 modes de vérification de l'identité :
				// ----------------------------------------------
				// 1 - lecture de la carte identité avec lecteur
				// 2 - lecture carte Isi+ QR Code avec scanner
				// 2 - lecture carte Isi+ Code Barre avec scanner
				// 4 - Saisie electronique (Itsme)
				// 9 - saisie manuelle
				// 0 : pas d'identité 
				
				if SERIAL = "87001" or SERIAL = "87997" then 
					// uniquement pour les tests pour l'instant
					
					open(w_efacturation_belgique_support)
					
					v_mode_verification_identite = message.doubleparm
					
				else
					// version client
					if Messagebox("QUESTION","Voulez-vous lire la carte eID du patient ?", Question!, YesNo!, 2) = 1 then
						v_mode_verification_identite = 1
					else
						v_mode_verification_identite = 9
					end if
				end if
				
				choose case v_mode_verification_identite
		
					case 1
						//  -----  Lecture de la carte d'identité -----------
						uo_lire_eid_belgique lecteur_carte_belge
						lecteur_carte_belge = create uo_lire_eid_belgique
						
						if lecteur_carte_belge.lire_carte() = 1 then
							
							// La lecture s'est bien passée ... les éléments sont chargés
							select trim(isnull(nom,'')), trim(isnull(prenom, '')), sexe, date_naissance , trim(isnull(secu_patient, '')), isnull(adulte, '')
							into :v_nom, :v_prenom, :v_sexe, :v_date_naissance , :v_niss, :v_adulte
							from patient 
							where code = :var_code_local ;
							
							v_libelle_erreur = ""
							
							b_nom_different = false
							b_prenom_different = false
							b_date_naissance_different = false
							b_sexe_different = false
							b_niss_different = false
							
							v_identite_numero_serie = lecteur_carte_belge.CardNumber
							if left(lecteur_carte_belge.DocumentType, 9) = "FOREIGNER" then
								v_identite_type_support = "2"	// eID étranger
							else
								v_identite_type_support = "1"	// eID belge
							end if
							
							v_identite_type_saisie = "1"		// puce
							v_identite_date_heure_lecture = lecteur_carte_belge.date_heure_lecture
							
							if upper(lecteur_carte_belge.nom) <> upper(v_nom) then
								v_libelle_erreur = v_libelle_erreur + "~n. Nom du patient lu : " + lecteur_carte_belge.nom +  " - dans le dossier : " + v_nom
								b_nom_different = true
							end if
							if upper(lecteur_carte_belge.prenom) <> upper(v_prenom) then
								v_libelle_erreur = v_libelle_erreur + "~n. Prénom du patient lu : " + lecteur_carte_belge.prenom +  " - dans le dossier : " + v_prenom
								b_prenom_different = true
							end if
							if lecteur_carte_belge.date_naissance <> v_date_naissance then
								v_libelle_erreur = v_libelle_erreur + "~n. Date de naissance du patient lue : " + string(lecteur_carte_belge.date_naissance) +  " - dans le dossier : " + string(v_date_naissance)
								b_date_naissance_different = true
							end if
							if upper(lecteur_carte_belge.sexe) <> upper(v_sexe) then
								v_libelle_erreur = v_libelle_erreur + "~n. Sexe du patient lu : " + lecteur_carte_belge.sexe +  " - dans le dossier : " + v_sexe
								b_sexe_different = true
							end if
							if upper(lecteur_carte_belge.national_number) <> upper(v_niss) then
								v_libelle_erreur = v_libelle_erreur + "~n. NISS du patient lu : " + lecteur_carte_belge.national_number +  " - dans le dossier : " + v_niss
								b_niss_different = true
							end if
							
							if v_libelle_erreur <> "" and serial <> "87001" then 	// pour nos tests ... on ne gère pas les différences de lecture 
				
								if Messagebox("ERREURS EN LECTURE DE CARTE", "ATENTION !~n~nAu moins un élément lu sur la carte diffère du dossier Orthokis : ~n" + v_libelle_erreur +"~n~nVoulez-vous poursuivre la facturation en mettant à jour le dosssier d'Orthokis ?" , Question!, YesNo!, 2) = 1  then
									// on met à jour la fiche et on poursuivre la facture
									//b_nom_different, b_prenom_different, b_date_naissance_different, b_sexe_different, b_niss_different
									if b_nom_different then 
										update patient set nom = :lecteur_carte_belge.nom where code = :var_code_local ;
									end if
									if b_prenom_different then 
										update patient set prenom = :lecteur_carte_belge.prenom where code = :var_code_local ;
									end if
									if b_sexe_different then 
										update patient set sexe = :lecteur_carte_belge.sexe where code = :var_code_local ;
									end if
									if b_date_naissance_different then 
										update patient set date_naissance = :lecteur_carte_belge.date_naissance where code = :var_code_local ;
										if age_calcul_des_annees_date(lecteur_carte_belge.date_naissance) >= 18 then
											v_adulte = "O"
										else
											v_adulte = "N"
										end if
										update patient set adulte = :v_adulte where code = :var_code_local ;
									end if
									
									if b_niss_different then 
										update patient set secu_patient = :lecteur_carte_belge.national_number where code = :var_code_local ;
									end if
																		
									if v_libelle_erreur <> "" then 
										commit ; 		
									end if
									
								else
									// pas de mise à jour de la fiche + on arrete la facturation
									ok_facture = false
								end if
							else
								// tous les éléments sont identiques .. on va poursuivre
							end if
					
							// Erreur de lecture de la carte 
							if Messagebox("QUESTION","Voulez-vous poursuivre la facturation ?", Question!, YesNo!, 2) = 2 then
								ok_facture = false
							end if
							
						end if
					case 2
						// -------------   lecture de la case Isi + QR Code  via Scanner
						
						openWithParm(w_efacturation_belgique_lecture_isi, 1)
						
						uo_valeur_retour = create uo_lire_eid_belgique
						uo_valeur_retour = message.powerobjectparm
						
						v_identite_numero_serie = uo_valeur_retour.cardnumber
						
						if v_identite_numero_serie <> "" then 
							
							// Vérification du ssin de la fiche
							select trim(isnull(secu_patient, '')) into :v_niss from patient where code = :var_code_local ;

							if uo_valeur_retour.ssin <> v_niss then 
								Messagebox("ATTENTION", "Le NISS lu (" + uo_valeur_retour.ssin + ") est différent de celui de la fiche du patient (" + v_niss +").~n~nFacturation annulée !")
								ok_facture = false
							else
								v_identite_type_support = "4"	// Isi +
								v_identite_type_saisie = "3"		// QR code
								v_identite_date_heure_lecture = fxg_get_heure_serveur()
							end if
						else
							// Abandon de la lecture
							ok_facture = false
						end if
						
						case 3
							// -------------   lecture de la case Isi + code barre via Scanner
							
							openWithParm(w_efacturation_belgique_lecture_isi, 2)
							
							uo_valeur_retour = create uo_lire_eid_belgique
							uo_valeur_retour = message.powerobjectparm
							
							v_identite_numero_serie = uo_valeur_retour.cardnumber
						
							
							if v_identite_numero_serie <> "" then 
								// Vérification du ssin de la fiche
								select trim(isnull(secu_patient, '')) into :v_niss from patient where code = :var_code_local ;
	
								if uo_valeur_retour.ssin <> v_niss then 
									Messagebox("ATTENTION", "Le NISS lu (" + uo_valeur_retour.ssin + ") est différent de celui de la fiche du patient (" + v_niss +").~n~nFacturation annulée !")
									ok_facture = false
								else

									v_identite_type_support = "4"	// Isi +
									v_identite_type_saisie = "2"		// Code Barre
									v_identite_date_heure_lecture = fxg_get_heure_serveur()
								end if
							else
								// Abandon de la lecture
								ok_facture = false
							end if

						case 4
							// -------------   Saisie Electronique Itsme
				
								v_identite_type_support = "A"	// Itsme
								v_identite_type_saisie = "A"		// Itsme
								v_identite_date_heure_lecture = fxg_get_heure_serveur()

						
					case 9
						
						// Pas de lecture : encodage manuel
						
						v_identite_type_support = "0"	// pas de document
						v_identite_type_saisie = "4"		// Encodage manuel
						v_identite_raison_encodage_manuel = "7" // pas de document
						v_identite_date_heure_lecture = fxg_get_heure_serveur()
						
					case 0
						// Pas de lecture d'identité => pas d'enregistrement 52 à faire 
						v_identite_type_saisie = "Z"
						v_identite_type_support = ""	
						v_identite_raison_encodage_manuel = "" 
						
						/*
						v_identite_type_support = "0"	// pas de document
						v_identite_type_saisie = "4"		// Encodage manuel
						v_identite_raison_encodage_manuel = "7" // pas de document
						v_identite_date_heure_lecture = fxg_get_heure_serveur()
						*/

					case else
						
						// abandon du choix de la lecture
						ok_facture = false
					
				end choose	
				
				// Fin de la partie controle de l'identité ..............
				
				if ok_facture then
						
					// La fenetre renvoie un numéro de facture à créer ... -1 si abandon

					openWithParm(w_efacturation_belgique_numero, "F")
					
					l_numero_facture = Message.DoubleParm
				
					
					
					// création de la facture !
					if l_numero_facture > 0 then 
						
						// infos patient
						select trim(isnull(nom,'')), trim(isnull(prenom, '')), isnull(sexe, ''), isnull(date_naissance, date('1900-01-01')) , trim(isnull(secu_patient, ''))
						into :v_nom, :v_prenom, :v_sexe, :v_date_naissance , :s_niss
						from patient 
						where code = :var_code_local ;


						// Appel à  Member Data pour qualifier le patient
						if d_soins_max = d_soins_min then
							d_soins_min = relativedate(d_soins_max , -1)
						end if
	
						s_commande = "action?type=getMemberdata&prat=" + v_code_praticien_courant +"&niss=" + s_niss + "&debut=" + string(d_soins_min, "yyyy-mm-dd") + "&fin=" + string(d_soins_max, "yyyy-mm-dd")
						
						
						if fxg_lancer_commande_myorthokis_simple(s_commande , true, "M") then
							
							// Retour XML
							constant string nom_fichier_recu = "wb.xml"
							integer i_fichier_retour, i
							string ls_retour_ehealth, ls_result, ls_erreur, ls_libelle_periodes
							long ll_root, ll_periodInfo, ll_cnt_periodInfo, ll_index_data, ll_memberdata
							long ll_mycarenet, ll_Response, ll_Status, ll_StatusDetail, ll_Fault, ll_Message
							boolean lb_success, b_paymentByIo
							long v_errorCode
							string v_error
							
							// Analyse du retour en Json
							i_fichier_retour = FileOpen(dir_ini + nom_fichier_recu, TextMode!, read!)
							FileReadEx(i_fichier_retour, ls_retour_ehealth)
							FileClose(i_fichier_retour)
							TRACE (" - Retour Json Member Data : "  + ls_retour_ehealth)		
							
							JSONParser json
							json = CREATE JSONParser
							
							
							ls_result = json.LoadString (ls_retour_ehealth)
							ll_root = json.GetRootItem()
							
							// Y a t il une erreur ?
							lb_success = json.GetItemBoolean(ll_root, 'success')  
							
							if not lb_success then
								v_errorCode =  json.GetItemNumber(ll_root, 'errorCode')  
								v_error =   json.GetItemString(ll_root, 'error')
								
								ls_libelle_erreur_suppémentaire = ""
								
								if pos(v_error , "NO_ENCRYPTED_DATA") > 0 then 
									ls_libelle_erreur_suppémentaire = "~n~nCeci est certainement dû à un manque d'assurabilité de ce patient à la date du soin !"
								end if
								
								if MessageBox("ATTENTION ! ", "Erreur dans l'appel à Member Data :~n~nErreur N° " + string(v_errorCode) +"~nMessage : " + v_error + ls_libelle_erreur_suppémentaire + "~n~nVoulez-vous tout de même poursuivre la facturation ?", Question!, YesNo!, 2) = 1 then 
									ok_facture = true
									// On récupère les infos du patients mémorisées la dernière fois
									select isnull(code_oa_affiliation, ''), isnull(codes_titulaires,''), isnull(sexe , '')
									into :s_code_oa_affiliation, :s_ct1, :s_sexe
									from patient
									where code = :var_code_local ;
									
									if s_code_oa_affiliation = "" then 
										Messagebox("ATTENTION", "Aucune information d'assurabilité n'a été précédemment mémorisée pour ce patient !~n~nFacturation anulée !")
										ok_facture = false
									else
										s_code_oa_destination = fxg_mutualite_destination(s_code_oa_affiliation)
										s_ct2 = ''
										if s_sexe = 'M' then 
											s_sexe = '1'  
										else
											s_sexe = '2'  
										end if
										
									end if
									
								else
									ok_facture = false
								end if
								
								
							else
								
								// Y a t il un message MyCarenet ?
								
								ll_mycarenet = json.GetItemObject(ll_root, "mycarenet")
								ll_Response = json.GetItemObject(ll_mycarenet, "Response")
								ll_Status = json.GetItemObject(ll_Response, "Status")
								ll_StatusDetail = json.GetItemObject(ll_Status, "StatusDetail")
								ll_Fault = json.GetItemObject(ll_StatusDetail, "Fault")
								ll_Message = json.GetItemObject(ll_Fault, "Message")
								ls_erreur = string_non_nulle(json.GetItemString(ll_Message, 'text')   )
								
								if ls_erreur <> "" then
								
									MessageBox("ATTENTION ! ", "Erreur Member Data : " + ls_erreur + "~n~nFacturation annulée !")
									ok_facture = false
								else
									
									// Analyse du Json complet ...
									ll_memberdata = json.GetItemObject(ll_root, "memberdata")
									
									b_paymentByIo = json.GetItemBoolean(ll_root, "paymentByIo")
									
									if not b_paymentByIo  then
										MessageBox("ATTENTION ! ", "Ce patient ne peut bénéficier d'une eFacturation !~n~nFacturation annulée !")
										ok_facture = false
										
									else

										ll_periodInfo = json.GetItemArray(ll_memberdata, 'periodInfo')
										ll_cnt_periodInfo = json.GetChildCount(ll_periodInfo)
										
										if ll_periodInfo = 0 then 
											
											MessageBox("ATTENTION ! ", "Il n'y a aucune assuralibilité pour ce patient dans cette période (du "+ string(d_soins_min)+" au " + string(d_soins_max) + ") : ~n~nFacturation Annulée !")
											ok_facture = false
												
										else
										
											if ll_cnt_periodInfo > 1 then 
												ls_libelle_periodes = ""
												// Lecture des PeriodInfo pour affiche message 
												For i = 1 to ll_cnt_periodInfo
													ll_index_data = json.GetChildItem(ll_periodInfo, i)    
													ls_libelle_periodes = ls_libelle_periodes +  "  - du " + string(json.GetItemDate(ll_index_data, "debut")) + " au " +  string(json.GetItemDate(ll_index_data, "fin")) + "~n~n"
												next
			
												MessageBox("ATTENTION ! ", "Il y a "+ string(ll_cnt_periodInfo) + " périodes d'assurabilité différentes dans cette période (du "+ string(d_soins_min)+" au " + string(d_soins_max) + ") : ~n~nVeuillez effectuer plusieurs factures !")
												ok_facture = false
												
											else
												
												if ll_cnt_periodInfo = 0 then
													MessageBox("ATTENTION ! ", "Aucune période d'assurabilité détectée !~n~nFacturation annulée")
													ok_facture = false
												
												else
													// On gère une seule période d'assurabilié ... 
													
													// codes titulaires :
													ll_index_data = json.GetChildItem(ll_periodInfo, 1) 
													s_ct1 = json.GetItemString(ll_index_data, "ct1")
													s_ct2 = json.GetItemString(ll_index_data, "ct2")
													
													s_code_oa_affiliation = json.GetItemString(ll_index_data, "mutuality")
													s_code_oa_destination = fxg_mutualite_destination(s_code_oa_affiliation)
													
													s_nom_member_data = json.GetItemString(ll_memberdata, "nom")
													s_prenom_member_data = json.GetItemString(ll_memberdata, "prenom")
													s_gender_member_data = json.GetItemString(ll_memberdata, "gender")
													d_date_naissance_member_data = json.GetItemDate(ll_memberdata, "birthdate")
													
													if s_gender_member_data = 'male' then 
														s_sexe = '1'  
														s_sexe_compare = "M"
													else
														s_sexe = '2'  
														s_sexe_compare = "F"
													end if
													
													
													v_libelle_erreur = ""
													
													b_nom_different = false
													b_prenom_different = false
													b_date_naissance_different = false
													b_sexe_different = false
													
													if upper(s_nom_member_data) <> upper(v_nom) then
														v_libelle_erreur = v_libelle_erreur + "~n. Nom du patient Member Data : " + s_nom_member_data +  " - dans le dossier : " + v_nom
														b_nom_different = true
													end if
													if upper(s_prenom_member_data) <> upper(v_prenom) then
														v_libelle_erreur = v_libelle_erreur + "~n. Prénom du patient Member Data : " + s_prenom_member_data +  " - dans le dossier : " + v_prenom
														b_prenom_different = true
													end if
													if d_date_naissance_member_data <> v_date_naissance then
														v_libelle_erreur = v_libelle_erreur + "~n. Date de naissance du patient Member Data : " + string(d_date_naissance_member_data) +  " - dans le dossier : " + string(v_date_naissance)
														b_date_naissance_different = true
													end if
													if upper(s_sexe_compare) <> upper(v_sexe) then
														v_libelle_erreur = v_libelle_erreur + "~n. Sexe du patient Member Data : " + s_sexe_compare+  " - dans le dossier : " + v_sexe
														b_sexe_different = true
													end if
													
													if v_libelle_erreur <> "" then 
										
														if SERIAL = "87001" then 
															// Uniquement pour les tests
															if Messagebox("QUESTION SPECIALE 87001 POUR LES TESTS", "ATTENTION !~n~nAu moins un élément de Member Data diffère du dossier Orthokis : ~n" + v_libelle_erreur +"~n~nVoulez-vous poursuivre la facturation SANS METTRE à jour le dosssier d'Orthokis ?" , Question!, YesNo!, 2) = 1  then
																ok_facture = true 
															else
																ok_facture = false
															end if
														else
															
															if Messagebox("ERREURS EN LECTURE DE MEMBER DATA", "ATTENTION !~n~nAu moins un élément de Member Data diffère du dossier Orthokis : ~n" + v_libelle_erreur +"~n~nVoulez-vous poursuivre la facturation en mettant à jour le dosssier d'Orthokis ?" , Question!, YesNo!, 2) = 1  then
																// on met à jour la fiche et on poursuivre la facture
																//b_nom_different, b_prenom_different, b_date_naissance_different, b_sexe_different, b_niss_different
																if b_nom_different then 
																	update patient set nom = :s_nom_member_data where code = :var_code_local ;
																end if
																if b_prenom_different then 
																	update patient set prenom = :s_prenom_member_data where code = :var_code_local ;
																end if
																if b_sexe_different then 
																	update patient set sexe = :s_sexe_compare where code = :var_code_local ;
																end if
																if b_date_naissance_different then 
																	update patient set date_naissance = :d_date_naissance_member_data where code = :var_code_local ;
																	if age_calcul_des_annees_date(d_date_naissance_member_data) >= 18 then
																		v_adulte = "O"
																	else
																		v_adulte = "N"
																	end if
																	update patient set adulte = :v_adulte where code = :var_code_local ;
																end if
															
																// Mise à jour des éléments d'assurabilité 
																update patient set code_oa_affiliation = :s_code_oa_affiliation, codes_titulaires = :s_ct1 + :s_ct2 where code = :var_code_local ;
																
																commit ; 		
															
															else
																// pas de mise à jour de la fiche + on arrete la facturation
																ok_facture = false
															end if
														end if
														
														
														
													else
														// tous les éléments sont identiques .. on va poursuivre
														
														// Mise à jour des éléments d'assurabilité 
														update patient set code_oa_affiliation = :s_code_oa_affiliation, codes_titulaires = :s_ct1 + :s_ct2 where code = :var_code_local ;
														commit ;
													end if										
												end if
					
												
											end if
										end if
									end if
								end if
							end if
						else
							
							MessageBox("ATTENTION ! ", "Erreur dans le retour de MyCarenet : ~n~n"   +ls_retour_ehealth )
							ok_facture = false
						end if
						

					else
						
						// Erreur dans l'appel à Member Data
						ok_facture = false
						Messagebox("ATTENTION", "Erreur dans l'appel à Member Data : Facturation impossible ! ")

					end if

					if ok_facture then
						
						insert into efacture_belgique ("numero_facture","type_facture", "date_facture", "code_patient", "niss", "sexe", "cause_traitement",  "type_facturation", "statut_my_carenet", 
						"code_praticien", "levee_delai_de_prescription", "codes_titulaires", "code_oa_affiliation" , "code_oa_destination",
						"identite_numero_serie_support", "identite_type_support", "identite_type_saisie", "identite_date_heure_lecture", "numero_document_justificatif" , "paiement_effectue", "identite_raison_encodage_manuel")
						
						values (:l_numero_facture, 'F', today(*), :var_code_local, :s_niss , :s_sexe, '0000' , '0', ' ', 
						:v_code_praticien_courant, 'N' , :s_ct1 + :s_ct2, :s_code_oa_affiliation, :s_code_oa_destination,
						:v_identite_numero_serie, :v_identite_type_support, :v_identite_type_saisie, :v_identite_date_heure_lecture, string(:l_numero_facture) , 'N', :v_identite_raison_encodage_manuel) ;
						
						if sqlca.sqlcode = 0 then 
							commit ;
							
							// infos du praticien
							select trim("nom_carte_cps"), "convention_secu"
							into :s_identification_prestataire, :s_prestataire_conventionne
							from prati 
							where code = :v_code_praticien_soin ;
							
							// Code INAMI sur 11 caractères mais il faut ajouter un "0" devant pour la facturation
							s_identification_prestataire = "0" + s_identification_prestataire 
							
							// préparation du Json pour interroger eTarification
							string justfication = "0"
							long ll_RootObject, ll_demandes, ll_demande_item , ll_tarification, ll_tarif, ll_tarif_item
							string nom_fichier_json, s_body, ls_ReturnJson, s_contrat, s_type_tarif, s_justification_refus
							date d_date_contrat
							integer i_fichier_json
							
							
							JSONParser json_tarif
							json_tarif = CREATE JSONParser
							
							JsonGenerator lnv_JsonGenerator
							lnv_JsonGenerator = Create JsonGenerator
							
							// Ajout des lignes de factures
							
							for lig = 1 to ligtot
								if dw_soins.getitemstring(lig,"fse") = 'O' then
									cle_soin  = dw_soins.getitemnumber(lig,"cle")
									
									// récupération des éléments des lignes de soins
									
									select trim("type") , "date_exe", "heures_non_ouvrees", "norme_prestation", "norme_prescripteur", "derogation", 
									"code_facturation_intervention_personnelle", isnull("dent", ''), "norme_dispensateur", "dispensateur_auxiliaire", "prescription_de_renvoi_electronique", isnull("intervention_personnelle", 0)
									into :s_type_soins, :d_date_prestation, :s_heures_non_ouvrees , :s_norme_prestation , :s_norme_prescripteur, :s_derogation, 
									:s_code_facturation_intervention_personnelle, :s_dent, :s_norme_dispensateur, :s_dispensateur_auxiliaire, :s_prescription_de_renvoi_electronique, :d_intervention_personnelle
									from soins 
									where code = :var_code_local and cle = :cle_soin ;
									
									// pour la efacturation on ne doit garder que la première dent
									if len(s_dent) > 2 then 
										s_dent = left(s_dent, 2)
									end if
									
									if len(s_type_soins) = 13 then
										// il y a un pseudo code
										s_code_nomenclature = "0"+ left(s_type_soins, 6)
										s_prestation_relative = "0" + right(s_type_soins, 6)
									else
										// pas de pseudo code
										s_code_nomenclature = "0"+ left(s_type_soins, 6)
										s_prestation_relative = ""
									end if
									
									// calcul part caisse
									select isnull(sum(montant),0) into :d_montant_tp_caisse 
									from ligne_soins where code = :var_code_local and cle = :cle_soin and tp = 'O' and origine_tp = 'C';
									
									// calcul de la part patient
									//select isnull(sum(montant),0) into :d_intervention_personnelle
									//from ligne_soins where code = :var_code_local and cle = :cle_soin and tp = 'N' or tp = '';
									// On prend la valeur saisie dans les soins, pas dle calcul automatique
					
									insert into ligne_efacture_belgique ("numero_facture", "type_facture", "cle", "norme_prestation", "date_prestation", "code_nomenclature", "prestation_relative", 
									"identification_prestataire", "prestataire_conventionne", "norme_prescripteur", "derogation", "heures_non_ouvrees", 
									"dent", "norme_dispensateur", "dispensateur_auxiliaire", "prescription_de_renvoi_electronique" , "intervention_personnelle", "montant_rembourse_oa")
									values (:l_numero_facture, 'F', :cle_soin , :s_norme_prestation, :d_date_prestation,  :s_code_nomenclature, :s_prestation_relative, 
									:s_identification_prestataire, :s_prestataire_conventionne ,:s_norme_prescripteur, :s_derogation , :s_heures_non_ouvrees, 
									:s_dent, :s_norme_dispensateur, :s_dispensateur_auxiliaire, :s_prescription_de_renvoi_electronique, :d_intervention_personnelle, :d_montant_tp_caisse ) ;
									
									if sqlca.sqlcode = 0 then 
										commit ;

										Destroy lnv_JsonGenerator
										lnv_JsonGenerator = Create JsonGenerator

										ll_RootObject = lnv_JsonGenerator.CreateJsonObject()
										lnv_JsonGenerator.AddItemString ( ll_RootObject, "prati", v_code_praticien_soin )
										lnv_JsonGenerator.AddItemString ( ll_RootObject, "niss", s_niss )
										lnv_JsonGenerator.AddItemString ( ll_RootObject, "date",string( d_date_prestation , "yyyy-mm-dd"))
										lnv_JsonGenerator.AddItemString ( ll_RootObject, "justfication", justfication )
										
										ll_demandes = lnv_JsonGenerator.AddItemArray ( ll_RootObject, "demandes" )
										
										// Ajout de la ligne de soin dans le json
										ll_demande_item = lnv_JsonGenerator.AddItemObject ( ll_demandes)
										lnv_JsonGenerator.AddItemstring ( ll_demande_item, "nihdi", right(s_code_nomenclature, 6))
										lnv_JsonGenerator.AddItemstring ( ll_demande_item, "nihdi2", right(s_prestation_relative, 6))
										lnv_JsonGenerator.AddItemstring ( ll_demande_item, "dent", s_dent)

										nom_fichier_json = dir_ini + "demande_tarif.txt"
										lnv_JsonGenerator.SaveToFile(nom_fichier_json)
										
										i_fichier_json = fileOpen(nom_fichier_json, TextMode!, Read! )
										
										FileReadEx(i_fichier_json, s_body)
										
										FileClose(i_fichier_json)
										
										destroy lnv_JsonGenerator
										
										
										
										if fxg_lancer_commande_myorthokis_http("action?type=getTarification" , s_body, "G", ls_ReturnJson) then
											
											// Exploitation des retours 
											
											
											
											Destroy json_tarif
											json_tarif = CREATE JSONParser
										  
											ls_result = json_tarif.LoadString (ls_ReturnJson)
											ll_root = json_tarif.GetRootItem()
											
														
											lb_success = json_tarif.GetItemBoolean(ll_root, 'success')  
							
											if not lb_success then
												v_errorCode =  json_tarif.GetItemNumber(ll_root, 'errorCode')  
												v_error =   json_tarif.GetItemString(ll_root, 'error')
												
												if MessageBox("ATTENTION", "Erreur dans l'appel à la tarification pour le soin " + s_type_soins + " du " + string(d_date_prestation) + "~n~nErreur N° " + string(v_errorCode) +"~nMessage : " + v_error  + "~n~nVous n'avez pas d'engagement de Tarif !~n~nNous vous conseillons de ne pas mettre ce soin dans cette facture.~n~nConfirmez-vous cette suppression !" , Question!, YesNo!, 2  ) = 1 then 
													delete ligne_efacture_belgique where numero_facture = :l_numero_facture and cle = :cle_soin ; 
													commit ;
												else
													// Mise à jour de la ligne de soins
													update soins set derniere_efacture = :l_numero_facture where code = :var_code_local and cle = :cle_soin ;
													commit ;
												end if
														
											else

												ll_tarification = json_tarif.GetItemObject(ll_root, "tarification")
												ll_tarif = json_tarif.GetItemArray(ll_tarification, 'tarif')
												
												// On n'a qu'un élément dans le tableau si on ne demande qu"un soin à la fois !
												ll_tarif_item = json_tarif.GetChildItem(ll_tarif, 1) 
												
												s_type_tarif = json_tarif.GetItemString(ll_tarif_item, "type")
												
												
												choose case s_type_tarif
													case "refus" 
														s_justification_refus = json_tarif.GetItemString(ll_tarif_item, "justification")
														
														MessageBox("ATTENTION", "Le soin " + s_type_soins + " du " + string(d_date_prestation) + " a été refusé avec le code motif : " + s_justification_refus + "~n~nLe soin a donc été supprimé de la facture !"   )
														delete ligne_efacture_belgique where numero_facture = :l_numero_facture and cle = :cle_soin ; 
														commit ;
														
														
													case "error" 
														v_errorCode =  json_tarif.GetItemNumber(ll_tarif_item, 'code')  
														v_error =   string_non_nulle(json_tarif.GetItemString(ll_tarif_item, 'description'))
														if MessageBox("ATTENTION TARIFICATION", "Une erreur s'est produite pour le soin " + s_type_soins + " du " + string(d_date_prestation) + " :~n~nErreur N° " + string(v_errorCode) +"~nMessage : " + v_error + "~n~nSouhaitez-vous tout de même conserver le soin dans la facture ?" , Question!, YesNo!, 2  ) = 2 then 
															// on supprime
															delete ligne_efacture_belgique where numero_facture = :l_numero_facture and cle = :cle_soin ; 
															commit ;
														else
															// Mise à jour de la ligne de soins
															update soins set derniere_efacture = :l_numero_facture where code = :var_code_local and cle = :cle_soin ;
															commit ;
														end if
														
													case "tarif"
														s_contrat = json_tarif.GetItemString(ll_tarif_item, "contrat")
														d_date_contrat = json_tarif.GetItemDate(ll_tarif_item, "date")
														string ss
														double dd
														s_montant_rembourse_oa = json_tarif.GetItemString(ll_tarif_item, "remboursementM")
														s_montant_rembourse_oa = gfx_tout_remplacer(s_montant_rembourse_oa, ",", ".")
														
														d_montant_rembourse_oa = dec(s_montant_rembourse_oa)
														
														if d_montant_rembourse_oa = d_montant_tp_caisse then 
														
															// Mise à à jour de la facture
															update ligne_efacture_belgique set "numero_engagement_tarif" = :s_contrat, "date_engagement_tarif" = :d_date_contrat, "montant_rembourse_oa" = :d_montant_rembourse_oa 
															where numero_facture = :l_numero_facture and cle = :cle_soin ; 
															commit ;
															
															// Mise à jour de la ligne de soins
															update soins set derniere_efacture = :l_numero_facture where code = :var_code_local and cle = :cle_soin ;
															commit ;
															
														else
															if SERIAL = "87001" then 
																// Uniquement pour les test internes
																if MessageBox("QUESTION SPECIALE 87001 POUR LES TESTS", "ATTENTION !~n~nErreur de montant le soin " + s_type_soins + " du " + string (d_date_prestation) +"~n~nMontant saisi en Tiers Payant : " + string(d_montant_tp_caisse, '0.00') +" €~nMontant remboursé par l'Organisme Assureur : " + string(d_montant_rembourse_oa, "0.00") + " €~n~nCliquez sur OUI pour le supprimer ou NON pour le conserver !" , Question! , YesNo!, 2) = 1 then 
																	// Suppression
																	delete ligne_efacture_belgique where numero_facture = :l_numero_facture and cle = :cle_soin ; 
																	commit ;
																else
																	// on conserve 		
																	// Mise à à jour de la facture
																	update ligne_efacture_belgique set "numero_engagement_tarif" = :s_contrat, "date_engagement_tarif" = :d_date_contrat, "montant_rembourse_oa" = :d_montant_rembourse_oa 
																	where numero_facture = :l_numero_facture and cle = :cle_soin ; 
																	commit ;
																	
																	// Mise à jour de la ligne de soins
																	update soins set derniere_efacture = :l_numero_facture where code = :var_code_local and cle = :cle_soin ;
																	
																	commit ;
																end if
															else
																// pour tous les clients
																MessageBox("ATTENTION", "Erreur de montant le soin " + s_type_soins + " du " + string (d_date_prestation) +"~n~nMontant saisi en Tiers Payant : " + string(d_montant_tp_caisse, '0.00') +" €~nMontant remboursé par l'Organisme Assureur : " + string(d_montant_rembourse_oa, "0.00") + " €~n~nLe soin a donc été supprimé de la facture !"   )
																delete ligne_efacture_belgique where numero_facture = :l_numero_facture and cle = :cle_soin ; 
																commit ;
															end if
														end if
												
												end choose
											end if
										
										end if

										

									else
										messagebox("ATTENTION","Erreur N°2 - Impossible d'insérer une ligne de facture !~n~nActe : " + s_type_soins + " du " + string(d_date_prestation) + "~n~n" + sqlca.sqlerrtext)
										rollback ;
									end if
				
									
									
								end if
							next
				
							
							// Vérification s'il reste encore au moins une ligne de facture 
							select isnull(count(*),0) into :v_cpt from 	ligne_efacture_belgique 	where numero_facture = :l_numero_facture  ; 
							
							
							if v_cpt > 0 then 
								// mise à jour de la facture
								param_win[1] = "M"
								// type de facture
								param_win[2] = "F"
								openwithparm(w_efacturation_belgique_maj, l_numero_facture)
								
								//guo_fenetre_modale.wf_ouvrir_param_nombre(w_efacturation_belgique_maj, l_numero_facture)
								
								dw_soins.retrieve(var_code_local)
								
								// repositionnement sur la ligne courante AVANT ....
								if ligne_courante > 0 then
									dw_soins.setrow(ligne_courante)
									dw_soins.scrolltorow(ligne_courante)
								end if
							else
								
								// plus de ligne dans la facture
								delete from efacture_belgique 	where numero_facture = :l_numero_facture  ; 
								commit ; 
								
								
								messagebox("ATTENTION","Erreur N°3 - Il n'y a plus de ligne à facturer !")
								
								
								
							end if
	
							
							
						else
							messagebox("ATTENTION","Erreur N°1 - Impossible de créer cette facture !~n~n" + sqlca.sqlerrtext)
							rollback ;
						end if
						
					end if
				end if
			end if
		end if
	end if
end if

close(w_patience)
end event

