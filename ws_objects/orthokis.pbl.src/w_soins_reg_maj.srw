type cb_supprimer from uo_picturebutton_390x120 within w_soins_reg_maj
integer x = 1024
integer y = 2444
integer width = 443
integer height = 152
integer taborder = 630
string text = "&Supprimer"
string tiptext = "Suppression du ou des soins"
string iconname = "ACTIONS_supprimer.png"
end type

event clicked;call super::clicked;double lig_soin 
integer cpt_reg


string v_nom_soin
date var_date_dem, var_date_dem_supprime, var_date_dem_supprime_derniere
double var_tot, v_cle
string cde, v_id_tea

long lig, nb_lig, nb_selection, nb_apres
string libelle_suppression
integer v_duree, v_duree_ligne
boolean v_suite

// -------------------------------------------------------------------------------------------------------- SOINS PREVUS
if type_gestion = 'P' then
	if dw_soins_prevus.rowcount() = 0 then
		son(5)
		MessageBox("ATTENTION !","Aucun soin prévu n'a été saisi !")
	else
		
		// Ligne courante
		lig_soin = dw_soins_prevus.getrow()
		
		// recherche si plusieurs lignes sélectionnées
		nb_lig = dw_soins_prevus.rowcount()
		
		nb_selection = 0
		
		for lig = 1 to nb_lig
			
			if dw_soins_prevus.getitemstring(lig , "fse") = "O" then
				nb_selection = nb_selection + 1
			end if
			
		next 
		
		if nb_selection > 1 then
			libelle_suppression = "La suppression de ces "+ string(nb_selection)+ " lignes sera définitive !"
		else
			libelle_suppression = "La suppression de ce soin sera définitive !"
		end if
		
		if MessageBox("ATTENTION !", libelle_suppression  + "~n~nConfirmez-vous ?",Question!,yesNo!,2) = 1 then
	
			
			if nb_selection = 0 then
				// rien de cocher => on coche la ligne courante
				if lig_soin < 1 then
					lig_soin = 1
				end if
				nb_selection  = 1
				dw_soins_prevus.Setitem(lig_soin , "fse", "O")
			end if
			
			v_duree = 0
	
			lig_soin = dw_soins_prevus.Find( "fse = 'O'", 1, 99999)
			
			// On va parcourir la liste pour voir si on a supprimer plusieurs soins QUI SE SUIVENT
			
			if lig_soin > 0 then
				
				var_date_dem_supprime = dw_soins_prevus.getItemDate(lig_soin, "date_demande")
							
				do while lig_soin <= nb_lig  and dw_soins_prevus.getItemString(lig_soin, "fse") = "O"
					v_duree_ligne = dw_soins_prevus.getItemNumber(lig_soin, "code_soins_duree")
					var_date_dem_supprime_derniere = dw_soins_prevus.getItemDate(lig_soin, "date_demande")
					zeroi(v_duree_ligne)
					v_duree = v_duree + v_duree_ligne
					
					lig_soin = lig_soin + 1
				loop
				
				if v_duree > 0 and lig_soin <= nb_lig then 
					// Y a une durée de supprimer et des soins après, on pose la question 
					if MessageBox("ATTENTION !", "Vous venez de supprimer un/des soin(s) durant " +  string(v_duree)+ " mois.~n~nSouhaitez-vous avancer d'autant les soins suivants ?", Question!,yesNo!,2) = 2 then
						v_duree = 0
					end if
				else
					v_duree = 0
				end if
			end if
			
			// on balaie pour supprimer
			for lig_soin = 1 to nb_lig
				
				if dw_soins_prevus.getitemstring(lig_soin , "fse") = "O" then
					cle_manip = dw_soins_prevus.getitemnumber(lig_soin,"cle")
			
					  DELETE FROM "ligne_soins_prevus"  
						WHERE ( code = :var_code_local ) AND  
								( cle = :cle_manip )   ;
			
					  DELETE FROM "soins_prevus"  
						WHERE ( code = :var_code_local ) AND  
								( cle = :cle_manip )   ;
						
					v_nom_soin = dw_soins_prevus.getitemstring(lig_soin,"code_soins_nom")
					var_date_dem = dw_soins_prevus.getitemdate(lig_soin,"date_demande")
					var_tot = dw_soins_prevus.getitemnumber(lig_soin,"total")
			
					ajout_histo_actions(var_code_local,"SUPSOP",today(),v_nom_soin +" - " + string(var_date_dem, "dd/mm/yyyy")+" - "+string(var_tot,'0.00'))
					
					COMMIT ;
					
				end if
	
				
			next
			
			
			if v_duree > 0 then
				// Délage des soins suivants ... 
//				cde = 'UPDATE ligne_soins_prevus, soins_prevus, code_soins SET "date" = months("date",'+string(- v_duree)+') WHERE "soins_prevus"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins_prevus"."code" = "ligne_soins_prevus"."code" and "soins_prevus"."cle" = "ligne_soins_prevus"."cle" and "soins_prevus"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(var_date_dem_supprime,'yyyy-mm-dd') +"'"
				cde = 'UPDATE ligne_soins_prevus, soins_prevus, code_soins SET "date" = dateadd (month, ' + string(- v_duree) + ' , "date") WHERE "soins_prevus"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins_prevus"."code" = "ligne_soins_prevus"."code" and "soins_prevus"."cle" = "ligne_soins_prevus"."cle" and "soins_prevus"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(var_date_dem_supprime,'yyyy-mm-dd') +"'"
				EXECUTE IMMEDIATE :cde ;
				if sqlca.sqlcode <> 0 then
					messagebox("Problème dans l'actualisation 1",sqlca.sqlerrtext)
					rollback ;
				else

					// Décalage des soins suivants ... 
//					cde = 'UPDATE soins_prevus, code_soins SET "date_demande" = months("date_demande",'+string(- v_duree)+')  WHERE "soins_prevus"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins_prevus"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(var_date_dem_supprime,'yyyy-mm-dd') +"'"
					cde = 'UPDATE soins_prevus, code_soins SET "date_demande" = dateadd (month, ' + string(- v_duree) + ' , "date_demande")   WHERE "soins_prevus"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins_prevus"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(var_date_dem_supprime,'yyyy-mm-dd') +"'"
					EXECUTE IMMEDIATE :cde ;
					if sqlca.sqlcode <> 0 then
						messagebox("Problème dans l'actualisation 2",sqlca.sqlerrtext)
						rollback ;
					else
						commit ;
					end if
				end if
				
			end if

			
			
				
			dw_soins_prevus.retrieve(var_code_local, var_code_devis_local)
			
			if lig_soin > dw_soins.rowcount() then
				lig_soin = dw_soins.rowcount()
			end if
			// On se met sur le soin suivant sinon on reset
			if dw_soins_prevus.rowcount() > 0 then
				dw_soins_prevus.Scrolltorow(lig_soin)
				dw_soins_prevus.SetRow(lig_soin)
				dw_soins_prevus.setfocus()
			else
				dw_detail_soins_prevus.reset()
			end if
	
		end if
	end if
	
	
else
	
	// -------------------------------------------------------------------------------------------------------- SOINS NORMAUX
	if dw_soins.rowcount() = 0 then
		son(5)
		MessageBox("ATTENTION !","Aucun soin n'a été saisi !")
	else
		// Ligne courante
		lig_soin = dw_soins.getrow()
		
		// recherche si plusieurs lignes sélectionnées
		nb_lig = dw_soins.rowcount()
		
		nb_selection = 0
		
		integer nb_attestation = 0
		integer nb_fs = 0
		integer nb_transfert = 0
		integer nb_facture = 0
		integer nb_efacture
		
		for lig = 1 to nb_lig
			
			
			if SERIAL = "87644" then
				if dw_soins.getitemstring(lig , "fse") = "O" then
					// pour Fac de Montpellier .. on interdit la suppression si soin envoyé à Facturation Hopital (Pastel)
					// On se sert de Transfert pour marquer ou pas le transfert
					if not isnull(dw_soins.getitemstring(lig , "soins_transfert")) then
						nb_transfert = nb_transfert + 1
						nb_selection = nb_selection + 1
					end if
				end if
			else
				if dw_soins.getitemstring(lig , "fse") = "O" then
					nb_selection = nb_selection + 1
					if dw_soins.getitemstring(lig , "attestation_belgique") = "A"  then
						nb_attestation = nb_attestation + 1
					end if
					if dw_soins.getitemstring(lig , "soins_fse_edite") = "V"  or dw_soins.getitemstring(lig , "soins_fse_edite") = "M"  then
						nb_fs = nb_fs + 1
					end if
					if dw_soins.getitemNumber(lig , "numero_facture") > 0  then
						nb_facture = nb_facture + 1
					end if
					if BELGIQUE then
						if dw_soins.getitemNumber(lig , "derniere_efacture") > 0  then
							nb_efacture = nb_efacture + 1
						end if
					end if
				end if
			end if
		next 
		
		v_suite = true
		
		if nb_selection = 0 then
			// rien de cocher => on verifie la ligne courante pour 
			if lig_soin > 0 then
				
				if SERIAL = "87644" then
					// pour Fac de Montpellier .. on interdit la suppression si soin envoyé à Facturation Hopital (Pastel)
					// On se sert de Transfert pour marquer ou pas le transfert
					if not isnull(dw_soins.getitemstring(lig , "soins_transfert")) then
						nb_transfert = nb_transfert + 1
					end if
				else
					if dw_soins.getitemstring(lig_soin , "attestation_belgique") = "A" or dw_soins.getitemstring(lig_soin , "attestation_belgique") = "E"  then
						nb_attestation = 1
					end if
					if dw_soins.getitemstring(lig_soin , "soins_fse_edite") = "V"  or dw_soins.getitemstring(lig_soin , "soins_fse_edite") = "M"  then
						nb_fs =  1
					end if
					if dw_soins.getitemNumber(lig_soin , "numero_facture") > 0  then
						nb_facture = 1
					end if
				end if

			end if
		end if
		
		
		if droits_acces[84] = "N" then
			// vérification si déjà FS ou Facture
			if SERIAL = "87644" and nb_transfert > 0 then
					MessageBox("ATTENTION !", "Vous n'êtes pas autorisé à supprimer une ligne de soin ayant été transféré dans la Facturation Pastel.") 
					v_suite = false
			else
				if Belgique and nb_attestation > 0 then 
					MessageBox("ATTENTION !", "Vous n'êtes pas autorisé à supprimer une ligne de soin ayant fait l'objet d'une Attestation (ou eAttestation).") 
					v_suite = false
				else
					if nb_fs > 0 then 
						MessageBox("ATTENTION !", "Vous n'êtes pas autorisé à supprimer une ligne de soin ayant fait l'objet d'une Feuille de Soin.") 
						v_suite = false
					end if
				end if
			end if
		end if
		
		if nb_efacture > 0 then
			MessageBox("ATTENTION !", "Vous ne pouvez pas supprimer un soin qui a fait l'objet d'une eFacture.~n~nLa supression est donc impossible !") 
			v_suite = false
		end if
		
		if droits_acces[83] = "N" then
			// On n'a pas le droit de supprimer une facture => si facture, on ne supprime pas le soin !!
			if nb_facture > 0 then
				if nb_facture = 1 then
					MessageBox("ATTENTION !", "Vous n'êtes pas autorisé à supprimer une facture. Or, un soin a fait l'objet d'une Facture.~n~nLa supression est donc impossible !") 
				else
					MessageBox("ATTENTION !", "Vous n'êtes pas autorisé à supprimer une facture. Or, " + string(nb_facture) +  "  soins on fait l'objet d'une Facture.~n~nLa supression est donc impossible !") 
				end if
				v_suite = false
			end if
		end if
		
		if nb_selection > 1 then
			libelle_suppression = "La suppression de ces "+ string(nb_selection)+ " lignes sera définitive !"
		else
			libelle_suppression = "La suppression de ce soin sera définitive !"
		end if
		
		if v_suite then
			
			if MessageBox("ATTENTION !", libelle_suppression  + "~n~nConfirmez-vous ?",Question!,yesNo!,2) = 1 then
		
				if nb_selection = 0 then
					// rien de cocher => on coche la ligne courante
					if lig_soin < 1 then
						lig_soin = 1
					end if
					nb_selection  = 1
					dw_soins.Setitem(lig_soin , "fse", "O")
				end if

				v_duree = 0
		
				lig_soin = dw_soins.Find( "fse = 'O'", 1, 99999)
				
				// On va parcourir la liste pour voir si on a supprimer plusieurs soins QUI SE SUIVENT
				
				if lig_soin > 0 then
					
					var_date_dem_supprime = dw_soins.getItemDate(lig_soin, "date_demande")
								
					do while lig_soin <= nb_lig  and dw_soins.getItemString(lig_soin, "fse") = "O"
						v_duree_ligne = dw_soins.getItemNumber(lig_soin, "code_soins_duree")
						var_date_dem_supprime_derniere = dw_soins.getItemDate(lig_soin, "date_demande")
						zeroi(v_duree_ligne)
						v_duree = v_duree + v_duree_ligne
						
						lig_soin = lig_soin + 1
					loop
					
					if v_duree > 0 and lig_soin <= nb_lig then 
						// Y a une durée de supprimer et des soins après, on pose la question 
						if MessageBox("ATTENTION !", "Vous venez de supprimer un/des soin(s) durant " +  string(v_duree)+ " mois.~n~nSouhaitez-vous avancer d'autant les soins suivants ?", Question!,yesNo!,2) = 2 then
							v_duree = 0
						end if
					else
						v_duree = 0
					end if
				end if
				
				
//				// On ne propose de décaler les soins que si on ne supprime qu'une ligne ...
//				if nb_selection  = 1 then
//					// Est ce que le soin supprimée à une durée ?
//					lig_soin = dw_soins.Find( "fse = 'O'", 1, 99999)
//					
//					if lig_soin > 0 then
//						v_duree = dw_soins.getItemNumber(lig_soin, "code_soins_duree")
//						var_date_dem_supprime = dw_soins.getItemDate(lig_soin, "date_demande")
//						zeroi(v_duree)
//						if v_duree > 0 then 
//							
//							if MessageBox("ATTENTION !", "Vous venez de supprimer un soin durant " +  string(v_duree)+ " mois.~n~nSouhaitez-vous avancer d'autant les soins suivants ?", Question!,yesNo!,2) = 2 then
//								v_duree = 0
//							end if
//						end if
//					end if
//				end if
//
				
				// on balaie pour supprimer
				for lig_soin = 1 to nb_lig
	
					
					
					if dw_soins.getitemstring(lig_soin , "fse") = "O" then
						cle_manip = dw_soins.getitemnumber(lig_soin,"cle")
				
						// Vérification de règlements saisis
						SELECT count(*) INTO :cpt_reg FROM paye WHERE code = :var_code_local and cle = :cle_manip ;
				
						v_nom_soin = trim(dw_soins.getitemstring(lig_soin,"code_soins_nom"))
						var_date_dem = dw_soins.getitemdate(lig_soin,"date_demande")
						var_tot = dw_soins.getitemnumber(lig_soin,"total")
	
						if cpt_reg > 0 then 
							son(5)
							MessageBox("ATTENTION !","~n~nDate : " + string(var_date_dem)+"~nLibellé : "+v_nom_soin + "~nMontant : "+string(var_tot, "0.00")+"~n~nLa suppression de ce soin est impossible !~n~n(Des règlements ont été saisis)")
						else
				
							son(7)
				
						  DELETE FROM "ligne_soins"  
							WHERE ( code = :var_code_local ) AND  
									( cle = :cle_manip )   ;
				
						  DELETE FROM "soins"  
							WHERE ( code = :var_code_local ) AND  
									( cle = :cle_manip )   ;
				
							
							if APPEL_VISIODENT then
								// On ne valide QUE si ok
								if fxg_ods_suppression_soin(var_code_local, cle_manip) then
									commit ;
									ajout_histo_actions(var_code_local,"SUPSOI",today(),v_nom_soin +" - " + string(var_date_dem, "dd/mm/yyyy")+" -  "+string(var_tot,'0.00'))
								else
									rollback ;
								end if
				
							else
								commit ;
								if TEA then
									if var_tot > 0 then 
										//fxg_lancer_commande_dsapi("payment/delete/" + string(var_code_local)+"-"+string(cle_manip), "",  "S", "G", var_code_local )
										fxg_maj_soins_tea(var_code_local, cle_manip, "D")
									end if
								end if

								ajout_histo_actions(var_code_local,"SUPSOI",today(),v_nom_soin +" - " + string(var_date_dem, "dd/mm/yyyy")+" -  "+string(var_tot,'0.00'))
							end if
				
						end if
					end if
						
					next
					
					if v_duree > 0 then
						// Délage des soins suivants ... 
//						cde = 'UPDATE ligne_soins,soins,code_soins SET "date" = months("date",'+string(- v_duree)+') WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins"."code" = "ligne_soins"."code" and "soins"."cle" = "ligne_soins"."cle" and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(var_date_dem_supprime,'yyyy-mm-dd') +"'"
						cde = 'UPDATE ligne_soins,soins,code_soins SET "date" = dateadd (month, ' + string(- v_duree) + ' , "date") WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins"."code" = "ligne_soins"."code" and "soins"."cle" = "ligne_soins"."cle" and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(var_date_dem_supprime,'yyyy-mm-dd') +"'"
						EXECUTE IMMEDIATE :cde ;
						if sqlca.sqlcode <> 0 then
							messagebox("Problème dans l'actualisation 1",sqlca.sqlerrtext)
							rollback ;
						else

							// Décalage des soins suivants ... 
//							cde = 'UPDATE soins,code_soins SET "date_demande" = months("date_demande",'+string(- v_duree)+'),  "date_exe" = months("date_exe",'+string(- v_duree)+')    WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(var_date_dem_supprime,'yyyy-mm-dd') +"'"
							cde = 'UPDATE soins,code_soins SET "date_demande" = dateadd (month, ' + string(- v_duree) + ' , "date_demande") , "date_exe" = dateadd (month, ' + string(- v_duree) + ' , "date_exe")    WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins"."code" = '+string(var_code_local) + ' and "date_demande" >= '+"'"+string(var_date_dem_supprime,'yyyy-mm-dd') +"'"
							EXECUTE IMMEDIATE :cde ;
							if sqlca.sqlcode <> 0 then
								messagebox("Problème dans l'actualisation 2",sqlca.sqlerrtext)
								rollback ;
							else
								commit ;
								if TEA then
									declare cur_soins cursor for select cle from soins,code_soins  WHERE "soins"."type" = "code_soins"."code"  and "code_soins"."duree" > 0  and "soins"."code" = :var_code_local and "date_demande" >= :var_date_dem_supprime ;
									open cur_soins ;
									fetch cur_soins into :v_cle ;
									do while sqlca.sqlcode = 0  
										v_id_tea = string(var_code_local) + "-" + string(v_cle)
										//fxg_lancer_commande_dsapi("payment/update/" + v_id_tea, "",  "S", "G", var_code_local )
										fxg_maj_soins_tea(var_code_local, v_cle, "U")
										fetch cur_soins into :v_cle ;
									loop
									close cur_soins ;
								end if
							end if
						end if
						
						if APPEL_VISIODENT and not VISIODENT_LIMITE then
							fxg_ods_envoi_soins_date(var_code_local, var_date_dem_supprime)
						end if
						
					end if
					
					
					
					dw_soins.retrieve(var_code_local)
					
					// Raffraichissement  de la barre si besoin

					if profilestring(dir_ini+inifile_orthokis,"admini","afficher_barre_avance_clinique_soins","N") = "O" then 
						uo_traitement.maj(var_code_local)
					end if

					if lig_soin > dw_soins.rowcount() then
						lig_soin = dw_soins.rowcount()
					end if
					// On se met sur le soin suivant sinon on reset
					if dw_soins.rowcount() > 0 then
						dw_soins.Scrolltorow(lig_soin)
						dw_soins.SetRow(lig_soin)
						dw_soins.setfocus()
					else
						dw_detail.reset()
					end if
		
			end if
		end if
	end if
end if


end event

type cb_bis from uo_picturebutton_390x120 within w_soins_reg_maj
integer x = 457
integer y = 2444
integer width = 288
integer height = 152
integer taborder = 590
fontcharset fontcharset = ansi!
string text = "&Bis"
string tiptext = "Duplique le soin à la suite, en tenant compte de sa durée"
end type

event clicked;call super::clicked;double lig_soin , cle_soin
date demande, execution, accord
double scp_demande, hn, total, tp, cle_max, scp_accord
double numero
integer duree
string v_type_soin, v_norme_prescripteur

string v_nom_soin
date var_date_dem
double var_tot
string v_execution_immediate, v_motif, v_lettre, v_dent, v_code_association
long nb_lig, nb_selection

boolean v_suite = true

if type_gestion = 'P' then
	// Répète la ligne de soins sur laquelle est le curseur en la décalant de la durée du soin
	
	if dw_soins_prevus.rowcount() = 0 then
		son(5)
		MessageBox("ATTENTION !","Aucun soin prévu n'a été saisi !")
	else
			 
			// recherche si plusieurs lignes sélectionnées
			nb_lig = dw_soins_prevus.rowcount()
		
			nb_selection = 0
		
			for lig_soin = 1 to nb_lig
				
				if dw_soins_prevus.getitemstring(lig_soin , "fse") = "O" then
					nb_selection = nb_selection + 1
				end if
			next

			
			if nb_selection = 0 then 
				// Pas de case cochée => on coche la ligne courante 
				lig_soin = dw_soins_prevus.getrow()
			
				if lig_soin < 1 Then
					lig_soin = 1
				end if
				
				dw_soins_prevus.Setitem(lig_soin , "fse", "O")
			end if
			
			
			for lig_soin = 1 to nb_lig
				if dw_soins_prevus.getitemstring(lig_soin , "fse") = "O" then

			
					cle_soin = dw_soins_prevus.getitemnumber(lig_soin,"cle")
			
					demande = dw_soins_prevus.getitemdate(lig_soin,"date_demande")
					hn = dw_soins_prevus.getitemnumber(lig_soin,"hn")
					total = dw_soins_prevus.getitemnumber(lig_soin,"total")
					scp_demande = dw_soins_prevus.getitemnumber(lig_soin,"scp_demande")
					tp = dw_soins_prevus.getitemnumber(lig_soin,"tp")
					numero = dw_soins_prevus.getitemnumber(lig_soin,"numero")
					v_type_soin = dw_soins_prevus.getitemstring(lig_soin,"code_soins_code")
					
				
				  SELECT isnull("code_soins"."duree"  ,0)
					 INTO :duree
					 FROM "code_soins"  
					WHERE "code_soins"."code" = :v_type_soin   ;
				
				
					
					// Ajout du soins pour le patient
						
					
						select max(cle) into :cle_max from "soins_prevus" where code = :var_code_local ;
						cle_max = cle_max + 1
						
						select isnull(max(numero),0) into :numero from  "soins_prevus" where code = :var_code_local and "type" = :v_type_soin and code_devis = :var_code_devis_local;
						
						if duree > 0 then
							numero = numero + 1
						else
							setnull(numero)
						end if
						
			
						  INSERT INTO "soins_prevus"  
							( "cle", 	"code","type","numero","date_demande","scp_demande",   
							  "date_accord","scp_accord","hn","total","tp","user_modif","date_modif", "code_devis" )  
							VALUES ( :cle_max,:var_code_local,:v_type_soin,:numero,  dateadd (month, :duree, :demande), :scp_demande,
								null,null,:hn,:total,:tp, :utilisateur_code,getdate(), :var_code_devis_local )  ;
				
				
						// Ajout des lignes de soins
						  INSERT INTO "ligne_soins_prevus"  
							( "cle",   				  "code",   				  "date",   				  "montant",   				  "tp",   				  "origine_tp" )  
					  SELECT :cle_max,   
								"ligne_soins_prevus"."code",   
								dateadd (month, :duree, "ligne_soins_prevus"."date") ,   
								"ligne_soins_prevus"."montant",   
								"ligne_soins_prevus"."tp",   
								"ligne_soins_prevus"."origine_tp"  
						 FROM "ligne_soins_prevus" 
						 WHERE code = :var_code_local and cle = :cle_soin ;
						
						commit ;
						
						
						// Mise en historique des actions
						select trim("code_soins"."nom"), soins_prevus.date_demande, soins_prevus.total into :v_nom_soin,  :var_date_dem , :var_tot 
						from soins_prevus , code_soins 
						where soins_prevus."type" = code_soins.code and soins_prevus.code = :var_code_local and cle = :cle_max ;
						ajout_histo_actions(var_code_local,"AJOSOP",today(),v_nom_soin +" - " + string(var_date_dem, "dd/mm/yyyy")+" - "+string(var_tot,'0.00'))
				
					end if
					
				next
	
				
				
				// On reset l'affichage ....
				
				dw_soins_prevus.reset()
				dw_soins_prevus.retrieve(var_code_local, var_code_devis_local)
				
				lig_soin = dw_soins_prevus.rowcount()
	
				// On se met sur le soin qu'on vient d'ajouter (en principe le dernier ?)
				if lig_soin > 0 then
					dw_soins_prevus.Scrolltorow(lig_soin)
					dw_soins_prevus.SetRow(lig_soin)
					dw_soins_prevus.setfocus()
				End If
		
	end if
		
		
	
else
	
	// Gestion des soins
	
	// Répète la ligne de soins sur laquelle est le curseur en la décalant de la durée du soin

	if dw_soins.rowcount() = 0 then
		son(5)
		MessageBox("ATTENTION !","Aucun soin n'a été saisi !")
	else
		
			// recherche si plusieurs lignes sélectionnées
			nb_lig = dw_soins.rowcount()
		
			nb_selection = 0
		
			for lig_soin = 1 to nb_lig
				
				if dw_soins.getitemstring(lig_soin , "fse") = "O" then
					nb_selection = nb_selection + 1
				end if
			next

			
			if nb_selection = 0 then 
				// Pas de case cochée => on coche la ligne courante 
				lig_soin = dw_soins.getrow()
			
				if lig_soin < 1 Then
					lig_soin = 1
				end if
				
				dw_soins.Setitem(lig_soin , "fse", "O")
			end if
			
			
			for lig_soin = 1 to nb_lig
				if dw_soins.getitemstring(lig_soin , "fse") = "O" then

	
					cle_soin = dw_soins.getitemnumber(lig_soin,"cle")
			
					demande = dw_soins.getitemdate(lig_soin,"date_demande")
					accord  = dw_soins.getitemdate(lig_soin,"date_accord")
					hn = dw_soins.getitemnumber(lig_soin,"hn")
					total = dw_soins.getitemnumber(lig_soin,"total")
					scp_demande = dw_soins.getitemnumber(lig_soin,"scp_demande")
					scp_accord = dw_soins.getitemnumber(lig_soin,"scp_accord")
					tp = dw_soins.getitemnumber(lig_soin,"tp")
					numero = dw_soins.getitemnumber(lig_soin,"numero")
					v_type_soin = dw_soins.getitemstring(lig_soin,"code_soins_code")
					v_motif = dw_soins.getitemstring(lig_soin,"motif_depassement")
					v_lettre = dw_soins.getitemstring(lig_soin,"code_soins_lettre")
				
					v_dent = dw_soins.getitemstring(lig_soin,"soins_dent")
					v_code_association = dw_soins.getitemstring(lig_soin,"soins_code_association")
				
				
				  SELECT isnull("code_soins"."duree" , 0) , "execution_immediate" 
					 INTO :duree, :v_execution_immediate
					 FROM "code_soins"  
					WHERE "code_soins"."code" = :v_type_soin   ;
				
					if belgique then 
						// efacturation 
						 SELECT "norme_prescripteur"  	 INTO :v_norme_prescripteur
						 FROM "soins"  WHERE "code" = :var_code_local and "cle" = :cle_soin ;
					end if
				
				
					demande = ajout_x_mois(demande, duree) 
					
					if v_execution_immediate = "O" then
						execution = demande
					else
						execution = ajout_x_mois(demande, duree)
					end if
				
					if Belgique then
						v_suite = verif_regles_soins_belges(var_code_local, v_type_soin, demande , true)
					else
						v_suite = true
					end if
			
				
				
					if v_suite then		
						// Ajout du soins pour le patient
				
						select max(cle) into :cle_max from "soins" where code = :var_code_local ;
						cle_max = cle_max + 1
						
						select isnull(max(numero),0) into :numero from  "soins" where code = :var_code_local and "type" = :v_type_soin ;

						if duree > 0 then
							numero = numero + 1
						else
							setnull(numero)
						end if
						
						
						// TO 45 en exo 3 et TO >= 60
						if CCVITALE and (scp_demande = 45 or scp_demande >=60 ) and (v_lettre = 'TO' or v_lettre = 'ORT') then
							  INSERT INTO "soins"  
								( "cle", 				"code",   				  "type",   				  "numero",   				  "date_demande",   				  "scp_demande",   
								  "date_accord",   				  "scp_accord",   				  "hn",   				  "total",   				  "tp",   				  "date_cara",   
								  "date_impr",   				  "date_donne",   				  "date_rapport",   				  "comment",   				  "date_exe",
								  "user_modif",				  "date_modif" , "motif_depassement" , "exo")  
							 VALUES ( :cle_max,   	:var_code_local,   	:v_type_soin,   			:numero,   		  :demande, 				  :scp_demande,
								null,   				  :scp_accord,   				  :hn,   				  :total,   				  :tp,   				  null,   				  
								  null,   					  null,   				  		null,   				  	null,     :execution , 				  :utilisateur_code,				  getdate() , :v_motif , '3')  ;
						else
							
							if belgique  then
								// Zones de eFacturation
									  INSERT INTO "soins"  
								( "cle", 				"code",   				  "type",   				  "numero",   				  "date_demande",   				  "scp_demande",   
								  "date_accord",   				  "scp_accord",   				  "hn",   				  "total",   				  "tp",   				  "date_cara",   
								  "date_impr",   				  "date_donne",   				  "date_rapport",   				  "comment",   				  "date_exe",
								  "user_modif",				  "date_modif" , "motif_depassement" , "norme_prescripteur")  
							 VALUES ( :cle_max,   	:var_code_local,   	:v_type_soin,   			:numero,   		  :demande, 				  :scp_demande,
								null,   				  :scp_accord,   				  :hn,   				  :total,   				  :tp,   				  null,   				  
								  null,   					  null,   				  		null,   				  	null,     :execution , 				  :utilisateur_code,				  getdate() , :v_motif, :v_norme_prescripteur )  ;						
								
							else
							  INSERT INTO "soins"  
								( "cle", 				"code",   				  "type",   				  "numero",   				  "date_demande",   				  "scp_demande",   
								  "date_accord",   				  "scp_accord",   				  "hn",   				  "total",   				  "tp",   				  "date_cara",   
								  "date_impr",   				  "date_donne",   				  "date_rapport",   				  "comment",   				  "date_exe",
								  "user_modif",				  "date_modif" , "motif_depassement", "dent" , "code_association")  
							 VALUES ( :cle_max,   	:var_code_local,   	:v_type_soin,   			:numero,   		  :demande, 				  :scp_demande,
								null,   				  :scp_accord,   				  :hn,   				  :total,   				  :tp,   				  null,   				  
								  null,   					  null,   				  		null,   				  	null,     :execution , 				  :utilisateur_code,				  getdate() , :v_motif , :v_dent, :v_code_association)  ;
							end if
						end if
						
						
						// Ajout des lignes de soins
						  INSERT INTO "ligne_soins"  
							( "cle",   				  "code",   				  "date",   				  "montant",   				  "tp",   				  "origine_tp",  "non_prelevement"  )  
					  SELECT :cle_max,   					"ligne_soins"."code",   					dateadd (month, :duree,"ligne_soins"."date") ,   					"ligne_soins"."montant",   					"ligne_soins"."tp",   
								"ligne_soins"."origine_tp" , "non_prelevement"  
							FROM "ligne_soins" 
						 WHERE code = :var_code_local and cle = :cle_soin ;
						
						
						commit ;
			
						// Le soin vient d'être ajouté ou mis à jour => Mise à jour ODS
						if APPEL_VISIODENT and not VISIODENT_LIMITE and sqlca.sqlcode = 0 then
							fxg_ods_envoi_soin(var_code_local, cle_max, false)
						end if
						
						if TEA then
							//fxg_lancer_commande_dsapi("payment/create/" + string(var_code_local)+"-"+string(cle_max), "",  "S", "G", var_code_local )
							fxg_maj_soins_tea(var_code_local, cle_max, "C")
						end if
		
						// Mise en historique des actions
						select trim("code_soins"."nom"), soins.date_demande, soins.total into :v_nom_soin,  :var_date_dem , :var_tot 
						from soins , code_soins 
						where soins."type" = code_soins.code and soins.code = :var_code_local and cle = :cle_max ;
						
						ajout_histo_actions(var_code_local,"AJOSOI",today(),v_nom_soin +" - " + string(var_date_dem, "dd/mm/yyyy")+" - "+string(var_tot,'0.00'))
			
						
						
						// Est ce une insertion de soins ?
						insertion_soins(cle_max)
						
					end if
				end if
				
			next
	
				
				dw_soins.reset()
				dw_soins.retrieve(var_code_local)
				
				lig_soin = dw_soins.rowcount()
				
				// Raffraichissement  de la barre si besoin
				if profilestring(dir_ini+inifile_orthokis,"admini","afficher_barre_avance_clinique_soins","N") = "O" then 
					uo_traitement.maj(var_code_local)
				end if
	
				// On se met sur le soin qu'on vient d'ajouter (en principe le dernier ?)
				if dw_soins.rowcount() > 0 then
					dw_soins.Scrolltorow(lig_soin)
					dw_soins.SetRow(lig_soin)
					dw_soins.setfocus()
				End If
				

				
	
	end if
end if
end event

type cb_ajouter from uo_picturebutton_390x120 within w_soins_reg_maj
integer x = 9
integer y = 2444
integer width = 453
integer height = 152
integer taborder = 600
string text = "&Ajouter"
string tiptext = "Ajout d~'un soin / soin prévu"
string iconname = "ACTIONS_ajouter.png"
end type

event clicked;call super::clicked;// AJOUT D'UNE LIGNE DE SOINS ou SOINS PREVUS
//------------------------------------------------------------



// Recherche du 1er soin par défaut

long v_min
string v_code_defaut
boolean v_suite

select min(ordre_trie) into :v_min from code_soins where actif = 1 ;
	
if not isnull(v_min) then
		
	action = "A"
	modif_echeance_direct = false
	
	guo_fenetre_modale.wf_ouvrir_param_fenetre(w_soins_reg_maj_echeances, parent)

	//openWithParm(w_soins_reg_maj_echeances, parent)

	
	// Raffraichissement  de la barre si besoin
	if profilestring(dir_ini+inifile_orthokis,"admini","afficher_barre_avance_clinique_soins","N") = "O" then 
		uo_traitement.maj(var_code_local)
	end if

	
else
	Messagebox("ATTENTION !","Vous n'avez pas de Type de Soins actif !~n~nVeuillez en saisir !")
end if
	

end event

