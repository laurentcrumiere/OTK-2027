type cb_bis2 from uo_picturebutton_390x120 within w_soins_reg_maj
integer x = 741
integer y = 2444
integer width = 288
integer height = 152
integer taborder = 640
boolean bringtotop = true
string text = "Bis 2"
string tiptext = "Duplique le à la date du jour "
