event rbuttondown;integer nb

dw_click = this
w_click_soins_reg = parent


If row > 0 Then
	
	
	newmenu.m_soins.m_annulertransfertdusoin.visible = true


	// Pour le menu contextuel d'impression des feuilles 
	//w_click_soins_prevus = parent
	type_menu = 'P'
	
	if getItemString(row, "soins_prevus_transfert") = "O" then 
		newmenu.m_soins.m_annulertransfertdusoin.enabled = true
	else
		newmenu.m_soins.m_annulertransfertdusoin.enabled = false
	end if

	newmenu.m_soins.popmenu(w_mdi_2020.PointerX(), w_mdi_2020.PointerY() )

	
	

end if


end event

event retrieveend;if rowcount = 1 then
	// spécial ... on simule un changement de ligne pour être sûr qu'il sélectionne la ligne sinon ...
	dw_detail_soins_prevus.retrieve(var_code_local,this.getitemnumber(1,"cle"))
// S'il n'y a qu'une ligne, on ne met pas le focus pour obliger à cliquer avec le bouton gauche
// sinon, ça plante le bouton droit
//	this.SetRow(1)
//	This.SelectRow(1,True)
else
	if rowcount > 0 then
		dw_detail_soins_prevus.retrieve(var_code_local,this.getitemnumber(getrow(),"cle"))
	else
		dw_detail_soins_prevus.reset()
	end if
end if

end event

event rowfocuschanged;if this.rowcount() > 0 and currentrow> 0 then
	dw_detail_soins_prevus.retrieve(var_code_local,this.getitemnumber(currentrow,"cle"))
	This.Setrow(currentrow)
else
	dw_detail.reset()
end if

end event

event buttonclicked;
string ls_Object
ls_Object = String(dwo.name)

choose case ls_Object
		
	case "b_schema"
		if row > 0 then
			param_win[1] = "D"
			openWithParm(w_schema, GetItemString(1, "soins_dent"))

			// recup de la valeur retournée
			string v_extraction 
			v_extraction = message.StringParm
			if v_extraction <> "-1" then
				SetItem(1, "dent", v_extraction)
			end if
		end if

		
end choose

if enregistrement_automatique then
	tab_1.tabpage_soins.cb_enregistrer_impr.triggerevent(clicked!)
end if

end event

