event resize;Try 
	
	if not b_premier_resize then 
		
		uo_size.retaille(this)

		if v_mode_reglement = "R" then 
			// Ajustement des dw d'échéances
			integer v_delta
			v_delta = 270
			
			
			dw_detail.width = 1381 + v_delta
			
			dw_detail.modify("l_1.x2 = 1594")
			dw_detail.modify("l_2.x2 = 1594")
			dw_detail.modify("l_3.x2 = 1594")
			dw_detail.modify("nb_echeances.x = 955")
			dw_detail.modify("non_prelevement.visible = 1")
			dw_detail.modify("t_non_prelevement.visible = 1")
	
			// uniquement pour l'esthétique
			dw_detail_soins_prevus.width = dw_detail.width
			dw_detail_soins_prevus.modify("l_1.x2 = 1594")
			dw_detail_soins_prevus.modify("l_2.x2 = 1594")
			dw_detail_soins_prevus.modify("l_3.x2 = 1594")
			
			dw_detail_soins_prevus.modify("nb_echeances.x = 955")
			dw_detail_soins_prevus.modify("non_prelevement.visible = 1")
			dw_detail_soins_prevus.modify("t_non_prelevement.visible = 1")
			
			uo_titre_echeances.width = dw_detail.width 
			if type_gestion = "P" then
				uo_titre_echeances.retaille(couleur_bleue_soins, couleur_bleu_fonce, "")
			else
				uo_titre_echeances.retaille(couleur_verte_soins, couleur_vert_fonce, "")
			end if
			
		end if
		
		
		if profilestring(dir_ini+inifile_orthokis,"admini","afficher_barre_avance_clinique_soins","N") = "O" then 
		
			if not isvalid(uo_traitement) then
				// première ouverture => faut créer l'UO et le positionner
				OpenUserObject(uo_traitement, 50 * uo_size.ratiow, cb_ajouter.y - 180)
				uo_traitement.width =4485
				uo_traitement.height = 164  
				uo_traitement.maj(var_code_local)
				uo_traitement.tag = "no resize hauteur"
			end if

			long v_y_remonte
			v_y_remonte = 200
			dw_soins_prevus.height = dw_soins_prevus.height - v_y_remonte
			dw_soins.height = dw_soins.height - v_y_remonte
			tab_1.y = tab_1.y - v_y_remonte
			dw_detail.y = dw_detail.y - v_y_remonte
			dw_detail_soins_prevus.y = dw_detail_soins_prevus.y - v_y_remonte
			uo_traitement.visible = true
			
			uo_traitement.x = tab_1.x
			uo_traitement.width = dw_detail.x + dw_detail.width
		end if


		
	
		dragobject temp
		
		// resize des objets des onglets
		integer cpt 
		cpt = 1
		for cpt = 1 to upperbound(tab)
			temp = tab[cpt]
			choose case typeof(temp)
				case commandbutton!
					commandbutton cb
					cb = tab[cpt]
					cb.x = cb.x *  uo_size.ratiow
					cb.y = cb.y * uo_size.ratioh
				case picturebutton!
					picturebutton pcb
					pcb = tab[cpt]
					pcb.x = pcb.x  * max(1, min( uo_size.ratiow , 1.15))
					pcb.y = pcb.y * uo_size.ratioh
				case datawindow!
					datawindow dw
					dw = tab[cpt]
		
					
					if pos(dw.tag,"no resize",1) > 0  or pos(dw.tag,"no resizeall",1) > 0  then
						dw.x = (tab_1.tabpage_soins.width - dw.width - tab_1.tabpage_soins.cb_selection_soins.width ) / 2 
						dw.y = dw.y * uo_size.ratioh
					else
						// On centre la dw (reglement et complement de soins)
						dw.width = tab_1.tabpage_soins.width - 10
						dw.x = (tab_1.tabpage_soins.width - dw.width ) / 2 
						dw.y = dw.y * uo_size.ratioh
					end if
			end choose
			
		next
		
		
		
		// pour la gestion du clic bouton droit et de la facture
		w_click_soins_reg = this
		
		
		// resize des titre des dw
		uo_titre_soins.height = 120
		uo_titre_soins.x = dw_soins.x
		uo_titre_soins.y = dw_soins.y - uo_titre_soins.height
		uo_titre_soins.width = dw_soins.width
		uo_titre_soins.retaille(couleur_verte_soins, couleur_vert_fonce, "")

		
		uo_titre_soins_prevus.height = 120
		uo_titre_soins_prevus.x = dw_soins_prevus.x
		uo_titre_soins_prevus.y = dw_soins_prevus.y - uo_titre_soins_prevus.height
		uo_titre_soins_prevus.width = dw_soins_prevus.width
		uo_titre_soins_prevus.retaille(couleur_bleue_soins, couleur_bleu_fonce, "")
		
		
		// Echéances
		uo_titre_echeances.height = 120
		uo_titre_echeances.width = dw_detail.width
		uo_titre_echeances.y = tab_1.y
		uo_titre_echeances.x = this.width - uo_titre_echeances.width - 100
		if type_gestion = "P" then 
			uo_titre_echeances.retaille(couleur_bleue_soins, couleur_bleu_fonce , "")
		else
			uo_titre_echeances.retaille(couleur_verte_soins, couleur_vert_fonce, "")
		end if
		
		// On centre les dw du bas à droite
		dw_detail.x =  uo_titre_echeances.x
		dw_detail_soins_prevus.x  =  dw_detail.x
		dw_detail.y = uo_titre_echeances.y + uo_titre_echeances.height
		dw_detail_soins_prevus.y  =  dw_detail.y
		//dw_detail.height =  tab_1.height -  uo_titre_echeances.height
		
		
//		uo_titre_echeances.height = 120
//		uo_titre_echeances.x = dw_detail.x
//		uo_titre_echeances.width = dw_detail.width
//		uo_titre_echeances.y = dw_detail.y - uo_titre_echeances.height
//		uo_titre_echeances.retaille()
//		
		
		// pour les icones en bas à droite
		
		// Centrer par rapport aux échéances
//		uo_icones.x = (dw_detail.x + dw_detail.width/2)   - uo_icones.width / 2
		uo_icones.x = dw_detail.x + 20
		uo_icones.y = dw_detail.y + dw_detail.height   - uo_icones.height - 20
		
		tab_1.width = dw_detail.x - tab_1.x - 100
		

		// Pour les boutons Soins prévisionnels et les devis
		tab_1.tabpage_soins_prevus.dw_devis.x = (tab_1.width - (tab_1.tabpage_soins_prevus.dw_devis.width + 50 + tab_1.tabpage_soins_prevus.cb_transfert.width) ) / 2 + tab_1.x 
		tab_1.tabpage_soins_prevus.dw_devis.height = tab_1.tabpage_soins_prevus.height - 400
		
		tab_1.tabpage_soins_prevus.pb_ajouter_devis.x = tab_1.tabpage_soins_prevus.dw_devis.x + 490
		tab_1.tabpage_soins_prevus.pb_ajouter_devis.y = tab_1.tabpage_soins_prevus.dw_devis.y + tab_1.tabpage_soins_prevus.dw_devis.height + 200

		tab_1.tabpage_soins_prevus.pb_supprimer_devis.x = tab_1.tabpage_soins_prevus.pb_ajouter_devis.x +  tab_1.tabpage_soins_prevus.pb_ajouter_devis.width + 380
		tab_1.tabpage_soins_prevus.pb_supprimer_devis.y = tab_1.tabpage_soins_prevus.pb_ajouter_devis.y 
		 
		tab_1.tabpage_soins_prevus.cbx_detail.x = tab_1.tabpage_soins_prevus.pb_supprimer_devis.x + tab_1.tabpage_soins_prevus.pb_supprimer_devis.width + 380
		tab_1.tabpage_soins_prevus.cbx_detail.y = tab_1.tabpage_soins_prevus.pb_ajouter_devis.y 
		
		tab_1.tabpage_soins_prevus.cb_selection.x = tab_1.tabpage_soins_prevus.dw_devis.x + tab_1.tabpage_soins_prevus.dw_devis.width + 50 + 140
		tab_1.tabpage_soins_prevus.cb_deselection.x = tab_1.tabpage_soins_prevus.cb_selection.x 
		tab_1.tabpage_soins_prevus.cb_transfert.x = tab_1.tabpage_soins_prevus.dw_devis.x + tab_1.tabpage_soins_prevus.dw_devis.width + 50
		tab_1.tabpage_soins_prevus.cb_dupliquer.x = tab_1.tabpage_soins_prevus.cb_selection.x 
		tab_1.tabpage_soins_prevus.pb_aide.x = tab_1.tabpage_soins_prevus.cb_selection.x 
		
		tab_1.tabpage_soins_prevus.cb_selection.y = tab_1.tabpage_soins_prevus.dw_devis.y
		tab_1.tabpage_soins_prevus.cb_deselection.y = tab_1.tabpage_soins_prevus.cb_selection.y + tab_1.tabpage_soins_prevus.cb_selection.height + 10
		tab_1.tabpage_soins_prevus.cb_transfert.y = tab_1.tabpage_soins_prevus.cb_deselection.y + tab_1.tabpage_soins_prevus.cb_deselection.height + 10
		tab_1.tabpage_soins_prevus.cb_dupliquer.y = tab_1.tabpage_soins_prevus.cb_transfert.y + tab_1.tabpage_soins_prevus.cb_transfert.height + 10
		tab_1.tabpage_soins_prevus.pb_aide.y = tab_1.tabpage_soins_prevus.cb_dupliquer.y + tab_1.tabpage_soins_prevus.cb_dupliquer.height + 10
		
		
		
		//tab_1.tabpage_soins_prevus.pb_aide.y = tab_1.tabpage_soins_prevus.cb_transfert.y  + ( tab_1.tabpage_soins_prevus.cb_transfert.y - tab_1.tabpage_soins_prevus.cb_deselection.y)
		
		// Pour les boutons Soins 

		tab_1.tabpage_soins.cb_annuler_impr.y =  tab_1.tabpage_soins.dw_impression.height + 40
		tab_1.tabpage_soins.cb_enregistrer_impr.y =  tab_1.tabpage_soins.cb_annuler_impr.y
		tab_1.tabpage_soins.pb_aide_2.y =  tab_1.tabpage_soins.cb_annuler_impr.y
		
		tab_1.tabpage_soins.cb_annuler_impr.x = tab_1.tabpage_soins.dw_impression.x   + 334
		tab_1.tabpage_soins.cb_enregistrer_impr.x = tab_1.tabpage_soins.cb_annuler_impr.x + tab_1.tabpage_soins.cb_annuler_impr.width + 60
		tab_1.tabpage_soins.pb_aide_2.x	 = tab_1.tabpage_soins.cb_enregistrer_impr.x + tab_1.tabpage_soins.cb_enregistrer_impr.width + 60
		tab_1.tabpage_soins.pb_aide_2.y	 = tab_1.tabpage_soins.cb_enregistrer_impr.y
		tab_1.tabpage_soins.cb_selection_soins.x = tab_1.tabpage_soins.dw_impression.x + tab_1.tabpage_soins.dw_impression.width + 10
		tab_1.tabpage_soins.cb_deselection_soins.x = tab_1.tabpage_soins.cb_selection_soins.x 
		
		// Spécial pour la taille maxi des reglements
		tab_1.tabpage_reglements.dw_reglements.width = tab_1.tabpage_reglements.width - 5
		tab_1.tabpage_reglements.dw_reglements.height = tab_1.tabpage_reglements.height -200
		
		// On belgique, on diminue certains boutons pour faire de la place pour ne autre
		if Belgique then
			tab_1.tabpage_reglements.cb_ajouter_reglement.width = 200
			tab_1.tabpage_reglements.cb_bis_reglement.width = tab_1.tabpage_reglements.cb_ajouter_reglement.width
			tab_1.tabpage_reglements.cb_modifier_reglement.width = tab_1.tabpage_reglements.cb_ajouter_reglement.width
			tab_1.tabpage_reglements.cb_supprimer_reglement.width = tab_1.tabpage_reglements.cb_ajouter_reglement.width
			tab_1.tabpage_reglements.cb_tarif.visible = true
		end if
		
		// positionnement en hauteur
		tab_1.tabpage_reglements.cb_ajouter_reglement.y = tab_1.tabpage_reglements.dw_reglements.height + 8
		tab_1.tabpage_reglements.cb_bis_reglement.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		tab_1.tabpage_reglements.cb_supprimer_reglement.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		tab_1.tabpage_reglements.cb_modifier_reglement.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		tab_1.tabpage_reglements.cb_debit.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		tab_1.tabpage_reglements.cb_facture.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		tab_1.tabpage_reglements.cb_fse.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		tab_1.tabpage_reglements.pb_visiodent.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		tab_1.tabpage_reglements.cb_recu.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		tab_1.tabpage_reglements.cb_justif.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		tab_1.tabpage_reglements.pb_aide_3.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
		
		// boutons en largeur : 8 boutons + bouton aide
		long taille_dispo
		
		if Belgique then
			taille_dispo = (tab_1.width - 11 * tab_1.tabpage_reglements.cb_ajouter_reglement.width - tab_1.tabpage_reglements.pb_aide_3.width) / 10
			// 2 bouton de + .. 1 au début 1 au milieu
			tab_1.tabpage_reglements.cb_bis_reglement.x 		= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 0.7 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 0.7 * taille_dispo
			tab_1.tabpage_reglements.cb_supprimer_reglement.x = tab_1.tabpage_reglements.cb_ajouter_reglement.x + 1.4 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 1.4 * taille_dispo
			tab_1.tabpage_reglements.cb_modifier_reglement.x 	= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 2.1 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 2.1 * taille_dispo
			tab_1.tabpage_reglements.cb_tarif.x 	= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 3 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 3 * taille_dispo
			tab_1.tabpage_reglements.cb_tarif.y = tab_1.tabpage_reglements.cb_ajouter_reglement.y
			
			// on réparti cet espace entre les boutons 
			tab_1.tabpage_reglements.cb_recu.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 4 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 4 * taille_dispo
			tab_1.tabpage_reglements.cb_fse.x 						= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 5 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 5 * taille_dispo
			tab_1.tabpage_reglements.pb_visiodent.x 				= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 5 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 5 * taille_dispo
			tab_1.tabpage_reglements.cb_facture.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 6 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 6 * taille_dispo
			tab_1.tabpage_reglements.cb_justif.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 7 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 7 * taille_dispo
			tab_1.tabpage_reglements.cb_debit.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 8 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 8 * taille_dispo
			tab_1.tabpage_reglements.cb_efact.y 					=	tab_1.tabpage_reglements.cb_ajouter_reglement.y
			tab_1.tabpage_reglements.cb_efact.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 9 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 9 * taille_dispo
			tab_1.tabpage_reglements.pb_aide_3.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 10 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 10 * taille_dispo
		else
			taille_dispo = (tab_1.width - 10 * tab_1.tabpage_reglements.cb_ajouter_reglement.width - tab_1.tabpage_reglements.pb_aide_3.width) / 9
			tab_1.tabpage_reglements.cb_bis_reglement.x 		= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 1 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 1 * taille_dispo
			tab_1.tabpage_reglements.cb_supprimer_reglement.x = tab_1.tabpage_reglements.cb_ajouter_reglement.x + 2 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 2 * taille_dispo
			tab_1.tabpage_reglements.cb_modifier_reglement.x 	= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 3 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 3 * taille_dispo
			
			// on réparti cet espace entre les boutons 
			tab_1.tabpage_reglements.cb_recu.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 4 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 4 * taille_dispo
			tab_1.tabpage_reglements.cb_fse.x 						= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 5 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 5 * taille_dispo
			tab_1.tabpage_reglements.pb_visiodent.x 				= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 5 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 5 * taille_dispo
			tab_1.tabpage_reglements.cb_facture.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 6 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 6 * taille_dispo
			tab_1.tabpage_reglements.cb_debit.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 7 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 7 * taille_dispo
			if luxembourg then 
				tab_1.tabpage_reglements.cb_pid.y 					=	tab_1.tabpage_reglements.cb_ajouter_reglement.y
				tab_1.tabpage_reglements.cb_pid.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 8 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 8 * taille_dispo
				tab_1.tabpage_reglements.pb_aide_3.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 9 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 9 * taille_dispo
			else
				tab_1.tabpage_reglements.pb_aide_3.x 					= tab_1.tabpage_reglements.cb_ajouter_reglement.x + 8 * tab_1.tabpage_reglements.cb_ajouter_reglement.width + 8 * taille_dispo
			end if 
		end if
		
	
		
		
		// Dans le resize depuis 2012
		maj_barre_patient(var_code_local, st_couleur, st_couleur2, st_nom, st_cmu, st_code, st_praticien, p_sepa, pb_documents_a_signer, pb_questionnaires_en_attente, this, st_couleur3, st_couleur4)
		
		if Belgique then
			string v_date_naissance
			select date_naissance into :v_date_naissance from patient where code = :var_code_local ;
			st_age.text = calcul_age( string (  v_date_naissance ) ) 
			st_age.y = st_praticien.y
			st_age.x = pb_questionnaires_en_attente.x + pb_questionnaires_en_attente.width + 45
			st_age.visible = true
		end if
		

		
		
		// Prochain rendez-vous juste en dessous et centrée
		dw_prochain_rdv.y = dw_detail_soins_prevus.y + dw_detail_soins_prevus.height + 10
		
		// Dw trop basse pour les boutons => on la remonte en réduisant la hauteur des dw_detail
		if dw_prochain_rdv.y + dw_prochain_rdv.height > cb_ajouter.y then 
			// on réduit les dw_detail
			dw_detail_soins_prevus.height = cb_ajouter.y - dw_prochain_rdv.height - dw_detail_soins_prevus.y - 40
			dw_detail.height = dw_detail_soins_prevus.height
			dw_prochain_rdv.y =  cb_ajouter.y - dw_prochain_rdv.height - 20
			uo_icones.y = dw_detail.y + dw_detail.height   - uo_icones.height - 20
		end if
		
		dw_prochain_rdv.x = dw_detail_soins_prevus.x + ( dw_detail_soins_prevus.width / 2 ) - (dw_prochain_rdv.width / 2)
		
		// On vérifie la largeur de la barre d'avancement pour pas qu'elle déborde
		if profilestring(dir_ini+inifile_orthokis,"admini","afficher_barre_avance_clinique_soins","N") = "O" then 
			if uo_traitement.x + uo_traitement.width > dw_prochain_rdv.x then
				uo_traitement.width = dw_prochain_rdv.x - uo_traitement.x - 50
			end if
		end if
	
		this.show()
	else
		this.hide()
	end if


	b_premier_resize = false
	

Catch (RuntimeError er)
	
	Messagebox("ERREUR INATTENDUE","Une erreur inattendue s'est produite.~nLa fenêtre n'a pas pu s'ouvrir normalement.~n~nNous vous conseillons de fermer puis rouvrir le dossier.~n~nEléments Techniques pour ARAKIS :~n~nClasse : " + er.class +"~nRoutine : "+er.RoutineName + "~nLigne : " + string(er.line) + "~nTexte : "  + er.text )
	
	
End Try


end event

event show;Try 

	positionnement_soin_en_cours()
	
	// Pour etre sur on repositionne le tab (pouvait merder en mode mdi)
	
	choose case type_gestion
		case 'P'
			tab_1.selecttab(1)
		case 'S'
			tab_1.selecttab(2)
		case 'R'
			tab_1.selecttab(3)
	end choose
	
	
Catch (RuntimeError er)
	
	Messagebox("ERREUR INATTENDUE","Une erreur inattendue s'est produite.~nLa fenêtre n'a pas pu s'ouvrir normalement.~n~nNous vous conseillons de fermer puis rouvrir le dossier.~n~nEléments Techniques pour ARAKIS :~n~nClasse : " + er.class +"~nRoutine : "+er.RoutineName + "~nLigne : " + string(er.line) + "~nTexte : "  + er.text )
	
	
End Try

end event

