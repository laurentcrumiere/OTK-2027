type cb_prelevement_patient from uo_picturebutton_390x120 within w_soins_reg_maj
boolean visible = false
integer x = 3913
integer y = 2444
integer width = 288
integer height = 152
integer taborder = 80
boolean bringtotop = true
string text = "Prelèv."
string tiptext = "Générations de tous les prélèvements de ce patient"
end type

event clicked;call super::clicked;// Vérifications avant de lancer 
boolean v_suite
string v_nom, v_rum, v_iban, v_bic
date v_date_mandat

v_suite = true


select  isnull(rum, ''), date_mandat, isnull(iban, '') , isnull(bic, '') 
into  :v_rum, :v_date_mandat, :v_iban, :v_bic
from patient
where code = :var_code_local ;

if v_rum = "" then 
	Messagebox("ATTENTION", "La Référence de Mandat Unique (RUM) de ce patient n'est pas renseignée !~n~nImpossible de  poursuivre !")  
	v_suite = false
end if

if v_suite and isnull(v_date_mandat) then 
	Messagebox("ATTENTION", "La Date de Signature du Mandat SEPA de ce patient n'est pas renseignée !~n~nImpossible de  poursuivre !")
	v_suite = false
end if

if v_suite and trim(v_iban) = "" then 
	Messagebox("ATTENTION", "L'IBAN de ce patient n'est pas renseigné !~n~nImpossible de  poursuivre !")
	v_suite = false
end if

if v_suite and trim(v_bic) = "" then 
	Messagebox("ATTENTION", "Le BIC de ce patient n'est pas renseigné !~n~nImpossible de  poursuivre !")
	v_suite = false
end if



if v_suite then 

	if isvalid(w_liste_gestion_prelevements) then
		// Si déjà ouvert, on vferme pour régénérer avec le patient
		fermer_fenetre(w_liste_gestion_prelevements)
	else
		if fxg_ouverture_onglet_possible() then
			// Le passage de paramètre ne fonctionne pas ... why ???
	//		str_patient v_patient_param
	//		v_patient_param.code = var_code_local
	//		v_patient_param.nom = var_nom_local
	//		w_mdi_2020.uo_powerdock.of_openDocument(w_liste_gestion_prelevements, v_patient_param, "Prélèvements", image_menu_listes_admini)
			
			// version avec passage global
			param_win[1] = string(var_code_local)
			param_win[2] = var_nom_local
			w_mdi_2020.uo_powerdock.of_openDocument(w_liste_gestion_prelevements, "Prélèvements", image_menu_listes_admini)
		end if
	end if
end if
end event

