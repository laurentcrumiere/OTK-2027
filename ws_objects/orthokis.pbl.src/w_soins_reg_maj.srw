integer y = 100
integer width = 1765
integer height = 1164
integer taborder = 460
boolean bringtotop = true
string dataobject = "dw_reglements_saisie"
boolean livescroll = true
end type

event dberror;CHOOSE CASE sqldbcode
	CASE -193
		MessageBox("Alerte Base de Données","Vous ne pouvez pas saisir 2 règlements identiques le même jour !",Information!)
	//CASE -195
	//	MessageBox("Alerte Base de Données","Il manque des informations dans ce règlement",Information!)
	CASE -198
		MessageBox("Alerte Base de Données","Vous n'avez pas le droit de supprimer ce règlement !~n~nElle est liée à une autre table.",Information!)
	CASE -3
		MessageBox("Alerte Base de Données","Les données que vous manipulez ont été~nmodifées par un autre utilisateur~nou dans une autre fenêtre.~n~nVeuillez annuler votre opération ....",Information!)
	CASE ELSE
		MessageBox("Alerte Base de Données Non Référencée","N° "+String(sqldbcode)+"~nText : "+sqlerrtext+"~n~nVeuillez en avertir ARAKIS ...",Information!)
END CHOOSE
return 1

end event

type dw_soins from datawindow within w_soins_reg_maj
string tag = "centrer no resize brush"
boolean visible = false
integer y = 236
integer width = 4677
integer height = 1056
integer taborder = 10
string title = "Lignes de soins"
string dataobject = "dw_soins"
boolean hscrollbar = true
boolean vscrollbar = true
boolean livescroll = true
end type

event rowfocuschanged;if this.rowcount() > 0 and currentrow> 0 then
	dw_detail.retrieve(var_code_local,this.getitemnumber(currentrow,"cle"))
	
	tab_1.tabpage_soins.dw_impression.retrieve(this.getitemnumber(currentrow,"cle"),var_code_local, v_pays)
	tab_1.tabpage_reglements.dw_reglements.retrieve(var_code_local, this.getitemnumber(currentrow,"cle"))

	if enregistrement_automatique then
		tab_1.tabpage_soins.cb_enregistrer_impr.triggerevent(clicked!)
	end if


	// Mise en évidence (et Scroll) sur le dernier règlement
	long nb_regl
	nb_regl = tab_1.tabpage_reglements.dw_reglements.rowcount()
	if nb_regl > 0 then
		tab_1.tabpage_reglements.dw_reglements.scrolltorow(nb_regl)
//		tab_1.tabpage_reglements.dw_reglements.SelectRow(0,False)
//		tab_1.tabpage_reglements.dw_reglements.SelectRow(nb_regl,True)
		tab_1.tabpage_reglements.dw_reglements.Setrow(nb_regl)		
	end if
	
	// Mise en évidence du soin
	This.Setrow(currentrow)
else
	dw_detail.reset()
	tab_1.tabpage_soins.dw_impression.reset()
	tab_1.tabpage_reglements.dw_reglements.reset()
end if

end event

event dberror;db_erreur_soins(dw_soins,sqldbcode,sqlerrtext)
return 1
end event

event clicked;If row > 0 Then
	This.setrow(row)
End If

end event

event rbuttondown;integer nb

string s_numero_fse
long v_numero_facture

// pour identifier la fenêtre dans le menu
dw_click = this
w_click_soins_reg = parent

if dw_recto.DataObject = "" then 
	dw_recto.DataObject = "dw_renouvellement_recto_nvelle"
	dw_recto.settransobject(SQLCA)
end if 
if dw_verso.DataObject = "" then 
	dw_verso.DataObject = "dw_renouvellement_verso_2_nvelle"
	dw_verso.settransobject(SQLCA)
end if 



choose case type_gestion 
	case 'S'
		If this.getrow() > 0 and row > 0 Then

			type_menu = 'S'
		
			newmenu.m_soins.popmenu(w_mdi_2020.PointerX(), w_mdi_2020.PointerY())
		end if
	case 'R'

			type_menu = 'R'
			
			If this.getrow() > 0 and row > 0 Then
				
				if not multi_fs_autorise then
					// Pas le droit de faire plusieurs FS
					// Pas le doit d'annuler ou autre
					newmenu.m_soins.m_annulationfeuilledesoins.enabled = false
				end if
				
				if Belgique then
					if this.getitemstring(row, "soins_fse_edite") = "E" then
						// c'est une eAttest
						newmenu.m_soins.m_ouvrirleattest.enabled = true
						newmenu.m_soins.m_annulerleattest.enabled = true
						newmenu.m_soins.m_inscriptioneattest.enabled = false
					else
						v_numero_facture =  this.getitemNumber(row, "numero_facture")
						zerol(v_numero_facture)
						if string_non_nulle(trim(this.getitemstring(row, "soins_fse_edite"))) = "" and v_numero_facture = 0 then
							newmenu.m_soins.m_inscriptioneattest.enabled = true
						else
							newmenu.m_soins.m_inscriptioneattest.enabled = false
						end if
						newmenu.m_soins.m_ouvrirleattest.enabled = false
						newmenu.m_soins.m_annulerleattest.enabled = false
					end if
					
					s_numero_fse = string_non_nulle (this.getitemstring(row, "soins_numero_fse" )) 
					
					// Mise en place pour agrément mais finalement pas utile 
					//if s_numero_fse <> "" then 
					//	newmenu.m_soins.m_duplicatadeleattest.enabled = true
					//else
					//	newmenu.m_soins.m_duplicatadeleattest.enabled = false
					//end if
					
				end if

				
				// Mise à jour des libellés du menu 
				newmenu.m_soins.popmenu(w_mdi_2020.PointerX(), w_mdi_2020.PointerY())
			end if

end choose


end event

event retrieveend;
// On met les cases FSE à "N"
//-----------------------------------------
long  i 
for i = 1 to rowcount
	this.setitem(i,"fse","N")
next


// positionnement des soins et donc des reglements ...
positionnement_soin_en_cours()



// Remise à jour du symbole de la somme due
uo_icones.uo_due.maj(var_code_local)





end event

event doubleclicked;// Double clic -> Comme si on cliquait sur "MODIFIER"
if row > 0 then
	This.setrow(row)
	if droits_acces[11] = "T" or  droits_acces[11] = "M"  then
		cb_modifier.triggerevent(Clicked!)
	end if
end if

end event

type ddlb_imprimantes from uo_liste_imprimantes within w_soins_reg_maj
string tag = "pour gérer le reçu en PDF"
boolean visible = false
integer x = 937
integer y = 120
integer width = 645
integer height = 496
integer taborder = 40
