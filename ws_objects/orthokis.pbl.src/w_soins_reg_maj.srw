type cb_transfert from picturebutton within tabpage_soins_prevus
integer x = 2162
integer y = 328
integer width = 475
integer height = 160
integer taborder = 30
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = " "
string picturename = "lc_transfert_soin_prevus_soins.png"
alignment htextalign = left!
string powertiptext = "Transfère les soins prévus sélectionnés dans les soins"
long backcolor = 553648127
end type

event clicked;// Transfert dans les soins toutes les lignes sélectionnées qui n'ont pas encore été transférées

long	nb_lignes				// Nombre de lignes de soins
long   nb_lignes_transfert	// Nombre de lignes EFFECTIVEMENT transférées
long cpt							// Compteur de lignes en cours


long cle_max					// clef maximale du patient dans les soins
long cle_prevu					// clef du soin prévu courant 
decimal {2} v_hn

string v_motif, v_type

decimal{2} v_total

boolean decalage_effectue = false

nb_lignes_transfert = 0
nb_lignes = dw_soins_prevus.rowcount()


for cpt = 1 to nb_lignes
	
	if dw_soins_prevus.getitemString(cpt,"fse") = 'O' then
		// Si la ligne est sélectionnnée
		if dw_soins_prevus.getitemString(cpt,"soins_prevus_transfert") <> 'O' then
			// Si la ligne n'a pas déjà été transférée
			
			// Recherche de la clef maximale dans les soins du patient
			cle_max = 0
			SELECT Max(cle) INTO :cle_max FROM "soins" WHERE code = :var_code_local ;
		
				if isnull(cle_max) then
					cle_max = 1
				else
					cle_max = cle_max + 1
				end if

			// Soin en cours 
			cle_prevu = dw_soins_prevus.getitemNumber(cpt,"cle")
			
			integer v_scp_demande
			string v_lettre
			
			SELECT "type", "scp_demande", isnull("total", 0) into :v_type, :v_scp_demande , :v_total
			FROM "soins_prevus"  WHERE "code" = :var_code_local and "cle" = :cle_prevu ;
			
			select lettre into :v_lettre from "code_soins" where code = :v_type ;
			
			// Dépassement ?
			SELECT isnull("hn",0) into :v_hn 
				FROM "soins_prevus" , "code_soins"
			WHERE "soins_prevus"."code" = :var_code_local and "soins_prevus"."cle" = :cle_prevu  and "code_soins"."code" = "soins_prevus"."type" and "code_soins"."execution_immediate" <> 'O' ;
				
			if v_hn > 0 then 
				v_motif = motif_depassement(var_code_local, v_type)
			else
				v_motif = ""
			end if
		
			// Insertion des soins ....
			
			// pour les soins SANS exécution immédiate
			// Depuis v2025, les codes exo et autres sont gérés dans les soins prévisionnels
		
			INSERT INTO "soins" ("cle","code","type","numero","date_demande","scp_demande","hn","total","tp","date_accord","scp_accord", "date_impr", "date_exe","user_modif","date_modif" , "motif_depassement",
			"code_association", "dent", "exo", "remboursement_exceptionnel")
			SELECT :cle_max, "soins_prevus"."code","soins_prevus"."type","soins_prevus"."numero","soins_prevus"."date_demande","soins_prevus"."scp_demande","soins_prevus"."hn","soins_prevus"."total",
			"soins_prevus"."tp","soins_prevus"."date_accord","soins_prevus"."scp_accord" , "soins_prevus"."date_impr", 
			(select dateadd (month, "code_soins"."duree","soins_prevus"."date_demande") from "code_soins" where "code_soins"."code" = "soins_prevus"."type" ), "soins_prevus"."user_modif","soins_prevus"."date_modif" , :v_motif,
			"soins_prevus"."code_association" , "dent", "exo", "remboursement_exceptionnel"
			FROM "soins_prevus" , "code_soins"
			WHERE "soins_prevus"."code" = :var_code_local and "soins_prevus"."cle" = :cle_prevu  and "code_soins"."code" = "soins_prevus"."type" and "code_soins"."execution_immediate" <> 'O' ;
				

			
			
			if sqlca.sqlcode <> 0 then
				
				MessageBox("ATTENTION !", "Erreur N° 1 dans le transfert de soin !~n~n"+sqlca.sqlerrText)
				// Problème 
				rollback ;
				
			else
				
				// Exo 3 pour les TO 45 et les TO >= 60
				if CCVITALE and (v_scp_demande = 45 or v_scp_demande >=60 ) and (v_lettre = 'TO' or v_lettre = 'ORT') then
					// pour les soins AVEC exécution immédiate
					INSERT INTO "soins" ("cle","code","type","numero","date_demande","scp_demande","hn","total","tp","date_accord","scp_accord", "date_impr", "date_exe","user_modif","date_modif" , "motif_depassement", "code_association", "exo")
					SELECT :cle_max, "soins_prevus"."code","soins_prevus"."type","soins_prevus"."numero","soins_prevus"."date_demande","soins_prevus"."scp_demande","soins_prevus"."hn","soins_prevus"."total",
					"soins_prevus"."tp","soins_prevus"."date_accord","soins_prevus"."scp_accord" , "soins_prevus"."date_impr", "soins_prevus"."date_demande", "soins_prevus"."user_modif","soins_prevus"."date_modif" , :v_motif,
					"soins_prevus"."code_association" , '3'
					FROM "soins_prevus" , "code_soins"
					WHERE "soins_prevus"."code" = :var_code_local and "soins_prevus"."cle" = :cle_prevu  and "code_soins"."code" = "soins_prevus"."type" and "code_soins"."execution_immediate" = 'O' ;
				else
					// pour les soins AVEC exécution immédiate
					INSERT INTO "soins" ("cle","code","type","numero","date_demande","scp_demande","hn","total","tp","date_accord","scp_accord", "date_impr", "date_exe","user_modif","date_modif" , "motif_depassement", "code_association")
					SELECT :cle_max, "soins_prevus"."code","soins_prevus"."type","soins_prevus"."numero","soins_prevus"."date_demande","soins_prevus"."scp_demande","soins_prevus"."hn","soins_prevus"."total",
					"soins_prevus"."tp","soins_prevus"."date_accord","soins_prevus"."scp_accord" , "soins_prevus"."date_impr", "soins_prevus"."date_demande", "soins_prevus"."user_modif","soins_prevus"."date_modif" , :v_motif,
					"soins_prevus"."code_association" 
					FROM "soins_prevus" , "code_soins"
					WHERE "soins_prevus"."code" = :var_code_local and "soins_prevus"."cle" = :cle_prevu  and "code_soins"."code" = "soins_prevus"."type" and "code_soins"."execution_immediate" = 'O' ;
				end if
				
				if sqlca.sqlcode <> 0 then
					
					MessageBox("ATTENTION !", "Erreur N° 2 dans le transfert de soin !~n~n"+sqlca.sqlerrText)
					// Problème 
					rollback ;
				else
					// L'ajout du soin est OK ...
					
					// Insertion des lignes
					
					INSERT INTO "ligne_soins" ("cle","code","date","montant","tp","origine_tp", "non_prelevement")
					SELECT :cle_max,"code","date","montant","tp","origine_tp", "non_prelevement" FROM "ligne_soins_prevus" 
					WHERE "code" = :var_code_local and "cle" = :cle_prevu ;

	
					if sqlca.sqlcode <> 0 then
						MessageBox("ATTENTION !", "Erreur N° 3 dans le transfert de soin !~n~n"+sqlca.sqlerrText)
						// Problème 
						rollback ;
					else
						// Les 2 insert sont ok
						
						// Mise à jour des soins _pévrus ... zone TRANSFERT
						UPDATE "soins_prevus" SET transfert = 'O' WHERE "code" = :var_code_local and "cle" = :cle_prevu ;
						
						commit ;
						
						
						// Le soin vient d'être ajouté  => Mise à jour ODS
						if APPEL_VISIODENT and not VISIODENT_LIMITE then
							fxg_ods_envoi_soin(var_code_local, cle_max, false)
						end if
						
						// Le soin vient d'être ajouté  => Mise à jour TEA
						if TEA then
							if v_total > 0 then
								// Ajout
								//fxg_lancer_commande_dsapi("payment/create/" + string(var_code_local) + '-' + string(cle_max), "",  "S", "G", var_code_local )
								fxg_maj_soins_tea(var_code_local, cle_max, "C")
							end if
						end if

						
						nb_lignes_transfert = nb_lignes_transfert + 1
					end if
				end if
			end if
		end if
	end if
	
Next

if nb_lignes_transfert = 0 then
	Messagebox("ATTENTION","Aucune ligne n'a été transférée !")
else
	dw_soins_prevus.retrieve(var_code_local, var_code_devis_local)
	if nb_lignes_transfert = 1 then
		MessageBox("FIN DU TRANSFERT","1 Ligne a été transférée.")
	else
		MessageBox("FIN DU TRANSFERT",string(nb_lignes_transfert)+" Lignes ont été transférées.")
	end if
	
	// Mise à jour automatiques d'infos ...
	date dt
	boolean ok_suite = false
	/// Y a t il une date de début de traitement ?
	select debut_traitement INTO :dt FROM "patient"  WHERE code = :var_code_local ;
	
	if isnull(dt) then
		if Messagebox("ATTENTION","Vous n'avez pas encore saisi de date de Début de Traitement.~n~nSouhaitez-vous la mettre à jour à la date du jour ?", Question!, YesNo!, 2) = 1 then
			update "patient" set debut_traitement = getdate()   WHERE code = :var_code_local ;
			dt = today()
			commit ;
			ok_suite = true
		end if
	else
		ok_suite = true
	end if
	
	if ok_suite then
		
		// On bascule dans les soins
		dw_soins.retrieve(var_code_local)
		type_gestion = "S"
		maj_selon_module(type_gestion)
		newmenu.Decalage_total("T")
		decalage_effectue = true
	end if
	

	
	if not decalage_effectue then
		// On bascule dans les soins
		dw_soins.retrieve(var_code_local)
		type_gestion = "S"
		maj_selon_module(type_gestion)
		tab_1.selectTab(2)
	end if
	
	// Raffraichissement  de la barre si besoin
	if profilestring(dir_ini+inifile_orthokis,"admini","afficher_barre_avance_clinique_soins","N") = "O" then 
		uo_traitement.maj(var_code_local)
	end if

end if

end event

