event clicked;call super::clicked;double lig_soin , cle_soin
date demande, execution, accord
double scp_demande, hn, total, tp, cle_max, scp_accord
double numero
integer duree
string v_type_soin
string v_motif, v_lettre, v_norme_prescripteur
long v_ecart
string v_dent, v_code_association
string v_nom_soin
date var_date_dem
double var_tot
boolean v_suite

long nb_lig, nb_selection

if type_gestion = 'P' then
	// Répète la ligne de soins sur laquelle est le curseur ET LE MET A LA DATE DU JOUR
	
	if dw_soins_prevus.rowcount() = 0 then
		son(5)
		MessageBox("ATTENTION !","Aucun soin prévu n'a été saisi !")
	else
			
			// recherche si plusieurs lignes sélectionnées
			nb_lig = dw_soins_prevus.rowcount()
		
			nb_selection = 0
		
			for lig_soin = 1 to nb_lig
				
				if dw_soins_prevus.getitemstring(lig_soin , "fse") = "O" then
					nb_selection = nb_selection + 1
				end if
			next

			
			if nb_selection = 0 then 
				// Pas de case cochée => on coche la ligne courante 
				lig_soin = dw_soins_prevus.getrow()
			
				if lig_soin < 1 Then
					lig_soin = 1
				end if
				
				dw_soins_prevus.Setitem(lig_soin , "fse", "O")
			end if
			
			
			for lig_soin = 1 to nb_lig
				if dw_soins_prevus.getitemstring(lig_soin , "fse") = "O" then
		
					
					cle_soin = dw_soins_prevus.getitemnumber(lig_soin,"cle")
			
					demande = dw_soins_prevus.getitemdate(lig_soin,"date_demande")
					hn = dw_soins_prevus.getitemnumber(lig_soin,"hn")
					total = dw_soins_prevus.getitemnumber(lig_soin,"total")
					scp_demande = dw_soins_prevus.getitemnumber(lig_soin,"scp_demande")
					tp = dw_soins_prevus.getitemnumber(lig_soin,"tp")
					numero = dw_soins_prevus.getitemnumber(lig_soin,"numero")
					v_type_soin = dw_soins_prevus.getitemstring(lig_soin,"code_soins_code")
					
				
					// Ajout du soins pour le patient
				
					// Nouvelles date ....
					// combien d'écart entre demande et today ?????
					v_ecart = daysafter(demande, today())
					
					demande = today()
					execution = relativedate(execution, v_ecart)
				
				
				
						select max(cle) into :cle_max from "soins_prevus" where code = :var_code_local ;
						cle_max = cle_max + 1

						select isnull(max(numero),0) into :numero from  "soins_prevus" where code = :var_code_local and "type" = :v_type_soin and code_devis = :var_code_devis_local;
						
				  SELECT "code_soins"."duree"  
					 INTO :duree
					 FROM "code_soins"  
					WHERE "code_soins"."code" = :v_type_soin   ;

						if duree > 0 then
							numero = numero + 1
						end if
						
						
						  INSERT INTO "soins_prevus"  
							( "cle", 	"code","type","numero","date_demande","scp_demande",   
							  "date_accord","scp_accord","hn","total","tp","user_modif","date_modif", "code_devis" )  
							VALUES ( :cle_max,:var_code_local,:v_type_soin,:numero,:demande,:scp_demande,
								null,null,:hn,:total,:tp, :utilisateur_code,getdate() , :var_code_devis_local)  ;
				
				
						// Ajout des lignes de soins
						  INSERT INTO "ligne_soins_prevus"  
							( "cle",   				  "code",   				  "date",   				  "montant",   				  "tp",   				  "origine_tp" )  
						  SELECT :cle_max,   
									"ligne_soins_prevus"."code",   
									dateadd(day, :v_ecart, "ligne_soins_prevus"."date") ,   
									"ligne_soins_prevus"."montant",   
									"ligne_soins_prevus"."tp",   
									"ligne_soins_prevus"."origine_tp"  
							 FROM "ligne_soins_prevus" 
							 WHERE code = :var_code_local and cle = :cle_soin ;
							
						commit ;
						
						// Mise en historique des actions
						select trim("code_soins"."nom"), soins_prevus.date_demande, soins_prevus.total into :v_nom_soin,  :var_date_dem , :var_tot 
						from soins_prevus , code_soins 
						where soins_prevus."type" = code_soins.code and soins_prevus.code = :var_code_local and cle = :cle_max ;
						ajout_histo_actions(var_code_local,"AJOSOP",today(),v_nom_soin +" - " + string(var_date_dem, "dd/mm/yyyy")+" - "+string(var_tot,'0.00'))
						
					end if
					
				next
	
				
				dw_soins_prevus.reset()
				dw_soins_prevus.retrieve(var_code_local, var_code_devis_local)
				
				lig_soin = dw_soins_prevus.rowcount()
	
				// On se met sur le soin qu'on vient d'ajouter (en principe le dernier ?)
				if dw_soins_prevus.rowcount() > 0 then
					dw_soins_prevus.Scrolltorow(lig_soin)
					dw_soins_prevus.SetRow(lig_soin)
					dw_soins_prevus.setfocus()
				End If
		
			
		end if
	
else
	
	
	// Répète la ligne de soins sur laquelle est le curseur en la décalant de la durée du soin

	if dw_soins.rowcount() = 0 then
		son(5)
		MessageBox("ATTENTION !","Aucun soin n'a été saisi !")
	else
		
			// recherche si plusieurs lignes sélectionnées
			nb_lig = dw_soins.rowcount()
		
			nb_selection = 0
		
			for lig_soin = 1 to nb_lig
				
				if dw_soins.getitemstring(lig_soin , "fse") = "O" then
					nb_selection = nb_selection + 1
				end if
			next

			
			if nb_selection = 0 then 
				// Pas de case cochée => on coche la ligne courante 
				lig_soin = dw_soins.getrow()
			
				if lig_soin < 1 Then
					lig_soin = 1
				end if
				
				dw_soins.Setitem(lig_soin , "fse", "O")
			end if
			
			
			for lig_soin = 1 to nb_lig
				if dw_soins.getitemstring(lig_soin , "fse") = "O" then

					cle_soin = dw_soins.getitemnumber(lig_soin,"cle")
			
					demande = dw_soins.getitemdate(lig_soin,"date_demande")
					accord  = dw_soins.getitemdate(lig_soin,"date_accord")
					hn = dw_soins.getitemnumber(lig_soin,"hn")
					total = dw_soins.getitemnumber(lig_soin,"total")
					scp_demande = dw_soins.getitemnumber(lig_soin,"scp_demande")
					scp_accord = dw_soins.getitemnumber(lig_soin,"scp_accord")
					tp = dw_soins.getitemnumber(lig_soin,"tp")
					numero = dw_soins.getitemnumber(lig_soin,"numero")
					v_type_soin = dw_soins.getitemstring(lig_soin,"code_soins_code")
					v_motif = dw_soins.getitemstring(lig_soin,"motif_depassement")
					v_lettre = dw_soins.getitemstring(lig_soin,"code_soins_lettre")
					
					v_dent = dw_soins.getitemstring(lig_soin,"soins_dent")
					v_code_association = dw_soins.getitemstring(lig_soin,"soins_code_association")
					
					execution  = tab_1.tabpage_soins.dw_impression.getitemdate(1,"date_exe")
					
					if belgique  then 
						// efacturation 
						 SELECT "norme_prescripteur"  	 INTO :v_norme_prescripteur
						 FROM "soins"  WHERE "code" = :var_code_local and "cle" = :cle_soin ;
					end if
				
			
					// Ajout du soins pour le patient
				
					// Nouvelles date ....
					// combien d'écart entre demande et today ?????
					v_ecart = daysafter(demande, today())
					
					demande = today()
					execution = relativedate(execution, v_ecart)
			
					if Belgique then
						v_suite = verif_regles_soins_belges(var_code_local, v_type_soin, today() , true)
					else
						v_suite = true
					end if
		
				
					if v_suite then
						select max(cle) into :cle_max from "soins" where code = :var_code_local ;
						cle_max = cle_max + 1
						select isnull(max(numero),0) into :numero from  "soins" where code = :var_code_local and "type" = :v_type_soin ;
						
						  SELECT "code_soins"."duree"  
						 INTO :duree
						 FROM "code_soins"  
						WHERE "code_soins"."code" = :v_type_soin   ;
						
						if duree > 0 then 
							numero = numero + 1
						end if
						
						// TO 45 en exo 3et TO >= 60
						if CCVITALE and (scp_demande = 45 or scp_demande >=60 )  and (v_lettre = 'TO' or v_lettre = 'ORT') then

						
						  INSERT INTO "soins"  
							( "cle", 	"code",   	  "type",     "numero",     "date_demande",     "scp_demande",   
							  "date_accord",     "scp_accord",     "hn",     "total",     "tp",     "date_cara",   
							  "date_impr",     "date_donne",     "date_rapport",     "comment",     "date_exe",
							  "user_modif",	  "date_modif", "motif_depassement", "exo")  
						VALUES ( :cle_max,   	  :var_code_local,     :v_type_soin,     :numero,   	  :demande,   
							  :scp_demande,     null,     :scp_accord,     :hn,     :total,     :tp,     null,   
							  null,     null,     null,     null,     :execution,	  :utilisateur_code,	  getdate() , :v_motif, '3')  ;
							  
						else
							
							if belgique then 
								// efacturation 
							  INSERT INTO "soins"  
								( "cle", 	"code",   	  "type",     "numero",     "date_demande",     "scp_demande",   
								  "date_accord",     "scp_accord",     "hn",     "total",     "tp",     "date_cara",   
								  "date_impr",     "date_donne",     "date_rapport",     "comment",     "date_exe",
								  "user_modif",	  "date_modif", "motif_depassement", "norme_prescripteur")  
							VALUES ( :cle_max,   	  :var_code_local,     :v_type_soin,     :numero,   	  :demande,   
								  :scp_demande,     null,     :scp_accord,     :hn,     :total,     :tp,     null,   
								  null,     null,     null,     null,     :execution,	  :utilisateur_code,	  getdate() , :v_motif, :v_norme_prescripteur)  ;
								  
							else
								
							  INSERT INTO "soins"  
								( "cle", 	"code",   	  "type",     "numero",     "date_demande",     "scp_demande",   
								  "date_accord",     "scp_accord",     "hn",     "total",     "tp",     "date_cara",   
								  "date_impr",     "date_donne",     "date_rapport",     "comment",     "date_exe",
								  "user_modif",	  "date_modif", "motif_depassement", "dent", "code_association")  
							VALUES ( :cle_max,   	  :var_code_local,     :v_type_soin,     :numero,   	  :demande,   
								  :scp_demande,     null,     :scp_accord,     :hn,     :total,     :tp,     null,   
								  null,     null,     null,     null,     :execution,	  :utilisateur_code,	  getdate() , :v_motif, :v_dent, :v_code_association)  ;
								  
							end if 
								  
							end if
				
				
						// Ajout des lignes de soins
						  INSERT INTO "ligne_soins"  
							( "cle",    "code",    "date",    "montant",     "tp",   	  "origine_tp" )  
					  SELECT :cle_max,   	"ligne_soins"."code",  dateadd(day, :v_ecart,"ligne_soins"."date") ,   
								"ligne_soins"."montant",  	"ligne_soins"."tp",   	"ligne_soins"."origine_tp"  
						 FROM "ligne_soins" 
						 WHERE code = :var_code_local and cle = :cle_soin ;
						
						
						commit ;
						
						// Le soin vient d'être ajouté ou mis à jour => Mise à jour ODS
						if APPEL_VISIODENT and not VISIODENT_LIMITE and sqlca.sqlcode = 0 then
							fxg_ods_envoi_soin(var_code_local, cle_max, false)
						end if
						
						if TEA then
							//fxg_lancer_commande_dsapi("payment/create/" + string(var_code_local)+"-"+string(cle_max), "",  "S", "G", var_code_local )
							fxg_maj_soins_tea(var_code_local, cle_max, "C")
						end if

						// Mise en historique des actions
						select trim("code_soins"."nom"), soins.date_demande, soins.total into :v_nom_soin,  :var_date_dem , :var_tot 
						from soins , code_soins 
						where soins."type" = code_soins.code and soins.code = :var_code_local and cle = :cle_max ;
						
						ajout_histo_actions(var_code_local,"AJOSOI",today(),v_nom_soin +" - " + string(var_date_dem, "dd/mm/yyyy")+" - "+string(var_tot,'0.00'))
			
						
						// Est ce une insertion de soins ?
						insertion_soins(cle_max)
						
					end if
				end if
					
			Next
	
				
			dw_soins.reset()
			dw_soins.retrieve(var_code_local)
			
			lig_soin = dw_soins.rowcount()

			// Raffraichissement  de la barre si besoin
			if profilestring(dir_ini+inifile_orthokis,"admini","afficher_barre_avance_clinique_soins","N") = "O" then 
				uo_traitement.maj(var_code_local)
			end if
			
			// On se met sur le soin qu'on vient d'ajouter (en principe le dernier ?)
			if dw_soins.rowcount() > 0 then
				dw_soins.Scrolltorow(lig_soin)
				dw_soins.SetRow(lig_soin)
				dw_soins.setfocus()
			End If
	
	end if
end if
end event

