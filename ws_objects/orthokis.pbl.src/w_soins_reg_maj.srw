				// pour tous depuis 2015
				//newmenu.m_soins.m_selectionnertouslessoinsdunememedate.visible = true
				//newmenu.m_soins.m_annulationfeuilledesoins.visible = false
				newmenu.m_soins.m_deblocageimpression.visible = true
				newmenu.m_soins.m_facture.visible = false
				newmenu.m_soins.m_feuilledesoins2014.visible = false
				newmenu.m_soins.m_feuilledesoins2014verso.visible = false
				newmenu.m_soins.m_feuilledesoins2014rectoverso.visible = false
				newmenu.m_soins.m_fs2014.visible = false
				newmenu.m_soins.m_ouvrirleattest.visible = true
				// Mise en place pour agrément mais finalement pas utile 
				// newmenu.m_soins.m_duplicatadeleattest.visible = true
				newmenu.m_soins.m_annulerleattest.visible = true
				newmenu.m_soins.m_inscriptioneattest.visible = true
			else
				if luxembourg or Suisse then
					newmenu.m_soins.m_imprimerrecto.visible =  false
					newmenu.m_soins.m_imprimerverso.visible =  false
					newmenu.m_soins.m_imprimerrectoverso.visible = false
					newmenu.m_soins.m_deblocageimpression.visible = false
					newmenu.m_soins.m_annulationfeuilledesoins.visible = false
					newmenu.m_soins.m_feuilledesoins2014.visible = false
					newmenu.m_soins.m_feuilledesoins2014verso.visible = false
					newmenu.m_soins.m_feuilledesoins2014rectoverso.visible = false
					newmenu.m_soins.m_fs2014.visible = false
				else
					// France
					newmenu.m_soins.m_imprimerrecto.visible = false
					newmenu.m_soins.m_imprimerverso.visible = false
					newmenu.m_soins.m_imprimerrectoverso.visible = false
					newmenu.m_soins.m_deblocageimpression.visible = false
					newmenu.m_soins.m_annulationfeuilledesoins.visible = true
					newmenu.m_soins.m_1.visible = false
					newmenu.m_soins.m_fs2014.visible = true
					
					// FS Intégrée ou non ?
//					if profilestring(dir_ini+inifile_orthokis,"DEP-FSE","fs_integre", "N") = "O" then
//						newmenu.m_soins.m_feuilledesoins2014.visible = true
//						newmenu.m_soins.m_feuilledesoins2014verso.visible = true
//						newmenu.m_soins.m_feuilledesoins2014rectoverso.visible = true
//						impression_integre = true
//					else
						newmenu.m_soins.m_feuilledesoins2014.visible = true
						newmenu.m_soins.m_feuilledesoins2014verso.visible = true
						//newmenu.m_soins.m_feuilledesoins2014verso.text = "Cadrage Feuille de Soins 2014"
						//newmenu.m_soins.m_feuilledesoins2014rectoverso.text = "Réinitialisation du cadrage Feuille de Soins 2014"
						impression_integre = false
//					end if
			
					if impression_integre then
						dw_recto.dataobject = "dw_feuille_soins_integree"
						dw_verso.dataobject = "dw_feuille_soin_verso_integree"
					else
						dw_recto.dataobject =  "dw_feuille_soins"
						dw_verso.dataobject = "dw_feuille_soin_verso"
