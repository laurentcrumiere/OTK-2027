type cb_facture from uo_picturebutton_390x120 within tabpage_reglements
integer x = 1806
integer y = 716
integer width = 416
integer taborder = 320
string text = "Facture"
string tiptext = "Facturation"
end type

event clicked;call super::clicked;
// Depuis les règlements forcément 
type_menu = 'R'

long cle_soin

string v_code_praticien_patient, v_code_praticien_soin, v_code_praticien_courant

boolean meme_praticien = true

if belgique then
	

	// Si pas de soins sélectionné ... on prend le soin courant
	if dw_soins.find("fse = 'O'",0,dw_soins.rowcount()) = 0  and dw_soins.rowcount() > 0 then
		dw_soins.SetItem(dw_soins.getrow(), "fse", "O")
	end if
	
	select code_praticien into :v_code_praticien_patient from patient where code = :var_code_local ;
	
	// Limitation à 12 soins .. pas + 
	long lig, ligtot, cpt
	
	// Parmi les lignes sélectionnées, on repère s'il y a eu déjà des factures ...
	ligtot = dw_soins.rowcount()
	cpt = 0
	v_code_praticien_soin = ""
	for lig = 1 to ligtot
		if dw_soins.getitemstring(lig,"fse") = 'O' then
			
			cpt = cpt + 1
			
			// verification du praticien
			cle_soin 		 = dw_soins.getitemnumber(lig,"cle")
			select isnull(code_praticien, :v_code_praticien_patient) into :v_code_praticien_courant from soins where code = :var_code_local and cle = :cle_soin ;
			
			if v_code_praticien_soin = "" then
				// c'est le premier soin
				v_code_praticien_soin = v_code_praticien_courant
			end if
			
			if v_code_praticien_courant <> v_code_praticien_soin then 
				meme_praticien = false
			end if

		end if
	next
	
	if cpt > 12 then
		
		MessageBox("ATTENTION","Vous ne pouvez pas avoir plus de 12 soins dans une Attestation.~n~n(Or vous en avez sélectionné "+ string(cpt) + ")")
		
	else
	
		if meme_praticien then 
			// pour identifier la fenêtre dans le menu
			dw_click = dw_soins
			w_click_soins_reg = dw_soins.getparent()

			guo_fenetre_modale.wf_ouvrir_param_string(w_attestation_impression, v_code_praticien_soin)
		
			
			//openWithParm(w_attestation_impression, v_code_praticien_soin)
			
		else
		
			MessageBox("ATTENTION","Vous avez sélectionné des soins devant être attestés par des praticiens différents ; veuillez corriger avant de renouveler votre demande.")
		
		end if
	end if
else
	// pour identifier la fenêtre dans le menu
	dw_click = dw_soins
	w_click_soins_reg = dw_soins.getparent()
//	Open(w_facture_impression)

	guo_fenetre_modale.wf_ouvrir(w_facture_impression)
	

end if


end event

type cb_fse from uo_picturebutton_390x120 within tabpage_reglements
integer x = 1390
integer y = 716
integer width = 416
integer taborder = 390
fontcharset fontcharset = ansi!
string text = "FSE"
string tiptext = "Facturation Sésam Vitale"
end type

event clicked;call super::clicked;boolean v_suite
string v_version_ccvitale

if dw_soins.rowcount() > 0 then

	if Belgique then
		

		// eAttestation
		ehealth("A")

			
		if profilestring(dir_ini+inifile_orthokis,"DEP-FSE","supprimer_confirmation_eattest","N")  = "N" then 
			Messagebox("INFORMATION","Une fois l'eAttest réalisée, veuillez cliquer sur OK pour actualiser le dossier.")
			cb_rafraichir.triggerevent(clicked!)
		end if
	
	else
	
		// FSE
			
		// France
		
		if CCVITALE then
			// Nouveau mécanisme de communication => version CC Obligatoire
			v_version_ccvitale = fxg_get_version_ccvitale()
			if  v_version_ccvitale >= "4.10" then
				v_suite = true
			else
				v_suite = false
				if v_version_ccvitale = "" then
					Messagebox("ATTENTION","CC-Vitale n'est pas installé sur ce poste !")
				else
					Messagebox("ATTENTION","Cette version d'Orthokis fonctionne avec CC-Vitale version 4.10 ou supérieure or vous êtes actuellement en " + v_version_ccvitale + ".~n~nVeuillez faire la mise à jour de CC-Vitale !")
				end if
			end if
		else
			v_suite = true
		end if
		
		if v_suite then
			lancer_fse()
		end if
	end if
		
end if

end event

type cb_recu from uo_picturebutton_390x120 within tabpage_reglements
integer x = 974
integer y = 716
integer width = 416
integer taborder = 390
string text = "Reçu"
string tiptext = "Impression d~'un reçu"
end type

event clicked;call super::clicked;if dw_soins.rowcount() = 0 then
	son(5)
	MessageBox("ATTENTION !","Aucun soin n'a été saisi !")
else
	
	v_date = date(1,1,1900)

	// Depuis 2013 .. on peut sélectionner des soins ou des règlements ... 
	// On mémorisera les infos du règlement le plus récent mais on totalisera tous les soins
	
	long lig, tot, nb_regl, lig2, tot2, nb_soins
	decimal {2} montant_total_reglements, montant_total_soins, v_montant_recu, montant_total_soins_hn
	
	boolean v_suite 
	
	
	string libelle_du_soin				// pour les sélections multiples
	string ls_payeur 						// pour le reçu
	
	// On cherche d'abord si plusieurs règlements sélectionnés sur ce soin ...
	
	tot = tab_1.tabpage_reglements.dw_reglements.rowcount()
	nb_regl = 0
	montant_total_reglements = 0
	montant_total_soins = 0
	montant_total_soins_hn = 0
	for lig = 1 to tot
		if tab_1.tabpage_reglements.dw_reglements.getitemstring(lig,"selection") = 'O'  then
			nb_regl = nb_regl + 1
			if  tab_1.tabpage_reglements.dw_reglements.getitemdate(lig,"date") > v_date then
				v_cle_regl = tab_1.tabpage_reglements.dw_reglements.getitemnumber(lig,"cle")
				// pour mémorisation pour le retriever de w_recu
				v_date = tab_1.tabpage_reglements.dw_reglements.getitemdate(lig,"date")
				v_mon = tab_1.tabpage_reglements.dw_reglements.getitemnumber(lig,"montant")
				v_code_regl = var_code_local
				// Ajout du mode et des commentaires
				v_mode = tab_1.tabpage_reglements.dw_reglements.getitemstring(lig,"mode")
				v_comment = tab_1.tabpage_reglements.dw_reglements.getitemstring(lig,"commentaire")
				ls_payeur = tab_1.tabpage_reglements.dw_reglements.getitemstring(lig,"payeur")
			end if
			v_montant_recu = v_montant_recu + tab_1.tabpage_reglements.dw_reglements.getitemnumber(lig,"montant")
		end if
		montant_total_reglements = montant_total_reglements + tab_1.tabpage_reglements.dw_reglements.getitemnumber(lig,"montant")
	next
	
	if nb_regl > 0 then
		// Y a des reglements cochés => on prend ça 
		v_suite = true
		montant_total_soins = dw_soins.getitemNumber(dw_soins.getrow(),"total")
		montant_total_soins_hn = dw_soins.getitemNumber(dw_soins.getrow(),"hn")
		libelle_du_soin =  dw_soins.getitemString(dw_soins.getrow(),"code_soins_nom")	

	else
		
		// On cherche si des soins ont été sélectionnés...
	
	
		tot2 = dw_soins.rowcount()
		
		nb_regl = 0
		montant_total_reglements = 0
		montant_total_soins = 0
		montant_total_soins_hn = 0
		
		boolean reglement_sur_le_soin 
		
		libelle_du_soin = ""
		
		for lig2 = 1 to tot2
			
			reglement_sur_le_soin = false
			
			if dw_soins.getitemstring(lig2,"fse") = 'O'  then
				
				nb_soins = nb_soins + 1
				
				// pour provoquer le retrieve de la dw des reglements
				dw_soins.scrolltorow(lig2)
				
				// Y a t il des règlements pour de soin ....
				tot = tab_1.tabpage_reglements.dw_reglements.rowcount()
				for lig = 1 to tot
					nb_regl = nb_regl + 1
					if  tab_1.tabpage_reglements.dw_reglements.getitemdate(lig,"date") > v_date then
						v_cle_regl = tab_1.tabpage_reglements.dw_reglements.getitemnumber(lig,"cle")
						// pour mémorisation pour le retriever de w_recu
						v_date = tab_1.tabpage_reglements.dw_reglements.getitemdate(lig,"date")
						v_mon = tab_1.tabpage_reglements.dw_reglements.getitemnumber(lig,"montant")
						v_code_regl = var_code_local
						// Ajout du mode et des commentaires
						v_mode = tab_1.tabpage_reglements.dw_reglements.getitemstring(lig,"mode")
						v_comment = tab_1.tabpage_reglements.dw_reglements.getitemstring(lig,"commentaire")
						ls_payeur = tab_1.tabpage_reglements.dw_reglements.getitemstring(lig,"payeur")
					end if
					reglement_sur_le_soin = true
					v_montant_recu = v_montant_recu + tab_1.tabpage_reglements.dw_reglements.getitemnumber(lig,"montant")
					montant_total_reglements = montant_total_reglements  + tab_1.tabpage_reglements.dw_reglements.getitemnumber(lig,"montant")
				next
				
				if reglement_sur_le_soin then
					if len(trim(libelle_du_soin)) > 0 then
						// on ajoute un séparateur
						libelle_du_soin = libelle_du_soin + " + "
					end if
					libelle_du_soin =  libelle_du_soin + dw_soins.getitemString(dw_soins.getrow(),"code_soins_nom")	
				end if

				montant_total_soins = montant_total_soins + dw_soins.getitemNumber(lig2,"total")
				montant_total_soins_hn = montant_total_soins_hn + dw_soins.getitemNumber(lig2,"hn")
				
			end if
		next
		
		if nb_regl > 0 then 
			v_suite = true
		else
			// pas de reglement trouvé
			if nb_soins > 0 then
				// y avait des soins cochés, mais pas de reglement
				v_suite = false
				son(5)
				messagebox("ATTENTION !", "Aucun règlement n'a été saisi pour ce(s) soin(s) !")
			else
				// On reste sur le soin en cours ... sur le reglemen en cours ...
				
				if tab_1.tabpage_reglements.dw_reglements.rowcount() = 0 then
					son(5)
					MessageBox("ATTENTION !","Aucun règlement n'a été saisi pour ce soin !")
					v_suite = false
				else
					v_suite = true
					v_cle_regl = tab_1.tabpage_reglements.dw_reglements.getitemnumber(tab_1.tabpage_reglements.dw_reglements.getrow(),"cle")
					v_date = tab_1.tabpage_reglements.dw_reglements.getitemdate(tab_1.tabpage_reglements.dw_reglements.getrow(),"date")
					v_mon = tab_1.tabpage_reglements.dw_reglements.getitemnumber(tab_1.tabpage_reglements.dw_reglements.getrow(),"montant")
					v_code_regl = var_code_local
					// Ajout du mode et des commentaires
					v_mode = tab_1.tabpage_reglements.dw_reglements.getitemstring(tab_1.tabpage_reglements.dw_reglements.getrow(),"mode")
					v_comment = tab_1.tabpage_reglements.dw_reglements.getitemstring(tab_1.tabpage_reglements.dw_reglements.getrow(),"commentaire")
					ls_payeur = tab_1.tabpage_reglements.dw_reglements.getitemstring(tab_1.tabpage_reglements.dw_reglements.getrow(),"payeur")
					montant_total_soins = montant_total_soins + dw_soins.getitemNumber(dw_soins.getrow(),"total")
					montant_total_soins_hn = montant_total_soins_hn + dw_soins.getitemNumber(dw_soins.getrow(),"hn")
					v_montant_recu = v_mon
					// montant total des règlements
					tot = tab_1.tabpage_reglements.dw_reglements.rowcount()
					for lig = 1 to tot
						montant_total_reglements = montant_total_reglements + tab_1.tabpage_reglements.dw_reglements.getitemnumber(lig,"montant")
					next
					
					libelle_du_soin =  dw_soins.getitemString(dw_soins.getrow(),"code_soins_nom")	

				end if
			end if
		end if
	end if
	
	if v_suite then
		open(w_patience_locale)
		
		// Pour passage de paramètres
		param_win[1] = string(montant_total_soins )
		param_win[2] = string(montant_total_reglements) 
		param_win[3] = string(v_montant_recu) 
		param_win[4] = libelle_du_soin
		param_win[5] = string(montant_total_soins_hn )
		select top 1 nom into :param_win[6]  from mode_reglement where code = :v_mode ; 
		param_win[7] = string(v_date)
		
		param_win[8] = v_comment
		param_win[9] = ls_payeur

		if profilestring(dir_ini+inifile_orthokis,"WORD","recu_word","N") = "O" then 
			Trace(". Impression du reçu au Format Word")
			// impression du reçu au format WORD
		
			double v_id_recu_word
			string nom_fichier_recu
			
			select max(id_recu_word) into :v_id_recu_word from param ;
			zerodb(v_id_recu_word)
			
			if v_id_recu_word = 0 then 
				if Messagebox("ATTENTION",'Pour imprimer un reçu au format Word vous devez définir le fichier Word associé (Onglet "Administratif", dans les "Paramètres Généraux").~n~nSouhaitez-vous le définir maintenant ?', Question!, YesNo!, 2) = 1 then
					if isvalid(w_paramgene) then
						// on selectionne
						w_mdi_2020.uo_powerdock.of_activatedocument (w_paramgene)
					else
						if fxg_ouverture_onglet_possible() then
							w_mdi_2020.uo_powerdock.of_openDocument(w_paramgene, "Paramètres Généraux", m_orthokis_2020.m_outils.m_paramètres.toolbarItemName )
						end if
					end if
					w_paramgene.tab_1.selectTab(2)
				end if
			else
				// 
				  SELECT trim(nom_document) + '.' + trim(extension)  
					 INTO : nom_fichier_recu
					 FROM "courriers_word"  
					WHERE "courriers_word"."id" = :v_id_recu_word    ;
				
				if FileExists(dir_courriers + nom_fichier_recu) then
					m_orthosoins m_menu
					// pour utiliser les fonction classiques d'impression de courriers Word ... 
					// on doit sélectioner les lignes qui font partie de la du documens dans dw_soins
					if dw_soins.rowcount() > 0 then
						dw_soins.SetItem(dw_soins.getrow(),"FSE","O") 
					end if

					string inifile_echeancier = "echeancier.ini"
					FileDelete (dir_ini + inifile_echeancier)
					m_menu = create m_orthosoins
					m_menu.utiliser_courrier_word ("R", 0)
					
				else
					Messagebox("ATTENTION","Le fichier d'impression du reçu est introuvable.~n~nNom du fichier : " + nom_fichier_recu + "~n~nVeuillez contacter ARAKIS.")
				end if
			end if
							
		else

//				Trace(". Avant ouverture w_recu - Impression du reçu classique" )
//				open(w_recu)
//				Trace(". Après ouverture w_recu")
//				
			imprimer_recu()

		end if
		close(w_patience_locale)
	end if
	
	
	
end if
end event

type cb_modifier_reglement from uo_picturebutton_390x120 within tabpage_reglements
integer x = 731
integer y = 716
integer width = 242
integer taborder = 390
string text = "..."
string tiptext = "Modification du règlement"
end type

event clicked;call super::clicked;if dw_soins.rowcount() = 0 then
	son(5)
	MessageBox("ATTENTION !","Aucun soin n'a été saisi !")
else
	if tab_1.tabpage_reglements.dw_reglements.rowcount() = 0 then
		son(5)
		MessageBox("ATTENTION !","Aucun règlement n'a été saisi pour ce soin !")
	else
		if not isnull(tab_1.tabpage_reglements.dw_reglements.getitemdate(tab_1.tabpage_reglements.dw_reglements.getrow(),"transfert")) then

			son(5)
			MessageBox("ATTENTION !","Ce règlement a été transféré en comptabilité le "+string(tab_1.tabpage_reglements.dw_reglements.getitemdate(tab_1.tabpage_reglements.dw_reglements.getrow(),"transfert"),"dd/mm/yyyy")+".~n~nVous ne pouvez plus ni le modifier ni le supprimer !")

		else
			double lig_paye
			lig_paye = dw_soins.getrow()
			v_cle_regl = tab_1.tabpage_reglements.dw_reglements.getitemnumber(tab_1.tabpage_reglements.dw_reglements.getrow(),"cle")
			v_code_regl = var_code_local
			v_mon = tab_1.tabpage_reglements.dw_reglements.getitemdecimal(tab_1.tabpage_reglements.dw_reglements.getrow(),"montant")
			v_date = tab_1.tabpage_reglements.dw_reglements.getitemdate(tab_1.tabpage_reglements.dw_reglements.getrow(),"date")
			v_date_rem = tab_1.tabpage_reglements.dw_reglements.getitemdate(tab_1.tabpage_reglements.dw_reglements.getrow(),"dateremise")
			v_mode = tab_1.tabpage_reglements.dw_reglements.getitemstring(tab_1.tabpage_reglements.dw_reglements.getrow(),"mode")
			v_comment = tab_1.tabpage_reglements.dw_reglements.getitemstring(tab_1.tabpage_reglements.dw_reglements.getrow(),"commentaire")
			
			guo_fenetre_modale.wf_ouvrir_param_nombre(w_reglements_saisie,2)
			//	OpenWithParm(w_reglements_saisie,2)

			dw_soins.retrieve(var_code_local)
			dw_soins.Scrolltorow(lig_paye)
			dw_soins.Setrow(lig_paye)
			dw_detail.retrieve(var_code_local,dw_soins.getitemnumber(lig_paye,"cle"))
			tab_1.tabpage_reglements.dw_reglements.retrieve(var_code_local,dw_soins.getitemnumber(lig_paye,"cle"))
		end if
	end if
end if
end event

type cb_supprimer_reglement from uo_picturebutton_390x120 within tabpage_reglements
integer x = 489
integer y = 716
integer width = 242
integer taborder = 390
string text = "-"
string tiptext = "Suppression du règlement"
end type

event clicked;call super::clicked;if dw_soins.rowcount() = 0 then
	son(5)
	MessageBox("ATTENTION !","Aucun soin n'a été saisi !")
else
	if tab_1.tabpage_reglements.dw_reglements.rowcount() = 0 then
		son(5)
		MessageBox("ATTENTION !","Aucun règlement n'a été saisi pour ce soin !")
	else
		if not isnull(tab_1.tabpage_reglements.dw_reglements.getitemdate(tab_1.tabpage_reglements.dw_reglements.getrow(),"transfert")) then

			son(5)
			MessageBox("ATTENTION !","Ce règlement a été transféré en comptabilité le "+string(tab_1.tabpage_reglements.dw_reglements.getitemdate(tab_1.tabpage_reglements.dw_reglements.getrow(),"transfert"),"dd/mm/yyyy")+".~n~nVous ne pouvez plus ni le modifier ni le supprimer !")
		else
			if not isnull(tab_1.tabpage_reglements.dw_reglements.getitemnumber(tab_1.tabpage_reglements.dw_reglements.getrow(),"code_remise")) then
				datetime v_dt
				v_dt = tab_1.tabpage_reglements.dw_reglements.getitemdatetime(tab_1.tabpage_reglements.dw_reglements.getrow(),"remises_date_generation")
				son(5)
				MessageBox("ATTENTION !","Ce règlement fait partie de la remise en banque du "+string( date(v_dt)) +" à " + string(time(v_dt)) +". Vous ne pouvez pas le supprimer.~n~nVous devez d'abord annuler la remise en banque si vous souhaitez réellement le faire.")

			else
	
			ok_mdp = false
	
		  SELECT "prati"."pasreg"  
		 INTO :pasreg  FROM "patient", "prati"  
		WHERE ( "prati"."code" = "patient"."code_praticien" ) and  
				( ( "patient"."code" = :var_code_local ) )   ;
	
		guo_fenetre_modale.wf_ouvrir(w_mot_passe_reglements)
		
		if ok_mdp then
			if MessageBox("ATTENTION !","La suppression de ce règlement ~nsera définitive !~n~nConfirmez-vous ?",Question!,yesNo!,2) = 1 then
				double lig_paye
				lig_paye = dw_soins.getrow()
				v_cle_regl = tab_1.tabpage_reglements.dw_reglements.getitemnumber(tab_1.tabpage_reglements.dw_reglements.getrow(),"cle")
				v_mon = tab_1.tabpage_reglements.dw_reglements.getitemdecimal(tab_1.tabpage_reglements.dw_reglements.getrow(),"montant")
				v_date = tab_1.tabpage_reglements.dw_reglements.getitemdate(tab_1.tabpage_reglements.dw_reglements.getrow(),"date")
				v_date_rem = tab_1.tabpage_reglements.dw_reglements.getitemdate(tab_1.tabpage_reglements.dw_reglements.getrow(),"dateremise")
				// ajout
				v_mode = tab_1.tabpage_reglements.dw_reglements.getitemstring(tab_1.tabpage_reglements.dw_reglements.getrow(),"mode")
				v_comment = tab_1.tabpage_reglements.dw_reglements.getitemstring(tab_1.tabpage_reglements.dw_reglements.getrow(),"commentaire")			
				son(7)
				DELETE FROM "paye" 
				WHERE "code" = :var_code_local and "cle" = :v_cle_regl 
				and "montant" = :v_mon and "date" = :v_date and "dateremise" = :v_date_rem and 
				"commentaire" = :v_comment and "mode" = :v_mode ;
				if SQLCA.Sqlcode <> 0 then
					son(4)
					Messagebox("ERREUR BASE DE DONNEES",SQLCA.SqlErrText)
					rollback ;
				else
					COMMIT ;
					// Suppression du reglement
					ajout_histo_actions(var_code_local,"SUPREG",today(),"Du "+string(v_date,'dd/mm/yyyy')+" - Montant : "+string(v_mon,'0.00'))
					if TEA then 
						// actualisation du soin
						//fxg_lancer_commande_dsapi("payment/update/" + string(var_code_local)+"-"+string(v_cle_regl), "",  "S", "G" , var_code_local)
						fxg_maj_soins_tea(var_code_local, v_cle_regl, "U")
					end if

				end if
				dw_soins.retrieve(var_code_local)
				dw_soins.Scrolltorow(lig_paye)
				dw_soins.Setrow(lig_paye)
				dw_detail.retrieve(var_code_local,dw_soins.getitemnumber(lig_paye,"cle"))
				tab_1.tabpage_reglements.dw_reglements.retrieve(var_code_local,dw_soins.getitemnumber(lig_paye,"cle"))
			end if
		end if
	end if
end if
end if
end if
end event

type cb_ajouter_reglement from uo_picturebutton_390x120 within tabpage_reglements
integer x = 5
integer y = 716
integer width = 242
integer taborder = 390
string text = "+"
string tiptext = "Ajout d~'un règlement"
end type

event clicked;call super::clicked;double lig_paye

double v_cle_regl_clique

if dw_soins.rowcount() = 0 then
	son(5)
	MessageBox("ATTENTION !","Aucun soin n'a été saisi !")
else
	
	
	// Depuis la V10 on peut soit saisir sur 1 soin (pas de case FSE cochée) ou sur plusieurs
	integer lig, ligtot, lig_mini, cpt
	ligtot = dw_soins.rowcount()
	
	// Avant de changer l'ordre de tri, on mémorise la ligne cliquée si besoin pour la suite
	v_cle_regl_clique = dw_soins.getitemnumber(dw_soins.getrow(),"cle")

	// pour se remettre ensuite sur le bonne ligne
	lig_paye = dw_soins.getrow()
	
	
	// On classe les soins selon leur date d'échéances avant de sélectionner ... pour examiner les soins dans cet ordre
	dw_soins.SetSort("date_ligne, date_demande, code_soins_nom, numero")
	dw_soins.Sort()
	
	// v_cle_regl sert à stocker le nombre de soin cochés EN NEGATIF car sinon on va confondre
	// variable globale pour passage en paramètre
	v_cle_regl = 0
	lig_mini = 0
	for lig = 1 to ligtot
		if dw_soins.getitemstring(lig,"fse") = 'O' then
			// Ligne de soins
			v_cle_regl = v_cle_regl - 1
			lig_mini = lig
			v_cle_regl_tab[abs(v_cle_regl)] = dw_soins.getitemnumber(lig,"cle")
		end if
	next

	if v_cle_regl = 0 then
		// rien n'a été coché => saisie normal, sur un seul soin
		v_cle_regl = v_cle_regl_clique
		// l'ordre peut avoir changé => n° de la ligne ?
		lig_mini = dw_soins.find("cle = " + string(v_cle_regl_clique), 0, 99999)
		if lig_mini = 0 then
			// en principe pas possible mais
			lig_mini = lig_paye
		end if
	end if
	
	// recherche si un des soins d'avant et encore dû ... 
	double totsoin, totpaye
	double v_cle_temp
	for lig = 1 to lig_mini - 1
		
		// On ne teste pas les lignes concernées pas la saisie du règlement
		if dw_soins.GetItemString(lig,"fse") <> "O" then

			totsoin = dw_soins.getitemnumber(lig,"total")
			v_cle_temp = dw_soins.getitemnumber(lig,"cle")
			select isnull(sum(montant),0) into :totpaye from paye where code = :var_code_local and cle = :v_cle_temp ;
			
			if totsoin > totpaye then
				string v_lib
				integer v_num
				
				v_lib = dw_soins.getitemstring(lig,"code_soins_nom")
				v_num = dw_soins.getitemnumber(lig,"numero")
				
				zeroi(v_num)
				
				if v_num > 0 then
					v_lib = v_lib + " N°"+string(v_num)
				end if
				
				v_lib = v_lib + " du "+string(dw_soins.getitemdate(lig,"date_demande"))
				
				Messagebox("ATTENTION","Le soin précédent n'est pas soldé :~n~n"+v_lib)
			end if
		end if
	next
	
	
	// Remise dans le bon ordre
	dw_soins.SetSort(dw_soins_tri_initial)
	dw_soins.Sort()

	// Variables globales utilisées dans la saisie du reglement
	v_code_regl = var_code_local
	v_mon = 0
	v_date = today()
	
	guo_fenetre_modale.wf_ouvrir_param_nombre(w_reglements_saisie,1)

//	OpenWithParm(w_reglements_saisie,1)
 

	
	dw_soins.retrieve(var_code_local)
	dw_soins.Scrolltorow(lig_paye)
	dw_soins.Setrow(lig_paye)
	dw_detail.retrieve(var_code_local,dw_soins.getitemnumber(lig_paye,"cle"))
	tab_1.tabpage_reglements.dw_reglements.retrieve(var_code_local,dw_soins.getitemnumber(lig_paye,"cle"))
	
	// Après un ajout de règlement on recoche les ligns cochés pour pouvoir faire une FSE derrière, pas en Belgique car rien à voir
	// En option depuis 25.00f
	
	if not Belgique then
		
		if profilestring(dir_ini+inifile_orthokis,"admini","soins_coches_reglement","O")  = "O" then 

		
			// On remet tout à N par sécurité
			for lig = 1 to ligtot
				dw_soins.Setitem(lig,"fse", "N") 
			next
			
			// Les clefs cochées sont dans un tableau
			for cpt = 1 to upperbound(v_cle_regl_tab) 
				lig = dw_soins.find("cle = " + string(v_cle_regl_tab[cpt]), 0, 99999)
				if lig > 0 then 
					dw_soins.Setitem(lig,"fse", "O") 
				end if
			next 		
		end if
	end if
	
end if
end event

type dw_reglements from datawindow within tabpage_reglements
string tag = "brush"
integer width = 3118
integer height = 668
integer taborder = 330
string title = "none"
string dataobject = "dw_detail_reglement"
boolean hscrollbar = true
boolean vscrollbar = true
boolean livescroll = true
end type

event clicked;If row > 0 Then
	This.Setrow(row)
End If

end event

event doubleclicked;// Double clic -> Comme si on cliquait sur "MODIFIER"

if droits_acces[12] = "T" or droits_acces[12] = "M" then
	tab_1.tabpage_reglements.cb_modifier_reglement.triggerevent(Clicked!)
end if

end event

event retrieveend;long var_cle = 0 

string mon, sf, se   
string ls_symbole_monnaie

 SELECT     "param"."monnaie_base",       "param"."symbole_franc",         "param"."symbole_euro"		into :mon, :sf, :se       FROM   "param"  ;
 
if mon = 'F' then
	ls_symbole_monnaie = sf
else
	ls_symbole_monnaie = se
end if
  
if rowcount = 0 then

	// Pas de règlements, on calcule les sommes dues
	
	// Calcul de la somme due
	double doit

	if dw_soins.rowcount() > 0 then
		var_cle = dw_soins.getitemnumber(dw_soins.getrow(),"cle")
	end if
	
	
//	SELECT isnull(sum(montant),0) into :doit FROM ligne_soins WHERE :var_code_local = ligne_soins.code and ligne_soins.cle = :var_cle and ligne_soins."date" <= cast(getdate() as date) ;
	
	// Utilisation de la procédure stockée 
	select dba.lignes_soins_dues_un_soin(:var_code_local,:var_cle, cast(getdate() as date), 'O') into :doit  from param ; 
	

			 


	
	this.modify ('t_somme_due.text = "Dû à ce jour : ' +string(doit,"0.00")+" "+ls_symbole_monnaie+ '"' )
	this.modify ('t_total_paye.text = "0.00 '+ ls_symbole_monnaie+'"' )
	
	this.modify ('t_somme_due.visible = 1' )
	this.modify ('somme_due.visible = 0' )
	this.modify ('t_total_paye.visible = 1' )
	this.modify ('total_paye.visible = 0' )
else
	this.modify ('t_somme_due.visible = 0' )
	this.modify ('somme_due.visible = 1' )
	this.modify ('t_total_paye.visible = 0' )
	this.modify ('total_paye.visible = 1' )
	if dw_soins.rowcount() > 0 then
		var_cle = dw_soins.getitemnumber(dw_soins.getrow(),"cle")
	end if
end if

// Mode de règlement habituel
string v_nom_mode_reglement_habituel
SELECT isnull(mode_reglement.nom, '') into :v_nom_mode_reglement_habituel  from mode_reglement, patient 
where patient.mode_reglement_habituel  = mode_reglement.code and patient.code = :var_code_local ;

if v_nom_mode_reglement_habituel <> '' then
	this.modify ('t_nom_mode_reglement_habituel.visible = 1')
	this.modify ('t_nom_mode_reglement_habituel.text = "Mode de règlement habituel : ' + v_nom_mode_reglement_habituel + '"')
	this.Object.DataWindow.footer.height = 176
	this.groupcalc()
end if


// Affichage des infos de dûs TP
decimal{2} total_soins_caisse, total_soins_mutuelle, total_soins_patient
decimal{2} du_caisse, du_mutuelle, du_patient
decimal{2} total_paye_caisse, total_paye_mutuelle, total_paye_patient

if rowcount > 0 then 
	total_paye_caisse = this.getitemNumber(1,"total_paye_caisse")
	total_paye_mutuelle = this.getitemNumber(1,"total_paye_mutuelle")
	total_paye_patient = this.getitemNumber(1,"total_paye_patient")
else
	total_paye_caisse = 0
	total_paye_mutuelle = 0
	total_paye_patient = 0
end if

// Analyse des sommes dues patient / caisse / mutuelle
SELECT
   isnull( SUM(CASE WHEN TP = 'O' AND origine_tp = 'C' THEN montant ELSE 0 END) , 0),
	 isnull(  SUM(CASE WHEN TP = 'O' AND origine_tp = 'M' THEN montant ELSE 0 END) , 0) ,
    isnull(  SUM(CASE WHEN TP <> 'O' THEN montant ELSE 0 END) , 0) 
	 into :total_soins_caisse, :total_soins_mutuelle, :total_soins_patient
FROM ligne_soins where code = :var_code_local and cle = :var_cle and ligne_soins."date" <= cast(getdate() as date);

du_caisse = total_soins_caisse - total_paye_caisse
du_mutuelle = total_soins_mutuelle - total_paye_mutuelle
du_patient = total_soins_patient - total_paye_patient

this.object.t_du_patient.visible = 0
this.object.t_du_mutuelle.visible = 0
this.object.t_du_caisse.visible = 0	

// uniquement si la caisse ou la mutuelle doit .. on explicite
if du_caisse > 0 or du_mutuelle > 0 then 
	if du_patient > 0 then 
		this.object.t_du_patient.visible = 1
		this.object.t_du_patient.text = "Dû patient : " + string(du_patient, "0.00") + " " + ls_symbole_monnaie
	end if
	if du_caisse > 0 then 
		this.object.t_du_caisse.visible = 1
		this.object.t_du_caisse.text = "Dû caisse : " + string(du_caisse, "0.00") + " " + ls_symbole_monnaie
	end if
	if du_mutuelle > 0 then 
		this.object.t_du_mutuelle.visible = 1
		this.object.t_du_mutuelle.text = "Dû mutuelle : " + string(du_mutuelle, "0.00") + " " + ls_symbole_monnaie
	end if

	
	

end if



end event

event rowfocuschanged;	
	if currentrow > 0 then
		This.SetRow(currentrow)
	end if


end event

event rbuttondown;if rowcount() > 0 then
	
	string s_tp, s_origine_tp
	
	w_click_soins_reg = tab_1.getparent()
	s_tp = getItemString(row, "tp")
	s_origine_tp = getItemString(row, "origine_tp")
	
	// Selon le type de règlement, repoort autorisé ou pas
	newmenu_reglt.m_reportertroppercumutuelle.enabled = false
	newmenu_reglt.m_reportertroppercucaisse.enabled = false
	newmenu_reglt.m_reportertroppercupatient.enabled = false
	newmenu_reglt.m_reportertroppercupatientfratrie.enabled = false


	if s_tp = "N" then
		// patient 
		newmenu_reglt.m_reportertroppercupatient.enabled = true
		newmenu_reglt.m_reportertroppercupatientfratrie.enabled = true
	else
		if s_origine_tp = "C" then
			newmenu_reglt.m_reportertroppercucaisse.enabled = true
		else
			newmenu_reglt.m_reportertroppercumutuelle.enabled = true
		end if
		
	end if
	
	newmenu_reglt.popmenu(this.PointerX(), w_mdi_2020.PointerY())
	
end if
end event

type cb_justif from uo_picturebutton_390x120 within tabpage_reglements
boolean visible = false
integer x = 2117
integer y = 492
integer width = 325
integer taborder = 330
boolean bringtotop = true
string text = "Doc. Justif"
string tiptext = "Document justificatif de soin hors Inami"
end type

event clicked;call super::clicked;long lig, tot
integer cpt_elimine = 0

if dw_soins.rowcount() > 0 then

	// si pas de ligne cochée on prend la ligen courante
	lig = dw_soins.find("fse = 'O'" , 1, 9999)
	
	if lig = 0 then 
		dw_soins.Setitem(dw_soins.getrow(),"fse" , 'O' )
	end if


	// Vérification des lignes ... on ne prend pas les lignes ayant déjà un justif et/ou attest et/ou eAttest
	tot = dw_soins.rowcount()
	for lig = 1 to tot
		string t1, t2
		t1 = dw_soins.GetitemString(lig,"fse" )
		t2 = string_non_nulle(trim(dw_soins.GetitemString(lig,"soins_fse_edite" )))
		
		if dw_soins.GetitemString(lig,"fse" ) = "O" and (string_non_nulle(trim(dw_soins.GetitemString(lig,"soins_fse_edite" ))) <> ""  or dw_soins.GetitemNumber(lig,"numero_facture") > 0)     then
			cpt_elimine = cpt_elimine + 1
			dw_soins.Setitem(lig,"fse" , '' )
		end if
	next
	
	if cpt_elimine > 0 then
		if cpt_elimine = 1 then 
			Messagebox("ATTENTION","1 ligne ayant déjà fait l'objet d'une Attestation ou d'une eAttestation ou d'un Justificatif a été désélectionnée !")
		else
			Messagebox("ATTENTION", string(cpt_elimine) + " lignes ayant déjà fait l'objet d'une Attestation ou d'une eAttestation ou d'un Justificatif ont été désélectionnées !")
		end if
	end if

	if dw_soins.find("fse = 'O'" , 1, 9999) > 0 then
		// S'il reste des lignes cochées
		newmenu.utiliser_courrier_word("J", 0)
	end if
end if



end event

