type cb_enregistrer_impr from uo_picturebutton_390x120 within tabpage_soins
integer x = 1202
integer y = 688
integer width = 553
integer height = 152
integer taborder = 330
string text = "Enregistrer"
string iconname = "ACTIONS_enregistrer.png"
end type

event clicked;call super::clicked;dw_impression.AcceptText ()

boolean v_modif = false

if CCVITALE and  dw_impression.rowcount() > 0 then
	integer v_quantite, v_denombrement
	v_quantite = dw_impression.GetItemNumber(1, "quantite")
	zeroi(v_quantite)
	if v_quantite <= 0 then
		Messagebox("ATTENTION", "La quantité doit être supérieure à 0")
		dw_impression.SetItem(1, "quantite", 1) 
		v_modif = true
	end if
//	v_denombrement = dw_impression.GetItemNumber(1, "denombrement")
//	zeroi(v_denombremen)
//	if v_denombrement <= 0 then
//		Messagebox("ATTENTION", "Le dénombrement doit être supérieur à 0")
//		dw_impression.SetItem(1, "denombrement", 1) 
//		v_modif = true
//	end if
end if


dw_impression.AcceptText ()

IF dw_impression.update() = 1 THEN
	// On met à a jour la date_exe dans les soins car elle sert pour la feuille de soin
	if dw_impression.rowcount() > 0 then
		if dw_soins.rowcount() > 0 then
			dw_soins.setitem(dw_soins.getrow(),"soins_date_exe",dw_impression.getitemdate(dw_impression.getrow(),"date_exe"))
		end if
	end if
			
	
	COMMIT ;
	
 	// S'il y a eu une modif de quantité, on reffraichit l'affichage
	if v_modif then
	 	tab_1.tabpage_soins.dw_impression.retrieve(dw_soins.getitemnumber(dw_soins.getrow(),"cle"),var_code_local, v_pays)
	end if

	
ELSE
	messagebox("ATTENTION","Erreur dans la mise à jour des données")
	ROLLBACK ;
END IF	


end event

