type dw_impression from datawindow within tabpage_soins
string tag = "brush no resizeall"
integer x = 14
integer y = 20
integer width = 2697
integer height = 708
integer taborder = 330
string title = "Complément du soin"
string dataobject = "dw_detail_soin_impression_ccvitale"
boolean livescroll = true
end type

event itemchanged;
// Mémorisation des infos de modifications la 1ere fois 
if row > 0 and first_modif then 
	fxg_set_infos_modifs(this,row)
	first_modif = false
end if


if enregistrement_automatique then
	tab_1.tabpage_soins.cb_enregistrer_impr.postevent(clicked!)
end if




end event

event retrieveend;

if rowcount > 0 then
	
	// pour dire que OK en modif
	first_modif = true
	boolean v_update = false
	string v_code_soins_nom
	
	if  BELGIQUE then
		// Spécial efacturation
		
		// Mise en place des valeurs par defaut ... 
		
		if string_non_nulle( GetItemString(1, "norme_prestation") ) = "" then
			setitem(1, "norme_prestation", "0")
			v_update = true
		end if
		if string_non_nulle( GetItemString(1, "derogation") ) = "" then
			setitem(1, "derogation", "00")
			v_update = true
		end if

		if string_non_nulle( GetItemString(1, "heures_non_ouvrees") ) = "" then
			setitem(1, "heures_non_ouvrees", "0")
			v_update = true
		end if
		if string_non_nulle( GetItemString(1, "code_facturation_intervention_personnelle") ) = "" then
			setitem(1, "code_facturation_intervention_personnelle", "1")
			v_update = true
		end if
		if string_non_nulle( GetItemString(1, "norme_prescripteur") ) = "" then
			setitem(1, "norme_prescripteur", "0")
			v_update = true
		end if
		
		// Si acte radio 
		v_code_soins_nom = upper( string_non_nulle( GetItemString(1, "code_soins_nom") )    )
		if pos(v_code_soins_nom, "RADIO", 1) > 0 and string_non_nulle( GetItemString(1, "norme_prescripteur") )  <> "3" then
			setitem(1, "norme_prescripteur", "3")
			v_update = true
		end if
			
		
		
		if string_non_nulle( GetItemString(1, "norme_dispensateur") ) = "" then
			setitem(1, "norme_dispensateur", "1")
			v_update = true
		end if
		
		// Si acte radio 

		if v_update then
			update()
			commit ;
		end if
	
		
		
	else
	
		// Spécial fac de montpellier : recherche du numero de séjour
		if SERIAL = "87644" and rowcount > 0 then
		
			double v_code, v_cle
			date vv_date
			string v_numero_sejour
			v_code = GetItemNumber(1, "code")
			v_cle = GetItemNumber(1, "cle")
			vv_date = GetItemDate(1, "date_exe")
			v_numero_sejour = fxg_fac_montpellier_numero_sejour(v_code, vv_date)
			
			if v_numero_sejour <> "" then
				Modify("t_numero_sejour.visible = 1")
				Modify("t_numero_sejour.text = 'Séjour : " + string(v_numero_sejour) + "'")
			else
				Modify("t_numero_sejour.visible = 0")
				Modify("t_numero_sejour.text = ''")
			end if
				
		end if
		
		if CCVITALE and  rowcount > 0 then
			integer v_quantite, v_denombrement
			v_quantite = GetItemNumber(1, "quantite")
			zeroi(v_quantite)
			if v_quantite <= 0 then
				SetItem(1, "quantite", 1) 
				v_update = true
			end if
			v_denombrement = GetItemNumber(1, "denombrement")
			if  fxg_get_version_ccvitale() >= "4.40" then
				// La zone dénombrement sert à l'EBD
				if isnull(v_denombrement) then
					SetItem(1, "denombrement", 1) 
					v_update = true
				end if
				
			else
				zeroi(v_denombrement)
				if v_denombrement <= 0 then
					SetItem(1, "denombrement", 1) 
					v_update = true
				end if
			end if
			
			if v_update then
				update()
				commit ;
			end if
		
		end if
		
		
		if ccvitale and france then
			Modify("b_motif_depassement.visible = 1")
		else
			Modify("b_motif_depassement.visible = 0")
		end if
		
		
		this.enabled = true
		
		// A t on le droit de modifier la ligne de soins
		if droits_acces[84] = "N" then
			if dw_soins.getitemstring(dw_soins.getrow() , "soins_fse_edite") = "V"  or dw_soins.getitemstring(dw_soins.getrow() , "soins_fse_edite") = "M"  then
				this.enabled = false
			end if
		end if
	end if
	
end if

end event

event buttonclicked;string ls_object

ls_Object = String(dwo.name)

choose case ls_Object
	case  "b_date_impr" 
		// Date de jour
		set_today(this, "date_impr")
	case  "b_date_donne" 
		// Date de jour
		set_today(this, "date_donne")
	case  "b_date_exe" 
		// Date de jour
		set_today(this, "date_exe")
	case  "b_date_rapport" 
		// Date de jour
		set_today(this, "date_rapport")
	case  "b_date_accord" 
		// Date de jour
		set_today(this, "date_accord")
	case  "b_date_presciption"
		set_today(this, "date_presciption")
	case  "b_motif_depassement" 
		// Choix des motifs
		if ccvitale then
			lb_motif_depassement_ccvitale.visible = true
		end if
		
	case "b_schema"
		if row > 0 then
			param_win[1] = "D"
			openWithParm(w_schema, GetItemString(1, "soins_dent"))

			// recup de la valeur retournée
			string v_extraction 
			v_extraction = message.StringParm
			if v_extraction <> "-1" then
				SetItem(1, "soins_dent", v_extraction)
			end if
		end if

		
end choose

if enregistrement_automatique then
	tab_1.tabpage_soins.cb_enregistrer_impr.triggerevent(clicked!)
end if

end event

event clicked;

if row > 0 then
	// sert à être sût d'enrgistrer si on clique sur remboursement except
	

	
//	messagebox("trace", string(this.ModifiedCount () ))
	
	
//	// Mémorisation des infos de modifications la 1ere fois 
//	if row > 0 and first_modif then 
//		fxg_set_infos_modifs(this,row)
//		first_modif = false
//	end if
//	
//	
//	if enregistrement_automatique then
//		tab_1.tabpage_soins.cb_enregistrer_impr.triggerevent(clicked!)
//	end if


end if
end event

