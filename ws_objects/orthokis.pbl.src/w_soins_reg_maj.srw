				end if
			end if
			newmenu.m_soins.m_-2.visible = true

		if luxembourg then
			newmenu.m_soins.m_2.visible = true
			newmenu.m_soins.m_selectionnertouslessoinsdus.visible = true
		end if
		
		
		
		// Verrouillage selon les droits d'accès
		//-------------------------------------------
		
		choose case droits_acces[12]
			Case 'C'
				// Consultation 
				tab_1.tabpage_reglements.cb_ajouter_reglement.enabled ( false)
				tab_1.tabpage_reglements.cb_bis_reglement.enabled ( false)
				tab_1.tabpage_reglements.cb_modifier_reglement.enabled ( false)
				tab_1.tabpage_reglements.cb_supprimer_reglement.enabled ( false)
			Case 'M'
