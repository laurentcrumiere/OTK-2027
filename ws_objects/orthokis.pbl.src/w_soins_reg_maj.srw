end on

event clicked;if enregistrement_automatique then
	tab_1.tabpage_soins.dw_impression.accepttext()
	tab_1.tabpage_soins_prevus.dw_devis.accepttext()
	tab_1.tabpage_soins.cb_enregistrer_impr.triggerevent(clicked!)
end if

if isnull(index) then return 0
if not index > 0 then return 0
if this.Control[index].enabled then
	choose case index
		case 1
			type_gestion = 'P'
		case 2 
			type_gestion = 'S'
		case 3 
			type_gestion = 'R'
	end choose
	maj_selon_module(type_gestion)
end if

end event

