event clicked;// Duplication du dévis sélectionné

string s_libelle_devis
long tot
integer code_max, code_devis 
double cle_max



if dw_devis.getrow() > 0 then
	
	s_libelle_devis = dw_devis.getItemString(dw_devis.getrow(), "libelle")
	code_devis = dw_devis.getItemNumber(dw_devis.getrow(), "code_devis")

	if Messagebox("CONFIRMATION",'Vous allez dupliquer le devis "' + s_libelle_devis + '".~n~nConfirmer-vous ?', Question!, YesNo!, 2)  = 1 then
	
		
		
		
		// Duplication de l'entete
		code_max = integer(get_max_code_integer_datawindow(dw_devis, "code_devis"))
		zeroi(code_max)
		code_max = code_max + 1
		
		select isnull(max(cle),0) into :cle_max from soins_prevus where code = :var_code_local ;
		
		cle_max = cle_max + 1 

		var_code_devis_local = code_max
		
		ajout_nouveau_devis = true
		dw_devis.insertrow(0)
		tot = dw_devis.rowcount()
		dw_devis.SetItem( tot , "code", var_code_local)
		dw_devis.SetItem( tot , "code_devis", code_max)
		dw_devis.SetItem( tot , "date", today())
		dw_devis.SetItem( tot , "Libelle", "Copie de " + s_libelle_devis )
		dw_devis.AcceptText ()
		
		
		IF dw_devis.update() = 1 THEN
			COMMIT ;
			
			// Duplication des lignes

			INSERT INTO "soins_prevus" ("cle","code","type","numero","date_demande","scp_demande","hn","total","tp","date_accord","scp_accord", "date_impr", "user_modif","date_modif" , "code_association", "code_devis", "dent", "exo", "remboursement_exceptionnel")
			SELECT "soins_prevus"."cle" + :cle_max, :var_code_local, "soins_prevus"."type","soins_prevus"."numero","soins_prevus"."date_demande","soins_prevus"."scp_demande","soins_prevus"."hn","soins_prevus"."total",
			"soins_prevus"."tp","soins_prevus"."date_accord","soins_prevus"."scp_accord" , "soins_prevus"."date_impr", "soins_prevus"."user_modif","soins_prevus"."date_modif" , "soins_prevus"."code_association" , :code_max , "dent", "exo", "remboursement_exceptionnel"
			FROM "soins_prevus" 
			WHERE "soins_prevus"."code" = :var_code_local  and code_devis = :code_devis    ;
		
			if sqlca.sqlcode = 0 then 
				commit ;
				
				// Duplication des échéances 
				
				INSERT INTO "ligne_soins_prevus" ("cle","code", "date", "montant", "tp", "origine_tp", "non_prelevement")
				SELECT "ligne_soins_prevus"."cle" + :cle_max, :var_code_local , "ligne_soins_prevus"."date", "ligne_soins_prevus"."montant", "ligne_soins_prevus"."tp", "ligne_soins_prevus"."origine_tp", "ligne_soins_prevus"."non_prelevement"
				from "ligne_soins_prevus" , "soins_prevus" 
				where "soins_prevus"."code" = :var_code_local and "soins_prevus"."code_devis" = :code_devis and "soins_prevus"."cle" = "ligne_soins_prevus"."cle" and "soins_prevus"."code" = "ligne_soins_prevus"."code"  ;
			
				
				if sqlca.sqlcode = 0 then 
					commit ;
				else
					Messagebox("ATTENTION", "Erreur N°3 dans la duplication du devis : ~n~n" + sqlca.sqlerrtext )
					rollback ;
				end if
							
			else
				
				Messagebox("ATTENTION", "Erreur N°2 dans la duplication du devis : ~n~n" + sqlca.sqlerrtext )
				rollback ;
				
			end if
			
			// repositionnement pour actualiser affichage
			ajout_nouveau_devis = false
			dw_devis.SelectRow(0,False)
			dw_devis.SelectRow(tot ,True)
			dw_devis.SetRow ( tot )

			
		ELSE
			Messagebox("ATTENTION", "Erreur N°1 dans la duplication du devis : ~n~n" + sqlca.sqlerrtext )
			ROLLBACK ;
		END IF	
		
	end if
end if


end event

type dw_devis from datawindow within tabpage_soins_prevus
string tag = "brush no resizeall  "
integer x = 59
integer y = 28
integer width = 2007
integer height = 664
integer taborder = 50
string title = "Complément du soin"
string dataobject = "dw_devis_liste"
boolean vscrollbar = true
boolean livescroll = true
end type

event clicked;If row > 0 Then
	This.SelectRow(0,False)
	This.SelectRow(row,True)
	This.setrow(row)
End If

end event

event rowfocuschanged;if not ajout_nouveau_devis then
	accepttext()
end if

if currentrow > 0 and rowcount() > 1 then
	var_code_devis_local = tab_1.tabpage_soins_prevus.dw_devis.GetItemNumber(currentrow, "code_devis")
	dw_soins_prevus.retrieve(var_code_local, var_code_devis_local)

else
	if rowcount() = 0 then
		var_code_devis_local = 0
	end if
end if

end event

event retrieveend;//if rowcount = 1 then
//	var_code_devis_local = tab_1.tabpage_soins_prevus.dw_devis.GetItemNumber(rowcount, "code_devis")
//	dw_soins_prevus.retrieve(var_code_local, var_code_devis_local)
//end if


if tab_1.tabpage_soins_prevus.dw_devis.rowcount() > 0 then
	var_code_devis_local = tab_1.tabpage_soins_prevus.dw_devis.GetItemNumber(tab_1.tabpage_soins_prevus.dw_devis.rowcount(), "code_devis")
	// On se positionne sur le plus récent
	tab_1.tabpage_soins_prevus.dw_devis.ScrollToRow(tab_1.tabpage_soins_prevus.dw_devis.rowcount())
	tab_1.tabpage_soins_prevus.dw_devis.SelectRow(0,False)
	tab_1.tabpage_soins_prevus.dw_devis.SelectRow(tab_1.tabpage_soins_prevus.dw_devis.rowcount(),True)
	tab_1.tabpage_soins_prevus.dw_devis.setrow(tab_1.tabpage_soins_prevus.dw_devis.rowcount())
	dw_soins_prevus.retrieve(var_code_local, var_code_devis_local)
else
	var_code_devis_local = 0
end if

end event

event itemchanged;dw_devis.accepttext()

// quand on ajoute, faut pas forcé l'update tant que valeurs pas initilisées
if not ajout_nouveau_devis then

	// Enregistrement automatique
	IF dw_devis.update() = 1 THEN
		COMMIT ;
	ELSE
		ROLLBACK ;
	END IF	
end if


end event

