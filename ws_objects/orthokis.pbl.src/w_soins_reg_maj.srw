event dragdrop;// Transfert dans les soins toutes les lignes sélectionnées qui n'ont pas encore été transférées

long	nb_lignes				// Nombre de lignes de soins
long   nb_lignes_transfert	// Nombre de lignes EFFECTIVEMENT transférées
long cpt							// Compteur de lignes en cours


long cle_max					// clef maximale du patient dans les soins
long cle_prevu					// clef du soin prévu courant 
decimal {2} v_hn

string v_motif, v_type


nb_lignes_transfert = 0
nb_lignes = dw_soins_prevus.rowcount()


for cpt = 1 to nb_lignes
	
	if dw_soins_prevus.IsSelected(cpt) then
		// Si la ligne est sélectionnnée
		if dw_soins_prevus.getitemString(cpt,"soins_prevus_transfert") <> 'O' then
			// Si la ligne n'a pas déjà été transférée
			
			// Recherche de la clef maximale dans les soins du patient
			cle_max = 0
			SELECT Max(cle) INTO :cle_max FROM "soins" WHERE code = :var_code_local ;
		
				if isnull(cle_max) then
					cle_max = 1
				else
					cle_max = cle_max + 1
				end if

			// Soin en cours 
			cle_prevu = dw_soins_prevus.getitemNumber(cpt,"cle")
			
			integer v_scp_demande
			string v_lettre
			
			SELECT "type", "scp_demande" into :v_type, :v_scp_demande 
			FROM "soins_prevus"  WHERE "code" = :var_code_local and "cle" = :cle_prevu ;
			
			select lettre into :v_lettre from "code_soins" where code = :v_type ;
			
			// Dépassement ?
			SELECT isnull("hn",0) into :v_hn 
				FROM "soins_prevus" 
				WHERE "code" = :var_code_local and "cle" = :cle_prevu ;
				
			if v_hn > 0 then 
				v_motif = motif_depassement(var_code_local, v_type)
			else
				v_motif = ""
			end if
			
			// Insertion du soins ....
			
			// Exo 3 pour les TO 45 et TO >= 60
			if CCVITALE and(v_scp_demande = 45 or v_scp_demande >=60 ) and (v_lettre = 'TO' or v_lettre = 'ORT') then
				INSERT INTO "soins" ("cle","code","type","numero","date_demande","scp_demande","hn","total","tp","date_accord","scp_accord", "date_impr", "date_exe","user_modif","date_modif", "motif_depassement", "exo")
				SELECT :cle_max,"code","type","numero","date_demande","scp_demande","hn","total","tp","date_accord","scp_accord" , "date_impr", (select dateadd (month, "code_soins"."duree", "soins_prevus"."date_demande") from "code_soins" where "code_soins"."code" = "soins_prevus"."type" ), "user_modif","date_modif" , :v_motif, '3'
				FROM "soins_prevus" 
				WHERE "code" = :var_code_local and "cle" = :cle_prevu ;
			else	
				INSERT INTO "soins" ("cle","code","type","numero","date_demande","scp_demande","hn","total","tp","date_accord","scp_accord", "date_impr", "date_exe","user_modif","date_modif", "motif_depassement")
				SELECT :cle_max,"code","type","numero","date_demande","scp_demande","hn","total","tp","date_accord","scp_accord" , "date_impr", (select dateadd (month, "code_soins"."duree","soins_prevus"."date_demande") from "code_soins" where "code_soins"."code" = "soins_prevus"."type" ), "user_modif","date_modif" , :v_motif
				FROM "soins_prevus" 
				WHERE "code" = :var_code_local and "cle" = :cle_prevu ;
			end if
				
			
			if sqlca.sqlcode <> 0 then
				// Problème 
				rollback ;
				MessageBox("ATTENTION !", "Erreur transfert de soin !~n~n"+sqlca.sqlerrText)
			else
				// L'ajout du soin est OK ...
				
				// Insertion des lignes
				INSERT INTO "ligne_soins" ("cle","code","date","montant","tp","origine_tp")
				SELECT :cle_max,"code","date","montant","tp","origine_tp" FROM "ligne_soins_prevus" 
				WHERE "code" = :var_code_local and "cle" = :cle_prevu ;

				if sqlca.sqlcode <> 0 then
					// Problème 
					rollback ;
					MessageBox("ATTENTION !", "Erreur transfert de ligne de soin !~n~n"+sqlca.sqlerrText)
				else
					// Les 2 insert sont ok
					
					// Mise à jour des soins _pévrus ... zone TRANSFERT
					UPDATE "soins_prevus" SET transfert = 'O' WHERE "code" = :var_code_local and "cle" = :cle_prevu ;
					
					commit ;
					nb_lignes_transfert = nb_lignes_transfert + 1
				end if
			end if
		end if
	end if
	
Next

if nb_lignes_transfert = 0 then
	Messagebox("ATTENTION","Aucune ligne n'a été transférée !")
else
	dw_soins_prevus.retrieve(var_code_local)
	if nb_lignes_transfert = 1 then
		MessageBox("FIN DU TRANSFERT","1 Ligne a été transférée.")
	else
		MessageBox("FIN DU TRANSFERT",string(nb_lignes_transfert)+" Lignes ont été transférées.")
	end if
	
	// On bascule dans les soins
	dw_soins.retrieve(var_code_local)
	type_gestion = "S"
	maj_selon_module(type_gestion)
	tab_1.selectTab(2)
end if

end event

