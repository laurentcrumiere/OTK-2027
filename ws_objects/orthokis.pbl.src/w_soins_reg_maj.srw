type pb_supprimer_devis from uo_picturebutton_390x120 within tabpage_soins_prevus
integer x = 425
integer y = 724
integer width = 315
integer taborder = 400
string text = "-"
string tiptext = "Suppression d~'un devis"
end type

event clicked;call super::clicked;
integer code_max
boolean v_suite 
string v_message

if dw_devis.rowcount() > 0 then

	if dw_soins_prevus.rowcount() > 0 then
		if dw_soins_prevus.rowcount() = 1 then
			v_message = "Ce devis contient une ligne qui sera supprimée définitivement." 		
		else
			v_message = "Ce devis contient " + string(dw_soins_prevus.rowcount())+ " lignes qui seront supprimées définitivement."
		end if
				
		if messageBox("ATTENTION !", v_message + "~n~nConfirmez-vous ?", Question!, Yesno!, 2) = 1 then
			v_suite = true
		else
			v_suite = false
		end if 
	else
		v_suite = true
	end if
	
	if v_suite then 
		dw_devis.DeleteRow(dw_devis.Getrow())
		IF dw_devis.update() = 1 THEN
			COMMIT ;
			
			var_code_devis_local = 0
			
			If dw_devis.rowcount() > 0 Then
				dw_devis.SelectRow(0,False)
				dw_devis.SelectRow(dw_devis.Getrow() ,True)
				dw_devis.SetRow ( dw_devis.Getrow() )
				var_code_devis_local = dw_devis.getitemNumber( dw_devis.Getrow(), "code_devis")
			End If
			
			dw_soins_prevus.retrieve(var_code_local, var_code_devis_local)
			
		ELSE
			ROLLBACK ;
		END IF	
	end if
end if


end event

type pb_ajouter_devis from uo_picturebutton_390x120 within tabpage_soins_prevus
integer x = 69
integer y = 724
integer width = 315
integer taborder = 400
string text = "+"
string tiptext = "Ajout d~'un devis"
end type

event clicked;call super::clicked;
integer code_max
long tot


if dw_devis.rowcount() > 0 then
	code_max = integer(get_max_code_integer_datawindow(dw_devis, "code_devis"))
else
	code_max = 0
end if

zeroi(code_max)

code_max = code_max + 1

var_code_devis_local = code_max

ajout_nouveau_devis = true
dw_devis.insertrow(0)
tot = dw_devis.rowcount()
dw_devis.SetItem( tot , "code", var_code_local)
dw_devis.SetItem( tot , "code_devis", code_max)
dw_devis.SetItem( tot , "date", today())
dw_devis.SetItem( tot , "Libelle", 'Devis N°'+string(code_max))
dw_devis.AcceptText ()


IF dw_devis.update() = 1 THEN
	COMMIT ;
ELSE
	ROLLBACK ;
END IF	

ajout_nouveau_devis = false

If tot > 0 Then
	dw_devis.SelectRow(0,False)
	dw_devis.SelectRow(tot ,True)
	dw_devis.SetRow ( tot )
End If

end event

