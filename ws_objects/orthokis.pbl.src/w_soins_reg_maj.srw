		//		tab_1.tabpage_reglements.cb_ajouter_reglement.enabled = false
				tab_1.tabpage_reglements.cb_supprimer_reglement.enabled ( false)
		end choose
		// pour rester cohérent avec les droits des lignes de soins
		droits_user_boutons_soins()

		// pour l'impression de la Feuille de Soins
	
		dw_recto.settransobject(sqlca)
		dw_verso.settransobject(sqlca)

		
end choose



// Il faut absolument que les 2 Datawindows des soins soit au top
//dw_soins_prevus.bringtotop = dw_soins_prevus.visible
//dw_soins.bringtotop = dw_soins.visible
//
//	messagebox("sortie", "Visible : " + string(newmenu.m_soins.m_imprimerrecto.visible))

uo_on_top()




end subroutine

public subroutine droits_user_boutons_soins ();choose case droits_acces[11]
	Case 'N','C'	// Pas d'accés ou en Consultation seulement
		cb_ajouter.enabled ( false )
		cb_bis.enabled ( false )
		cb_bis2.enabled ( false )
		cb_supprimer.enabled ( false )
		cb_modifier.enabled ( false )
		cb_auto.enabled ( false )
		cb_qualite.enabled ( false )
		tab_1.tabpage_soins.cb_enregistrer_impr.enabled ( false )
		
	Case 'M'	// Modification
		cb_ajouter.enabled ( true )
		cb_bis.enabled ( true )
		cb_bis2.enabled ( true )
		cb_supprimer.enabled ( false )
		cb_modifier.enabled ( true )
		cb_auto.enabled ( true )
		cb_qualite.enabled ( true )
	Case 'T'	// total
		cb_ajouter.enabled ( true )
		cb_bis.enabled ( true )
		cb_bis2.enabled ( true )
		cb_supprimer.enabled ( true )
		cb_modifier.enabled ( true )
		cb_auto.enabled ( true )
		cb_qualite.enabled ( true )
end choose

end subroutine

public subroutine uo_on_top ();
uo_icones.bringtotop = true
//uo_anni.bringtotop = true
//uo_due.bringtotop = true
//uo_confidentiel.bringtotop = true
//uo_parente.bringtotop = true

end subroutine

public subroutine positionnement_soin_en_cours ();
// Positionnement de la datawindows des soins sur le soin en cours


// On se met sur le soin le plus proche en date
integer l

// On recherche ici en marche arrière
// On se positionne sur le dernier soin car Il faut bouger sinon ....
dw_soins.Scrolltorow(9999)

l = dw_soins.Find("date_demande <= today()",9999,1)

if l > 0 then
	dw_soins.Scrolltorow(l)
else
	dw_soins.Scrolltorow(9999)
end if
dw_soins.setfocus()



if dw_soins.rowcount() > 0 then
		// positionnement sur le dernier règlement du soin
	tab_1.tabpage_reglements.dw_reglements.Scrolltorow(9999)

	tab_1.tabpage_reglements.dw_reglements.SelectRow(0,False)

	if tab_1.tabpage_reglements.dw_reglements.rowcount() > 0 then
		tab_1.tabpage_reglements.dw_reglements.Setrow(tab_1.tabpage_reglements.dw_reglements.rowcount())
	end if
end if



return


end subroutine

public subroutine insertion_soins (double cle_soin_ajoute);// Test si le soin ajouté peut impliquer un décalage des soins suivants
// Si oui ... question et décalage ...
//-------------------------------------------------------------------------------

date v_date_ajout
string v_type_ajout
integer v_duree_ajout, v_cpt_ajout, v_ligne_ajout

 
if type_gestion = 'S' or type_gestion = 'R' then 
	
	
	// Recherche des infos sur le soin ajouté
	select "soins"."date_demande" , "soins"."type", "code_soins"."duree" 
	into :v_date_ajout, :v_type_ajout, :v_duree_ajout
	from soins, code_soins 
	where "soins"."type" = "code_soins"."code" and soins.code = :var_code_local and soins.cle = :cle_soin_ajoute ;
	
	if v_duree_ajout > 0 and France then
		// le soin ajouté à une durée => on va peut être devoir décaler la suite
		
		// Est ce qu'il y a des soins suivants qui ont des durées => décalables ?
		select isnull(count(*),0) into :v_cpt_ajout 
		from soins , code_soins
		where "soins"."type" = "code_soins"."code" and soins.code = :var_code_local and soins.cle <> :cle_soin_ajoute and soins.date_demande >= :v_date_ajout and code_soins.duree > 0 ;
		
		if v_cpt_ajout > 0 then 
			
			if Messagebox("ATENTION !","Voulez-vous décaler automatiquement les soins suivants ?",Question!, Yesno!, 2) = 1 then
				
				// On va décaler les soins suivants ...
				

				// Positionnement de la DW sur la ligne  
				dw_soins.retrieve(var_code_local)
				v_ligne_ajout = dw_soins.find("date_demande >= date('"+ string(v_date_ajout)+"') and cle <> "+string(cle_soin_ajoute),1,99999)
									
				if v_ligne_ajout > 0 then
				
					// pour identifier la fenêtre dans le menu
					dw_click = dw_soins
					w_click_soins_reg = this
					dw_soins.ScrollToRow(v_ligne_ajout)
					dw_soins.SetRow(v_ligne_ajout)
					type_menu = 'S'
					newmenu.decalage_partiel( 'T' , false, cle_soin_ajoute )
						
				end if
			end if
		end if
	end if
end if
end subroutine

public function boolean verif_si_deja_fs (datawindow dw_1);
// Permet de détecté si un ou des actes sélectionnés ont déjà fait l'objet d'une FS ou d'une FSE
// Renvoie true si oui

// Utile pour tester selon le droit du user !!

boolean v_retour
long lig, ligtot


v_retour = false

ligtot = dw_1.rowcount()

for lig = 1 to ligtot
	if dw_1.getitemstring(lig,"fse") = 'O' and ( dw_1.getitemstring(lig,"soins_fse_edite") = 'V' or dw_1.getitemstring(lig,"soins_fse_edite") = 'M')  then
			v_retour = true
	end if
next


return v_retour

end function

public subroutine lancer_fse ();// Depuis la version 10, l'ordre de tri de la dw_soins (dw_soins) a changé
// Pour être sur que les FDO de code "Z" soit après, 
//            - on trie la DW AVANT
//            - on remet le tri 


// Pour plus de Sécurité le code TELEVITALE et le code CCVITALE sont séparés ... pas mal de chose en commun mais code dupliqué

Boolean Carte


// Fichier de transmission entre TELEVITALE et PWO
string fic_tele
string fic_tele_bis				// servira à préparer le fichier à transfer à TV .. on le copiera ensuite dans fic_tele
integer num_file

// porteur CPS
string porteur_cps

// infos patient
double id_patient							// Id_patient envoyé à Télévitale
integer id_retour							// Id_patient renvoyé parTélévitale
string nom_patient,prenom_patient	// Nom et Prénom du patient
string nom_praticien, v_code_praticien_patient, v_code_praticien_soin
date dn_patient								// Date de naissance
date dt_patient								// Date de début de traitement
String dv_patient							// Date de naissance vitale

str_soins Soins_tele	 					// Structure qui sert à passer des paramètres à la fenêtre
												// de saisie du N° d'appareil radio

String appareil_cabinet					// Appareil de radio du cabinet
String appareil_soin						// Appareil de radio saisi pour chaque soin RADIO

// Actes
integer lig,ligtot,code_ep,cpt
string code_soin,renouv,lib_acte,lettre, v_nature
date date_ep,date_dem,date_acc,date_exe
decimal{2} scp_dem,hn
decimal{6} valeur_lettre
double  code_patient, cle_soin

date date_prescription
boolean v_suite = true
	
	

cadre_facture = ""

// Si pas de soins sélectionné ... on prend le soin courant
if dw_soins.find("fse = 'O'",0,dw_soins.rowcount()) = 0  and dw_soins.rowcount() > 0 then
	dw_soins.SetItem(dw_soins.getrow(), "fse", "O")
end if

if dw_soins.find("fse = 'O'",0,dw_soins.rowcount()) > 0 then
	
	ligtot = dw_soins.rowcount()
	
	// 1ère verif pour ceux qui n'ont pas le droit de refaire des FS
	if not multi_fs_autorise then 
		if verif_si_deja_fs(dw_soins) then
				v_suite = false
		end if
	end  if
	
	if not v_suite then
		Messagebox("ATTENTION","Au moins un des soins sélectionnés a déjà fait l'objet d'une Feuille de Soin. Vous devez le désélectionner pour poursuivre.")
	else

		
		// Pour repérer le cadre et pour vérifier les dates d'exécution remplies ou pas !!
		Boolean soin_caisse = false
		Boolean soin_mutuelle = false
		Boolean ok_dimanche = true
		string cadre_soin = ''
		string or_tp 
		boolean 	cadre_remboursement_ok = true
		boolean 	date_exe_ok = true
		boolean  praticien_ok = true
		
		// Pour repérer les déja facturées
		integer nb	// Compteur pour savoir si facturé ou pas
		string code_soin_fact ,lettre_fact, fs_necessaire
		decimal{2} scp_dem_fact , montant_fact
		date date_exe_fact
		date	ld_date_exec_recup

		// Pour détecter les factures sur 2001 et sur 2002
		boolean soin_2001, soin_2002, soin_2001_et_2002, soin_avant_2000

		
		long ligne_courante
		ligne_courante = dw_soins.getrow()
		
		// Pour parcourir les lignes de soins
		DECLARE cur_tp CURSOR FOR SELECT origine_tp FROM "ligne_soins" 
		WHERE code = :code_patient AND cle = :cle_soin ;
		
		
		
		if CCVITALE then
			
			trace("========== Début Vérification CC Vitale  ============")

			integer v_acte_ccam	= 0	// Utile pour CC Vitale
			
			////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
			
			// on trie sur date + code de soins
			// les soins NGAP doivent être en premiers, CCAM en second
				
			// Recherche des éléments du Patient
			  SELECT "patient"."identifiant_televitale",
							"patient"."date_naissance",   
							"patient"."code_praticien",   
							"patient"."date_naissance_vitale"
						 INTO :id_patient, 
								:dn_patient,   
								:v_code_praticien_patient,
								:dv_patient
						 FROM "patient"  
						WHERE "patient"."code" = :var_code_local   ;

			// recherche du praticien du soin
			cle_soin  = dw_soins.getitemNumber(ligne_courante, "cle")
			select code_praticien into :v_code_praticien_soin from soins where code = :var_code_local and cle = :cle_soin ;
			

			if not isnull(v_code_praticien_soin) then
				v_code_praticien_fs = v_code_praticien_soin
			else
				v_code_praticien_fs = v_code_praticien_patient
			end if
				
			
			
			if serial = "87001" or SERIAL = "88005" or SERIAL = "88036" then
				// On trie dans l'ordre de saisie ... cle !! car sinon ça pine sur 1 test de l'agrément CNDA
				dw_soins.setsort("date_demande asc, cle asc")
			else
				// Trie sur le code soin pour bien mettre les FDO après
				// 17/01/2024 : dw_soins.setsort("code_soins_nature desc, date_demande, code_soins_code")
				// 29/05/2024 : dw_soins.setsort("soins_date_exe, code_soins_code")
				// Depuis build 32.00 on fait un tri pour mettre les FDO APRES les Semestres, quelque soit leur code 
				id_retour = dw_soins.setsort("soins_date_exe, tri_fse, code_soins_code")
			end if
			id_retour = dw_soins.sort()
		
		
					
			if isnull(id_patient) then
				id_patient = 0
			end if
			if isnull(prenom_patient) then
				prenom_patient = ''
			end if

			if isnull(dn_patient) and (isnull(dv_patient) or len(trim(dv_patient))=0) then
				MessageBox("ATTENTION","Ce patient n'a pas de date de naissance dans sa fiche~n~nL'accès au module " + logiciel_vitale + " ne peut avoir lieu !")
				var_suite = false
			else
			
			
				cpt = 1
		
				soin_2001 = false
				soin_2002 = false
				soin_2001_et_2002 = false
				ok_dimanche = true
				
				// Pour CCVITALE , est ce qu'on a une part complémentaire - Vaudra 0 ou 1
				integer part_complementaire = 0
				
				// Idem pour part obligatoire pour CCVITALE
				integer part_obligatoire = 0
				
				for lig = 1 to ligtot

									
					Trace ("Ligne : " + string(lig) + "/" + string(ligtot) )


					if dw_soins.getitemstring(lig,"fse") = 'O' and cadre_remboursement_ok and date_exe_ok and not soin_2001_et_2002 and ok_dimanche and praticien_ok then
						// Ligne de soins
						code_patient = dw_soins.getitemnumber(lig,"soins_code")
						cle_soin 		 = dw_soins.getitemnumber(lig,"cle")
						date_exe 	 = dw_soins.getitemdate(lig,"soins_date_exe")
						v_code_praticien_soin = dw_soins.getitemString(lig, "soins_code_praticien")
						
						
						if isnull(v_code_praticien_soin) then
							// pas de praticien spécif .. faut que le praticien de la FS soit celui du patient
							if v_code_praticien_fs <> v_code_praticien_patient then
								praticien_ok = false
							end if
						else
							// Praticien spécif .. 
							if v_code_praticien_soin <> v_code_praticien_fs then
								praticien_ok = false
							end if
						end if
							
						if not praticien_ok then
							
							Messagebox("ATTENTION", "Les actes sélectionnés ne sont pas tous du même praticien. Vous ne pouvez pas les inclure dans la même feuille de soins.")
							
						end if
						/////////////////////////////////////////////////////////////////////////////////////////////
						// on récup à la volée (ds la table soins)la date d'exec
						// -> pour prendre en cpt sans refermer la fenêtre des rglts si des modifs ds gestion soins
						
						select date_exe into :ld_date_exec_recup from soins where code = :code_patient AND cle = :cle_soin ;
						
						// si pas de pb lors du select -> maj de la date d'exec
						if SQLCA.SQLCODE = 0 then dw_soins.SetItem(lig, "soins_date_exe", ld_date_exec_recup)
						
						/////////////////////////////////////////////////////////////////////////////////////////////
						code_soin_fact = dw_soins.getitemstring(lig,"code_soins_code")
						// Recherche des caractéristiques du soin
						SELECT "lettre" , "nature", isnull("fs", 'O') INTO :lettre_fact, :v_nature, :fs_necessaire
						FROM "code_soins" WHERE code = :code_soin_fact ;
						
						if v_nature = 'C' then
							v_acte_ccam = 1
						end if
						
					
						// On verifie si feuille de soin nécessaire
						if fs_necessaire = "N" then
							MessageBox("ATTENTION !","Le type de soin " + dw_soins.getitemstring(lig,"code_soins_nom") + " ne nécessite pas de Feuille de soins !~n~nIl est retiré de la facture !")
							dw_soins.setitem(lig,"fse",'N' )
						end if
					
						
						if dw_soins.getitemstring(lig,"soins_fse_edite") = "M" or dw_soins.getitemstring(lig,"soins_fse_edite") = "V"    then
							date_dem = dw_soins.getitemdate(lig,"date_demande")
							scp_dem_fact = dw_soins.getitemnumber(lig,"scp_demande")
							date_exe_fact = dw_soins.getitemdate(lig,"soins_date_exe")
							montant_fact = dw_soins.getitemnumber(lig,"total")
								
							
							// Le soin a été facturé ... on le mentionne ... c'est tout !
							if MessageBox("ATTENTION !","L'acte "+lettre_fact+" "+string(scp_dem_fact)+" du "+string(date_exe_fact,'dd/mm/yyyy')+" pour "+string(montant_fact)+" € a déjà été facturé !~n~nVoulez-vous le retirer de la facture ?",Question!,YesNo!,2) = 1 then
								// L'utilisateur veut retirer l'acte
								dw_soins.setitem(lig,"fse",'N' )
							end if
						end if
						
						soin_caisse = false
						soin_mutuelle = false
						
						// Si la date d'exécution du soin est nulle => On empêche d'aller plus loin
						// (On mettra, dans les soins, la date d'exécution par défaut pour les actes non soumis à entente)
						If isnull(date_exe) then
							MessageBox("ATTENTION !","Au moins un des actes sélectionné n'a pas de date d'exécution !")
							date_exe_ok = false
						else
							
							// Vérification du Dimanche remise en place en 31.00k
							if daynumber(date_exe) = 1 then
								if MessageBox("ATTENTION !","Un soin est en date du "+string(date_exe)+" (date d'exécution) : c'est un dimanche (il pourra y avoir une majoration dans " + logiciel_vitale + ")~n~nConfirmez-vous ?", Question!,YesNo!,2)  = 2 then
									ok_dimanche = false
								end if
							end if

							// On vérifie sur la date_exe est un jour férié (plus un dimanche depuis V2015)
							if ok_dimanche then
								if jour_ferie(date_exe) then
									if MessageBox("ATTENTION !","Un soin est en date du "+string(date_exe)+" (date d'exécution) : c'est un jour férié (il pourra y avoir une majoration dans " + logiciel_vitale + ")~n~nConfirmez-vous ?", Question!,YesNo!,2)  = 2 then
										ok_dimanche = false
									end if
								end if
							end if
												
							// Vérification s'il y a des soins sur 2001 et 2002 (CDC 1.31)
							if year(date_exe) = 2001 then
								soin_2001 = true
							else
								if year(date_exe) = 2002 then
									soin_2002 = true
								end if
							end if
		
							if soin_2001 and soin_2002 then
								soin_2001_et_2002 = true
								MessageBox("ATTENTION !","Vous avez sélectionné des soins de 2001 ou des soins de 2002. Ceci n'est pas autorisé dans la même facture. Veuillez décocher certains soins !")
							end if
							
							
							code_soin_fact = dw_soins.getitemstring(lig,"code_soins_code")
							date_dem = dw_soins.getitemdate(lig,"date_demande")
							scp_dem_fact = dw_soins.getitemnumber(lig,"scp_demande")
							date_exe_fact = dw_soins.getitemdate(lig,"soins_date_exe")
							montant_fact = dw_soins.getitemnumber(lig,"total")
								
							// Recherche des caractéristiques du soin
							SELECT "lettre" 	INTO :lettre_fact 	FROM "code_soins" WHERE code = :code_soin_fact ;

							if year(date_exe) < 2000 then
								soin_avant_2000 = true
								MessageBox("ATTENTION !","Vous avez sélectionné au moins un soins ayant une date d'exécution antérieure à 2000 : ~n~n"+ lettre_fact+" "+string(scp_dem_fact)+" du "+string(date_dem,'dd/mm/yyyy') +" exécuté le " + string(date_exe)+".~n~nVeuillez corriger avant de poursuivre  !")
							end if

							// La date d'exe est OK
							OPEN cur_tp ;		
							FETCH cur_tp INTO :or_tp ;
							DO WHILE SQLCA.SQLCODE = 0 
								if not(isnull(or_tp)) then
									if or_tp = 'C' then
										soin_caisse = True
									else
										if or_tp = 'M' then
											soin_mutuelle = True
										end if	
									end if
								end if
								FETCH cur_tp INTO :or_tp ;
							loop
							CLOSE cur_tp ;
							
							// Fin du parcours du soins => Détermination du cadre du soin 
							if not soin_caisse and not soin_mutuelle then
								// Tout est payé par le patient
								Cadre_soin = '1'
							else
								if soin_caisse and not soin_mutuelle then
									// Une partie est payé par la caisse ... rien par la mutuelle
									Cadre_soin = '2'
									part_obligatoire = 1
								else
									if soin_caisse and soin_mutuelle then
										// Une partie est payé par la caisse ... une autre par la mutuelle
										Cadre_soin = '3'
										part_obligatoire = 1
										part_complementaire = 1
									else
										// Une partie est payée par la mutuelle ... rien par la caisse
										Cadre_soin = '4'
										part_complementaire = 1
									end if
								end if
							end if
			
						end if // Si date nulle 
					end if // Soin de la FSE
				next
				
				Trace ("Fin parcours des verifs")


				
				if cadre_remboursement_ok and ok_dimanche and cadre_remboursement_ok and date_exe_ok and dw_soins.find("fse = 'O'",0,dw_soins.rowcount()) > 0 and not soin_2001_et_2002 and not soin_avant_2000 then		// Début du transfert effectif des données
					// On peut y aller !!!!!	
					
					if CCVITALE then
						param_win[1] = "3"
						param_win[2] = string(part_obligatoire)
						param_win[3] = string(part_complementaire)
						param_win[6] = string(v_acte_ccam)
						Trace("ouverture de w_cc_vitale")
						OpenWithParm (w_cc_vitale, cette_fenetre)
					end if
				end if // Fin cadre de remboursment OK
			end if // fin du si les dates de naissance sont bonnes
	
			// On remet le bon ordre de tri
			dw_soins.setsort(dw_soins_tri_initial)
			dw_soins.sort()
			dw_soins.retrieve(var_code_local)
			
			// repositionnement sur la ligne courante AVANT ....
			if ligne_courante > 0 then
				dw_soins.setrow(ligne_courante)
				dw_soins.scrolltorow(ligne_courante)
			end if
			
			
			
			
			////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
			
			
		
		end if

end if // Fin du test

else
	MessageBox("ATTENTION","Vous devez sélectionner un soin avant de réaliser une FSE.")
end if


end subroutine

public subroutine ehealth (string action_demandee);// e Attest ou tarification
// Paramètre en entrée
// - A pour attestation
// - T pour tarification
// - D pour duplication de l'eAttest (plus utilisée)


long lig, tot
string s_input_reference, s_numero_fse
double v_cle
date l_date
time l_heure
integer i_cpt_efface = 0

tot =  dw_soins.rowcount()
if tot > 0 then
	string v_liste_soins = ""
	
	// pour la duplicatio de l'eAttest, on n'a besoin que de la ligne courant pour récupérer le N° stocké dans numero_fse 
	
	if action_demandee  ="D" then
		
		// On se position sur la 1ère ligne sélectionnée
		if dw_soins.find("fse = 'O'",0,tot) = 0 then
			// pas de soins coché => On coche la ligne courante
			dw_soins.setItem(dw_soins.getrow(), "fse", "O")
		end if
		
		s_input_reference = dw_soins.GetItemString(dw_soins.getrow(), "soins_numero_fse")
		
	else
		
		// recherche des lignes de soins
		if dw_soins.find("fse = 'O'",0,tot) = 0 then
			// pas de soins coché => On coche la ligne courante
			dw_soins.setItem(dw_soins.getrow(), "fse", "O")
		end if
		
		for lig = 1 to tot
			if trim(v_liste_soins) <> "" then 
				v_liste_soins = v_liste_soins + ","
			end if
			
			v_cle = dw_soins.GetItemNumber(lig, "cle")
			
			if dw_soins.GetItemString(lig, "fse") = "O" then
				v_liste_soins = v_liste_soins + string(v_cle)
			end if
			
			// pour chaque ligne on vérfiei si pas déjà eu une eAtteste qui a échouée
			// Numéro FSE contient dans la dfate et l'heure de l'essai : 20231109 090020 
			// Si > à 30 minutes, on efface l'information 
			
			if string_non_nulle(trim(dw_soins.GetItemString(lig, "soins_numero_fse"))) <> "" and string_non_nulle(trim(dw_soins.GetItemstring(lig, "soins_fse_edite"))) = ""  then 
				
				s_numero_fse = dw_soins.GetItemString(lig, "soins_numero_fse")
				
				l_date = date(left(s_numero_fse, 4)+"/"+mid(s_numero_fse, 5,2)+"/"+mid(s_numero_fse, 7,2))
				l_heure = time(mid(s_numero_fse, 9,2) + ":" + mid(s_numero_fse, 11,2)+ ":" + mid(s_numero_fse, 13,2) )
				
				if ( l_date < today() ) or     ( l_date = today() and SecondsAfter ( l_heure, now())  > 1800  ) then
					// On efface 
					dw_soins.setItem(lig, "soins_numero_fse", "")
					update soins set numero_fse = null where code = :var_code_local and cle = :v_cle ;
					commit ;
					
					i_cpt_efface = i_cpt_efface + 1 
				end if 
			end if
		next
		
		if i_cpt_efface > 0 then
			
			messagebox("ATTENTION !", "Des tentatives précédentes d'eAttest ont été effacées sur " + string(i_cpt_efface)  + " ligne(s)." )
			
		end if
 	end if
	
	string url_wb, url_myo
	
	//open(w_patience_locale)
	
	// myo ?
	select top 1 url_my_orthokis into :url_myo from param ;
	
	// Construction de l'URL complète
	
	choose case action_demandee
		case "T" 
			url_wb = url_myo + "myorthokis/app/tarif/index.html?code="+string(var_code_local) + "&soins="  + v_liste_soins
		case "A"
			url_wb = url_myo + "myorthokis/app/attest/index.html?code="+string(var_code_local) + "&soins="  + v_liste_soins + "&user="  + utilisateur_code
		case "D"
			url_wb = url_myo + "myorthokis/app/attest/index.html?code="+string(var_code_local) + "&soins=1&user="  + utilisateur_code+"&inputReference=" + s_input_reference
	end choose
	
	
	//run('cmd /C start "e-Attest" "' + url_wb +'"')
	openurl ( url_wb )	
	
	//close(w_patience_locale)
end if
end subroutine

public subroutine imprimer_soins (date date_debut, character monnaie, datastore dw, string destination);// IMPRESSION DES SOINS DU PATIENT A PARTIR D'UNE DATE DONNEE
// Appelée par :
//  - Bouton IMPRIMER avec '01/01/1900' en argument
//  - Menu accessible avec le bouton droit sur les soins avec la date de demande du soin en cours

// - La variable monnaie doit être 'E' ou 'F' : monnaie d'impression

// - dw pour imprimer les soins ou les soins prévus

// - destination : I pour imprimante, E pour email 


string entete, baspage,cade,cadbp
double cpt

if type_gestion = 'R' then
	// reglements : on peut ou pas masquer le mode
	if dw.DataObject = "" then 
		dw.DataObject = "dw_reglements_edition"
		dw.settransobject(SQLCA)
	end if 
	if reg_avec_mode then
		dw.retrieve(var_code_local,date_debut,1, monnaie)
	else
		dw.retrieve(var_code_local,date_debut,0, monnaie)
	end if
else
	if type_gestion = 'S' then
		// soins normaux
		if dw.DataObject = "" then 
			dw.DataObject = "dw_soins_edition"
			dw.settransobject(SQLCA)
		end if 
		dw.retrieve(var_code_local,date_debut,monnaie)
	else
		// soins prevus
		if dw.DataObject = "" then 
			dw.DataObject = "dw_soins_prevus_edition"
			dw.settransobject(SQLCA)
		end if 
		dw.retrieve(var_code_local,date_debut,monnaie, var_code_devis_local)
	end if
end if

if dw.rowcount() = 0 then
	son(5)
	MessageBox("ATTENTION !","Aucun soin n'a été saisi !")
else
	
	
		// Entête, bas de page et signature
	
		entete = dw.GetItemString(dw.GetRow(),"prati_entete")
		baspage = dw.GetItemString(dw.GetRow(),"prati_bas_page")
		rte_1.insertdocument(entete, False, FileTypeRichText!)
		rte_1.SelectTextAll ()
		entete = rte_1.CopyRtf( )
		
		rte_1.insertdocument(baspage, False, FileTypeRichText!)
		rte_1.SelectTextAll ()
		baspage = rte_1.CopyRtf( )
	
		for cpt = 1 to dw.rowcount()
			dw.SetItem(cpt,"prati_entete",entete)
			dw.SetItem(cpt,"prati_bas_page",baspage)
		next
		
		dw.object.p_signature.FileName = dw.GetItemString(1, "prati_chemin_complet_signature")
		
//		// Cadrage de l'entête et du bas de page
//		// (Le visible ou non visible est fait automatiquement dans la Dw)
//	
//		SELECT "edition_entete_cadrage", "edition_baspage_cadrage" INTO :cade, :cadbp 
//		FROM "param" ;
//		
//		dw.Modify("prati_entete.alignment = '"+cade+"'")
//		dw.Modify("prati_bas_page.alignment = '"+cadbp+"'")
	
	
	if type_gestion = 'P' then
		// soins prévus
		if suisse then
			// On efface les zones inutiles
			dw_edition.Modify("demande_t.visible = 0")
			dw_edition.Modify("lettre_t.visible = 0")
			dw_edition.Modify("base_t.visible = 0")
			dw_edition.Modify("hn_t.visible = 0")
			dw_edition.Modify("tp_t.visible = 0")
			dw_edition.Modify("compute_hn.visible = 0")	
			dw_edition.Modify("compute_monnaie_hn.visible = 0")	
		end if
		
	else
		// soins ou règlements
		if suisse then
			// On efface les zones inutiles
			dw_edition.Modify("demande_t.visible = 0")
			dw_edition.Modify("lettre_t.visible = 0")
			dw_edition.Modify("date_accord_t.visible = 0")
			dw_edition.Modify("base_t.visible = 0")
			dw_edition.Modify("hn_t.visible = 0")
			dw_edition.Modify("tp_t.visible = 0")
			dw_edition.Modify("compute_hn.visible = 0")	
		end if
		
	end if
	
	if destination = "I" then
		// Impression directe
		dw.print()
	
		if type_gestion = 'P'  or  type_gestion = 'S'  then
			ajout_histo_editions(var_code_local,"DOSSOI",today(),"")
		else
			ajout_histo_editions(var_code_local,"DOSCOM",today(),"Format Complet")
		end if
	else
		// PDF puis email
		string s_rep_photos_patient, v_fichier_destination,v_fichier_destination_complet, v_code_edition
		datawindow ldw_courriers
		long ligtot
		
		s_rep_photos_patient = dir_photos + string( var_code_local )
		if not fileexists( s_rep_photos_patient ) then gfx_creer_rep( s_rep_photos_patient )
		v_fichier_destination =  string(today(), "yyyy-mm-dd")+" "+string(now(), "hh-mm-ss")
		choose case type_gestion 
			case "P"
				v_fichier_destination =  v_fichier_destination +  " - Soins Prévisionnels.pdf"
				v_code_edition = "DOSSOI"
			case "S"
				v_fichier_destination =  v_fichier_destination +  " - Soins.pdf"
				v_code_edition = "DOSSOI"
			case "R"
				v_fichier_destination =  v_fichier_destination +  " - Règlements.pdf"
				v_code_edition = "DOSCOM"
		end choose
		
		v_fichier_destination_complet = s_rep_photos_patient + win_delimiter + v_fichier_destination
		
		dw.saveas(v_fichier_destination_complet, PDF!, false)
		
		
		if not fileExists(v_fichier_destination_complet) then
			Messagebox("ATTENTION", "Impossible de générer le fichier : " + v_fichier_destination_complet)
		else
				
			integer categorie_nulle
			setnull(categorie_nulle)
			fxg_enregcourrierhisto ( var_code_local, v_code_edition , today() ,"Pour envoi par email" , v_fichier_destination_complet , 'E', 'N' , 'N', "", categorie_nulle)
			
			ldw_courriers = create datawindow
			ldw_courriers = w_mdi_2020.dw_patient_courriers

			ldw_courriers.settransobject(sqlca)
			ldw_courriers.retrieve(var_code_local, "E")
			ldw_courriers.setfilter("historique_editions_nom_courrier = '" + v_fichier_destination + "'" )
			ldw_courriers.filter()
			ligtot = ldw_courriers.rowcount()
			if  ligtot > 0 then
				ldw_courriers.SetItem(1, "Selection", 'O')					
				m_btdroit_historique		Menu
				Menu = CREATE m_btdroit_historique
				Menu.dw_locale = ldw_courriers
				Menu.var_code_local = var_code_local
				
				Menu.m_envoyerparemailpiècejointe.TriggerEvent(clicked!)
				
			end if				
		end if
	end if
end if
end subroutine

public subroutine imprimer_recu ();
trace(". Début fonction imprimer_recu()")
Datastore dw_donnees

dw_donnees = CREATE DataStore
dw_donnees.DataObject = "dw_lettre_recu"

dw_donnees.SetTransObject(SQLCA)

decimal {2} montant_total_reglements, montant_total_soins, montant_recu, montant_total_hn

montant_total_soins = dec(param_win[1])
montant_total_reglements = dec(param_win[2])
montant_recu = dec(param_win[3])
montant_total_hn = dec(param_win[5])

dw_donnees.Retrieve(v_code_regl,v_cle_regl,v_date,v_mon,v_mode,v_comment)

if dw_donnees.rowcount() > 0 then
	// Mise à jour des champs calculés par ailleurs
	
	dw_donnees.setitem(dw_donnees.getrow(), "paye_total",montant_total_reglements)
	dw_donnees.setitem(dw_donnees.getrow(), "soins_total",montant_total_soins)
	dw_donnees.setitem(dw_donnees.getrow(), "paye_montant",montant_recu)
	dw_donnees.setitem(dw_donnees.getrow(), "code_soins_nom",param_win[4])
	dw_donnees.setitem(dw_donnees.getrow(), "remboursement", montant_total_soins - montant_total_hn)
	
end if

// pour n'imprimer qu'une pasge si plusieurs règlements !
// Depuis 2018
integer v_cpt

for v_cpt = dw_donnees.rowcount() to 2 step -1
	dw_donnees.deleterow(v_cpt)
next 
////////////////////////////////////////////////////////

uo_edition_rtf uo_edition
openuserobject(uo_edition)
uo_edition.visible = false


if profilestring(dir_ini+inifile_orthokis,"admini","recu_pdf","N") = "O" then 
	Trace(". Impression en PDF")
	// impression en PDF
	string rep_phot_patient, v_fichier_destination,v_fichier_destination_complet, v_fichier_pdf
	rep_phot_patient = dir_photos + string( v_code_regl )
	if not fileexists( rep_phot_patient ) then gfx_creer_rep( rep_phot_patient )

	v_fichier_destination =  string(today(), "yyyy-mm-dd")+" "+string(now(), "hh-mm-ss")+ " - Recu.pdf"
	v_fichier_destination_complet = rep_phot_patient + win_delimiter + v_fichier_destination
	uo_edition.edition(dw_donnees,"lettre_recu", false, v_fichier_destination_complet )
else
	Trace(". Impression  Normale")
	// impression normale
	uo_edition.edition(dw_donnees,"lettre_recu", false, "" )
end if


string symbole

if monnaie_base = 'F' then
	symbole = symbole_franc
else
	symbole = symbole_euro
end if


if profilestring(dir_ini+inifile_orthokis,"admini","recu_pdf","N") = "O" then 
	
	Trace(". Mémo impression en PDF")
	// Mémo du PDF
	string v_libelle 
	long lig, ligtot
	v_libelle = "Montant : "+string(montant_recu,"#,##0.00")+" "+symbole
	integer categorie_nulle
	setnull(categorie_nulle)
	fxg_enregcourrierhisto ( v_code_regl, "RECREG" , today() ,v_libelle , v_fichier_destination , 'E', 'N' , 'N', "", categorie_nulle)
	
	if Messagebox("QUESTION","Souhaitez-vous envoyer ce reçu par email ?", Question!, YesNo!, 1) = 1 then
		// on enchaine par l'envoi de l'email
		Trace(". Envoi par Mail")
		
		// Par sécurité en reprend le code de la fênetre Administrative, clic droits dans les documents !
		dw_courriers.settransobject(sqlca)
		dw_courriers.retrieve(v_code_regl, "E")
		dw_courriers.setfilter("historique_editions_nom_courrier = '" + v_fichier_destination + "'" )
		dw_courriers.filter()
		ligtot = dw_courriers.rowcount()
		if  ligtot > 0 then
			dw_courriers.SetItem(1, "Selection", 'O')					
			m_btdroit_historique		Menu
			Menu = CREATE m_btdroit_historique
			Menu.dw_locale = dw_courriers
			Menu.var_code_local = v_code_regl
			
			Menu.m_envoyerparemailpiècejointe.TriggerEvent(clicked!)
			
		end if
	end if
else
	Trace(". Mémo Impression en normal")
	// impression normale .. pas PDF
	ajout_histo_editions(v_code_regl,"RECREG",today(),"Montant : "+string(montant_recu,"#,##0.00")+" "+symbole)
end if

Destroy dw_donnees

trace(". fin fonction imprimer_recu()")


end subroutine

event open;call super::open;// param_win[2]
// On passe en paramètre si on veut un resize automatique ou pas
// OUI = 1 en mode normal
// NON = 0 en mode MDI patient pour éciter 3 Resize

//param_win[1]
// On rentre pourquoi ???
// P : soins prévus
// S : soins
// R : reglements


//param_win[3]
// On vient d'ou ?
// R : rendez-vous pour un nouveau patient => pas de fenêtre mère valide (pour la mise à jour des icones)
// M : menu

// Dans quel module

  
Try 
	
	// on ouvre w_patience_locale à chaque fois sinon ça pine
	// Why ???
	
	open(w_patience_locale)

	trace("============ DEBUT OPEN SOINS / REGLEMENTS ============ ")
	
	type_gestion = param_win[1]		// Soucis avec le passage de paramètre entre windows .... why ???
	resize_automatique = integer(param_win[2])
	
	
	// on crée un menu pour le bouton droit sur les reglement
	newmenu_reglt = CREATE m_btdroit_reglements

	// on crée un menu pour le bouton droit sur les soins
	newmenu = CREATE m_orthosoins

	// zone qui sert aux sélections ..
	update table_vide set v1 = 'N' ;
	commit ;
	
//	Trace("Création des Datastores d'édition")
	// Création des DW d'impression avec assignation des DataObject
	dw_edition = create datastore
	dw_edition_reglements = create datastore
	dw_edition_soins_prevus = create datastore
	

	dw_recto = create datawindow
	dw_recto = w_mdi_2020.dw_recto
	dw_verso = create datawindow
	dw_verso = w_mdi_2020.dw_verso
	
	
	// L'affectation des Dataobject est LONG ! On ne le fera qu'au fur est à mesure des fonctionnalités
//	Trace("Affectations des dw")
//	dw_recto.DataObject = "dw_renouvellement_recto_nvelle"
//	dw_verso.DataObject = "dw_renouvellement_verso_2_nvelle"
//	dw_edition.DataObject = "dw_soins_edition"
//	dw_edition_reglements.DataObject = "dw_reglements_edition"
//	dw_edition_soins_prevus.DataObject = "dw_soins_prevus_edition"
//
//	Trace("Fin de la déclaration des Datastore")
	
	tab_1.tabpage_soins_prevus.cbx_detail.visible = true
	
	if CCVITALE then 
		logiciel_vitale = "CC-Vitale"
	else
		logiciel_vitale = ""
	end if

			
	dw_reg.settransobject(sqlca)


	
	
	// Initialisation des tailles des objets des onglets 
	tab[1] = tab_1.tabpage_soins_prevus.cb_selection
	tab[2] = tab_1.tabpage_soins_prevus.cb_deselection
	tab[3] = tab_1.tabpage_soins_prevus.cb_transfert
	
	tab[4] = tab_1.tabpage_soins.dw_impression
	tab[5] = tab_1.tabpage_soins.cb_annuler_impr
	tab[6] = tab_1.tabpage_soins.cb_enregistrer_impr
	
	tab[7] = tab_1.tabpage_reglements.dw_reglements
	tab[8] = tab_1.tabpage_reglements.cb_ajouter_reglement
	tab[9] = tab_1.tabpage_reglements.cb_supprimer_reglement
	tab[10] = tab_1.tabpage_reglements.cb_modifier_reglement
	tab[11] = tab_1.tabpage_reglements.cb_recu
	tab[12] = tab_1.tabpage_reglements.cb_fse
	tab[13] = tab_1.tabpage_reglements.cb_facture
	tab[14] = tab_1.tabpage_reglements.cb_debit
	tab[15] = tab_1.tabpage_reglements.cb_bis_reglement
	tab[16] = tab_1.tabpage_reglements.cb_efact
	
	
	date date_tt
	
	var_code_local = var_code
	var_nom_local = var_nom
	var_numero_dossier_local = var_numero_dossier

	
	dw_prochain_rdv.settransobject(sqlca)
	dw_prochain_rdv.retrieve(var_code_local)

	

	
	// Mise à jour des icones
	if param_win[3] = "R" then
		// trop chiant de récupérer la fenêtre mère ... on rend les icones invisible ... il se réactualiseront si besoin
		//uo_icones.maj(var_code_local, this,  w_mdi_patient)
		uo_icones.visible = false
	else
		uo_icones.maj(var_code_local, this,  parentWindow())
	end if
	
	
	// Alerte confidentielle ?
	uo_icones.uo_confid.verif_alertes(var_code_local, 'SR')
	
	
	// recherche des valeurs par défaut
	SELECT "patient"."debut_traitement"  , "mode_reglement_habituel"
		 INTO :date_tt , :v_mode_reglement
		 FROM "patient"  
		WHERE "patient"."code" = :var_code_local   ;
	
	// Bouton spécial si prélèvement pour POITEL / WAGNER
	if v_mode_reglement = "R"  then
		cb_prelevement_patient.visible = true
	end if
	
	w_patience_locale.Wf_SetValue(20)
	

	// dw_spécial pour CC Vitale ou la Belgique
	
	if BELGIQUE  then
		dw_soins.dataobject = "dw_soins"
		tab_1.tabpage_soins.dw_impression.dataobject = "dw_detail_soin_impression_efact_belgique"
		tab_1.tabpage_soins.dw_impression.width = 3730
		tab_1.tabpage_reglements.cb_efact.visible = true
		tab_1.tabpage_reglements.cb_pid.visible = false
				
		
	else
		tab_1.tabpage_reglements.cb_efact.visible = false
		
		if LUXEMBOURG  then 
			// Gestion du PID
			tab_1.tabpage_reglements.cb_pid.visible = true
		else
			tab_1.tabpage_reglements.cb_pid.visible = false
		end if
		
		if CCVITALE then
			string s_version_ccvitale 
			s_version_ccvitale = fxg_get_version_ccvitale()
			if  s_version_ccvitale >= "4.40" then
				tab_1.tabpage_soins.dw_impression.dataobject = "dw_detail_soin_impression_ccvitale_440"
			else
				tab_1.tabpage_soins.dw_impression.dataobject = "dw_detail_soin_impression_ccvitale"
				if s_version_ccvitale >= "4.10" then
					// supression du dénombrement
					tab_1.tabpage_soins.dw_impression.modify("denombrement.visible = 0")
					tab_1.tabpage_soins.dw_impression.modify("t_denombrement.visible = 0")
				end if
			end if
			
		else
			if luxembourg then 
				tab_1.tabpage_soins.dw_impression.dataobject = "dw_detail_soin_impression_luxembourg"
			else
				tab_1.tabpage_soins.dw_impression.dataobject = "dw_detail_soin_impression"
			end if

		end if
	end if
	
	
	dw_detail.settransobject(SQLCA)
	dw_soins.settransobject(SQLCA)
	
	// tri intial - On se sert d'une constant pour plus de sécurité !
	dw_soins.setSort(dw_soins_tri_initial)
	dw_soins.sort()
	
	tab_1.tabpage_soins_prevus.dw_devis.settransobject(SQLCA)
	tab_1.tabpage_soins.dw_impression.settransobject(SQLCA)
	tab_1.tabpage_reglements.dw_reglements.settransobject(SQLCA)

	dw_soins_prevus.settransobject(SQLCA)
	dw_detail_soins_prevus.settransobject(SQLCA)
	

	// Modification du terme "Dépassement"
	dw_soins.modify("hn_t.text = '"+libelle_depassement+"'")
	dw_edition.modify("hn_t.text = '"+libelle_depassement+"'")
	
	
	// Gestion spéciale des modes de règlement
	if not reg_avec_mode then
		tab_1.tabpage_reglements.dw_reglements.Modify("mode_t.visible = 0")
		tab_1.tabpage_reglements.dw_reglements.Modify("mode_reglement_nom.visible = 0")
		
		// idem dans la datawindow d'impression : on passera dw_reglements_edition en paramètres
	
	end if
	
	// Vérification de SESAM VITALE
	if FRANCE then
		if not CCVITALE or droits_acces[13] = 'N' then
			tab_1.tabpage_reglements.cb_fse.enabled ( false )
		else
			tab_1.tabpage_reglements.cb_fse.enabled ( true )
			tab_1.tabpage_soins.dw_impression.Modify("b_qualif.visible = 1")
		end if
	else
		// Pays étranger 
		tab_1.tabpage_reglements.cb_fse.enabled ( true )
	end if
	
	if APPEL_VISIODENT then
		tab_1.tabpage_reglements.cb_fse.visible = false 
		tab_1.tabpage_reglements.pb_visiodent.x = tab_1.tabpage_reglements.cb_fse.x
		tab_1.tabpage_reglements.pb_visiodent.y = tab_1.tabpage_reglements.cb_fse.y
		tab_1.tabpage_reglements.pb_visiodent.visible = true
	else
		tab_1.tabpage_reglements.pb_visiodent.visible = false
	end if

	
	

	
	if belgique then
		// on supprime les référence à la sécu
		dw_soins.modify("t_base.text = '~nTarif de Base' ")
		dw_soins.modify("fs_t.Text = 'Att.'")
		dw_soins.modify("soins_fse_edite.visible = 0")
		dw_soins.modify("attestation_belgique.visible = 1")
		dw_soins.modify("soins_fse_edite.visible = 0")
		
		dw_soins.modify("facture.visible = 0")
		dw_soins.modify("efacture.visible = 1")
		
		dw_soins.modify("date_accord_t.visible = 0")
		dw_soins.modify("demande_t.visible = 0")
		
		// Idem soins prévis
		dw_soins_prevus.modify("demande_t.visible = 0")
		dw_soins_prevus.modify("t_base.text = '~nTarif Base' ")
		dw_soins_prevus.modify("date_accord_t.visible = 0")
		
		// plus de bouton FSE
		//tab_1.tabpage_reglements.cb_fse.visible = false
		// 2021 => E-Attestation
		tab_1.tabpage_reglements.cb_fse.text = "e-Attest."
		tab_1.tabpage_reglements.cb_fse.tiptext = "Attestation Electronique"
		
		// Facture devient Attestation
		tab_1.tabpage_reglements.cb_facture.text = "Att. Papier"
		tab_1.tabpage_reglements.cb_facture.tiptext = "Attestation papier" 
//		tab_1.tabpage_soins.dw_impression.object.date_rapport_t.visible = false
//		tab_1.tabpage_soins.dw_impression.object.date_rapport.visible = false
//		tab_1.tabpage_soins.dw_impression.object.b_date_rapport.visible = false
		
		// redimensionnement des boutons 
		tab_1.tabpage_reglements.cb_recu.width = tab_1.tabpage_reglements.cb_justif.width
		tab_1.tabpage_reglements.cb_fse.width = tab_1.tabpage_reglements.cb_justif.width
		tab_1.tabpage_reglements.cb_facture.width = tab_1.tabpage_reglements.cb_justif.width
		tab_1.tabpage_reglements.cb_fse.width = tab_1.tabpage_reglements.cb_justif.width
		tab_1.tabpage_reglements.cb_debit.width = tab_1.tabpage_reglements.cb_justif.width
		tab_1.tabpage_reglements.cb_justif.visible = true
		
		// Annulation de justification au lieu d'annulation d'une feuille de soins
		newmenu.m_soins.m_annulationfeuilledesoins.text = "Annulation du Justificatif de soins"

		// POUR AFFICHAGE DANS LA dw_impression
		v_pays = "B"
	else
		if luxembourg then
			// on supprime les référence à la sécu
			dw_soins.modify("fs_t.visible = 0")
			dw_soins.modify("soins_fse_edite.visible = 0")
			tab_1.tabpage_soins.dw_impression.object.date_rapport_t.visible = false
			tab_1.tabpage_soins.dw_impression.object.date_rapport.visible = false


			tab_1.tabpage_soins.dw_impression.object.b_motif_depassement.visible = false
			tab_1.tabpage_soins.dw_impression.object.soins_code_association.visible = false
			tab_1.tabpage_soins.dw_impression.object.t_soins_code_association.visible = false

			tab_1.tabpage_soins.dw_impression.object.motif_depassement.visible = false
			tab_1.tabpage_soins.dw_impression.object.t_motif_depassement.visible = false

			tab_1.tabpage_soins.dw_impression.object.soins_dent.width = 200
			tab_1.tabpage_soins.dw_impression.object.b_schema.visible = false
			
			
			//tab_1.tabpage_soins.dw_impression.object.facture.visible = false
			tab_1.tabpage_reglements.cb_fse.visible = false
			
			dw_soins.object.pid.visible = 1 
			dw_soins.object.fs_t.text = "eM."
			dw_soins.object.fs_t.visible = 1
			
			tab_1.tabpage_soins.dw_impression.object.soins_code_association.visible = true

			tab_1.tabpage_soins.dw_impression.object.t_soins_code_association.visible = true
			tab_1.tabpage_soins.dw_impression.object.t_soins_code_association.text = "Suffixe :"
		
			// POUR AFFICHAGE DANS LA dw_impression ... en principe masqué mais ..
			v_pays = "L"
	
		else
			// POUR AFFICHAGE DANS LA dw_impression
			// France
			v_pays = "F"
		end if
	end if
	
	if belgique then // date d'accord 
		dw_soins.modify("accord.visible = 0")
	else
		// Affichage date d'accord
		string val_par_defaut
		if luxembourg then
			val_par_defaut = "O" 
		else
			val_par_defaut = "N" 
		end if 
		
		if profilestring(dir_ini+inifile_orthokis,"admini","afficher_date_accord",val_par_defaut) = "O" then 
			dw_soins.modify("accord.visible = 1")
		else
			dw_soins.modify("accord.visible = 0")
		end if
	end if
	
	// Retrieve des soins
	dw_soins.retrieve(var_code_local)

	
	tab_1.tabpage_soins_prevus.dw_devis.retrieve(var_code_local)
	// Les soins prevus de chargent selon le devis	
	//dw_soins_prevus.retrieve(var_code_local)
	
	if tab_1.tabpage_soins_prevus.dw_devis.rowcount() > 0 then
		var_code_devis_local = tab_1.tabpage_soins_prevus.dw_devis.GetItemNumber(tab_1.tabpage_soins_prevus.dw_devis.rowcount(), "code_devis")
		// On se positionne sur le plus récent
		tab_1.tabpage_soins_prevus.dw_devis.ScrollToRow(tab_1.tabpage_soins_prevus.dw_devis.rowcount())
		tab_1.tabpage_soins_prevus.dw_devis.SelectRow(0,False)
		tab_1.tabpage_soins_prevus.dw_devis.SelectRow(tab_1.tabpage_soins_prevus.dw_devis.rowcount(),True)
		tab_1.tabpage_soins_prevus.dw_devis.setrow(tab_1.tabpage_soins_prevus.dw_devis.rowcount())
	else
		var_code_devis_local = 0
	end if
	
	
	w_patience_locale.Wf_SetValue(40)
	
	//h.chp()	//vérif la présence de la clef HASP
	
	uo_size.taille(this)
	
	
	// Il faut absolument que les 2 Datawindows des soins soit au top
	
	dw_soins.bringtotop = true
	dw_soins_prevus.bringtotop = true
	
	
	maj_selon_module(type_gestion)
	
	string nom_soin
	
	
	w_patience_locale.Wf_SetValue(60)
	
		
	w_click_soins_reg = this
	
	// droits utilisateurs
	tab_1.tabpage_soins_prevus.enabled = m_orthokis_2020.m_patients.m_soinsprevus.enabled
	tab_1.tabpage_soins.enabled = m_orthokis_2020.m_patients.m_soins.enabled
	tab_1.tabpage_reglements.enabled = m_orthokis_2020.m_patients.m_reglements.enabled
	
	// Recherche autorisation dans la table des users
	string v_multi_fs
	
	select reglt_multi_fs into :v_multi_fs from utilisateurs where code = :utilisateur_code ; 
	
	if v_multi_fs = 'O' then
		multi_fs_autorise = true
	else
		multi_fs_autorise = false
	end if 
	
	// Special 2008
	//placer_image_fond(this, p_fond, image_fond_fenetre)
	
	// Dans le resize depuis 2012
	//maj_barre_patient(var_code_local, st_couleur, st_nom, st_cmu, st_code, st_praticien, this)

	
	close(w_patience_locale)
	
	
	// coloration des DW
	colore_datawindow(Tab_1.tabpage_soins_prevus.dw_devis)
	colore_datawindow(Tab_1.tabpage_reglements.dw_reglements)
	colore_datawindow(Tab_1.tabpage_soins.dw_impression)
	
	Tab_1.tabpage_soins_prevus.BackColor = couleur_fond_fenetre
	Tab_1.tabpage_soins.BackColor = couleur_fond_fenetre
	Tab_1.tabpage_reglements.BackColor = couleur_fond_fenetre
	
	// pour passage de paramètre avec TV
	cette_fenetre = this
	
	if enregistrement_automatique then
		tab_1.tabpage_soins.cb_enregistrer_impr.visible = false
		tab_1.tabpage_soins.cb_annuler_impr.visible = false
	end if
	
	if  MON_ORTHODONTISTE or TEA  then
		uo_mon_orthodontiste.visible = true
		if MON_ORTHODONTISTE then
			uo_mon_orthodontiste.init(var_code_local, "PP")
		else
			uo_mon_orthodontiste.init(var_code_local, "R")
			uo_mon_orthodontiste.pb_1.width = uo_mon_orthodontiste.width
			uo_mon_orthodontiste.pb_1.height = uo_mon_orthodontiste.height
		end if
	end if
	trace("============ FIN OPEN SOINS / REGLEMENTS ============ ")


Catch (RuntimeError er)
	
	Messagebox("ERREUR INATTENDUE","Une erreur inattendue s'est produite.~nLa fenêtre n'a pas pu s'ouvrir normalement.~n~nNous vous conseillons de fermer puis rouvrir le dossier.~n~nEléments Techniques pour ARAKIS :~n~nClasse : " + er.class +"~nRoutine : "+er.RoutineName + "~nLigne : " + string(er.line) + "~nTexte : "  + er.text )
	
	
End Try



end event

on w_soins_reg_maj.create
int iCurrent
call super::create
this.cb_trait=create cb_trait
this.cb_dep=create cb_dep
this.cb_autre=create cb_autre
this.cb_imprimer=create cb_imprimer
this.cb_modifier=create cb_modifier
this.cb_supprimer=create cb_supprimer
this.cb_bis=create cb_bis
this.cb_ajouter=create cb_ajouter
this.uo_size=create uo_size
this.rte_1=create rte_1
this.tab_1=create tab_1
this.uo_titre_soins_prevus=create uo_titre_soins_prevus
this.uo_titre_echeances=create uo_titre_echeances
this.st_couleur=create st_couleur
this.dw_detail=create dw_detail
this.dw_detail_soins_prevus=create dw_detail_soins_prevus
