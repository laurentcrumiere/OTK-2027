type variables
decimal {2} prix_scp,prix_cons,prix_radio
char action 	// A pour Ajout, M pour Modif
double cle_manip,var_code_local,hn_def,tp_def, var_numero_dossier_local
string type_soin,ancien_soin,var_nom_local
boolean modif_echeance_direct 	// pour ne pas modifier le début du soin mais que les échéances
decimal {2} nb_lettre, depasse
decimal {6} valeur


boolean soin_saisi_ccam = false


integer var_code_devis_local 	// devis courant - sélectionné


string v_code_praticien_fs		// servira aussi à la fenêtre w_soins_reg_televitale appelée
// pour position la liste des soins ...
string chaine_saisie_liste_soins = ""
// pour passage de paramètres à TV
w_soins_reg_maj cette_fenetre


// pour le cadre de remboursement
string cadre_facture = ''

// menu clic droit des soins et reglements
m_orthosoins newmenu
m_btdroit_reglements newmenu_reglt

// pour impression FS ou DEP intégrée
boolean impression_integre = false

// Module : vaudra P, S ou R
string type_gestion

// Pour les impression
datastore dw_edition, dw_edition_reglements, dw_edition_soins_prevus
datawindow dw_recto, dw_verso

// Pour le resize à l'intérieur des onglets
any tab[]



// pour affichage dans la dw_impression
string v_pays


// POur la mémorisation des infos dans la dw_impression ... et ne le faire qu'une fois par modif
boolean first_modif

// Pour savoir si on peut modifier un soin ... sera utile pour le double clic sur les échéances ... si le soin est transféré ou pas
boolean modif_ok

integer resize_automatique

boolean multi_fs_autorise			// pour savoir si l'utilisateur à le droit de refaire des FS plusieurs fois ...

boolean ajout_nouveau_devis

// Pour gérer l'afficage de p_sepa et autres
string v_mode_reglement

string logiciel_vitale

// Pour avoir notre propre fenetre de patience
w_patience w_patience_locale

boolean b_premier_resize = true		// pour pas faire le 1er mais que le second qui correpond à l'ajustement dans le mdi

constant string dw_soins_tri_initial = 	"date_demande, date_ligne, code_soins_nom, numero"

uo_barre_traitement uo_traitement

// PID Luxemnourg
long il_dernier_numero_memoire
boolean ib_correction_ememoire_luxembourg = false
end variables

forward prototypes
public subroutine maj_selon_module (string module)
public subroutine droits_user_boutons_soins ()
public subroutine uo_on_top ()
public subroutine positionnement_soin_en_cours ()
public subroutine insertion_soins (double cle_soin_ajoute)
public function boolean verif_si_deja_fs (datawindow dw_1)
public subroutine lancer_fse ()
public subroutine ehealth (string action_demandee)
public subroutine imprimer_soins (date date_debut, character monnaie, datastore dw, string destination)
public subroutine imprimer_recu ()
end prototypes

public subroutine maj_selon_module (string module);
// ATTENTION
// IL Y A AUSSI LE selecttab DANS L'EVEN SHOW CAR SOUCIS DEPUIS 17.00j

// Couleur du titre des échéances
	if type_gestion = "P" then 
		uo_titre_echeances.retaille(couleur_bleue_soins, couleur_bleu_fonce , "")
	else
		uo_titre_echeances.retaille(couleur_verte_soins, couleur_vert_fonce, "")
	end if
	
	
//	messagebox("entrée", "Visible : " + string(newmenu.m_soins.m_imprimerrecto.visible))

// On active tout ce qui est actif par défaut
newmenu.m_soins.m_remplacerpar.visible = true
newmenu.m_soins.m_feuilledesoins2014rectoverso.visible = true
newmenu.m_soins.m_decalage.visible = true
newmenu.m_soins.m_decalagepartiel.visible = true

if FRANCE and profilestring(dir_ini+inifile_orthokis,"admini","masquer_decalages_menu_clic_droit","N") = "N" then 
	newmenu.m_soins.m_decalage2.visible = true
	newmenu.m_soins.m_decalage3.visible = true
	newmenu.m_soins.m_decalagepartiel2.visible = true
	newmenu.m_soins.m_decalagepartiel3.visible = true 
	newmenu.m_soins.m_-0.visible = true
	newmenu.m_soins.m_-1.visible = true
else
	newmenu.m_soins.m_decalage2.visible = false
	newmenu.m_soins.m_decalage3.visible = false
	newmenu.m_soins.m_decalagepartiel2.visible = false
	newmenu.m_soins.m_decalagepartiel3.visible = false 
	newmenu.m_soins.m_-0.visible = false
	newmenu.m_soins.m_-1.visible = false
end if



newmenu.m_soins.m_-.visible = true
newmenu.m_soins.m_trait1.visible = true
newmenu.m_soins.m_imprimersoins.visible = true
newmenu.m_soins.m_utiliseruncourrierword.visible = true
newmenu.m_soins.m_imprimerrecto.enabled = true
newmenu.m_soins.m_imprimerverso.enabled = true
newmenu.m_soins.m_imprimerrectoverso.enabled = true
newmenu.m_soins.m_imprimerrecto.visible = true
newmenu.m_soins.m_imprimerverso.visible = true
newmenu.m_soins.m_imprimerrectoverso.visible = true



// Menu spécifique ODS
newmenu.m_soins.m_2.visible = false
newmenu.m_soins.m_renvoyerlesoinaods.visible = false

// Menu spécifique LUXEMBOURG
newmenu.m_soins.m_2.visible = false
newmenu.m_soins.m_selectionnertouslessoinsdus.visible = false

// droits sur bouton Traitement
if droits_acces[10] = 'N' then 
	cb_trait.enabled ( false )
else
	cb_trait.enabled ( true )
end if



//Messagebox ("trace","Maj selon module : "+module)


// Mise à jour de l'affichage en fonction du module
choose case module
		
		
	case 'P'
		// Soins Prévus :
		//--------------------
		
		
		tab_1.selecttab(1)
		dw_soins_prevus.visible = true
		dw_soins.visible = false
		dw_detail_soins_prevus.visible = true
		dw_detail.visible = false
		uo_titre_soins.visible = false
		uo_titre_soins_prevus.visible = true
		uo_titre_echeances.visible = true
		dw_click = dw_soins_prevus
		
		// On désactive toutes les fonctions de décalage : on ne garde que les impressions
		newmenu.m_soins.m_decalage.visible = false
		newmenu.m_soins.m_decalage2.visible = false
		newmenu.m_soins.m_decalage3.visible = false
		newmenu.m_soins.m_decalagepartiel.visible = false
		newmenu.m_soins.m_decalagepartiel2.visible = false
		newmenu.m_soins.m_decalagepartiel3.visible = false
		newmenu.m_soins.m_-0.visible = false
		newmenu.m_soins.m_-1.visible = false
		newmenu.m_soins.m_-.visible = false
		newmenu.m_soins.m_trait1.visible = false
		newmenu.m_soins.m_imprimersoins.visible = false
		newmenu.m_soins.m_annulationfeuilledesoins.visible = false
		newmenu.m_soins.m_remplacerpar.visible = false
		newmenu.m_soins.m_fs2014.visible = false
		newmenu.m_soins.m_feuilledesoins2014.visible = false
		newmenu.m_soins.m_feuilledesoins2014verso.visible = false
		newmenu.m_soins.m_feuilledesoins2014rectoverso.visible = false
		newmenu.m_soins.m_fs2014.visible = false
		newmenu.m_soins.m_annulertransfertdusoin.visible = true
		newmenu.m_soins.m_ouvrirleattest.visible = false
		newmenu.m_soins.m_annulerleattest.visible = false
		newmenu.m_soins.m_duplicatadeleattest.visible = false
		newmenu.m_soins.m_inscriptioneattest.visible = false

		// Gestion des droits d'accès sur le menu ... pas de décalage en consultation
		if droits_acces[21] = 'N'  then
			// Pas autoriser à imprimer les feuilles sécu
			newmenu.m_soins.m_imprimerrecto.enabled = false 
			newmenu.m_soins.m_imprimerverso.enabled = false 
			newmenu.m_soins.m_imprimerrectoverso.enabled = false 
		end if

		
		newmenu.m_soins.m_imprimersoins.text = "Imprimer les soins à partir de ..."
		newmenu.m_soins.m_envoyerlessoinsparemailapartirde.text =  "Envoyer les soins par email a partir de ...."

		if BELGIQUE then
			// Mise à jour des libellés du menu 
			newmenu.m_soins.m_imprimerrecto.text = "Imprimer Demande d'intervention"
			newmenu.m_soins.m_imprimerverso.text = "Imprimer Annexe de la demande de prolongation"
			newmenu.m_soins.m_imprimerrectoverso.visible = false
			newmenu.m_soins.m_annulationfeuilledesoins.visible = false
		else
			// Mise à jour des libellés du menu 
			newmenu.m_soins.m_imprimerrecto.text = "Imprimer &Recto Demande Entente Préalable"
			newmenu.m_soins.m_imprimerverso.text = "Imprimer &Verso Demande Entente Préalable"
			newmenu.m_soins.m_imprimerrectoverso.text = "&Imprimer Recto / Verso Demande Entente Préalable"
		end if
		
		// pour l'impression de la DEP
	
	
		// DEP Intégrée ou non ?
		if profilestring(dir_ini+inifile_orthokis,"DEP-FSE","dep_integre", "N") = "O" then
			impression_integre = true
		else
			impression_integre = false
		end if

		if impression_integre then
			dw_recto.dataobject = "dw_renouvellement_recto_integree"
			dw_verso.dataobject = "dw_renouvellement_verso_integree"
		else
			dw_recto.dataobject = "dw_renouvellement_recto_nvelle"
			dw_verso.dataobject = "dw_renouvellement_verso_2_nvelle"
		end if
		dw_recto.settransobject(sqlca)
		dw_verso.settransobject(sqlca)

		//--------------------------------------------------------------------
		// changement du select pour les DEP .. recto et verso
		//--------------------------------------------------------------------

		
		// On modifie les SELECT des feuilles de SECU ...
		// C'est les même que celle des soins "normaux" .. on replace juste la table soins par soins.prevu !!
		
		string select_recto, select_verso
		long start_pos=1
		string old_str, new_str, mystring
		old_str = '"soins'
		new_str = '"soins_prevus'
		
		//--------- Modification du SELECT du Recto
		
		select_recto = dw_recto.Describe('datawindow.table.select')
		
		// Find the first occurrence of old_str.
		start_pos = Pos(select_recto, old_str, start_pos)
		
		// Only enter the loop if you find old_str.
		DO WHILE start_pos > 0
		// Replace old_str with new_str.
				select_recto = Replace(select_recto, start_pos, &
					Len(old_str), new_str)
				// Find the next occurrence of old_str.
				start_pos = Pos(select_recto, old_str, &
					start_pos+Len(new_str))
		LOOP

		
		dw_recto.Modify ( "DataWindow.Table.Select = '" + select_recto + "'" ) 
		
		//--------- Modification du SELECT du Verso
		
		select_verso = dw_verso.Describe('datawindow.table.select')
		
		// Find the first occurrence of old_str.
		start_pos = Pos(select_verso, old_str, start_pos)
		
		// Only enter the loop if you find old_str.
		DO WHILE start_pos > 0
		// Replace old_str with new_str.
				select_verso = Replace(select_verso, start_pos, &
					Len(old_str), new_str)
				// Find the next occurrence of old_str.
				start_pos = Pos(select_verso, old_str, &
					start_pos+Len(new_str))
		LOOP
		
		dw_verso.Modify ( "DataWindow.Table.Select = '" + select_verso + "'" ) 


		// Verrouillage selon les droits d'accès
		//-------------------------------------------
		
		choose case droits_acces[17]
			Case 'C'	// Consultation
				cb_ajouter.enabled ( false )
				cb_bis.enabled ( false )
				cb_bis2.enabled ( false )
				cb_supprimer.enabled ( false )
				cb_modifier.enabled ( false )
				cb_qualite.enabled ( false )
				cb_auto.enabled ( false)
		Case 'M'	// Modification 
				cb_ajouter.enabled ( true )
				cb_bis.enabled ( true )
				cb_bis2.enabled ( true )
				cb_supprimer.enabled ( false )
				cb_modifier.enabled ( true )
				cb_auto.enabled ( true )
				cb_qualite.enabled ( true )
			Case 'T'	// total
				cb_ajouter.enabled ( true )
				cb_bis.enabled ( true )
				cb_bis2.enabled ( true )
				cb_supprimer.enabled ( true )
				cb_modifier.enabled ( true )
				cb_auto.enabled ( true )
				cb_qualite.enabled ( true )
		end choose
		
		// Gestion du bouton de transfert en fonction des droites sur les SOINS (normaux)
		choose case droits_acces[11]
			Case 'C'
				// Consultation 
				tab_1.tabpage_soins_prevus.cb_transfert.enabled = false 
				tab_1.tabpage_soins_prevus.cb_selection.enabled = false 
				tab_1.tabpage_soins_prevus.cb_deselection.enabled = false 
			Case 'M'
				// Modification 
		//		cb_transfert.enabled ( false )
		end choose
		
	case 'S'
		
		// Soins :
		//------------

		dw_click = dw_soins
		newmenu.m_soins.m_fs2014.visible = false
		newmenu.m_soins.m_feuilledesoins2014.visible = false
		newmenu.m_soins.m_feuilledesoins2014verso.visible = false
		newmenu.m_soins.m_feuilledesoins2014rectoverso.visible = false
		newmenu.m_soins.m_annulertransfertdusoin.visible = false

		newmenu.m_soins.m_ouvrirleattest.visible = false
		newmenu.m_soins.m_annulerleattest.visible = false
		newmenu.m_soins.m_duplicatadeleattest.visible = false
		newmenu.m_soins.m_inscriptioneattest.visible = false
		
