this.lb_motif_depassement_ccvitale=create lb_motif_depassement_ccvitale
this.st_praticien=create st_praticien
this.st_nom=create st_nom
this.st_code=create st_code
this.st_cmu=create st_cmu
this.pb_questionnaires_en_attente=create pb_questionnaires_en_attente
this.pb_documents_a_signer=create pb_documents_a_signer
this.cb_auto=create cb_auto
this.dw_reg=create dw_reg
this.dw_soins=create dw_soins
this.ddlb_imprimantes=create ddlb_imprimantes
this.dw_courriers=create dw_courriers
this.dw_prochain_rdv=create dw_prochain_rdv
this.cb_prelevement_patient=create cb_prelevement_patient
this.cb_partie2=create cb_partie2
this.st_couleur3=create st_couleur3
this.st_couleur4=create st_couleur4
iCurrent=UpperBound(this.Control)
this.Control[iCurrent+1]=this.cb_trait
this.Control[iCurrent+2]=this.cb_dep
this.Control[iCurrent+3]=this.cb_autre
this.Control[iCurrent+4]=this.cb_imprimer
this.Control[iCurrent+5]=this.cb_modifier
this.Control[iCurrent+6]=this.cb_supprimer
this.Control[iCurrent+7]=this.cb_bis
this.Control[iCurrent+8]=this.cb_ajouter
this.Control[iCurrent+9]=this.uo_size
this.Control[iCurrent+10]=this.rte_1
this.Control[iCurrent+11]=this.tab_1
this.Control[iCurrent+12]=this.uo_titre_soins_prevus
this.Control[iCurrent+13]=this.uo_titre_echeances
this.Control[iCurrent+14]=this.st_couleur
this.Control[iCurrent+15]=this.dw_detail
this.Control[iCurrent+16]=this.dw_detail_soins_prevus
this.Control[iCurrent+17]=this.uo_icones
this.Control[iCurrent+18]=this.cb_qualite
this.Control[iCurrent+19]=this.cb_bis2
this.Control[iCurrent+20]=this.st_date_impr
this.Control[iCurrent+21]=this.cb_rafraichir
this.Control[iCurrent+22]=this.dw_soins_prevus
this.Control[iCurrent+23]=this.uo_titre_soins
this.Control[iCurrent+24]=this.st_couleur2
this.Control[iCurrent+25]=this.p_sepa
this.Control[iCurrent+26]=this.pb_envoi_email
this.Control[iCurrent+27]=this.st_age
this.Control[iCurrent+28]=this.uo_mon_orthodontiste
this.Control[iCurrent+29]=this.lb_motif_depassement_ccvitale
this.Control[iCurrent+30]=this.st_praticien
this.Control[iCurrent+31]=this.st_nom
this.Control[iCurrent+32]=this.st_code
this.Control[iCurrent+33]=this.st_cmu
this.Control[iCurrent+34]=this.pb_questionnaires_en_attente
this.Control[iCurrent+35]=this.pb_documents_a_signer
this.Control[iCurrent+36]=this.cb_auto
this.Control[iCurrent+37]=this.dw_reg
this.Control[iCurrent+38]=this.dw_soins
this.Control[iCurrent+39]=this.ddlb_imprimantes
this.Control[iCurrent+40]=this.dw_courriers
this.Control[iCurrent+41]=this.dw_prochain_rdv
this.Control[iCurrent+42]=this.cb_prelevement_patient
this.Control[iCurrent+43]=this.cb_partie2
this.Control[iCurrent+44]=this.st_couleur3
this.Control[iCurrent+45]=this.st_couleur4
end on

