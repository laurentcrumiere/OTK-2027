type cb_sauver from w_diagnos_maj_`cb_sauver within w_diagnos_maj_87135_1
integer x = 2322
integer y = 6192
end type

event cb_sauver::clicked;call super::clicked;// Sauvegarde de la DataWindow DEP
dw_1.accepttext()

if dw_1.update() = 1 then
                commit ;
                if sqlca.sqlcode <> 0 then
                               Messagebox("ERREUR DANS LA MISE A JOUR N°"+string(sqlca.sqlcode),sqlca.sqlerrtext)
                end if
else
                rollback ;
end if


// Sauvegarde de la DataWindow Diagnostic / Plan de traitement
dw_2.accepttext()
dw_2.setItem(1, "patient_traitement_effectue_html", dw_2.getitemString(1, "texte_brut_traitement_effectue"))
dw_2.setItem(1, "patient_plan_traitement_html", dw_2.getitemString(1, "texte_brut_plan_traitement"))

if dw_2.update() = 1 then
                commit ;
                if sqlca.sqlcode <> 0 then
                               Messagebox("ERREUR DANS LA MISE A JOUR N°"+string(sqlca.sqlcode),sqlca.sqlerrtext)
                end if
else
                rollback ;
end if

end event

