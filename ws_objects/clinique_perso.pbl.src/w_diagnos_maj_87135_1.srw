public subroutine load_ctrls ();f.lirepage(rb_profil_concave,page_buffer[1],1)
f.lirepage(rb_profil_droit,page_buffer[1],2)
f.lirepage(rb_profil_convexe,page_buffer[1],3)
f.lirepage(rb_etages_oui,page_buffer[1],4)
f.lirepage(rb_etages_augm,page_buffer[1],5)
f.lirepage(rb_etages_dimin,page_buffer[1],6)
f.lirepage(cbx_mil_d_haut,page_buffer[1],7)
f.lirepage(cbx_mil_g_haut,page_buffer[1],8)
f.lirepage(cbx_mil_d_bas,page_buffer[1],9)
f.lirepage(cbx_mil_g_bas,page_buffer[1],10)
f.lirepage(rb_ferm_norm,page_buffer[1],11)
f.lirepage(rb_ferm_proglis,page_buffer[1],12)
f.lirepage(rb_ferm_latero,page_buffer[1],13)

// Modification : les boutons radio deviennent des cases à cocher (24/09/14)
// f.lirepage(rb_atm_bonne,page_buffer[1],14)
// f.lirepage(rb_atm_craq,page_buffer[1],15)
// f.lirepage(rb_atm_claq,page_buffer[1],16)
// f.lirepage(rb_atm_doul,page_buffer[1],17)
// f.lirepage(rb_atm_mvts_lim,page_buffer[1],18)
f.lirepage(cbx_atm_bonne,page_buffer[1],14)
f.lirepage(cbx_atm_craq,page_buffer[1],15)
f.lirepage(cbx_atm_claq,page_buffer[1],16)
f.lirepage(cbx_atm_doul,page_buffer[1],17)
f.lirepage(cbx_atm_mvts_lim,page_buffer[1],18)
// Ajout des choix G/D sur ATM craquements, claquements et douloureux
f.lirepage(cbx_atm_craq_g,page_buffer[1],340)
f.lirepage(cbx_atm_craq_d,page_buffer[1],341)
f.lirepage(cbx_atm_claq_g,page_buffer[1],342)
f.lirepage(cbx_atm_claq_d,page_buffer[1],343)
f.lirepage(cbx_atm_doul_g,page_buffer[1],344)
f.lirepage(cbx_atm_doul_d,page_buffer[1],345)

f.lirepage(rb_degl_atyp_oui,page_buffer[1],19)
f.lirepage(rb_degl_atyp_non,page_buffer[1],20)
f.lirepage(rb_post_relach,page_buffer[1],21)
f.lirepage(rb_post_contract,page_buffer[1],22)
f.lirepage(rb_post_incomp,page_buffer[1],23)
f.lirepage(rb_freins_lab_sup,page_buffer[1],24)
f.lirepage(rb_freins_lab_inf,page_buffer[1],25)
f.lirepage(rb_freins_ling,page_buffer[1],26)
f.lirepage(rb_hyg_bonne,page_buffer[1],27)
f.lirepage(rb_hyg_moy,page_buffer[1],28)
f.lirepage(rb_hyg_motiv,page_buffer[1],29)
f.lirepage(rb_caries_abs,page_buffer[1],30)
f.lirepage(rb_caries_soign,page_buffer[1],31)
f.lirepage(sle_carries,page_buffer[1],32,30)
f.lirepage(sle_2,page_buffer[1],62,1)
f.lirepage(rb_traitmnt_attente,page_buffer[1],63)
f.lirepage(rb_traitmnt_traiter,page_buffer[1],64)
f.lirepage(rb_situation_motiv,page_buffer[1],65)
f.lirepage(rb_situation_reserv,page_buffer[1],66)
f.lirepage(rb_situation_indif,page_buffer[1],67)
f.lirepage(rb_plan_inter,page_buffer[1],68)
f.lirepage(rb_plan_mb,page_buffer[1],69)
f.lirepage(rb_plan_invis,page_buffer[1],70)
f.lirepage(rb_lite,page_buffer[1],71)
f.lirepage(rb_teen,page_buffer[1],72)
f.lirepage(rb_full,page_buffer[1],73)
f.lirepage(mle_plan_ttmnt,page_buffer[1],74,60)
f.lirepage(mle_focus,page_buffer[1],134,200)
f.lirepage(cbx_vivera_max,page_buffer[1],334)
f.lirepage(cbx_gco_max,page_buffer[1],335)
f.lirepage(cbx_3x3_max,page_buffer[1],336)
f.lirepage(cbx_vivera_mand,page_buffer[1],337)
f.lirepage(cbx_gco_mand,page_buffer[1],338)
f.lirepage(cbx_3x3_mand,page_buffer[1],339)

// Ajout de 2 choix dans le tableau CONTENTION / SURVEILLANCE
f.lirepage(cbx_gcs_max,page_buffer[1],346)
f.lirepage(cbx_4x4_mand,page_buffer[1],347)

// max carac = 348


// Affichage ou masquage des choix Invisalign

if rb_plan_invis.Checked then
	rb_teen.visible = true
	rb_lite.visible = true
	rb_full.visible = true
	st_24.visible = true
else
	rb_teen.visible = false
	rb_lite.visible = false
	rb_full.visible = false
	st_24.visible = false
end if


end subroutine

