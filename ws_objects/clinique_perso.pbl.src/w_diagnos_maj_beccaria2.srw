type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
string page
uo_fx_pages_cliniques f
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();string rem,pt


SELECT remarques INTO :rem FROM diagnos WHERE code = :var_code_local ;
SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;


if mid(page,1400,1) = 'O' then
	cbx_ds1.checked = true
end if
if mid(page,1401,1) = 'O' then
	cbx_ds2.checked = true
end if
if mid(page,1402,1) = 'O' then
	cbx_ds3.checked = true
end if
if mid(page,1403,1) = 'O' then
	cbx_ds4.checked = true
end if

sle_agenesie.text = RightTrim(mid(page,1404,40))
sle_surnum.text = RightTrim(mid(page,1444,40))

mle_diag_clin.text = RightTrim(mid(page,723,300))
mle_diag_cephal.text = RightTrim(mid(page,1700,200))


f.lirepage(em_date_1,page,2000,10) //à partir du 27/12/2001
f.lirepage(em_date_2,page,2010,10)
f.lirepage(em_date_3,page,2020,10)
f.lirepage(em_date_4,page,2030,10)
f.lirepage(em_date_5,page,2040,10)
f.lirepage(em_date_6,page,2050,10)
f.lirepage(em_date_7,page,2060,10)
f.lirepage(em_date_8,page,2070,10)
f.lirepage(em_date_9,page,2080,10)
f.lirepage(em_date_10,page,2090,10)
f.lirepage(em_date_11,page,2100,10)
f.lirepage(em_date_12,page,2110,10)
f.lirepage(em_date_13,page,2120,10)
f.lirepage(em_date_14,page,2130,10)
f.lirepage(em_date_15,page,2140,10)		//max carac = 2150

modif = false
cb_fermer.setfocus()
end subroutine

event open;var_code_local = message.doubleparm
string vn
date vd

select  trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vd) then
	vd = Today()
end if


this.title = "Page N°2 : "+vn+ " - Date de naissance : " + string(vd,"dd/mm/yyyy") +" - N° dossier : "+string(var_code_local)

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

init()
mep_win_mdi(this,1)

//modif sur cadre photo 12 --> il était mal nommé et donc planté : corrigé le 02/08/2001
end event

