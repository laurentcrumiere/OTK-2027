global w_diagnos_maj_liniere1 w_diagnos_maj_liniere1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false
string pt

SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;

mle_plan_traitement.text = pt

mle_ant_gene.text = Righttrim(trim(mid(page,1,250)))
mle_ant_fami.text = Righttrim(trim(mid(page,300,250)))

ddlb_respiration.selectitem(integer(mid(page,601,1)))
ddplb_deglutition.selectitem(integer(mid(page,602,1)))
ddplb_phonation.selectitem(integer(mid(page,603,1)))
if mid(page,604,1) = 'O' then
	cbx_suceur.checked = true
else
	cbx_suceur.checked = false
end if
if mid(page,605,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page,606,1) = 'O' then
	cbx_bruxisme.checked = true
else
	cbx_bruxisme.checked = false
end if

ddlb_amygdales.selectitem(integer(mid(page,607,1)))
ddlb_vegetations.selectitem(integer(mid(page,608,1)))
ddlb_langue.selectitem(integer(mid(page,609,1)))
ddplb_levres.selectitem(integer(mid(page,610,1)))
ddplb_volume.selectitem(integer(mid(page,611,1)))

if mid(page,612,1) = 'O' then
	cbx_douleur.checked = true
else
	cbx_douleur.checked = false
end if
if mid(page,613,1) = 'O' then
	cbx_craquement.checked = true
else
	cbx_craquement.checked = false
end if
if mid(page,614,1) = 'O' then
	cbx_ressaut.checked = true
else
	cbx_ressaut.checked = false
end if
ddlb_chemin.selectitem(integer(mid(page,615,1)))
ddplb_amplitude.selectitem(integer(mid(page,616,1)))

sle_prematurites.text = Righttrim(mid(page,620,30))
mle_paro.text = Righttrim(mid(page,700,150))

if mid(page,901,1) = 'O' then
	cbx_langue.checked = true
else
	cbx_langue.checked = false
end if
if mid(page,902,1) = 'O' then
	cbx_levre_sup.checked = true
else
	cbx_levre_sup.checked = false
end if
if mid(page,903,1) = 'O' then
	cbx_levre_inf.checked = true
else
	cbx_levre_inf.checked = false
end if
if mid(page,904,1) = 'O' then
	cbx_ds1.checked = true
else
	cbx_ds1.checked = false
end if
if mid(page,905,1) = 'O' then
	cbx_ds2.checked = true
else
	cbx_ds2.checked = false
end if
if mid(page,906,1) = 'O' then
	cbx_ds3.checked = true
else
	cbx_ds3.checked = false
end if
if mid(page,907,1) = 'O' then
	cbx_ds4.checked = true
else
	cbx_ds4.checked = false
end if

em_date_du_jour.text = Righttrim(mid(page,910,10))

IF mid(page,910,10) = space(10) THEN
	em_date_du_jour.text = string(today (),'dd/mm/yyyy')
END IF 



sle_position.text = RightTrim(mid(page,1000,50))
mle_diagnostic.text = RightTrim(mid(page,1050,200))

em_date_du_jour.SetFocus()
end subroutine

event open;
var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, mois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°1 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()


dw_1.settransobject(SQLCA)

dw_1.retrieve(var_code_local)

end event

