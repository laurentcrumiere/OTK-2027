event clicked;place_avec_blancs(mle_ant_gene.text,page,1,250)
place_avec_blancs(mle_ant_fami.text,page,300,250)

place(string(ddlb_respiration.FindItem(ddlb_respiration.text,1)),page,601)
place(string(ddplb_deglutition.FindItem(ddplb_deglutition.text,1)),page,602)
place(string(ddplb_phonation.FindItem(ddplb_phonation.text,1)),page,603)

if cbx_suceur.checked then
	place("O",page,604)
else
	place("N",page,604)
end if
if cbx_onychophagie.checked then
	place("O",page,605)
else
	place("N",page,605)
end if
if cbx_bruxisme.checked then
	place("O",page,606)
else
	place("N",page,606)
end if

place(string(ddlb_amygdales.FindItem(ddlb_amygdales.text,1)),page,607)
place(string(ddlb_vegetations.FindItem(ddlb_vegetations.text,1)),page,608)
place(string(ddlb_langue.FindItem(ddlb_langue.text,1)),page,609)
place(string(ddplb_levres.FindItem(ddplb_levres.text,1)),page,610)
place(string(ddplb_volume.FindItem(ddplb_volume.text,1)),page,611)


if cbx_douleur.checked then
	place("O",page,612)
else
	place("N",page,612)
end if
if cbx_craquement.checked then
	place("O",page,613)
else
	place("N",page,613)
end if
if cbx_ressaut.checked then
	place("O",page,614)
else
	place("N",page,614)
end if

place(string(ddlb_chemin.FindItem(ddlb_chemin.text,1)),page,615)
place(string(ddplb_amplitude.FindItem(ddplb_amplitude.text,1)),page,616)


place_avec_blancs(sle_prematurites.text,page,620,30)
place_avec_blancs(mle_paro.text,page,700,150)


if cbx_langue.checked then
	place("O",page,901)
else
	place("N",page,901)
end if
if cbx_levre_sup.checked then
	place("O",page,902)
else
	place("N",page,902)
end if
if cbx_levre_inf.checked then
	place("O",page,903)
else
	place("N",page,903)
end if
if cbx_ds1.checked then
	place("O",page,904)
else
	place("N",page,904)
end if
if cbx_ds2.checked then
	place("O",page,905)
else
	place("N",page,905)
end if
if cbx_ds3.checked then
	place("O",page,906)
else
	place("N",page,906)
end if
if cbx_ds4.checked then
	place("O",page,907)
else
	place("N",page,907)
end if


place_avec_blancs(em_date_du_jour.text,page,910,10)

place_avec_blancs(sle_position.text,page,1000,50)

place_avec_blancs(mle_diagnostic.text,page,1050,200)

string pt
pt = mle_plan_traitement.text
 
UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	UPDATE patient SET plan_traitement = :pt WHERE code = :var_code_local ;
	if SQLCA.Sqlcode <> 0 then
		son(4)
		Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
	else
		modif = false
		COMMIT ;
	end if
end if

end event

