//pt = mle_plan.text

UPDATE diagnos SET perso = :page  WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
	else
//	UPDATE patient SET plan_traitement = :pt WHERE code = :var_code_local ;
//	if SQLCA.Sqlcode <> 0 then
//		son(4)
//		Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
//	else
		if dw_1.update () <> 1 THEN
			son(4)
			Messagebox("ERREUR BASE DE DONNEES (N°3)",SQLCA.SqlErrText)
		else	
			if dw_2.update () <> 1 THEN
				son(4)
				Messagebox("ERREUR BASE DE DONNEES (N°4)",SQLCA.SqlErrText)
			else	
				modif = false
				COMMIT ;
			end if	
		end if	
//	end if		
end if

end event

