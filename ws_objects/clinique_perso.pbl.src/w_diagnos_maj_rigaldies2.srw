global w_diagnos_maj_rigaldies2 w_diagnos_maj_rigaldies2

type variables
double var_code_local 
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();mle_remarques.text =  trim(mid(page,845,250))
em_d1.text = trim(mid(page,1095,10))
em_d2.text = trim(mid(page,1105,10))
em_d3.text = trim(mid(page,1115,10))

mle_anal1.text = RightTrim(mid(page,1125,64))
mle_anal2.text = RightTrim(mid(page,1189,64))
mle_anal3.text = RightTrim(mid(page,1253,64))

mle_plusp2.text = RightTrim(mid(page,1317,40))
mle_moinsp2.text = RightTrim(mid(page,1357,40))

sle_cha1.text = RightTrim(mid(page,1397,4))
sle_cha2.text = RightTrim(mid(page,1401,4))
sle_cha3.text = RightTrim(mid(page,1405,4))
sle_cha4.text = RightTrim(mid(page,1409,4))
sle_cha5.text = RightTrim(mid(page,1413,4))
sle_cha6.text = RightTrim(mid(page,1417,4))

sle_chb1.text = RightTrim(mid(page,1421,4))
sle_chb2.text = RightTrim(mid(page,1425,4))
sle_chb3.text = RightTrim(mid(page,1429,4))
sle_chb4.text = RightTrim(mid(page,1433,4))
sle_chb5.text = RightTrim(mid(page,1437,4))
sle_chb6.text = RightTrim(mid(page,1441,4))



end subroutine

event open;
var_code_local = message.doubleparm

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

mep_win_mdi(this,1)
init()


end event

