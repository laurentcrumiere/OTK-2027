public subroutine load_ctrls ();string	lstr_dentiste, lstr_correspondant


// zone "dentiste traitant"
select correspondants.nom into :lstr_dentiste from correspondants, patient where correspondants.code = patient.code_dentiste AND patient.code = :var_code_local ;
if isnull(lstr_dentiste) then lstr_dentiste = ""
st_dentiste.text = lstr_dentiste

// zone "correspondant"
select correspondants.nom into :lstr_correspondant from correspondants, patient where correspondants.code = patient.code_correspondant AND patient.code = :var_code_local ;
if isnull(lstr_correspondant) then lstr_correspondant = ""
st_corres.text = " " + lstr_correspondant



f.lirepage(sle_motif_consult,page_buffer[1],1,45)
f.lirepage(sle_autre,page_buffer[1],46,45)
