table(column=(type=char(30) updatewhereclause=yes name=prati_nom_praticien dbname="prati.nom_praticien" dbalias=".nom_praticien" )
 column=(type=char(1) updatewhereclause=yes name=patient_numero_serie dbname="patient.numero_serie" dbalias=".numero_serie" )
 column=(type=char(48) updatewhereclause=yes name=soin dbname="soin" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=date updatewhereclause=yes name=soins_date_debut dbname="soins.date_debut" dbalias=".date_debut" initial="null" )
 column=(type=date updatewhereclause=yes name=date_fin dbname="date_fin" )
 column=(type=long updatewhereclause=yes name=mois_effectues dbname="mois_effectues" )
 column=(type=decimal(0) updatewhereclause=yes name=mois_restants dbname="mois_restants" )
 retrieve="  SELECT ~"prati~".~"nom~" as nom_praticien,   
         :numero_serie as numero_serie,   
          ~"code_soins~".~"nom~" + ' ' + cast( ~"soins~".~"numero~" as varchar) as soin,   
         ~"patient~".~"nom~",   
         ~"patient~".~"prenom~",   
         ~"patient~".~"numero_dossier~",   
         ~"soins~".~"date_demande~" as date_debut,   
		cast(dateadd (month, ~"code_soins~".~"duree~", ~"soins~".~"date_demande~"  ) as date) as date_fin,
        datediff (month, ~"soins~".~"date_demande~" , :date_reference) as mois_effectues,   
        ~"code_soins~".~"duree~" - mois_effectues as mois_restants  
    FROM ~"patient~",   
         ~"soins~",   
         ~"table_vide~",   
         ~"prati~",   
         ~"code_soins~"  
   WHERE ( ~"patient~".~"code~" = ~"soins~".~"code~" ) and  
         ( ~"patient~".~"code_praticien~" = ~"prati~".~"code~" ) and  
         ( ~"soins~".~"type~" = ~"code_soins~".~"code~" ) and  
         ( ( :date_reference between ~"soins~".~"date_demande~" and dateadd (month, ~"code_soins~".~"duree~", ~"soins~".~"date_demande~"  ) ) )    
" arguments=(("date_reference", date),("numero_serie", string))  sort="prati_nom_praticien A soin A nom A prenom A " )
