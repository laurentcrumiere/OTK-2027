type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();
em_d1.text = trim(mid(page,1,10))
em_d2.text = trim(mid(page,11,10))
em_d3.text = trim(mid(page,21,10))
em_d5.text = trim(mid(page,31,10))
em_d6.text = trim(mid(page,41,10))
em_d7.text = trim(mid(page,51,10))


mle_col1.text = RightTrim(mid(page,101,68))
mle_col2.text = RightTrim(mid(page,201,68))
mle_col3.text = RightTrim(mid(page,301,68))

em_diam.text = trim(mid(page,400,4))

em_t11.text = trim(mid(page,404,4))
em_t12.text = trim(mid(page,408,4))
em_t13.text = trim(mid(page,412,4))
em_t14.text = trim(mid(page,416,4))
em_t15.text = trim(mid(page,420,4))

em_t21.text = trim(mid(page,424,4))
em_t22.text = trim(mid(page,428,4))
em_t23.text = trim(mid(page,432,4))
em_t24.text = trim(mid(page,436,4))
em_t25.text = trim(mid(page,440,4))

em_t31.text = trim(mid(page,444,4))
em_t32.text = trim(mid(page,448,4))
em_t33.text = trim(mid(page,452,4))
em_t34.text = trim(mid(page,456,4))
em_t35.text = trim(mid(page,460,4))

em_t41.text = trim(mid(page,464,4))
em_t42.text = trim(mid(page,468,4))
em_t43.text = trim(mid(page,472,4))
em_t44.text = trim(mid(page,476,4))
em_t45.text = trim(mid(page,480,4))

em_p1.text = trim(mid(page,500,6))
em_p2.text = trim(mid(page,506,6))
em_p3.text = trim(mid(page,512,6))
em_p4.text = trim(mid(page,530,6))
em_p5.text = trim(mid(page,536,6))
em_p6.text = trim(mid(page,542,6))
em_p7.text = trim(mid(page,560,6))
em_p8.text = trim(mid(page,566,6))
em_p9.text = trim(mid(page,572,6))

em_m1.text = trim(mid(page,518,6))
em_m2.text = trim(mid(page,524,6))
em_m4.text = trim(mid(page,548,6))
em_m5.text = trim(mid(page,554,6))
em_m7.text = trim(mid(page,578,6))
em_m8.text = trim(mid(page,584,6))

modif = false

end subroutine

event open;
var_code_local = message.doubleparm

string vn,vm 
select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

this.title = "Page N°1 : "+vn+" (Moulage : "+vm+")"

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()


end event

