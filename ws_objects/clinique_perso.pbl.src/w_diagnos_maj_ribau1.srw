event clicked;f.ecrirepage(rb_dolico1,page,1)
f.ecrirepage(rb_meso1,page,2)
f.ecrirepage(rb_brach1,page,3)

f.ecrirepage(rb_dolico2,page,4)
f.ecrirepage(rb_meso2,page,5)
f.ecrirepage(rb_brach2,page,6)

f.ecrirepage(rb_dolico3,page,7)
f.ecrirepage(rb_meso3,page,8)
f.ecrirepage(rb_brach3,page,9)

f.ecrirepage(rb_dolico4,page,10)
f.ecrirepage(rb_meso4,page,11)
f.ecrirepage(rb_brach4,page,12)

f.ecrirepage(rb_dolico5,page,13)
f.ecrirepage(rb_meso5,page,14)
f.ecrirepage(rb_brach5,page,15)

f.ecrirepage(sle_nc1,page,16,5)
f.ecrirepage(sle_nc2,page,21,5)
f.ecrirepage(sle_nc3,page,26,5)
f.ecrirepage(sle_nc4,page,31,5)
f.ecrirepage(sle_nc5,page,36,5)
f.ecrirepage(sle_nc6,page,41,5)
f.ecrirepage(sle_nc7,page,46,5)
f.ecrirepage(sle_nc8,page,51,5)
f.ecrirepage(sle_nc9,page,56,5)
f.ecrirepage(sle_nc10,page,61,5)

f.ecrirepage(sle_patient1,page,66,5)
f.ecrirepage(sle_patient2,page,71,5)
f.ecrirepage(sle_patient3,page,76,5)
f.ecrirepage(sle_patient4,page,81,5)
f.ecrirepage(sle_patient5,page,86,5)
f.ecrirepage(sle_patient6,page,91,5)
f.ecrirepage(sle_patient7,page,96,5)
f.ecrirepage(sle_patient8,page,101,5)
f.ecrirepage(sle_patient9,page,106,5)
f.ecrirepage(sle_patient10,page,111,5)

f.ecrirepage(mle_mand,page,116,200)
f.ecrirepage(mle_max,page,316,200)
