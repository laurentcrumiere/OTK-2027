type cb_1 from commandbutton within w_diagnos_maj_87467_2
integer x = 933
integer y = 4860
integer width = 768
integer height = 120
boolean bringtotop = true
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Transférer vers Diagnostic"
boolean default = true
end type

event clicked;
string diagnos

//
//
// Header
//
//
diagnos = diagnos + "==Motif de consultation=="

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if mle_motif.text <> "" then diagnos = diagnos + "- Motif de consultation: " + mle_motif.text
// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_motiv_forte.checked then diagnos = diagnos + "- Motivation : forte"
if rb_motiv_m.checked then diagnos = diagnos + "- Motivation : moyenne"
if rb_motiv_faible.checked then diagnos = diagnos + "- Motivation : faible"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_denture_mixte.checked then diagnos = diagnos + "- Denture : mixte"
if rb_denture_definitive.checked then diagnos = diagnos + "- Denture : definitive"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_hygiene_faible.checked then diagnos = diagnos + "- Hygiène : faible"
if rb_hygiene_moy.checked then diagnos = diagnos + "- Hygiène : moyenne"
if rb_hygiene_bon.checked then diagnos = diagnos + "- Hygiène : bonne"
// passage à la ligne
diagnos = diagnos + char(13) + char(10)

//---------------------------------------------------------------------------------------------------------------------------
//
//
// D i a g n o s t i c       F o n c t i o n n e l  (1)
//
//
// passage à la ligne
diagnos = diagnos + char(13) + char(10)
diagnos = diagnos + "==FONCTIONNEL=="

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if sle_aler.text <> "" then diagnos = diagnos + "- Allergie : " + sle_aler.text

// passage à la ligne si check
if cbx_pres_amy.checked then diagnos = diagnos + char(13) + char(10) + "- Présence amygdale"
// passage à la ligne si check
if cbx_vegetation.checked then diagnos = diagnos + char(13) + char(10) + "- Présence végétations"


// passage à la ligne
diagnos = diagnos + char(13) + char(10)
if rb_seuilnarin_etroit.checked then diagnos = diagnos + "- Seuils narinaires étroits"
if rb_seuilnarin_norm.checked then diagnos = diagnos + "- Seuils narinaires normaux"
if rb_seuilnarin_large.checked then diagnos = diagnos + "- Seuils narinaires larges"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)
if rb_resp_buc.checked then diagnos = diagnos + "- Respiration buccale"
if rb_resp_nas.checked then diagnos = diagnos + "- Respiration nasale"
if rb_resp_mix.checked then diagnos = diagnos + "- Respiration mixte"

// passage à la ligne deglutition si coché oui
if rb_deg_oui.checked then diagnos = diagnos + char(13) + char(10) + "- Déglutition atypique"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)
if rb_phon_norm.checked then diagnos = diagnos + "- Phonation normale"
if rb_phon_pert.checked then diagnos = diagnos + "- Phonation perturbé :" + sle_phon.text

// passage à la ligne contracture si coché oui
if rb_cont_oui.checked then diagnos = diagnos + char(13) + char(10) + "- Contracture mentonnière"

// passage à la ligne habitudes si check
if cbx_habit_ony.checked then diagnos = diagnos + char(13) + char(10) + "- Habitudes : onychophagie"
if cbx_habit_succ.checked then diagnos = diagnos + char(13) + char(10) + "- Habitudes : succion digitale"
if cbx_habit_inter.checked then diagnos = diagnos + char(13) + char(10) + "- Habitudes : interposition labiale"
if cbx_habit_ony.checked then diagnos = diagnos + char(13) + char(10) + "- Habitudes : onychophagie"
if sle_habit_autre.text <> "" then diagnos = diagnos + char(13) + char(10) + "- Autres : " + sle_habit_autre.text


if rb_musc_hyper.checked then diagnos = diagnos + char(13) + char(10) + "- Musculature : hypertonique"
if rb_musc_norm.checked then diagnos = diagnos + char(13) + char(10) + "- Musculature : normale"
if rb_musc_hypo.checked then diagnos = diagnos + char(13) + char(10) + "- Musculature : hypotonique"



if cbx_atm_dte.checked then diagnos = diagnos + char(13) + char(10) + "- Sub luxation ATM droite "
if cbx_atm_gau.checked then diagnos = diagnos + char(13) + char(10) + "- Sub luxation ATM gauche "
if cbx_brux.checked then diagnos = diagnos + char(13) + char(10) + "- Bruxisme"


// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if sle_fonct.text <> "" then diagnos = diagnos + "- " + sle_fonct.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)


//--------------------------------------------------------------------------------------------------------------------------
//
// Diagnostic dentaire   (2)
//
//
// passage à la ligne
diagnos = diagnos + char(13) + char(10)
diagnos = diagnos + "==DENTAIRE=="

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if sle_carie.text <> "" then diagnos = diagnos + " - Carie sur " + sle_carie.text
if sle_délab.text <> "" then diagnos = diagnos + ", délabrement important de " + sle_délab.text
if sle_persist.text <> "" then diagnos = diagnos + ", persistance de " + sle_persist.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

// passage à la ligne si check
if cbx_fr_ling.checked then diagnos = diagnos + char(13) + char(10) + "- Frein lingual court "
if cbx_fr_lab.checked then diagnos = diagnos + char(13) + char(10) + "- Frein labial supérieur hypertrophique"
if sle_autre_bride.text <> "" then diagnos = diagnos + char(13) + char(10) + "- Autre brides : " + sle_autre_bride.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if cbx_retard.checked then diagnos = diagnos + ", retard dentaire"
if sle_émail.text <> "" then diagnos = diagnos + ", tâches de l'émail sur" + sle_émail.text
if cbx_usure.checked then diagnos = diagnos + ", usure dentaire"
if cbx_bruxisme.checked then diagnos = diagnos + ", bruxisme"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)


if cbx_ddm.checked then diagnos = diagnos + "- DDM, Malpositions : " + sle_ddm.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)
//debut des classes molaire gauche
if rb_mg_cl1.checked then diagnos = diagnos + "- Classe 1 molaire gauche"
if rb_mg_cl2.checked then diagnos = diagnos + "- Classe 2 molaire gauche"
if rb_mg_cl3.checked then diagnos = diagnos + "- Classe 3 molaire gauche"
// passage à la ligne
diagnos = diagnos + char(13) + char(10)
//debut des classes molaire droite
if rb_md_cl1.checked then diagnos = diagnos + "- Classe 1 molaire droite"
if rb_md_cl2.checked then diagnos = diagnos + "- Classe 2 molaire droite"
if rb_md_cl3.checked then diagnos = diagnos + "- Classe 3 molaire droite"
// passage à la ligne
diagnos = diagnos + char(13) + char(10)
//debut des classes canine gauche
if rb_cg_cl1.checked then diagnos = diagnos + "- Classe 1 canine gauche"
if rb_cg_cl2.checked then diagnos = diagnos + "- Classe 2 canine gauche"
if rb_cg_cl3.checked then diagnos = diagnos + "- Classe 3 canine gauche"
// passage à la ligne
diagnos = diagnos + char(13) + char(10)
//debut des classes canine droite
if rb_cd_cl1.checked then diagnos = diagnos + "- Classe 1 canine droite"
if rb_cd_cl2.checked then diagnos = diagnos + "- Classe 2 canine droite"
if rb_cd_cl3.checked then diagnos = diagnos + "- Classe 3 canine droite"


//articulé inversé
if cbx_art_inv_anté.checked then diagnos = diagnos + char(13) + char(10) + "- Articulé inversé antérieur "
if cbx_art_lat_drt.checked then diagnos = diagnos + char(13) + char(10) + "- Articulé inversé latéral droit "
if cbx_art_lat_gau.checked then diagnos = diagnos + char(13) + char(10) + "- Articulé inversé latéral gauche"
if cbx_art_dent.checked then diagnos = diagnos + char(13) + char(10) + "- Dents :  " + sle_dents.text

//recouvrement etc...

if sle_recouv.text <> "" then diagnos = diagnos + char(13) + char(10) + "- Recouvrement " + sle_recouv.text + " %CC "
if sle_surplomb.text <> "" then diagnos = diagnos + char(13) + char(10) + "- Surplomb " + sle_surplomb.text + " mm "
if sle_infracl.text <> "" then diagnos = diagnos + char(13) + char(10) + "- Infraclusion " + sle_infracl.text + " mm "

//decalage des centres
if rb_dec_max_dr.checked then diagnos = diagnos + char(13) + char(10) + "- Décalage du centre maxillaire de " + sle_dec_max.text + " mm sur la droite"
if rb_dec_max_g.checked then diagnos = diagnos + char(13) + char(10) + "- Décalage du centre maxillaire de " + sle_dec_max.text + " mm sur la gauche"
if rb_dec_mand_dr.checked then diagnos = diagnos + char(13) + char(10) + "- Décalage du centre mandibulaire de " + sle_dec_mand.text + " mm sur la droite"
if rb_dec_mand_g.checked then diagnos = diagnos + char(13) + char(10) + "- Décalage du centre mandibulaire de " + sle_dec_mand.text + " mm sur la gauche"

//deviation
if rb_devia_oui.checked then diagnos = diagnos + char(13) + char(10) + "- Déviation fonctionnelle de la mandibule"

//asymetrie
if cbx_asym_mand.checked then diagnos = diagnos + char(13) + char(10) + "- Asymétrie de la mandibule"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)
//agnesie
if sle_agé.text <> "" then diagnos = diagnos + "- Agénésies de " + sle_agé.text
if sle_inclu.text <> "" then diagnos = diagnos + " , inclusion de " + sle_inclu.text
if sle_dents_surnum.text <> "" then diagnos = diagnos + " , dents surnuméraires : " + sle_dents_surnum.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_réces_géné.checked then diagnos = diagnos + "- Récessions gingivales généralisées "
if rb_réces_sur.checked then diagnos = diagnos + "- Récessions gingivales sur " + sle_réces_sur.text
if cbx_plaq.checked then diagnos = diagnos + ", Plaque"
if cbx_gingiv.checked then diagnos = diagnos + ", gingivite"


// passage à la ligne
diagnos = diagnos + char(13) + char(10)
if cbx_pres_8.checked then diagnos = diagnos + "- Présence des 8 sur la pano"
if cbx_abs_8.checked then diagnos = diagnos + "- Absence des 8 sur la pano"
if sle_pres.text <> "" then diagnos = diagnos + ", présence de " + sle_pres.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

//max mand en V
if rb_maxv_oui.checked then diagnos = diagnos + "- Maxillaire en V"
if rb_mandv_oui.checked then diagnos = diagnos + "- Mandibule verrouillée"

//proversion et retroversion
if cbx_prov_sup.checked then diagnos = diagnos + char(13) + char(10) + "- Proversion incisives supérieure "
if cbx_prov_inf.checked then diagnos = diagnos + char(13) + char(10) + "- Proversion incisives inférieure"
// passage à la ligne
if cbx_retro_sup.checked then diagnos = diagnos + char(13) + char(10) + "- Rétroversion incisives supérieure "
if cbx_retro_inf.checked then diagnos = diagnos + char(13) + char(10) + "- Rétroversion incisives inférieure"
// passage à la ligne
diagnos = diagnos + char(13) + char(10)
if sle_dentaire.text <> "" then diagnos = diagnos + "- " + sle_dentaire.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)


//--------------------------------------------------------------------------------------------------------------------------
//
//EXOBUCCAL (3)
//
//

// passage à la ligne
diagnos = diagnos + char(13) + char(10)
diagnos = diagnos + "==EXOBUCCAL=="

// passage à la ligne
diagnos = diagnos + char(13) + char(10) + "- Ligne lèvre au repos à : " + sle_ligne_levre.text + " mm"
diagnos = diagnos + char(13) + char(10) + "- Ligne du sourrire à : " + sle_ligne_sourrire.text + " %CC"
diagnos = diagnos + char(13) + char(10) + "- Gencive exposée au sourrire à : " + sle_gencive.text + " mm"
diagnos = diagnos + char(13) + char(10) + "- Longueur de lèvre supérieur à : " + sle_long.text + " %CC"
if sle_beance.text <> "" then diagnos = diagnos + char(13) + char(10) + "- Béance labiale repos à : " + sle_beance.text + " mm"
if sle_asym.text <> "" then diagnos = diagnos + char(13) + char(10) + "- Asymétrie faciale : " + sle_asym.text
// passage à la ligne
diagnos = diagnos + char(13) + char(10)
//---------------------------------------------------------------------------------------------------------------------------
//
//
//     D i a g n o s t i c       S q u e l e t t i q u e   (4)
//
//

// passage à la ligne
diagnos = diagnos + char(13) + char(10)
diagnos = diagnos + "==SQUELETTIQUE=="
// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_cl1_sque.checked then diagnos = diagnos + "- Classe 1 "
if rb_cl2_sque.checked then diagnos = diagnos + "- Classe 2 "
if rb_cl3_sque.checked then diagnos = diagnos + "- Classe 3 "
if cbx_cl_sque_imp.checked then diagnos = diagnos + " Importante"
if cbx_progenie.checked then diagnos = diagnos + char(13) + char(10) + "- Progrénie"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_normo.checked then diagnos = diagnos + "- Normodivergence "
if rb_hypo.checked then diagnos = diagnos + "- Hypodivergence "
if rb_hyper.checked then diagnos = diagnos + "- Hyperdivergence "
if cbx_import.checked then diagnos = diagnos + "importante"


// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if sle_sque.text <> "" then diagnos = diagnos + "- " + sle_sque.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)



// passage à la ligne double
diagnos = diagnos + char(13) + char(10) + char(13) + char(10)


// Affichage du texte géné pour tester...
// Messagebox("Diagnostic généré : ",diagnos)
//

//=================================================================
// Mise à jour du Diagnostic patient

string	lstr_diag, lstr_diag_rtf

// zone "diagnostic"
select traitement_effectue_html, traitement_effectue  into :lstr_diag, :lstr_diag_rtf from patient where patient.code = :var_code_local ;

// Ajout du commentaire
lstr_diag = diagnos
lstr_diag_rtf = string_to_rtf(diagnos,couleur_noire,couleur_blanche)

// Mise à jour du Diagnostic
Update patient
Set traitement_effectue_html = :lstr_diag, traitement_effectue = :lstr_diag_rtf
Where patient.code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	COMMIT ;
	sle_result.visible = true
	sle_result.text = "Transfert OK"
end if



end event

