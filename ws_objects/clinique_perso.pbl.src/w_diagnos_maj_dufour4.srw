global w_diagnos_maj_dufour4 w_diagnos_maj_dufour4

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();sle_respi.text = RightTrim(mid(page,2000,20))
sle_deglu.text = RightTrim(mid(page,2020,20))
sle_phona.text = RightTrim(mid(page,2040,20))

sle_amyg.text = RightTrim(mid(page,2060,20))
sle_vege.text = RightTrim(mid(page,2080,20))

sle_langue1.text = RightTrim(mid(page,2100,20))
sle_langue2.text = RightTrim(mid(page,2120,20))
sle_langue3.text = RightTrim(mid(page,2140,20))
sle_langue4.text = RightTrim(mid(page,2160,20))
sle_langue5.text = RightTrim(mid(page,2180,20))

sle_sup1.text = RightTrim(mid(page,2200,20))
sle_sup2.text = RightTrim(mid(page,2220,20))
sle_sup3.text = RightTrim(mid(page,2240,20))

sle_inf1.text = RightTrim(mid(page,2260,20))
sle_inf2.text = RightTrim(mid(page,2280,20))
sle_inf3.text = RightTrim(mid(page,2300,20))

sle_douleur.text = RightTrim(mid(page,2320,20))
sle_craquement.text = RightTrim(mid(page,2340,20))
sle_ressaut.text = RightTrim(mid(page,2360,20))
sle_chemin.text = RightTrim(mid(page,2380,20))
sle_amplitude.text = RightTrim(mid(page,2400,20))
sle_prema.text = RightTrim(mid(page,2420,20))

if mid(page,2440,1) = 'O' then
	cbx_suceur.checked = true
end if
if mid(page,2441,1) = 'O' then
	cbx_onychophagie.checked = true
end if
if mid(page,2442,1) = 'O' then
	cbx_bruxisme.checked = true
end if

string pt
SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;
mle_plan_traitement.text = pt

mle_reeva.text = RightTrim(mid(page,2500,500))

modif = false
cb_fermer.setfocus()
end subroutine

event open;var_code_local = message.doubleparm

string vn,vm 

select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if

this.title = "Page N°4  : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if


init()

end event

