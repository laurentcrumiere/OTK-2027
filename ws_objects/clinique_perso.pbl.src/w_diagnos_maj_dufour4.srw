type cb_enregistrer from commandbutton within w_diagnos_maj_dufour4
integer x = 2171
integer y = 1720
integer width = 338
integer height = 96
integer taborder = 300
integer textsize = -8
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Enregistrer"
boolean default = true
end type

event clicked;string pt 

place_avec_blancs(sle_respi.text,page,2000,20)
place_avec_blancs(sle_deglu.text,page,2020,20)
place_avec_blancs(sle_phona.text,page,2040,20)

place_avec_blancs(sle_amyg.text,page,2060,20)
place_avec_blancs(sle_vege.text,page,2080,20)

place_avec_blancs(sle_langue1.text,page,2100,20)
place_avec_blancs(sle_langue2.text,page,2120,20)
place_avec_blancs(sle_langue3.text,page,2140,20)
place_avec_blancs(sle_langue4.text,page,2160,20)
place_avec_blancs(sle_langue5.text,page,2180,20)

place_avec_blancs(sle_sup1.text,page,2200,20)
place_avec_blancs(sle_sup2.text,page,2220,20)
place_avec_blancs(sle_sup3.text,page,2240,20)

place_avec_blancs(sle_inf1.text,page,2260,20)
place_avec_blancs(sle_inf2.text,page,2280,20)
place_avec_blancs(sle_inf3.text,page,2300,20)

place_avec_blancs(sle_douleur.text,page,2320,20)
place_avec_blancs(sle_craquement.text,page,2340,20)
place_avec_blancs(sle_ressaut.text,page,2360,20)
place_avec_blancs(sle_chemin.text,page,2380,20)
place_avec_blancs(sle_amplitude.text,page,2400,20)
place_avec_blancs(sle_prema.text,page,2420,20)

if cbx_suceur.checked then
	place("O",page,2440)
else
	place("N",page,2440)
end if
if cbx_onychophagie.checked then
	place("O",page,2441)
else
	place("N",page,2441)
end if
if cbx_bruxisme.checked then
	place("O",page,2442)
else
	place("N",page,2442)
end if

place_avec_blancs(mle_reeva.text,page,2500,500)

pt = mle_plan_traitement.text

UPDATE diagnos SET perso = :page  WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
	else
	UPDATE patient SET plan_traitement = :pt WHERE code = :var_code_local ;
	if SQLCA.Sqlcode <> 0 then
		son(4)
		Messagebox("ERREUR BASE DE DONNEES (N°3)",SQLCA.SqlErrText)
	else
		modif = false
		COMMIT ;
	end if
end if


end event

