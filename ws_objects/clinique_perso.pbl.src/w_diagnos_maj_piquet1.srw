else
	place("N",page_buffer[2],1905)
end if
if cbx_beance.checked then
	place("O",page_buffer[2],1906)
else
	place("N",page_buffer[2],1906)
end if
place_avec_blancs(em_date.text,page_buffer[2],1907,10)
place_avec_blancs(em_age.text,page_buffer[2],1920,2)


// ajout suite remaniement page du 27/09/2005
// cbx_suceur.checked
place("N",page_buffer[2],404)

// ddlb_hygiene
place(space(1),page_buffer[2],721)

