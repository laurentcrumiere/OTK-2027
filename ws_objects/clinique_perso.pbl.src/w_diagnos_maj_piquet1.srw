public subroutine unload_ctrls ();place_avec_blancs(mle_ant_gene.text,page_buffer[2],1,200)
place_avec_blancs(mle_ant_fami.text,page_buffer[2],201,200)
place(string(ddlb_respiration.FindItem(ddlb_respiration.text,1)),page_buffer[2],401)
place(string(ddplb_deglutition.FindItem(ddplb_deglutition.text,1)),page_buffer[2],402)
place(string(ddplb_phonation.FindItem(ddplb_phonation.text,1)),page_buffer[2],403)

if cbx_onychophagie.checked then
	place("O",page_buffer[2],405)
else
	place("N",page_buffer[2],405)
end if
if cbx_bruxisme.checked then
	place("O",page_buffer[2],406)
else
	place("N",page_buffer[2],406)
end if
place(string(ddlb_amygdales.FindItem(ddlb_amygdales.text,1)),page_buffer[2],407)
place(string(ddlb_vegetations.FindItem(ddlb_vegetations.text,1)),page_buffer[2],408)
place(string(ddlb_langue.FindItem(ddlb_langue.text,1)),page_buffer[2],409)
place(string(ddplb_levres.FindItem(ddplb_levres.text,1)),page_buffer[2],410)
place(string(ddplb_volume.FindItem(ddplb_volume.text,1)),page_buffer[2],411)
place(string(ddlb_chemin.FindItem(ddlb_chemin.text,1)),page_buffer[2],415)
place(string(ddplb_amplitude.FindItem(ddplb_amplitude.text,1)),page_buffer[2],416)
place_avec_blancs(sle_prematurites.text,page_buffer[2],417,30)
place_avec_blancs(mle_paro.text,page_buffer[2],448,150)
if cbx_langue.checked then
	place("O",page_buffer[2],600)
else
	place("N",page_buffer[2],600)
end if
if cbx_levre_sup.checked then
	place("O",page_buffer[2],601)
else
	place("N",page_buffer[2],601)
end if
if cbx_levre_inf.checked then
	place("O",page_buffer[2],602)
else
	place("N",page_buffer[2],602)
end if
place_avec_blancs(em_sag2.text,page_buffer[2],606,3)
place_avec_blancs(em_sag3.text,page_buffer[2],609,3)
place_avec_blancs(em_sag4.text,page_buffer[2],612,3)
