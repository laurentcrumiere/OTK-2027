integer x = 3291
integer y = 2300
integer taborder = 690
end type

event cb_sauver::clicked;call super::clicked;dw_diag3.accepttext()

// Mise à jour des zones pour myOrthokis
dw_diag3.setItem(1, "traitement_effectue_html", dw_diag3.getitemString(1, "texte_brut_traitement_effectue"))

if dw_diag3.update() = 1 then
	commit ;
	if sqlca.sqlcode <> 0 then
		Messagebox("ERREUR DANS LA MISE A JOUR N°"+string(sqlca.sqlcode),sqlca.sqlerrtext)
	end if
else
	rollback ;
end if

end event

