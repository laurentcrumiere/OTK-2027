public subroutine load_ctrls ();mle_ant_gene.text = Righttrim(trim(mid(page_buffer[1],1,200)))
mle_ant_fami.text = Righttrim(trim(mid(page_buffer[1],201,200)))
ddlb_respiration.selectitem(integer(mid(page_buffer[1],401,1)))
ddplb_deglutition.selectitem(integer(mid(page_buffer[1],402,1)))
ddplb_phonation.selectitem(integer(mid(page_buffer[1],403,1)))
if mid(page_buffer[1],404,1) = 'O' then
	cbx_suceur.checked = true
else
	cbx_suceur.checked = false
end if
if mid(page_buffer[1],405,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page_buffer[1],406,1) = 'O' then
	cbx_bruxisme.checked = true
else
	cbx_bruxisme.checked = false
end if
ddlb_amygdales.selectitem(integer(mid(page_buffer[1],407,1)))
ddlb_vegetations.selectitem(integer(mid(page_buffer[1],408,1)))
ddlb_langue.selectitem(integer(mid(page_buffer[1],409,1)))
ddplb_levres.selectitem(integer(mid(page_buffer[1],410,1)))
ddplb_volume.selectitem(integer(mid(page_buffer[1],411,1)))
if mid(page_buffer[1],412,1) = 'O' then
	cbx_douleur.checked = true
else
	cbx_douleur.checked = false
end if
if mid(page_buffer[1],413,1) = 'O' then
	cbx_craquement.checked = true
else
	cbx_craquement.checked = false
end if
if mid(page_buffer[1],414,1) = 'O' then
	cbx_ressaut.checked = true
else
	cbx_ressaut.checked = false
end if
ddlb_chemin.selectitem(integer(mid(page_buffer[1],415,1)))
ddplb_amplitude.selectitem(integer(mid(page_buffer[1],416,1)))
sle_prematurites.text = Righttrim(mid(page_buffer[1],417,30))
mle_paro.text = Righttrim(mid(page_buffer[1],448,150))
if mid(page_buffer[1],600,1) = 'O' then
	cbx_langue.checked = true
else
	cbx_langue.checked = false
end if
if mid(page_buffer[1],601,1) = 'O' then
	cbx_levre_sup.checked = true
else
	cbx_levre_sup.checked = false
end if
if mid(page_buffer[1],602,1) = 'O' then
	cbx_levre_inf.checked = true
else
	cbx_levre_inf.checked = false
end if
em_sag1.text = mid(page_buffer[1],603,3)
em_sag2.text = mid(page_buffer[1],606,3)
em_sag3.text = mid(page_buffer[1],609,3)
em_sag4.text = mid(page_buffer[1],612,3)
em_sag5.text = mid(page_buffer[1],615,3)
em_tran1.text = mid(page_buffer[1],618,3)
em_tran2.text = mid(page_buffer[1],621,3)
em_tran3.text = mid(page_buffer[1],624,3)
em_tran4.text = mid(page_buffer[1],627,3)
em_tran5.text = mid(page_buffer[1],630,3)
ddlb_vert1.selectitem(integer(mid(page_buffer[1],1323,1)))
ddlb_vert2.selectitem(integer(mid(page_buffer[1],1324,1)))
ddlb_vert3.selectitem(integer(mid(page_buffer[1],1325,1)))
ddlb_vert4.selectitem(integer(mid(page_buffer[1],1326,1)))
ddlb_vert5.selectitem(integer(mid(page_buffer[1],1327,1)))
ddlb_milieux.selectitem(integer(mid(page_buffer[1],636,1)))
ddlb_mand.selectitem(integer(mid(page_buffer[1],637,1)))
if mid(page_buffer[1],638,1) = 'O' then
	cbx_haut.checked = true
else
	cbx_haut.checked = false
end if
if mid(page_buffer[1],639,1) = 'O' then
	cbx_bas.checked = true
else
	cbx_bas.checked = false
end if
if mid(page_buffer[1],640,1) = 'O' then
	cbx_ddd.checked = true
else
	cbx_ddd.checked = false
end if
sle_caries.text = Righttrim(mid(page_buffer[1],641,40))
sle_cysplasies.text = Righttrim(mid(page_buffer[1],681,40))
ddlb_hygiene.selectitem(integer(mid(page_buffer[1],721,1)))
ddlb_motivation.selectitem(integer(mid(page_buffer[1],722,1)))
mle_diag.text = RightTrim(mid(page_buffer[1],723,300))
mle_remarques.text = RightTrim(mid(page_buffer[1],1023,300))
if mid(page_buffer[1],1905,1) = 'O' then
	cbx_interposition.checked = true
else
	cbx_interposition.checked = false
end if
if mid(page_buffer[1],1906,1) = 'O' then
	cbx_beance.checked = true
else
	cbx_beance.checked = false
end if
em_date.text = mid(page_buffer[1],1907,10)
em_age.text = mid(page_buffer[1],1920,2)



// ajout suite remaniement page du 27/09/2005

if em_date.text = "00/00/0000" then 
	// si date exam initial pas encore init
	em_date.text = string(today())
	date date_naissance
	select date_naissance INTO :date_naissance FROM	 patient WHERE code = :var_code_local ;
	if not isnull(date_naissance) then
		// calcule de son age (années seulement)
		integer an
		if (month(today()) < month( date_naissance )) then
			an = year(today()) - year( date_naissance ) - 1
		ELSE
			an = year(today()) - year( date_naissance )
		END IF
		em_age.text = string( an )
	end if
end if

//f.lire_d(mle_1, var_code_local)

f.lirepage(em_1, page_buffer[1], 2000, 10)
f.lirepage(em_2, page_buffer[1], 2010, 4)
f.lirepage(em_3, page_buffer[1], 2014, 3)

f.lirepage(sle_1, page_buffer[1], 2020, 50)
f.lirepage(sle_2, page_buffer[1], 2070, 50)
f.lirepage(sle_3, page_buffer[1], 2120, 50)
f.lirepage(sle_4, page_buffer[1], 2170, 30)
f.lirepage(sle_5, page_buffer[1], 2200, 30)
f.lirepage(sle_6, page_buffer[1], 2230, 20)
f.lirepage(sle_7, page_buffer[1], 2250, 10)

if cbx_suceur.checked then
	ddlb_1.selectitem( 2 )
else
	f.lirepage(ddlb_1, page_buffer[1], 2260, 1)
end if
f.lirepage(ddlb_2, page_buffer[1], 2261, 1)
f.lirepage(ddlb_3, page_buffer[1], 2262, 1)
f.lirepage(ddlb_4, page_buffer[1], 2263, 1)
choose case ddlb_hygiene.FindItem(ddlb_hygiene.text,0)
	case 1
		ddlb_5.selectitem( 2 )
	case 2,3
		ddlb_5.selectitem( 3 )
	case else
		f.lirepage(ddlb_5, page_buffer[1], 2264, 1)
end choose
choose case ddlb_motivation.FindItem(ddlb_motivation.text,0)
	case 1
		ddlb_6.selectitem( 2 )
	case 2,3
		ddlb_6.selectitem( 3 )
	case else
		f.lirepage(ddlb_6, page_buffer[1], 2265, 1)
end choose
f.lirepage(cbx_1, page_buffer[1], 2266)
if cbx_ressaut.checked then
	cbx_2.checked = true
	cbx_3.checked = true
else
	f.lirepage(cbx_2, page_buffer[1], 2267)
	f.lirepage(cbx_3, page_buffer[1], 2268)
end if
if cbx_craquement.checked then
	cbx_5.checked = true
	cbx_4.checked = true
else
	f.lirepage(cbx_4, page_buffer[1], 2269)
	f.lirepage(cbx_5, page_buffer[1], 2270)
end if
if cbx_douleur.checked then
	cbx_7.checked = true
	cbx_6.checked = true
else
	f.lirepage(cbx_6, page_buffer[1], 2271)
	f.lirepage(cbx_7, page_buffer[1], 2272)
end if

if trim(em_sag1.text) = "" then
	f.lirepage(em_sag1, page_buffer[1], 2275, 4)
end if
// max carac = 2280



dw_diag3.SetTransObject(SQLCA)
dw_diag3.Retrieve(var_code_local)



end subroutine

