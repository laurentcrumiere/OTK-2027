place_avec_blancs(em_tran4.text,page_buffer[2],627,3)
place_avec_blancs(em_tran5.text,page_buffer[2],630,3)
place(string(ddlb_vert1.FindItem(ddlb_vert1.text,1)),page_buffer[2],1323)
place(string(ddlb_vert2.FindItem(ddlb_vert2.text,1)),page_buffer[2],1324)
place(string(ddlb_vert3.FindItem(ddlb_vert3.text,1)),page_buffer[2],1325)
place(string(ddlb_vert4.FindItem(ddlb_vert4.text,1)),page_buffer[2],1326)
place(string(ddlb_vert5.FindItem(ddlb_vert5.text,1)),page_buffer[2],1327)
place(string(ddlb_milieux.FindItem(ddlb_milieux.text,1)),page_buffer[2],636)
place(string(ddlb_mand.FindItem(ddlb_mand.text,1)),page_buffer[2],637)
if cbx_haut.checked then
	place("O",page_buffer[2],638)
else
	place("N",page_buffer[2],638)
end if
if cbx_bas.checked then
	place("O",page_buffer[2],639)
else
	place("N",page_buffer[2],639)
end if
if cbx_ddd.checked then
	place("O",page_buffer[2],640)
else
