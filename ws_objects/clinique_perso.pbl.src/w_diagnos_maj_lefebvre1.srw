forward prototypes
public subroutine load_ctrls ()
public subroutine unload_ctrls ()
end prototypes

public subroutine load_ctrls ();string cdent,n,pn

modif = false

select code_dentiste INTO :cdent FROM patient WHERE code = :var_code_local ;
select nom,prenom INTO :n,:pn FROM correspondants WHERE code = :cdent ;
if isnull(n) then
	n = ""
end if
if isnull(pn) then
	pn = ""
end if
sle_dentiste.text = n + " " +pn


f.lirepage(sle_docteur,page_buffer[1],1,50)

f.lirepage(em_taille,page_buffer[1],101,2)
f.lirepage(em_ai,page_buffer[1],110,6)
f.lirepage(em_a1,page_buffer[1],120,6)
f.lirepage(em_a2,page_buffer[1],130,6)
f.lirepage(em_a3,page_buffer[1],140,6)
f.lirepage(em_a4,page_buffer[1],150,6)
f.lirepage(em_date,page_buffer[1],160,10)
f.lirepage(em_6d,page_buffer[1],170,5)
f.lirepage(em_3d,page_buffer[1],175,5)
f.lirepage(em_oj,page_buffer[1],180,5)
f.lirepage(em_supra,page_buffer[1],185,5)
f.lirepage(em_6g,page_buffer[1],190,5)
f.lirepage(em_st,page_buffer[1],195,5)

f.lirepage(mle_remarques,page_buffer[1],200,50)
f.lirepage(mle_snm,page_buffer[1],250,50)

f.lirepage(sle_radios,page_buffer[1],300,50)
f.lirepage(sle_extractions,page_buffer[1],350,50)

f.lirepage(mle_rem1,page_buffer[1],400,150)

f.lirepage(em_fd_d_haut,page_buffer[1],550,30)
f.lirepage(em_6d2,page_buffer[1],580,5)
f.lirepage(em_3d2,page_buffer[1],585,5)
