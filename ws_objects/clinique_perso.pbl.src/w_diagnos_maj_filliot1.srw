forward prototypes
public subroutine save ()
public subroutine init ()
end prototypes

public subroutine save ();f.ecrirepage(em_date1,page,10,10)	//1710
f.ecrirepage(em_date2,page,20,10)
f.ecrirepage(em_date3,page,30,10)
f.ecrirepage(em_date4,page,40,10)
f.ecrirepage(em_date5,page,50,10)
f.ecrirepage(em_date6,page,60,10)
f.ecrirepage(em_date7,page,70,10)
f.ecrirepage(em_date8,page,80,10)
f.ecrirepage(em_date9,page,90,10)
f.ecrirepage(em_date10,page,100,10)
f.ecrirepage(em_date11,page,110,10)
f.ecrirepage(em_date12,page,120,10)		//carac max = 130



UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

public subroutine init ();f.lirepage(em_date1,page,10,10)	//1710
f.lirepage(em_date2,page,20,10)
f.lirepage(em_date3,page,30,10)
f.lirepage(em_date4,page,40,10)
f.lirepage(em_date5,page,50,10)
f.lirepage(em_date6,page,60,10)
f.lirepage(em_date7,page,70,10)
f.lirepage(em_date8,page,80,10)
f.lirepage(em_date9,page,90,10)
f.lirepage(em_date10,page,100,10)
f.lirepage(em_date11,page,110,10)
f.lirepage(em_date12,page,120,10)		//carac max = 130



modif = false
cb_fermer.setfocus()

end subroutine

