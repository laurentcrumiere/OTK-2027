public function string calc_tab_st (string str_sj, integer tab_st_champ);// renvoie la valeur calculée pour le champ souhaitée (param tab_st_champ) à partir de SJ (param SJ)
// renvoie chaine vide si pb (ou valeur de SJ erronée)

string return_val = ''

if isnull(str_sj) then return return_val
real sj
sj = real(str_sj)
if sj < 25 or sj > 36 then return return_val
if isnull(tab_st_champ) then return return_val
if tab_st_champ < 1 or tab_st_champ > 3 then return return_val

real tab_values_sj[23] = { &
	25.0, 25.5, 26.0, 26.5, 27.0, 27.5, 28.0, 28.5, 29.0, 29.5, 30.0, 30.5, &
	31.0, 31.5, 32.0, 32.5, 33.0, 33.5, 34.0, 34.5, 35.0, 35.5, 36.0 }
real tab_values_premol[23]	= { &
	29.4, 30.0, 35.0, 31.1, 31.7, 32.3, 32.9, 33.5, 34.1, 34.7, 35.2, 35.5, &
	36.4, 37.0, 37.6, 38.2, 38.8, 39.4, 40.0, 40.5, 41.1, 41.7, 42.3 }
real tab_values_mol[23] = { &
	38.4, 39.2, 40.0, 40.7, 41.5, 42.3, 43.0, 43.8, 44.6, 45.3, 46.1, 46.9, &
	47.6, 48.4, 49.2, 50.0, 50.7, 51.5, 52.3, 53.0, 53.8, 54.6, 55.3 }
real tab_values_fleche[23] = { &
	15.0, 15.3, 15.5, 15.8, 16.0, 16.3, 16.5, 16.8, 17.0, 17.3, 17.5, 17.8, &
	18.0, 18.3, 18.5, 18.8, 19.0, 19.3, 19.5, 19.8, 20.0, 20.5, 21.0 }

int i = 1
boolean hit = false
do
	if tab_values_sj[i] = sj then 
		hit = true
	else
		i++
	end if
loop while not hit and i <= upperbound(tab_values_sj)

if hit then
	choose case tab_st_champ
		case TAB_ST_premolaire
			return_val = string(Round (tab_values_premol[i], 1))
		case TAB_ST_molaire
			return_val = string(Round (tab_values_mol[i], 1))
		case TAB_ST_fleche
			return_val = string(Round (tab_values_fleche[i], 1))
	end choose
end if

return return_val
end function

