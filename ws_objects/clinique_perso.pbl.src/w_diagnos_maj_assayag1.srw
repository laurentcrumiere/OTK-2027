type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();em_heredite.text =  trim(mid(page,1,5))
em_accident.text =  trim(mid(page,6,5))
em_interventions.text =  trim(mid(page,11,5))
em_allergies.text =  trim(mid(page,20,6))
em_orl.text =  trim(mid(page,26,6))
em_pulmonaires.text =  trim(mid(page,32,6))
em_traitement.text =  trim(mid(page,38,6))
em_coo.text =  trim(mid(page,50,4))

em_nez.text =  trim(mid(page,55,15))
em_levres.text =  trim(mid(page,70,15))
em_menton.text =  trim(mid(page,85,15))
em_nez_profil.text =  trim(mid(page,100,15))
em_levre_profil.text =  trim(mid(page,115,15))
em_menton_profil.text =  trim(mid(page,130,15))

mle_observ.text =  trim(mid(page,150,500))

em_6d.text =  trim(mid(page,650,4))
em_3d.text =  trim(mid(page,655,4))
em_ob.text =  trim(mid(page,660,5))
em_6g.text =  trim(mid(page,665,4))
em_3g.text =  trim(mid(page,670,4))
em_oj.text =  trim(mid(page,675,5))

em_agenesie.text =  trim(mid(page,680,15))
em_extraction.text =  trim(mid(page,695,15))
em_protheses.text =  trim(mid(page,710,15))
em_obturation.text =  trim(mid(page,725,15))
em_rapports.text =  trim(mid(page,740,15))
em_carie.text =  trim(mid(page,765,15))

em_ddm.text =  trim(mid(page,780,5))
em_courbe.text =  trim(mid(page,785,5))
em_gia.text =  trim(mid(page,790,10))
em_freins_sup.text =  trim(mid(page,800,10))
em_freins_inf.text =  trim(mid(page,810,10))

em_hygiene.text =  trim(mid(page,820,10))
em_plaque.text =  trim(mid(page,830,10))
em_gingivite.text =  trim(mid(page,840,10))
em_poche.text =  trim(mid(page,850,10))
em_mobilite.text =  trim(mid(page,860,10))
em_deglutition.text =  trim(mid(page,870,12))
em_respiration.text =  trim(mid(page,885,12))
em_phonation.text =  trim(mid(page,900,12))
em_amygdales.text =  trim(mid(page,915,12))
em_vege.text =  trim(mid(page,930,12))
em_langue.text =  trim(mid(page,945,12))
em_tonus.text =  trim(mid(page,960,12))
em_douleurs.text =  trim(mid(page,980,10))
em_craquements.text =  trim(mid(page,990,10))
em_ressauts.text =  trim(mid(page,1000,10))
em_chemin.text =  trim(mid(page,1010,10))
em_succeur.text =  trim(mid(page,1020,12))
em_onycho.text =  trim(mid(page,1035,12))
em_bruxisme.text =  trim(mid(page,1050,12))

if mid(page,1070,1) = "O" then
	cbx_ddd.checked = true
else
	cbx_ddd.checked = false
end if
if mid(page,1071,1) = "O" then
	cbx_dysplasie.checked = true
else
	cbx_dysplasie.checked = false
end if

ddlb_milieux.selectitem(integer(mid(page,1072,1)))
ddlb_mand.selectitem(integer(mid(page,1073,1)))

cb_fermer.setfocus()
modif = false

end subroutine

event open;var_code_local = message.doubleparm


dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

string vn,vm 

select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if

this.title = "Page N°1 - Examen Clinique : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;


if isnull(page) then
	page = space(1000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

mep_win_mdi(this,1)
init()

end event

