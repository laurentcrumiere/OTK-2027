type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();mle_commentaires.text = RightTrim(mid(page,4200,500))


em_d1.text = RightTrim(mid(page,4000,10))
em_d2.text = RightTrim(mid(page,4010,10))
em_d3.text = RightTrim(mid(page,4020,10))
em_d4.text = RightTrim(mid(page,4030,10))
em_d5.text = RightTrim(mid(page,4040,10))
em_d6.text = RightTrim(mid(page,4050,10))
em_d7.text = RightTrim(mid(page,4060,10))
