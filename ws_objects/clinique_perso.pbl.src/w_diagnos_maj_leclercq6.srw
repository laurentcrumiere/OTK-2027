em_d9.text = RightTrim(mid(page,4080,10))
em_d10.text = RightTrim(mid(page,4090,10))
em_d11.text = RightTrim(mid(page,4100,10))
em_d12.text = RightTrim(mid(page,4110,10))
em_d13.text = RightTrim(mid(page,4120,10))
em_d14.text = RightTrim(mid(page,4130,10))
em_d15.text = RightTrim(mid(page,4140,10))
em_d16.text = RightTrim(mid(page,4150,10))
em_d17.text = RightTrim(mid(page,4160,10))
em_d18.text = RightTrim(mid(page,4170,10))



modif = false

end subroutine

event open;var_code_local = message.doubleparm

string vn
date vm

select trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = date('00/00/0000')
end if

this.title = "Page diagnostique N°6 : "+vn+" - Né(e) le : " +string(vm)+ " - N° dossier : "+string(var_code_local)


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(5000)
end if

if len(page) < 5000 then
	page = page + space(5000 - len(page))
end if

init()

end event

