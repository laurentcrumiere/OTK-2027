global w_diagnos_maj_vincenti1 w_diagnos_maj_vincenti1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

mle_ant_gene.text = Righttrim(trim(mid(page,1,200)))
mle_ant_fami.text = Righttrim(trim(mid(page,201,200)))

ddlb_respiration.selectitem(integer(mid(page,401,1)))
ddplb_deglutition.selectitem(integer(mid(page,402,1)))
ddplb_phonation.selectitem(integer(mid(page,403,1)))
if mid(page,404,1) = 'O' then
	cbx_suceur.checked = true
else
	cbx_suceur.checked = false
end if
if mid(page,405,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page,406,1) = 'O' then
	cbx_bruxisme.checked = true
else
	cbx_bruxisme.checked = false
end if

ddlb_amygdales.selectitem(integer(mid(page,407,1)))
ddlb_vegetations.selectitem(integer(mid(page,408,1)))
ddlb_langue.selectitem(integer(mid(page,409,1)))
ddplb_levres.selectitem(integer(mid(page,410,1)))
ddplb_volume.selectitem(integer(mid(page,411,1)))

if mid(page,412,1) = 'O' then
	cbx_douleur.checked = true
else
	cbx_douleur.checked = false
end if
if mid(page,413,1) = 'O' then
	cbx_craquement.checked = true
else
	cbx_craquement.checked = false
end if
if mid(page,414,1) = 'O' then
	cbx_ressaut.checked = true
else
	cbx_ressaut.checked = false
end if
ddlb_chemin.selectitem(integer(mid(page,415,1)))
ddplb_amplitude.selectitem(integer(mid(page,416,1)))

sle_prematurites.text = Righttrim(mid(page,417,30))
mle_paro.text = Righttrim(mid(page,448,150))

if mid(page,600,1) = 'O' then
	cbx_langue.checked = true
else
	cbx_langue.checked = false
end if
if mid(page,601,1) = 'O' then
	cbx_levre_sup.checked = true
else
	cbx_levre_sup.checked = false
end if
if mid(page,602,1) = 'O' then
	cbx_levre_inf.checked = true
else
	cbx_levre_inf.checked = false
end if
em_sag1.text = mid(page,603,3)
em_sag2.text = mid(page,606,3)
em_sag3.text = mid(page,609,3)
em_sag4.text = mid(page,612,3)
em_sag5.text = mid(page,615,3)
em_tran1.text = mid(page,618,3)
em_tran2.text = mid(page,621,3)
em_tran3.text = mid(page,624,3)
em_tran4.text = mid(page,627,3)
em_tran5.text = mid(page,630,3)
ddlb_vert1.selectitem(integer(mid(page,1323,1)))
ddlb_vert2.selectitem(integer(mid(page,1324,1)))
ddlb_vert3.selectitem(integer(mid(page,1325,1)))
ddlb_vert4.selectitem(integer(mid(page,1326,1)))
ddlb_vert5.selectitem(integer(mid(page,1327,1)))

ddlb_milieux.selectitem(integer(mid(page,636,1)))
ddlb_mand.selectitem(integer(mid(page,637,1)))

if mid(page,638,1) = 'O' then
	cbx_haut.checked = true
else
	cbx_haut.checked = false
end if
if mid(page,639,1) = 'O' then
	cbx_bas.checked = true
else
	cbx_bas.checked = false
end if
if mid(page,640,1) = 'O' then
	cbx_ddd.checked = true
else
	cbx_ddd.checked = false
end if

sle_caries.text = Righttrim(mid(page,641,40))
sle_dysplasies.text = Righttrim(mid(page,681,40))

ddlb_hygiene.selectitem(integer(mid(page,721,1)))
ddlb_motivation.selectitem(integer(mid(page,722,1)))

mle_diag.text = RightTrim(mid(page,723,300))
mle_remarques.text = RightTrim(mid(page,1023,300))


end subroutine

event open;
var_code_local = message.doubleparm

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

string vn,vm 
select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

this.title = "Page N°1 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"

init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if


init()


end event

