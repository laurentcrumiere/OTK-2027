global type w_diagnos_maj_bany4 from window
integer x = 5
integer width = 2907
integer height = 1940
boolean titlebar = true
string title = "Page N°4"
windowtype windowtype = response!
long backcolor = 12632256
ole_photo006 ole_photo006
ole_photo005 ole_photo005
ole_photo004 ole_photo004
ole_photo003 ole_photo003
ole_photo002 ole_photo002
ole_photo001 ole_photo001
sle_6 sle_6
sle_5 sle_5
sle_4 sle_4
sle_3 sle_3
sle_2 sle_2
sle_1 sle_1
em_d6 em_d6
em_d5 em_d5
em_d4 em_d4
em_d3 em_d3
em_d2 em_d2
em_d1 em_d1
cb_imprimer cb_imprimer
cb_fermer cb_fermer
cb_annuler cb_annuler
cb_enregistrer cb_enregistrer
end type
global w_diagnos_maj_bany4 w_diagnos_maj_bany4

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_d1.text = trim(mid(page,1300,10))
em_d2.text = trim(mid(page,1310,10))
em_d3.text = trim(mid(page,1320,10))
em_d4.text = trim(mid(page,1330,10))
em_d5.text = trim(mid(page,1340,10))
em_d6.text = trim(mid(page,1350,10))


sle_1.text = RightTrim(mid(page,1360,50))
sle_2.text = RightTrim(mid(page,1450,50))
sle_3.text = RightTrim(mid(page,1500,50))
sle_4.text = RightTrim(mid(page,1550,50))
sle_5.text = RightTrim(mid(page,1600,50))
sle_6.text = RightTrim(mid(page,1650,50))
end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select nom,moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°4 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

end event

