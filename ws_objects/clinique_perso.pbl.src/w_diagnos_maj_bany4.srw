event clicked;place(em_d1.text,page,1300)
place(em_d2.text,page,1310)
place(em_d3.text,page,1320)
place(em_d4.text,page,1330)
place(em_d5.text,page,1340)
place(em_d6.text,page,1350)

place_avec_blancs(sle_1.text,page,1360,50)
place_avec_blancs(sle_2.text,page,1450,50)
place_avec_blancs(sle_3.text,page,1500,50)
place_avec_blancs(sle_4.text,page,1550,50)
place_avec_blancs(sle_5.text,page,1600,50)
place_avec_blancs(sle_6.text,page,1650,50)

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if
end event


