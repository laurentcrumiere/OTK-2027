public subroutine init ();//ddlb_bases.selectitem(integer(mid(page,1300,1)))

ddlb_proalveo_sup.selectitem(integer(mid(page,1301,1)))
ddlb_proalveo_inf.selectitem(integer(mid(page,1302,1)))
ddlb_supra.selectitem(integer(mid(page,1303,1)))
ddlb_retro_sup.selectitem(integer(mid(page,1304,1)))
ddlb_retro_inf.selectitem(integer(mid(page,1305,1)))
ddlb_infra.selectitem(integer(mid(page,1306,1)))
ddlb_vert1.selectitem(integer(mid(page,1307,1)))
ddlb_vert2.selectitem(integer(mid(page,1308,1)))
ddlb_vert3.selectitem(integer(mid(page,1309,1)))
ddlb_vert4.selectitem(integer(mid(page,1310,1)))
ddlb_vert5.selectitem(integer(mid(page,1311,1)))

sle_sag1.text = RightTrim(mid(page,1312,3))
sle_sag2.text = RightTrim(mid(page,1315,3))
sle_sag3.text = RightTrim(mid(page,1318,3))
sle_sag4.text = RightTrim(mid(page,1321,3))
sle_sag5.text = RightTrim(mid(page,1324,3))
sle_tran1.text = RightTrim(mid(page,1327,3))
sle_tran2.text = RightTrim(mid(page,1330,3))
sle_tran3.text = RightTrim(mid(page,1333,3))
sle_tran4.text = RightTrim(mid(page,1336,3))
sle_tran5.text = RightTrim(mid(page,1339,3))

if mid(page,1342,1) = 'O' then
	cbx_sup_ant.checked = true
end if
if mid(page,1343,1) = 'O' then
	cbx_sup_lateral.checked = true
end if
if mid(page,1344,1) = 'O' then
	cbx_sup_post.checked = true
end if
if mid(page,1345,1) = 'O' then
	cbx_inf_ant.checked = true
end if
if mid(page,1346,1) = 'O' then
	cbx_inf_lateral.checked = true
end if
if mid(page,1347,1) = 'O' then
	cbx_inf_post.checked = true
end if
if mid(page,1348,1) = 'O' then
	cbx_ddd.checked = true
end if

sle_diasteme.text = RightTrim(mid(page,1350,20))
sle_surnu.text = RightTrim(mid(page,1370,20))
sle_rc.text = RightTrim(mid(page,1390,20))
sle_inclusion.text = RightTrim(mid(page,1410,20))
sle_prema.text = RightTrim(mid(page,1430,20))

sle_d_haut.text = RightTrim(mid(page,1450,15))
sle_g_haut.text = RightTrim(mid(page,1465,15))
sle_d_bas.text = RightTrim(mid(page,1480,15))
sle_g_bas.text = RightTrim(mid(page,1495,15))

sle_latero.text = Trim(mid(page,1510,20))

sle_d_haut_carie.text = RightTrim(mid(page,1530,15))
sle_g_haut_carie.text = RightTrim(mid(page,1545,15))
sle_d_bas_carie.text = RightTrim(mid(page,1560,15))
sle_g_bas_carie.text = RightTrim(mid(page,1575,15))

sle_dysplasie.text = RightTrim(mid(page,1590,20))
sle_dent.text = RightTrim(mid(page,1610,20))
sle_examen.text = RightTrim(mid(page,1630,20))

mle_remarques.text = RightTrim(mid(page,1650,300))

ddlb_sv.selectitem(integer(mid(page,1951,1)))
ddlb_sap.selectitem(integer(mid(page,1952,1)))
ddlb_st.selectitem(integer(mid(page,1953,1)))

modif = false
cb_fermer.setfocus()
end subroutine

event open;var_code_local = message.doubleparm

string vn,vm 

select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if

this.title = "Page N°3  : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

init()

end event

