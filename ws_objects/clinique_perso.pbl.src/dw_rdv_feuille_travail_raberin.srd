table(column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" dbalias=".nom" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" dbalias=".rdv" initial="today" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_duree dbname="rdv.duree" dbalias=".duree" )
 column=(type=char(6) updatewhereclause=yes name=rdv_code_praticien dbname="rdv.code_praticien" dbalias=".code_praticien" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=due dbname="patient.somme_due" dbalias=".somme_due" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_fauteuil dbname="rdv.fauteuil" dbalias=".fauteuil" )
 column=(type=char(30000) updatewhereclause=yes name=patient_remarques dbname="patient.remarques" dbalias=".remarques" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=date updatewhereclause=yes name=date_proc_reglt dbname="patient.date_proc_reglt" dbalias=".date_proc_reglt" )
 column=(type=decimal(2) updatewhereclause=yes name=mont_proc_reglt dbname="patient.mont_proc_reglt" dbalias=".mont_proc_reglt" )
 column=(type=date updatewhereclause=yes name=cdat_com dbname="dat_com" )
 column=(type=char(30000) updatewhereclause=yes name=cdern_com dbname="dern_com" )
 column=(type=char(30000) updatewhereclause=yes name=cdern_prevu dbname="dern_prevu" )
 column=(type=date updatewhereclause=yes name=cdate_soin dbname="date_soin" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_soin dbname="total_soin" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_paye dbname="total_paye" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 retrieve="  SELECT ~"patient~".~"nom~",   
         ~"patient~".~"code~",   
         ~"rdv~".~"rdv~",   
         ~"type_rdv~".~"nom~",   
         ~"rdv~".~"duree~",   
         ~"rdv~".~"code_praticien~",   
         ~"patient~".~"somme_due~",   
         ~"rdv~".~"fauteuil~",   
         ~"patient~".~"remarques~",   
         ~"patient~".~"moulage~",   
         ~"patient~".~"date_proc_reglt~",   
         ~"patient~".~"mont_proc_reglt~",   
         (SELECT max(dat) As dat_com FROM coment WHERE coment.code = patient.code ),   
         (SELECT max(com) as Dern_com FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code ) and coment.code = patient.code ),   
         (SELECT max(acte_prevu) as Dern_prevu FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code ) and coment.code = patient.code ),   
         (SELECT max(~"date~") as date_soin FROM ligne_soins WHERE patient.code = ligne_soins.code and ~"date~" <= cast(getdate() as date) ),   
         (SELECT isnull(sum(montant),0) as total_soin FROM ligne_soins WHERE patient.code = ligne_soins.code and ~"date~" <=  cast(getdate() as date)),   
         (SELECT isnull(sum(montant),0) as total_paye FROM paye WHERE patient.code = paye.code),   
         ~"patient~".~"prenom~"  
    FROM ~"patient~",   
         ~"rdv~",   
         ~"type_rdv~"  
   WHERE ( ~"patient~".~"code~" = ~"rdv~".~"code~" ) and  
         ( ~"rdv~".~"type~" = ~"type_rdv~".~"code~" ) and  
         ( ( ~"patient~".~"code_praticien~" between :prat_min and :prat_max ) AND  
         ( date(~"rdv~".~"rdv~") = :var_date ) AND  
         ( ~"type_rdv~".~"fauteuil~" between :f_min and :f_max ) )    
" arguments=(("prat_min", string),("prat_max", string),("var_date", date),("f_min", number),("f_max", number))  sort="rdv_rdv A patient_nom A patient_code A " )
