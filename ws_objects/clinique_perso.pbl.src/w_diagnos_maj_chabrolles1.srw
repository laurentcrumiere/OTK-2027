this.ole_photo002=create ole_photo002
this.cb_fermer=create cb_fermer
this.Control[]={this.ole_photo001,&
this.ole_photo006,&
this.ole_photo007,&
this.ole_photo008,&
this.ole_photo009,&
this.ole_photo010,&
this.ole_photo005,&
this.ole_photo004,&
this.ole_photo003,&
this.ole_photo002,&
this.cb_fermer}
end on

