event open;var_code_local = message.doubleparm
string vn,vm 


select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if


this.title = "Photos : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"

//SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;
//
//if isnull(page) then
//	page = space(2000)
//end if
//
//init()

//init_photos(var_code_local)
mep_win_mdi(this,1)
end event

