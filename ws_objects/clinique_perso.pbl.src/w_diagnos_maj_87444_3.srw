forward prototypes
public subroutine gras_rouge (statictext st)
public subroutine somme_6maxilaires ()
public subroutine somme_6mandibule ()
public subroutine somme_12mandibule ()
public subroutine somme_12maxilaires ()
public subroutine bolton_12 ()
