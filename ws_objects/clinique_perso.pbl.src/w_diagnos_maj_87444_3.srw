end prototypes

public subroutine gras_rouge (statictext st);// transforme le contenu d'un statictext en Gras et en Rouge
st.Weight = 700	
st.TextColor = RGB(255,0,0)
end subroutine

public subroutine somme_6maxilaires ();integer somme_maxil_6

somme_maxil_6=Integer(sle_maxil_g_3.Text)+Integer(sle_maxil_g_2.Text)+Integer(sle_maxil_g_1.Text)+Integer(sle_maxil_d_1.Text)+Integer(sle_maxil_d_2.Text)+Integer(sle_maxil_d_3.Text)
sle_maxil_6dents.Text = String(somme_maxil_6)
end subroutine

public subroutine somme_6mandibule ();integer somme_mandib_6

somme_mandib_6=Integer(sle_mand_g_3.Text)+Integer(sle_mand_g_2.Text)+Integer(sle_mand_g_1.Text)+Integer(sle_mand_d_1.Text)+Integer(sle_mand_d_2.Text)+Integer(sle_mand_d_3.Text)
sle_mand_6dents.Text = String(somme_mandib_6)
end subroutine

public subroutine somme_12mandibule ();integer somme_mandib_12

somme_6mandibule()
somme_mandib_12 = Integer(sle_mand_g_6.Text)+Integer(sle_mand_g_5.Text)+Integer(sle_mand_g_4.Text)+Integer(sle_mand_d_4.Text)+Integer(sle_mand_d_5.Text)+Integer(sle_mand_d_6.Text)
somme_mandib_12 = somme_mandib_12 + Integer(sle_mand_6dents.Text)
sle_mand_12dents.Text = String(somme_mandib_12)
end subroutine

public subroutine somme_12maxilaires ();integer somme_maxil_12

somme_6maxilaires()
somme_maxil_12 = Integer(sle_maxil_g_6.Text) + Integer(sle_maxil_g_5.Text) + Integer(sle_maxil_g_4.Text) + Integer(sle_maxil_d_4.Text) + Integer(sle_maxil_d_5.Text) + Integer(sle_maxil_d_6.Text)
somme_maxil_12 = somme_maxil_12 + Integer (sle_maxil_6dents.Text)
sle_maxil_12dents.Text = String(somme_maxil_12)
end subroutine

public subroutine bolton_12 ();Integer Maxil_12, Mandib_12, Bolton_12

Bolton_6()
somme_12mandibule()
somme_12maxilaires()

Mandib_12 = Integer(sle_mand_12dents.Text)
Maxil_12 = Integer(sle_maxil_12dents.Text)

if Maxil_12 = 0 then
	sle_bolton_12dents.Text = "Err."
else
	sle_bolton_12dents.text = Left(String(Mandib_12 / Maxil_12),5)
end if
end subroutine

public subroutine bolton_6 ();Integer Maxil_6, Mandib_6, Bolton_6

somme_6mandibule()
somme_6maxilaires()

Mandib_6 = Integer(sle_mand_6dents.Text)
Maxil_6 = Integer(sle_maxil_6dents.Text)

if Maxil_6 = 0 then
	sle_bolton_6dents.Text = "Err."
else
	sle_bolton_6dents.text = Left(String(Mandib_6 / Maxil_6),5)
end if
end subroutine

