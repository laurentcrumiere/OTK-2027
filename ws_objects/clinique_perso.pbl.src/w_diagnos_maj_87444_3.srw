public function boolean mise_en_valeur (statictext st);Integer taille

taille = st.Weight
if taille = 400 then
	gras_rouge(st)
	return true
else
	st.Weight = 400	
	st.TextColor = RGB(0,0,0)
	return false
end if
end function

