global w_diagnos_maj_swartberg2 w_diagnos_maj_swartberg2

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();em_tele_1.text = Trim(mid(page,540,10))
em_tele_2.text = Trim(mid(page,550,10))
em_tele_3.text = Trim(mid(page,560,10))
em_pano_1.text = Trim(mid(page,570,10))
em_pano_2.text = Trim(mid(page,580,10))
em_pano_3.text = Trim(mid(page,590,10))
em_atm_1.text = Trim(mid(page,600,10))
em_atm_2.text = Trim(mid(page,610,10))
em_atm_3.text = Trim(mid(page,620,10))
em_ap_1.text = Trim(mid(page,630,10))
em_ap_2.text = Trim(mid(page,640,10))
em_ap_3.text = Trim(mid(page,650,10))
em_poig_1.text = Trim(mid(page,660,10))
em_poig_2.text = Trim(mid(page,670,10))
em_poig_3.text = Trim(mid(page,680,10))
em_emp_1.text = Trim(mid(page,690,10))
em_emp_2.text = Trim(mid(page,700,10))
em_emp_3.text = Trim(mid(page,710,10))
em_photo_1.text = Trim(mid(page,720,10))
em_photo_2.text = Trim(mid(page,730,10))
em_photo_3.text = Trim(mid(page,740,10))

if mid(page,750,1) = '1' OR mid(page,750,1) = ' ' then
	rb_omni.checked = true
else
	if mid(page,750,1) = '2' then
		rb_medecin.checked = true
	else
		rb_autre.checked = true
	end if
end if

if mid(page,751,1) = '1' then
	rb_patient.checked = true
else
	rb_corres.checked = true
end if

if mid(page,752,1) = '1' OR mid(page,752,1) = ' ' then
	rb_sante_ras.checked = true
else
	rb_sante.checked = true
end if

if mid(page,753,1) = '1' OR mid(page,753,1) = ' ' then
	rb_medi_ras.checked = true
else
	rb_medi.checked = true
end if

if mid(page,754,1) = '1' OR mid(page,754,1) = ' ' then
	rb_aden_ras.checked = true
else
	rb_aden.checked = true
end if

if mid(page,755,1) = '1' OR mid(page,755,1) = ' ' then
	rb_allerg_ras.checked = true
else
	if mid(page,755,1) = '2' then
		rb_allerg_rhume.checked = true
	else
		rb_allerg_autre.checked = true
	end if
end if

if mid(page,756,1) = '1' OR mid(page,756,1) = ' ' then
	rb_trauma_ras.checked = true
else
	rb_trauma.checked = true
end if

if mid(page,757,1) = '1' OR mid(page,757,1) = ' ' then
	rb_odf_non.checked = true
else
	rb_odf_oui.checked = true
end if


mle_cores_autre.text = Righttrim(mid(page,758,45))
mle_consul.text = Righttrim(mid(page,803,62))
mle_sante.text = Righttrim(mid(page,865,73))
mle_medicament.text = Righttrim(mid(page,938,73))
mle_aden.text = Righttrim(mid(page,1011,73))
mle_allerg.text = Righttrim(mid(page,1084,45))
mle_trauma.text = Righttrim(mid(page,1129,73))


sle_appa.text = Righttrim(mid(page,1202,30))
sle_par.text = Righttrim(mid(page,1232,28))
sle_de.text = Righttrim(mid(page,1260,35))
sle_a.text = Righttrim(mid(page,1295,35))

modif = false
end subroutine

event open;
var_code_local = message.doubleparm

string vn,vm 
date vd
select nom,moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if


this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Date de naissance : " + string(vd,'dd/mm/yyyy') + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if



init()
//init_photos(var_code_local)

end event

