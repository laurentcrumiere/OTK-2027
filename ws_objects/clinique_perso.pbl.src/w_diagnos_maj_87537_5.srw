type cb_signer from commandbutton within w_diagnos_maj_87537_5
integer x = 2939
integer y = 2072
integer width = 535
integer height = 92
integer taborder = 110
boolean bringtotop = true
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Signer"
end type

event clicked;string v_prat

maj_signature = true


if v_signe = 'O' then 
	// On déjà signé ...
	// => c'est pour annuler 
	// => On prend la signature du signatire
	v_prat = v_signataire
else
	v_prat = dw_prati.gettext()
end if

ok_mdp = false


  SELECT "prati"."pasfin"  
	 INTO :pasfin  
	 FROM "dba"."prati"  
	WHERE "prati"."code" = :v_prat ;
	
	
open(w_mot_passe_chu)

	
if ok_mdp then

	if v_signe = 'O' then
		// c'était déjà signé
		// => on désigne !!
		v_signe = 'N'
	else
		// On signe
		v_signe = 'O' 
		v_signataire = v_prat
	end if

	info_signature(v_signe)
end if



end event

