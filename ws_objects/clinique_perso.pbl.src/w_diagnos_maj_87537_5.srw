// max carac = 5591



// pour la dw du haut pour le patient
dw_patient.settransobject(sqlca)
dw_patient.retrieve(var_code_local)


// pour la signature
dw_prati.settransobject(sqlca)
dw_prati.retrieve()

// Le champ plus2 servira à stocker si la page 5 est signée ou pas
// vaudra "O" si signée

// le champ remarques de diagnos servira à la signature de la page 5
select isnull(plus2,'N'), isnull(remarques,'') 
into :v_signe, :v_signataire from diagnos  where code = :var_code_local ;

if v_signataire <> '' then
	dw_prati.Scrolltorow(dw_prati.Find("code = '"+ v_signataire+"'", 0, 9999))
end if

info_signature(v_signe)
end subroutine

public subroutine info_signature (string vv_signe);if vv_signe = "O" then
	// déjà signé
	cb_signer.text = "Annul. Signer"
	
	// On doit verrouiller des trucs !!!!
	mle_2.enabled = false
	// La date
	sle_10.enabled = false
	dw_prati.enabled = false
else
	// pas encore
	cb_signer.text = "Signer"
	
	// On doit déverrouiller des trucs !!!!
	mle_2.enabled = true
	// La date
	sle_10.enabled = true
	dw_prati.enabled = true
end if
end subroutine

