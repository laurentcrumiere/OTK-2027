global w_diagnos_maj_bourdillat3 w_diagnos_maj_bourdillat3

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_d1.text = Righttrim(trim(mid(page,3500,7)))
em_d2.text = Righttrim(trim(mid(page,3510,7)))
em_d3.text = Righttrim(trim(mid(page,3520,7)))
em_d4.text = Righttrim(trim(mid(page,3530,7)))
em_d5.text = Righttrim(trim(mid(page,3540,7)))
em_d6.text = Righttrim(trim(mid(page,3550,7)))
em_d7.text = Righttrim(trim(mid(page,3560,7)))
em_d8.text = Righttrim(trim(mid(page,3570,7)))
em_d9.text = Righttrim(trim(mid(page,3580,7)))
em_d10.text = Righttrim(trim(mid(page,3590,7)))
em_d11.text = Righttrim(trim(mid(page,3600,7)))
em_d12.text = Righttrim(trim(mid(page,3610,7)))
em_d13.text = Righttrim(trim(mid(page,3620,7)))
em_d14.text = Righttrim(trim(mid(page,3630,7)))
em_d15.text = Righttrim(trim(mid(page,3640,7)))
em_d16.text = Righttrim(trim(mid(page,3650,7)))
em_d17.text = Righttrim(trim(mid(page,3660,7)))
em_d18.text = Righttrim(trim(mid(page,3670,7)))
em_d19.text = Righttrim(trim(mid(page,3680,7)))
em_d20.text = Righttrim(trim(mid(page,3690,7)))

cb_fermer.setfocus()
end subroutine

event open;var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, mois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°3 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+") Praticien : BOURDILLAT"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(6000)
end if

if len(page) < 6000 then
	page = page + space(6000 - len(page))
end if

init()

end event

