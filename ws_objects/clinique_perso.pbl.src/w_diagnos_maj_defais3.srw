global w_diagnos_maj_defais3 w_diagnos_maj_defais3

type variables
double var_code_local 
String var_nom_local,moul_local
string page
end variables

event open;var_code_local = message.doubleparm
string vn,vm 


select nom,moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if


this.title = "Page N°3 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"
//
//SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;
//
//if isnull(page) then
//	page = space(2000)
//end if
//
end event

