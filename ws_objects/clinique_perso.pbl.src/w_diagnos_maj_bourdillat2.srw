type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
private subroutine place_avec_blancs_sp (string text, ref string bd_page, integer position1, integer position2, integer lg)
public subroutine init ()
end prototypes

private subroutine place_avec_blancs_sp (string text, ref string bd_page, integer position1, integer position2, integer lg);integer l_txt,l_page
string s1,s2

l_txt = len(text)
l_page = len(BD_page)


if l_txt <= lg then
	s1 = text + space(lg - l_txt)
	BD_page = left(BD_page,position1 - 1) + s1 + right(BD_page, l_page - lg - position1 + 1)
	s2=space(lg)
	BD_page = left(BD_page,position2 - 1)+ s2 + right(BD_page, l_page - lg - position2 + 1)
else
	s1=left(text,lg)
	s2=right(text,lg)
	l_txt=len(s2)
	s2 = s2 + space(lg - l_txt)
	BD_page = left(BD_page,position1 - 1) + s1 + right(BD_page, l_page - lg - position1 + 1)
	BD_page = left(BD_page,position2 - 1)+ s2 + right(BD_page, l_page - lg - position2 + 1)
end if
end subroutine

public subroutine init ();ddlb_arcade.selectitem(integer(mid(page,2150,1)))
ddlb_coop.selectitem(integer(mid(page,2151,1)))

if mid(page,2152,1) = '1' OR mid(page,2152,1) = ' ' then
	rb_pat_bonne.checked = true
else
	if mid(page,2152,1) = '2' then
		rb_pat_moy.checked = true
	else
		rb_pat_auc.checked = true
	end if
end if
if mid(page,2153,1) = '1' OR mid(page,2153,1) = ' ' then
	rb_par_bonne.checked = true
else
	if mid(page,2153,1) = '2' then
		rb_par_moy.checked = true
	else
		rb_par_auc.checked = true
	end if
end if

em_traitement.text = RightTrim(mid(page,2154,2))
em_ttt_actif.text = RightTrim(mid(page,2156,2))
em_interception.text = RightTrim(mid(page,2158,2))
em_suspension.text = RightTrim(mid(page,2160,2))
em_phase.text = RightTrim(mid(page,2162,2))
em_contention.text = RightTrim(mid(page,2164,2))

em_date_fin.text = RightTrim(mid(page,2170,10))

em_ext_d_haut.text =  RightTrim(mid(page,2180,15))
em_ext_g_haut.text =  RightTrim(mid(page,2195,15))
em_ext_d_bas.text =  RightTrim(mid(page,2210,15))
em_ext_g_bas.text =  RightTrim(mid(page,2225,15))

em_demande.text =  RightTrim(mid(page,2240,20))
em_date.text =  RightTrim(mid(page,2260,10))
em_effectue.text =  RightTrim(mid(page,2270,20))

mle_hobbies.text = Righttrim(mid(page,2290,20))
mle_sports.text = Righttrim(mid(page,2310,20))

mle_plan1.text = RightTrim(mid(page,2400,100)) + RightTrim(mid(page,3800,100))	//mle_plan1.text = RightTrim(mid(page,2400,100))
mle_plan2.text = RightTrim(mid(page,2500,100)) + RightTrim(mid(page,3900,100))	//mle_plan2.text = RightTrim(mid(page,2500,100))
mle_plan3.text = RightTrim(mid(page,2600,100)) + RightTrim(mid(page,4100,100))	//mle_plan3.text = RightTrim(mid(page,2600,100))
mle_plan4.text = RightTrim(mid(page,2700,100)) + RightTrim(mid(page,4200,100))	//mle_plan4.text = RightTrim(mid(page,2700,100))
mle_plan5.text = RightTrim(mid(page,2800,100)) + RightTrim(mid(page,4300,100))	//mle_plan5.text = RightTrim(mid(page,2800,100))
mle_plan6.text = RightTrim(mid(page,2900,100)) + RightTrim(mid(page,4400,100))	//mle_plan6.text = RightTrim(mid(page,2900,100))

mle_asurveiller.text = RightTrim(mid(page,3000,300))
mle_reevaluation.text = RightTrim(mid(page,3300,200))

//ne souhaite plus de liaison avec diag de feuille de sécu
		//string diag
		//
		//SELECT traitement_effectue INTO :diag FROM patient WHERE code = :var_code_local ;
		//mle_diag.text = diag
mle_diag.text=RightTrim(mid(page,900,250))

modif = false
cb_fermer.setfocus()

end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+") Praticien : BOURDILLAT"

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(6000)
end if

if len(page) < 6000 then
	page = page + space(6000 - len(page))
end if

init()

end event

