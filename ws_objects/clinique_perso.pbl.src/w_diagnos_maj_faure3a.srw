global w_diagnos_maj_faure3a w_diagnos_maj_faure3a

type variables
double var_code_local 
string page
boolean modif
uo_fx_pages_cliniques f
end variables

forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lirepage(em_date1,page,10,10)
f.lirepage(em_date2,page,20,10)
f.lirepage(em_date3,page,30,10)
f.lirepage(em_date4,page,40,10)
f.lirepage(em_date5,page,50,10)
f.lirepage(em_date6,page,60,10)

f.lirepage(mle_1,page,70,110)
f.lirepage(mle_2,page,180,110)
f.lirepage(mle_3,page,290,110)
f.lirepage(mle_4,page,400,110)
f.lirepage(mle_5,page,510,110)
f.lirepage(mle_6,page,620,110)

f.lirepage(mle_remarques,page,730,300)		//max carac = 1050


cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(em_date1,page,10,10)
f.ecrirepage(em_date2,page,20,10)
f.ecrirepage(em_date3,page,30,10)
f.ecrirepage(em_date4,page,40,10)
f.ecrirepage(em_date5,page,50,10)
f.ecrirepage(em_date6,page,60,10)

f.ecrirepage(mle_1,page,70,110)
f.ecrirepage(mle_2,page,180,110)
f.ecrirepage(mle_3,page,290,110)
f.ecrirepage(mle_4,page,400,110)
f.ecrirepage(mle_5,page,510,110)
f.ecrirepage(mle_6,page,620,110)

f.ecrirepage(mle_remarques,page,730,300)		//max carac = 1050


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

event open;var_code_local = message.doubleparm

string vn,vp
date vd
integer an, mois

select nom, prenom, date_naissance INTO :vn,:vp,:vd FROM patient WHERE code = :var_code_local ;

if isnull(vn) then
	vn = ""
end if
if isnull(vp) then
	vp = ""
end if
if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page Clinique : " + vn + " " + vp +" - N° dossier : "+string(var_code_local) + " - Age : " + string(an) + " ans " + string(mois) + " mois "

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

mep_win_mdi(this,1)
init()

end event

