public subroutine test_dent (checkbox haut, checkbox bas, statictext dent);// met le n° de dent en fond JAUNE si une des 2 cases (haut & bas) est cochée.
// De même si les 2 cases sont cochées.
// Sinon, fond GRIS

if haut.checked OR bas.checked then dent.BackColor = RGB(255,255,0) else dent.BackColor = RGB(240,240,240)
end subroutine

