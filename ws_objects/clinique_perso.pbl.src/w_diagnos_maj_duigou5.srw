global w_diagnos_maj_duigou5 w_diagnos_maj_duigou5

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();string rem,pt


//SELECT remarques INTO :rem FROM diagnos WHERE code = :var_code_local ;
SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;


mle_plan_traitement.text = pt
mle_remarques.text = RightTrim(mid(page,1000,500))

modif = false

end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if isnull(vd) then
	vd = Today()
end if


if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°5 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()

end event

