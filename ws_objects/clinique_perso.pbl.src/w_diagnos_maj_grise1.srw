em_gingivite.text =  trim(mid(page,78,6))
em_poche.text =  trim(mid(page,84,6))
em_plaque.text =  trim(mid(page,90,4))
em_freins.text =  trim(mid(page,94,6))
em_brides.text =  trim(mid(page,100,6))

em_6d.text =  trim(mid(page,106,4))
em_3d.text =  trim(mid(page,110,4))
em_6g.text =  trim(mid(page,114,4))
em_3g.text =  trim(mid(page,118,4))
em_oj.text =  trim(mid(page,122,3))
em_ob.text =  trim(mid(page,125,3))

em_plan.text =  trim(mid(page,128,8))
em_rapports.text =  trim(mid(page,136,10))
em_milieux.text =  trim(mid(page,146,10))
em_extraction.text =  trim(mid(page,156,10))
em_agenesie.text =  trim(mid(page,166,10))
em_obturation.text =  trim(mid(page,176,10))
em_protheses.text =  trim(mid(page,186,10))
em_carie.text =  trim(mid(page,196,10))

em_chemin.text =  trim(mid(page,206,10))
em_respiration.text =  trim(mid(page,216,12))
em_phonation.text =  trim(mid(page,228,12))
em_deglutition.text =  trim(mid(page,240,12))
em_vision.text =  trim(mid(page,252,12))
em_succion.text =  trim(mid(page,264,12))
em_posture.text =  trim(mid(page,276,12))

em_claquements.text =  trim(mid(page,288,10))
em_ressauts.text =  trim(mid(page,298,10))
em_douleurs.text =  trim(mid(page,308,10))
em_irradiations.text =  trim(mid(page,318,8))

em_heredite.text =  trim(mid(page,326,5))
em_accident.text =  trim(mid(page,331,5))
em_interventions.text =  trim(mid(page,336,5))
em_allergies.text =  trim(mid(page,341,6))
em_pulmonaires.text =  trim(mid(page,353,6))
em_hepatiques.text =  trim(mid(page,359,6))
em_cardiaques.text =  trim(mid(page,365,6))
em_sanguin.text =  trim(mid(page,371,6))
em_traitement.text =  trim(mid(page,377,10))
em_sports.text =  trim(mid(page,387,6))
em_hobbies.text =  trim(mid(page,393,6))

if mid(page,399,1) = "O" then
	cbx_amyg.checked = true
else
	cbx_amyg.checked = false
end if

if mid(page,400,1) = "O" then
	cbx_norm.checked = true
else
	cbx_norm.checked = false
end if
if mid(page,401,1) = "O" then
	cbx_volum.checked = true
else
	cbx_volum.checked = false
end if
if mid(page,402,1) = "O" then
	cbx_vege.checked = true
else
	cbx_vege.checked = false
end if




end subroutine

event open;
var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select  trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°1 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

end event

