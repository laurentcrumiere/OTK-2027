forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false
em_face.text =  trim(mid(page,1,13))
em_levres.text =  trim(mid(page,14,13))
em_nez.text =  trim(mid(page,27,13))
em_symetrie.text =  trim(mid(page,40,10))
em_profil.text =  trim(mid(page,50,10))
