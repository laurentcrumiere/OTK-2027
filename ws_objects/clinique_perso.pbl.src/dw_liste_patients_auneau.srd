 column=(type=date updatewhereclause=yes name=fin_semestre_4 dbname="fin_semestre_4" )
 column=(type=char(20) updatewhereclause=yes name=nom_semestre_4 dbname="nom_semestre_4" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_semestre_4 dbname="montant_semestre_4" )
 column=(type=date updatewhereclause=yes name=demande_semestre_5 dbname="demande_semestre_5" )
 column=(type=date updatewhereclause=yes name=fin_semestre_5 dbname="fin_semestre_5" )
 column=(type=char(20) updatewhereclause=yes name=nom_semestre_5 dbname="nom_semestre_5" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_semestre_5 dbname="montant_semestre_5" )
 column=(type=date updatewhereclause=yes name=demande_semestre_6 dbname="demande_semestre_6" )
 column=(type=date updatewhereclause=yes name=fin_semestre_6 dbname="fin_semestre_6" )
 column=(type=char(20) updatewhereclause=yes name=nom_semestre_6 dbname="nom_semestre_6" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_semestre_6 dbname="montant_semestre_6" )
 column=(type=date updatewhereclause=yes name=demande_semestre_7 dbname="demande_semestre_7" )
 column=(type=date updatewhereclause=yes name=fin_semestre_7 dbname="fin_semestre_7" )
 column=(type=char(20) updatewhereclause=yes name=nom_semestre_7 dbname="nom_semestre_7" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_semestre_7 dbname="montant_semestre_7" )
 column=(type=date updatewhereclause=yes name=demande_semestre_8 dbname="demande_semestre_8" )
 column=(type=date updatewhereclause=yes name=fin_semestre_8 dbname="fin_semestre_8" )
 column=(type=char(20) updatewhereclause=yes name=nom_semestre_8 dbname="nom_semestre_8" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_semestre_8 dbname="montant_semestre_8" )
 column=(type=date updatewhereclause=yes name=demande_contention_1 dbname="demande_contention_1" )
 column=(type=date updatewhereclause=yes name=fin_contention_1 dbname="fin_contention_1" )
 column=(type=char(20) updatewhereclause=yes name=nom_contention_1 dbname="nom_contention_1" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_contention_1 dbname="montant_contention_1" )
 column=(type=date updatewhereclause=yes name=demande_contention_2 dbname="demande_contention_2" )
 column=(type=date updatewhereclause=yes name=fin_contention_2 dbname="fin_contention_2" )
 column=(type=char(20) updatewhereclause=yes name=nom_contention_2 dbname="nom_contention_2" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_contention_2 dbname="montant_contention_2" )
 column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" )
 column=(type=char(60) updatewhereclause=yes name=nom_correspondant dbname="nom_correspondant" )
 column=(type=datetime updatewhereclause=yes name=dernier_rdv_honore dbname="dernier_rdv_honore" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 retrieve="  SELECT   ~"patient~".~"nom~" + ' ' + isnull(~"patient~".~"prenom~", '' ) as nom,   
		~"patient~".~"adulte~",   
         ~"mutuelle~".~"nom~" as nom_mutuelle,
         (select min(date_demande) from soins where soins.code = patient.code and ~"soins~".~"type~" = 'CS') as date_premiere_cs,   
         (select min(date_demande) from soins where soins.code = patient.code and ~"soins~".~"type~" in  ('DA', 'DAA')) as date_bilan,   
         ~"patient~".~"debut_traitement~"  ,
         ~"patient~".~"duree_traitement~" as nombre_semestres_prevus ,
		(select count(*) from soins where soins.code = patient.code and soins.date_demande < today(*) and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as nombre_semestres_effectues,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 1 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as demande_semestre_1 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 1 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as fin_semestre_1 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 1 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as nom_semestre_1 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 1 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%') or nom like ('FDO%' ) ) ) as montant_semestre_1,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 2 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as demande_semestre_2 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 2 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as fin_semestre_2 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 2 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as nom_semestre_2 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 2 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%') or nom like ('FDO%' )) ) as montant_semestre_2,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 3 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as demande_semestre_3 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 3 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as fin_semestre_3 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 3 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as nom_semestre_3 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 3 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%') or nom like ('FDO%' )) ) as montant_semestre_3,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 4 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as demande_semestre_4 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 4 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as fin_semestre_4 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 4 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as nom_semestre_4 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 4 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%') or nom like ('FDO%' )) ) as montant_semestre_4,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 5 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as demande_semestre_5 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 5 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as fin_semestre_5 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 5 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as nom_semestre_5 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 5 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%') or nom like ('FDO%' )) ) as montant_semestre_5 ,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 6 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as demande_semestre_6 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 6 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as fin_semestre_6 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 6 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as nom_semestre_6 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 6 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%') or nom like ('FDO%' )) ) as montant_semestre_6,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 7 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as demande_semestre_7 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 7 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as fin_semestre_7 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 7 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as nom_semestre_7 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 7 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%') or nom like ('FDO%' )) ) as montant_semestre_7,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 8 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as demande_semestre_8 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 8 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as fin_semestre_8 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 8 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%')) ) as nom_semestre_8 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 8 and ~"type~" in (select code from code_soins where nom like ('%SEMESTRE%') or nom like ('FDO%' )) ) as montant_semestre_8,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 1 and ~"type~" in (select code from code_soins where nom like ('%- CONTENTION%')) ) as demande_contention_1 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 1 and ~"type~" in (select code from code_soins where nom like ('%- CONTENTION%')) ) as fin_contention_1 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 1 and ~"type~" in (select code from code_soins where nom like ('%- CONTENTION%')) ) as nom_contention_1 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 1 and ~"type~" in (select code from code_soins where nom like ('%- CONTENTION%') ) ) as montant_contention_1 ,

		(select top 1 date_demande from soins where soins.code = patient.code and numero = 2 and ~"type~" in (select code from code_soins where nom like ('%- CONTENTION%')) ) as demande_contention_2 ,
		(select top 1 date_exe from soins where soins.code = patient.code and numero = 2 and ~"type~" in (select code from code_soins where nom like ('%- CONTENTION%')) ) as fin_contention_2 ,
		(select top 1 code_soins.code from soins, code_soins where code_soins.code = soins.~"type~" and soins.code = patient.code and numero = 2 and ~"type~" in (select code from code_soins where nom like ('%- CONTENTION%')) ) as nom_contention_2 ,
		(select top 1 sum(total) from soins where soins.code = patient.code and numero = 2 and ~"type~" in (select code from code_soins where nom like ('%- CONTENTION%') ) ) as montant_contention_2,

		~"dossier~".~"nom~" ,
		~"correspondants~".~"nom~" + isnull(~"correspondants~".~"prenom~" ,'') as nom_correspondant ,
		(select max(rdv) from rdv where rdv.code = patient.code and absent in (select code from etat_rdv where elimine_agenda = 'N') and date(rdv) <= today(*) ) as dernier_rdv_honore ,

		~"patient~".~"code~" as code ,
		~"patient~".~"numero_dossier~" as numero_dossier


    FROM ~"patient~",   
         ~"mutuelle~",
		~"correspondants~"  ,
~"dossier~"
   WHERE ( ~"mutuelle~".~"code~" = ~"patient~".~"code_mutuelle~" )  and (~"correspondants~".~"code~" = ~"patient~".~"code_correspondant~") and (~"dossier~".~"code~" = ~"patient~".~"type_dossier~")
		 and (  ~"patient~".~"numero_dossier~"  between  :v_numero_dossier_min and :v_numero_dossier_max  ) 
		and (  ~"patient~".~"type_dossier~"  between  :v_type_dossier_min and :v_type_dossier_max       ) 
" arguments=(("v_numero_dossier_min", number),("v_numero_dossier_max", number),("v_type_dossier_min", string),("v_type_dossier_max", string)) )
