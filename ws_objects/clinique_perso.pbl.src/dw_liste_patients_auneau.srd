table(column=(type=char(81) updatewhereclause=yes name=nom dbname="nom" )
 column=(type=char(1) updatewhereclause=yes name=patient_adulte dbname="patient.adulte" )
 column=(type=char(30) updatewhereclause=yes name=nom_mutuelle dbname="mutuelle.nom_mutuelle" )
 column=(type=date updatewhereclause=yes name=date_premiere_cs dbname="date_premiere_cs" )
 column=(type=date updatewhereclause=yes name=date_bilan dbname="date_bilan" )
 column=(type=date updatewhereclause=yes name=patient_debut_traitement dbname="patient.debut_traitement" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_nombre_semestres_prevus dbname="patient.nombre_semestres_prevus" )
 column=(type=long updatewhereclause=yes name=nombre_semestres_effectues dbname="nombre_semestres_effectues" )
