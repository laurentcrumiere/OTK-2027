event clicked;string diagnos, artic_inv

artic_inv = ""

// Diagnostic dentaire

diagnos = "DENTAIRE :"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)


if rb_occ_def.checked then diagnos = diagnos + "- Occlusion en denture définitive"
if rb_occ_mixte.checked then diagnos = diagnos + "- Occlusion en denture mixte"
if cbx_occ_ddm.checked then diagnos = diagnos + ", DDM, Malpositions"
if cbx_occ_malp.checked then diagnos = diagnos + ", Malpositions importantes"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_cl1_dte.checked then diagnos = diagnos + "- en classe 1 à droite"
if rb_cl2_dte.checked then diagnos = diagnos + "- en classe 2 à droite"
if rb_cl3_dte.checked then diagnos = diagnos + "- en classe 3 à droite"

if rb_cl1_gau.checked then diagnos = diagnos + ", en classe 1 à gauche"
if rb_cl2_gau.checked then diagnos = diagnos + ", en classe 2 à gauche"
if rb_cl3_gau.checked then diagnos = diagnos + ", en classe 3 à gauche"

// passage à la ligne
// diagnos = diagnos + char(13) + char(10)

if cbx_art_inv_anté.checked then artic_inv = artic_inv + "antérieur "
if cbx_art_dent.checked then artic_inv = artic_inv + " de " + sle_dents.text
if cbx_art_lat_drt.checked then artic_inv = artic_inv + " latéral droit "
if cbx_art_lat_gau.checked then artic_inv = artic_inv + " latéral gauche"
if artic_inv <> "" then diagnos = diagnos + char(13) + char(10) + "- Articulé inversé " + artic_inv

if sle_supra.text <> "" then diagnos = diagnos + ", Supra " + sle_supra.text + " mm "
if sle_surplomb.text <> "" then diagnos = diagnos + ", Surplomb " + sle_surplomb.text + " mm "
if sle_infracl.text <> "" then diagnos = diagnos + ", Infraclusion " + sle_infracl.text + " mm "
if sle_decal.text <> "" then diagnos = diagnos + ", Décalage des centres " + sle_decal.text + " mm"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if sle_agé.text <> "" then diagnos = diagnos + "- Agénésies de " + sle_agé.text
if sle_inclu.text <> "" then diagnos = diagnos + " , inclusion de " + sle_inclu.text
if sle_carie.text <> "" then diagnos = diagnos + " , carie sur " + sle_carie.text
if sle_délab.text <> "" then diagnos = diagnos + "  , délabrement important de " + sle_délab.text
if sle_persist.text <> "" then diagnos = diagnos + "  , persistance de " + sle_persist.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_réces_géné.checked then diagnos = diagnos + "- récessions gingivales généralisées "
if rb_réces_sur.checked then diagnos = diagnos + "- récessions gingivales sur " + sle_réces_sur.text
if cbx_plaq.checked then diagnos = diagnos + " , Plaque "
if cbx_gingiv.checked then diagnos = diagnos + " , gingivite "
if cbx_retard.checked then diagnos = diagnos + " , retard dentaire "
if sle_émail.text <> "" then diagnos = diagnos + " , tâches de l'émail sur " + sle_émail.text
if cbx_usure.checked then diagnos = diagnos + " , usure dentaire"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if cbx_pres_8.checked then diagnos = diagnos + "- Présence des 8 "
if cbx_abs_8.checked then diagnos = diagnos + "- absence des 8 sur la pano "
if sle_pres.text <> "" then diagnos = diagnos + " , présence de " + sle_pres.text
if cbx_diast.checked then diagnos = diagnos + ", diastème 11 - 21 "
if sle_abs.text <> "" then diagnos = diagnos + ", absence de " + sle_abs.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if sle_dentaire.text <> "" then diagnos = diagnos + "- " + sle_dentaire.text

// passage à la ligne double
diagnos = diagnos + char(13) + char(10) + char(13) + char(10)


//
//
// D i a g n o s t i c       F o n c t i o n n e l
//
//

diagnos = diagnos + "FONCTIONNEL :"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_interp_lat.checked then diagnos = diagnos + "- Interposition linguale latérale "
if rb_interp_ant.checked then diagnos = diagnos + "- Interposition linguale antérieure "
if rb_interp_tot.checked then diagnos = diagnos + "- Interposition linguale totale "
if cbx_interp_lab.checked then diagnos = diagnos + "- Interposition labiale"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if cbx_fr_ling.checked then diagnos = diagnos + "- Frein lingual court "
if cbx_fr_lab.checked then diagnos = diagnos + "- Frein labial supérieur hypertrophique"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if cbx_atm_dte.checked then diagnos = diagnos + "- Sub luxation ATM droite "
if cbx_atm_gau.checked then diagnos = diagnos + "- Sub luxation ATM gauche "
if cbx_brux.checked then diagnos = diagnos + ", Bruxisme "
if cbx_suc_pouce.checked then diagnos = diagnos + ", Succion pouce "
if cbx_ventil.checked then diagnos = diagnos + ", Ventilation buccale"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if sle_fonct.text <> "" then diagnos = diagnos + "- " + sle_fonct.text

// passage à la ligne
diagnos = diagnos + char(13) + char(10) + char(13) + char(10)



//
//
//     D i a g n o s t i c       S q u e l e t t i q u e
//
//


diagnos = diagnos + "SQUELETTIQUE ET ALVEOLAIRE :"
// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_cl1_sque.checked then diagnos = diagnos + "- Classe squelettique 1 "
if rb_cl2_sque.checked then diagnos = diagnos + "- Classe squelettique 2 "
if rb_cl3_sque.checked then diagnos = diagnos + "- Classe squelettique 3 "
if cbx_cl_sque_imp.checked then diagnos = diagnos + " importante"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if rb_normo.checked then diagnos = diagnos + "- Normodivergence "
if rb_hypo.checked then diagnos = diagnos + "- Hypodivergence "
if rb_hyper.checked then diagnos = diagnos + "- Hyperdivergence "
if cbx_import.checked then diagnos = diagnos + " importante"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if cbx_prov_sup.checked then diagnos = diagnos + "- Proversion incisive supérieure "
if cbx_prov_inf.checked then diagnos = diagnos + "- Proversion incisive inférieure "
if cbx_rétro_sup.checked then diagnos = diagnos + "- Rétroversion incisive supérieure "
if cbx_rétro_inf.checked then diagnos = diagnos + "- Rétroversion incisive inférieure "
if cbx_verti.checked then diagnos = diagnos + "- Asymétrie mandibulaire verticale"
if cbx_sagi.checked then diagnos = diagnos + "- Asymétrie mandibulaire sagittale"

// passage à la ligne
diagnos = diagnos + char(13) + char(10)

if sle_sque.text <> "" then diagnos = diagnos + "- " + sle_sque.text

// mle_1.visible = true

// mle_1.text = diagnos



// Mise à jour du Diagnostic patient

string	lstr_diag, lstr_diag_rtf

// zone "diagnostic"
select traitement_effectue_html, traitement_effectue  into :lstr_diag, :lstr_diag_rtf from patient where patient.code = :var_code_local ;

// Ajout du commentaire
lstr_diag = diagnos
lstr_diag_rtf = string_to_rtf(diagnos,couleur_noire,couleur_blanche)

// Mise à jour du Diagnostic
Update patient
Set traitement_effectue_html = :lstr_diag, traitement_effectue = :lstr_diag_rtf
Where patient.code = :var_code_local ;
Commit;
sle_result.visible = true
sle_result.text = "Transfert OK"
end event

