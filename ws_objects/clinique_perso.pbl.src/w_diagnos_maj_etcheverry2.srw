global w_diagnos_maj_etcheverry2 w_diagnos_maj_etcheverry2

type variables
double var_code_local 
boolean modif
string page
uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lire_pt(mle_plan_traitement,var_code_local)
f.lire_d(mle_diag_clin,var_code_local)

f.lirepage(cbx_ds1,page,1)
f.lirepage(cbx_ds2,page,2)
f.lirepage(cbx_ds3,page,3)
f.lirepage(cbx_ds4,page,4)

f.lirepage(sle_agenesie,page,5,50)
f.lirepage(sle_surnum,page,55,50)
f.lirepage(mle_remarques,page,105,200)
f.lirepage(mle_diag_cephal,page,305,300)	//max carac = 605


cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrire_pt(mle_plan_traitement,var_code_local)
f.ecrire_d(mle_diag_clin,var_code_local)

f.ecrirepage(cbx_ds1,page,1)
f.ecrirepage(cbx_ds2,page,2)
f.ecrirepage(cbx_ds3,page,3)
f.ecrirepage(cbx_ds4,page,4)

f.ecrirepage(sle_agenesie,page,5,50)
f.ecrirepage(sle_surnum,page,55,50)
f.ecrirepage(mle_remarques,page,105,200)
f.ecrirepage(mle_diag_cephal,page,305,300)	//max carac = 605



UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

