uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine save ()
public subroutine init ()
end prototypes

public subroutine save ();f.ecrirepage(sle_remarques,page,1,30)

//face
f.ecrirepage(cbx_1,page,39)
f.ecrirepage(cbx_2,page,40)
f.ecrirepage(cbx_3,page,41)
f.ecrirepage(cbx_4,page,42)
f.ecrirepage(cbx_5,page,43)
f.ecrirepage(cbx_6,page,44)
f.ecrirepage(sle_assymetrie,page,45,20)

//tonicité
f.ecrirepage(cbx_11,page,66)
f.ecrirepage(cbx_12,page,67)
f.ecrirepage(cbx_13,page,68)
f.ecrirepage(cbx_14,page,69)

//habitudes
f.ecrirepage(sle_langue,page,70,10)
f.ecrirepage(sle_pouce,page,80,10)
f.ecrirepage(sle_respira,page,90,10)

//profil
f.ecrirepage(cbx_7,page,100)
f.ecrirepage(cbx_8,page,101)
f.ecrirepage(cbx_9,page,102)
f.ecrirepage(cbx_10,page,103)
f.ecrirepage(sle_ls,page,104,3)
f.ecrirepage(sle_li,page,107,3)

//fonction
f.ecrirepage(sle_tmj,page,110,23)
f.ecrirepage(sle_freeway,page,135,23)
f.ecrirepage(sle_orthophonie,page,160,23)

//aspect dentaire
f.ecrirepage(cbx_15,page,185)
f.ecrirepage(cbx_16,page,186)
f.ecrirepage(cbx_17,page,187)
f.ecrirepage(cbx_18,page,188)
f.ecrirepage(cbx_19,page,189)
f.ecrirepage(cbx_20,page,190)
f.ecrirepage(cbx_21,page,191)
f.ecrirepage(cbx_22,page,192)
f.ecrirepage(cbx_23,page,193)
f.ecrirepage(cbx_24,page,194)
f.ecrirepage(cbx_25,page,195)
f.ecrirepage(cbx_26,page,196)
f.ecrirepage(sle_mol_dt,page,197,2)
f.ecrirepage(sle_mol_g,page,200,2)
f.ecrirepage(sle_canine_dt,page,202,2)
f.ecrirepage(sle_canine_g,page,204,2)
f.ecrirepage(cbx_27,page,206)
f.ecrirepage(cbx_28,page,207)
f.ecrirepage(cbx_29,page,208)

//overjet
f.ecrirepage(sle_overjet,page,210,10)
f.ecrirepage(sle_overbite,page,220,10)
f.ecrirepage(sle_cross1,page,230,5)
f.ecrirepage(sle_cross2,page,235,5)
f.ecrirepage(sle_cross3,page,240,5)
f.ecrirepage(sle_cross4,page,245,5)
f.ecrirepage(sle_exces_mand,page,250,2)
f.ecrirepage(sle_exces_maxi,page,255,2)

//ddm
f.ecrirepage(sle_ddm,page,260,3)
f.ecrirepage(sle_mediane1,page,265,2)
f.ecrirepage(sle_mediane2,page,270,2)
f.ecrirepage(sle_mediane3,page,275,2)
f.ecrirepage(sle_mediane4,page,280,2)
f.ecrirepage(sle_gap01,page,285,1)
f.ecrirepage(sle_gap1,page,286,2)
f.ecrirepage(sle_gap02,page,290,1)
f.ecrirepage(sle_gap2,page,295,2)	//300 carac au total pour page N°1


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	COMMIT ;
	string	c, t
	c = sle_classe.text
	t= sle_type.text
	UPDATE patient SET classe = :c, type = :t WHERE code = :var_code_local ;
	if SQLCA.Sqlcode <> 0 then
		son(4)
		Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
	else
		modif = false
		COMMIT ;
	end if
end if

end subroutine

public subroutine init ();//pour afficher correspondant
string cc,nom_c,prenom_c

select code_correspondant INTO :cc FROM patient WHERE code = :var_code_local ;
select nom, prenom INTO :nom_c, :prenom_c FROM correspondants WHERE code = :cc ;
if isnull(nom_c) then
	nom_c = ""
end if
if isnull(prenom_c) then
	prenom_c = ""
end if
st_correspondant.text = nom_c + " " + prenom_c

//pour afficher la "classe" et le "type" de la table patient
//(attention on reprend les variable du nom/prenom)
select classe, type INTO :nom_c, :prenom_c FROM patient WHERE code = :var_code_local ;
if isnull(nom_c) then
	nom_c = ""
end if
if isnull(prenom_c) then
	prenom_c = ""
end if
sle_classe.text = nom_c
sle_type.text = prenom_c

//
f.lirepage(sle_remarques,page,1,30)

//face
f.lirepage(cbx_1,page,39)
f.lirepage(cbx_2,page,40)
f.lirepage(cbx_3,page,41)
f.lirepage(cbx_4,page,42)
