event open;var_code_local = message.doubleparm

string vn,vp
double vnd
date vd
integer an, vmois

select nom, prenom, date_naissance,numero_dossier INTO :vn,:vp,:vd,:vnd FROM patient WHERE code = :var_code_local ;

if isnull(vn) then
	vn = ""
end if
if isnull(vp) then
	vp = ""
end if
if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	vmois = month(today()) - month( vd ) +12
ELSE
	vmois = month(today()) - month( vd )
END IF

this.title = "Page Clinique N°1 : " + vn + " " + vp +" - N° dossier : "+string(vnd) + " - Age : " + string(an) + " ans " + string(vmois) + " mois "

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

//if len(page) < 6000 then
//	page = page + space(6000 - len(page))
//end if

init()
mep_win_mdi(this,1)

end event

type cb_suivant from commandbutton within w_diagnos_maj_malins1
integer x = 3095
integer y = 1536
integer width = 402
integer height = 112
integer taborder = 590
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Suivant"
end type

event clicked;if modif then
	if MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre sans enregistrer ?",Question!,YesNo!) = 1 then
		If ui_v2020 then 
			OpenWithParm( w_diagnos_maj_malins2, var_code_local, "w_diagnos_maj_malins2", w_mdi_2020)
		else
			OpenSheetWithParm( w_diagnos_maj_malins2, var_code_local, "w_diagnos_maj_malins2", w_mdi, 0, Original!)
		end if
		Close(parent)
	end if
else
	If ui_v2020 then 
		OpenWithParm( w_diagnos_maj_malins2, var_code_local, "w_diagnos_maj_malins2", w_mdi_2020)
	else
		OpenSheetWithParm( w_diagnos_maj_malins2, var_code_local, "w_diagnos_maj_malins2", w_mdi, 0, Original!)
	end if
	close(parent)
end if




end event

type cb_precedant from commandbutton within w_diagnos_maj_malins1
boolean visible = false
integer x = 3095
integer y = 1368
integer width = 402
integer height = 112
integer taborder = 300
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Précédant"
end type

event clicked;if modif then
	if MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre sans enregistrer ?",Question!,YesNo!) = 1 then
		OpenSheetWithParm(w_diagnos_maj_malins1,var_code_local,w_mdi,1,Original!)
		Close(parent)
	end if
else
	OpenSheetWithParm(w_diagnos_maj_malins1,var_code_local,w_mdi,1,Original!)
	close(parent)
end if

end event

