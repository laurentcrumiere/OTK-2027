 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"titre_personnes~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"param.appelh~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"prati.cadre_bas_page~") COLUMN(NAME=~"param.c1~") COLUMN(NAME=~"param.c2~") COLUMN(NAME=~"param.c3~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"titre_personnes.nom~")    JOIN (LEFT=~"titre_personnes.code~"    OP =~"=~"RIGHT=~"patient.titre_parent1~"    OUTER2 =~"patient.titre_parent1~" )   JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" ) WHERE(    EXP1 =~"( ( ~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode ) )~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " arguments=(("nocode", number)) )
