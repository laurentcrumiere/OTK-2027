type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();string pt


SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;


modif = false

ddlb_17.selectitem(integer(mid(page,2800,1)))
ddlb_17a.selectitem(integer(mid(page,2801,1)))
ddlb_18.selectitem(integer(mid(page,2802,1)))
ddlb_18a.selectitem(integer(mid(page,2803,1)))
ddlb_19.selectitem(integer(mid(page,2804,1)))
ddlb_19a.selectitem(integer(mid(page,2805,1)))
ddlb_19b.selectitem(integer(mid(page,2806,1)))
ddlb_20.selectitem(integer(mid(page,2807,1)))
ddlb_21.selectitem(integer(mid(page,2808,1)))
ddlb_21a.selectitem(integer(mid(page,2809,1)))
ddlb_22.selectitem(integer(mid(page,2810,1)))
ddlb_23.selectitem(integer(mid(page,2811,1)))
ddlb_24.selectitem(integer(mid(page,2812,1)))
ddlb_24a.selectitem(integer(mid(page,2813,1)))
ddlb_25.selectitem(integer(mid(page,2814,1)))


mle_ddm.text = RightTrim(mid(page,2900,100))
mle_anomalies.text = RightTrim(mid(page,3000,100))
mle_malposition.text = RightTrim(mid(page,3100,100))
mle_fonction.text = RightTrim(mid(page,3200,200))
mle_atm.text = RightTrim(mid(page,3400,200))

mle_plan_traitement.text = pt

end subroutine

event open;var_code_local = message.doubleparm

string vn
date vm

select trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = date('00/00/0000')
end if

this.title = "Page diagnostique N°5 : "+vn+" - Né(e) le : " +string(vm)+ " - N° dossier : "+string(var_code_local)


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(5000)
end if

if len(page) < 5000 then
	page = page + space(5000 - len(page))
end if

init()


end event

