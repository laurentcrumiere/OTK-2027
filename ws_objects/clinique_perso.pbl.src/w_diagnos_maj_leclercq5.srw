type cb_enregistrer from commandbutton within w_diagnos_maj_leclercq5
integer x = 1106
integer y = 1708
integer width = 384
integer height = 108
integer taborder = 240
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Enregistrer"
end type

event clicked;string pt

place(string(ddlb_17.FindItem(ddlb_17.text,1)),page,2800)
place(string(ddlb_17a.FindItem(ddlb_17a.text,1)),page,2801)
place(string(ddlb_18.FindItem(ddlb_18.text,1)),page,2802)
place(string(ddlb_18a.FindItem(ddlb_18a.text,1)),page,2803)
place(string(ddlb_19.FindItem(ddlb_19.text,1)),page,2804)
place(string(ddlb_19a.FindItem(ddlb_19a.text,1)),page,2805)
place(string(ddlb_19b.FindItem(ddlb_19b.text,1)),page,2806)
place(string(ddlb_20.FindItem(ddlb_20.text,1)),page,2807)
place(string(ddlb_21.FindItem(ddlb_21.text,1)),page,2808)
place(string(ddlb_21a.FindItem(ddlb_21a.text,1)),page,2809)
place(string(ddlb_22.FindItem(ddlb_22.text,1)),page,2810)
place(string(ddlb_23.FindItem(ddlb_23.text,1)),page,2811)
place(string(ddlb_24.FindItem(ddlb_24.text,1)),page,2812)
place(string(ddlb_24a.FindItem(ddlb_24a.text,1)),page,2813)
place(string(ddlb_25.FindItem(ddlb_25.text,1)),page,2814)

place_avec_blancs(mle_ddm.text,page,2900,100)
place_avec_blancs(mle_anomalies.text,page,3000,100)
place_avec_blancs(mle_malposition.text,page,3100,100)
place_avec_blancs(mle_fonction.text,page,3200,200)
place_avec_blancs(mle_atm.text,page,3400,200)

pt = mle_plan_traitement.text


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
	else
	UPDATE patient SET plan_traitement = :pt WHERE code = :var_code_local ;
	if SQLCA.Sqlcode <> 0 then
		son(4)
		Messagebox("ERREUR BASE DE DONNEES (N°3)",SQLCA.SqlErrText)
	else
		modif = false
		COMMIT ;
	end if
end if
end event

