global type w_diagnos_maj_filliot4 from window
integer x = 18
integer y = 168
integer width = 3173
integer height = 1944
boolean titlebar = true
string title = "page_clinique"
boolean controlmenu = true
windowtype windowtype = response!
long backcolor = 8421504
cb_fermer cb_fermer
cb_imprimer cb_imprimer
ole_photo4 ole_photo4
ole_photo3 ole_photo3
ole_photo2 ole_photo2
ole_photo1 ole_photo1
ole_plein ole_plein
end type
global w_diagnos_maj_filliot4 w_diagnos_maj_filliot4

type variables
double var_code_local

end variables

forward prototypes
public subroutine zoom_photo (string photo)
end prototypes

public subroutine zoom_photo (string photo);// Affichage de l'image .. OCX Wang Image Control
	//if trim(photo) <> '' then
	//	ole_plein.object.image = photo
	//	ole_plein.object.Display()
	//	ole_plein.object.FitTo(0)
	//	ole_plein.visible = true
	//else
	//	son(5)
	//end if
	//ole_plein.visible = false		//à mettre dans "simple click" de "ole_plein"

/////////////////////////////////////////////////////////////////////////////////

// Affichage de l'image .. OCX IMAGEGEAR

if trim(photo) <> '' then
	ole_plein.object.AutoRedraw = true
	ole_plein.object.ImageIndex = 1
	ole_plein.object.LoadImage =  photo
	ole_plein.object.dsplFitMethodSet( 0)
	ole_plein.visible = true
else
	son(5)
end if

end subroutine

on w_diagnos_maj_filliot4.create
this.cb_fermer=create cb_fermer
this.cb_imprimer=create cb_imprimer
this.ole_photo4=create ole_photo4
this.ole_photo3=create ole_photo3
this.ole_photo2=create ole_photo2
this.ole_photo1=create ole_photo1
this.ole_plein=create ole_plein
this.Control[]={this.cb_fermer,&
this.cb_imprimer,&
this.ole_photo4,&
this.ole_photo3,&
this.ole_photo2,&
this.ole_photo1,&
this.ole_plein}
end on

on w_diagnos_maj_filliot4.destroy
destroy(this.cb_fermer)
destroy(this.cb_imprimer)
destroy(this.ole_photo4)
destroy(this.ole_photo3)
destroy(this.ole_photo2)
destroy(this.ole_photo1)
destroy(this.ole_plein)
end on

event open;var_code_local = message.doubleparm

string vn,vp
date vd
integer an, mois

select nom, prenom, date_naissance INTO :vn,:vp,:vd FROM patient WHERE code = :var_code_local ;

if isnull(vn) then
	vn = ""
end if
if isnull(vp) then
	vp = ""
end if
if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Présentation pour " + vn + " " + vp + "  - Age : " + string(an) + " ans " + string(mois) + " mois "


//charge tout ce qui va bien
centrer(this)

end event

