public subroutine unload_ctrls ();long	duree
duree = long(em_4.text)
UPDATE patient SET duree_traitement = :duree WHERE code = :var_code_local ;
if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°3)", "Sur l'enregistrement de la Durée du Traitement. ~n~n" + SQLCA.SqlErrText )
else
	COMMIT ;
end if

f.ecrire_pt(mle_2,var_code_local)
f.ecrire_d(mle_3,var_code_local)

f.ecrirepage(em_1,page_buffer[2],1,10)

f.ecrirepage(ddlb_2,page_buffer[2],11,1)
string	sch_vertical
sch_vertical = trim(left(ddlb_2.text,20))
UPDATE patient SET "type" = :sch_vertical WHERE code = :var_code_local ;
if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°3)", "Sur l'enregistrement du Schéma Vertical. ~n~n" + SQLCA.SqlErrText )
else
	COMMIT ;
end if

f.ecrirepage(sle_1,page_buffer[2],12,70)
f.ecrirepage(cbx_1,page_buffer[2],82)
f.ecrirepage(cbx_2,page_buffer[2],83)
f.ecrirepage(cbx_3,page_buffer[2],84)
