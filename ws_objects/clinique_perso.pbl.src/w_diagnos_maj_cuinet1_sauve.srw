forward prototypes
public subroutine load_ctrls ()
public subroutine unload_ctrls ()
end prototypes

public subroutine load_ctrls ();long	duree
SELECT duree_traitement INTO :duree FROM patient WHERE code = :var_code_local ;
em_4.text = string(duree)

f.lire_pt(mle_2,var_code_local)
f.lire_d(mle_3,var_code_local)

f.lirepage(em_1,page_buffer[1],1,10)
f.lirepage(ddlb_2,page_buffer[1],11,1)
f.lirepage(sle_1,page_buffer[1],12,70)
f.lirepage(cbx_1,page_buffer[1],82)
