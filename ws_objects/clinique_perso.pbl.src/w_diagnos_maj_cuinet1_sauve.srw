f.lirepage(ddlb_3,page_buffer[1],157,1)
f.lirepage(ddlb_4,page_buffer[1],158,1)
f.lirepage(ddlb_5,page_buffer[1],159,1)
f.lirepage(ddlb_6,page_buffer[1],160,1)
f.lirepage(em_2,page_buffer[1],161,6)
f.lirepage(em_3,page_buffer[1],167,6)
f.lirepage(ddlb_10,page_buffer[1],173,1)
f.lirepage(cbx_6,page_buffer[1],174)
f.lirepage(cbx_7,page_buffer[1],175)
f.lirepage(cbx_8,page_buffer[1],176)
f.lirepage(ddlb_11,page_buffer[1],177,1)
f.lirepage(mle_1,page_buffer[1],178,500)
f.lirepage(ddlb_1,page_buffer[1],678,1)
f.lirepage(em_bg24,page_buffer[1],679,4)
f.lirepage(em_bg23,page_buffer[1],683,4)
f.lirepage(em_bg22,page_buffer[1],687,4)
f.lirepage(em_bg21,page_buffer[1],691,4)
f.lirepage(em_bg20,page_buffer[1],695,4)
f.lirepage(em_bg19,page_buffer[1],699,4)
f.lirepage(em_bg18,page_buffer[1],703,4)
