f.ecrirepage(ddlb_5,page_buffer[2],159,1)
f.ecrirepage(ddlb_6,page_buffer[2],160,1)
f.ecrirepage(em_2,page_buffer[2],161,6)
f.ecrirepage(em_3,page_buffer[2],167,6)
f.ecrirepage(ddlb_10,page_buffer[2],173,1)
f.ecrirepage(cbx_6,page_buffer[2],174)
f.ecrirepage(cbx_7,page_buffer[2],175)
f.ecrirepage(cbx_8,page_buffer[2],176)
f.ecrirepage(ddlb_11,page_buffer[2],177,1)
f.ecrirepage(mle_1,page_buffer[2],178,500)

f.ecrirepage(ddlb_1,page_buffer[2],678,1)
string	typo_faciale
typo_faciale = trim(left(ddlb_1.text,20))
UPDATE patient SET classe = :typo_faciale WHERE code = :var_code_local ;
if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°3)", "Sur l'enregistrement de la Typologie Faciale. ~n~n" + SQLCA.SqlErrText )
else
	COMMIT ;
end if

f.ecrirepage(em_bg24,page_buffer[2],679,4)
f.ecrirepage(em_bg23,page_buffer[2],683,4)
f.ecrirepage(em_bg22,page_buffer[2],687,4)
