global w_diagnos_maj_pruit2 w_diagnos_maj_pruit2

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_date.text = Righttrim(trim(mid(page,1300,10)))

string pt

SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;
mle_plan_traitement.text = pt
end subroutine

event open;var_code_local = message.doubleparm
dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

string vn,vm 
date vd


select nom,prenom, date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vn) then
	vn = ""
end if


this.title = "Page N°2 : " + vn+ " " +vm+" - N° dossier : "+string(var_code_local)+ " - Date de naissance : " + string(vd) 


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

end event

