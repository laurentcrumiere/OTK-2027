 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"diagnos~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"diagnos.code~") COLUMN(NAME=~"diagnos.plus1~") COLUMN(NAME=~"diagnos.plus2~") COLUMN(NAME=~"diagnos.plus3~") COLUMN(NAME=~"diagnos.plus4~") COLUMN(NAME=~"diagnos.plus5~") COLUMN(NAME=~"diagnos.plus6~") COLUMN(NAME=~"diagnos.plus7~") COLUMN(NAME=~"diagnos.plus8~") COLUMN(NAME=~"diagnos.plus9~") COLUMN(NAME=~"diagnos.plus10~") COLUMN(NAME=~"diagnos.plus11~") COLUMN(NAME=~"diagnos.moins1~") COLUMN(NAME=~"diagnos.moins2~") COLUMN(NAME=~"diagnos.moins3~") COLUMN(NAME=~"diagnos.moins4~") COLUMN(NAME=~"diagnos.moins5~") COLUMN(NAME=~"diagnos.moins6~") COLUMN(NAME=~"diagnos.moins7~") COLUMN(NAME=~"diagnos.moins8~") COLUMN(NAME=~"diagnos.moins9~") COLUMN(NAME=~"diagnos.moins10~") COLUMN(NAME=~"diagnos.moins11~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"diagnos.code~" )WHERE(    EXP1 =~"~~~"diagnos~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " update="diagnos" updatewhere=1 updatekeyinplace=no arguments=(("nocode", number)) )
