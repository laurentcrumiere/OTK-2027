global w_diagnos_maj_lebail1 w_diagnos_maj_lebail1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

mle_ant_gene.text = Righttrim(trim(mid(page,1,200)))
mle_ant_fami.text = Righttrim(trim(mid(page,250,200)))

ddlb_face.selectitem(integer(mid(page,500,1)))
ddlb_levre_sup.selectitem(integer(mid(page,501,1)))
ddlb_levre_inf.selectitem(integer(mid(page,502,1)))
ddlb_profil.selectitem(integer(mid(page,503,1)))
ddlb_menton.selectitem(integer(mid(page,504,1)))
ddlb_nez.selectitem(integer(mid(page,505,1)))
ddlb_slm.selectitem(integer(mid(page,506,1)))
ddlb_angle.selectitem(integer(mid(page,507,1)))
ddlb_respiration.selectitem(integer(mid(page,508,1)))
ddlb_deglutition.selectitem(integer(mid(page,509,1)))
ddlb_phonation.selectitem(integer(mid(page,510,1)))
ddlb_succion.selectitem(integer(mid(page,511,1)))
ddlb_langue.selectitem(integer(mid(page,512,1)))
ddlb_levres.selectitem(integer(mid(page,513,1)))
ddlb_amygdales.selectitem(integer(mid(page,514,1)))
ddlb_vegetations.selectitem(integer(mid(page,515,1)))
ddlb_chemin.selectitem(integer(mid(page,516,1)))
ddplb_amplitude.selectitem(integer(mid(page,517,1)))
ddlb_hygiene.selectitem(integer(mid(page,518,1)))
ddlb_frein_langue.selectitem(integer(mid(page,519,1)))
ddlb_frein_lev_sup.selectitem(integer(mid(page,520,1)))
ddlb_frein_lev_inf.selectitem(integer(mid(page,521,1)))

ddlb_trans2.selectitem(integer(mid(page,522,1)))
ddlb_trans3.selectitem(integer(mid(page,523,1)))
ddlb_trans4.selectitem(integer(mid(page,524,1)))
ddlb_trans5.selectitem(integer(mid(page,525,1)))

ddlb_vert2.selectitem(integer(mid(page,526,1)))
ddlb_vert3.selectitem(integer(mid(page,527,1)))
ddlb_vert4.selectitem(integer(mid(page,528,1)))
ddlb_vert5.selectitem(integer(mid(page,529,1)))

ddlb_milieux.selectitem(integer(mid(page,530,1)))
ddlb_mand.selectitem(integer(mid(page,531,1)))

if mid(page,532,1) = 'O' then
	cbx_sourire.checked = true
else
	cbx_sourire.checked = false
end if

if mid(page,533,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page,534,1) = 'O' then
	cbx_bruxisme.checked = true
else
	cbx_bruxisme.checked = false
end if
if mid(page,535,1) = 'O' then
	cbx_contracture.checked = true
else
	cbx_contracture.checked = false
end if
if mid(page,536,1) = 'O' then
	cbx_levre.checked = true
else
	cbx_levre.checked = false
end if
if mid(page,537,1) = 'O' then
	cbx_douleur.checked = true
else
	cbx_douleur.checked = false
end if
if mid(page,538,1) = 'O' then
	cbx_craquement.checked = true
else
	cbx_craquement.checked = false
end if
if mid(page,539,1) = 'O' then
	cbx_ressaut.checked = true
else
	cbx_ressaut.checked = false
end if
if mid(page,540,1) = 'O' then
	cbx_plaque.checked = true
else
	cbx_plaque.checked = false
end if
if mid(page,541,1) = 'O' then
	cbx_maxi_oui.checked = true
else
	cbx_maxi_oui.checked = false
end if
if mid(page,542,1) = 'O' then
	cbx_rotation16.checked = true
else
	cbx_rotation16.checked = false
end if
if mid(page,543,1) = 'O' then
	cbx_rotation26.checked = true
else
	cbx_rotation26.checked = false
end if

em_symetrie.text = Righttrim(mid(page,550,10))
em_gencive.text = Righttrim(mid(page,560,10))

em_sag1.text = mid(page,570,3)
em_tran1.text = mid(page,575,3)
em_vert1.text = mid(page,580,3)

em_sag2.text = mid(page,585,3)
em_sag3.text = mid(page,590,3)
em_sag4.text = mid(page,595,3)
em_sag5.text = mid(page,600,3)

em_gingivite.text = Righttrim(mid(page,610,10))
em_poche.text = Righttrim(mid(page,620,10))
em_mobilite.text = Righttrim(mid(page,630,10))

// depuis le 17/08/2004
ddlb_1.selectitem(integer(mid(page,1962,1)))
ddlb_2.selectitem(integer(mid(page,1963,1)))
ddlb_3.selectitem(integer(mid(page,1964,1)))
ddplb_1.selectitem(integer(mid(page,1965,1)))
sle_1.text = Righttrim(mid(page,1966,10))		//max carac depuis 17/08/2004 = 1976
end subroutine

event open;var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, lmois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	lmois = month(today()) - month( vd ) +12
ELSE
	lmois = month(today()) - month( vd )
END IF

this.title = "Page N°1 : "+vn+ " " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(lmois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

//dw_1.settransobject(SQLCA)

///dw_1.retrieve(var_code_local)

mep_win_mdi(this,1)

cb_fermer.setfocus()
end event

