type cb_suivant from commandbutton within w_diagnos_maj_lebail1
event clicked pbm_bnclicked
integer x = 3141
integer y = 1368
integer width = 338
integer height = 96
integer taborder = 650
integer textsize = -8
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Suivant"
end type

event clicked;if modif then
	If MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre ?",Question!,YesNo!) = 1 Then
		if ui_v2020 then
			OpenWithParm( w_diagnos_maj_lebail2, var_code_local, w_mdi_2020)
		else
			OpenSheetWithParm ( w_diagnos_maj_lebail2 , var_code_local , w_mdi , 1 , Original! )
		end if
		Close(w_diagnos_maj_lebail1)
	end if
else
	if ui_v2020 then
		OpenWithParm( w_diagnos_maj_lebail2, var_code_local, w_mdi_2020)
	else
		OpenSheetWithParm ( w_diagnos_maj_lebail2 , var_code_local , w_mdi , 1 , Original! )
	end if
	close(w_diagnos_maj_lebail1)
end if
end event

