type p_vide from picture within w_diagnos_maj_soiron1
integer x = 2089
integer y = 344
integer width = 96
integer height = 100
integer taborder = 100
string picturename = "memovide.bmp"
boolean focusrectangle = false
end type

event clicked;openwithparm(w_confidentiel_soiron,var_code_local)

decimal l
string texte

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

texte = Righttrim(mid(page,1200,250))

IF IsNull(texte) THEN
	l = 0
ELSE
	l = len(texte)
END IF	

p_vide.visible = false
p_plein.visible = false

if l = 0 then
	p_vide.visible = true
else
	p_plein.visible = true
end if

end event

