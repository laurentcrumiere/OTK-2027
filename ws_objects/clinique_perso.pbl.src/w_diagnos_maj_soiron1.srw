global w_diagnos_maj_soiron1 w_diagnos_maj_soiron1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();if mid(page,1,1) = 'O' then
	cbx_parent.checked = true
else
	cbx_parent.checked = false
end if
if mid(page,2,1) = 'O' then
	cbx_enfant.checked = true
else
	cbx_enfant.checked = false
end if
if mid(page,3,1) = 'O' then
	cbx_corr.checked = true
else
	cbx_corr.checked = false
end if

ddlb_parent.selectitem(integer(mid(page,4,1)))
ddlb_patient.selectitem(integer(mid(page,5,1)))
ddlb_face.selectitem(integer(mid(page,6,1)))
ddlb_profil.selectitem(integer(mid(page,7,1)))
ddlb_hauteur.selectitem(integer(mid(page,8,1)))
ddlb_mol_d.selectitem(integer(mid(page,9,1)))
ddlb_mol_g.selectitem(integer(mid(page,10,1)))
ddlb_can_d.selectitem(integer(mid(page,11,1)))
ddlb_can_g.selectitem(integer(mid(page,12,1)))
ddlb_beance_ant.selectitem(integer(mid(page,13,1)))
ddlb_beance_lat.selectitem(integer(mid(page,14,1)))
ddlb_supra.selectitem(integer(mid(page,15,1)))
ddlb_infra.selectitem(integer(mid(page,16,1)))
ddlb_plan.selectitem(integer(mid(page,17,1)))
ddlb_occl_sup.selectitem(integer(mid(page,18,1)))
ddlb_occl_inf.selectitem(integer(mid(page,19,1)))
ddlb_bou_sup.selectitem(integer(mid(page,20,1)))
ddlb_bou_inf.selectitem(integer(mid(page,21,1)))
ddlb_levre_sup.selectitem(integer(mid(page,22,1)))
ddlb_levre_inf.selectitem(integer(mid(page,23,1)))
ddlb_frein_langue.selectitem(integer(mid(page,24,1)))
ddlb_gingivite.selectitem(integer(mid(page,25,1)))
ddlb_hygiene.selectitem(integer(mid(page,26,1)))
ddlb_craquement.selectitem(integer(mid(page,27,1)))
ddlb_douleurs.selectitem(integer(mid(page,28,1)))
ddlb_ressaut.selectitem(integer(mid(page,29,1)))
ddlb_chemin.selectitem(integer(mid(page,30,1)))
ddlb_respiration.selectitem(integer(mid(page,31,1)))
ddplb_deglutition.selectitem(integer(mid(page,32,1)))
ddplb_phonation.selectitem(integer(mid(page,33,1)))
ddlb_succion.selectitem(integer(mid(page,34,1)))
ddlb_onycho.selectitem(integer(mid(page,35,1)))
ddlb_bruxisme.selectitem(integer(mid(page,36,1)))
ddlb_aurepos.selectitem(integer(mid(page,37,1)))
ddlb_langue.selectitem(integer(mid(page,38,1)))
ddlb_position.selectitem(integer(mid(page,39,1)))
ddlb_levre.selectitem(integer(mid(page,40,1)))
ddlb_amygdales.selectitem(integer(mid(page,41,1)))
ddlb_vegetations.selectitem(integer(mid(page,42,1)))

em_overjet.text = Righttrim(mid(page,45,5))

sle_agenesie.text = Righttrim(mid(page,50,30))
sle_dent_surnu.text = Righttrim(mid(page,100,20))
sle_dent_inclu.text = Righttrim(mid(page,150,20))
sle_dent_extr.text = Righttrim(mid(page,200,20))
sle_carie.text = Righttrim(mid(page,250,20))
sle_resorption.text = Righttrim(mid(page,300,20))
sle_prothese.text = Righttrim(mid(page,350,20))
sle_mobilite.text = Righttrim(mid(page,400,20))
sle_visibles.text = Righttrim(mid(page,450,30))
sle_taches.text = Righttrim(mid(page,500,30))
sle_endo.text = Righttrim(mid(page,550,20))
sle_exo.text = Righttrim(mid(page,600,20))
sle_recession.text = Righttrim(mid(page,650,30))

mle_pb.text = Righttrim(mid(page,700,150))
mle_particu.text = Righttrim(trim(mid(page,900,250)))

decimal l
string texte

texte = Righttrim(mid(page,1200,250))

IF IsNull(texte) THEN
	l = 0
ELSE
	l = len(texte)
END IF	

p_vide.visible = false
p_plein.visible = false

if l = 0 then
	p_vide.visible = true
else
	p_plein.visible = true
end if

modif = false
cb_fermer.setfocus()

end subroutine

event open;
var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, mois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°1 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+") Praticien : B. SOIRON"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(6000)
end if

if len(page) < 6000 then
	page = page + space(6000 - len(page))
end if

init()


end event

