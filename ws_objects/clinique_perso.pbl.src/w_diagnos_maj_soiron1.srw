event clicked;if cbx_parent.checked then
	place("O",page,1)
else
	place("N",page,1)
end if
if cbx_enfant.checked then
	place("O",page,2)
else
	place("N",page,2)
end if
if cbx_corr.checked then
	place("O",page,3)
else
	place("N",page,3)
end if

