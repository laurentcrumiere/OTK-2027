public subroutine maj_diagnos ();// Mise à jour du Diagnostic patient en ajoutant les valeurs de l'Overbite et de l'Overjet

string	lstr_diag

// zone "diagnostic"
select traitement_effectue into :lstr_diag from patient where patient.code = :var_code_local ;

// Ajout du commentaire
lstr_diag = lstr_diag + char(13) + char(10) + "L'overbite est de " + sle_Overbite.text + " mm" + char(13) + char(10) + "L'overjet est de " + sle_Overjet.text + "mm."

// Mise à jour du Diagnostic
Update patient
Set traitement_effectue = :lstr_diag
Where patient.code = :var_code_local ;
end subroutine

