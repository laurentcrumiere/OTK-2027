public subroutine init ();
em_d1.text = trim(mid(page,1220,7))
em_d2.text = trim(mid(page,1227,7))
em_d3.text = trim(mid(page,1234,7))
em_d4.text = trim(mid(page,1241,7))
em_d5.text = trim(mid(page,1248,7))
em_d6.text = trim(mid(page,1255,7))
em_d7.text = trim(mid(page,1262,7))
em_d8.text = trim(mid(page,1269,7))
em_d9.text = trim(mid(page,1276,7))
em_d10.text = trim(mid(page,1283,7))

em_d1bis.text = Trim(mid(page,1290,10))
em_d2bis.text = Trim(mid(page,1300,10))
em_d3bis.text = Trim(mid(page,1310,10))
em_d4bis.text = Trim(mid(page,1320,10))

mle_col1.text = RightTrim(mid(page,1330,150))
mle_col2.text = RightTrim(mid(page,1480,150))
mle_col3.text = RightTrim(mid(page,1630,150))
mle_col4.text = RightTrim(mid(page,1780,150))

em_d_haut.text = RightTrim(mid(page,1930,15))
em_g_haut.text = RightTrim(mid(page,1945,15))
em_d_bas.text = RightTrim(mid(page,1960,15))
em_g_bas.text = RightTrim(mid(page,1975,15))

sle_interception.text = RightTrim(mid(page,1990,15))
em_debut1.text = RightTrim(mid(page,2005,7))
sle_xb.text = RightTrim(mid(page,2012,15))
em_debut2.text = RightTrim(mid(page,2027,15))

modif = false

//au total 2034 caractères, donc on passe à page=4000

end subroutine

