type cb_page1 from commandbutton within w_diagnos_maj_raoux2
integer x = 2656
integer y = 1196
integer width = 320
integer height = 108
integer taborder = 280
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Page N°1"
end type

event clicked;
boolean suite=false

if modif then
	If MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre sans enregistrer ?",Question!,YesNo!) = 1 Then
		suite=true
	end if
else
	suite=true
end if

if suite then
	openwithparm(w_diagnos_maj_raoux1,var_code_local)
	//close(w_diagnos_maj_raoux2)
	close(parent)
end if
end event

type cb_imprimer from commandbutton within w_diagnos_maj_raoux2
integer x = 2656
