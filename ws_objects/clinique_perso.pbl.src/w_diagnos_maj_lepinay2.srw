global w_diagnos_maj_lepinay2 w_diagnos_maj_lepinay2

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_d1.text = trim(mid(page,1300,7))
em_d2.text = trim(mid(page,1310,7))
em_d3.text = trim(mid(page,1320,7))
em_d4.text = trim(mid(page,1330,7))
em_d5.text = trim(mid(page,1340,7))

mle_col1.text = RightTrim(mid(page,1350,70))
mle_col2.text = RightTrim(mid(page,1420,70))
mle_col3.text = RightTrim(mid(page,1490,70))
mle_col4.text = RightTrim(mid(page,1560,70))
mle_col5.text = RightTrim(mid(page,1630,70))

mle_diagnostic.text = RightTrim(mid(page,1700,300))
mle_reevaluation.text = RightTrim(mid(page,2000,200))

string pt

SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;
mle_plan.text = pt
end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"

init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

init()

// place la window ds la mdi -> confort utilisateur
mep_win_mdi(this,1)
end event

