type cb_enregistrer from commandbutton within w_diagnos_maj_lepinay2
integer x = 2030
integer y = 1664
integer width = 384
integer height = 108
integer taborder = 150
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Enregistrer"
boolean default = true
end type

event clicked;string pt

place(em_d1.text,page,1300)
place(em_d2.text,page,1310)
place(em_d3.text,page,1320)
place(em_d4.text,page,1330)
place(em_d5.text,page,1340)

place_avec_blancs(mle_col1.text,page,1350,70)
place_avec_blancs(mle_col2.text,page,1420,70)
place_avec_blancs(mle_col3.text,page,1490,70)
place_avec_blancs(mle_col4.text,page,1560,70)
place_avec_blancs(mle_col5.text,page,1630,70)

place_avec_blancs(mle_diagnostic.text,page,1700,300)
place_avec_blancs(mle_reevaluation.text,page,2000,200)

pt = mle_plan.text

UPDATE diagnos SET perso = :page  WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
	rollback ;
else
	commit ;
	UPDATE patient SET plan_traitement = :pt WHERE code = :var_code_local ;
	if SQLCA.Sqlcode <> 0 then
		son(4)
		Messagebox("ERREUR BASE DE DONNEES (N°3)",SQLCA.SqlErrText)
		rollback ;
	else
		modif = false
		COMMIT ;
	end if
end if

end event

