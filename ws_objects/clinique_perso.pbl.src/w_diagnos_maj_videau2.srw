type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();mle_ant_gene.text = Righttrim(trim(mid(page,1,200)))
mle_ant_fami.text = Righttrim(trim(mid(page,300,200)))

ddlb_respiration.selectitem(integer(mid(page,601,1)))
ddplb_deglutition.selectitem(integer(mid(page,602,1)))
ddplb_phonation.selectitem(integer(mid(page,603,1)))
if mid(page,604,1) = 'O' then
	cbx_suceur.checked = true
else
	cbx_suceur.checked = false
end if
if mid(page,605,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page,606,1) = 'O' then
	cbx_bruxisme.checked = true
else
	cbx_bruxisme.checked = false
end if

ddlb_amygdales.selectitem(integer(mid(page,607,1)))
ddlb_vegetations.selectitem(integer(mid(page,608,1)))

// ------------- 3.5.2000-----------------------
//ddlb_langue.selectitem(integer(mid(page,609,1)))
//ddplb_levres.selectitem(integer(mid(page,610,1)))
//ddplb_volume.selectitem(integer(mid(page,611,1)))
//----------------------------------------------------------------


if mid(page,612,1) = 'O' then
	cbx_douleur.checked = true
else
	cbx_douleur.checked = false
end if

if mid(page,613,1) = 'O' then
	cbx_craquement.checked = true
else
	cbx_craquement.checked = false
end if

if mid(page,614,1) = 'O' then
	cbx_ressaut.checked = true
else
	cbx_ressaut.checked = false
end if


//-------------------- 3.5.2000 -------------------------
if mid(page,617,1) = 'O' then
	cbx_douleur_droite.checked = true
else
	cbx_douleur_droite.checked = false
end if

if mid(page,618,1) = 'O' then
	cbx_craquement_droite.checked = true
else
	cbx_craquement_droite.checked = false
end if

if mid(page,619,1) = 'O' then
	cbx_ressaut_droite.checked = true
else
	cbx_ressaut_droite.checked = false
end if
//----------------------------------------------------------

ddlb_chemin.selectitem(integer(mid(page,615,1)))
ddplb_amplitude.selectitem(integer(mid(page,616,1)))

sle_prematurites.text = Righttrim(mid(page,620,30))
mle_paro.text = Righttrim(mid(page,700,150))

if mid(page,901,1) = 'O' then
	cbx_langue.checked = true
else
	cbx_langue.checked = false
end if
if mid(page,902,1) = 'O' then
	cbx_levre_sup.checked = true
else
	cbx_levre_sup.checked = false
end if
if mid(page,903,1) = 'O' then
	cbx_levre_inf.checked = true
else
	cbx_levre_inf.checked = false
end if

sle_sagittal.text = Righttrim(mid(page,910,60))
sle_transver.text = Righttrim(mid(page,1000,60))
sle_vertical.text = Righttrim(mid(page,1100,60))

ddlb_milieux.selectitem(integer(mid(page,1201,1)))
ddlb_mand.selectitem(integer(mid(page,1202,1)))

if mid(page,1203,1) = 'O' then
	cbx_ddm.checked = true
else
	cbx_ddm.checked = false
end if

ddlb_hygiene.selectitem(integer(mid(page,1204,1)))

sle_caries.text = Righttrim(mid(page,1210,40))
sle_dysplasies.text = Righttrim(mid(page,1300,40))

mle_remarques.text = RightTrim(mid(page,1400,500))

// --------------- 3.5.2000 ------------------
// sle_position.text = RightTrim(mid(page,1900,50))
// ---------------------------------------------

// --------------- 3.5.2000 ------------------
sle_langue.text = RightTrim(mid(page,3600,50))
sle_levres.text = RightTrim(mid(page,3650,50))
// ---------------------------------------------

modif = false
cb_fermer.setfocus()
end subroutine

event open;
var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, vmois
double nd

select nom,prenom,moulage,date_naissance, numero_dossier INTO :vn,:vp,:vm,:vd, :nd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vd) then
	vd = today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	vmois = month(today()) - month( vd ) +12
ELSE
	vmois = month(today()) - month( vd )
END IF

this.title = "Page N°2 : "+vn+" " +vp+" - N° dossier : "+string(nd)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

init()
dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

end event

