table(column=(type=long updatewhereclause=yes name=nb_actes_z dbname="nb_actes_z" )
 column=(type=decimal(2) updatewhereclause=yes name=ca_actes_z dbname="ca_actes_z" )
 column=(type=long updatewhereclause=yes name=nb_gouttieres_refaites dbname="nb_gouttieres_refaites" )
 column=(type=long updatewhereclause=yes name=nb_helix dbname="nb_helix" )
 column=(type=long updatewhereclause=yes name=nb_ph dbname="nb_ph" )
 column=(type=long updatewhereclause=yes name=nb_teo dbname="nb_teo" )
 column=(type=long updatewhereclause=yes name=nb_grilles dbname="nb_grilles" )
 column=(type=long updatewhereclause=yes name=nb_gouttieres_produites dbname="nb_gouttieres_produites" )
 column=(type=long updatewhereclause=yes name=nb_gouttieres3 dbname="nb_gouttieres3" )
 column=(type=long updatewhereclause=yes name=nb_tracteurs dbname="nb_tracteurs" )
 column=(type=long updatewhereclause=yes name=nb_nti dbname="nb_nti" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param~" ) COMPUTE(NAME=~"( select count(*) as nb_actes_z from soins, code_soins where date_demande between :date_min and :date_max and soins.type = code_soins.code and trim(code_soins.lettre) = 'Z' )~") COMPUTE(NAME=~"( select sum(soins.total) as ca_actes_z from soins, code_soins where date_demande between :date_min and :date_max and soins.type = code_soins.code and trim(code_soins.lettre) = 'Z' )~") COMPUTE(NAME=~"( select count(*) as nb_gouttieres_refaites from coment where dat between :date_min and :date_max and com like '%'+trim(param.c17)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_helix from coment where dat between :date_min and :date_max and com like '%'+trim(param.c13)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_ph from coment where dat between :date_min and :date_max and com like '%'+trim(param.c15)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_teo from coment where dat between :date_min and :date_max and com like '%'+trim(param.ap8)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_grilles from coment where dat between :date_min and :date_max and com like '%'+trim(param.c14)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_gouttieres_produites from coment where dat between :date_min and :date_max and com like '%'+trim(param.c16)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_gouttieres3 from coment where dat between :date_min and :date_max and com like '%'+trim(param.c12)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_tracteurs from coment where dat between :date_min and :date_max and com like '%'+trim(param.c18)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_nti from coment where dat between :date_min and :date_max and com like '%'+trim(param.c19)+'%'  )~")) ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("date_min", date),("date_max", date)) )
