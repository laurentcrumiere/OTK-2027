global w_diagnos_maj_leclercq2 w_diagnos_maj_leclercq2

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_1.text = RightTrim(mid(page,830,2))
em_2.text = RightTrim(mid(page,832,2))
em_3.text = RightTrim(mid(page,834,2))
em_4.text = RightTrim(mid(page,836,2))
em_5.text = RightTrim(mid(page,838,2))
em_6.text = RightTrim(mid(page,840,2))
em_7.text = RightTrim(mid(page,842,2))
em_8.text = RightTrim(mid(page,844,2))
em_9.text = RightTrim(mid(page,846,2))
em_10.text = RightTrim(mid(page,848,2))
em_11.text = RightTrim(mid(page,850,2))
em_12.text = RightTrim(mid(page,852,2))
em_13.text = RightTrim(mid(page,854,2))
em_14.text = RightTrim(mid(page,856,2))
em_15.text = RightTrim(mid(page,858,2))
em_16.text = RightTrim(mid(page,860,2))

em_c1.text = RightTrim(mid(page,862,2))
em_c2.text = RightTrim(mid(page,864,2))
em_c3.text = RightTrim(mid(page,866,2))
em_c4.text = RightTrim(mid(page,868,2))
em_c5.text = RightTrim(mid(page,870,2))
em_c6.text = RightTrim(mid(page,872,2))
em_c7.text = RightTrim(mid(page,874,2))
em_c8.text = RightTrim(mid(page,876,2))
em_c9.text = RightTrim(mid(page,878,2))
em_c10.text = RightTrim(mid(page,880,2))
em_c11.text = RightTrim(mid(page,882,2))
em_c12.text = RightTrim(mid(page,884,2))
em_c13.text = RightTrim(mid(page,886,2))
em_c14.text = RightTrim(mid(page,888,2))
em_c15.text = RightTrim(mid(page,890,2))
em_c16.text = RightTrim(mid(page,892,2))


if mid(page,895,1) = 'O' then
	cbx_normal.checked = true
else
	cbx_normal.checked = false
end if
if mid(page,896,1) = 'O' then
	cbx_augmente.checked = true
else
	cbx_augmente.checked = false
end if

mle_muqueuse.text = RightTrim(mid(page,900,100))
mle_arcade.text = RightTrim(mid(page,1000,300))
mle_repos.text = RightTrim(mid(page,1300,100))
mle_fonction.text = RightTrim(mid(page,1400,100))
mle_parafonction.text = RightTrim(mid(page,1500,100))


end subroutine

event open;var_code_local = message.doubleparm

string vn
date vm

select trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = date('00/00/0000')
end if

this.title = "Page diagnostique N°2 : "+vn+" - Né(e) le : " +string(vm)+ " - N° dossier : "+string(var_code_local)


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(5000)
end if

if len(page) < 5000 then
	page = page + space(5000 - len(page))
end if

init()

end event

