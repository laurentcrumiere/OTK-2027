global w_diagnos_maj_plantavin1 w_diagnos_maj_plantavin1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();
em_d1.text = trim(mid(page,1,10))
em_d2.text = trim(mid(page,11,10))
em_d3.text = trim(mid(page,21,10))
em_d4.text = trim(mid(page,31,10))
em_d5.text = trim(mid(page,41,10))
em_d6.text = trim(mid(page,51,10))

mle_col1.text = RightTrim(mid(page,100,100))
mle_col2.text = RightTrim(mid(page,200,100))
mle_col3.text = RightTrim(mid(page,300,100))
mle_col4.text = RightTrim(mid(page,400,100))
mle_col5.text = RightTrim(mid(page,500,100))
mle_col6.text = RightTrim(mid(page,600,100))

em_ddm.text = Righttrim(mid(page,700,3))
em_cc.text = Righttrim(mid(page,705,3))

ddlb_ancrage.selectitem(integer(mid(page,710,1)))

sle_asymetrie.text = Righttrim(mid(page,720,30))

em_1.text = Righttrim(mid(page,750,2))
em_2.text = Righttrim(mid(page,755,2))
em_3.text = Righttrim(mid(page,760,2))
em_4.text = Righttrim(mid(page,765,2))
em_5.text = Righttrim(mid(page,770,2))
em_6.text = Righttrim(mid(page,775,2))
em_7.text = Righttrim(mid(page,780,2))
em_8.text = Righttrim(mid(page,785,2))
em_9.text = Righttrim(mid(page,790,2))
em_10.text = Righttrim(mid(page,795,2))
em_11.text = Righttrim(mid(page,800,2))
em_12.text = Righttrim(mid(page,805,2))
em_13.text = Righttrim(mid(page,810,2))
em_14.text = Righttrim(mid(page,815,2))
em_15.text = Righttrim(mid(page,820,2))
em_16.text = Righttrim(mid(page,825,2))

mle_examen.text = Righttrim(mid(page,900,500))

modif = false

end subroutine

event open;string vn,vm,vp 
date vd
integer an, lmois


var_code_local = message.doubleparm

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	lmois = month(today()) - month( vd ) +12
ELSE
	lmois = month(today()) - month( vd )
END IF

this.title = "Page N°1 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(lmois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then	page = space(2000)

init()

mep_win_mdi(this,1)
end event

