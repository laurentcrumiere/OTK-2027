uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lirepage(em_1,page,1000,10)
f.lirepage(em_2,page,1010,10)
f.lirepage(em_3,page,1020,10)
f.lirepage(em_4,page,1030,10)
f.lirepage(em_5,page,1040,10)
f.lirepage(em_6,page,1050,10)
f.lirepage(em_7,page,1060,10)
f.lirepage(em_8,page,1070,10)
f.lirepage(em_9,page,1080,10)
f.lirepage(em_10,page,1090,10)
f.lirepage(em_11,page,1100,10)
f.lirepage(em_12,page,1110,10)
f.lirepage(em_13,page,1120,10)
f.lirepage(em_14,page,1130,10)
f.lirepage(em_15,page,1140,10)
f.lirepage(em_16,page,1150,10)
f.lirepage(em_17,page,1160,10)
f.lirepage(em_18,page,1170,10)
f.lirepage(em_19,page,1180,10)
f.lirepage(em_20,page,1190,10)

f.lirepage(mle_1,page,1200,300)		//max carac = 1500


cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(em_1,page,1000,10)
f.ecrirepage(em_2,page,1010,10)
f.ecrirepage(em_3,page,1020,10)
f.ecrirepage(em_4,page,1030,10)
f.ecrirepage(em_5,page,1040,10)
f.ecrirepage(em_6,page,1050,10)
f.ecrirepage(em_7,page,1060,10)
f.ecrirepage(em_8,page,1070,10)
f.ecrirepage(em_9,page,1080,10)
f.ecrirepage(em_10,page,1090,10)
f.ecrirepage(em_11,page,1100,10)
f.ecrirepage(em_12,page,1110,10)
f.ecrirepage(em_13,page,1120,10)
f.ecrirepage(em_14,page,1130,10)
f.ecrirepage(em_15,page,1140,10)
f.ecrirepage(em_16,page,1150,10)
f.ecrirepage(em_17,page,1160,10)
f.ecrirepage(em_18,page,1170,10)
f.ecrirepage(em_19,page,1180,10)
f.ecrirepage(em_20,page,1190,10)

f.ecrirepage(mle_1,page,1200,300)		//max carac = 1500



UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

