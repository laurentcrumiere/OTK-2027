global w_diagnos_maj_bany2 w_diagnos_maj_bany2

type variables
double var_code_local 
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();
em_d1.text = trim(mid(page,410,10))
em_d2.text = trim(mid(page,420,10))
em_d3.text = trim(mid(page,430,10))
em_d4.text = trim(mid(page,440,10))
em_d5.text = trim(mid(page,450,10))
em_d6.text = trim(mid(page,460,10))
em_d7.text = trim(mid(page,470,10))
em_d8.text = trim(mid(page,480,10))


mle_col1.text = RightTrim(mid(page,500,70))
mle_col2.text = RightTrim(mid(page,570,70))
mle_col3.text = RightTrim(mid(page,640,70))
mle_col4.text = RightTrim(mid(page,710,70))
mle_col5.text = RightTrim(mid(page,780,70))
mle_col6.text = RightTrim(mid(page,850,70))
mle_col7.text = RightTrim(mid(page,920,70))
mle_col8.text = RightTrim(mid(page,990,70))

mle_p1.text = RightTrim(mid(page,1060,20))
mle_m1.text = RightTrim(mid(page,1080,20))

mle_p2.text = RightTrim(mid(page,1100,20))
mle_m2.text = RightTrim(mid(page,1120,20))

mle_pt.text = RightTrim(mid(page,1140,10))
mle_mt.text = RightTrim(mid(page,1150,10))

mle_p3.text = RightTrim(mid(page,1160,20))
mle_m3.text = RightTrim(mid(page,1180,20))

mle_extract.text = RightTrim(mid(page,1200,80))

end subroutine

on open;
var_code_local = message.doubleparm

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()


end on

