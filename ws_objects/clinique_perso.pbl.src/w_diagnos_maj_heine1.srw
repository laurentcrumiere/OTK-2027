event clicked;if modif then
	If MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre ?",Question!,YesNo!) = 1 Then
		openwithparm(w_diagnos_maj_heine2,var_code_local)
		Close(w_diagnos_maj_heine1)
//		page_suivante(w_diagnos_maj_heine1,w_diagnos_maj_heine2,var_code_local)
	end if
else
	openwithparm(w_diagnos_maj_heine2,var_code_local)
	close(w_diagnos_maj_heine1)
//	page_suivante(w_diagnos_maj_heine1,w_diagnos_maj_heine2,var_code_local)
end if

end event

