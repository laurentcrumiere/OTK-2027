global w_diagnos_maj_heine1 w_diagnos_maj_heine1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

ddlb_face.selectitem(integer(mid(page,1,1)))
ddlb_ht_etage.selectitem(integer(mid(page,2,1)))
ddlb_profil.selectitem(integer(mid(page,3,1)))

em_fma.text = RightTrim(mid(page,4,3))
em_d_haut.text = RightTrim(mid(page,7,30))
//em_g_haut.text = RightTrim(mid(page,22,15))
em_d_bas.text = RightTrim(mid(page,37,30))
//em_g_bas.text = RightTrim(mid(page,52,15))

ddlb_levres.selectitem(integer(mid(page,67,1)))
ddlb_frein.selectitem(integer(mid(page,68,1)))
//ddlb_vol_lang.selectitem(integer(mid(page,69,1)))
ddlb_lang.selectitem(integer(mid(page,70,1)))
ddlb_fw_db.selectitem(integer(mid(page,71,1)))
ddlb_sp_sp.selectitem(integer(mid(page,72,1)))
ddlb_amyg.selectitem(integer(mid(page,73,1)))
ddlb_vege.selectitem(integer(mid(page,74,1)))

mle_paro.text = Righttrim(mid(page,75,45))

ddlb_deglu.selectitem(integer(mid(page,120,1)))
ddlb_interpo.selectitem(integer(mid(page,121,1)))
ddlb_respi.selectitem(integer(mid(page,122,1)))
ddlb_clas_dent_g.selectitem(integer(mid(page,123,1)))
ddlb_clas_dent_d.selectitem(integer(mid(page,124,1)))

sle_aca.text = Righttrim(mid(page,125,30))
//sle_acl.text = Righttrim(mid(page,140,15))

em_dis_1.text = RightTrim(mid(page,155,2))
em_dis_2.text = RightTrim(mid(page,157,2))
em_dis_3.text = RightTrim(mid(page,159,2))
em_dis_4.text = RightTrim(mid(page,161,2))
em_za_d_haut.text = RightTrim(mid(page,163,2))
em_za_g_haut.text = RightTrim(mid(page,165,2))
em_za_d_bas.text = RightTrim(mid(page,167,2))
em_za_g_bas.text = RightTrim(mid(page,169,2))

ddlb_non_occlu.selectitem(integer(mid(page,171,1)))
ddlb_beance.selectitem(integer(mid(page,172,1)))
ddlb_prot.selectitem(integer(mid(page,173,1)))
ddlb_ret.selectitem(integer(mid(page,174,1)))
ddlb_transv_sup.selectitem(integer(mid(page,175,1)))
ddlb_sag_sup.selectitem(integer(mid(page,176,1)))

em_overjet.text = RightTrim(mid(page,177,3))
em_overbite.text = RightTrim(mid(page,180,3))
em_ind_pont.text = RightTrim(mid(page,183,3))

if mid(page,186,1) = "O" then
	cbx_ddd.checked = true
else
	cbx_ddd.checked = false
end if

sle_surnu.text = Righttrim(mid(page,187,23))
p_picture.visible = FALSE

IF (mid(page,187,23) <> space(23) ) THEN
	p_picture.visible = TRUE
	st_surnu.visible = TRUE
ELSE	
	st_surnu.visible = FALSE
END IF

sle_abse.text = Righttrim(mid(page,210,25))

IF (mid(page,210,25) <> space(25)) THEN
	p_picture.visible = TRUE
	st_absence.visible = TRUE
ELSE	
	st_absence.visible = FALSE
END IF

sle_extra.text = Righttrim(mid(page,235,25))
sle_carie.text = Righttrim(mid(page,260,25))

ddlb_hygie.selectitem(integer(mid(page,285,1)))

sle_resorp.text = RightTrim(mid(page,286,20))

if mid(page,306,1) = "O" then
	cbx_para.checked = true
else
	cbx_para.checked = false
end if

ddlb_suceur.selectitem(integer(mid(page,307,1)))

if mid(page,308,1) = "O" then
	cbx_atm.checked = true
else
	cbx_atm.checked = false
end if

ddlb_atm_dou.selectitem(integer(mid(page,309,1)))

mle_rem.text = RightTrim(mid(page,310,25))

ddlb_operation.selectitem(integer(mid(page,335,1)))

mle_ant_fam.text = RightTrim(mid(page,336,80))

IF (mid(page,4,3) = space(3)) THEN
	em_fma.text = string(22)
END IF

IF (mid(page,177,3) = space(3)) THEN
	em_overjet.text = string(2)
END IF

IF (mid(page,180,3) = space(3)) THEN
	em_overbite.text = string(2)
END IF


end subroutine

event open;date date_avant
date date_apres

var_code_local = message.doubleparm

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)


string vn,vm 
date vd
select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

date_avant = RelativeDate(Today(),-3)
date_apres= RelativeDate(Today(),+3)

dw_1.Modify("ans.Color = 0")
dw_1.Modify("st_ans.Color = 0")
dw_1.Modify("mois.Color = 0")
dw_1.Modify("st_mois.Color = 0")

IF (month(date_avant) = month (vd)) OR (month(date_apres) = month(vd)) THEN
	IF (month(date_avant) <> month(date_apres)) THEN
		IF ((day(vd) <= day(date_avant)) AND (day(vd) <= day(date_apres))) THEN
			dw_1.Modify("ans.Color = 16711680")
			dw_1.Modify("st_ans.Color = 16711680")
			dw_1.Modify("mois.Color = 16711680")
			dw_1.Modify("st_mois.Color = 16711680")	
		END IF
	ELSE
		IF ((day(vd) >= day(date_avant)) AND (day(vd) <= day(date_apres))) THEN
			dw_1.Modify("ans.Color = 16711680")
			dw_1.Modify("st_ans.Color = 16711680")
			dw_1.Modify("mois.Color = 16711680")
			dw_1.Modify("st_mois.Color = 16711680")
		END IF
	END IF
END IF

this.title = "Page N°1 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Date de naissance : " + string(vd,'dd/mm/yyyy') + " (Moulage : "+vm+")"

init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

end event

