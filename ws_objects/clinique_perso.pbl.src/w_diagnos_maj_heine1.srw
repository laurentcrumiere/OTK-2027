event clicked;place(string(ddlb_face.FindItem(ddlb_face.text,1)),page,1)
place(string(ddlb_ht_etage.FindItem(ddlb_ht_etage.text,1)),page,2)
place(string(ddlb_profil.FindItem(ddlb_profil.text,1)),page,3)

place_avec_blancs(em_fma.text,page,4,3)
place_avec_blancs(em_d_haut.text,page,7,30)
//place_avec_blancs(em_g_haut.text,page,22,15)
place_avec_blancs(em_d_bas.text,page,37,30)
//place_avec_blancs(em_g_bas.text,page,52,15)

place(string(ddlb_levres.FindItem(ddlb_levres.text,1)),page,67)
place(string(ddlb_frein.FindItem(ddlb_frein.text,1)),page,68)
//place(string(ddlb_vol_lang.FindItem(ddlb_vol_lang.text,1)),page,69)
place(string(ddlb_lang.FindItem(ddlb_lang.text,1)),page,70)
place(string(ddlb_fw_db.FindItem(ddlb_fw_db.text,1)),page,71)
place(string(ddlb_sp_sp.FindItem(ddlb_sp_sp.text,1)),page,72)
place(string(ddlb_amyg.FindItem(ddlb_amyg.text,1)),page,73)
place(string(ddlb_vege.FindItem(ddlb_vege.text,1)),page,74)

place_avec_blancs(mle_paro.text,page,75,45)

place(string(ddlb_deglu.FindItem(ddlb_deglu.text,1)),page,120)
place(string(ddlb_interpo.FindItem(ddlb_interpo.text,1)),page,121)
place(string(ddlb_respi.FindItem(ddlb_respi.text,1)),page,122)
place(string(ddlb_clas_dent_g.FindItem(ddlb_clas_dent_g.text,1)),page,123)
place(string(ddlb_clas_dent_d.FindItem(ddlb_clas_dent_d.text,1)),page,124)

place_avec_blancs(sle_aca.text,page,125,30)
//place_avec_blancs(sle_acl.text,page,140,15)

place_avec_blancs(em_dis_1.text,page,155,2)
place_avec_blancs(em_dis_2.text,page,157,2)
place_avec_blancs(em_dis_3.text,page,159,2)
place_avec_blancs(em_dis_4.text,page,161,2)
place_avec_blancs(em_za_d_haut.text,page,163,2)
place_avec_blancs(em_za_g_haut.text,page,165,2)
place_avec_blancs(em_za_d_bas.text,page,167,2)
place_avec_blancs(em_za_g_bas.text,page,169,2)

place(string(ddlb_non_occlu.FindItem(ddlb_non_occlu.text,1)),page,171)
place(string(ddlb_beance.FindItem(ddlb_beance.text,1)),page,172)
place(string(ddlb_prot.FindItem(ddlb_prot.text,1)),page,173)
place(string(ddlb_ret.FindItem(ddlb_ret.text,1)),page,174)
place(string(ddlb_transv_sup.FindItem(ddlb_transv_sup.text,1)),page,175)
place(string(ddlb_sag_sup.FindItem(ddlb_sag_sup.text,1)),page,176)

place_avec_blancs(em_overjet.text,page,177,3)
place_avec_blancs(em_overbite.text,page,180,3)
place_avec_blancs(em_ind_pont.text,page,183,3)

if cbx_ddd.checked then
	place("O",page,186)
else
	place("N",page,186)
end if

place_avec_blancs(sle_surnu.text,page,187,23)
p_picture.visible = FALSE

IF (mid(page,187,23) <> space(23)) THEN
	p_picture.visible = TRUE
	st_surnu.visible = TRUE
ELSE	
	st_surnu.visible = FALSE
END IF

place_avec_blancs(sle_abse.text,page,210,25)

IF (mid(page,210,25) <> space(25)) THEN
	p_picture.visible = TRUE
	st_absence.visible = TRUE
ELSE	
	st_absence.visible = FALSE
END IF


place_avec_blancs(sle_extra.text,page,235,25)
place_avec_blancs(sle_carie.text,page,260,25)

place(string(ddlb_hygie.FindItem(ddlb_hygie.text,1)),page,285)

place_avec_blancs(sle_resorp.text,page,286,20)

if cbx_para.checked then
	place("O",page,306)
else
	place("N",page,306)
end if

place(string(ddlb_suceur.FindItem(ddlb_suceur.text,1)),page,307)

if cbx_atm.checked then
	place("O",page,308)
else
	place("N",page,308)
end if

place(string(ddlb_atm_dou.FindItem(ddlb_atm_dou.text,1)),page,309)

place_avec_blancs(mle_rem.text,page,310,25)

place(string(ddlb_operation.FindItem(ddlb_operation.text,1)),page,335)

place_avec_blancs(mle_ant_fam.text,page,336,80)


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end event

