public subroutine save ()
public subroutine init ()
end prototypes

public subroutine save ();f.ecrirepage(sle_bag1,page,340,4)
f.ecrirepage(sle_bag2,page,344,4)
f.ecrirepage(sle_bag3,page,348,4)
