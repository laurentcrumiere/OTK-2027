 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"diagnos~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"diagnos.code~") COLUMN(NAME=~"diagnos.moins4~") COLUMN(NAME=~"diagnos.bgs1~") COLUMN(NAME=~"diagnos.bgs2~") COLUMN(NAME=~"diagnos.bgs3~") COLUMN(NAME=~"diagnos.bgs4~") COLUMN(NAME=~"diagnos.bgs5~") COLUMN(NAME=~"diagnos.bgs6~") COLUMN(NAME=~"diagnos.bgs7~") COLUMN(NAME=~"diagnos.bgs8~") COLUMN(NAME=~"diagnos.bgs9~") COLUMN(NAME=~"diagnos.bgs10~") COLUMN(NAME=~"diagnos.bgs11~") COLUMN(NAME=~"diagnos.bgs12~") COLUMN(NAME=~"diagnos.bgi1~") COLUMN(NAME=~"diagnos.bgi2~") COLUMN(NAME=~"diagnos.bgi3~") COLUMN(NAME=~"diagnos.bgi4~") COLUMN(NAME=~"diagnos.bgi5~") COLUMN(NAME=~"diagnos.bgi6~") COLUMN(NAME=~"diagnos.bgi7~") COLUMN(NAME=~"diagnos.bgi8~") COLUMN(NAME=~"diagnos.bgi9~") COLUMN(NAME=~"diagnos.bgi10~") COLUMN(NAME=~"diagnos.bgi11~") COLUMN(NAME=~"diagnos.bgi12~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"diagnos.code~" )WHERE(    EXP1 =~"~~~"diagnos~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " update="diagnos" updatewhere=1 updatekeyinplace=no arguments=(("nocode", number)) )
