type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

sle_consul.text = Righttrim(mid(page,300,15))
sle_heredite.text = Righttrim(mid(page,315,15))
sle_accident.text = Righttrim(mid(page,330,15))
sle_orl.text = Righttrim(mid(page,345,15))
sle_maladie.text = Righttrim(mid(page,360,15))
sle_interv.text = Righttrim(mid(page,375,15))
sle_alimen.text = Righttrim(mid(page,390,15))
sle_face.text = Righttrim(mid(page,405,15))
sle_levre.text = Righttrim(mid(page,420,15))
sle_atm.text = Righttrim(mid(page,435,15))
sle_profil.text = Righttrim(mid(page,450,15))
sle_stomion.text = Righttrim(mid(page,465,15))
sle_frein_sup.text = Righttrim(mid(page,480,15))
sle_cicatrices.text = Righttrim(mid(page,495,15))
sle_gingivite.text = Righttrim(mid(page,510,15))
sle_frein_inf.text = Righttrim(mid(page,525,15))
sle_poches.text = Righttrim(mid(page,540,15))

if mid(page,560,1) = "O" then
	cbx_proglis.checked = true
else
	cbx_proglis.checked = false
end if

if mid(page,561,1) = "O" then
	cbx_retroglis.checked = true
else
	cbx_retroglis.checked = false
end if

if mid(page,562,1) = "O" then
	cbx_lateroglis.checked = true
else
	cbx_lateroglis.checked = false
end if

if mid(page,563,1) = "O" then
	cbx_protect_dte.checked = true
else
	cbx_protect_dte.checked = false
end if

if mid(page,564,1) = "O" then
	cbx_protect_gche.checked = true
else
	cbx_protect_gche.checked = false
end if

if mid(page,565,1) = "O" then
	cbx_protec_ext.checked = true
else
	cbx_protec_ext.checked = false
end if

sle_respi.text = Righttrim(mid(page,570,10))
sle_deglu.text = Righttrim(mid(page,580,10))
sle_langue.text = Righttrim(mid(page,590,10))
sle_phona.text = Righttrim(mid(page,600,10))
sle_succion.text = Righttrim(mid(page,610,10))
sle_tics.text = Righttrim(mid(page,620,10))

em_sn.text = RightTrim(mid(page,640,3))
em_sna.text = RightTrim(mid(page,643,3))
em_snb.text = RightTrim(mid(page,646,3))
em_anb.text = RightTrim(mid(page,649,3))
em_fma.text = RightTrim(mid(page,652,3))
em_if.text = RightTrim(mid(page,655,3))
em_im.text = RightTrim(mid(page,658,3))
em_aobo.text = RightTrim(mid(page,661,3))

sle_autre.text = Righttrim(mid(page,665,15))

modif = false
end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()

end event

