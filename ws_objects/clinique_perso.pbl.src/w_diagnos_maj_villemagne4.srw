global w_diagnos_maj_villemagne4 w_diagnos_maj_villemagne4

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_d1.text = Righttrim(trim(mid(page,1700,10)))
em_d2.text = Righttrim(trim(mid(page,1710,10)))
em_d3.text = Righttrim(trim(mid(page,1720,10)))
em_d4.text = Righttrim(trim(mid(page,1730,10)))
em_d5.text = Righttrim(trim(mid(page,1740,10)))
em_d6.text = Righttrim(trim(mid(page,1750,10)))
em_d7.text = Righttrim(trim(mid(page,1760,10)))
em_d8.text = Righttrim(trim(mid(page,1770,10)))
em_d9.text = Righttrim(trim(mid(page,1780,10)))
em_d10.text = Righttrim(trim(mid(page,1790,10)))
em_d11.text = Righttrim(trim(mid(page,1800,10)))
em_d12.text = Righttrim(trim(mid(page,1810,10)))
em_d13.text = Righttrim(trim(mid(page,1820,10)))
em_d14.text = Righttrim(trim(mid(page,1830,10)))
em_d15.text = Righttrim(trim(mid(page,1840,10)))
em_d16.text = Righttrim(trim(mid(page,1850,10)))
em_d17.text = Righttrim(trim(mid(page,1860,10)))
em_d18.text = Righttrim(trim(mid(page,1870,10)))
em_d19.text = Righttrim(trim(mid(page,1880,10)))
em_d20.text = Righttrim(trim(mid(page,1890,10)))
// max carac 1900
em_d1.SetFocus()

end subroutine

event open;var_code_local = message.doubleparm


string vn,vm, vp 
date vd
integer an, mois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°4 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"



SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

end event

