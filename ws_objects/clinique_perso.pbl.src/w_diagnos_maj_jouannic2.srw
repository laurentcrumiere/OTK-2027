type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();//string pt		//, diag

//SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;

//  SELECT "patient"."traitement_effectue"  
//    INTO :diag  
//    FROM "patient"  
//   WHERE "patient"."code" = :var_code_local   ;

//mle_plan.text = pt
//mle_diagnostic.text = diag

mle_diagnostic.text = RightTrim(mid(page,3230,300))
mle_plan.text = RightTrim(mid(page,3530,450))

mle_col1.text = RightTrim(mid(page,2000,70))
mle_col2.text = RightTrim(mid(page,2100,70))
mle_col3.text = RightTrim(mid(page,2200,70))
mle_col4.text = RightTrim(mid(page,2300,70))

mle_remarques.text = RightTrim(mid(page,2400,200))
mle_reevaluation.text = RightTrim(mid(page,2600,200))
mle_extractions.text = RightTrim(mid(page,2800,150))

em_duree_pre.text = RightTrim(mid(page,2950,10))
em_degre_pre.text = RightTrim(mid(page,2960,10))
em_duree_rep.text = RightTrim(mid(page,2970,10))
em_degre_rep.text = RightTrim(mid(page,2980,10))

em_d1.text = trim(mid(page,2990,7))
em_d2.text = trim(mid(page,3000,7))
em_d3.text = trim(mid(page,3010,7))
em_d4.text = trim(mid(page,3020,7))

modif = false
cb_fermer.setfocus()
end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(6000)
end if

if len(page) < 6000 then
	page = page + space(6000 - len(page))
end if

init()



end event

