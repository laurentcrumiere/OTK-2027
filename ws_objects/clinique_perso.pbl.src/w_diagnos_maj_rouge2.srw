global w_diagnos_maj_rouge2 w_diagnos_maj_rouge2

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_d1.text = trim(mid(page,420,10))
em_d2.text = trim(mid(page,430,10))
em_d3.text = trim(mid(page,440,10))
em_d4.text = trim(mid(page,450,10))
em_d5.text = trim(mid(page,460,10))
em_d6.text = trim(mid(page,470,10))
em_d7.text = trim(mid(page,480,10))

mle_col1.text = RightTrim(mid(page,490,100))
mle_col2.text = RightTrim(mid(page,590,100))
mle_col3.text = RightTrim(mid(page,690,100))
mle_col4.text = RightTrim(mid(page,790,100))
mle_col5.text = RightTrim(mid(page,890,100))
mle_col6.text = RightTrim(mid(page,990,100))
mle_col7.text = RightTrim(mid(page,1090,100))

mle_remarque.text = RightTrim(mid(page,1190,80))

end subroutine

event open;var_code_local = message.doubleparm
string vn,vm 


select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if


this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()


end event

