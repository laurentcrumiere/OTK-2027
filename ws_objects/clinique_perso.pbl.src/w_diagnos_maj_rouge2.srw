type cb_enregistrer from commandbutton within w_diagnos_maj_rouge2
integer x = 2030
integer y = 1664
integer width = 384
integer height = 108
integer taborder = 170
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Enregistrer"
boolean default = true
end type

event clicked;
place(em_d1.text,page,420)
place(em_d2.text,page,430)
place(em_d3.text,page,440)
place(em_d4.text,page,450)
place(em_d5.text,page,460)
place(em_d6.text,page,470)
place(em_d7.text,page,480)

place_avec_blancs(mle_col1.text,page,490,100)
place_avec_blancs(mle_col2.text,page,590,100)
place_avec_blancs(mle_col3.text,page,690,100)
place_avec_blancs(mle_col4.text,page,790,100)
place_avec_blancs(mle_col5.text,page,890,100)
place_avec_blancs(mle_col6.text,page,990,100)
place_avec_blancs(mle_col7.text,page,1090,100)

place_avec_blancs(mle_remarque.text,page,1190,80)



UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if



end event

