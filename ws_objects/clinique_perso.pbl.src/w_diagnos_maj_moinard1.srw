this.ole_photo001=create ole_photo001
this.mle_plt=create mle_plt
this.mle_rem=create mle_rem
this.st_2=create st_2
this.st_1=create st_1
this.ole_photo005=create ole_photo005
this.ole_photo006=create ole_photo006
this.ole_photo007=create ole_photo007
this.Control[]={this.pb_2,&
this.pb_1,&
this.cb_fermer,&
this.cb_sauver,&
this.cb_annuler,&
this.cb_imprimer,&
this.ole_photo008,&
this.ole_photo004,&
this.ole_photo003,&
this.ole_photo002,&
this.ole_photo001,&
this.mle_plt,&
this.mle_rem,&
