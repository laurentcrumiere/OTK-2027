global w_diagnos_maj_moinard1 w_diagnos_maj_moinard1

type variables
double var_code_local 
boolean modif
string page
uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lirepage(mle_rem,page,1,500)	//max carac = 501
f.lire_pt(mle_plt,var_code_local)

cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(mle_rem,page,1,500)	//max carac = 501
f.ecrire_pt(mle_plt,var_code_local)


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

on w_diagnos_maj_moinard1.create
this.pb_2=create pb_2
