global w_diagnos_maj_villemagne2 w_diagnos_maj_villemagne2

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_d1.text = Righttrim(trim(mid(page,1410,10)))
em_d2.text = Righttrim(trim(mid(page,1420,10)))
em_d3.text = Righttrim(trim(mid(page,1430,10)))
em_d4.text = Righttrim(trim(mid(page,1440,10)))
em_d5.text = Righttrim(trim(mid(page,1450,10)))
em_d6.text = Righttrim(trim(mid(page,1460,10)))
em_d7.text = Righttrim(trim(mid(page,1470,10)))
em_d8.text = Righttrim(trim(mid(page,1480,10)))
em_d9.text = Righttrim(trim(mid(page,1490,10)))
em_d10.text = Righttrim(trim(mid(page,1500,10)))
em_d11.text = Righttrim(trim(mid(page,1510,10)))
em_d12.text = Righttrim(trim(mid(page,1520,10)))
em_d13.text = Righttrim(trim(mid(page,1530,10)))
em_d14.text = Righttrim(trim(mid(page,1540,10)))
em_d15.text = Righttrim(trim(mid(page,1550,10)))
em_d16.text = Righttrim(trim(mid(page,1560,10)))
em_d17.text = Righttrim(trim(mid(page,1570,10)))
em_d18.text = Righttrim(trim(mid(page,1580,10)))
em_d19.text = Righttrim(trim(mid(page,1590,10)))
em_d20.text = Righttrim(trim(mid(page,1600,10)))

em_d1.SetFocus()

end subroutine

event open;var_code_local = message.doubleparm


string vn,vm, vp 
date vd
integer an, mois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°2 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"



SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

end event

