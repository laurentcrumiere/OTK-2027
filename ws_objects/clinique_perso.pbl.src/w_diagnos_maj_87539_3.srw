event clicked;if modif then
	if MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre sans enregistrer ?",Question!,YesNo!) = 1 then
		if ui_v2020 then
			OpenWithParm( w_diagnos_maj_87539_2, var_code_local, w_mdi_2020)
		else
			OpenSheetWithParm(w_diagnos_maj_87539_2,var_code_local,w_mdi,1,Original!)
		end if
		Close(parent)
	end if
else
	if ui_v2020 then
		OpenWithParm( w_diagnos_maj_87539_2, var_code_local, w_mdi_2020)
	else
		OpenSheetWithParm(w_diagnos_maj_87539_2,var_code_local,w_mdi,1,Original!)
	end if
	close(parent)
end if

end event

