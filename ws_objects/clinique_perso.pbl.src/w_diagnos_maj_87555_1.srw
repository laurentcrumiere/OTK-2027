type sle_troubles_coag from singlelineedit within w_diagnos_maj_87555_1
integer x = 1198
integer y = 2072
integer width = 1495
integer height = 68
integer taborder = 950
boolean bringtotop = true
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long textcolor = 33554432
integer limit = 60
borderstyle borderstyle = stylelowered!
end type

event modified;// Si il y a du texte de renseigné, il apparaît en rouge sur fond jaune sinon, on repasse en noir sur fond blanc

if len(Trim(this.text))>0 then
	// Texte en Rouge sur fond Jaune
	This.TextColor = RGB(255,0,0)
	This.BackColor = RGB(255,255,0)
	// Titre en Rouge & Gras
	st_coagulation.TextColor = RGB(255,0,0)
	st_coagulation.Weight = 700
else
	// Texte  en Noir sur fond Blanc
	This.TextColor = RGB(0,0,0)
	This.BackColor = RGB(255,255,255)
	// Titre normal
	st_coagulation.TextColor = RGB(0,0,0)
	st_coagulation.Weight = 400
end if
end event

