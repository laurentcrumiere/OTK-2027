event modified;// Si il y a du texte de renseigné, il apparaît en rouge sur fond jaune sinon, on repasse en noir sur fond blanc

if len(Trim(this.text))>0 then
	// Texte en Rouge sur fond Jaune
	This.TextColor = RGB(255,0,0)
	This.BackColor = RGB(255,255,0)
	// Titre en Rouge & Gras
	st_allergies.TextColor = RGB(255,0,0)
	st_allergies.Weight = 700
else
	// Texte  en Noir sur fond Blanc
	This.TextColor = RGB(0,0,0)
	This.BackColor = RGB(255,255,255)
	// Titre normal
	st_allergies.TextColor = RGB(0,0,0)
	st_allergies.Weight = 400
end if
end event

