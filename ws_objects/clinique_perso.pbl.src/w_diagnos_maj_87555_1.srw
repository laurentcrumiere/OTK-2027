// Gestion du menu déroulant pour la FACE
IF rb_asym.Checked = TRUE then
	ddlb_asym.visible = TRUE
ELSE
	ddlb_asym.visible = FALSE
END IF

// Gestion du menu déroulant pour la déviation du CIS
IF rb_deviation_cis_oui.Checked = TRUE then
	ddlb_deviation_cis.visible = TRUE
ELSE
	ddlb_deviation_cis.visible = FALSE
END IF

// Gestion du menu déroulant pour la déviation du CII
IF rb_deviation_cii_oui.Checked = TRUE then
	ddlb_deviation_cii.visible = TRUE
ELSE
	ddlb_deviation_cii.visible = FALSE
END IF

// Mise en valeur pour les troubles de la coagulation
IF len(Trim(sle_troubles_coag.text))>0 THEN
	// Texte en Rouge sur fond Jaune
	sle_troubles_coag.TextColor = RGB(255,0,0)
	sle_troubles_coag.BackColor = RGB(255,255,0)
	// Titre en Rouge & Gras
	st_coagulation.TextColor = RGB(255,0,0)
	st_coagulation.Weight = 700
END IF

// Mise en valeur pour les allergies
IF len(Trim(sle_allergies.text))>0 THEN
	// Texte en Rouge sur fond Jaune
	sle_allergies.TextColor = RGB(255,0,0)
	sle_allergies.BackColor = RGB(255,255,0)
	// Titre en Rouge & Gras
	st_allergies.TextColor = RGB(255,0,0)
	st_allergies.Weight = 700
END IF
