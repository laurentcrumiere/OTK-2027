public subroutine load_ctrls ();string	moulage_str

select moulage into :moulage_str from patient where code = :var_code_local ;
if isnull(moulage_str) then moulage_str = ""
sle_1.text = moulage_str

f.lirepage(sle_3,page_buffer[1],1,40)
f.lirepage(sle_4,page_buffer[1],41,40)
