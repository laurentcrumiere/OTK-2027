type variables
boolean modif
// pour savoir si la feuille est signée ou pas
string v_signe, v_signataire
boolean maj_signature = false
end variables

forward prototypes
public subroutine info_signature (string vv_signe)
public subroutine unload_ctrls ()
public subroutine load_ctrls ()
end prototypes

public subroutine info_signature (string vv_signe);if vv_signe = "O" then
	// déjà signé
	cb_signer.text = "Annul. Signer"
	// On doit verrouiller des trucs !!!!
	cbx_disjonc.enabled = false
	cbx_plaque.enabled = false
	cbx_encrage_e-o.enabled = false
	cbx_lip_bumper.enabled = false
	st_7.enabled = false
	sle_dents_extrac.enabled = false
	cbx_arc_ling.enabled = false
	cbx_activateur.enabled = false
	cbx_autres_dents_incl.enabled = false
	st_8.enabled = false
	sle_dents_can_incl.enabled = false
	st_9.enabled = false
	sle_autres_dents_incl.enabled = false
	cbx_ancrage_extra_oral.enabled = false
	cbx_recul.enabled = false
	rb_zygomatique.enabled = false
	rb_minivis.enabled = false
	cbx_forsus.enabled = false
	cbx_d-o.enabled = false
	st_10.enabled = false
	sle_gonflements_dents.enabled = false
	cbx_parodontologie.enabled = false
	rb_parodont_chron.enabled = false
	rb_parodont_agress.enabled = false
	cbx_chirurgie.enabled = false
	rb_classe_2.enabled = false
	rb_classe_3.enabled = false
	rb_bimax.enabled = false
	rb_impaction.enabled = false
	rb_frenectomie.enabled = false
	cbx_t-dream.enabled = false
	cbx_resmed.enabled = false

	// La date
	sle_10.enabled = false
	dw_prati.enabled = false
	
	// On simule le clic sur le bouton "Enregistrer" pour valider les dernières modifications au moment de la signature
	cb_sauver.triggerevent(clicked!)
	
else
	
	// pas encore
	cb_signer.text = "Signer"
		// On doit déverrouiller des trucs !!!!
		cbx_disjonc.enabled = true
		cbx_plaque.enabled = true
		cbx_encrage_e-o.enabled = true
		cbx_lip_bumper.enabled = true
		st_7.enabled = true
		sle_dents_extrac.enabled = true
		cbx_arc_ling.enabled = true
		cbx_activateur.enabled = true
		cbx_autres_dents_incl.enabled = true
		st_8.enabled = true
		sle_dents_can_incl.enabled = true
		st_9.enabled = true
		sle_autres_dents_incl.enabled = true
		cbx_ancrage_extra_oral.enabled = true
		cbx_recul.enabled = true
		if cbx_recul.checked then
			rb_zygomatique.enabled = true
			rb_minivis.enabled = true
		end if
		cbx_forsus.enabled = true
		cbx_d-o.enabled = true
		st_10.enabled = true
		sle_gonflements_dents.enabled = true
		cbx_parodontologie.enabled = true
		if cbx_parodontologie.checked then
			rb_parodont_chron.enabled = true
			rb_parodont_agress.enabled = true
		end if
		cbx_chirurgie.enabled = true
		if cbx_chirurgie.checked then
			rb_classe_2.enabled = true
			rb_classe_3.enabled = true
			rb_bimax.enabled = true
			rb_impaction.enabled = true
			rb_frenectomie.enabled = true
		end if
		cbx_t-dream.enabled = true
		cbx_resmed.enabled = true
		// La date
		sle_10.enabled = true
		dw_prati.enabled = true
		
end if
end subroutine

public subroutine unload_ctrls ();
f.ecrirepage(sle_10,page_buffer[2],4050,10)
f.ecrirepage(cbx_disjonc,page_buffer[2],4060)
f.ecrirepage(cbx_plaque,page_buffer[2],4061)
f.ecrirepage(cbx_encrage_e-o,page_buffer[2],4062)
f.ecrirepage(cbx_lip_bumper,page_buffer[2],4063)
f.ecrirepage(cbx_arc_ling,page_buffer[2],4064)
f.ecrirepage(cbx_activateur,page_buffer[2],4065)
f.ecrirepage(cbx_ancrage_extra_oral,page_buffer[2],4066)
f.ecrirepage(cbx_recul,page_buffer[2],4067)
f.ecrirepage(cbx_forsus,page_buffer[2],4068)
f.ecrirepage(cbx_prothese,page_buffer[2],4069)
f.ecrirepage(cbx_d-o,page_buffer[2],4070)
f.ecrirepage(cbx_parodontologie,page_buffer[2],4071)
f.ecrirepage(cbx_chirurgie,page_buffer[2],4072)
f.ecrirepage(sle_dents_extrac,page_buffer[2],4073,20)
f.ecrirepage(sle_dents_can_incl,page_buffer[2],4093,20)
f.ecrirepage(cbx_autres_dents_incl,page_buffer[2],4113)
f.ecrirepage(sle_autres_dents_incl,page_buffer[2],4114,20)
f.ecrirepage(rb_zygomatique,page_buffer[2],4134)
f.ecrirepage(rb_minivis,page_buffer[2],4135)
f.ecrirepage(sle_gonflements_dents,page_buffer[2],4136,20)
f.ecrirepage(rb_parodont_chron,page_buffer[2],4156)
f.ecrirepage(rb_parodont_agress,page_buffer[2],4157)
f.ecrirepage(rb_classe_2,page_buffer[2],4158)
f.ecrirepage(rb_classe_3,page_buffer[2],4159)
f.ecrirepage(rb_bimax,page_buffer[2],4160)
f.ecrirepage(rb_impaction,page_buffer[2],4161)
f.ecrirepage(rb_frenectomie,page_buffer[2],4162)
f.ecrirepage(sle_degagement_dents,page_buffer[2],4163,20)
f.ecrirepage(cbx_t-dream,page_buffer[2],4183)
f.ecrirepage(cbx_resmed,page_buffer[2],4184)
f.ecrirepage(sle_6,page_buffer[2],4185,80)
// max carac = 4265


if maj_signature then

	update diagnos set plus1 = :v_signe, plan_traitement = :v_signataire  
	where code = :var_code_local ;
	
	if sqlca.sqlcode = 0 then 
		commit ;
	else
		rollback ;
		Messagebox("ATTENTION","Erreur lors de la mise à jour de la signature")
	end if
	
	info_signature(v_signe)
end if
end subroutine

public subroutine load_ctrls ();
f.lirepage(sle_10,page_buffer[1],4050,10)
f.lirepage(cbx_disjonc,page_buffer[1],4060)
f.lirepage(cbx_plaque,page_buffer[1],4061)
f.lirepage(cbx_encrage_e-o,page_buffer[1],4062)
f.lirepage(cbx_lip_bumper,page_buffer[1],4063)
f.lirepage(cbx_arc_ling,page_buffer[1],4064)
f.lirepage(cbx_activateur,page_buffer[1],4065)
f.lirepage(cbx_ancrage_extra_oral,page_buffer[1],4066)
f.lirepage(cbx_recul,page_buffer[1],4067)
f.lirepage(cbx_forsus,page_buffer[1],4068)
f.lirepage(cbx_prothese,page_buffer[1],4069)
f.lirepage(cbx_d-o,page_buffer[1],4070)
f.lirepage(cbx_parodontologie,page_buffer[1],4071)
f.lirepage(cbx_chirurgie,page_buffer[1],4072)
f.lirepage(sle_dents_extrac,page_buffer[1],4073,20)
f.lirepage(sle_dents_can_incl,page_buffer[1],4093,20)
f.lirepage(cbx_autres_dents_incl,page_buffer[1],4113)
f.lirepage(sle_autres_dents_incl,page_buffer[1],4114,20)
f.lirepage(rb_zygomatique,page_buffer[1],4134)
f.lirepage(rb_minivis,page_buffer[1],4135)
f.lirepage(sle_gonflements_dents,page_buffer[1],4136,20)
f.lirepage(rb_parodont_chron,page_buffer[1],4156)
f.lirepage(rb_parodont_agress,page_buffer[1],4157)
f.lirepage(rb_classe_2,page_buffer[1],4158)
f.lirepage(rb_classe_3,page_buffer[1],4159)
f.lirepage(rb_bimax,page_buffer[1],4160)
f.lirepage(rb_impaction,page_buffer[1],4161)
f.lirepage(rb_frenectomie,page_buffer[1],4162)
f.lirepage(sle_degagement_dents,page_buffer[1],4163,20)
f.lirepage(cbx_t-dream,page_buffer[1],4183)
f.lirepage(cbx_resmed,page_buffer[1],4184)
f.lirepage(sle_6,page_buffer[1],4185,80)
// max carac = 4265


// Activation des boutons radio si choix cochés
if cbx_recul.checked then
	rb_zygomatique.enabled = true
	rb_minivis.enabled = true
end if

if cbx_parodontologie.checked then
	rb_parodont_chron.enabled = true
	rb_parodont_agress.enabled = true
end if

if cbx_chirurgie.checked then
	rb_classe_2.enabled = true
	rb_classe_3.enabled = true
	rb_bimax.enabled = true
	rb_impaction.enabled = true
	rb_frenectomie.enabled = true
end if


// pour la signature
dw_prati.settransobject(sqlca)
dw_prati.retrieve()

// Le champ plus1 servira à stocker si la page 4 est signée ou pas
// vaudra "O" si signée

// le champ plan_traitement de diagnos servira à la signature de la page 4
select isnull(plus1,'N'), isnull(plan_traitement,'') 
into :v_signe, :v_signataire from diagnos  where code = :var_code_local ;

if v_signataire <> '' then
	dw_prati.Scrolltorow(dw_prati.Find("code = '"+ v_signataire+"'", 0, 9999))
end if

info_signature(v_signe)

end subroutine

