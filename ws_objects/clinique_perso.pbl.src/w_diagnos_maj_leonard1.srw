destroy(this.ddlb_7)
destroy(this.ddlb_8)
destroy(this.ddlb_16)
destroy(this.ddlb_17)
destroy(this.ddlb_18)
end on

event open;var_code_local = message.doubleparm

string vn,vp
date vd
integer an, mois_local
double v_numero_dossier

select nom, prenom, date_naissance, numero_dossier INTO :vn,:vp,:vd, :v_numero_dossier FROM patient WHERE code = :var_code_local ;

if isnull(vn) then
	vn = ""
end if
if isnull(vp) then
	vp = ""
end if
if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois_local = month(today()) - month( vd ) +12
ELSE
	mois_local = month(today()) - month( vd )
END IF

this.title = "Page Clinique N°1 : " + vn + " " + vp +" - N° dossier : "+string(v_numero_dossier) + " - Age : " + string(an) + " ans " + string(mois_local) + " mois "

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

init()
mep_win_mdi(this,1)

end event

