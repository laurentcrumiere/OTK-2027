event cb_sauver::clicked;call super::clicked;//// Mise à jour de la durée de traitement
//integer duree_choisie
//
//select duree_traitement
//into :duree_choisie
//from patient where patient.code = :var_code_local ;
//
//if ddlb_duree.Text = '6 m' then duree_choisie = 1
//if ddlb_duree.Text = '12 m' then duree_choisie = 2
//if ddlb_duree.Text = '18 m' then duree_choisie = 3
//if ddlb_duree.Text = '24 m' then duree_choisie = 4
//if ddlb_duree.Text = '30 m' then duree_choisie = 5
//if ddlb_duree.Text = '36 m' then duree_choisie = 6
//
//Update patient
//Set duree_traitement = :duree_choisie
//Where patient.code = :var_code_local ;
//
//// -----------------------------------------------------------------------------------------------------
//
//string fact_fonc, agen, malpos
//
//if (cbx_pouce.Checked = TRUE ) or (cbx_levre.checked = true ) or (cbx_langue.checked = true ) or (cbx_tetine.checked = true ) then
//	fact_fonc = "Succion: "
//	if (cbx_tetine.Checked = TRUE ) then fact_fonc = fact_fonc + "tétine, "
//	if (cbx_pouce.Checked = TRUE ) then fact_fonc = fact_fonc + "pouce, "
//	if (cbx_levre.Checked = TRUE ) then fact_fonc = fact_fonc + "lèvre, "
//	if (cbx_langue.Checked = TRUE ) then fact_fonc = fact_fonc + "langue "
//end if
//
//if (cbx_onycoph.Checked = TRUE ) then fact_fonc = fact_fonc + " / Onychophagie"
//if (cbx_bruxisme.Checked = TRUE ) then fact_fonc = fact_fonc + " / Bruxisme"
//if (cbx_ronflements.Checked = TRUE ) then fact_fonc = fact_fonc + " / Ronflement"
//
//
//
//// Mise à jour des Facteurs Fonctionnels dans le Diagnostic patient
//
//string	lstr_clas, lstr_fact, lstr_agen, lstr_malpos
//
//char lc_bas_max_pro, lc_bas_max_ret, lc_bas_max_end, lc_bas_max_exo
//char lc_bas_mand_pro, lc_bas_mand_ret
//char lc_bas_hypo, lc_bas_hyper, lc_dys_dentm
//
//char lc_alv_max_pro, lc_alv_max_ret
//char lc_alv_mand_pro, lc_alv_mand_ret
//char lc_supra, lc_infra
//char lc_oc_d, lc_oc_ant, lc_oc_g, lc_dys_dentd
//
//char lc_can_cl1, lc_can_cl2, lc_can_cl3
//string lc_can
//
//char lc_mol_cl1, lc_mol_cl2, lc_mol_cl3
//string lc_mol
//
//// zone "diagnostic"
//select classe, facteur, agenesie, malposition, alveo_max_pro, alveo_max_retro, alveo_mand_pro, alveo_mand_retro
//, alveo_mand_endo, alveo_mand_exo, supraclusion, infraclusion, occl_dte, occl_gche, occl_ant
//, basal_max_pro, basal_max_retro, basal_max_endo, basal_max_exo, basal_mand_pro, basal_mand_retro, hypodivergence, hyperdivergence
//, dento_max, dento_dent, can_cl1, can_cl2, can_cl3, canine, mol_cl1, mol_cl2, mol_cl3, molaire
//into :lstr_clas, :lstr_fact, :lstr_agen, :lstr_malpos, :lc_alv_max_pro, :lc_alv_max_ret, :lc_alv_mand_pro, :lc_alv_mand_ret
//, :lc_supra, :lc_infra, :lc_oc_d, :lc_oc_ant, :lc_oc_g, :lc_bas_max_pro, :lc_bas_max_ret, :lc_bas_max_end, :lc_bas_max_exo, :lc_bas_mand_pro
//, :lc_bas_mand_ret, :lc_bas_hypo, :lc_bas_hyper, :lc_dys_dentm, :lc_dys_dentd, :lc_can_cl1, :lc_can_cl2, :lc_can_cl3, :lc_can
//, :lc_mol_cl1, :lc_mol_cl2, :lc_mol_cl3, :lc_mol
//from patient where patient.code = :var_code_local ;
//
//// Ajout de la classe
//if rb_ClI.checked = true then lstr_clas = "Classe I"
//if rb_ClII.checked = true then lstr_clas = "Classe II"
//if rb_ClII1.checked = true then lstr_clas = "Classe II 1"
//if rb_ClII2.checked = true then lstr_clas = "Classe II 2"
//if rb_ClIII.checked = true then lstr_clas = "Classe III"
//
//
//// Ajout des commentaires du cadre "PARAFONCTIONS"
//lstr_fact = fact_fonc
//
//// Cadre "DENTAIRE" supprimé le 09/11/16
//// Ajout des commentaires du cadre "DENTAIRE"
