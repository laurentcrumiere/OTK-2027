// max carac = 690


end subroutine

public function long change_couleur (long couleur);
if couleur = couleur_jaune then
	return couleur_rouge
else
	if couleur = couleur_rouge then 
		return couleur_orange
	else
		if couleur = couleur_orange then
			return couleur_jour_interdit
		else
			if couleur = couleur_jour_interdit then
				return couleur_jaune
			end if
		end if
	end if
end if

end function

public function character get_code_couleur (long couleur);choose case couleur 
	case couleur_jaune 
		return "J"
	case couleur_orange
		return "M"
	case couleur_jour_interdit
		return "G"
	case couleur_rouge
		return "R"
	case else
		return "?"
end choose
	
end function

public function long set_couleur (character code_couleur);choose case code_couleur 
	case "J"
		return couleur_jaune 
	case  "M"
		return couleur_orange
	case "G"
		return couleur_jour_interdit 
	case "R"
		return couleur_rouge 
	case else
		return couleur_jour_interdit
end choose
	
end function

