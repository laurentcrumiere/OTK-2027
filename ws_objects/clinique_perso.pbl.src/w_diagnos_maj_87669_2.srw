f.ecrirepage(sle_trajet_ouv,page_buffer[2],1434,60)
f.ecrirepage(sle_trajet_ferm,page_buffer[2],1494,60)
f.ecrirepage(sle_diag_atm_rem,page_buffer[2],1554,60)
f.ecrirepage(ddlb_ddm_lat1,page_buffer[2],1614,1)
f.ecrirepage(cbx_douleurs,page_buffer[2],1615)
f.ecrirepage(cbx_craq_claq,page_buffer[2],1616)
// max carac = 1617

end subroutine

public function integer save_buffer ();// fx qui sauvegarde les données du buffers secondaire (page_buffer[2]) vers la BD

integer return_val = -1


// on tante de save les données ds la base
UPDATE               diagnos
SET                        perso = :page_buffer[2]
WHERE                                code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
// un pb survient
                rollback ;
                // alerte utilisateur
                son(4)
                Messagebox("ERREUR ...","Sauvegarde des données impossible !~n~n" + SQLCA.SqlErrText, StopSign!)
                
else
// no pb pendant maj BD
                COMMIT ;

                p_sablier.visible = true
                fxg_copie_ecran ( var_code_local, "Page2.jpg",this)
                p_sablier.visible = false

                // à l'arrivé les 2 buffers doivent être identiques
                page_buffer[1] = page_buffer[2]
                // maj val retour
                return_val = 1
end if

return return_val

end function

