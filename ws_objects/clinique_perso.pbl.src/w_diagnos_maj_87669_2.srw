type cb_1 from commandbutton within w_diagnos_maj_87669_2
integer x = 4443
integer y = 2312
integer width = 1102
integer height = 112
integer taborder = 450
boolean bringtotop = true
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Générer Diagnostic / Plan de traitement"
end type

event clicked;string pt, diagnos, comm_img
double v_temps_traitement

// Récupération des commentaires du tableau de mesures ODR pour insertion dans le Diag.

select top 1 temps_traitement into :v_temps_traitement from images_infos  where code = :var_code_local order by date_acquis desc ;
SELECT isnull(commentaires_html, '') INTO :comm_img FROM images_infos WHERE code = :var_code_local AND type_image = 50 AND temps_traitement = :v_temps_traitement ;

diagnos = comm_img


// Génération du plan de traitement par défaut

pt = 'Traitement fixe bimaxillaire :' + char(13) + char(10) + '1) Nivellement' + char(13) + char(10) + '2) Phase active' + char(13) + char(10) + '3) Finitions' + char(13) + char(10) + '4) Contentions' + char(13) + char(10) + '5) Surveillance DDS'

// Génération du diagnostic à partir des éléments saisis

if isnull(ddlb_clas_c_g.Text) then
	ddlb_clas_c_g.Text = ""
end if

if isnull(ddlb_clas_m_g.Text) then
	ddlb_clas_m_g.Text = ""
end if

if isnull(ddlb_clas_c_d.Text) then
	ddlb_clas_c_d.Text = ""
end if

if isnull(ddlb_clas_m_d.Text) then
	ddlb_clas_m_d.Text = ""
end if
if len(trim(diagnos)) > 0 then 
	diagnos = diagnos + char(13) + char(10)
end if

diagnos = diagnos + "Classe d'angle :" + char(13) + char(10) + 'Gauche    C = ' + ddlb_clas_c_g.Text + '     M = ' + ddlb_clas_m_g.Text + char(13) + char(10)
diagnos = diagnos + 'Droite    C = ' + ddlb_clas_c_d.Text + '     M = ' + ddlb_clas_m_d.Text

// Enregistrement en base de données du diagnostic et plan de traitement

UPDATE patient SET plan_traitement_html = :pt, traitement_effectue_html = :diagnos WHERE code = :var_code_local ;


if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
	rollback ;
else
	sauvegarder(false)
	
	if SQLCA.Sqlcode <> 0 then
		son(4)
		Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
		rollback ;
	else
		modif = false
		COMMIT ;
		MessageBox("Enregistrement", "Transfert effectué !")
	end if
end if
end event

