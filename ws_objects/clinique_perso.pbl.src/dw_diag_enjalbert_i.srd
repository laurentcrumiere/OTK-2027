 retrieve="  SELECT ~"patient~".~"code~",   
         ~"patient~".~"traitement_effectue~",   
         ~"patient~".~"plan_traitement~",   
         ~"patient~".~"traitement_effectue_html~",   
         ~"patient~".~"plan_traitement_html~",   
         ~"patient~".~"commentaire_html~"  
    FROM ~"patient~"  
   WHERE  ~"patient~".~"code~" = :var_code     
" update="patient" updatewhere=0 updatekeyinplace=yes arguments=(("var_code", number)) )
