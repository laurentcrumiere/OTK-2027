event clicked;place(string(ddlb_face.FindItem(ddlb_face.text,1)),page,1)
place(string(ddlb_profil.FindItem(ddlb_profil.text,1)),page,2)
place(string(ddlb_menton.FindItem(ddlb_menton.text,1)),page,3)
place(string(ddlb_stomion.FindItem(ddlb_stomion.text,1)),page,4)
place(string(ddlb_levre_sup.FindItem(ddlb_levre_sup.text,1)),page,5)
place(string(ddlb_levre_inf.FindItem(ddlb_levre_inf.text,1)),page,6)
place(string(ddlb_frein_langue.FindItem(ddlb_frein_langue.text,1)),page,7)
place(string(ddlb_frein_levre.FindItem(ddlb_frein_levre.text,1)),page,8)
place(string(ddlb_articule.FindItem(ddlb_articule.text,1)),page,9)
place(string(ddlb_beance.FindItem(ddlb_beance.text,1)),page,10)
place(string(ddlb_milieux.FindItem(ddlb_milieux.text,1)),page,11)
place(string(ddlb_mand.FindItem(ddlb_mand.text,1)),page,12)
place(string(ddlb_chemin.FindItem(ddlb_chemin.text,1)),page,13)
place(string(ddlb_respiration.FindItem(ddlb_respiration.text,1)),page,14)
place(string(ddlb_deglutition.FindItem(ddlb_deglutition.text,1)),page,15)
place(string(ddlb_mast.FindItem(ddlb_mast.text,1)),page,16)
place(string(ddlb_langue.FindItem(ddlb_langue.text,1)),page,17)
place(string(ddlb_contract.FindItem(ddlb_contract.text,1)),page,18)
place(string(ddplb_tonicite.FindItem(ddplb_tonicite.text,1)),page,19)
place(string(ddlb_para.FindItem(ddlb_para.text,1)),page,20)

	//if	rb_ddm_sup.checked then
	//	place("1",page,21)
	//else
	//	if	rb_ddm_inf.checked then
	//		place("2",page,21)
	//	else	
	//		place("3",page,21)
	//	end if	
	//end if
if cbx_ddm_sup.checked then
	place("1",page,3300)
else
	place("0",page,3300)
end if
if cbx_ddm_inf.checked then
	place("1",page,3301)
else
	place("0",page,3301)
end if
if cbx_ddd.checked then
	place("1",page,3302)
else
	place("0",page,3302)
end if


place_avec_blancs(em_date_du_jour.text,page,30,10)

place_avec_blancs(em_6d.text,page,40,5)
