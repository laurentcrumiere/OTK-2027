global w_diagnos_maj_jouannic1 w_diagnos_maj_jouannic1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

ddlb_face.selectitem(integer(mid(page,1,1)))
ddlb_profil.selectitem(integer(mid(page,2,1)))
ddlb_menton.selectitem(integer(mid(page,3,1)))
ddlb_stomion.selectitem(integer(mid(page,4,1)))
ddlb_levre_sup.selectitem(integer(mid(page,5,1)))
ddlb_levre_inf.selectitem(integer(mid(page,6,1)))
ddlb_frein_langue.selectitem(integer(mid(page,7,1)))
ddlb_frein_levre.selectitem(integer(mid(page,8,1)))
ddlb_articule.selectitem(integer(mid(page,9,1)))
ddlb_beance.selectitem(integer(mid(page,10,1)))
ddlb_milieux.selectitem(integer(mid(page,11,1)))
ddlb_mand.selectitem(integer(mid(page,12,1)))
ddlb_chemin.selectitem(integer(mid(page,13,1)))
ddlb_respiration.selectitem(integer(mid(page,14,1)))
ddlb_deglutition.selectitem(integer(mid(page,15,1)))
ddlb_mast.selectitem(integer(mid(page,16,1)))
ddlb_langue.selectitem(integer(mid(page,17,1)))
ddlb_contract.selectitem(integer(mid(page,18,1)))
ddplb_tonicite.selectitem(integer(mid(page,19,1)))
ddlb_para.selectitem(integer(mid(page,20,1)))

	//if mid(page,21,1) = '1' OR mid(page,21,1) = ' ' then
	//	rb_ddm_sup.checked = true
	//else
	//	if mid(page,21,1) = '2' then
	//		rb_ddm_inf.checked = true
	//	else
	//		rb_ddd.checked = true
	//	end if
	//end if		
if mid(page,3300,1)='1' then
	cbx_ddm_sup.checked=true
else
	cbx_ddm_sup.checked=false
end if
if mid(page,3301,1)='1' then
	cbx_ddm_inf.checked=true
else
	cbx_ddm_inf.checked=false
end if
if mid(page,3302,1)='1' then
	cbx_ddd.checked=true
else
	cbx_ddd.checked=false
end if


em_date_du_jour.text = Righttrim(mid(page,30,10))

IF mid(page,30,10) = space(10) THEN
	em_date_du_jour.text = string(today (),'dd/mm/yyyy')
END IF 

em_6d.text = Righttrim(mid(page,40,5))
em_3d.text = Righttrim(mid(page,45,5))
em_ob.text = Righttrim(mid(page,50,5))
em_6g.text = Righttrim(mid(page,55,5))
em_3g.text = Righttrim(mid(page,60,5))
em_oj.text = Righttrim(mid(page,65,5))

em_choc.text = Righttrim(mid(page,70,15))
em_dysplasie.text = Righttrim(mid(page,85,15))
em_surnum.text = Righttrim(mid(page,100,15))

sle_dt_manq.text = Righttrim(mid(page,150,50))
sle_dt_proth.text = Righttrim(mid(page,200,50))
sle_recession.text = Righttrim(mid(page,250,50))
sle_mobilite.text = Righttrim(mid(page,300,50))
sle_defaut.text = Righttrim(mid(page,350,50))

mle_motif.text = Righttrim(trim(mid(page,400,250)))
mle_ant.text = Righttrim(trim(mid(page,650,250)))
mle_anoter.text = Righttrim(trim(mid(page,900,250)))
mle_endo.text = Righttrim(trim(mid(page,1150,150)))
mle_paro.text = Righttrim(trim(mid(page,1300,150)))
mle_chemin.text = Righttrim(trim(mid(page,1450,150)))
mle_fonct.text = Righttrim(trim(mid(page,1600,150)))
mle_observ.text = Righttrim(trim(mid(page,1750,250)))

em_date_du_jour.SetFocus()
end subroutine

event open;
var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, mois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°1 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(6000)
end if

if len(page) < 6000 then
	page = page + space(6000 - len(page))
end if

init()



end event

