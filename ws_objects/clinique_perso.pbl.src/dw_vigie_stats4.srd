table(column=(type=char(30) updatewhereclause=yes name=nom dbname="fournisseur.nom" )
 column=(type=decimal(2) updatewhereclause=yes name=ca_commande dbname="ca_commande" )
 column=(type=decimal(6) updatewhereclause=yes name=moyenne_qualite dbname="moyenne_qualite" )
 column=(type=decimal(6) updatewhereclause=yes name=moyenne_delais dbname="moyenne_delais" )
 column=(type=decimal(6) updatewhereclause=yes name=moyenne_reactvite dbname="moyenne_reactvite" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fournisseur~" ) COLUMN(NAME=~"fournisseur.nom~") COMPUTE(NAME=~"(select sum(ligne_commande.qte_livree * ligne_commande.prix) as ca_commande from commande, ligne_commande where fournisseur.code = commande.code_fournisseur and commande.numero_commande = ligne_commande.numero_commande and commande.date_commande between :date_min and :date_max)~") COMPUTE(NAME=~"(select avg( convert(decimal, controle_qualite)) as moyenne_qualite from commande where fournisseur.code = commande.code_fournisseur and commande.date_commande between :date_min and :date_max)~") COMPUTE(NAME=~"(select avg( convert(decimal, controle_delais)) as moyenne_delais from commande where fournisseur.code = commande.code_fournisseur and commande.date_commande between :date_min and :date_max)~") COMPUTE(NAME=~"(select avg( convert(decimal, controle_reactivite)) as moyenne_reactvite from commande where fournisseur.code = commande.code_fournisseur and commande.date_commande between :date_min and :date_max)~")) ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " filter=" ca_commande > 0"arguments=(("date_min", date),("date_max", date))  sort="nom A ca_commande A " )
