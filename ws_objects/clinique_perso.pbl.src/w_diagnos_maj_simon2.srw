f.lirepage(em_14,page,1765,4)
f.lirepage(em_15,page,1770,4)
f.lirepage(em_16,page,1775,4)		//max carac = 1780


cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(ddlb_1,page,185,1)
f.ecrirepage(ddlb_2,page,193,1)
f.ecrirepage(ddlb_3,page,186,1)
f.ecrirepage(ddlb_4,page,187,1)
