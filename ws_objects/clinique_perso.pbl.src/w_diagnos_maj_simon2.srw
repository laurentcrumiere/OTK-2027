end prototypes

public subroutine init ();f.lirepage(ddlb_1,page,185,1)
f.lirepage(ddlb_2,page,193,1)
f.lirepage(ddlb_3,page,186,1)
f.lirepage(ddlb_4,page,187,1)
f.lirepage(ddlb_5,page,188,1)
