line(band=header x1="5" y1="296" x2="3200" y2="296"  name=l_2 pen.style="0" pen.width="9" pen.color="33554432"  background.mode="1" background.color="553648127" )
compute(band=header.1 alignment="0" expression=" nom  + ' '  + if( isNull( patient_prenom ), '',  patient_prenom  )"border="0" color="33554432" x="37" y="16" height="56" width="603" format="[general]"  name=compute_2  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
