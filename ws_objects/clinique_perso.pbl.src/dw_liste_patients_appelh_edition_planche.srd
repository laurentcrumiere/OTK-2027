$PBExportHeader$dw_liste_patients_appelh_edition_planche.srd
release 7;
datawindow(units=0 timer_interval=0 color=1090519039 processing=0 HTMLDW=no print.documentname="Liste Patients" print.orientation = 2 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 9 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=300 color="-1" )
summary(height=88 color="-1" )
footer(height=88 color="-1" )
detail(height=68 color="-1" )
table(column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=soins_numero dbname="soins.numero" )
 column=(type=char(1) updatewhereclause=yes name=param_appelh_non dbname="param.appelh_oui" values="Lettre à imprimer 	O/Lettre à imprimer 	N" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=decimal(2) updatewhereclause=yes name=cdeja_paye_soin dbname="deja_paye_soin" )
 column=(type=decimal(2) updatewhereclause=yes name=cmontant_soin dbname="montant_soin" )
 column=(type=date updatewhereclause=yes name=cdate_soin dbname="date_soin" )
 column=(type=decimal(2) updatewhereclause=yes name=csoins_dus_avant_soin dbname="soins_dus_avant_soin" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"param~" ALIAS=~"param_a~" )  TABLE(NAME=~"param~" ALIAS=~"param_b~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"param_a.appelh_oui~") COLUMN(NAME=~"patient.code~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS deja_paye_soin FROM paye WHERE paye.code = patient.code and paye.~~~"date~~~" <= :date_max and soins.cle = paye.cle and paye.tp = 'N')~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS montant_soin FROM ligne_soins WHERE ligne_soins.~~~"date~~~" between :date_min and :date_max and ligne_soins.code = soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'N')~") COMPUTE(NAME=~"(SELECT max(~~~"date~~~") AS date_soin FROM ligne_soins WHERE ligne_soins.code = patient.code and ligne_soins.~~~"date~~~" between :date_min and :date_max and ligne_soins.code = soins.code  and soins.cle = ligne_soins.cle and ligne_soins.tp = 'N')~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS soins_dus_avant_soin FROM ligne_soins WHERE ligne_soins.code = patient.code and ligne_soins.~~~"date~~~" < :date_min and ligne_soins.code = soins.code  and soins.cle = ligne_soins.cle and ligne_soins.tp = 'N')~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"param_b.monnaie_base~") COLUMN(NAME=~"param_b.symbole_franc~") COLUMN(NAME=~"param_b.symbole_euro~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"param_a.cle~"    OP =~"=~"RIGHT=~"param_b.cle~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":var_prat~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"code~~~"~"   OP =~"in~"    EXP2 =~"(SELECT code FROM ligne_soins WHERE ~~~"ligne_soins~~~".~~~"date~~~" between :date_min and :date_max and soins.cle = ligne_soins.cle)~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"var_prat~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " filter="param_appelh_non = ~"O~"" arguments=(("code_min", number),("code_max", number),("var_prat", string),("date_min", date),("date_max", date))  sort="nom A patient_prenom A " )
group(level=1 header.height=76 trailer.height=4 by=("code" ) header.color="-1" trailer.color="-1" )
text(band=header alignment="0" text="Liste de Patients Appels d'Honoraires (Spécifique)" border="0" color="0" x="375" y="12" height="92" width="2144"  name=t_1  font.face="Arial" font.height="-14" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=header alignment="0" text="Nom du Patient" border="0" color="33554432" x="37" y="216" height="56" width="379"  name=nom_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
