compute(band=header.1 alignment="1" expression="sum ( cmontant_soin -  cdeja_paye_soin +  csoins_dus_avant_soin for group 1)"border="0" color="0" x="1755" y="16" height="64" width="439" format="#,##0.00"  name=csomme_patient  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=header.1 alignment="2" expression="max(cdate_soin for group 1)"border="0" color="33554432" x="2327" y="16" height="68" width="315" format="dd/mm/yyyy"  name=cdate_patient  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=header.1 alignment="0" expression="if ( param_monnaie_base = 'F', param_symbole_franc , param_symbole_euro )"border="0" color="33554432" x="2208" y="16" height="64" width="101" format="[GENERAL]"  name=compute_7  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="0" expression=" nom  + ' '  + if( isNull( patient_prenom ), '',  patient_prenom  )"border="0" color="33554432" x="37" y="12" height="56" width="603" format="[general]"  name=compute_3  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
