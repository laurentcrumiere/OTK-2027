text(band=header alignment="2" text="Impression" border="0" color="33554432" x="2674" y="216" height="56" width="293"  name=t_impression  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
