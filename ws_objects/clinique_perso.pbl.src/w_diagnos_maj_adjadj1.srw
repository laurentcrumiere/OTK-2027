global w_diagnos_maj_adjadj1 w_diagnos_maj_adjadj1

type variables
double var_code_local 
boolean modif
string page
uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lirepage(sle_1,page,1,30)
f.lirepage(sle_2,page,31,30)
f.lirepage(sle_3,page,61,30)

f.lirepage(sle_4,page,91,20)

f.lirepage(sle_5,page,111,70)
f.lirepage(sle_6,page,181,70)
f.lirepage(sle_7,page,251,70)

f.lirepage(cbx_1,page,321)
f.lirepage(cbx_2,page,322)
f.lirepage(cbx_3,page,323)
f.lirepage(cbx_4,page,324)
f.lirepage(cbx_5,page,325)

f.lirepage(mle_1,page,326,500)
f.lirepage(mle_2,page,826,300)	//carac max = 1130




cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(sle_1,page,1,30)
f.ecrirepage(sle_2,page,31,30)
f.ecrirepage(sle_3,page,61,30)

f.ecrirepage(sle_4,page,91,20)

f.ecrirepage(sle_5,page,111,70)
f.ecrirepage(sle_6,page,181,70)
f.ecrirepage(sle_7,page,251,70)

f.ecrirepage(cbx_1,page,321)
f.ecrirepage(cbx_2,page,322)
f.ecrirepage(cbx_3,page,323)
f.ecrirepage(cbx_4,page,324)
f.ecrirepage(cbx_5,page,325)

f.ecrirepage(mle_1,page,326,500)
f.ecrirepage(mle_2,page,826,300)	//carac max = 1130


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

