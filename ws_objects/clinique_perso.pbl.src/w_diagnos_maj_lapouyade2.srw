global w_diagnos_maj_lapouyade2 w_diagnos_maj_lapouyade2

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

string pt

SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;

mle_traitement.text = pt

ddlb_respiration.selectitem(integer(mid(page,1250,1)))
ddlb_deglutition.selectitem(integer(mid(page,1251,1)))
ddlb_phonation.selectitem(integer(mid(page,1252,1)))
ddlb_amygdales.selectitem(integer(mid(page,1253,1)))
ddlb_vegetations.selectitem(integer(mid(page,1254,1)))
ddlb_langue.selectitem(integer(mid(page,1255,1)))
ddlb_levres.selectitem(integer(mid(page,1256,1)))
ddlb_volume.selectitem(integer(mid(page,1257,1)))
ddlb_chemin.selectitem(integer(mid(page,1258,1)))
ddlb_amplitude.selectitem(integer(mid(page,1259,1)))

if mid(page,1260,1) = 'O' then
	cbx_suceur.checked = true
else
	cbx_suceur.checked = false
end if
if mid(page,1261,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page,1262,1) = 'O' then
	cbx_bruxisme.checked = true
else
	cbx_bruxisme.checked = false
end if

if mid(page,1263,1) = 'O' then
	cbx_douleur.checked = true
else
	cbx_douleur.checked = false
end if
if mid(page,1264,1) = 'O' then
	cbx_craquement.checked = true
else
	cbx_craquement.checked = false
end if
if mid(page,1265,1) = 'O' then
	cbx_ressaut.checked = true
else
	cbx_ressaut.checked = false
end if
if mid(page,1266,1) = 'O' then
	cbx_ddd.checked = true
else
	cbx_ddd.checked = false
end if

sle_prematurites.text = Righttrim(mid(page,1270,30))

em_mand.text = mid(page,1300,6)
em_leeway.text = mid(page,1310,6)
em_encomb.text = mid(page,1320,6)
em_traitement.text = mid(page,1330,2)
em_ttt_actif.text = mid(page,1332,2)
em_interception.text = mid(page,1334,2)
em_suspension.text = mid(page,1336,2)
em_phase.text = mid(page,1338,2)
em_contention.text = mid(page,1340,2)

em_ext_d_haut.text = mid(page,1350,15)
em_ext_g_haut.text = mid(page,1365,15)
em_ext_d_bas.text = mid(page,1380,15)
em_ext_g_bas.text = mid(page,1395,15)

mle_diagnostic.text = RightTrim(mid(page,1410,300))
mle_reevaluation.text = RightTrim(mid(page,1710,200))
mle_cmt.text = RightTrim(mid(page,3000,300))

end subroutine

event open;
var_code_local = message.doubleparm

string vn
date vd

select  trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vd) then
	vd = Today()
end if


this.title = "Page N°2 : "+vn+ " - Date de naissance : " + string(vd,"dd/mm/yyyy") +" - N° dossier : "+string(var_code_local)

init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if


init()


end event

