integer x = 1801
integer y = 1716
integer width = 384
integer height = 108
integer taborder = 190
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Enregistrer"
end type

event clicked;string rem,pt


place_avec_blancs(sle_agenesie.text,page,1080,20)
place_avec_blancs(sle_surnum.text,page,1100,20)

place_avec_blancs(em_fma.text,page,1120,5)
place_avec_blancs(em_yaxis.text,page,1125,5)
place_avec_blancs(em_sna.text,page,1130,5)
place_avec_blancs(em_snb.text,page,1135,5)
place_avec_blancs(em_anb.text,page,1140,5)
place_avec_blancs(em_aobo.text,page,1145,5)
place_avec_blancs(em_if.text,page,1150,5)
place_avec_blancs(em_iapo.text,page,1155,5)
place_avec_blancs(em_ii.text,page,1160,5)
place_avec_blancs(em_iapo2.text,page,1165,5)
place_avec_blancs(em_iapomm.text,page,1170,5)
place_avec_blancs(em_impa.text,page,1175,5)

place_avec_blancs(mle_diag_clin.text,page,1200,300)

pt = mle_plan_traitement.text
rem = mle_remarques.text

UPDATE diagnos SET perso = :page,remarques = :rem WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
	else
	UPDATE patient SET plan_traitement = :pt WHERE code = :var_code_local ;
	if SQLCA.Sqlcode <> 0 then
		son(4)
		Messagebox("ERREUR BASE DE DONNEES (N°3)",SQLCA.SqlErrText)
	else
		modif = false
		COMMIT ;
	end if
end if
end event

