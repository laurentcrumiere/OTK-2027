type pb_2 from picturebutton within w_diagnos_maj_assayag3
boolean visible = false
integer x = 2761
integer y = 1712
integer width = 137
integer height = 112
integer taborder = 220
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "ar_left.bmp"
vtextalign vtextalign = vcenter!
end type

event clicked;if modif then
	if MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre sans enregistrer ?",Question!,YesNo!) = 1 then
		//OpenSheetWithParm(w_diagnos_maj_assayag2,var_code_local,w_mdi,0,Original!)
		openwithparm(w_diagnos_maj_assayag3,var_code_local)
		Close(parent)
	end if
else
	//OpenSheetWithParm(w_diagnos_maj_assayag2,var_code_local,w_mdi,0,Original!)
	openwithparm(w_diagnos_maj_assayag3,var_code_local)
	close(parent)
end if

end event

