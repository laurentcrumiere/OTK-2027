global w_diagnos_maj_assayag3 w_diagnos_maj_assayag3

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();string rem,pt


SELECT remarques INTO :rem FROM diagnos WHERE code = :var_code_local ;
SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;


modif = false

sle_agenesie.text = RightTrim(mid(page,1080,20))
sle_surnum.text = RightTrim(mid(page,1100,20))

em_fma.text = RightTrim(mid(page,1120,5))
em_yaxis.text = RightTrim(mid(page,1125,5))
em_sna.text = RightTrim(mid(page,1130,5))
em_snb.text = RightTrim(mid(page,1135,5))
em_anb.text = RightTrim(mid(page,1140,5))
em_aobo.text = RightTrim(mid(page,1145,5))
em_if.text = RightTrim(mid(page,1150,5))
em_iapo.text = RightTrim(mid(page,1155,5))
em_ii.text = RightTrim(mid(page,1160,5))
em_iapo2.text = RightTrim(mid(page,1165,5))
em_iapomm.text = RightTrim(mid(page,1170,5))
em_impa.text = RightTrim(mid(page,1175,5))

mle_diag_clin.text = RightTrim(mid(page,1200,300))

mle_plan_traitement.text = pt
mle_remarques.text = rem

end subroutine

event open;var_code_local = message.doubleparm

string vn,vm 

select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if

this.title = "Page N°3 - Diagnostic : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

init()
mep_win_mdi(this,1)

end event

