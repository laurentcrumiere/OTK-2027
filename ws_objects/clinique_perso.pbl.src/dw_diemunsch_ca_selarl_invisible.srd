table(column=(type=char(81) updatewhereclause=yes name=nom_patient dbname="nom_patient" )
 column=(type=number update=yes updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" dbalias=".nom" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" dbalias=".numero" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" dbalias=".lettre" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_scp_demande dbname="soins.scp_demande" dbalias=".scp_demande" initial="null" )
 column=(type=date updatewhereclause=yes name=patient_debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" dbalias=".date_demande" initial="null" )
 column=(type=date updatewhereclause=yes name=debut_traitement_finale dbname="debut_traitement_finale" )
 column=(type=date updatewhereclause=yes name=date_demande_finale dbname="date_demande_finale" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" dbalias=".total" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"soins~" ) COMPUTE(NAME=~"~~~"patient~~~".~~~"nom~~~" + isnull (' ' + prenom, '') as nom_patient~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"soins.date_demande~") COMPUTE(NAME=~"dateadd (month, ~~~"code_soins~~~".~~~"duree~~~",~~~"patient~~~".~~~"debut_traitement~~~") as debut_traitement_finale~") COMPUTE(NAME=~"dateadd (month, ~~~"code_soins~~~".~~~"duree~~~",~~~"soins~~~".~~~"date_demande~~~") as date_demande_finale~") COLUMN(NAME=~"soins.total~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )WHERE(    EXP1 =~"((~~~"soins~~~".~~~"scp_demande~~~"~"   OP =~"=~"    EXP2 =~"90~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"numero~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"lettre~"   OP =~"in~"    EXP2 =~"('TO','SCP')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"debut_traitement~~~"~"   OP =~"between~"    EXP2 =~":da1 and :da2)~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"((~~~"soins~~~".~~~"numero~~~"~"   OP =~"<>~"    EXP2 =~"1~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"lettre~"   OP =~"not in~"    EXP2 =~"('TO','SCP')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"scp_demande~~~"~"   OP =~"<>~"    EXP2 =~"90~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"lettre~"   OP =~"is~"    EXP2 =~"NULL )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_demande~~~"~"   OP =~"between~"    EXP2 =~":da1 and :da2))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":v_praticien~" ) ) ORDER(NAME=~"soins.date_demande~" ASC=yes ) ARG(NAME = ~"da1~" TYPE = date)  ARG(NAME = ~"da2~" TYPE = date)  ARG(NAME = ~"v_praticien~" TYPE = string) " arguments=(("da1", date),("da2", date),("v_praticien", string)) )
