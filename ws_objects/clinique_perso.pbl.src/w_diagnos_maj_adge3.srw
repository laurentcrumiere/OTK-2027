event clicked;place_avec_blancs(em_d1.text,page,1540,10)
place_avec_blancs(em_d2.text,page,1550,10)
place_avec_blancs(em_d3.text,page,1560,10)
place_avec_blancs(em_d4.text,page,1570,10)
place_avec_blancs(em_d5.text,page,1580,10)

place_avec_blancs(mle_anal1.text,page,1590,80)
place_avec_blancs(mle_anal2.text,page,1670,80)
place_avec_blancs(mle_anal3.text,page,1750,80)
place_avec_blancs(mle_anal4.text,page,1830,80)
place_avec_blancs(mle_anal5.text,page,1910,80)

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if  SQLCA.Sqlcode = 0 then
	modif = false
	COMMIT ;
else
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
end if


end event

