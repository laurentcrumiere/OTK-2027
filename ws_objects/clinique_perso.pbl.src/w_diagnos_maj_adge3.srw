global w_diagnos_maj_adge3 w_diagnos_maj_adge3

type variables
double var_code_local 
boolean modif 
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();em_d1.text = trim(mid(page,1540,10))
em_d2.text = trim(mid(page,1550,10))
em_d3.text = trim(mid(page,1560,10))
em_d4.text = trim(mid(page,1570,10))
em_d5.text = trim(mid(page,1580,10))

mle_anal1.text = RightTrim(mid(page,1590,80))
mle_anal2.text = RightTrim(mid(page,1670,80))
mle_anal3.text = RightTrim(mid(page,1750,80))
mle_anal4.text = RightTrim(mid(page,1830,80))
mle_anal5.text = RightTrim(mid(page,1910,80))


end subroutine

event open;
var_code_local = message.doubleparm

string vn,vm 
select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

this.title = "Page N°3 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if


init()

// place la window ds la mdi -> confort utilisateur
mep_win_mdi(this,1)
end event

