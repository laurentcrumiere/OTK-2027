 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"facture~" ) COLUMN(NAME=~"facture.date_r1~") COLUMN(NAME=~"facture.date_r2~") COLUMN(NAME=~"facture.date_r3~") COLUMN(NAME=~"facture.date_solde~") COLUMN(NAME=~"facture.numero~")WHERE(    EXP1 =~"~~~"facture~~~".~~~"numero~~~"~"   OP =~"=~"    EXP2 =~":v_numero~" ) ) ARG(NAME = ~"v_numero~" TYPE = number) " update="facture" updatewhere=0 updatekeyinplace=no arguments=(("v_numero", number)) )
