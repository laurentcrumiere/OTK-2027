table(column=(type=date update=yes updatewhereclause=yes name=dat dbname="coment.dat" initial="today()" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com dbname="coment.com" initial="null" validation="len(trim(gettext())) > 0 and not(isnull(gettext()))" validationmsg="~"Vous ne pouvez pas enregistrer de commentaire vierge !~"" )
 column=(type=char(1) update=yes updatewhereclause=yes name=photos dbname="coment.photos" )
 column=(type=char(1) update=yes updatewhereclause=yes name=radios_e dbname="coment.radios_e" )
 column=(type=char(1) update=yes updatewhereclause=yes name=radios_t dbname="coment.radios_t" )
 column=(type=char(1) update=yes updatewhereclause=yes name=radios_o dbname="coment.radios_o" )
 column=(type=char(1) update=yes updatewhereclause=yes name=radios_h dbname="coment.radios_h" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=acte_prevu dbname="coment.acte_prevu" )
 column=(type=char(4) update=yes updatewhereclause=yes name=minute dbname="coment.minute" )
 column=(type=char(4) update=yes updatewhereclause=yes name=sem dbname="coment.sem" )
 column=(type=decimal(0) updatewhereclause=yes name=coul_texte dbname="coment.coul_texte" )
 column=(type=decimal(0) updatewhereclause=yes name=coul_fond dbname="coment.coul_fond" )
 column=(type=number updatewhereclause=yes key=yes name=ordre dbname="coment.ordre" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="coment.code" )
 column=(type=char(100) updatewhereclause=yes name=hygiene_v10 dbname="coment.hygiene_v10" )
 column=(type=char(100) updatewhereclause=yes name=elastique_v10 dbname="coment.elastique_v10" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="coment.user_modif" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_modif dbname="coment.date_modif" initial="today" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coment~" ) COLUMN(NAME=~"coment.dat~") COLUMN(NAME=~"coment.com~") COLUMN(NAME=~"coment.photos~") COLUMN(NAME=~"coment.radios_e~") COLUMN(NAME=~"coment.radios_t~") COLUMN(NAME=~"coment.radios_o~") COLUMN(NAME=~"coment.radios_h~") COLUMN(NAME=~"coment.acte_prevu~") COLUMN(NAME=~"coment.minute~") COLUMN(NAME=~"coment.sem~") COLUMN(NAME=~"coment.coul_texte~") COLUMN(NAME=~"coment.coul_fond~") COLUMN(NAME=~"coment.ordre~") COLUMN(NAME=~"coment.code~") COLUMN(NAME=~"coment.hygiene_v10~") COLUMN(NAME=~"coment.elastique_v10~") COLUMN(NAME=~"coment.user_modif~") COLUMN(NAME=~"coment.date_modif~")WHERE(    EXP1 =~"( ~~~"coment~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode )~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " update="coment" updatewhere=1 updatekeyinplace=no arguments=(("nocode", number))  sort="dat A " )
