type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();string cdent,n,pn

modif = false

sle_docteur.text = Righttrim(trim(mid(page,1,50)))

select code_dentiste INTO :cdent FROM patient WHERE code = :var_code_local ;
select nom,prenom INTO :n,:pn FROM correspondants WHERE code = :cdent ;
if isnull(n) then
	n = ""
end if
if isnull(pn) then
	pn = ""
end if
sle_dentiste.text = n + " " +pn

em_taille.text = Righttrim(mid(page,101,2))

em_ai.text = Righttrim(mid(page,110,6))
em_a1.text = Righttrim(mid(page,120,6))
em_a2.text = Righttrim(mid(page,130,6))
em_a3.text = Righttrim(mid(page,140,6))
em_a4.text = Righttrim(mid(page,150,6))

em_date.text = Righttrim(mid(page,160,10))

em_6d.text = Righttrim(mid(page,170,5))
em_6d2.text = Righttrim(mid(page,580,5))
em_3d.text = Righttrim(mid(page,175,5))
em_3d2.text = Righttrim(mid(page,585,5))
em_oj.text = Righttrim(mid(page,180,5))
em_oj2.text = Righttrim(mid(page,590,5))
em_supra.text = Righttrim(mid(page,185,5))
em_supra2.text = Righttrim(mid(page,595,5))
em_6g.text = Righttrim(mid(page,190,5))
em_6g2.text = Righttrim(mid(page,630,5))
em_st.text = Righttrim(mid(page,195,5))

mle_remarques.text = Righttrim(trim(mid(page,200,50)))
mle_snm.text = Righttrim(trim(mid(page,250,50)))
sle_radios.text = Righttrim(trim(mid(page,300,50)))
sle_extractions.text = Righttrim(trim(mid(page,350,50)))

mle_rem1.text = Righttrim(trim(mid(page,400,150)))

em_fd_d_haut.text = Righttrim(mid(page,550,30))
em_fd_g_haut.text = Righttrim(mid(page,600,30))
em_fd_d_bas.text = Righttrim(mid(page,650,30))
em_fd_g_bas.text = Righttrim(mid(page,700,30))

mle_consult.text = Righttrim(trim(mid(page,800,200)))
mle_familial.text = Righttrim(trim(mid(page,1000,200)))
mle_medical.text = Righttrim(trim(mid(page,1500,500)))
mle_dentaire.text = Righttrim(trim(mid(page,2000,500)))
mle_diag.text = Righttrim(trim(mid(page,2500,500)))
mle_traitement.text = Righttrim(trim(mid(page,3000,500)))
mle_soins.text = Righttrim(trim(mid(page,3500,500)))


end subroutine

event open;var_code_local = message.doubleparm

string vn,vm,vp 
date vd
integer an, mois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if
if isnull(vd) then
	vd = today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page Clinique N°1 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

init()

end event

