forward prototypes
public subroutine changer_couleur_cb (checkbox cb, statictext st)
public subroutine changer_couleur_rb (radiobutton rb, statictext st)
public subroutine clic_cbx (checkbox cb, statictext st)
public subroutine load_ctrls ()
public subroutine unload_ctrls ()
end prototypes

public subroutine changer_couleur_cb (checkbox cb, statictext st);// on récupère le StaticText (ST) et on modifie la couleur en fonction du Checkbox (CB)

IF cb.checked then
	st.textcolor = RGB(255,0,0)
else
	st.textcolor = RGB(0,0,0)
end if
end subroutine

public subroutine changer_couleur_rb (radiobutton rb, statictext st);// on récupère le StaticText (ST) et on modifie la couleur en fonction du RadioButton (RB)

IF rb.checked then
	st.textcolor = RGB(255,0,0)
else
	st.textcolor = RGB(0,0,0)
end if
end subroutine

public subroutine clic_cbx (checkbox cb, statictext st);IF cb.Checked THEN
	cb.Checked = FALSE
ELSE
	cb.Checked = TRUE
END IF

changer_couleur_cb (cb, st)
end subroutine

