 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param~" ) COMPUTE(NAME=~"( select count(*) as demande_dep from soins, code_soins where date_demande between :date_min and :date_max and soins.type = code_soins.code and code_soins.renouvt = 'O' )~") COMPUTE(NAME=~"( select count(*) as nb_refus from coment where dat between :date_min and :date_max and com like '%'+trim(param.c6)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_desaccord from coment where dat between :date_min and :date_max and com like '%'+trim(param.c7)+'%'  )~") COMPUTE(NAME=~"( select count(*) as nb_semestre_gratuits from soins, code_soins where date_demande between :date_min and :date_max and soins.~~~"type~~~" = 'SG' and soins.~~~"type~~~" = code_soins.code and code_soins.renouvt = 'O' )~") COMPUTE(NAME=~"( select count(*) as nb_premiers_contacs from patient where date_contact between :date_min and :date_max  )~") COMPUTE(NAME=~"( select count(*) as nb_premieres_visite from patient where premiere_visite between :date_min and :date_max  )~") COMPUTE(NAME=~"( select count(*) as nb_debut_traitement from patient where debut_traitement between :date_min and :date_max  )~") COMPUTE(NAME=~"( select count(*) as nb_traitements_aligneurs_transparents from histo_dossier where date(date_heure) between :date_min and :date_max  and type_dossier = '15'   )~") COMPUTE(NAME=~"( select count(*) as nb_traitements_invisalign from histo_dossier where date(date_heure) between :date_min and :date_max  and type_dossier = '14'   )~") COMPUTE(NAME=~"( select count(*) as nb_traitements_mixtes from histo_dossier where date(date_heure) between :date_min and :date_max  and type_dossier = '16'   )~") COMPUTE(NAME=~"( select count(*) as demande_to10 from soins, code_soins where date_demande between :date_min and :date_max and soins.type = code_soins.code and code_soins.renouvt = 'O'  and code_soins.lettre = 'TO' and scp_demande = 10)~") COMPUTE(NAME=~"( select count(*) as demande_to45 from soins, code_soins where date_demande between :date_min and :date_max and soins.type = code_soins.code and code_soins.renouvt = 'O'  and code_soins.lettre = 'TO' and scp_demande = 45)~") COMPUTE(NAME=~"( select count(*) as demande_to90 from soins, code_soins where date_demande between :date_min and :date_max and soins.type = code_soins.code and code_soins.renouvt = 'O'  and code_soins.lettre = 'TO' and scp_demande = 90)~") COMPUTE(NAME=~"( select count(*) as demande_to75 from soins, code_soins where date_demande between :date_min and :date_max and soins.type = code_soins.code and code_soins.renouvt = 'O'  and code_soins.lettre = 'TO' and scp_demande = 75)~") COMPUTE(NAME=~"( select count(*) as provenance_longtemps from patient where left(categorie_statistique,2) = 'lo' and date_statistique between :date_min and :date_max)~") COMPUTE(NAME=~"( select count(*) as provenance_dentiste from patient where left(categorie_statistique,2) = 'de' and date_statistique between :date_min and :date_max)~") COMPUTE(NAME=~"( select count(*) as provenance_specialiste from patient where left(categorie_statistique,2) = 'sp' and date_statistique between :date_min and :date_max)~") COMPUTE(NAME=~"( select count(*) as provenance_recommande from patient where left(categorie_statistique,2) = 're' and date_statistique between :date_min and :date_max)~") COMPUTE(NAME=~"( select count(*) as provenance_plaque from patient where left(categorie_statistique,2) = 'pl' and date_statistique between :date_min and :date_max)~") COMPUTE(NAME=~"( select count(*) as provenance_pages from patient where left(categorie_statistique,2) = 'pa' and date_statistique between :date_min and :date_max)~") COMPUTE(NAME=~"( select count(*) as provenance_internet from patient where left(categorie_statistique,2) = 'in' and date_statistique between :date_min and :date_max)~") COMPUTE(NAME=~"( select count(*) as nb_archivage_actif from histo_dossier where date(date_heure) between :date_min and :date_max  and type_dossier = '2'   )~")) ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("date_min", date),("date_max", date)) )
