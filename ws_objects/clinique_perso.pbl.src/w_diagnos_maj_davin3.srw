global w_diagnos_maj_davin3 w_diagnos_maj_davin3

type variables
double var_code_local
boolean modif
string page
uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine save ()
public subroutine init ()
end prototypes

public subroutine save ();f.ecrirepage(em_d1,page,1665,10)
f.ecrirepage(em_d2,page,1675,10)
f.ecrirepage(em_d3,page,1685,10)
f.ecrirepage(em_d4,page,1695,10)

f.ecrirepage(mle_col1,page,1710,76)
f.ecrirepage(mle_col2,page,1790,76)
f.ecrirepage(mle_col3,page,1870,76)
f.ecrirepage(mle_col4,page,1950,76)

f.ecrirepage(mle_remarques,page,2030,250)		//2280 caractères au total

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if
end subroutine

public subroutine init ();f.lirepage(em_d1,page,1665,10)
f.lirepage(em_d2,page,1675,10)
f.lirepage(em_d3,page,1685,10)
f.lirepage(em_d4,page,1695,10)

f.lirepage(mle_col1,page,1710,76)
f.lirepage(mle_col2,page,1790,76)
f.lirepage(mle_col3,page,1870,76)
f.lirepage(mle_col4,page,1950,76)

f.lirepage(mle_remarques,page,2030,250)		//2280 caractères au total

modif = false
cb_fermer.setfocus()
end subroutine

event open;var_code_local = message.doubleparm

string vn
date vm

select trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = date('00/00/0000')
end if

this.title = "Page Clinique N°3 : "+vn+" - Né(e) le : " +string(vm)+ " - N° dossier : "+string(var_code_local)


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

//if len(page) < 6000 then
//	page = page + space(6000 - len(page))
//end if

init()

end event

