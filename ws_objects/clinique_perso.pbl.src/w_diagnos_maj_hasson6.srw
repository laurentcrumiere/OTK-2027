type cb_fermer from commandbutton within w_diagnos_maj_hasson6
integer x = 2720
integer y = 1712
integer width = 402
integer height = 112
integer taborder = 350
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
