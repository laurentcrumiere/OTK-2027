end type

event clicked;string PathBonRep
security_attributes l_SA


//init des vars
PathBonRep = dir_photos + string(var_code_local)

if not FileExists(PathBonRep) then
	// si le rep n'existe pas
	CreateDirectoryA( PathBonRep, l_SA)	//on le crée
end if

//on ouvre la fenêtre de sélection
run("explorer" + ' "' + PathBonRep + '"')
end event

