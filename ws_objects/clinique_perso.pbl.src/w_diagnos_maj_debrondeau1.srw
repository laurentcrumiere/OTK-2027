date	ld_date_naiss


select	date_naissance
into	:ld_date_naiss
from	patient
where	patient.code = :var_code_local ;

if isnull(ld_date_naiss) then
	st_38.text = "00/00/0000"
else
	st_38.text = string(ld_date_naiss)
end if

