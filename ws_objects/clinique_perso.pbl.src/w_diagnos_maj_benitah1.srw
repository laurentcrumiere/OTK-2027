date	ld_date_naiss
string	lstr_nom_dentiste


select	correspondants.nom , date_naissance
into	:lstr_nom_dentiste , :ld_date_naiss
from	correspondants , patient
where	code_dentiste = correspondants.code
and	patient.code = :var_code_local ;

if isnull(lstr_nom_dentiste) then lstr_nom_dentiste = ""
st_3.text = lstr_nom_dentiste

if isnull(ld_date_naiss) then
	st_47.text = "00/00/0000"
else
	st_47.text = string(ld_date_naiss)
end if

end subroutine

