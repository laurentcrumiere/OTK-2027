global w_diagnos_maj_trovero2 w_diagnos_maj_trovero2

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_mol_d.text = RightTrim(mid(page,41,2))
em_mol_g.text = RightTrim(mid(page,43,2))
em_can_d.text = RightTrim(mid(page,45,2))
em_can_g.text = RightTrim(mid(page,47,2))

//sle_dent_inclu.text = RightTrim(mid(page,49,12))
//sle_rotation.text = RightTrim(mid(page,61,12))
sle_surnu.text = RightTrim(mid(page,73,5))
sle_agene.text = RightTrim(mid(page,78,5))
sle_500.text = RightTrim(mid(page,1750,20))

em_surplomb.text = RightTrim(mid(page,83,2))
em_recouv.text = RightTrim(mid(page,85,2))
em_dist_inter.text = RightTrim(mid(page,87,2))

ddlb_beance.selectitem(integer(mid(page,89,1)))
ddlb_encombre.selectitem(integer(mid(page,90,1)))
ddlb_cl_dent.selectitem(integer(mid(page,91,1)))
ddlb_charte.selectitem(integer(mid(page,92,1)))
ddlb_sourire.selectitem(integer(mid(page,93,1)))
ddlb_mand.selectitem(integer(mid(page,94,1)))
ddlb_ch_ferme.selectitem(integer(mid(page,95,1)))
ddlb_max.selectitem(integer(mid(page,96,1)))
ddlb_mil_inter.selectitem(integer(mid(page,97,1)))
ddlb_deg_dif.selectitem(integer(mid(page,98,1)))

em_md.text = RightTrim(mid(page,1600,3))
em_mg.text = RightTrim(mid(page,1605,3))
em_cd.text = RightTrim(mid(page,1610,3))
em_cg.text = RightTrim(mid(page,1615,3))

ddlb_axecan.selectitem(integer(mid(page,1620,1)))

sle_axecan.text = RightTrim(mid(page,1625,5))
sle_occl.text = RightTrim(mid(page,1630,10))

ddlb_16.selectitem(integer(mid(page,1640,1)))
ddlb_36.selectitem(integer(mid(page,1645,1)))

sle_dent_incluse.text = RightTrim(mid(page,1680,20))
sle_rotations.text = RightTrim(mid(page,1700,20))
end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"



SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

// place la window ds la mdi -> confort utilisateur
mep_win_mdi(this,1)
end event

