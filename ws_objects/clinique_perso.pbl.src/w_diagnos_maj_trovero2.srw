event clicked pbm_bnclicked
integer x = 2240
integer y = 1540
integer width = 384
integer height = 108
integer taborder = 330
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
