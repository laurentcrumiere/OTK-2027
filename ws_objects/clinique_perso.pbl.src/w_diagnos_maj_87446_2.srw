forward prototypes
public subroutine somme (singlelineedit sle01, singlelineedit sle02, singlelineedit sle03, singlelineedit sle04, singlelineedit sle05, singlelineedit sle06, singlelineedit sle07, singlelineedit sle08, singlelineedit sle09, singlelineedit sle10, singlelineedit sle11, singlelineedit sl_somme)
public function boolean test_numero (singlelineedit saisie)
public subroutine load_ctrls ()
public subroutine unload_ctrls ()
end prototypes

public subroutine somme (singlelineedit sle01, singlelineedit sle02, singlelineedit sle03, singlelineedit sle04, singlelineedit sle05, singlelineedit sle06, singlelineedit sle07, singlelineedit sle08, singlelineedit sle09, singlelineedit sle10, singlelineedit sle11, singlelineedit sl_somme);double somme_zones

// calcul de la somme des 11 entrées
somme_zones = double(sle01.text) + double(sle02.text) + double(sle03.text) + double(sle04.text) + double(sle05.text)
somme_zones = somme_zones + double(sle06.text) + double(sle07.text) + double(sle08.text) + double(sle09.text) + double(sle10.text) + double(sle11.text)

// Affichage de la somme dans la zone concernée
sl_somme.text = string(somme_zones)
end subroutine

public function boolean test_numero (singlelineedit saisie);//
//IF saisie.text = string(double(saisie.text)) then
IF IsNumber(saisie.text) then
	return true
else
		Messagebox("ATTENTION !","UNIQUEMENT des valeurs !!!")
		saisie.text = ''
		saisie.SetFocus()
		return false
end if
end function

