f.ecrirepage(em_3,page_buffer[2],1040,10)
f.ecrirepage(em_1,page_buffer[2],1050,10)
f.ecrirepage(em_2,page_buffer[2],1060,10)
f.ecrirepage(em_4,page_buffer[2],1070,10)
f.ecrirepage(em_5,page_buffer[2],1080,10)
f.ecrirepage(em_6,page_buffer[2],1090,10)
f.ecrirepage(em_11,page_buffer[2],1100,10)
f.ecrirepage(em_12,page_buffer[2],1110,10)
