forward prototypes
public subroutine load_ctrls ()
public subroutine unload_ctrls ()
end prototypes

public subroutine load_ctrls ();string	classePatient, typePatient


select	classe, type
into	:classePatient, :typePatient
from	patient
where	code = :var_code_local ;

if isnull( classePatient ) then classePatient = ""
sle_10.text = classePatient

if isnull( typePatient ) then typePatient = ""
sle_11.text = typePatient

f.lirepage(em_9,page_buffer[1],950,10)
f.lirepage(sle_1,page_buffer[1],960,10)
f.lirepage(sle_2,page_buffer[1],970,10)
f.lirepage(sle_3,page_buffer[1],980,10)
f.lirepage(sle_4,page_buffer[1],990,10)
f.lirepage(sle_5,page_buffer[1],1000,10)
f.lirepage(sle_6,page_buffer[1],1010,10)
f.lirepage(sle_7,page_buffer[1],1020,10)
f.lirepage(em_10,page_buffer[1],1030,10)
f.lirepage(em_3,page_buffer[1],1040,10)
f.lirepage(em_1,page_buffer[1],1050,10)
f.lirepage(em_2,page_buffer[1],1060,10)
f.lirepage(em_4,page_buffer[1],1070,10)
f.lirepage(em_5,page_buffer[1],1080,10)
f.lirepage(em_6,page_buffer[1],1090,10)
f.lirepage(em_11,page_buffer[1],1100,10)
f.lirepage(em_12,page_buffer[1],1110,10)
f.lirepage(em_13,page_buffer[1],1120,10)
f.lirepage(em_14,page_buffer[1],1130,10)
f.lirepage(em_15,page_buffer[1],1140,10)
f.lirepage(em_16,page_buffer[1],1150,10)
// max carac = 1160

end subroutine

public subroutine unload_ctrls ();string	classePatient, typePatient


classePatient = sle_10.text
typePatient = sle_11.text

update	patient
set			classe = : classePatient, type = :typePatient
where		code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES","Impossible de sauvegarder la Classe ou le Type. ~n~nTexte de l'erreur : ~n" + SQLCA.SqlErrText , StopSign!)
else
	COMMIT ;
end if

f.ecrirepage(em_9,page_buffer[2],950,10)
f.ecrirepage(sle_1,page_buffer[2],960,10)
f.ecrirepage(sle_2,page_buffer[2],970,10)
f.ecrirepage(sle_3,page_buffer[2],980,10)
f.ecrirepage(sle_4,page_buffer[2],990,10)
f.ecrirepage(sle_5,page_buffer[2],1000,10)
f.ecrirepage(sle_6,page_buffer[2],1010,10)
