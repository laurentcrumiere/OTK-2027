forward prototypes
public subroutine init ()
public subroutine init_photos (double num)
end prototypes

public subroutine init ();modif = false

sle_pta.text = RightTrim(mid(page,150,3))
sle_pog.text = RightTrim(mid(page,153,3))

ddlb_max.selectitem(integer(mid(page,156,1)))
ddlb_mand.selectitem(integer(mid(page,157,1)))
ddlb_hfa.selectitem(integer(mid(page,157,1)))
ddlb_levre_sup.selectitem(integer(mid(page,159,1)))
