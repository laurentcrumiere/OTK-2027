type cb_1 from commandbutton within w_diagnos_maj_87735_4
integer x = 3973
integer y = 1180
integer width = 343
integer height = 100
integer taborder = 70
boolean bringtotop = true
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Calcul"
end type

event clicked;integer nb_jours, nb_valeur, multiplicateur

// récupération de la valeur du premier menu déroulant
nb_valeur = integer(ddlb_duree_nb.Text)

// calcul du multiplicateur en fonction du choix sur le second menu déroulant
CHOOSE CASE ddlb_duree_type.Text
	CASE "semestre(s)"
		multiplicateur = 182.625
		
	CASE "mois"
		multiplicateur = 30.4375
		
	CASE "année(s)"
		multiplicateur = 365.25
		
	CASE ELSE
		multiplicateur = 0

END CHOOSE

// calcul du nombre de jours à ajouter à la date du jour
nb_jours = nb_valeur * multiplicateur

// Renseignement de la date dans la zone "sle_date_fin"
sle_date_fin.text = String(RelativeDate(Today(), nb_jours))
end event

