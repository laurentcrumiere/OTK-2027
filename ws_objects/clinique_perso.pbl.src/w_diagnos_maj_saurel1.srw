event open;
var_code_local = message.doubleparm

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

if len(page) < 2000 then
	page = page + space(2000 - len(page))
end if

init()

em_face.setfocus()

// place la window ds la mdi -> confort utilisateur
mep_win_mdi(this,1)
end event

