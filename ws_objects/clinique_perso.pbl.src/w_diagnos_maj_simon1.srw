f.lirepage(ddlb_decalcif,page,181,1)
f.lirepage(ddlb_troma,page,182,1)		//max carac = 185


cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(ddlb_motivation,page,1,1)
f.ecrirepage(ddlb_antmaladie,page,2,1)
f.ecrirepage(ddlb_antchirurgie,page,3,1)
f.ecrirepage(ddlb_antortho,page,4,1)
