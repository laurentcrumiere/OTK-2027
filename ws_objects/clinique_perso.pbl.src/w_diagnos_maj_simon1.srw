f.ecrirepage(ddlb_caries,page,179,1)
f.ecrirepage(ddlb_hygiene,page,180,1)
f.ecrirepage(ddlb_decalcif,page,181,1)
f.ecrirepage(ddlb_troma,page,182,1)		//max carac = 185


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

