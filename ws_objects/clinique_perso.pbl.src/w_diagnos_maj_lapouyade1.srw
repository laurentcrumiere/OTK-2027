global w_diagnos_maj_lapouyade1 w_diagnos_maj_lapouyade1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

mle_ant_gene.text = Righttrim(trim(mid(page,1,200)))
mle_remarques.text = Righttrim(trim(mid(page,201,300)))

mle_face.text = Righttrim(mid(page,501,100))
mle_profil.text = Righttrim(mid(page,601,100))
mle_dentaire.text = Righttrim(mid(page,701,100))
mle_paro.text = Righttrim(mid(page,801,100))

sle_caries.text = Righttrim(mid(page,901,40))
sle_dysplasies.text = Righttrim(mid(page,941,40))
sle_malp.text = Righttrim(mid(page,981,40))
sle_frein.text = Righttrim(mid(page,1021,20))
sle_recession.text = Righttrim(mid(page,1041,20))

em_d1.text = mid(page,1061,10)
em_d2.text = mid(page,1071,10)
em_d3.text = mid(page,1081,10)
em_d4.text = mid(page,1091,10)
em_d5.text = mid(page,1101,10)
em_d6.text = mid(page,1111,10)

if mid(page,1121,1) = 'O' then
	cbx_maxi_oui.checked = true
else
	cbx_maxi_oui.checked = false
end if
if mid(page,1122,1) = 'O' then
	cbx_maxi_non.checked = true
else
	cbx_maxi_non.checked = false
end if
if mid(page,1123,1) = 'O' then
	cbx_articu_oui.checked = true
else
	cbx_articu_oui.checked = false
end if
if mid(page,1124,1) = 'O' then
	cbx_articu_non.checked = true
else
	cbx_articu_non.checked = false
end if


ddlb_hygiene.selectitem(integer(mid(page,1125,1)))
ddlb_motivation.selectitem(integer(mid(page,1126,1)))


em_sag2.text = mid(page,1130,3)
em_sag3.text = mid(page,1133,3)
em_tran2.text = mid(page,1136,3)
em_tran3.text = mid(page,1139,3)
em_sag4.text = mid(page,1142,3)
em_sag5.text = mid(page,1145,3)
em_tran4.text = mid(page,1148,3)
em_tran5.text = mid(page,1151,3)

em_surplomb.text = mid(page,1155,6)
em_recouv.text = mid(page,1170,6)
em_beance.text = mid(page,1180,6)

em_surplomb1.text = mid(page,2900,6)
em_recouv1.text = mid(page,2910,6)
em_beance1.text = mid(page,2920,6)

em_art_d_haut.text = mid(page,1190,15)
em_art_g_haut.text = mid(page,1205,15)
em_art_d_bas.text = mid(page,1220,15)
em_art_g_bas.text = mid(page,1235,15)


end subroutine

event open;var_code_local = message.doubleparm

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

string vn
date vd

select  trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vd) then
	vd = Today()
end if


this.title = "Page N°1 : "+vn+ " - Date de naissance : " + string(vd,"dd/mm/yyyy") +" - N° dossier : "+string(var_code_local)

init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

init()


end event

