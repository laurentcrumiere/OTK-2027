place_avec_blancs(mle_medical.text,page,701,200)
place_avec_blancs(sle_allergie.text,page,901,60)

place_avec_blancs(mle_dentaire.text,page,1000,500)
place_avec_blancs(mle_face.text,page,1500,150)
place_avec_blancs(mle_profil.text,page,1650,150)
place_avec_blancs(mle_atm.text,page,1800,150)
place_avec_blancs(mle_arcade.text,page,1950,500)
place_avec_blancs(mle_paro.text,page,2450,150)

place_avec_blancs(sle_amygdale.text,page,2600,60)
place_avec_blancs(sle_posture.text,page,2700,60)
place_avec_blancs(sle_habitudes.text,page,2800,60)
place_avec_blancs(sle_phonation.text,page,2900,60)
place_avec_blancs(mle_remarques.text,page,3000,500)

place(string(ddplb_deglutition.FindItem(ddplb_deglutition.text,1)),page,3500)
place(string(ddlb_respiration.FindItem(ddlb_respiration.text,1)),page,3501)
place(string(ddlb_hygiene.FindItem(ddlb_hygiene.text,1)),page,3502)
place(string(ddlb_volume.FindItem(ddlb_volume.text,1)),page,3503)
place(string(ddlb_tonus.FindItem(ddlb_tonus.text,1)),page,3504)
place(string(ddlb_competence.FindItem(ddlb_competence.text,1)),page,3505)
place(string(ddlb_volume_langue.FindItem(ddlb_volume_langue.text,1)),page,3506)
place(string(ddlb_tonus_langue.FindItem(ddlb_tonus_langue.text,1)),page,3507)
place(string(ddlb_mobilite.FindItem(ddlb_mobilite.text,1)),page,3508)

if cbx_langue.checked then
	place("O",page,3509)
else
	place("N",page,3509)
end if
if cbx_levre_sup.checked then
	place("O",page,3510)
else
	place("N",page,3510)
end if
if cbx_levre_inf.checked then
	place("O",page,3511)
else
	place("N",page,3511)
end if


place_avec_blancs(em_date.text,page,3520,10)

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end event

