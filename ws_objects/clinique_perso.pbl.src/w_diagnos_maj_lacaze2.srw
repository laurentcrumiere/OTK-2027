global w_diagnos_maj_lacaze2 w_diagnos_maj_lacaze2

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

mle_consult.text = Righttrim(trim(mid(page,501,200)))
mle_medical.text = Righttrim(trim(mid(page,701,200)))
sle_allergie.text = Righttrim(trim(mid(page,901,60)))
mle_dentaire.text = Righttrim(trim(mid(page,1000,500)))
mle_face.text = Righttrim(trim(mid(page,1500,150)))
mle_profil.text = Righttrim(trim(mid(page,1650,150)))
mle_atm.text = Righttrim(trim(mid(page,1800,150)))
mle_arcade.text = Righttrim(trim(mid(page,1950,500)))
mle_paro.text = Righttrim(trim(mid(page,2450,150)))

sle_amygdale.text = Righttrim(trim(mid(page,2600,60)))
sle_posture.text = Righttrim(trim(mid(page,2700,60)))
sle_habitudes.text = Righttrim(trim(mid(page,2800,60)))
sle_phonation.text = Righttrim(trim(mid(page,2900,60)))

mle_remarques.text = Righttrim(trim(mid(page,3000,500)))


ddplb_deglutition.selectitem(integer(mid(page,3500,1)))
ddlb_respiration.selectitem(integer(mid(page,3501,1)))
ddlb_hygiene.selectitem(integer(mid(page,3502,1)))
ddlb_volume.selectitem(integer(mid(page,3503,1)))
ddlb_tonus.selectitem(integer(mid(page,3504,1)))
ddlb_competence.selectitem(integer(mid(page,3505,1)))
ddlb_volume_langue.selectitem(integer(mid(page,3506,1)))
ddlb_tonus_langue.selectitem(integer(mid(page,3507,1)))
ddlb_mobilite.selectitem(integer(mid(page,3508,1)))


if mid(page,3509,1) = 'O' then
	cbx_langue.checked = true
else
	cbx_langue.checked = false
end if
if mid(page,3510,1) = 'O' then
	cbx_levre_sup.checked = true
else
	cbx_levre_sup.checked = false
end if
if mid(page,3511,1) = 'O' then
	cbx_levre_inf.checked = true
else
	cbx_levre_inf.checked = false
end if

//ddlb_amygdales.selectitem(integer(mid(page,607,1)))
//ddlb_vegetations.selectitem(integer(mid(page,608,1)))
//ddlb_langue.selectitem(integer(mid(page,609,1)))
//ddplb_levres.selectitem(integer(mid(page,610,1)))
//ddplb_volume.selectitem(integer(mid(page,611,1)))
//

em_date.text = Righttrim(mid(page,3520,10))

end subroutine

event open;
var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, mois

double v_numero_dossier

select nom,prenom,moulage,date_naissance, numero_dossier
INTO :vn,:vp,:vm,:vd , :v_numero_dossier
FROM patient WHERE code = :var_code_local ;


if isnull(vm) then
	vm = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°2 EXAMEN CLINIQUE : "+vn+" " +vp+" - N° dossier : "+string(v_numero_dossier)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(5000)
end if

if len(page) < 5000 then
	page = page + space(5000 - len(page))
end if

init()
cb_fermer.setfocus()

end event

