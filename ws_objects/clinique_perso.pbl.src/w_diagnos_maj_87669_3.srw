event selectionchanged;// Modification de l'objet PICTURE en fonction du choix dans le menu déroulant

String selection_liste, nom_app
Integer nbcr, accent

// récupération du choix et génération du chemin pour atteindre le fichier JPG correspondant
selection_liste =ddlb_chx_app_1ere_int.Text + ".jpg"

// Suppression des "e" accentué dans le nom du fichier à récupérer
nom_app = ""

for nbcr = 1 to len(selection_liste)
	
	accent = 0
	
	CHOOSE CASE mid(selection_liste,nbcr,1)
		CASE char(232)	// è
			nom_app = nom_app + 'e'
				
		CASE char(233)	// é
			nom_app = nom_app + 'e'
		
		CASE char(234)	// ê
			nom_app = nom_app + 'e'
		
		CASE ELSE
			nom_app = nom_app + mid(selection_liste,nbcr,1)
	END CHOOSE
	
next

// affectation du chemin à l'objet PICTURE
p_appareil.PictureName = nom_app
end event

