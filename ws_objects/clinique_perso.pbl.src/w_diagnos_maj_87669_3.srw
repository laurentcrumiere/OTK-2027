event open;call super::open;string v_autor
select isnull(reglt_multi_fs , 'N') into :v_autor from utilisateurs where code = :utilisateur_code ;
if v_autor = "O" then 
                cbx_valide.enabled = true
else
                cbx_valide.enabled = false
end if

end event

