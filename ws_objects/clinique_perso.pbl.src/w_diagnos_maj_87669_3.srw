public subroutine load_ctrls ();f.lirepage(sle_resum_rx_pano,page_buffer[1],1617,200)
f.lirepage(mle_resum_moulages,page_buffer[1],1817,300)
f.lirepage(sle_motif,page_buffer[1],2117,50)
f.lirepage(sle_comnt_1ere_int,page_buffer[1],2167,200)
f.lirepage(mle_obj_trait_1ere_int,page_buffer[1],2367,300)
f.lirepage(sle_soins_1ere_int,page_buffer[1],2667,60)
f.lirepage(sle_extrac_1ere_int,page_buffer[1],2727,60)
f.lirepage(sle_rx_compl_1ere_int,page_buffer[1],2787,60)

// Lecture choix appareil + affichage
//f.lirepage(ddlb_chx_app_1ere_int,page_buffer[1],2847,1)
f.lirepage(ddlb_chx_app_1ere_int,page_buffer[1],4422,2)

String selection_liste
// récupération du choix et génération du chemin pour atteindre le fichier JPG correspondant
selection_liste = ddlb_chx_app_1ere_int.Text + ".jpg"
// affectation du chemin à l'objet PICTURE
p_appareil.PictureName = selection_liste

f.lirepage(sle_chx_app_1ere_int,page_buffer[1],2848,60)
f.lirepage(sle_ttmnt_autre_1ere_int,page_buffer[1],2908,60)

// max carac = 4424



// récupération des information en pages 1 & 2 pour le résumé de l'examen clinique
// page 1
f.lirepage(sle_motif,page_buffer[1],72,50)
f.lirepage(ddlb_respi,page_buffer[1],3,1)
f.lirepage(ddlb_deglut,page_buffer[1],5,1)
f.lirepage(cbx_succion,page_buffer[1],10)
f.lirepage(ddlb_succion,page_buffer[1],8,1)
// f.lirepage(sle_succion,page_buffer[1],864,40)

// récupération des informations du frein
f.lirepage(cbx_fr_lab_sup,page_buffer[1],67)
f.lirepage(cbx_fr_lab_inf,page_buffer[1],68)
f.lirepage(cbx_fr_ling,page_buffer[1],69)
f.lirepage(cbx_fr_ras,page_buffer[1],743)
f.lirepage(sle_fr_lab_sup,page_buffer[1],744,40)
f.lirepage(sle_fr_lab_inf,page_buffer[1],784,40)
f.lirepage(sle_fr_ling,page_buffer[1],824,40)

// page 2
// Colonne 5
f.lirepage(sle_decouv_repos,page_buffer[1],946,10)
f.lirepage(sle_decouv_sourire,page_buffer[1],956,10)
f.lirepage(sle_gs,page_buffer[1],1210,10)
f.lirepage(rb_plan_parall,page_buffer[1],1280)
f.lirepage(rb_plan_oblique,page_buffer[1],1281)
f.lirepage(sle_sup,page_buffer[1],1220,30)
f.lirepage(sle_inf,page_buffer[1],1250,30)

// Diagnostic ATM
f.lirepage(cbx_diag_atm,page_buffer[1],977)
if cbx_diag_atm.checked then
	st_50.visible = True
	ddlb_douleurs.visible = True
	st_51.visible = True
	ddlb_craq_claq.visible = True
	st_52.visible = True
	ddlb_trajet_ouv.visible = True
	st_53.visible = True
	ddlb_trajet_ferm.visible = True
	sle_trajet_ferm.visible = True
	st_54.visible = True
	sle_diag_atm_rem.visible = True
end if
//f.lirepage(cbx_douleurs,page_buffer[1],1615)
f.lirepage(ddlb_douleurs,page_buffer[1],978,1)

//f.lirepage(cbx_craq_claq,page_buffer[1],1616)
f.lirepage(ddlb_craq_claq,page_buffer[1],979,1)

f.lirepage(ddlb_trajet_ouv,page_buffer[1],1432,1)
f.lirepage(sle_trajet_ouv,page_buffer[1],1434,60)

f.lirepage(ddlb_trajet_ferm,page_buffer[1],1433,1)
f.lirepage(sle_trajet_ferm,page_buffer[1],1494,60)

f.lirepage(sle_diag_atm_rem,page_buffer[1],1554,60)

// Colonne 1
f.lirepage(ddlb_cis,page_buffer[1],913,1)
f.lirepage(ddlb_ac,page_buffer[1],914,1)
f.lirepage(ddlb_cii,page_buffer[1],915,1)
f.lirepage(ddlb_pog,page_buffer[1],916,1)
f.lirepage(cbx_lmf,page_buffer[1],917)
f.lirepage(cbx_lma,page_buffer[1],918)
f.lirepage(sle_cis-ac,page_buffer[1],980,30)
f.lirepage(sle_ac-psm,page_buffer[1],1010,30)
f.lirepage(sle_pog-psm,page_buffer[1],1040,30)
f.lirepage(sle_cii-pog,page_buffer[1],1070,30)
f.lirepage(sle_lmf,page_buffer[1],1150,30)
f.lirepage(sle_lma,page_buffer[1],1180,30)

//

if cbx_valide.checked then
	r_1.LineColor = 32768
else
	r_1.LineColor = 15780518
end if

// Ajout validation page n° 3
f.lirepage(cbx_valide,page_buffer[1],4420)


// --------------------------------

string comm_img
double v_temps_traitement

select top 1 temps_traitement into :v_temps_traitement from images_infos  where code = :var_code_local order by date_acquis desc ;

SELECT commentaires_html INTO :comm_img FROM images_infos WHERE code = :var_code_local AND type_image = 50 AND temps_traitement = :v_temps_traitement ;

mle_comment_odr.text = comm_img

end subroutine

public subroutine unload_ctrls ();f.ecrirepage(sle_resum_rx_pano,page_buffer[2],1617,200)
f.ecrirepage(mle_resum_moulages,page_buffer[2],1817,300)
f.ecrirepage(sle_motif,page_buffer[2],2117,50)
f.ecrirepage(sle_comnt_1ere_int,page_buffer[2],2167,200)
f.ecrirepage(mle_obj_trait_1ere_int,page_buffer[2],2367,300)
f.ecrirepage(sle_soins_1ere_int,page_buffer[2],2667,60)
f.ecrirepage(sle_extrac_1ere_int,page_buffer[2],2727,60)
f.ecrirepage(sle_rx_compl_1ere_int,page_buffer[2],2787,60)
//
//f.ecrirepage(ddlb_chx_app_1ere_int,page_buffer[2],2847,1)
f.ecrirepage(ddlb_chx_app_1ere_int,page_buffer[2],4422,2)
//
f.ecrirepage(sle_chx_app_1ere_int,page_buffer[2],2848,60)
f.ecrirepage(sle_ttmnt_autre_1ere_int,page_buffer[2],2908,60)

// max carac = 2968

// Ajout validation page n° 3
f.ecrirepage(cbx_valide,page_buffer[2],4420)
end subroutine

public function integer save_buffer ();// fx qui sauvegarde les données du buffers secondaire (page_buffer[2]) vers la BD

integer return_val = -1


// on tante de save les données ds la base
UPDATE               diagnos
SET                        perso = :page_buffer[2]
WHERE                                code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
// un pb survient
                rollback ;
                // alerte utilisateur
                son(4)
                Messagebox("ERREUR ...","Sauvegarde des données impossible !~n~n" + SQLCA.SqlErrText, StopSign!)
                
else
// no pb pendant maj BD
                COMMIT ;

                p_sablier.visible = true
                fxg_copie_ecran ( var_code_local, "Page3.jpg",this)
                p_sablier.visible = false

                // à l'arrivé les 2 buffers doivent être identiques
                page_buffer[1] = page_buffer[2]
                // maj val retour
                return_val = 1
end if

return return_val

end function

