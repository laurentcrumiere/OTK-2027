event clicked;place(em_date.text,page,1)

//place_avec_blancs(em_age.text,page,11,2)
place_avec_blancs(sle_regle.text,page,13,5)
//place_avec_blancs(em_taille.text,page,18,4)

//place(string(ddlb_consul.FindItem(ddlb_consul.text,1)),page,22)
place(string(ddlb_amyg.FindItem(ddlb_amyg.text,1)),page,23)
place(string(ddlb_vege.FindItem(ddlb_vege.text,1)),page,24)
place(string(ddlb_respi.FindItem(ddlb_respi.text,1)),page,25)
place(string(ddlb_pb_respi.FindItem(ddlb_pb_respi.text,1)),page,26)
place(string(ddlb_succion.FindItem(ddlb_succion.text,1)),page,27)
place(string(ddlb_deglu.FindItem(ddlb_deglu.text,1)),page,28)
place(string(ddlb_praxie.FindItem(ddlb_praxie.text,1)),page,29)
place(string(ddlb_langue.FindItem(ddlb_langue.text,1)),page,30)
place(string(ddlb_contract.FindItem(ddlb_contract.text,1)),page,31)
place(string(ddlb_frein.FindItem(ddlb_frein.text,1)),page,32)
place(string(ddlb_muscu.FindItem(ddlb_muscu.text,1)),page,33)
place(string(ddlb_reeduca.FindItem(ddlb_reeduca.text,1)),page,34)
place(string(ddlb_ch_ferme.FindItem(ddlb_ch_ferme.text,1)),page,35)
place(string(ddlb_ouvert.FindItem(ddlb_ouvert.text,1)),page,36)
place(string(ddlb_pb.FindItem(ddlb_pb.text,1)),page,37)
place(string(ddlb_coop.FindItem(ddlb_coop.text,1)),page,38)
place(string(ddlb_pb_mineur.FindItem(ddlb_pb_mineur.text,1)),page,39)
place(string(ddlb_degre.FindItem(ddlb_degre.text,1)),page,40)

place(string(ddlb_taille.FindItem(ddlb_taille.text,1)),page,1647)

place_avec_blancs(sle_motif.text,page,1650,20)

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if
end event


