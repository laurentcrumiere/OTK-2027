global w_diagnos_maj_duigou1 w_diagnos_maj_duigou1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_date.text = Trim(mid(page,1,10))

IF mid(page,1,10) = space(10) THEN
	em_date.text = string(today (),'dd/mm/yyyy')
END IF 

//em_age.text = RightTrim(mid(page,11,2))
sle_regle.text = RightTrim(mid(page,13,5))
//em_taille.text = RightTrim(mid(page,18,4))

//ddlb_consul.selectitem(integer(mid(page,22,1)))
ddlb_amyg.selectitem(integer(mid(page,23,1)))
ddlb_vege.selectitem(integer(mid(page,24,1)))
ddlb_respi.selectitem(integer(mid(page,25,1)))
ddlb_pb_respi.selectitem(integer(mid(page,26,1)))
ddlb_succion.selectitem(integer(mid(page,27,1)))
ddlb_deglu.selectitem(integer(mid(page,28,1)))
ddlb_praxie.selectitem(integer(mid(page,29,1)))
ddlb_langue.selectitem(integer(mid(page,30,1)))
ddlb_contract.selectitem(integer(mid(page,31,1)))
ddlb_frein.selectitem(integer(mid(page,32,1)))
ddlb_muscu.selectitem(integer(mid(page,33,1)))
ddlb_reeduca.selectitem(integer(mid(page,34,1)))
ddlb_ch_ferme.selectitem(integer(mid(page,35,1)))
ddlb_ouvert.selectitem(integer(mid(page,36,1)))
ddlb_pb.selectitem(integer(mid(page,37,1)))
ddlb_coop.selectitem(integer(mid(page,38,1)))
ddlb_pb_mineur.selectitem(integer(mid(page,39,1)))
ddlb_degre.selectitem(integer(mid(page,40,1)))

ddlb_taille.selectitem(integer(mid(page,1647,1)))

sle_motif.text = RightTrim(mid(page,1650,20))
end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°1 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()

end event

