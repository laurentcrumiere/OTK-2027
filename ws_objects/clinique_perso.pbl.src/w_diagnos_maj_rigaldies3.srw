global w_diagnos_maj_rigaldies3 w_diagnos_maj_rigaldies3

type variables
double var_code_local 
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();mle_remarques.text =  trim(mid(page,845,250))
sle_fma.text = RightTrim(mid(page,1445,6))

mle_plusp3.text = RightTrim(mid(page,1451,78))
mle_moinsp3.text = RightTrim(mid(page,1529,78))
sle_cons.text = RightTrim(mid(page,1607,6))
em_extrac.text = trim(mid(page,579,38))


sle_deb1.text = RightTrim(mid(page,1613,4))
sle_deb2.text = RightTrim(mid(page,1617,4))
sle_deb3.text = RightTrim(mid(page,1621,4))
sle_deb4.text = RightTrim(mid(page,1625,4))
sle_deb5.text = RightTrim(mid(page,1629,4))
sle_deb6.text = RightTrim(mid(page,1633,4))

sle_but1.text = RightTrim(mid(page,1637,4))
sle_but2.text = RightTrim(mid(page,1641,4))
sle_but3.text = RightTrim(mid(page,1645,4))
sle_but4.text = RightTrim(mid(page,1649,4))
sle_but5.text = RightTrim(mid(page,1653,4))
sle_but6.text = RightTrim(mid(page,1657,4))

sle_fin1.text = RightTrim(mid(page,1661,4))
sle_fin2.text = RightTrim(mid(page,1665,4))
sle_fin3.text = RightTrim(mid(page,1669,4))
sle_fin4.text = RightTrim(mid(page,1673,4))
sle_fin5.text = RightTrim(mid(page,1677,4))
sle_fin6.text = RightTrim(mid(page,1681,4))


end subroutine

event open;
var_code_local = message.doubleparm

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

mep_win_mdi(this,1)
init()


end event

