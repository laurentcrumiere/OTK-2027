event clicked;if	rb_dent_pres.checked then
	place("1",page,1816)
else
	if	rb_dent_age.checked then
		place("2",page,1816)
	else	
		if	rb_dent_enc.checked then
			place("3",page,1816)
		else	
			if	rb_dent_ext.checked then
				place("4",page,1816)
			else	
				if	rb_dent_pas_vue.checked then
					place("5",page,1816)
				else	
					place("6",page,1816)
				end if	
			end if	
		end if	
	end if	
end if

if	rb_age_non.checked then
	place("1",page,1817)
else
	place("2",page,1817)
end if

if	rb_ext_non.checked then
	place("1",page,1818)
else
	place("2",page,1818)
end if

if	rb_sur_non.checked then
	place("1",page,1819)
else
	place("2",page,1819)
end if

if	rb_inc_non.checked then
	place("1",page,1820)
else
	place("2",page,1820)
end if

if	rb_resorp_non.checked then
	place("1",page,1821)
else
	place("2",page,1821)
end if

if	rb_atro_non.checked then
	place("1",page,1822)
else
	place("2",page,1822)
end if

if	rb_abces_non.checked then
	place("1",page,1823)
else
	if	rb_abces_api.checked then
		place("2",page,1823)
	else
		place("3",page,1823)
	end if
end if

if	rb_trait_non.checked then
	place("1",page,1824)
else
	place("2",page,1824)
end if

if	rb_atm_ras.checked then
	place("1",page,1825)
else
	if	rb_atm_dte.checked then
		place("2",page,1825)
	else
		place("3",page,1825)
	end if
end if


place_avec_blancs(mle_age.text,page,1826,62)
place_avec_blancs(mle_ext.text,page,1888,62)
place_avec_blancs(mle_sur.text,page,1950,62)
place_avec_blancs(mle_inc.text,page,2012,62)
place_avec_blancs(mle_resorp.text,page,2074,62)
place_avec_blancs(mle_atro.text,page,2136,62)
place_avec_blancs(mle_abces_api.text,page,2198,21)
place_avec_blancs(mle_abces_paro.text,page,2219,25)
place_avec_blancs(mle_trait.text,page,2244,62)


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end event

