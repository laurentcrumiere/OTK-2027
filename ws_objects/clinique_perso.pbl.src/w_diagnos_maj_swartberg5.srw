global w_diagnos_maj_swartberg5 w_diagnos_maj_swartberg5

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();if mid(page,1816,1) = '1' then
	rb_dent_pres.checked = true
else
	if mid(page,1816,1) = '2' then
		rb_dent_age.checked = true
	else
		if mid(page,1816,1) = '3' then
			rb_dent_enc.checked = true
		else
			if mid(page,1816,1) = '4' then
				rb_dent_ext.checked = true
			else
				if mid(page,1816,1) = '5' then
					rb_dent_pas_vue.checked = true
				else
					rb_dent_vue.checked = true
				end if
			end if
		end if
	end if
end if

if mid(page,1817,1) = '1' OR mid(page,1817,1) = ' ' then
	rb_age_non.checked = true
else
	rb_age_oui.checked = true
end if

if mid(page,1818,1) = '1' OR mid(page,1818,1) = ' ' then
	rb_ext_non.checked = true
else
	rb_ext_oui.checked = true
end if

if mid(page,1819,1) = '1' OR mid(page,1819,1) = ' ' then
	rb_sur_non.checked = true
else
	rb_sur_oui.checked = true
end if

if mid(page,1820,1) = '1' OR mid(page,1820,1) = ' ' then
	rb_inc_non.checked = true
else
	rb_inc_oui.checked = true
end if

if mid(page,1821,1) = '1' OR mid(page,1821,1) = ' ' then
	rb_resorp_non.checked = true
else
	rb_resorp_oui.checked = true
end if

if mid(page,1822,1) = '1' OR mid(page,1822,1) = ' ' then
	rb_atro_non.checked = true
else
	rb_atro_oui.checked = true
end if

if mid(page,1823,1) = '1' OR mid(page,1823,1) = ' ' then
	rb_abces_non.checked = true
else
	if mid(page,1823,1) = '2' then
		rb_abces_api.checked = true
	else
		rb_abcess_paro.checked = true
	end if
end if

if mid(page,1824,1) = '1' OR mid(page,1824,1) = ' ' then
	rb_trait_non.checked = true
else
	rb_trait_oui.checked = true
end if

if mid(page,1825,1) = '1' OR mid(page,1825,1) = ' ' then
	rb_atm_ras.checked = true
else
	if mid(page,1825,1) = '2' then
		rb_atm_dte.checked = true
	else
		rb_atm_gche.checked = true
	end if
end if

mle_age.text = Righttrim(mid(page,1826,62))
mle_ext.text = Righttrim(mid(page,1888,62))
mle_sur.text = Righttrim(mid(page,1950,62))
mle_inc.text = Righttrim(mid(page,2012,62))
mle_resorp.text = Righttrim(mid(page,2074,62))
mle_atro.text = Righttrim(mid(page,2136,62))
mle_abces_api.text = Righttrim(mid(page,2198,21))
mle_abces_paro.text = Righttrim(mid(page,2219,25))
mle_trait.text = Righttrim(mid(page,2244,62))

modif = false
end subroutine

event open;
var_code_local = message.doubleparm

string vn,vm 
date vd
select nom,moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if


this.title = "Page N°5 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Date de naissance : " + string(vd,'dd/mm/yyyy') + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if




init()
//init_photos(var_code_local)

end event

