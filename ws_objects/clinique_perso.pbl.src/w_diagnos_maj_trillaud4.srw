type cb_suivant from commandbutton within w_diagnos_maj_trillaud4
boolean visible = false
integer x = 1856
integer y = 1712
integer width = 338
integer height = 96
integer taborder = 540
integer textsize = -8
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Suivant"
end type

event clicked;if modif then
	If MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre ?",Question!,YesNo!) = 1 Then
		OpenSheetWithParm(w_diagnos_maj_trillaud4,var_code_local,w_mdi,1,Original!)
		Close(w_diagnos_maj_trillaud4)
	end if
else
	OpenSheetWithParm(w_diagnos_maj_trillaud4,var_code_local,w_mdi,1,Original!)
	close(w_diagnos_maj_trillaud4)
end if
end event

