place(string(ddlb_milieux.FindItem(ddlb_milieux.text,1)),page,1360)
place(string(ddlb_mand.FindItem(ddlb_mand.text,1)),page,1361)

if cbx_haut.checked then
	place("O",page,1362)
else
	place("N",page,1362)
end if
if cbx_bas.checked then
	place("O",page,1363)
else
	place("N",page,1363)
end if
if cbx_ddd.checked then
	place("O",page,1364)
else
	place("N",page,1364)
end if

place_avec_blancs(sle_caries.text,page,1370,40)
place_avec_blancs(sle_dysplasies.text,page,1450,40)

place(string(ddlb_hygiene.FindItem(ddlb_hygiene.text,1)),page,1500)
place(string(ddlb_motivation.FindItem(ddlb_motivation.text,1)),page,1501)

place_avec_blancs(mle_diag.text,page,1510,300)
place_avec_blancs(mle_remarques.text,page,2000,300)



UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end event

