global w_diagnos_maj_trillaud4 w_diagnos_maj_trillaud4

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

mle_ant_gene.text = Righttrim(trim(mid(page,200,200)))
mle_ant_fami.text = Righttrim(trim(mid(page,500,200)))

ddlb_respiration.selectitem(integer(mid(page,1000,1)))
ddplb_deglutition.selectitem(integer(mid(page,1001,1)))
ddplb_phonation.selectitem(integer(mid(page,1002,1)))
if mid(page,1003,1) = 'O' then
	cbx_suceur.checked = true
else
	cbx_suceur.checked = false
end if
if mid(page,1004,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page,1005,1) = 'O' then
	cbx_bruxisme.checked = true
else
	cbx_bruxisme.checked = false
end if

ddlb_amygdales.selectitem(integer(mid(page,1006,1)))
ddlb_vegetations.selectitem(integer(mid(page,1007,1)))
ddlb_langue.selectitem(integer(mid(page,1008,1)))
ddplb_levres.selectitem(integer(mid(page,1009,1)))
ddplb_volume.selectitem(integer(mid(page,1010,1)))

if mid(page,1011,1) = 'O' then
	cbx_douleur.checked = true
else
	cbx_douleur.checked = false
end if
if mid(page,1012,1) = 'O' then
	cbx_craquement.checked = true
else
	cbx_craquement.checked = false
end if
if mid(page,1013,1) = 'O' then
	cbx_ressaut.checked = true
else
	cbx_ressaut.checked = false
end if
ddlb_chemin.selectitem(integer(mid(page,1014,1)))
ddplb_amplitude.selectitem(integer(mid(page,1015,1)))

sle_prematurites.text = Righttrim(mid(page,1020,30))
em_plaque.text = Righttrim(mid(page,1100,10))
em_gingivite.text = Righttrim(mid(page,1150,10))
em_poche.text = Righttrim(mid(page,1200,10))
em_mobilite.text = Righttrim(mid(page,1250,10))

if mid(page,1300,1) = 'O' then
	cbx_langue.checked = true
else
	cbx_langue.checked = false
end if
if mid(page,1301,1) = 'O' then
	cbx_levre_sup.checked = true
else
	cbx_levre_sup.checked = false
end if
if mid(page,1302,1) = 'O' then
	cbx_levre_inf.checked = true
else
	cbx_levre_inf.checked = false
end if
em_sag1.text = mid(page,1305,3)
em_sag2.text = mid(page,1310,3)
em_sag3.text = mid(page,1315,3)
em_sag4.text = mid(page,1320,3)
em_sag5.text = mid(page,1325,3)
em_tran1.text = mid(page,1330,3)
em_tran2.text = mid(page,1335,3)
em_tran3.text = mid(page,1340,3)
em_tran4.text = mid(page,1345,3)
em_tran5.text = mid(page,1350,3)
ddlb_vert1.selectitem(integer(mid(page,1355,1)))
ddlb_vert2.selectitem(integer(mid(page,1356,1)))
ddlb_vert3.selectitem(integer(mid(page,1357,1)))
ddlb_vert4.selectitem(integer(mid(page,1358,1)))
ddlb_vert5.selectitem(integer(mid(page,1359,1)))

ddlb_milieux.selectitem(integer(mid(page,1360,1)))
ddlb_mand.selectitem(integer(mid(page,1361,1)))

if mid(page,1362,1) = 'O' then
	cbx_haut.checked = true
else
	cbx_haut.checked = false
end if
if mid(page,1363,1) = 'O' then
	cbx_bas.checked = true
else
	cbx_bas.checked = false
end if
if mid(page,1364,1) = 'O' then
	cbx_ddd.checked = true
else
	cbx_ddd.checked = false
end if

sle_caries.text = Righttrim(mid(page,1370,40))
sle_dysplasies.text = Righttrim(mid(page,1450,40))

ddlb_hygiene.selectitem(integer(mid(page,1500,1)))
ddlb_motivation.selectitem(integer(mid(page,1501,1)))

mle_diag.text = RightTrim(mid(page,1510,300))
mle_remarques.text = RightTrim(mid(page,2000,300))


end subroutine

event open;
var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, lmois

select nom,moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;

if isnull(vm) then vm = ""
if isnull(vd) then vd = Today()

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	lmois = month(today()) - month( vd ) +12
ELSE
	lmois = month(today()) - month( vd )
END IF

this.title = "Page N°4 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(lmois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

init()

dw_1.settransobject(SQLCA)

dw_1.retrieve(var_code_local)

mep_win_mdi(this,1)

end event

