type cb_date from commandbutton within w_diagnos_maj_87660_1
integer x = 599
integer y = 204
integer width = 530
integer height = 104
integer taborder = 20
boolean bringtotop = true
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = roman!
string facename = "Times New Roman"
string text = "insérer date du jour"
end type

event clicked;
modif = true

date vd
integer age_an, age_mois, saisie_mois


em_date.Text = string(Today())


select date_naissance INTO :vd FROM patient WHERE code = :var_code_local ;

saisie_mois = integer(mid(em_date.text,4,2))

if  saisie_mois < month( vd ) then
	age_an = integer(mid(em_date.text,7,4)) - year( vd ) - 1
ELSE
	age_an = integer(mid(em_date.text,7,4)) - year( vd )
END IF	

if saisie_mois < month( vd ) then
	age_mois = integer(mid(em_date.text,4,2)) - month( vd ) +12
ELSE
	age_mois = integer(mid(em_date.text,4,2)) - month( vd )
END IF

sle_age.text = string(age_an) + " ans " + string(age_mois) + " mois"

end event

