global w_diagnos_maj_swartberg1 w_diagnos_maj_swartberg1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();string pt

SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;

modif = false

em_date_donne.text = Trim(mid(page,1,10))
em_date_rendu.text = Trim(mid(page,11,10))
em_date_consul.text = Trim(mid(page,21,10))
em_date_conf.text = Trim(mid(page,31,10))
em_date_pose.text = Trim(mid(page,41,10))
em_date_debut.text = Trim(mid(page,51,10))
em_date_trait.text = Trim(mid(page,61,10))
em_date_trait_int.text = Trim(mid(page,71,10))

em_mois.text = RightTrim(mid(page,81,3))

if mid(page,84,1) = '1' then
	rb_d_sup_min.checked = true
else
	rb_d_sup_max.checked = true
end if

if mid(page,85,1) = '1' then
	rb_d_inf_min.checked = true
else
	rb_d_inf_max.checked = true
end if

if mid(page,86,1) = '1' then
	rb_g_sup_min.checked = true
else
	rb_g_sup_max.checked = true
end if

if mid(page,87,1) = '1' then
	rb_g_inf_min.checked = true
else
	rb_g_inf_max.checked = true
end if

if mid(page,88,1) = '1' OR mid(page,88,1) = ' ' then
	rb_pat_bonne.checked = true
else
	if mid(page,88,1) = '2' then
		rb_pat_moy.checked = true
	else
		rb_pat_auc.checked = true
	end if
end if

if mid(page,89,1) = '1' OR mid(page,89,1) = ' ' then
	rb_par_bonne.checked = true
else
	if mid(page,89,1) = '2' then
		rb_par_moy.checked = true
	else
		rb_par_auc.checked = true
	end if
end if

sle_extract.text = Righttrim(mid(page,100,20))
sle_prot.text = Righttrim(mid(page,120,20))
sle_cont.text = Righttrim(mid(page,140,20))
sle_rem.text = Righttrim(mid(page,160,20))
sle_prof.text = Righttrim(mid(page,180,20))
sle_etio.text = Righttrim(mid(page,200,20))

mle_hobbies.text = Righttrim(mid(page,220,20))
mle_sports.text = Righttrim(mid(page,240,20))
mle_dx_prov.text = Righttrim(mid(page,260,43))
mle_tx_prov.text = Righttrim(mid(page,310,43))
mle_dx_def.text = Righttrim(mid(page,360,180))

mle_tx_def.text = pt
end subroutine

event open;
var_code_local = message.doubleparm

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

string vn,vm 
date vd
select nom,moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if


this.title = "Page N°1 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Date de naissance : " + string(vd,'dd/mm/yyyy') + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if


init()


end event

