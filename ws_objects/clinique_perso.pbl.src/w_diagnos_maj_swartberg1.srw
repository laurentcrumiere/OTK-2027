event clicked;string pt

place(em_date_donne.text ,page,1)
place(em_date_rendu.text ,page,11)
place(em_date_consul.text ,page,21)
place(em_date_conf.text ,page,31)
place(em_date_pose.text ,page,41)
place(em_date_debut.text ,page,51)
place(em_date_trait.text ,page,61)
place(em_date_trait_int.text ,page,71)

place_avec_blancs(em_mois.text,page,81,3)

if	rb_d_sup_min.checked then
	place("1",page,84)
else
	place("2",page,84)
end if

if	rb_d_inf_min.checked then
	place("1",page,85)
else
	place("2",page,85)
end if

if	rb_g_sup_min.checked then
	place("1",page,86)
else
	place("2",page,86)
end if

if	rb_g_inf_min.checked then
	place("1",page,87)
else
	place("2",page,87)
end if

if	rb_pat_bonne.checked then
	place("1",page,88)
else
	if	rb_pat_moy.checked then
		place("2",page,88)
	else	
		place("3",page,88)
	end if	
end if

if	rb_par_bonne.checked then
	place("1",page,89)
else
	if	rb_par_moy.checked then
		place("2",page,89)
	else	
		place("3",page,89)
	end if	
end if

place_avec_blancs(sle_extract.text,page,100,20)
place_avec_blancs(sle_prot.text,page,120,20)
place_avec_blancs(sle_cont.text,page,140,20)
place_avec_blancs(sle_rem.text,page,160,20)
place_avec_blancs(sle_prof.text,page,180,20)
place_avec_blancs(sle_etio.text,page,200,20)

place_avec_blancs(mle_hobbies.text,page,220,20)
place_avec_blancs(mle_sports.text,page,240,20)
place_avec_blancs(mle_dx_prov.text,page,260,43)
place_avec_blancs(mle_tx_prov.text,page,310,43)
place_avec_blancs(mle_dx_def.text,page,360,180)

pt = mle_tx_def.text

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	UPDATE patient SET plan_traitement = :pt WHERE code = :var_code_local ;
	if SQLCA.Sqlcode <> 0 then
		son(4)
		Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
	else
		modif = false
		COMMIT ;
	end if
end if

end event

