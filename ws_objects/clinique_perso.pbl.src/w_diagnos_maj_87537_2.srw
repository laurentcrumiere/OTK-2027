event losefocus;
LM_Haut = this.Position
sle_LM_Haut.text = string(LM_Haut)
sle_val_LM_Haut.text=string(abs((LM_Haut)-10))
end event

event moved;
LM_Haut = this.Position
sle_LM_Haut.text = string(LM_Haut)
sle_val_LM_Haut.text=string(abs((LM_Haut)-10))
end event

event other;
LM_Haut = this.Position
sle_LM_Haut.text = string(LM_Haut)
sle_val_LM_Haut.text=string(abs((LM_Haut)-10))
end event

