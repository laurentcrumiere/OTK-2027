global w_diagnos_maj_hernandez1 w_diagnos_maj_hernandez1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false
mle_remarques.text =  trim(mid(page,1,250))
sle_fma.text = RightTrim(mid(page,300,6))

mle_plusp3.text = RightTrim(mid(page,400,78))
mle_moinsp3.text = RightTrim(mid(page,500,78))
sle_cons.text = RightTrim(mid(page,600,6))
em_extrac.text = trim(mid(page,650,38))


sle_deb1.text = RightTrim(mid(page,700,4))
sle_deb2.text = RightTrim(mid(page,710,4))
sle_deb3.text = RightTrim(mid(page,720,4))
sle_deb4.text = RightTrim(mid(page,730,4))
sle_deb5.text = RightTrim(mid(page,740,4))
sle_deb6.text = RightTrim(mid(page,750,4))

sle_but1.text = RightTrim(mid(page,760,4))
sle_but2.text = RightTrim(mid(page,770,4))
sle_but3.text = RightTrim(mid(page,780,4))
sle_but4.text = RightTrim(mid(page,790,4))
sle_but5.text = RightTrim(mid(page,800,4))
sle_but6.text = RightTrim(mid(page,810,4))

sle_fin1.text = RightTrim(mid(page,820,4))
sle_fin2.text = RightTrim(mid(page,830,4))
sle_fin3.text = RightTrim(mid(page,840,4))
sle_fin4.text = RightTrim(mid(page,850,4))
sle_fin5.text = RightTrim(mid(page,860,4))
sle_fin6.text = RightTrim(mid(page,870,4))


end subroutine

event open;
var_code_local = message.doubleparm
string vn,vm 


select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if


this.title = "Page N°1 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()


end event

