boolean modif
end variables

forward prototypes
public subroutine init ()
public subroutine majtot ()
end prototypes

public subroutine init ();
em_aet72.text = trim(mid(page,1700,3))

em_acf11.text = trim(mid(page,1725,2))
em_acf21.text = trim(mid(page,1727,2))
em_acf31.text = trim(mid(page,1729,2))
em_acf41.text = trim(mid(page,1731,2))
em_acf51.text = trim(mid(page,1733,2))
em_acf61.text = trim(mid(page,1735,4))

em_aet11.text = trim(mid(page,1740,2))
em_aet21.text = trim(mid(page,1742,3))
em_aet31.text = trim(mid(page,1745,2))

em_aet51.text = trim(mid(page,1750,3))
em_aet61.text = trim(mid(page,1753,3))

em_aet81.text = trim(mid(page,1760,3))
em_aet91.text = trim(mid(page,1763,3))

em_acf12.text = string (integer(em_acf11.text) * 5)
em_acf22.text = string (integer(em_acf21.text) * 15)
em_acf32.text = string (integer(em_acf31.text) * 2)
em_acf42.text = string (integer(em_acf41.text) * 3)
em_acf52.text = string (integer(em_acf51.text) * 5)
em_acf62.text = string (double(em_acf61.text) * 300)

em_aet12.text = string (integer(em_aet11.text) * 1.5)
em_aet22.text = string (integer(em_aet21.text) * 1)
em_aet32.text = string (integer(em_aet31.text) * 0.5)
em_aet62.text = string (integer(em_aet61.text) * 1)
em_aet82.text = string (integer(em_aet81.text) * 0.5)
em_aet92.text = string (integer(em_aet91.text) * 0.5)


majtot()

modif = false

end subroutine

public subroutine majtot ();em_acf72.text = string (integer(em_acf12.text)+integer(em_acf22.text)+integer(em_acf32.text)+integer(em_acf42.text)+integer(em_acf52.text)+integer(em_acf62.text))

em_totcf.text = em_acf72.text


em_aet112.text = string (integer(em_aet12.text)+integer(em_aet22.text)+integer(em_aet32.text) &
+integer(em_aet52.text)+integer(em_aet62.text)+integer(em_aet72.text)+integer(em_aet82.text)+&
integer(em_aet92.text))

em_totd.text = em_aet112.text

em_totgene.text = string(integer(em_totd.text)+integer(em_totcf.text))

em_aet41.text = string (integer(em_aet11.text)+integer(em_aet21.text)+integer(em_aet31.text))
em_aet71.text = string (integer(em_aet51.text)+integer(em_aet61.text))
em_aet101.text = string (integer(em_aet81.text)+integer(em_aet91.text))

em_aet111.text = string (integer(em_aet41.text)+integer(em_aet71.text)+integer(em_aet101.text))
end subroutine

event open;
var_code_local = message.doubleparm

string vn,vm,se
date dn

select nom,moulage,sexe,date_naissance INTO :vn,:vm,:se,:dn 
FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if
if isnull(se) then
	se = "M"
end if
if isnull(dn) then
	dn = date('1900-01-01')
end if


this.title = "Page N°2 : "+vn+ " - N°"+string(var_code_local)

if se = "F" then
	this.title = this.title + " - Née le "+string(dn)+" - Sexe Féminin"
else
	this.title = this.title + " - Né le "+string(dn)+" - Sexe Masculin"
end if

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then	page = space(4000)
if len(page) < 4000 then page = page + space(4000 - len(page))

init()
mep_win_mdi(this,1)

end event

