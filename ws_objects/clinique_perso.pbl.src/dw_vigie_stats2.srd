 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param~" ) COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim1_n from paye where ~~~"date~~~" between :trim1_min and :trim1_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim2_n from paye where ~~~"date~~~" between :trim2_min and :trim2_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim3_n from paye where ~~~"date~~~" between :trim3_min and :trim3_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim4_n from paye where ~~~"date~~~" between :trim4_min and :trim4_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim1_n1 from paye where ~~~"date~~~" between :n1_trim1_min and :n1_trim1_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim2_n1 from paye where ~~~"date~~~" between :n1_trim2_min and :n1_trim2_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim3_n1 from paye where ~~~"date~~~" between :n1_trim3_min and :n1_trim3_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim4_n1 from paye where ~~~"date~~~" between :n1_trim4_min and :n1_trim4_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim1_n2 from paye where ~~~"date~~~" between :n2_trim1_min and :n2_trim1_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim2_n2 from paye where ~~~"date~~~" between :n2_trim2_min and :n2_trim2_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim3_n2 from paye where ~~~"date~~~" between :n2_trim3_min and :n2_trim3_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim4_n2 from paye where ~~~"date~~~" between :n2_trim4_min and :n2_trim4_max and ~~~"mode~~~" <> 'S')~") COMPUTE(NAME=~"( select isnull(sum(montant),0)  as trim1_n3 from paye where ~~~"date~~~