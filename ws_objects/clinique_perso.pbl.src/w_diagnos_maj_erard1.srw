public subroutine load_ctrls ()
public subroutine unload_ctrls ()
end prototypes

public subroutine load_ctrls ();string	nomPatient, prenomPatient, moulagePatient, telPatient, corresPatient, dentistePatient, nomCorres, nomDentiste
date	dateNaissPatient


st_6.text = string( var_code_local )

select	nom, prenom, moulage, teldom_parent1, date_naissance, code_correspondant, code_dentiste
into	:nomPatient, :prenomPatient, :moulagePatient, :telPatient, :dateNaissPatient, :corresPatient, :dentistePatient
from	patient
where	patient.code = :var_code_local ;

if isnull( nomPatient ) then nomPatient = ""
st_19.text = nomPatient

if isnull( prenomPatient ) then prenomPatient = ""
st_20.text = prenomPatient

if isnull( moulagePatient ) then moulagePatient = ""
st_50.text = moulagePatient

if isnull( telPatient ) then telPatient = ""
st_4.text = st_4.tag + telPatient

if not isnull( dateNaissPatient ) then
	st_2.text = st_2.tag + string( dateNaissPatient )
else
	st_2.text = st_2.tag
end if

if not isnull( corresPatient ) then
	select	correspondants.nom
	into	:nomCorres
	from	correspondants, patient
	where	code_correspondant = correspondants.code and
			code_correspondant = :corresPatient ;
	
	if isnull( nomCorres ) then nomCorres = ""
	st_1.text = st_1.tag + nomCorres
else
	st_1.text = st_1.tag
end if

if not isnull( dentistePatient ) then
	select	correspondants.nom
	into	:nomDentiste
	from	correspondants, patient
	where	code_dentiste = correspondants.code and
			code_dentiste = :dentistePatient ;
	
	if isnull( nomDentiste ) then nomDentiste = ""
	st_3.text = st_3.tag + nomCorres
else
	st_3.text = st_3.tag
end if

f.lire_pt( mle_3, var_code_local )

f.lirepage(sle_1,page_buffer[1],10,12)
f.lirepage(ddlb_6,page_buffer[1],22,1)
