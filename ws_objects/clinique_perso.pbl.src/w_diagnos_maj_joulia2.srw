global w_diagnos_maj_joulia2 w_diagnos_maj_joulia2

type variables
double var_code_local 
boolean modif
string page
uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lirepage(em_1_1,page,171,10)
f.lirepage(em_1_2,page,181,10)
f.lirepage(em_1_3,page,191,10)
f.lirepage(em_1_4,page,201,10)
f.lirepage(em_1_5,page,211,10)

f.lirepage(em_2_1,page,221,10)
f.lirepage(em_2_2,page,231,10)
f.lirepage(em_2_3,page,241,10)
f.lirepage(em_2_4,page,251,10)
f.lirepage(em_2_5,page,261,10)
f.lirepage(em_2_6,page,271,10)
f.lirepage(em_2_7,page,281,10)
f.lirepage(em_2_8,page,291,10)

f.lirepage(mle_1,page,301,500)		// 801 carac ds page N°2



cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(em_1_1,page,171,10)
f.ecrirepage(em_1_2,page,181,10)
f.ecrirepage(em_1_3,page,191,10)
f.ecrirepage(em_1_4,page,201,10)
f.ecrirepage(em_1_5,page,211,10)

f.ecrirepage(em_2_1,page,221,10)
f.ecrirepage(em_2_2,page,231,10)
f.ecrirepage(em_2_3,page,241,10)
f.ecrirepage(em_2_4,page,251,10)
f.ecrirepage(em_2_5,page,261,10)
f.ecrirepage(em_2_6,page,271,10)
f.ecrirepage(em_2_7,page,281,10)
f.ecrirepage(em_2_8,page,291,10)

f.ecrirepage(mle_1,page,301,500)		// 801 carac ds page N°2


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

