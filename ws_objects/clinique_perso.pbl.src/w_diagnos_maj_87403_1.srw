// max carac = 2300

//*****************************************************************
string	lstr_sexe, lstr_dentiste
date		ld_naissance

// pour zone "sexe"
select sexe into :lstr_sexe from patient where code = :var_code_local ;
if lstr_sexe = "M" then lstr_sexe = "Masculin"
if lstr_sexe = "F" then lstr_sexe = "Féminin"
if isnull(lstr_sexe) then lstr_sexe = ""
st_36.text = lstr_sexe

// zone "date naissance"
select date_naissance into :ld_naissance from patient where code = :var_code_local ;
if isnull(ld_naissance) then ld_naissance = date("0000-00-00")
st_7.text = string(ld_naissance, "dd/mm/aaaa")

// zone "dentiste traitant"
select correspondants.nom into :lstr_dentiste from correspondants, patient where correspondants.code = patient.code_correspondant AND patient.code = :var_code_local ;
if isnull(lstr_dentiste) then lstr_dentiste = ""
st_6.text = lstr_dentiste
end subroutine

