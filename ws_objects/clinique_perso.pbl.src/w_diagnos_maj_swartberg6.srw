else
	if mid(page,2309,1) = '2' then
		rb_max_mand_disto.checked = true
	else
		rb_max_mand_mesio.checked = true
	end if
end if

if mid(page,2310,1) = '1' OR mid(page,2310,1) = ' ' then
	rb_mand_plane_nor.checked = true
else
	if mid(page,2310,1) = '2' then
		rb_mand_plane_doli.checked = true
	else
		rb_mand_plane_brachy.checked = true
	end if
end if

if mid(page,2311,1) = '1' OR mid(page,2311,1) = ' ' then
	rb_mand_egal.checked = true
else
	rb_mand_bord.checked = true
end if

if mid(page,2312,1) = '1' OR mid(page,2312,1) = ' ' then
	rb_ufh_nor.checked = true
else
	if mid(page,2312,1) = '2' then
		rb_ufh_dolicho.checked = true
	else
		rb_ufh_brachy.checked = true
	end if
end if

if mid(page,2314,1) = '1' OR mid(page,2314,1) = ' ' then
	rb_naso_nor.checked = true
else
	if mid(page,2314,1) = '2' then
		rb_naso_prog.checked = true
	else
		rb_naso_retru.checked = true
	end if
end if

if mid(page,2315,1) = '1' OR mid(page,2315,1) = ' ' then
	rb_facial_nor.checked = true
else
	if mid(page,2315,1) = '2' then
		rb_facial_dolicho.checked = true
	else
		rb_facial_brachy.checked = true
	end if
end if

if mid(page,2316,1) = '1' OR mid(page,2316,1) = ' ' then
	rb_pos_sup_nor.checked = true
else
	if mid(page,2316,1) = '2' then
		rb_pos_sup_propo.checked = true
	else
		rb_pos_sup_retro.checked = true
	end if
end if

if mid(page,2317,1) = '1' OR mid(page,2317,1) = ' ' then
	rb_pos_inf_nor.checked = true
else
	if mid(page,2317,1) = '2' then
		rb_pos_inf_propo.checked = true
	else
