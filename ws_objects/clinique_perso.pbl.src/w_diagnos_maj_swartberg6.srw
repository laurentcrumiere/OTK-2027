type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();if mid(page,2306,1) = '1' OR mid(page,2306,1) = ' ' then
	rb_profil_normal.checked = true
else
	if mid(page,2306,1) = '2' then
		rb_profil_convexe.checked = true
	else
		if mid(page,2306,1) = '3' then
			rb_profil_conca.checked = true
		else
			if mid(page,2306,1) = '4' then
				rb_profil_dish.checked = true
			else
				rb_profil_pro.checked = true
			end if
		end if
	end if
end if

if mid(page,2307,1) = '1' OR mid(page,2307,1) = ' ' then
	rb_max_cra_nor.checked = true
else
	if mid(page,2307,1) = '2' then
		rb_max_cra_progn.checked = true
	else
		rb_max_cra_retro.checked = true
	end if
end if

if mid(page,2308,1) = '1' OR mid(page,2308,1) = ' ' then
	rb_man_cra_nor.checked = true
else
	if mid(page,2308,1) = '2' then
		rb_man_cra_prog.checked = true
	else
		rb_man_cra_retro.checked = true
	end if
end if

if mid(page,2309,1) = '1' OR mid(page,2309,1) = ' ' then
