END IF
em_pos_inf.text = Righttrim(mid(page,2335,3))
IF mid(page,2335,3) = space(3) THEN
	em_pos_inf.text = string(2)
END IF
em_inc_inc_sup.text = Righttrim(mid(page,2338,2))
IF mid(page,2338,2) = space(2) THEN
	em_inc_inc_sup.text = string(28)
END IF
em_inc_inf.text = Righttrim(mid(page,2340,2))
IF mid(page,2340,2) = space(2) THEN
	em_inc_inf.text = string(22)
END IF


modif = false
end subroutine

event open;
var_code_local = message.doubleparm

string vn,vm 
date vd
select nom,moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if


this.title = "Page N°6 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Date de naissance : " + string(vd,'dd/mm/yyyy') + " (Moulage : "+vm+")"

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if



init()
//init_photos(var_code_local)

end event

