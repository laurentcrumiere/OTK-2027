else
	if mid(page,2319,1) = '2' then
		rb_inc_protru.checked = true
	else
		rb_inc_inf_retru.checked = true
	end if
end if

em_sna.text = Righttrim(mid(page,2320,3))
IF mid(page,2320,3) = space(3) THEN
	em_sna.text = string(81)
END IF

em_snb.text = Righttrim(mid(page,2323,3))
IF mid(page,2323,3) = space(3) THEN
	em_snb.text = string(79)
END IF
em_anb.text = Righttrim(mid(page,2326,3))
IF mid(page,2326,3) = space(3) THEN
