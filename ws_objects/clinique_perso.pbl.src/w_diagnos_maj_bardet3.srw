if mid(page,2199,1) = '1' then
	rb_stress1.checked = true
else
	if mid(page,2199,1) = '2' then
		rb_stress2.checked = true
	else
		rb_stress3.checked = true
	end if
end if

sle_bil1.text = Righttrim(mid(page,2200,15))
