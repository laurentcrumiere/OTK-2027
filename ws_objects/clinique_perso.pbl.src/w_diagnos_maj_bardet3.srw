forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();
// On utilise à partir de 2000

if mid(page,2000,1) = 'O' then
	cbx_seq1.checked = true
else
	cbx_seq1.checked = false
end if

if mid(page,2001,1) = 'O' then
	cbx_seq2.checked = true
else
	cbx_seq2.checked = false
end if
if mid(page,2002,1) = 'O' then
	cbx_seq31.checked = true
else
	cbx_seq31.checked = false
end if
