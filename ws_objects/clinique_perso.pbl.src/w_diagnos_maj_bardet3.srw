	cbx_seq6.checked = true
else
	cbx_seq6.checked = false
end if
if mid(page,2011,1) = 'O' then
	cbx_seq7.checked = true
else
	cbx_seq7.checked = false
end if

em_d0.text = Righttrim(mid(page,2012,8))

if mid(page,2020,1) = 'O' then
	cbx_con11.checked = true
else
	cbx_con11.checked = false
end if
if mid(page,2021,1) = 'O' then
	cbx_con12.checked = true
