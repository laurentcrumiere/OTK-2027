global type w_diagnos_maj_marie4 from window
integer x = 5
integer width = 2907
integer height = 1940
boolean titlebar = true
string title = "Page N°3"
windowtype windowtype = response!
long backcolor = 12632256
ole_photo016 ole_photo016
ole_photo015 ole_photo015
ole_photo014 ole_photo014
ole_photo013 ole_photo013
ole_photo012 ole_photo012
ole_photo011 ole_photo011
ole_photo010 ole_photo010
ole_photo009 ole_photo009
cb_fermer cb_fermer
end type
global w_diagnos_maj_marie4 w_diagnos_maj_marie4

type variables
double var_code_local 
string page
boolean modif
end variables

event open;var_code_local = message.doubleparm

string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vd) then
	vd = today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°4 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"

//charge tout ce qui va bien
centrer(this)

end event

