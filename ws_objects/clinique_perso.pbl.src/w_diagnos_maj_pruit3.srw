global w_diagnos_maj_pruit3 w_diagnos_maj_pruit3

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_d1.text = Righttrim(trim(mid(page,1310,7)))
em_d2.text = Righttrim(trim(mid(page,1320,7)))
em_d3.text = Righttrim(trim(mid(page,1330,7)))
em_d4.text = Righttrim(trim(mid(page,1340,7)))
em_d5.text = Righttrim(trim(mid(page,1350,7)))
em_d6.text = Righttrim(trim(mid(page,1360,7)))
em_d7.text = Righttrim(trim(mid(page,1370,7)))
em_d8.text = Righttrim(trim(mid(page,1380,7)))
em_d9.text = Righttrim(trim(mid(page,1390,7)))
em_d10.text = Righttrim(trim(mid(page,1400,7)))
em_d11.text = Righttrim(trim(mid(page,1410,7)))
em_d12.text = Righttrim(trim(mid(page,1420,7)))
em_d13.text = Righttrim(trim(mid(page,1430,7)))
em_d14.text = Righttrim(trim(mid(page,1440,7)))
em_d15.text = Righttrim(trim(mid(page,1450,7)))

mle_observ.text = Righttrim(trim(mid(page,1500,400)))
end subroutine

event open;var_code_local = message.doubleparm

string vn,vm 
date vd


select nom,prenom, date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vn) then
	vn = ""
end if


this.title = "Page N°3 : " + vn+ " " +vm+" - N° dossier : "+string(var_code_local)+ " - Date de naissance : " + string(vd) 


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()

end event

