global w_diagnos_maj_hernandez2 w_diagnos_maj_hernandez2

type variables
double var_code_local 
string page
end variables

event open;string sel,rc

var_code_local = var_code

dw_diag.settransobject(SQLCA)
dw_diag.retrieve(var_code_local)

string vn,vm 


select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if


this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"


end event

on w_diagnos_maj_hernandez2.create
this.ole_photo001=create ole_photo001
this.cb_imprimer=create cb_imprimer
this.cb_enregistrer=create cb_enregistrer
this.cb_annuler=create cb_annuler
this.cb_fermer=create cb_fermer
this.dw_diag=create dw_diag
this.Control[]={this.ole_photo001,&
this.cb_imprimer,&
this.cb_enregistrer,&
this.cb_annuler,&
this.cb_fermer,&
this.dw_diag}
end on

on w_diagnos_maj_hernandez2.destroy
destroy(this.ole_photo001)
destroy(this.cb_imprimer)
destroy(this.cb_enregistrer)
destroy(this.cb_annuler)
destroy(this.cb_fermer)
destroy(this.dw_diag)
end on

