global w_diagnos_maj_rouge1 w_diagnos_maj_rouge1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

sle_ante_gene.text = Righttrim(mid(page,1,40))
sle_ante_fami.text = Righttrim(mid(page,41,40))

ddlb_prati.selectitem(integer(mid(page,81,1)))

em_taille.text = Trim(mid(page,82,4))

ddlb_face.selectitem(integer(mid(page,86,1)))
ddlb_profil.selectitem(integer(mid(page,87,1)))
ddlb_hauteur.selectitem(integer(mid(page,88,1)))

em_particu.text = RightTrim(mid(page,89,21))

sle_agenesie.text = Righttrim(mid(page,110,40))
sle_dent_surnu.text = Righttrim(mid(page,150,20))
sle_dent_inclu.text = Righttrim(mid(page,170,15))
sle_dent_extr.text = Righttrim(mid(page,185,15))
sle_carie.text = Righttrim(mid(page,200,20))
sle_dysphasie.text = Righttrim(mid(page,220,15))
sle_prothese.text = Righttrim(mid(page,235,15))

ddlb_dens_sagi.selectitem(integer(mid(page,250,1)))
ddlb_sens_trav.selectitem(integer(mid(page,251,1)))
ddlb_sens_vert.selectitem(integer(mid(page,252,1)))
ddlb_mol_d.selectitem(integer(mid(page,253,1)))
ddlb_mol_g.selectitem(integer(mid(page,254,1)))
ddlb_can_d.selectitem(integer(mid(page,255,1)))
ddlb_can_g.selectitem(integer(mid(page,256,1)))
ddlb_frein_lev_sup1.selectitem(integer(mid(page,257,1)))
ddlb_frein_lev_sup2.selectitem(integer(mid(page,258,1)))
ddlb_frein_lev_inf1.selectitem(integer(mid(page,259,1)))
ddlb_frein_lev_inf2.selectitem(integer(mid(page,260,1)))
ddlb_frein_langue1.selectitem(integer(mid(page,261,1)))
ddlb_frein_langue2.selectitem(integer(mid(page,262,1)))
ddlb_plan_occlu.selectitem(integer(mid(page,263,1)))

em_bride.text = Trim(mid(page,264,18))

ddlb_respi.selectitem(integer(mid(page,282,1)))
ddlb_deglu.selectitem(integer(mid(page,283,1)))
ddlb_suceur.selectitem(integer(mid(page,284,1)))
ddlb_ony.selectitem(integer(mid(page,285,1)))
ddlb_bruxi.selectitem(integer(mid(page,286,1)))
ddlb_amyg.selectitem(integer(mid(page,287,1)))
ddlb_vege.selectitem(integer(mid(page,288,1)))
ddlb_langue_vol.selectitem(integer(mid(page,289,1)))
ddlb_langue_forme.selectitem(integer(mid(page,290,1)))
ddlb_levre_vol.selectitem(integer(mid(page,291,1)))
ddlb_levre_forme.selectitem(integer(mid(page,292,1)))

sle_remarque.text = Righttrim(mid(page,293,27))
sle_claque.text = Righttrim(mid(page,320,15))
sle_ressaut.text = Righttrim(mid(page,335,15))
sle_douleur.text = trim(mid(page,350,20))
sle_irradiation.text = Righttrim(mid(page,370,20))

ddlb_ch_ferme.selectitem(integer(mid(page,390,1)))

sle_amplitude.text = Righttrim(mid(page,391,9))
sle_prema.text = Righttrim(mid(page,400,15))

ddlb_phone.selectitem(integer(mid(page,416,1)))
ddlb_paro.selectitem(integer(mid(page,417,1)))
ddlb_hygiene.selectitem(integer(mid(page,418,1)))
end subroutine

event open;
var_code_local = message.doubleparm

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

string vn,vm 

select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

this.title = "Page N°1 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()


end event

