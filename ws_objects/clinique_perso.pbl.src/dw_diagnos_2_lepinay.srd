 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"diagnos~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"diagnos.code~") COLUMN(NAME=~"diagnos.bgs5~") COLUMN(NAME=~"diagnos.bgs6~") COLUMN(NAME=~"diagnos.bgs7~") COLUMN(NAME=~"diagnos.bgs8~") COLUMN(NAME=~"diagnos.bgi5~") COLUMN(NAME=~"diagnos.bgi6~") COLUMN(NAME=~"diagnos.bgi7~") COLUMN(NAME=~"diagnos.bgi8~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"diagnos.code~" )WHERE(    EXP1 =~"~~~"diagnos~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " update="diagnos" updatewhere=0 updatekeyinplace=no arguments=(("nocode", number)) )
