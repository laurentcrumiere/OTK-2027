global w_diagnos_maj_lapouyade3 w_diagnos_maj_lapouyade3

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();
modif = false

em_d1.text = RightTrim(mid(page,1910,7))
em_d2.text = RightTrim(mid(page,1920,7))
em_d3.text = RightTrim(mid(page,1930,7))
em_d4.text = RightTrim(mid(page,1940,7))
em_d5.text = RightTrim(mid(page,1950,7))

em_axe_mesures.text = RightTrim(mid(page,1960,3))
em_axe1.text = RightTrim(mid(page,1963,3))
em_axe_dolicho.text = RightTrim(mid(page,1966,1))
em_axe_meso.text = RightTrim(mid(page,1967,1))
em_axe_brachy.text = RightTrim(mid(page,1968,1))

em_plan_mesures.text = RightTrim(mid(page,1970,2))
em_plan1.text = RightTrim(mid(page,1972,2))
em_plan_dolicho.text = RightTrim(mid(page,1974,1))
em_plan_meso.text = RightTrim(mid(page,1975,1))
em_plan_brachy.text = RightTrim(mid(page,1976,1))

em_angle_mesures.text = RightTrim(mid(page,1980,2))
em_angle1.text = RightTrim(mid(page,1982,2))
em_angle_dolicho.text = RightTrim(mid(page,1984,1))
em_angle_meso.text = RightTrim(mid(page,1985,1))
em_angle_brachy.text = RightTrim(mid(page,1986,1))

em_hfi_mesures.text = RightTrim(mid(page,1990,2))
em_hfi1.text = RightTrim(mid(page,1992,2))
em_hfi_dolicho.text = RightTrim(mid(page,1994,1))
em_hfi_meso.text = RightTrim(mid(page,1995,1))
em_hfi_brachy.text = RightTrim(mid(page,1996,1))

em_hft_mesures.text = RightTrim(mid(page,2000,2))
em_hft1.text = RightTrim(mid(page,2002,2))
em_hft_dolicho.text = RightTrim(mid(page,2004,1))
em_hft_meso.text = RightTrim(mid(page,2005,1))
em_hft_brachy.text = RightTrim(mid(page,2006,1))

em_arc_mesures.text = RightTrim(mid(page,2010,2))
em_arc1.text = RightTrim(mid(page,2012,2))
em_arc_dolicho.text = RightTrim(mid(page,2014,1))
em_arc_meso.text = RightTrim(mid(page,2015,1))
em_arc_brachy.text = RightTrim(mid(page,2016,1))

em_convexe_mesures.text = RightTrim(mid(page,2020,2))
em_imm_mesures.text = RightTrim(mid(page,2025,2))
em_ideg_mesures.text = RightTrim(mid(page,2030,2))
em_ptv_mesures.text = RightTrim(mid(page,2035,2))

mle_diagnostic.text = RightTrim(mid(page,2100,300))
mle_commentaires.text = RightTrim(mid(page,2400,400))


end subroutine

event open;var_code_local = message.doubleparm


string vn
date vd

select  trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vd) then
	vd = Today()
end if


this.title = "Page N°3 : "+vn+ " - Date de naissance : " + string(vd,"dd/mm/yyyy") +" - N° dossier : "+string(var_code_local)

//init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

init()

end event

