type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_axe_mesures.text = RightTrim(mid(page,410,3))
em_axe1.text = RightTrim(mid(page,413,3))
