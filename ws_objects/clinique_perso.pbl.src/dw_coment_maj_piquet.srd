table(column=(type=date update=yes updatewhereclause=yes name=dat dbname="coment.dat" dbalias=".dat" initial="today()" )
 column=(type=char(1) update=yes updatewhereclause=yes name=radios_o dbname="coment.radios_o" dbalias=".radios_o" initial="N" values="	O/	n" )
 column=(type=char(1) update=yes updatewhereclause=yes name=radios_h dbname="coment.radios_h" dbalias=".radios_h" initial="N" values="	O/	N" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=ordre dbname="coment.ordre" dbalias=".ordre" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=coul_texte dbname="coment.coul_texte" dbalias=".coul_texte" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=coul_fond dbname="coment.coul_fond" dbalias=".coul_fond" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="coment.code" dbalias=".code" )
 column=(type=char(100) update=yes updatewhereclause=yes name=hygiene_v10 dbname="coment.hygiene_v10" dbalias=".hygiene_v10" )
 column=(type=char(100) update=yes updatewhereclause=yes name=elastique_v10 dbname="coment.elastique_v10" dbalias=".elastique_v10" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com_html dbname="coment.com_html" dbalias=".com_html" values="Absent	Absent/Excusé	Excusé/Ordonnance Télé Pano	Ordonnance Télé Pano/TA - Photos	TA - Photos/Explications bilan	Explications bilan/Emp appareil	Emp appareil/Mise en bouche appareil	Mise en bouche appareil/Pose Multiattache haut	Pose Multiattache haut/Pose Multiattache bas	Pose Multiattache bas/FEO	FEO/Quad'helix	Quad'helix/TIM II	TIM II/TIM III	TIM III/Contrôle	Contrôle/Activation	Activation/" validation="len(trim(gettext())) > 0 and not(isnull(gettext()))" validationmsg="~"Vous ne pouvez pas enregistrer de commentaire vierge !~"" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=acte_prevu_html dbname="coment.acte_prevu_html" dbalias=".acte_prevu_html" values="Faire bilan	Faire bilan/Multiattache haut	Multiattache haut/Multiattache bas	Multiattache bas/Empreinte	Empreinte/Quad'helix	Quad'helix/FEO	FEO/TIM	TIM/Arc d'alignement	Arc d'alignement/Arc d'ingression	Arc d'ingression/Arc de retraction	Arc de retraction/Arc d'expansion	Arc d'expansion/Arc de finition	Arc de finition/Debaguer	Debaguer/" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_modif dbname="coment.date_modif" dbalias=".date_modif" initial="today" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="coment.user_modif" dbalias=".user_modif" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com dbname="coment.com" dbalias=".com" initial="null" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=acte_prevu dbname="coment.acte_prevu" dbalias=".acte_prevu" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coment~" ) COLUMN(NAME=~"coment.dat~") COLUMN(NAME=~"coment.radios_o~") COLUMN(NAME=~"coment.radios_h~") COLUMN(NAME=~"coment.ordre~") COLUMN(NAME=~"coment.coul_texte~") COLUMN(NAME=~"coment.coul_fond~") COLUMN(NAME=~"coment.code~") COLUMN(NAME=~"coment.hygiene_v10~") COLUMN(NAME=~"coment.elastique_v10~") COLUMN(NAME=~"coment.com_html~") COLUMN(NAME=~"coment.acte_prevu_html~") COLUMN(NAME=~"coment.date_modif~") COLUMN(NAME=~"coment.user_modif~") COLUMN(NAME=~"coment.com~") COLUMN(NAME=~"coment.acte_prevu~")WHERE(    EXP1 =~"( ~~~"coment~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode )~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " update="coment" updatewhere=1 updatekeyinplace=yes arguments=(("nocode", number))  sort="dat A nocode A " )
