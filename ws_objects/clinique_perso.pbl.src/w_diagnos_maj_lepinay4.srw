type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

mle_ant_gene.text = Righttrim(trim(mid(page,1,200)))
mle_ant_fami.text = Righttrim(trim(mid(page,201,150)))

em_classe.text = Righttrim(trim(mid(page,351,3)))
em_contact.text = Righttrim(trim(mid(page,355,1)))
em_hygiene.text = Righttrim(trim(mid(page,356,1)))

mle_face.text = Righttrim(trim(mid(page,360,100)))
mle_profil.text = Righttrim(trim(mid(page,460,100)))

em_aml.text = Righttrim(trim(mid(page,560,1)))
em_sml.text = Righttrim(trim(mid(page,561,1)))
em_angle.text = Righttrim(trim(mid(page,562,1)))
em_competence.text = Righttrim(trim(mid(page,563,1)))

mle_commentaire1.text = Righttrim(trim(mid(page,570,100)))

sle_agenesie.text = Righttrim(trim(mid(page,670,20)))
sle_retenue.text = Righttrim(trim(mid(page,690,20)))
sle_frein.text = Righttrim(trim(mid(page,710,20)))

mle_paro.text = Righttrim(trim(mid(page,730,100)))
sle_recession.text = Righttrim(trim(mid(page,830,20)))

em_6d.text = Righttrim(trim(mid(page,850,4)))
em_6g.text = Righttrim(trim(mid(page,855,4)))
em_3d.text = Righttrim(trim(mid(page,860,4)))
em_3g.text = Righttrim(trim(mid(page,865,4)))
em_oj.text = Righttrim(trim(mid(page,870,4)))
em_ob.text = Righttrim(trim(mid(page,875,4)))

em_milieux.text = Righttrim(trim(mid(page,880,20)))
sle_inverse.text = Righttrim(trim(mid(page,1000,20)))

em_enc_ant.text = Righttrim(trim(mid(page,1020,3)))
em_moyen.text = Righttrim(trim(mid(page,1025,3)))

mle_commentaire2.text = Righttrim(trim(mid(page,1030,100)))

em_deglutition.text = Righttrim(trim(mid(page,1130,1)))
em_phonation.text = Righttrim(trim(mid(page,1131,1)))
em_respiration.text = Righttrim(trim(mid(page,1132,1)))
em_succion.text = Righttrim(trim(mid(page,1133,1)))

em_claquements.text = Righttrim(trim(mid(page,1140,10)))
em_douleurs.text = Righttrim(trim(mid(page,1150,10)))
em_of.text = Righttrim(trim(mid(page,1160,25)))
mle_commentaire3.text = Righttrim(trim(mid(page,1190,100)))

ddlb_dentaire.selectitem(integer(mid(page,1290,1)))
ddlb_endoalveolie.selectitem(integer(mid(page,1291,1)))


end subroutine

event open;
var_code_local = message.doubleparm

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

string vn,vm 
select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

this.title = "Page N°4 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"

init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

init()

// place la window ds la mdi -> confort utilisateur
mep_win_mdi(this,1)
end event

