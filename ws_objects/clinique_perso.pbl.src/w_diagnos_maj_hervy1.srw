integer height = 180
integer taborder = 360
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Enregistrer"
end type

event clicked;place_avec_blancs(mle_motif_consult.text,page,1,100)

place(string(ddlb_etat_gene.FindItem(ddlb_etat_gene.text,1)),page,101)
place(string(ddlb_etat_dent.finditem(ddlb_etat_dent.text,1)),page,102)
