uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine save ()
public subroutine init ()
end prototypes

public subroutine save ();f.ecrirepage(em_date1,page,130,10)
f.ecrirepage(em_date2,page,140,10)
f.ecrirepage(em_date3,page,150,10)
f.ecrirepage(em_date4,page,160,10)
f.ecrirepage(em_date5,page,170,10)
f.ecrirepage(em_date6,page,180,10)
f.ecrirepage(em_date7,page,190,10)
f.ecrirepage(em_date8,page,200,10)
f.ecrirepage(em_date9,page,210,10)
f.ecrirepage(em_date10,page,220,10)
f.ecrirepage(em_date11,page,230,10)
f.ecrirepage(em_date12,page,240,10)		//carac max = 250



UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

public subroutine init ();f.lirepage(em_date1,page,130,10)
f.lirepage(em_date2,page,140,10)
f.lirepage(em_date3,page,150,10)
f.lirepage(em_date4,page,160,10)
f.lirepage(em_date5,page,170,10)
f.lirepage(em_date6,page,180,10)
f.lirepage(em_date7,page,190,10)
f.lirepage(em_date8,page,200,10)
f.lirepage(em_date9,page,210,10)
f.lirepage(em_date10,page,220,10)
f.lirepage(em_date11,page,230,10)
f.lirepage(em_date12,page,240,10)		//carac max = 250



modif = false
cb_fermer.setfocus()

end subroutine

