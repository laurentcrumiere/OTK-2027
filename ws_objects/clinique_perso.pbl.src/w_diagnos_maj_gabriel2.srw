type cb_1 from commandbutton within w_diagnos_maj_gabriel2
integer x = 3483
integer y = 1560
integer width = 823
integer height = 120
integer taborder = 380
boolean bringtotop = true
integer textsize = -8
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "Récupération date de moulage"
end type

event clicked;date	date_moulage
string	date_formatee


// recup date moulage
select date_moulage into :date_moulage from patient where code = :var_code_local ;

if not isnull( date_moulage ) then
	// on formate la date en string
	date_formatee = string( date_moulage, "dd/mm/yyyy" )
	
	// on l'applique au 15 premiers cadres
	em_1.text = date_formatee
	em_2.text = date_formatee
	em_4.text = date_formatee
	em_3.text = date_formatee
	em_7.text = date_formatee
	em_8.text = date_formatee
	em_11.text = date_formatee
	em_12.text = date_formatee
	em_13.text = date_formatee
	em_14.text = date_formatee
	em_20.text = date_formatee
	em_21.text = date_formatee
	em_22.text = date_formatee
	em_23.text = date_formatee
	em_24.text = date_formatee
end if

end event

