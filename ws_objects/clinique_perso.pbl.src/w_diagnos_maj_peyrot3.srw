// -> max carac = 2270 depuis 26/5/2003 (cf page n°1)

cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(em_date1,page,1770,10)
f.ecrirepage(em_date2,page,1780,10)
