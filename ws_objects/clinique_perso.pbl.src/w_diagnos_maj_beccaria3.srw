f.lirepage(em_date_15,page,2290,10)
f.lirepage(em_date_16,page,2300,10)
f.lirepage(em_date_17,page,2310,10)
f.lirepage(em_date_18,page,2320,10)
f.lirepage(em_date_19,page,2330,10)
f.lirepage(em_date_20,page,2340,10)
f.lirepage(em_date_21,page,2350,10)

f.lirepage(mle_notes,page,2360,400)		//max carac = 2800

modif = false
cb_fermer.setfocus()
end subroutine

event open;//page N°3 à partir du 27/12/2001

var_code_local = message.doubleparm
string vn
date vd

select  trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vd) then
	vd = Today()
end if


this.title = "Page N°3 : "+vn+ " - Date de naissance : " + string(vd,"dd/mm/yyyy") +" - N° dossier : "+string(var_code_local)

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

init()
mep_win_mdi(this,1)

end event

