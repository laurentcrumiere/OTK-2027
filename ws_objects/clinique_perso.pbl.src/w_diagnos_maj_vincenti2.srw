global w_diagnos_maj_vincenti2 w_diagnos_maj_vincenti2

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();string rem,pt


SELECT remarques INTO :rem FROM diagnos WHERE code = :var_code_local ;
SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;


modif = false

if mid(page,1330,1) = 'O' then
	cbx_ds1.checked = true
end if
if mid(page,1331,1) = 'O' then
	cbx_ds2.checked = true
end if
if mid(page,1332,1) = 'O' then
	cbx_ds3.checked = true
end if
if mid(page,1333,1) = 'O' then
	cbx_ds4.checked = true
end if

sle_agenesie.text = RightTrim(mid(page,1340,40))
sle_surnum.text = RightTrim(mid(page,1400,40))

mle_plan_traitement.text = pt
mle_remarques.text = rem

end subroutine

event open;var_code_local = message.doubleparm

dw_diag.settransobject(SQLCA)
dw_diag.retrieve(var_code_local)

string vn,vm 

select nom,moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if


this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+  " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

init()

end event

