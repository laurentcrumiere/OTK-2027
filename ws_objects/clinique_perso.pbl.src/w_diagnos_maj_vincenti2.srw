type cb_enregistrer from commandbutton within w_diagnos_maj_vincenti2
integer x = 2930
integer y = 2036
integer width = 338
integer height = 96
integer taborder = 110
integer textsize = -8
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Enregistrer"
end type

event clicked;string rem,pt

if cbx_ds1.checked then
	place("O",page,1330)
else
	place("N",page,1330)
end if
if cbx_ds2.checked then
	place("O",page,1331)
else
	place("N",page,1331)
end if
if cbx_ds3.checked then
	place("O",page,1332)
else
	place("N",page,1332)
end if
if cbx_ds4.checked then
	place("O",page,1333)
else
	place("N",page,1333)
end if


place_avec_blancs(sle_agenesie.text,page,1340,40)
place_avec_blancs(sle_surnum.text,page,1400,40)

pt = mle_plan_traitement.text
rem = mle_remarques.text

UPDATE diagnos SET perso = :page,remarques = :rem WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
	else
	UPDATE patient SET plan_traitement = :pt WHERE code = :var_code_local ;
	if SQLCA.Sqlcode <> 0 then
		son(4)
		Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
	else
		if dw_diag.update () <> 1 THEN
			son(4)
			Messagebox("ERREUR BASE DE DONNEES (N°3)",SQLCA.SqlErrText)
		else	
			modif = false
			COMMIT ;
		end if		
	end if
end if
end event

