string picturename = "ar_left.bmp"
vtextalign vtextalign = vcenter!
end type

event clicked;if modif then
	if MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre sans enregistrer ?",Question!,YesNo!) = 1 then
	If ui_v2020 then 
		OpenWithParm( w_diagnos_maj_houllier4, var_code_local, "w_diagnos_maj_houllier4", w_mdi_2020)
	else
		OpenSheetWithParm( w_diagnos_maj_houllier4, var_code_local, "w_diagnos_maj_houllier4", w_mdi, 0, Original!)
	end if	
		Close(parent)
	end if
else
	If ui_v2020 then 
		OpenWithParm( w_diagnos_maj_houllier4, var_code_local, "w_diagnos_maj_houllier4", w_mdi_2020)
	else
		OpenSheetWithParm( w_diagnos_maj_houllier4, var_code_local, "w_diagnos_maj_houllier4", w_mdi, 0, Original!)
	end if	
	close(parent)
end if

end event

