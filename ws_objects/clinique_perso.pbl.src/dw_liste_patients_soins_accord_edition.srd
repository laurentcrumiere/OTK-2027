table(column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" )
 column=(type=date update=yes updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_dentiste dbname="patient.code_dentiste" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" initial="null" )
 column=(type=decimal(0) updatewhereclause=yes name=soins_numero dbname="soins.numero" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" )
 column=(type=date updatewhereclause=yes name=soins_date_accord dbname="soins.date_accord" initial="null" )
 column=(type=date updatewhereclause=yes name=soins_date_min dbname="soins.date_min" )
 column=(type=date updatewhereclause=yes name=date_soin_suivant dbname="date_soin_suivant" )
 column=(type=char(1) updatewhereclause=yes name=soin_suivant dbname="table_vide.v1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"patient.code_dentiste~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"soins.date_accord~") COMPUTE(NAME=~"~~~"soins~~~".~~~"date_demande~~~"  as date_min~") COMPUTE(NAME=~"(select min(~~~"soins~~~".~~~"date_demande~~~") as date_soin_suivant FROM ~~~"soins~~~" where ~~~"soins~~~".~~~"date_demande~~~" > date_min and ~~~"soins~~~".~~~"code~~~" = ~~~"patient~~~".~~~"code~~~")~") COLUMN(NAME=~"table_vide.v1~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_accord~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date))  sort="nom A prenom A soins_date_demande A " )
