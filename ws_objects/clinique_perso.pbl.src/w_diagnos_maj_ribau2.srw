public subroutine init ();f.lirepage(em_datephoto1,page,1200,10)
f.lirepage(em_datephoto2,page,1210,10)
f.lirepage(em_datephoto3,page,1220,10)
f.lirepage(em_datephoto4,page,1230,10)
f.lirepage(em_datephoto5,page,1240,10)
