type dw_diag from datawindow within w_diagnos_maj_hodin1
boolean visible = false
integer x = 2336
integer y = 224
integer width = 997
integer height = 852
boolean bringtotop = true
string title = "none"
string dataobject = "dw_diagnostic_affichage"
boolean vscrollbar = true
boolean livescroll = true
borderstyle borderstyle = stylelowered!
end type

event rbuttondown;this.visible = FALSE
end event

event clicked;If row > 0 Then
	This.SelectRow(0,False)
	This.SelectRow(row,True)
End If

end event

event doubleclicked;// Si tout le texte dans la zone "Diagnostic" est sélectionné 
// Alors on remplace tout et on met le diagnostic cliqué
// Sinon si rien sélectionné
//			alors rajouter à la suite le diagnostic
//			sinon si début de texte sélectionné
//					alors on remet la fin du texte + le diagnostic cliqué
//					sinon (fin de texte sélectionné) on remet le début du texte + le diagnostic cliqué

string texte ,  texte_diag , texte_final
string texte_selectionne
char c = "~n"
char r = "~r"

dw_diagnostic.accepttext()

if this.rowcount() > 0 then

	texte = this.GetItemString(this.GetRow(),"texte")
	texte_diag =dw_diagnostic.GetItemString(dw_diagnostic.GetRow(),"traitement_effectue")
	
	
	texte_selectionne = dw_diagnostic.SelectedText()
	
	IF texte_diag = texte_selectionne OR IsNull(texte_diag)THEN
		texte_final = texte
	ELSE	
		IF texte_selectionne = ""  THEN
			texte_final = texte_diag + r + c + texte	
		ELSE	
			IF pos(texte_diag,texte_selectionne) = 1 THEN
				texte_final = Mid(texte_diag ,len(texte_selectionne) + 1) + r + c + texte
			ELSE	
				texte_final = Mid(texte_diag ,1,(pos(texte_diag,texte_selectionne) - 1 )) + r + c + texte
			END IF
		END IF		
	END IF	
	
	dw_diagnostic.SetItem(dw_diagnostic.GetRow(),"traitement_effectue",texte_final)
	
end if

this.visible = FALSE


