type dw_plan from datawindow within w_diagnos_maj_hodin1
boolean visible = false
integer x = 2336
integer y = 960
integer width = 997
integer height = 852
boolean bringtotop = true
string title = "none"
string dataobject = "dw_plan_ttt_affichage"
boolean vscrollbar = true
boolean livescroll = true
borderstyle borderstyle = stylelowered!
end type

event rbuttondown;this.visible = FALSE
end event

event clicked;If row > 0 Then
	This.SelectRow(0,False)
	This.SelectRow(row,True)
End If

end event

event doubleclicked;
//string texte
//
//texte = dw_plan.GetItemString(this.GetRow(),"texte")
//dw_traitement.SetItem(dw_traitement.GetRow(),"plan_traitement",texte)
//
//
//this.visible = FALSE


// Si tout le texte dans la zone "Plan de traitement" est sélectionné 
// Alors on remplace tout et on met le plan de traitement cliqué
// Sinon si rien sélectionné
//			alors rajouter à la suite le plan de traitement
//			sinon si début de texte sélectionné
//					alors on remet la fin du texte + le plan de traitement cliqué
//					sinon (fin de texte sélectionné) on remet le début du texte + le plan de traitement cliqué


string texte ,  texte_plan , texte_final
string texte_selectionne
char c = "~n"
char r = "~r"

dw_diagnostic.accepttext()

if this.rowcount() > 0 then
		
	texte = dw_plan.GetItemString(this.GetRow(),"texte") 
	texte_plan = dw_diagnostic.GetItemString(dw_diagnostic.GetRow(),"plan_traitement")
	
	texte_selectionne = dw_diagnostic.SelectedText()
	
	IF texte_plan = texte_selectionne OR IsNull(texte_plan) THEN
		texte_final = texte
	ELSE	
		IF texte_selectionne = "" THEN
			texte_final = texte_plan + r + c + texte	
		ELSE	
			IF pos(texte_plan,texte_selectionne) = 1 THEN
				texte_final = Mid(texte_plan ,len(texte_selectionne) + 1) + r + c + texte
			ELSE
				texte_final = Mid(texte_plan ,1,(pos(texte_plan,texte_selectionne) - 1 )) + r + c + texte
			END IF	
		END IF	
	END IF	
	
	dw_diagnostic.SetItem(dw_diagnostic.GetRow(),"plan_traitement",texte_final)
	
end if

this.visible = FALSE











