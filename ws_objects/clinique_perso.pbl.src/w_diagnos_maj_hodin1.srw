type variables
double var_code_local 
string page
boolean modif
uo_fx_pages_cliniques f
end variables

forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lirepage(em_axe_mesures,page,1,3)
f.lirepage(em_plan_mesures,page,4,3)
f.lirepage(em_angle_mesures,page,7,3)
f.lirepage(em_hfi_mesures,page,10,3)
//f.lirepage(em_hft_mesures,page,13,3)
f.lirepage(em_arc_mesures,page,16,3)
f.lirepage(em_convexe_mesures,page,19,3)
f.lirepage(em_imm_mesures,page,22,3)
f.lirepage(em_ideg_mesures,page,25,3)
f.lirepage(em_ptv_mesures,page,28,3)
f.lirepage(em_levre_inf,page,31,3)

f.lirepage(ddlb_deglu,page,34,1)
f.lirepage(ddlb_interpos,page,35,1)

f.lirepage(mle_1,page,36,300)

//string pt,diag
//SELECT plan_traitement,traitement_effectue INTO :pt,:diag FROM patient WHERE code = :var_code_local ;
//mle_diag_cephal.text=diag
//mle_plan_traitement.text=pt

modif = false
cb_fermer.setfocus()


dw_diagnostic.SetTransObject(SQLCA)
dw_diagnostic.Retrieve(var_code_local)



end subroutine

public subroutine save ();f.ecrirepage(em_axe_mesures,page,1,3)
f.ecrirepage(em_plan_mesures,page,4,3)
f.ecrirepage(em_angle_mesures,page,7,3)
f.ecrirepage(em_hfi_mesures,page,10,3)
//f.ecrirepage(em_hft_mesures,page,13,3)
f.ecrirepage(em_arc_mesures,page,16,3)
f.ecrirepage(em_convexe_mesures,page,19,3)
f.ecrirepage(em_imm_mesures,page,22,3)
f.ecrirepage(em_ideg_mesures,page,25,3)
f.ecrirepage(em_ptv_mesures,page,28,3)
f.ecrirepage(em_levre_inf,page,31,3)

f.ecrirepage(ddlb_deglu,page,34,1)
f.ecrirepage(ddlb_interpos,page,35,1)

f.ecrirepage(mle_1,page,36,300)



UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

commit ;

dw_diagnostic.accepttext()

// Mise à jour des zones pour myOrthokis
dw_diagnostic.setItem(1, "patient_traitement_effectue_html", dw_diagnostic.getitemString(1, "texte_brut_traitement_effectue"))
dw_diagnostic.setItem(1, "patient_plan_traitement_html", dw_diagnostic.getitemString(1, "texte_brut_plan_traitement"))

if dw_diagnostic.update() = 1 then
	commit ;
	if sqlca.sqlcode <> 0 then
		Messagebox("ERREUR DANS LA MISE A JOUR N°"+string(sqlca.sqlcode),sqlca.sqlerrtext)
	end if
else
	rollback ;
end if




//if SQLCA.Sqlcode <> 0 then
//	son(4)
//	Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
//else
//	UPDATE patient SET plan_traitement = :pt WHERE code = :var_code_local ;
//	UPDATE patient SET traitement_effectue = :diag WHERE code = :var_code_local ;
//	if SQLCA.Sqlcode <> 0 then
//		son(4)
//		Messagebox("ERREUR BASE DE DONNEES (N°3)",SQLCA.SqlErrText)
//	else
//		modif = false
//		COMMIT ;
//	end if
//end if
end subroutine

event open;var_code_local = message.doubleparm

string vn,vm 
date vd
integer an, v_mois
double nd

select nom,moulage,date_naissance, numero_dossier INTO :vn,:vm,:vd, :nd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	v_mois = month(today()) - month( vd ) +12
ELSE
	v_mois = month(today()) - month( vd )
END IF

this.title = "Page Clinique N°1 : "+vn+" - N° dossier : "+string(nd)+ " - Age : " + string(an) + " ans " + string(v_mois) + " v_mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

//charge tout ce qui va bien
init()
centrer(this)

dw_plan.settransobject(SQLCA)
dw_diag.settransobject(SQLCA)


end event

