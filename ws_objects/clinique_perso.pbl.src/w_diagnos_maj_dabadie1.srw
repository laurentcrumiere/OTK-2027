em_bg21.text = mid(page,580,4)
em_bg22.text = mid(page,584,4)
em_bg23.text = mid(page,588,4)
em_bg24.text = mid(page,592,4)

modif = false


end subroutine

event open;
var_code_local = message.doubleparm

string vn
date vd

select  trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vd) then
	vd = Today()
end if


this.title = "Page N°1 : "+vn+ " - Date de naissance : " + string(vd,"dd/mm/yyyy") +" - N° dossier : "+string(var_code_local)

init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()
mep_win_mdi(this,1)

end event

