global w_diagnos_maj_dabadie1 w_diagnos_maj_dabadie1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();ddlb_respiration.selectitem(integer(mid(page,1,1)))
ddplb_deglutition.selectitem(integer(mid(page,2,1)))
ddplb_phonation.selectitem(integer(mid(page,3,1)))
if mid(page,4,1) = 'O' then
	cbx_suceur.checked = true
else
	cbx_suceur.checked = false
end if
if mid(page,5,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page,6,1) = 'O' then
	cbx_bruxisme.checked = true
else	
	cbx_bruxisme.checked = false
end if

ddlb_amygdales.selectitem(integer(mid(page,7,1)))
ddlb_vegetations.selectitem(integer(mid(page,8,1)))
ddlb_langue.selectitem(integer(mid(page,9,1)))

if mid(page,10,1) = 'O' then
	cbx_douleur.checked = true
else
	cbx_douleur.checked = false
end if
if mid(page,11,1) = 'O' then
	cbx_craquement.checked = true
else
	cbx_craquement.checked = false
end if
if mid(page,12,1) = 'O' then
	cbx_ressaut.checked = true
else
	cbx_ressaut.checked = false
end if
ddlb_chemin.selectitem(integer(mid(page,13,1)))
ddplb_amplitude.selectitem(integer(mid(page,14,1)))

sle_prematurites.text = Righttrim(mid(page,15,30))
mle_paro.text = Righttrim(mid(page,45,150))

if mid(page,200,1) = 'O' then
	cbx_langue.checked = true
else
	cbx_langue.checked = false
end if
if mid(page,201,1) = 'O' then
	cbx_levre_sup.checked = true
else
	cbx_levre_sup.checked = false
end if
if mid(page,202,1) = 'O' then
	cbx_levre_inf.checked = true
else
	cbx_levre_inf.checked = false
end if

em_d1.text = trim(mid(page,210,10))
em_d2.text = trim(mid(page,220,10))
em_d3.text = trim(mid(page,230,10))
em_d4.text = trim(mid(page,240,10))
em_d5.text = trim(mid(page,250,10))
em_d6.text = trim(mid(page,260,10))
em_d7.text = trim(mid(page,270,10))
em_d8.text = trim(mid(page,280,10))


mle_col1.text = RightTrim(mid(page,300,21))
mle_col2.text = RightTrim(mid(page,321,21))
mle_col3.text = RightTrim(mid(page,342,21))
mle_col4.text = RightTrim(mid(page,363,21))
mle_col5.text = RightTrim(mid(page,384,21))
mle_col6.text = RightTrim(mid(page,405,21))
mle_col7.text = RightTrim(mid(page,426,21))
mle_col8.text = RightTrim(mid(page,447,21))

em_bg1.text = mid(page,500,4)
em_bg2.text = mid(page,504,4)
em_bg3.text = mid(page,508,4)
em_bg4.text = mid(page,512,4)
em_bg5.text = mid(page,516,4)
em_bg6.text = mid(page,520,4)
em_bg7.text = mid(page,524,4)
em_bg8.text = mid(page,528,4)
em_bg9.text = mid(page,532,4)
em_bg10.text = mid(page,536,4)
em_bg11.text = mid(page,540,4)
em_bg12.text = mid(page,544,4)
em_bg13.text = mid(page,548,4)
em_bg14.text = mid(page,552,4)
em_bg15.text = mid(page,556,4)
