end type

event clicked;long Job

Job = PrintOpen( )
parent.Print ( job, 0, 0)
PrintClose(Job)
end event

type pb_1 from picturebutton within w_diagnos_maj_leonard2
integer x = 2533
integer y = 1708
integer width = 137
integer height = 112
integer taborder = 290
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "ar_right.bmp"
vtextalign vtextalign = vcenter!
end type

event clicked;if modif then
	if MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre sans enregistrer ?",Question!,YesNo!) = 1 then
		if ui_v2020 then
			OpenWithParm( w_diagnos_maj_leonard1, var_code_local, w_mdi_2020)
		else	
			OpenSheetWithParm(w_diagnos_maj_leonard1,var_code_local,w_mdi,1,Original!)
		end if
		Close(parent)
	end if
else
	if ui_v2020 then
		OpenWithParm( w_diagnos_maj_leonard1, var_code_local, w_mdi_2020)
	else	
		OpenSheetWithParm(w_diagnos_maj_leonard1,var_code_local,w_mdi,1,Original!)
	end if
	close(parent)
end if

end event

