date	ld_date_naiss
string	lstr_nom_prati


select	prati.nom , date_naissance
into	:lstr_nom_prati , :ld_date_naiss
from	prati , patient
where	code_praticien = prati.code
and	patient.code = :var_code_local ;

if isnull(lstr_nom_prati) then lstr_nom_prati = ""
st_39.text = lstr_nom_prati

if isnull(ld_date_naiss) then
	st_38.text = "00/00/0000"
else
	st_38.text = string(ld_date_naiss)
end if

end subroutine

