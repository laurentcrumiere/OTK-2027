type variables
double var_code_local 
boolean modif
string page
uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lirepage(mle_remarques,page,3200,300)

f.lirepage(mle_col1,page,3500,57)
f.lirepage(mle_col2,page,3600,57)
f.lirepage(mle_col3,page,3700,57)
f.lirepage(mle_col4,page,3800,57)

f.lirepage(em_d1,page,3900,10)
f.lirepage(em_d2,page,3910,10)
f.lirepage(em_d3,page,3920,10)
f.lirepage(em_d4,page,3930,10)	//max carc = 3940


cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(mle_remarques,page,3200,300)

f.ecrirepage(mle_col1,page,3500,57)
f.ecrirepage(mle_col2,page,3600,57)
f.ecrirepage(mle_col3,page,3700,57)
f.ecrirepage(mle_col4,page,3800,57)

f.ecrirepage(em_d1,page,3900,10)
f.ecrirepage(em_d2,page,3910,10)
f.ecrirepage(em_d3,page,3920,10)
f.ecrirepage(em_d4,page,3930,10)	//max carc = 3940

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

