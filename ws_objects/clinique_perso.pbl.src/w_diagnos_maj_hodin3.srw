end type
global w_diagnos_maj_hodin3 w_diagnos_maj_hodin3

type variables
double var_code_local 
string page
boolean modif
uo_fx_pages_cliniques f
end variables

forward prototypes
public subroutine save ()
public subroutine init ()
end prototypes

public subroutine save ();f.ecrirepage(mle_diag_cephal,page,1000,500)


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°2)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if
end subroutine

public subroutine init ();f.lirepage(mle_diag_cephal,page,1000,500)

modif = false
cb_fermer.setfocus()
end subroutine

event open;var_code_local = message.doubleparm

string vn,vm 
date vd
integer an, mois

select nom,moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page Clinique N°3 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

//charge tout ce qui va bien
init()
centrer(this)

end event

