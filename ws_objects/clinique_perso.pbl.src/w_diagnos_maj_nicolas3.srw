public subroutine load_ctrls ();f.lirepage(mle_1,page_buffer[1],3700,200)
f.lirepage(sle_1,page_buffer[1],3900,50)
f.lirepage(mle_2,page_buffer[1],3950,300)
f.lirepage(mle_3,page_buffer[1],4250,2000)
