//f.ecrirepage(mle_diagnostic,page_buffer[2],2431,1032)

// Nouveau Max Carac suite modification du 17/04/2020
// max carac = 2481


string lstr_diag, lstr_diag_rtf

lstr_diag = mle_diagnostic.text
lstr_diag_rtf = string_to_rtf(lstr_diag,couleur_noire,couleur_blanche)


// Mise à jour du Diagnostic
Update patient
Set traitement_effectue_html = :lstr_diag, traitement_effectue = :lstr_diag_rtf
Where patient.code = :var_code_local ;
commit ;

end subroutine

