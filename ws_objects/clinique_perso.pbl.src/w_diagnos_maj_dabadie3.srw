global w_diagnos_maj_dabadie3 w_diagnos_maj_dabadie3

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zooma
string page
end variables

event open;var_code_local = message.doubleparm
string vn
date vd

select  trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vd) then
	vd = Today()
end if


this.title = "Page N°2 : "+vn+ " - Date de naissance : " + string(vd,"dd/mm/yyyy") +" - N° dossier : "+string(var_code_local)

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

mep_win_mdi(this,1)

end event

