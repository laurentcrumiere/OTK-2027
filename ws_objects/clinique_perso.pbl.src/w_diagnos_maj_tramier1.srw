f.lirepage(em_31,page_buffer[1],1625,3)
f.lirepage(em_32,page_buffer[1],1628,3)
f.lirepage(em_33,page_buffer[1],1631,3)
f.lirepage(em_50,page_buffer[1],1634,5)
