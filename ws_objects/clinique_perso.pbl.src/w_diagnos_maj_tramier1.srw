forward prototypes
public subroutine load_ctrls ()
public subroutine unload_ctrls ()
end prototypes

public subroutine load_ctrls ();string	lstr_nom, lstr_prenom, lstr_corresp, lstr_dentiste, lstr_praticien, lstr_mutuelle, lstr_num_moulage
date	ld_deb_trait, ld_reprise, ld_date_naiss

select nom, prenom, date_naissance, debut_traitement, date_reprise, moulage
into :lstr_nom, :lstr_prenom, :ld_date_naiss, :ld_deb_trait, :ld_reprise, :lstr_num_moulage
from patient
where code = :var_code_local ;

select mutuelle.nom
into :lstr_mutuelle
from patient, mutuelle
where patient.code_mutuelle = mutuelle.code
and patient.code = :var_code_local ;

select correspondants.nom
into :lstr_corresp
from patient, correspondants
where patient.code_correspondant = correspondants.code
and patient.code = :var_code_local ;

select correspondants.nom
into :lstr_dentiste
from patient, correspondants
where patient.code_dentiste = correspondants.code
and patient.code = :var_code_local ;

//select prati.nom
//into :lstr_praticien
//from patient, prati
//where patient.code_praticien = prati.code
//and patient.code = :var_code_local ;

if isnull(lstr_nom) then lstr_nom = ""
if isnull(lstr_prenom) then lstr_prenom = ""
if isnull(lstr_corresp) then lstr_corresp = ""
if isnull(lstr_dentiste) then lstr_dentiste = ""
//if isnull(lstr_praticien) then lstr_praticien = ""
if isnull(lstr_mutuelle) then lstr_mutuelle = ""
if isnull(lstr_num_moulage) then lstr_num_moulage = ""
if isnull(ld_date_naiss) then ld_date_naiss = date("0000-00-00")
if isnull(ld_reprise) then ld_reprise = date("0000-00-00")
if isnull(ld_deb_trait) then ld_deb_trait = date("0000-00-00")

sle_1.text = lstr_nom
sle_2.text = lstr_prenom
sle_3.text = lstr_corresp
sle_4.text = lstr_dentiste
sle_5.text = lstr_mutuelle
sle_6.text = lstr_num_moulage
em_1.text = string(ld_date_naiss)
em_3.text = string(ld_deb_trait)
em_4.text = string(ld_reprise)


f.lire_d(mle_2, var_code_local)
f.lire_pt(mle_3, var_code_local)

f.lirepage(em_2,page_buffer[1],20,10)
f.lirepage(mle_1,page_buffer[1],50,500)
f.lirepage(mle_4,page_buffer[1],550,500)
f.lirepage(mle_5,page_buffer[1],1050,500)
f.lirepage(em_5,page_buffer[1],1550,3)
f.lirepage(em_6,page_buffer[1],1553,3)
f.lirepage(em_7,page_buffer[1],1556,3)
f.lirepage(em_8,page_buffer[1],1559,3)
f.lirepage(em_9,page_buffer[1],1562,3)
f.lirepage(em_10,page_buffer[1],1565,3)
f.lirepage(em_11,page_buffer[1],1568,3)
f.lirepage(em_12,page_buffer[1],1571,3)
f.lirepage(em_13,page_buffer[1],1574,3)
f.lirepage(em_14,page_buffer[1],1577,3)
f.lirepage(em_15,page_buffer[1],1580,3)
f.lirepage(em_16,page_buffer[1],1583,3)
