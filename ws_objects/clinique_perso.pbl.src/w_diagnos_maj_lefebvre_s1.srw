forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lirepage(em_1_1,page,1,10)
f.lirepage(em_1_2,page,11,10)
f.lirepage(em_1_3,page,21,10)
f.lirepage(em_1_4,page,31,10)
f.lirepage(em_1_5,page,41,10)
f.lirepage(em_1_6,page,51,10)

f.lirepage(em_2_1,page,61,10)
f.lirepage(em_2_2,page,71,10)
f.lirepage(em_2_3,page,81,10)
f.lirepage(em_2_4,page,91,10)
f.lirepage(em_2_5,page,101,10)

f.lirepage(em_3_1,page,111,10)
f.lirepage(em_3_2,page,121,10)
f.lirepage(em_3_3,page,131,10)
f.lirepage(em_3_4,page,141,10)
f.lirepage(em_3_5,page,151,10)
f.lirepage(em_3_6,page,161,10)	//171 carac ds page N°1


cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(em_1_1,page,1,10)
f.ecrirepage(em_1_2,page,11,10)
f.ecrirepage(em_1_3,page,21,10)
f.ecrirepage(em_1_4,page,31,10)
f.ecrirepage(em_1_5,page,41,10)
f.ecrirepage(em_1_6,page,51,10)

f.ecrirepage(em_2_1,page,61,10)
f.ecrirepage(em_2_2,page,71,10)
f.ecrirepage(em_2_3,page,81,10)
f.ecrirepage(em_2_4,page,91,10)
f.ecrirepage(em_2_5,page,101,10)

f.ecrirepage(em_3_1,page,111,10)
f.ecrirepage(em_3_2,page,121,10)
f.ecrirepage(em_3_3,page,131,10)
f.ecrirepage(em_3_4,page,141,10)
f.ecrirepage(em_3_5,page,151,10)
f.ecrirepage(em_3_6,page,161,10)	//171 carac ds page N°1


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

