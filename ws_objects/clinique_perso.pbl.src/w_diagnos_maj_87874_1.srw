public subroutine open_another_page (picturebutton pb);// fx qui lance la sauvegarde des données, ouvre une autre page clinique et ferme celle-ci


// on lance la procédure de sauvegarde des données
sauvegarder( false )

if pb.tag <> "" then
	w_diagnos_maj_		W_fille
	
	// on ouvre l'autre page clinique
	OpenSheetWithParm( W_fille, var_code_local, "w_diagnos_maj_" + pb.tag, w_mdi, 0, Original!)
	
	// on ferme celle-ci
	Close(this)
end if

end subroutine

public subroutine mise_en_valeur (checkbox cb);// vérification des propriétés de la case à cocher
// si la case est en GRAS alors elle passe en NORMAL
// sinon, elle passe en GRAS.

// code des couleurs
// 12639424 = Mint (vert clair)
// RGB(56,162,64) = (vert foncé)
// 15780518 = Sky (bleu clair)
// 8421376 = Teal (bleu foncé)
// 12632256 = Silver (gris clair)
// 8421504 = Gray (gris foncé)


if cb.Checked = True then
	// passe en GRAS
	cb.Weight = 700
	// si fond "Mint" --> passer le fond en RGB(56,162,64)
	if cb.backColor = 12639424 then cb.backColor = RGB(56,162,64)
	// si fond "Sky" --> passer le fond en "Teal"
	if cb.backColor = 15780518 then cb.backColor = 8421376
	// si fond "Silver" --> passer le fond en "Gray"
	if cb.backColor = 12632256 then cb.backColor = 8421504
else
	// passe en NORMAL
	cb.Weight = 400
	// si fond RGB(56,162,64) --> passer le fond en "Mint"
	if cb.backColor = RGB(56,162,64) then cb.backColor = 12639424
	// si fond "Teal" --> passer le fond en "Sky"
	if cb.backColor = 8421376 then	cb.backColor = 15780518
	// si fond "Gray" --> passer le fond en "Silver"
	if cb.backColor = 8421504 then	cb.backColor = 12632256
end if

end subroutine

