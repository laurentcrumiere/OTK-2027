f.ecrirepage(sle_prematurites,page_buffer[2],15,30)
f.ecrirepage(mle_paro,page_buffer[2],45,150)
f.ecrirepage(em_d1,page_buffer[2],210,10)
f.ecrirepage(em_d2,page_buffer[2],220,10)
f.ecrirepage(em_d3,page_buffer[2],230,10)
f.ecrirepage(em_d4,page_buffer[2],240,10)
f.ecrirepage(em_d5,page_buffer[2],250,10)
f.ecrirepage(em_d6,page_buffer[2],260,10)
