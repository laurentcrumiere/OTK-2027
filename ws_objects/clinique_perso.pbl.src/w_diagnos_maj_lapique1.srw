forward prototypes
public subroutine load_ctrls ()
public subroutine unload_ctrls ()
end prototypes

public subroutine load_ctrls ();dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

if dw_1.rowcount() = 0 then
	dw_1.insertrow(0)
	dw_1.setitem(1,"code",var_code_local)

	if dw_1.update() = 1 then
		commit ;
	else
		MessageBox("ATTENTION !","Impossible d'initaliser le tableau des bagues !", StopSign!)
		Rollback ;
	end if
end if

if mid(page_buffer[1],4,1) = 'O' then
	cbx_suceur.checked = true
else
	cbx_suceur.checked = false
end if
if mid(page_buffer[1],5,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page_buffer[1],6,1) = 'O' then
	cbx_bruxisme.checked = true
else	
	cbx_bruxisme.checked = false
end if
if mid(page_buffer[1],10,1) = 'O' then
	cbx_douleur.checked = true
else
	cbx_douleur.checked = false
end if
if mid(page_buffer[1],11,1) = 'O' then
	cbx_craquement.checked = true
else
	cbx_craquement.checked = false
end if
if mid(page_buffer[1],12,1) = 'O' then
	cbx_ressaut.checked = true
else
	cbx_ressaut.checked = false
end if
if mid(page_buffer[1],200,1) = 'O' then
	cbx_langue.checked = true
else
	cbx_langue.checked = false
end if
if mid(page_buffer[1],201,1) = 'O' then
	cbx_levre_sup.checked = true
else
	cbx_levre_sup.checked = false
end if
if mid(page_buffer[1],202,1) = 'O' then
	cbx_levre_inf.checked = true
else
	cbx_levre_inf.checked = false
end if

f.lirepage(ddlb_respiration,page_buffer[1],1,1)
f.lirepage(ddplb_deglutition,page_buffer[1],2,1)
f.lirepage(ddplb_phonation,page_buffer[1],3,1)
f.lirepage(ddlb_amygdales,page_buffer[1],7,1)
f.lirepage(ddlb_vegetations,page_buffer[1],8,1)
f.lirepage(ddlb_langue,page_buffer[1],9,1)
f.lirepage(ddlb_chemin,page_buffer[1],13,1)
f.lirepage(ddplb_amplitude,page_buffer[1],14,1)
f.lirepage(sle_prematurites,page_buffer[1],15,30)
f.lirepage(mle_paro,page_buffer[1],45,150)
f.lirepage(em_d1,page_buffer[1],210,10)
f.lirepage(em_d2,page_buffer[1],220,10)
f.lirepage(em_d3,page_buffer[1],230,10)
f.lirepage(em_d4,page_buffer[1],240,10)
f.lirepage(em_d5,page_buffer[1],250,10)
f.lirepage(em_d6,page_buffer[1],260,10)
f.lirepage(em_d7,page_buffer[1],270,10)
f.lirepage(em_d8,page_buffer[1],280,10)
f.lirepage(mle_col1,page_buffer[1],300,21)
f.lirepage(mle_col2,page_buffer[1],321,21)
f.lirepage(mle_col3,page_buffer[1],342,21)
f.lirepage(mle_col4,page_buffer[1],363,21)
f.lirepage(mle_col5,page_buffer[1],384,21)
f.lirepage(mle_col6,page_buffer[1],405,21)
f.lirepage(mle_col7,page_buffer[1],426,21)
f.lirepage(mle_col8,page_buffer[1],447,21)

end subroutine

public subroutine unload_ctrls ();if dw_1.update() = 1  then
	commit ;
else
	son(4)
	Messagebox("ERREUR ", "Erreur dans la sauvegarde du tableau des bagues.", StopSign!)
	Rollback ;
end if

if cbx_suceur.checked then
	place("O",page_buffer[2],4)
else
	place("N",page_buffer[2],4)
end if
if cbx_onychophagie.checked then
	place("O",page_buffer[2],5)
else
	place("N",page_buffer[2],5)
end if
if cbx_bruxisme.checked then
	place("O",page_buffer[2],6)
else
	place("N",page_buffer[2],6)
end if
if cbx_douleur.checked then
	place("O",page_buffer[2],10)
else
	place("N",page_buffer[2],10)
end if
if cbx_craquement.checked then
	place("O",page_buffer[2],11)
else
	place("N",page_buffer[2],11)
end if
if cbx_ressaut.checked then
	place("O",page_buffer[2],12)
else
	place("N",page_buffer[2],12)
end if
if cbx_langue.checked then
	place("O",page_buffer[2],200)
else
	place("N",page_buffer[2],200)
end if
if cbx_levre_sup.checked then
	place("O",page_buffer[2],201)
else
	place("N",page_buffer[2],201)
end if
if cbx_levre_inf.checked then
	place("O",page_buffer[2],202)
else
	place("N",page_buffer[2],202)
end if

f.ecrirepage(ddlb_respiration,page_buffer[2],1,1)
f.ecrirepage(ddplb_deglutition,page_buffer[2],2,1)
f.ecrirepage(ddplb_phonation,page_buffer[2],3,1)
