global w_diagnos_maj_heine2 w_diagnos_maj_heine2

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();string pt

SELECT plan_traitement INTO :pt FROM patient WHERE code = :var_code_local ;


modif = false

mle_traitement_suite.text = RightTrim(mid(page,500,350))

mle_plan_traitement.text = pt

end subroutine

event open;var_code_local = message.doubleparm
string vn,vm 


select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if


this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

end event

