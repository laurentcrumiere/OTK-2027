type variables
double var_code_local 
boolean modif
string page
uo_fx_pages_cliniques f

end variables

forward prototypes
public subroutine init ()
public subroutine save ()
end prototypes

public subroutine init ();f.lirepage(sle_1,page,1,4)
f.lirepage(sle_2,page,5,4)
f.lirepage(sle_3,page,10,4)
f.lirepage(sle_4,page,15,4)
f.lirepage(sle_5,page,20,4)
f.lirepage(sle_6,page,25,4)
f.lirepage(sle_7,page,30,4)
f.lirepage(sle_8,page,35,4)
f.lirepage(sle_9,page,40,4)
f.lirepage(sle_10,page,45,4)
f.lirepage(sle_11,page,50,4)
f.lirepage(sle_12,page,55,4)
f.lirepage(sle_13,page,60,4)
f.lirepage(sle_14,page,65,4)
f.lirepage(sle_15,page,70,4)

f.lirepage(mle_diagnos,page,100,500)
f.lirepage(mle_traitement,page,600,500)	//1100 carac au total


cb_fermer.setfocus()
modif = false

end subroutine

public subroutine save ();f.ecrirepage(sle_1,page,1,4)
f.ecrirepage(sle_2,page,5,4)
f.ecrirepage(sle_3,page,10,4)
f.ecrirepage(sle_4,page,15,4)
f.ecrirepage(sle_5,page,20,4)
f.ecrirepage(sle_6,page,25,4)
f.ecrirepage(sle_7,page,30,4)
f.ecrirepage(sle_8,page,35,4)
f.ecrirepage(sle_9,page,40,4)
f.ecrirepage(sle_10,page,45,4)
f.ecrirepage(sle_11,page,50,4)
f.ecrirepage(sle_12,page,55,4)
f.ecrirepage(sle_13,page,60,4)
f.ecrirepage(sle_14,page,65,4)
f.ecrirepage(sle_15,page,70,4)

f.ecrirepage(mle_diagnos,page,100,500)
f.ecrirepage(mle_traitement,page,600,500)	//1100 carac au total


UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1) : ",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end subroutine

