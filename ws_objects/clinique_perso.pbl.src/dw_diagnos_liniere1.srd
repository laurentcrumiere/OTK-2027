compute(band=detail alignment="1" expression="if (month(today()) < month( date_naissance ),month(today()) - month( date_naissance ) +12, month(today()) - month( date_naissance ))"border="0" color="0" x="421" y="16" height="56" width="59" format="#0"  name=mois  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127"  height.autosize=yes)
