table(column=(type=date update=yes updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.moulage~")WHERE(    EXP1 =~"( ~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode )~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " arguments=(("nocode", number)) )
text(band=detail alignment="0" text="Age :" border="0" color="0" x="27" y="16" height="56" width="128"  name=t_1  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=detail alignment="0" expression="if (month(today()) < month( date_naissance ),year(today()) - year( date_naissance ) - 1, year(today()) - year( date_naissance ))"border="0" color="0" x="210" y="16" height="56" width="78" format="#0"  name=ans  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
