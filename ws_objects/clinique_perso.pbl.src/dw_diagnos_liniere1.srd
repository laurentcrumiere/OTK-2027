text(band=detail alignment="0" text="Praticien :" border="0" color="0" x="27" y="100" height="56" width="247"  name=t_4  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
