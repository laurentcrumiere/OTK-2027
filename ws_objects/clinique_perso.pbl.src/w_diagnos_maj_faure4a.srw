type cb_fermer from commandbutton within w_diagnos_maj_faure4a
integer x = 2976
integer y = 1760
integer width = 384
integer height = 96
integer taborder = 570
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Fermer"
boolean default = true
end type

event clicked;if modif or dw_1.modifiedcount() > 0 then
	if MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre sans enregistrer ?",Question!,YesNo!) = 1 then
		Close(parent)
	end if
else
	close(parent)
end if

end event

