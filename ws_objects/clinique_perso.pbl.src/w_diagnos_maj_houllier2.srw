type pb_2 from picturebutton within w_diagnos_maj_houllier2
integer x = 4329
integer y = 2260
integer width = 137
integer height = 112
integer taborder = 370
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "ar_left.bmp"
vtextalign vtextalign = vcenter!
end type

event clicked;if modif then
	if MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre sans enregistrer ?",Question!,YesNo!) = 1 then
	If ui_v2020 then 
		OpenWithParm( w_diagnos_maj_houllier3, var_code_local, "w_diagnos_maj_houllier3", w_mdi_2020)
	else
		OpenSheetWithParm( w_diagnos_maj_houllier3, var_code_local, "w_diagnos_maj_houllier3", w_mdi, 0, Original!)
	end if	
		Close(parent)
	end if
else
	If ui_v2020 then 
		OpenWithParm( w_diagnos_maj_houllier3, var_code_local, "w_diagnos_maj_houllier3", w_mdi_2020)
	else
		OpenSheetWithParm( w_diagnos_maj_houllier3, var_code_local, "w_diagnos_maj_houllier3", w_mdi, 0, Original!)
	end if	
	close(parent)
end if

end event

