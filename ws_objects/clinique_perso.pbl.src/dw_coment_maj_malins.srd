 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coment~" ) COLUMN(NAME=~"coment.dat~") COLUMN(NAME=~"coment.com_html~") COLUMN(NAME=~"coment.acte_prevu_html~") COLUMN(NAME=~"coment.coul_texte~") COLUMN(NAME=~"coment.coul_fond~") COLUMN(NAME=~"coment.code~") COLUMN(NAME=~"coment.ordre~") COLUMN(NAME=~"coment.proc~") COLUMN(NAME=~"coment.hg~") COLUMN(NAME=~"coment.ela~") COLUMN(NAME=~"coment.hygiene_v10~") COLUMN(NAME=~"coment.elastique_v10~") COLUMN(NAME=~"coment.date_modif~") COLUMN(NAME=~"coment.user_modif~") COLUMN(NAME=~"coment.com~") COLUMN(NAME=~"coment.acte_prevu~")WHERE(    EXP1 =~"( ~~~"coment~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":numero )~" ) ) ARG(NAME = ~"numero~" TYPE = number) " update="coment" updatewhere=0 updatekeyinplace=yes arguments=(("numero", number))  sort="dat A ordre A " )
