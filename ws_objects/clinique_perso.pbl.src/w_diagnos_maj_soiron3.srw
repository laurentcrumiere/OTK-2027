global w_diagnos_maj_soiron3 w_diagnos_maj_soiron3

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_d1.text = Righttrim(trim(mid(page,3300,7)))
em_d2.text = Righttrim(trim(mid(page,3310,7)))
em_d3.text = Righttrim(trim(mid(page,3320,7)))
em_d4.text = Righttrim(trim(mid(page,3330,7)))
em_d5.text = Righttrim(trim(mid(page,3340,7)))
em_d6.text = Righttrim(trim(mid(page,3350,7)))
em_d7.text = Righttrim(trim(mid(page,3360,7)))
em_d8.text = Righttrim(trim(mid(page,3370,7)))
em_d9.text = Righttrim(trim(mid(page,3380,7)))
em_d10.text = Righttrim(trim(mid(page,3390,7)))
em_d11.text = Righttrim(trim(mid(page,3400,7)))
em_d12.text = Righttrim(trim(mid(page,3410,7)))
em_d13.text = Righttrim(trim(mid(page,3420,7)))
em_d14.text = Righttrim(trim(mid(page,3430,7)))
em_d15.text = Righttrim(trim(mid(page,3440,7)))
em_d16.text = Righttrim(trim(mid(page,3450,7)))
em_d17.text = Righttrim(trim(mid(page,3460,7)))
em_d18.text = Righttrim(trim(mid(page,3470,7)))
em_d19.text = Righttrim(trim(mid(page,3480,7)))
em_d20.text = Righttrim(trim(mid(page,3490,7)))

end subroutine

event open;var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, mois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°3 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+") Praticien : B. SOIRON"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(6000)
end if

if len(page) < 6000 then
	page = page + space(6000 - len(page))
end if

init()

end event

