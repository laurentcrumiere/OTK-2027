UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;
COMMIT ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end event

type cb_precedent from commandbutton within w_diagnos_maj_lacaze3
integer x = 1838
integer y = 2128
integer width = 338
integer height = 96
integer taborder = 810
integer textsize = -8
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "&Précédant"
end type

event clicked;if modif then
	If MessageBox("ATTENTION","Vous avez fait des modifications !~n~nVoulez-vous tout de même quitter~ncette fenêtre ?",Question!,YesNo!) = 1 Then
		openwithparm(w_diagnos_maj_lacaze2,var_code_local)
		Close(w_diagnos_maj_lacaze3)
	end if
else
	openwithparm(w_diagnos_maj_lacaze2,var_code_local)
	close(w_diagnos_maj_lacaze3)
end if
end event

