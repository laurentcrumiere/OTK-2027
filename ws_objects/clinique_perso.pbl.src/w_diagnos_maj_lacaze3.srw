	em_impa.text = string (180 - integer(em_fmia.text) - integer(em_fma.text))
END IF
IF (integer(em_sna.text) <> 0 AND integer(em_snb.text) <> 0) THEN
	em_anb.text = string (integer(em_sna.text) - integer(em_snb.text))
END IF	
IF (integer(em_ant.text) <> 0) THEN
	em_index.text = string (integer(em_post.text) / integer(em_ant.text))
END IF	

IF (integer(em_fmia1.text) <> 0 AND integer(em_fma1.text) <> 0) THEN
	em_impa1.text = string (180 - integer(em_fmia1.text) - integer(em_fma1.text))
END IF
IF (integer(em_sna1.text) <> 0 AND integer(em_snb1.text) <> 0) THEN	
	em_anb1.text = string (integer(em_sna1.text) - integer(em_snb1.text))
END IF	
IF (integer(em_ant1.text) <> 0) THEN
	em_index1.text = string (integer(em_post1.text) / integer(em_ant1.text))
END IF	

IF (integer(em_fmia2.text) <> 0 AND integer(em_fma2.text) <> 0) THEN
	em_impa2.text = string (180 - integer(em_fmia2.text) - integer(em_fma2.text))
END IF
IF (integer(em_sna2.text) <> 0 AND integer(em_snb2.text) <> 0) THEN		
	em_anb2.text = string (integer(em_sna2.text) - integer(em_snb2.text))
END IF	
IF (integer(em_ant2.text) <> 0) THEN
	em_index2.text = string (integer(em_post2.text) / integer(em_ant2.text))
END IF	

IF (integer(em_fmia3.text) <> 0 AND integer(em_fma3.text) <> 0) THEN
	em_impa3.text = string (180 - integer(em_fmia3.text) - integer(em_fma3.text))
END IF
IF (integer(em_sna3.text) <> 0 AND integer(em_snb3.text) <> 0) THEN		
	em_anb3.text = string (integer(em_sna3.text) - integer(em_snb3.text))
END IF	
IF (integer(em_ant3.text) <> 0) THEN
	em_index3.text = string (integer(em_post3.text) / integer(em_ant3.text))
END IF	

IF (integer(em_fmia4.text) <> 0 AND integer(em_fma4.text) <> 0) THEN
	em_impa4.text = string (180 - integer(em_fmia4.text) - integer(em_fma4.text))
END IF
IF (integer(em_sna4.text) <> 0 AND integer(em_snb4.text) <> 0) THEN			
	em_anb4.text = string (integer(em_sna4.text) - integer(em_snb4.text))
END IF	
IF (integer(em_ant4.text) <> 0) THEN
	em_index4.text = string (integer(em_post4.text) / integer(em_ant4.text))
END IF	



majtot()

modif = false

end subroutine

event open;

var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, mois

double v_numero_dossier

select nom,prenom,moulage,date_naissance, numero_dossier
INTO :vn,:vp,:vm,:vd , :v_numero_dossier
FROM patient WHERE code = :var_code_local ;


if isnull(vm) then
	vm = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°3 : "+vn+" " +vp+" - N° dossier : "+string(v_numero_dossier)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(5000)
end if

if len(page) < 5000 then
	page = page + space(5000 - len(page))
end if

init()
cb_fermer.setfocus()
end event

