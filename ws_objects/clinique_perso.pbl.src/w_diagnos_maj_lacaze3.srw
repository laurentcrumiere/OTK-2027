type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine majtot ()
public subroutine init ()
end prototypes

public subroutine majtot ();
em_acf72.text = string (integer(em_acf12.text)+integer(em_acf22.text)+integer(em_acf32.text)+integer(em_acf42.text)+integer(em_acf52.text)+integer(em_acf62.text))
em_totcf.text = em_acf72.text


em_aet42.text = string (integer(em_aet12.text)+integer(em_aet22.text)+integer(em_aet32.text))
em_aet102.text = string (integer(em_aet82.text)+integer(em_aet92.text))

em_aet112.text = string (integer(em_aet42.text)+integer(em_aet62.text)+integer(em_coef.text)+integer(em_aet102.text)) //suite à modif par fax
em_totd.text = em_aet112.text

em_totgene.text = string(integer(em_totd.text)+integer(em_totcf.text))

em_aet41.text = string (integer(em_aet11.text)+integer(em_aet21.text)+integer(em_aet31.text))
em_aet71.text = string (integer(em_aet51.text)+integer(em_aet61.text))
em_aet101.text = string (integer(em_aet81.text)+integer(em_aet91.text))

em_aet111.text = string (integer(em_aet41.text)+integer(em_aet71.text)+integer(em_clii_moy.text)+integer(em_aet101.text)) //suite à modif par fax
end subroutine

public subroutine init ();
em_d1.text = trim(mid(page,3530,10))
em_d2.text = trim(mid(page,3540,10))
em_d3.text = trim(mid(page,3550,10))
em_d4.text = trim(mid(page,3560,10))
em_d5.text = trim(mid(page,3570,10))

em_fmia.text = Righttrim(mid(page,3600,3))
em_fma.text = Righttrim(mid(page,3605,3))
em_sna.text = Righttrim(mid(page,3610,3))
em_snb.text = Righttrim(mid(page,3615,3))
em_aobo.text = Righttrim(mid(page,3620,3))
em_plan.text = Righttrim(mid(page,3625,3))
em_z.text = Righttrim(mid(page,3630,3))
em_upper.text = Righttrim(mid(page,3635,3))
