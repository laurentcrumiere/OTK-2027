//em_age.text = mid(page,1920,2)
//
modif = false



end subroutine

event open;
var_code_local = message.doubleparm

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

string vn,vm 
select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"

init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

init()

// place la window ds la mdi -> confort utilisateur
mep_win_mdi(this,1)

end event

