forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();mle_ant_gene.text = Righttrim(trim(mid(page,1,200)))
mle_ant_fami.text = Righttrim(trim(mid(page,201,200)))

ddlb_respiration.selectitem(integer(mid(page,401,1)))
ddplb_deglutition.selectitem(integer(mid(page,402,1)))
ddplb_phonation.selectitem(integer(mid(page,403,1)))
if mid(page,404,1) = 'O' then
	cbx_suceur.checked = true
else
	cbx_suceur.checked = false
end if
if mid(page,405,1) = 'O' then
	cbx_onychophagie.checked = true
else
	cbx_onychophagie.checked = false
end if
if mid(page,406,1) = 'O' then
	cbx_bruxisme.checked = true
else
	cbx_bruxisme.checked = false
end if

ddlb_amygdales.selectitem(integer(mid(page,407,1)))
