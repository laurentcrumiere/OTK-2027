global w_diagnos_maj_liniere3 w_diagnos_maj_liniere3

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_axe_mesures.text = RightTrim(mid(page,1400,3))
em_axe_dolicho.text = RightTrim(mid(page,1403,1))
em_axe_meso.text = RightTrim(mid(page,1404,1))
em_axe_brachy.text = RightTrim(mid(page,1405,1))

em_plan_mesures.text = RightTrim(mid(page,1406,2))
em_plan_dolicho.text = RightTrim(mid(page,1408,1))
em_plan_meso.text = RightTrim(mid(page,1409,1))
em_plan_brachy.text = RightTrim(mid(page,1410,1))

em_angle_mesures.text = RightTrim(mid(page,1411,2))
em_angle_dolicho.text = RightTrim(mid(page,1413,1))
em_angle_meso.text = RightTrim(mid(page,1414,1))
em_angle_brachy.text = RightTrim(mid(page,1415,1))

em_hfi_mesures.text = RightTrim(mid(page,1416,2))
em_hfi_dolicho.text = RightTrim(mid(page,1418,1))
em_hfi_meso.text = RightTrim(mid(page,1419,1))
em_hfi_brachy.text = RightTrim(mid(page,1420,1))

em_hft_mesures.text = RightTrim(mid(page,1421,2))
em_hft_dolicho.text = RightTrim(mid(page,1423,1))
em_hft_meso.text = RightTrim(mid(page,1424,1))
em_hft_brachy.text = RightTrim(mid(page,1425,1))

em_arc_mesures.text = RightTrim(mid(page,1426,2))
em_arc_dolicho.text = RightTrim(mid(page,1428,1))
em_arc_meso.text = RightTrim(mid(page,1429,1))
em_arc_brachy.text = RightTrim(mid(page,1430,1))

em_total_dolicho.text = RightTrim(mid(page,1431,2))
em_total_meso.text = RightTrim(mid(page,1433,2))
em_total_brachy.text = RightTrim(mid(page,1435,2))

em_convexe_mesures.text = RightTrim(mid(page,1437,2))
em_imm_mesures.text = RightTrim(mid(page,1439,2))
em_ideg_mesures.text = RightTrim(mid(page,1441,2))
em_ptv_mesures.text = RightTrim(mid(page,1443,2))

ddlb_typo.selectitem(integer(mid(page,1445,1)))
ddlb_mand.selectitem(integer(mid(page,1446,1)))
ddlb_cl_squel.selectitem(integer(mid(page,1447,1)))
ddlb_i.selectitem(integer(mid(page,1448,1)))
ddlb_6.selectitem(integer(mid(page,1449,1)))

mle_diagnostic.text = RightTrim(mid(page,1450,250))
mle_remarques.text = RightTrim(mid(page,1700,300))
end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if isnull(vd) then
	vd = Today()
end if


if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°3 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

init()

end event

