place_avec_blancs(mle_diagnostic.text,page,1450,250)
place_avec_blancs(mle_remarques.text,page,1700,300)

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if
end event

