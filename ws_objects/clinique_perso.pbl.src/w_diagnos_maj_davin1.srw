public subroutine save ();f.ecrirepage(mle_ant_gene,page,1,200)
f.ecrirepage(mle_ant_fami,page,201,150)
f.ecrirepage(sle_classe,page,351,3)
f.ecrirepage(sle_contact,page,355,1)
f.ecrirepage(sle_hygiene,page,356,1)

