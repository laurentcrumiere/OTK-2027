f.ecrirepage(mle_commentaire3,page,1080,100)		//1180 caractères au total ds page

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
	RollBack ;
else
	modif = false
	COMMIT ;
end if

end subroutine

event open;var_code_local = message.doubleparm

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

string vn,vm 
select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

this.title = "Page Clinique N°1 : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"

init()


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

//if len(page) < 6000 then
//	page = page + space(6000 - len(page))
//end if

init()


end event

