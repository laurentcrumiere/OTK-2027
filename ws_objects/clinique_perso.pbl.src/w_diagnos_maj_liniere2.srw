place_avec_blancs(sle_agene.text,page,1325,5)

place_avec_blancs(em_surplomb.text,page,1330,2)
place_avec_blancs(em_recouv.text,page,1332,2)

place(string(ddlb_beance.FindItem(ddlb_beance.text,1)),page,1334)
place(string(ddlb_encombre.FindItem(ddlb_encombre.text,1)),page,1335)
