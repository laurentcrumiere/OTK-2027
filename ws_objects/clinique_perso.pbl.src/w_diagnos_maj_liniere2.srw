global w_diagnos_maj_liniere2 w_diagnos_maj_liniere2

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

em_date.text = Trim(mid(page,1250,10))

IF mid(page,1250,10) = space(10) THEN
	em_date.text = string(today (),'dd/mm/yyyy')
END IF 

sle_regle.text = RightTrim(mid(page,1260,5))
ddlb_taille.selectitem(integer(mid(page,1265,1)))

em_mol_d.text = RightTrim(mid(page,1270,2))
em_mol_g.text = RightTrim(mid(page,1272,2))
em_can_d.text = RightTrim(mid(page,1274,2))
em_can_g.text = RightTrim(mid(page,1276,2))

sle_dent_incluse.text = RightTrim(mid(page,1280,20))
sle_rotations.text = RightTrim(mid(page,1300,20))
sle_surnu.text = RightTrim(mid(page,1320,5))
sle_agene.text = RightTrim(mid(page,1325,5))

em_surplomb.text = RightTrim(mid(page,1330,2))
em_recouv.text = RightTrim(mid(page,1332,2))

ddlb_beance.selectitem(integer(mid(page,1334,1)))
ddlb_encombre.selectitem(integer(mid(page,1335,1)))
ddlb_cl_dent.selectitem(integer(mid(page,1336,1)))
ddlb_sourire.selectitem(integer(mid(page,1337,1)))
ddlb_mand.selectitem(integer(mid(page,1338,1)))
ddlb_max.selectitem(integer(mid(page,1339,1)))
ddlb_mil_inter.selectitem(integer(mid(page,1340,1)))
ddlb_16.selectitem(integer(mid(page,1341,1)))
ddlb_36.selectitem(integer(mid(page,1342,1)))

em_md.text = RightTrim(mid(page,1343,3))
em_mg.text = RightTrim(mid(page,1346,3))
em_cd.text = RightTrim(mid(page,1349,3))
em_cg.text = RightTrim(mid(page,1352,3))

sle_occl.text = RightTrim(mid(page,1360,10))

em_date.SetFocus()

end subroutine

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if isnull(vd) then
	vd = Today()
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°2 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if


init()



end event

