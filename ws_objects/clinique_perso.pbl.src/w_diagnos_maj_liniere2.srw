event clicked;place(em_date.text,page,1250)

place_avec_blancs(sle_regle.text,page,1260,5)
place(string(ddlb_taille.FindItem(ddlb_taille.text,1)),page,1265)


place_avec_blancs(em_mol_d.text,page,1270,2)
