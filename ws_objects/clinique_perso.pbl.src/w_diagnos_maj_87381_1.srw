public subroutine load_ctrls ();String	nom_str
Date	dateNaissance_d

// pour siumple affichage
select date_naissance into :dateNaissance_d from patient where code = :var_code_local ;
st_15.text = string(dateNaissance_d, "dd/mm/yyyy;'00/00/0000'")	// permet de gérer le NULL en une seule ligne

select prati.nom into : nom_str from prati, patient where prati.code = patient.code_praticien and patient.code = :var_code_local ;
if isnull(nom_str) then nom_str = "" ;
st_16.text = nom_str


f.lirepage(ddlb_5,page_buffer[1],1,1)
