string dentiste_nom, dentiste_prenom
select correspondants.nom, correspondants.prenom into :dentiste_nom, :dentiste_prenom 
from patient, correspondants 
where patient.code_dentiste = correspondants.code and patient.code = :var_code_local ;
if isnull(dentiste_nom) then dentiste_nom = ""
if isnull(dentiste_prenom) then dentiste_prenom = ""
st_dentiste.text = trim( dentiste_nom + space(1) + dentiste_prenom)
end subroutine

