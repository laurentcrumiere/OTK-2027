public subroutine s3_sup_gg ();// Somme des 3 mesures supérieures gauche

double somme

somme = double(sle_p5sg.text) + double(sle_p4sg.text) + double(sle_p3sg.text) + double(sle_m5sg.text) + double(sle_m4sg.text) + double(sle_m3sg.text)
sle_pnsgg.text = doubleToStringAvecPlus(somme)
end subroutine

public subroutine s3_sup_dd ();// Somme des 3 mesures supérieures droite

double somme

somme = double(sle_p5sd.text) + double(sle_p4sd.text) + double(sle_p3sd.text) + double(sle_m5sd.text) + double(sle_m4sd.text) + double(sle_m3sd.text)
sle_pnsdd.text = doubleToStringAvecPlus(somme)
end subroutine

public subroutine s2_sup_g ();// Somme des 2 mesures supérieures gauche

double somme

somme = double(sle_p2sg.text) + double(sle_p1sg.text) + double(sle_m2sg.text) + double(sle_m1sg.text)
sle_pnsg.text = doubleToStringAvecPlus(somme)
end subroutine

public subroutine s2_sup_d ();// Somme des 2 mesures supérieures droite

double somme

somme = double(sle_p2sd.text) + double(sle_p1sd.text) + double(sle_m2sd.text) + double(sle_m1sd.text)
sle_pnsd.text = doubleToStringAvecPlus(somme)
end subroutine

public subroutine s2_inf_d ();// Somme des 2 mesures inférieures droite

double somme

somme = double(sle_p2id.text) + double(sle_p1id.text) + double(sle_m2id.text) + double(sle_m1id.text)
sle_pnid.text = doubleToStringAvecPlus(somme)
end subroutine

public subroutine s2_inf_g ();// Somme des 2 mesures inférieures gauche

double somme

somme = double(sle_p2ig.text) + double(sle_p1ig.text) + double(sle_m2ig.text) + double(sle_m1ig.text)
sle_pnig.text = doubleToStringAvecPlus(somme)
end subroutine

public subroutine s3_inf_dd ();// Somme des 3 mesures inférieures droite

double somme

somme = double(sle_p5id.text) + double(sle_p4id.text) + double(sle_p3id.text) + double(sle_m5id.text) + double(sle_m4id.text) + double(sle_m3id.text)
sle_pnidd.text = doubleToStringAvecPlus(somme)
end subroutine

public subroutine s3_inf_gg ();// Somme des 3 mesures inférieures gauche

double somme

somme = double(sle_p5ig.text) + double(sle_p4ig.text) + double(sle_p3ig.text) + double(sle_m5ig.text) + double(sle_m4ig.text) + double(sle_m3ig.text)
sle_pnigg.text = doubleToStringAvecPlus(somme)
end subroutine

public subroutine ddd ();// DDD ; calcul du BOLTON
// (Somme des 6 dents antéro-inférieures / Somme des 6 dents antéro-supérieures) * 100

double s6_sup, s6_inf


s6_sup =  double(sle_p3sg.text) + double(sle_p2sg.text) + double(sle_p1sg.text)
s6_sup = s6_sup + double(sle_m3sg.text) + double(sle_m2sg.text) + double(sle_m1sg.text)
s6_sup = s6_sup +  double(sle_p3sd.text) + double(sle_p2sd.text) + double(sle_p1sd.text)
s6_sup = s6_sup + double(sle_m3sd.text) + double(sle_m2sd.text) + double(sle_m1sd.text)

s6_inf =  double(sle_p3ig.text) + double(sle_p2ig.text) + double(sle_p1ig.text)
s6_inf = s6_inf + double(sle_m3ig.text) + double(sle_m2ig.text) + double(sle_m1ig.text)
s6_inf = s6_inf +  double(sle_p3id.text) + double(sle_p2id.text) + double(sle_p1id.text)
s6_inf = s6_inf + double(sle_m3id.text) + double(sle_m2id.text) + double(sle_m1id.text)

if s6_sup = 0 then st_DDD.text = "Div. 0" else st_DDD.text = doubleToStringAvecPlus((s6_inf/s6_sup)*100)
end subroutine

public subroutine b3_inf_d ();// Bilan des 3 mesures inférieures droite

double bilan

bilan = double(sle_pdidd.text) - double(sle_pnidd.text)
sle_bilan3_inf_d.text = doubleToStringAvecPlus(bilan)
end subroutine

public subroutine b3_sup_d ();// Bilan des 3 mesures supérieures droite

double bilan

bilan = double(sle_pdsdd.text) - double(sle_pnsdd.text)
sle_bilan3_sup_d.text = doubleToStringAvecPlus(bilan)
end subroutine

public subroutine b3_inf_g ();// Bilan des 3 mesures inférieures gauche

double bilan

bilan = double(sle_pdigg.text) - double(sle_pnigg.text)
sle_bilan3_inf_g.text = doubleToStringAvecPlus(bilan)
end subroutine

public subroutine b3_sup_g ();// Bilan des 3 mesures supérieures gauche

double bilan

bilan = double(sle_pdsgg.text) - double(sle_pnsgg.text)
sle_bilan3_sup_g.text = doubleToStringAvecPlus(bilan)
end subroutine

public subroutine ddm ();// DDM ; calcul du BOLTON
// Total supérieur des bilans de place / Total inférieur des bilans de place

double sup, inf, ddm

sup =  double(sle_bilan3_sup_g.text) + double(sle_bilan2_sup_g.text) + double(sle_bilan2_sup_d.text) + double(sle_bilan3_sup_d.text)

inf = double(sle_bilan3_inf_g.text) + double(sle_bilan2_inf_g.text) + double(sle_bilan2_inf_d.text) + double(sle_bilan3_inf_d.text)

st_s_sup.text = string(sup)
st_s_inf.text = string(inf)


//if inf = 0 then st_DDM.text = "Div. 0" else st_DDM.text = doubleToStringAvecPlus((sup/inf))
end subroutine

public subroutine b2_inf_d ();// Bilan des 2 mesures inférieures droite

double bilan

bilan = double(sle_pdid.text) - double(sle_pnid.text)
sle_bilan2_inf_d.text = doubleToStringAvecPlus(bilan)
end subroutine

public subroutine b2_inf_g ();// Bilan des 2 mesures inférieures gauche

double bilan

bilan = double(sle_pdig.text) - double(sle_pnig.text)
sle_bilan2_inf_g.text = doubleToStringAvecPlus(bilan)
end subroutine

public subroutine b2_sup_d ();// Bilan des 2 mesures supérieures droite

double bilan

bilan = double(sle_pdsd.text) - double(sle_pnsd.text)
sle_bilan2_sup_d.text = doubleToStringAvecPlus(bilan)
end subroutine

public subroutine b2_sup_g ();// Bilan des 2 mesures supérieures gauche

double bilan

bilan = double(sle_pdsg.text) - double(sle_pnsg.text)
sle_bilan2_sup_g.text = doubleToStringAvecPlus(bilan)
end subroutine

