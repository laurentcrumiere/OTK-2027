public function string doubletostringavecplus (double valeur);

if valeur > 0 then
	return "+" + string(valeur, "0.##")
else
	return string(valeur, "0.##")
end if
end function

public subroutine open_another_page (picturebutton pb);// fx qui lance la sauvegarde des données, ouvre une autre page clinique et ferme celle-ci


// on lance la procédure de sauvegarde des données
sauvegarder( false )

if pb.tag <> "" then
	w_diagnos_maj_		W_fille
	
	// on ouvre l'autre page clinique
	OpenSheetWithParm( W_fille, var_code_local, "w_diagnos_maj_" + pb.tag, w_mdi, 0, Original!)
	
	// on ferme celle-ci
	Close(this)
end if

end subroutine

public subroutine calculs_automatiques ();// Calculs automatiques


// Place nécéssaire
double pour_calcul 


// Pour la partie Haute !!!!


//-----------------------------------------------------------------------------------------------------------
// Partie 1/4 haut gauche
pour_calcul = StringToDoubleSansPlus(sle_p5sg.text) + StringToDoubleSansPlus(sle_p4sg.text) + StringToDoubleSansPlus(sle_p3sg.text) + StringToDoubleSansPlus(sle_m5sg.text) + StringToDoubleSansPlus(sle_m4sg.text) + StringToDoubleSansPlus(sle_m3sg.text) 
sle_pnsgg.text = DoubleToStringAvecPlus(pour_calcul)
 
pour_calcul = StringToDoubleSansPlus(sle_pdsgg.text) - StringToDoubleSansPlus(sle_pnsgg.text)
sle_bilan3_sup_g.text = DoubleToStringAvecPlus(pour_calcul)

pour_calcul = StringToDoubleSansPlus(sle_p2sg.text) + StringToDoubleSansPlus(sle_p1sg.text) + StringToDoubleSansPlus(sle_m2sg.text) + StringToDoubleSansPlus(sle_m1sg.text) 
sle_pnsg.text = DoubleToStringAvecPlus(pour_calcul) 

pour_calcul = StringToDoubleSansPlus(sle_pdsg.text) - StringToDoubleSansPlus(sle_pnsg.text)
sle_bilan2_sup_g.text = DoubleToStringAvecPlus(pour_calcul)

// Partie 1/4 haut droite
pour_calcul = StringToDoubleSansPlus(sle_p5sd.text) + StringToDoubleSansPlus(sle_p4sd.text) + StringToDoubleSansPlus(sle_p3sd.text) + StringToDoubleSansPlus(sle_m5sd.text) + StringToDoubleSansPlus(sle_m4sd.text) + StringToDoubleSansPlus(sle_m3sd.text) 
sle_pnsdd.text = DoubleToStringAvecPlus(pour_calcul)
 
pour_calcul = StringToDoubleSansPlus(sle_pdsdd.text) - StringToDoubleSansPlus(sle_pnsdd.text)
sle_bilan3_sup_d.text = DoubleToStringAvecPlus(pour_calcul)

pour_calcul = StringToDoubleSansPlus(sle_p2sd.text) + StringToDoubleSansPlus(sle_p1sd.text) + StringToDoubleSansPlus(sle_m2sd.text) + StringToDoubleSansPlus(sle_m1sd.text) 
sle_pnsd.text = DoubleToStringAvecPlus(pour_calcul) 

pour_calcul = StringToDoubleSansPlus(sle_pdsd.text) - StringToDoubleSansPlus(sle_pnsd.text)
sle_bilan2_sup_d.text = DoubleToStringAvecPlus(pour_calcul)

// Calcul de S ...
pour_calcul = StringToDoubleSansPlus(sle_bilan3_sup_g.text) +  StringToDoubleSansPlus(sle_bilan2_sup_g.text) +  StringToDoubleSansPlus(sle_bilan3_sup_d.text) +  StringToDoubleSansPlus(sle_bilan2_sup_d.text)
st_s_sup.text = DoubleToStringAvecPlus(pour_calcul)


// Pour la partie basse !!!!
//-----------------------------------------------------------------------------------------------------------

// Partie 1/4 bas gauche
pour_calcul = StringToDoubleSansPlus(sle_p5ig.text) + StringToDoubleSansPlus(sle_p4ig.text) + StringToDoubleSansPlus(sle_p3ig.text) + StringToDoubleSansPlus(sle_m5ig.text) + StringToDoubleSansPlus(sle_m4ig.text) + StringToDoubleSansPlus(sle_m3ig.text) 
sle_pnigg.text = DoubleToStringAvecPlus(pour_calcul)
 
pour_calcul = StringToDoubleSansPlus(sle_pdigg.text) - StringToDoubleSansPlus(sle_pnigg.text)
sle_bilan3_inf_g.text = DoubleToStringAvecPlus(pour_calcul)

pour_calcul = StringToDoubleSansPlus(sle_p2ig.text) + StringToDoubleSansPlus(sle_p1ig.text) + StringToDoubleSansPlus(sle_m2ig.text) + StringToDoubleSansPlus(sle_m1ig.text) 
sle_pnig.text = DoubleToStringAvecPlus(pour_calcul) 

pour_calcul = StringToDoubleSansPlus(sle_pdig.text) - StringToDoubleSansPlus(sle_pnig.text)
sle_bilan2_inf_g.text = DoubleToStringAvecPlus(pour_calcul)

// Partie 1/4 bas droite
pour_calcul = StringToDoubleSansPlus(sle_p5id.text) + StringToDoubleSansPlus(sle_p4id.text) + StringToDoubleSansPlus(sle_p3id.text) + StringToDoubleSansPlus(sle_m5id.text) + StringToDoubleSansPlus(sle_m4id.text) + StringToDoubleSansPlus(sle_m3id.text) 
sle_pnidd.text = DoubleToStringAvecPlus(pour_calcul)
 
pour_calcul = StringToDoubleSansPlus(sle_pdidd.text) - StringToDoubleSansPlus(sle_pnidd.text)
sle_bilan3_inf_d.text = DoubleToStringAvecPlus(pour_calcul)

pour_calcul = StringToDoubleSansPlus(sle_p2id.text) + StringToDoubleSansPlus(sle_p1id.text) + StringToDoubleSansPlus(sle_m2id.text) + StringToDoubleSansPlus(sle_m1id.text) 
sle_pnid.text = DoubleToStringAvecPlus(pour_calcul) 

pour_calcul = StringToDoubleSansPlus(sle_pdid.text) - StringToDoubleSansPlus(sle_pnid.text)
sle_bilan2_inf_d.text = DoubleToStringAvecPlus(pour_calcul)

// Calcul de I ...
pour_calcul = StringToDoubleSansPlus(sle_bilan3_inf_g.text) +  StringToDoubleSansPlus(sle_bilan2_inf_g.text) +  StringToDoubleSansPlus(sle_bilan3_inf_d.text) +  StringToDoubleSansPlus(sle_bilan2_inf_d.text)
st_s_inf.text = DoubleToStringAvecPlus(pour_calcul)




// DDD ; calcul du BOLTON
// (Somme des 6 dents antéro-inférieures / Somme des 6 dents antéro-supérieures) * 100

double s6_sup, s6_inf

s6_sup =  StringToDoubleSansPlus(sle_p3sg.text) + StringToDoubleSansPlus(sle_p2sg.text) + StringToDoubleSansPlus(sle_p1sg.text)
s6_sup = s6_sup + StringToDoubleSansPlus(sle_m3sg.text) + StringToDoubleSansPlus(sle_m2sg.text) + StringToDoubleSansPlus(sle_m1sg.text)
s6_sup = s6_sup +  StringToDoubleSansPlus(sle_p3sd.text) + StringToDoubleSansPlus(sle_p2sd.text) + StringToDoubleSansPlus(sle_p1sd.text)
s6_sup = s6_sup + StringToDoubleSansPlus(sle_m3sd.text) + StringToDoubleSansPlus(sle_m2sd.text) + StringToDoubleSansPlus(sle_m1sd.text)

s6_inf =  StringToDoubleSansPlus(sle_p3ig.text) + StringToDoubleSansPlus(sle_p2ig.text) + StringToDoubleSansPlus(sle_p1ig.text)
s6_inf = s6_inf + StringToDoubleSansPlus(sle_m3ig.text) + StringToDoubleSansPlus(sle_m2ig.text) + StringToDoubleSansPlus(sle_m1ig.text)
s6_inf = s6_inf +  StringToDoubleSansPlus(sle_p3id.text) + StringToDoubleSansPlus(sle_p2id.text) + StringToDoubleSansPlus(sle_p1id.text)
s6_inf = s6_inf + StringToDoubleSansPlus(sle_m3id.text) + StringToDoubleSansPlus(sle_m2id.text) + StringToDoubleSansPlus(sle_m1id.text)

if s6_sup = 0 then st_DDD.text = "Div. 0" else st_DDD.text = doubleToStringAvecPlus((s6_inf/s6_sup)*100)


end subroutine

public function double stringtodoublesansplus (string valeur_texte);
if isnull(valeur_texte) then
	return 0
else
	if left(valeur_texte, 1) = '+' then
		return double( right( valeur_texte, len(valeur_texte) - 1))
	else
		return double( valeur_texte ) 
	end if
end if
end function

