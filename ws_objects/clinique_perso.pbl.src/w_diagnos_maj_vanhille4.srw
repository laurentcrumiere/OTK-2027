global type w_diagnos_maj_vanhille4 from window
integer x = 5
integer y = 8
integer width = 2926
integer height = 1908
boolean titlebar = true
string title = "Page N° 4"
boolean controlmenu = true
windowtype windowtype = response!
long backcolor = 12632256
ole_photo033 ole_photo033
ole_photo032 ole_photo032
ole_photo031 ole_photo031
ole_photo030 ole_photo030
ole_photo029 ole_photo029
ole_photo028 ole_photo028
ole_photo027 ole_photo027
ole_photo026 ole_photo026
cb_fermer cb_fermer
end type
global w_diagnos_maj_vanhille4 w_diagnos_maj_vanhille4

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

event open;var_code_local = message.doubleparm


string vn,vm 
date vd
integer an, mois

select trim(nom)+' '+isnull(prenom,''),moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°4 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+")"

SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(2000)
end if

end event

