global w_diagnos_maj_leclercq1 w_diagnos_maj_leclercq1

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

mle_motif.text = RightTrim(mid(page,1,100))
mle_passe.text = RightTrim(mid(page,101,200))
mle_examen.text = RightTrim(mid(page,301,300))
mle_atm.text = RightTrim(mid(page,601,200))


em_poids.text = RightTrim(mid(page,801,6))
em_taille.text = RightTrim(mid(page,810,5))
em_mot_patient.text = RightTrim(mid(page,820,1))
em_mot_parent.text = RightTrim(mid(page,821,1))
end subroutine

event open;var_code_local = message.doubleparm

string vn
date vm

select trim(nom)+' '+isnull(prenom,''),date_naissance INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = date('00/00/0000')
end if

this.title = "Page diagnostique N°1 : "+vn+" - Né(e) le : " +string(vm)+ " - N° dossier : "+string(var_code_local)


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(5000)
end if

if len(page) < 5000 then
	page = page + space(5000 - len(page))
end if

init()

end event

