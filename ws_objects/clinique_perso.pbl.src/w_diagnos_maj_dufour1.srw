global w_diagnos_maj_dufour1 w_diagnos_maj_dufour1

type variables
double var_code_local 
String var_nom_local,moul_local
boolean modif
double zoom
string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

ddlb_praticien.selectitem(integer(mid(page,1,1)))

if mid(page,2,1) = "O" then
	cbx_motivation.checked = true
else
	cbx_motivation.checked = false
end if

//em_age.text = RightTrim(mid(page,3,2))

mle_hygiene.text = RightTrim(mid(page,5,60))

mle_generaux.text = RightTrim(mid(page,70,300))
mle_familliaux.text = RightTrim(mid(page,370,300))
mle_observations.text = RightTrim(mid(page,670,200))


end subroutine

event open;var_code_local = message.doubleparm

string vn,vm 

select trim(nom)+' '+isnull(prenom,''),moulage INTO :vn,:vm FROM patient WHERE code = :var_code_local ;

if isnull(vm) then
	vm = ""
end if

this.title = "Page N°1 - Diagnostic : "+vn+" - N° dossier : "+string(var_code_local)+" (Moulage : "+vm+")"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if

dw_1.settransobject(SQLCA)
dw_1.retrieve(var_code_local)

init()

end event

