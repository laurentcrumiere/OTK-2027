         ~"patient~".~"alveo_max_exo~",   
         ~"patient~".~"alveo_mand_endo~",   
         ~"patient~".~"alveo_mand_exo~",   
         ~"patient~".~"supraclusion~",   
         ~"patient~".~"infraclusion~",   
         ~"patient~".~"mol_cl1~",   
         ~"patient~".~"mol_cl2~",   
         ~"patient~".~"mol_cl3~",   
         ~"patient~".~"can_cl1~",   
         ~"patient~".~"can_cl2~",   
         ~"patient~".~"can_cl3~",   
         ~"patient~".~"molaire~",   
         ~"patient~".~"canine~",   
         ~"patient~".~"dento_max~",   
         ~"patient~".~"dento_dent~",   
         ~"patient~".~"agenesie~",   
         ~"patient~".~"surnum~",   
         ~"patient~".~"malposition~",   
         ~"patient~".~"occl_dte~",   
         ~"patient~".~"occl_gche~",   
         ~"patient~".~"occl_ant~",   
         ~"patient~".~"facteur~",   
         ~"patient~".~"extraction~",   
         ~"patient~".~"date_fin_tpi~",   
         ~"patient~".~"duree_traitement_unite~",   
         ~"patient~".~"barre_avancement~",   
         ~"patient~".~"code_comptable~",   
         (select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_correspondant) as nom_correspondant,   
         (select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_dentiste) as nom_dentiste,   
         (select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_medecin) as nom_autre1,   
         (select nom from dossier where dossier.code = patient.type_dossier) as nom_type_dossier,   
         (select nom from prati where prati.code = patient.code_praticien) as nom_praticien,   
         (select nom from caisse where caisse.code = patient.code_caisse) as nom_caisse,   
         (select nom from mutuelle where mutuelle.code = patient.code_mutuelle) as nom_mutuelle,   
         (select nom from ecole where ecole.code = patient.ecole) as nom_ecole,   
         (select nom from motif_fin_traitement where motif_fin_traitement.code = patient.motif_fin_traitement) as nom_motif_fin_traitement,   
         (select nom from qualite_traitement where qualite_traitement.code = patient.qualite_traitement) as nom_qualite_traitement,   
         (select nom from utilisateurs where utilisateurs.code = patient.user_modif) as nom_utilisateur_dernier_modif,   
         (select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_medecin2) as nom_autre2,   
         (select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_medecin3) as nom_autre3,   
         (select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_medecin4) as nom_autre4,   
         ~"patient~".~"autor_rdv_portail_patient~",   
         ~"patient~".~"message_borne~",   
         ~"patient~".~"rum~",   
         ~"patient~".~"code_mutuelle2~",   
         ~"patient~".~"autor_cloud~",   
         ~"patient~".~"alerte_confidentiel_img~",   
         ~"patient~".~"autor_appli_patient~",   
         ~"patient~".~"autor_appli_parent11~",   
         ~"patient~".~"autor_appli_parent12~",   
         ~"patient~".~"autor_appli_parent21~",   
         ~"patient~".~"autor_appli_parent22~",   
         ~"patient~".~"autor_appli_payeur1~",   
         ~"patient~".~"autor_appli_payeur2~",   
         ~"patient~".~"message_borne_conserver~",   
         ~"patient~".~"message_portail~",   
         ~"patient~".~"id_invisalign~"  
    FROM {oj ~"pays~" RIGHT OUTER JOIN ~"patient~" ON ~"pays~".~"code~" = ~"patient~".~"pays_parent1~"},   
         ~"prati~",   
         ~"correspondants~",   
         ~"dossier~"  
   WHERE ( ~"prati~".~"code~" = ~"patient~".~"code_praticien~" ) and  
         ( ~"correspondants~".~"code~" = ~"patient~".~"code_correspondant~" ) and  
         ( ~"dossier~".~"code~" = ~"patient~".~"type_dossier~" ) and  
         ( ( ~"patient~".~"date_modif~" >= :date_modif_limite ) )    
" arguments=(("date_modif_limite", date))  sort="nom A patient_prenom A " )
