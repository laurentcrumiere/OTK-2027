type cb_sauver from w_diagnos_maj_`cb_sauver within w_diagnos_maj_87504_1
integer x = 4498
integer y = 2640
end type

event cb_sauver::clicked;call super::clicked;// Mise à jour de la durée de traitement
integer duree_choisie

select duree_traitement
into :duree_choisie
from patient where patient.code = :var_code_local ;

if ddlb_duree.Text = '6 m' then duree_choisie = 1
if ddlb_duree.Text = '12 m' then duree_choisie = 2
if ddlb_duree.Text = '18 m' then duree_choisie = 3
if ddlb_duree.Text = '24 m' then duree_choisie = 4
if ddlb_duree.Text = '30 m' then duree_choisie = 5
if ddlb_duree.Text = '36 m' then duree_choisie = 6

Update patient
Set duree_traitement = :duree_choisie
Where patient.code = :var_code_local ;

// -----------------------------------------------------------------------------------------------------

string fact_fonc, agen, malpos

if (cbx_1.Checked = TRUE ) or (cbx_2.checked = true ) or (cbx_3.checked = true ) then
	fact_fonc = "Succion: "
	if (cbx_1.Checked = TRUE ) then fact_fonc = fact_fonc + "pouce, "
	if (cbx_2.Checked = TRUE ) then fact_fonc = fact_fonc + "lèvre, "
	if (cbx_3.Checked = TRUE ) then fact_fonc = fact_fonc + "langue "
end if

if (cbx_4.Checked = TRUE ) then fact_fonc = fact_fonc + " / Onychophagie"
if (cbx_5.Checked = TRUE ) then fact_fonc = fact_fonc + " / Bruxisme"
if (cbx_6.Checked = TRUE ) then fact_fonc = fact_fonc + " / Ronflement"



// Mise à jour des Facteurs Fonctionnels dans le Diagnostic patient

string	lstr_clas, lstr_fact, lstr_agen, lstr_malpos

char lc_bas_max_pro, lc_bas_max_ret, lc_bas_max_end, lc_bas_max_exo
char lc_bas_mand_pro, lc_bas_mand_ret
char lc_bas_hypo, lc_bas_hyper, lc_dys_dentm

char lc_alv_max_pro, lc_alv_max_ret, lc_alv_max_end, lc_alv_max_exo
char lc_alv_mand_pro, lc_alv_mand_ret
char lc_supra, lc_infra
char lc_oc_d, lc_oc_ant, lc_oc_g, lc_dys_dentd

char lc_can_cl1, lc_can_cl2, lc_can_cl3
string lc_can

char lc_mol_cl1, lc_mol_cl2, lc_mol_cl3
string lc_mol

// zone "diagnostic"
select classe, facteur, agenesie, malposition, alveo_max_pro, alveo_max_retro, alveo_max_endo, alveo_max_exo, alveo_mand_pro, alveo_mand_retro
, alveo_mand_endo, alveo_mand_exo, supraclusion, infraclusion, occl_dte, occl_gche, occl_ant
, basal_max_pro, basal_max_retro, basal_max_endo, basal_max_exo, basal_mand_pro, basal_mand_retro, hypodivergence, hyperdivergence
, dento_max, dento_dent, can_cl1, can_cl2, can_cl3, canine, mol_cl1, mol_cl2, mol_cl3, molaire
into :lstr_clas, :lstr_fact, :lstr_agen, :lstr_malpos, :lc_alv_max_pro, :lc_alv_max_ret, :lc_alv_max_end, :lc_alv_max_exo, :lc_alv_mand_pro, :lc_alv_mand_ret
, :lc_supra, :lc_infra, :lc_oc_d, :lc_oc_ant, :lc_oc_g, :lc_bas_max_pro, :lc_bas_max_ret, :lc_bas_max_end, :lc_bas_max_exo, :lc_bas_mand_pro
, :lc_bas_mand_ret, :lc_bas_hypo, :lc_bas_hyper, :lc_dys_dentm, :lc_dys_dentd, :lc_can_cl1, :lc_can_cl2, :lc_can_cl3, :lc_can
, :lc_mol_cl1, :lc_mol_cl2, :lc_mol_cl3, :lc_mol
from patient where patient.code = :var_code_local ;

// Ajout de la classe
if rb_ClI.checked = true then lstr_clas = "Classe I"
if rb_ClII.checked = true then lstr_clas = "Classe II"
if rb_ClII1.checked = true then lstr_clas = "Classe II 1"
if rb_ClII2.checked = true then lstr_clas = "Classe II 2"
if rb_ClIII.checked = true then lstr_clas = "Classe III"


// Ajout des commentaires du cadre "PARAFONCTIONS"
lstr_fact = fact_fonc

// Ajout des commentaires du cadre "DENTAIRE"
lstr_agen = sle_agen.text
lstr_malpos = sle_malpos.text

// Ajout des commentaires du cadre "DIAGNOSTIC"
// basal
if cbx_bas_max_pro.checked = true then lc_bas_max_pro ="X" else lc_bas_max_pro = "0"
if cbx_bas_max_retro.checked = true then lc_bas_max_ret ="X" else lc_bas_max_ret = "0"
if cbx_bas_max_endo.checked = true then lc_bas_max_end ="X" else lc_bas_max_end = "0"
if cbx_bas_max_exo.checked = true then lc_bas_max_exo ="X" else lc_bas_max_exo = "0"
if cbx_bas_mand_pro.checked = true then lc_bas_mand_pro ="X" else lc_bas_mand_pro = "0"
if cbx_bas_mand_retro.checked = true then lc_bas_mand_ret ="X" else lc_bas_mand_ret = "0"
if cbx_hypodiv.checked = true then lc_bas_hypo ="X" else lc_bas_hypo = "0"
if cbx_hyperdiv.checked = true then lc_bas_hyper ="X" else lc_bas_hyper = "0"
if cbx_dento_max.checked = true then lc_dys_dentm ="X" else lc_dys_dentm = "0"
// alvéolaire
if cbx_alv_max_pro.checked = true then lc_alv_max_pro ="X" else lc_alv_max_pro = "0"
if cbx_alv_max_retro.checked = true then lc_alv_max_ret ="X" else lc_alv_max_ret = "0"
if cbx_alv_max_endo.checked = true then lc_alv_max_end ="X" else lc_alv_max_end = "0"
if cbx_alv_max_exo.checked = true then lc_alv_max_exo ="X" else lc_alv_max_exo = "0"
if cbx_alv_mand_pro.checked = true then lc_alv_mand_pro ="X" else lc_alv_mand_pro = "0"
if cbx_alv_mand_retro.checked = true then lc_alv_mand_ret ="X" else lc_alv_mand_ret = "0"
if cbx_supra.checked = true then lc_supra ="X" else lc_supra = "0"
if cbx_infra.checked = true then lc_infra ="X" else lc_infra = "0"
if cbx_occl_d.checked = true then lc_oc_d ="X" else lc_oc_d = "0"
if cbx_occl_ant.checked = true then lc_oc_ant ="X" else lc_oc_ant = "0"
if cbx_occl_g.checked = true then lc_oc_g ="X" else lc_oc_g = "0"
if cbx_dento_dent.checked = true then lc_dys_dentd ="X" else lc_dys_dentd = "0"

// Classe dentaire molaire
if left(ddlb_molaire.text,1) = "1" then lc_mol_cl1 = "X"
if left(ddlb_molaire.text,1) = "2" then lc_mol_cl2 = "X"
if left(ddlb_molaire.text,1) = "3" then lc_mol_cl3 = "X"
if (len(ddlb_molaire.text) > 1) and (right(ddlb_molaire.text,1)) = "D" then lc_mol = "Droite"
if (len(ddlb_molaire.text) > 1) and (right(ddlb_molaire.text,1)) = "G" then lc_mol = "Gauche"


// Classe dentaire canine
if left(ddlb_canine.text,1) = "1" then lc_can_cl1 = "X"
if left(ddlb_canine.text,1) = "2" then lc_can_cl2 = "X"
if left(ddlb_canine.text,1) = "3" then lc_can_cl3 = "X"
if (len(ddlb_canine.text) > 1) and (right(ddlb_canine.text,1)) = "D" then lc_can = "Droite"
if (len(ddlb_canine.text) > 1) and (right(ddlb_canine.text,1)) = "G" then lc_can = "Gauche"

// Mise à jour des Facteurs Fonctionnels
Update patient
Set classe = :lstr_clas, facteur = :lstr_fact, agenesie = :lstr_agen, malposition = :lstr_malpos
Where patient.code = :var_code_local ;

// Mise à jour des Anomalies Alvéolaires
Update patient
Set alveo_max_pro = :lc_alv_max_pro , alveo_max_retro = :lc_alv_max_ret, alveo_max_endo = :lc_alv_max_end, alveo_max_exo = :lc_alv_max_exo
, alveo_mand_pro = :lc_alv_mand_pro, alveo_mand_retro = :lc_alv_mand_ret, supraclusion = :lc_supra, infraclusion = :lc_infra, occl_dte = :lc_oc_d
, occl_gche = :lc_oc_g, occl_ant = :lc_oc_ant, dento_dent = :lc_dys_dentd
Where patient.code = :var_code_local ;

// Mise à jour des Anomalies Basales
Update patient
Set basal_max_pro = :lc_bas_max_pro , basal_max_retro = :lc_bas_max_ret, basal_max_endo = :lc_bas_max_end, basal_max_exo = :lc_bas_max_exo
, basal_mand_pro = :lc_bas_mand_pro, basal_mand_retro = :lc_bas_mand_ret, hypodivergence = :lc_bas_hypo, hyperdivergence = :lc_bas_hyper
, dento_max = :lc_dys_dentm
Where patient.code = :var_code_local ;

// Mise à jour des Classes dentaires
Update patient
Set can_cl1 = :lc_can_cl1, can_cl2 = :lc_can_cl2, can_cl3 = :lc_can_cl3, canine = :lc_can, mol_cl1 = :lc_mol_cl1, mol_cl2 = :lc_mol_cl2
, mol_cl3 = :lc_mol_cl3, molaire = :lc_mol
Where patient.code = :var_code_local ;

commit ;


dw_diagnostic.accepttext()
dw_correspondant.accepttext()

// Mise à jour des zones pour myOrthokis
dw_diagnostic.setItem(1, "patient_traitement_effectue_html", dw_diagnostic.getitemString(1, "texte_brut_traitement_effectue"))
dw_diagnostic.setItem(1, "patient_plan_traitement_html", dw_diagnostic.getitemString(1, "texte_brut_plan_traitement"))

if dw_diagnostic.update() = 1 and dw_correspondant.update() = 1 then
	commit ;
	if sqlca.sqlcode <> 0 then
		Messagebox("ERREUR DANS LA MISE A JOUR N°"+string(sqlca.sqlcode),sqlca.sqlerrtext)
	end if
else
	rollback ;
end if



end event

