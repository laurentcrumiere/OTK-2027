global w_diagnos_maj_swartberg3 w_diagnos_maj_swartberg3

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();mle_syme.text = Righttrim(mid(page,1330,73))
mle_deglu.text = Righttrim(mid(page,1403,45))
mle_respi.text = Righttrim(mid(page,1448,73))

if mid(page,1521,1) = '1' OR mid(page,1521,1) = ' ' then
	rb_syme_ras.checked = true
else
	rb_syme.checked = true
end if

if mid(page,1522,1) = '1' OR mid(page,1522,1) = ' ' then
	rb_hab_ras.checked = true
else
	rb_hab_succ.checked = true
end if

if mid(page,1523,1) = '1' OR mid(page,1523,1) = ' ' then
	rb_deglu_ras.checked = true
else
	if mid(page,1523,1) = '2' then
		rb_deglu_pous.checked = true
	else
		rb_deglu_autre.checked = true
	end if
end if

if mid(page,1524,1) = '1' OR mid(page,1524,1) = ' ' then
	rb_phone_ras.checked = true
else
	rb_phone.checked = true
end if

if mid(page,1525,1) = '1' OR mid(page,1525,1) = ' ' then
	rb_respi_nasa.checked = true
else
	if mid(page,1525,1) = '2' then
		rb_respi_nasa_buca.checked = true
	else
		rb_respi_bucca.checked = true
	end if
end if

if mid(page,1526,1) = '1' OR mid(page,1526,1) = ' ' then
	rb_levre_ras.checked = true
else
	if mid(page,1526,1) = '2' then
		rb_levre_souv.checked = true
	else
		rb_levre_tjs.checked = true
	end if
end if

if mid(page,1527,1) = '1' OR mid(page,1527,1) = ' ' then
	rb_grinc_non.checked = true
else
	rb_grinc_oui.checked = true
end if

if mid(page,1528,1) = '1' OR mid(page,1528,1) = ' ' then
	rb_brux_non.checked = true
else
	rb_brux_oui.checked = true
end if

if mid(page,1529,1) = '1' OR mid(page,1529,1) = ' ' then
	rb_maux_non.checked = true
else
	rb_maux_oui.checked = true
end if

if mid(page,1530,1) = '1' OR mid(page,1530,1) = ' ' then
	rb_dou_non.checked = true
else
	rb_dou_oui.checked = true
end if

if mid(page,1531,1) = '1' OR mid(page,1531,1) = ' ' then
	rb_cra_non.checked = true
else
	rb_cra_oui.checked = true
end if

if mid(page,1532,1) = '1' OR mid(page,1532,1) = ' ' then
	rb_res_non.checked = true
else
	rb_res_oui.checked = true
end if

if mid(page,1533,1) = '1' OR mid(page,1533,1) = ' ' then
	rb_amp_nor.checked = true
else
	if mid(page,1533,1) = '2' then
		rb_amp_aug.checked = true
	else
		rb_amp_dim.checked = true
	end if
end if

modif = false
end subroutine

event open;
var_code_local = message.doubleparm

string vn,vm 
date vd
select nom,moulage,date_naissance INTO :vn,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if


this.title = "Page N°3 : "+vn+" - N° dossier : "+string(var_code_local)+ " - Date de naissance : " + string(vd,'dd/mm/yyyy') + " (Moulage : "+vm+")"



SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(4000)
end if

if len(page) < 4000 then
	page = page + space(4000 - len(page))
end if


init()


end event

