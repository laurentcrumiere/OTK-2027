string page
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();em_date1.text =  trim(mid(page,500,10))
em_date2.text =  trim(mid(page,534,10))

sle_deb1.text =  trim(mid(page,510,4))
sle_deb2.text =  trim(mid(page,514,4))
