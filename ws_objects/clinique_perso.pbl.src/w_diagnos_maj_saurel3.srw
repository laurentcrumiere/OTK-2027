mle_correction.text =  trim(mid(page,1200,154))
mle_finition.text =  trim(mid(page,1354,154))
mle_contention.text =  trim(mid(page,1508,241))

mle_squelv.text =  trim(mid(page,930,16))
mle_squels.text =  trim(mid(page,946,16))
mle_squelt.text =  trim(mid(page,962,16))

