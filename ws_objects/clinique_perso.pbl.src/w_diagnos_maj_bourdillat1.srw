global w_diagnos_maj_bourdillat1 w_diagnos_maj_bourdillat1

type variables
double var_code_local 
string page
boolean modif
end variables

forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();ddlb_antero_squel.selectitem(integer(mid(page,1,1)))
ddlb_vert_squel.selectitem(integer(mid(page,2,1)))
ddlb_trans_squel.selectitem(integer(mid(page,3,1)))
ddlb_antero_dent.selectitem(integer(mid(page,4,1)))
ddlb_vert_dent.selectitem(integer(mid(page,5,1)))
ddlb_trans_dent.selectitem(integer(mid(page,6,1)))
ddlb_g_mol.selectitem(integer(mid(page,7,1)))
ddlb_g_can.selectitem(integer(mid(page,8,1)))
ddlb_d_mol.selectitem(integer(mid(page,9,1)))
ddlb_d_can.selectitem(integer(mid(page,10,1)))
ddlb_mediane.selectitem(integer(mid(page,11,1)))
ddlb_atm.selectitem(integer(mid(page,12,1)))
ddlb_habitude.selectitem(integer(mid(page,13,1)))
ddlb_menton.selectitem(integer(mid(page,14,1)))
ddlb_slm.selectitem(integer(mid(page,15,1)))
ddlb_profil.selectitem(integer(mid(page,16,1)))
ddlb_paro.selectitem(integer(mid(page,17,1)))
ddlb_hygiene.selectitem(integer(mid(page,18,1)))
ddlb_squel.selectitem(integer(mid(page,19,1)))
ddlb_dent.selectitem(integer(mid(page,20,1)))
ddlb_esth.selectitem(integer(mid(page,21,1)))
ddlb_fonct.selectitem(integer(mid(page,22,1)))
ddlb_parent.selectitem(integer(mid(page,23,1)))
ddlb_enfant.selectitem(integer(mid(page,24,1)))
ddlb_orl.selectitem(integer(mid(page,25,1)))

if mid(page,26,1) = 'O' then
	cbx_langue.checked = true
else
	cbx_langue.checked = false
end if
if mid(page,27,1) = 'O' then
	cbx_levre_sup.checked = true
else
	cbx_levre_sup.checked = false
end if
if mid(page,28,1) = 'O' then
	cbx_levre_inf.checked = true
else
	cbx_levre_inf.checked = false
end if
if mid(page,29,1) = 'O' then
	cbx_autre.checked = true
else
	cbx_autre.checked = false
end if

em_largeur.text =  trim(mid(page,30,3))
em_ddm.text =  trim(mid(page,35,3))
em_leeway.text =  trim(mid(page,40,3))
em_total_ddm.text =  trim(mid(page,45,3))

em_accident.text = Righttrim(trim(mid(page,50,5)))
em_orthopho.text = Righttrim(trim(mid(page,55,5)))
em_allergies.text = Righttrim(trim(mid(page,60,5)))

em_heredite.text = Righttrim(mid(page,70,10))
em_antecedent.text = Righttrim(mid(page,80,10))
em_traitement.text = Righttrim(mid(page,90,10))

em_date_du_jour.text = Righttrim(mid(page,100,10))

IF mid(page,100,10) = space(10) THEN
	em_date_du_jour.text = string(today (),'dd/mm/yyyy')
END IF 

em_d_haut.text = Righttrim(mid(page,110,15))
em_g_haut.text = Righttrim(mid(page,125,15))
em_d_bas.text = Righttrim(mid(page,140,15))
em_g_bas.text = Righttrim(mid(page,165,15))

em_md_haut.text = Righttrim(mid(page,180,15))
em_mg_haut.text = Righttrim(mid(page,195,15))
em_md_bas.text = Righttrim(mid(page,210,15))
em_mg_bas.text = Righttrim(mid(page,225,15))

mle_col1.text =  trim(mid(page,300,50))
mle_col2.text =  trim(mid(page,400,50))
mle_col3.text =  trim(mid(page,500,50))

mle_pb.text = RightTrim(mid(page,600,50))
mle_anoter.text = Righttrim(trim(mid(page,650,150)))
//les diags des pages 1 et 2
	mle_diag.text = Righttrim(trim(mid(page,900,250)))
	
mle_motif.text = Righttrim(trim(mid(page,1150,250)))
mle_esthe.text = Righttrim(trim(mid(page,1400,250)))
mle_examen.text = Righttrim(trim(mid(page,1650,250)))
mle_obs.text = Righttrim(trim(mid(page,1900,250)))

em_articule.text = Righttrim(mid(page,250,10))

modif = false
cb_fermer.SetFocus()


end subroutine

event open;
var_code_local = message.doubleparm


string vn,vm,vp 
date vd
integer an, mois

select nom,prenom,moulage,date_naissance INTO :vn,:vp,:vm,:vd FROM patient WHERE code = :var_code_local ;
if isnull(vm) then
	vm = ""
end if
if isnull(vp) then
	vp = ""
end if

if (month(today()) < month( vd )) then
	an = year(today()) - year( vd ) - 1
ELSE
	an = year(today()) - year( vd )
END IF	

if (month(today()) < month( vd )) then
	mois = month(today()) - month( vd ) +12
ELSE
	mois = month(today()) - month( vd )
END IF

this.title = "Page N°1 : "+vn+" " +vp+" - N° dossier : "+string(var_code_local)+ " - Age : " + string(an) + " ans " + string(mois) + " mois " + " (Moulage : "+vm+") Praticien : BOURDILLAT"


SELECT perso INTO :page FROM diagnos WHERE code = :var_code_local ;

if isnull(page) then
	page = space(6000)
end if

if len(page) < 6000 then
	page = page + space(6000 - len(page))
end if

init()

end event

