event clicked;place(string(ddlb_antero_squel.FindItem(ddlb_antero_squel.text,1)),page,1)
place(string(ddlb_vert_squel.FindItem(ddlb_vert_squel.text,1)),page,2)
place(string(ddlb_trans_squel.FindItem(ddlb_trans_squel.text,1)),page,3)
place(string(ddlb_antero_dent.FindItem(ddlb_antero_dent.text,1)),page,4)
place(string(ddlb_vert_dent.FindItem(ddlb_vert_dent.text,1)),page,5)
place(string(ddlb_trans_dent.FindItem(ddlb_trans_dent.text,1)),page,6)
place(string(ddlb_g_mol.FindItem(ddlb_g_mol.text,1)),page,7)
place(string(ddlb_g_can.FindItem(ddlb_g_can.text,1)),page,8)
place(string(ddlb_d_mol.FindItem(ddlb_d_mol.text,1)),page,9)
place(string(ddlb_d_can.FindItem(ddlb_d_can.text,1)),page,10)
place(string(ddlb_mediane.FindItem(ddlb_mediane.text,1)),page,11)
place(string(ddlb_atm.FindItem(ddlb_atm.text,1)),page,12)
place(string(ddlb_habitude.FindItem(ddlb_habitude.text,1)),page,13)
place(string(ddlb_menton.FindItem(ddlb_menton.text,1)),page,14)
place(string(ddlb_slm.FindItem(ddlb_slm.text,1)),page,15)
place(string(ddlb_profil.FindItem(ddlb_profil.text,1)),page,16)
place(string(ddlb_paro.FindItem(ddlb_paro.text,1)),page,17)
place(string(ddlb_hygiene.FindItem(ddlb_hygiene.text,1)),page,18)
place(string(ddlb_squel.FindItem(ddlb_squel.text,1)),page,19)
place(string(ddlb_dent.FindItem(ddlb_dent.text,1)),page,20)
place(string(ddlb_esth.FindItem(ddlb_esth.text,1)),page,21)
place(string(ddlb_fonct.FindItem(ddlb_fonct.text,1)),page,22)
place(string(ddlb_parent.FindItem(ddlb_parent.text,1)),page,23)
place(string(ddlb_enfant.FindItem(ddlb_enfant.text,1)),page,24)
place(string(ddlb_orl.FindItem(ddlb_orl.text,1)),page,25)

if cbx_langue.checked then
	place("O",page,26)
else
	place("N",page,26)
end if
if cbx_levre_sup.checked then
	place("O",page,27)
else
	place("N",page,27)
end if
if cbx_levre_inf.checked then
	place("O",page,28)
else
	place("N",page,28)
end if
if cbx_autre.checked then
	place("O",page,29)
else
	place("N",page,29)
end if

place_avec_blancs(em_largeur.text,page,30,3)
place_avec_blancs(em_ddm.text,page,35,3)
place_avec_blancs(em_leeway.text,page,40,3)
place_avec_blancs(em_total_ddm.text,page,45,3)

place_avec_blancs(em_accident.text,page,50,5)
place_avec_blancs(em_orthopho.text,page,55,5)
place_avec_blancs(em_allergies.text,page,60,5)

place_avec_blancs(em_heredite.text,page,70,10)
place_avec_blancs(em_antecedent.text,page,80,10)
place_avec_blancs(em_traitement.text,page,90,10)
place_avec_blancs(em_date_du_jour.text,page,100,10)

place_avec_blancs(em_d_haut.text,page,110,15)
place_avec_blancs(em_g_haut.text,page,125,15)
place_avec_blancs(em_d_bas.text,page,140,15)
place_avec_blancs(em_g_bas.text,page,165,15)

place_avec_blancs(em_md_haut.text,page,180,15)
place_avec_blancs(em_mg_haut.text,page,195,15)
place_avec_blancs(em_md_bas.text,page,210,15)
place_avec_blancs(em_mg_bas.text,page,225,15)

place_avec_blancs(mle_col1.text,page,300,50)
place_avec_blancs(mle_col2.text,page,400,50)
place_avec_blancs(mle_col3.text,page,500,50)

place_avec_blancs(mle_pb.text,page,600,50)

place_avec_blancs(mle_anoter.text,page,650,150)
//pour diag des pages 1 et 2
	place_avec_blancs(mle_diag.text,page,900,250)

place_avec_blancs(mle_motif.text,page,1150,250)
place_avec_blancs(mle_esthe.text,page,1400,250)
place_avec_blancs(mle_examen.text,page,1650,250)
place_avec_blancs(mle_obs.text,page,1900,250)

place_avec_blancs(em_articule.text,page,250,10)

UPDATE diagnos SET perso = :page WHERE code = :var_code_local ;

if SQLCA.Sqlcode <> 0 then
	son(4)
	Messagebox("ERREUR BASE DE DONNEES (N°1)",SQLCA.SqlErrText)
else
	modif = false
	COMMIT ;
end if

end event

