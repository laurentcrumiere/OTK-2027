boolean visible = false
integer x = 3323
integer y = 1708
integer width = 137
integer height = 112
integer taborder = 370
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
