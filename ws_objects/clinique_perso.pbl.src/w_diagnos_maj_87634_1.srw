type em_date_exam from editmask within w_diagnos_maj_87634_1
integer x = 421
integer y = 32
integer width = 251
integer height = 48
integer taborder = 10
boolean bringtotop = true
integer textsize = -7
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string text = "none"
boolean border = false
alignment alignment = center!
maskdatatype maskdatatype = datemask!
string mask = "dd/mm/yyyy"
end type

event modified;modif = true



v_jour = date(em_date_exam.text)

IF isnull(v_date_naissance) then
	sle_age.text = "Date de naissance à renseigner !"
	sle_age.textcolor=RGB(255,0,0)
ELSE
	IF (month(v_jour) < month( v_date )) then
	 	patient_ans = year(v_jour) - year( v_date_naissance ) - 1
	ELSE
	 	patient_ans = year(v_jour) - year( v_date_naissance )
	END IF	

	IF (month(v_jour) < month( v_date_naissance )) then
		patient_mois = month(v_jour) - month( v_date_naissance ) +12
	ELSE
		patient_mois = month(v_jour) - month( v_date_naissance )
	END IF
	sle_age.text = string( patient_ans) + " ans " + string(patient_mois) + " mois "
	sle_age.textcolor=RGB(0,0,0)
END IF




end event

