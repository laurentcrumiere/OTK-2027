global type m_breadcrumbmenu from menu
end type
global m_breadcrumbmenu m_breadcrumbmenu

type variables
u_cst_breadcrumb_toolbar iuo_parent
end variables

on m_breadcrumbmenu.create
m_breadcrumbmenu=this
call super::create
this.text = "m_breadcrumbmenu"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 134217732
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
end on

on m_breadcrumbmenu.destroy
call super::destroy
end on

event clicked;iuo_parent.EVENT ue_buttonclicked(THIS.Text, Long(tag))
end event

