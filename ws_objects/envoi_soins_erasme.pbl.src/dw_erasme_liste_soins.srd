table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=date updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" )
 column=(type=date updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" )
 column=(type=date updatewhereclause=yes name=relance dbname="patient.relance" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=char(30) updatewhereclause=yes name=prenom dbname="patient.prenom" )
 column=(type=char(10) updatewhereclause=yes name=moulage dbname="patient.moulage" )
 column=(type=date updatewhereclause=yes name=fin_traitement dbname="patient.fin_traitement" )
 column=(type=date updatewhereclause=yes name=date_moulage dbname="patient.date_moulage" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" initial="null" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=soins_numero dbname="soins.numero" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=soins_date_cara dbname="soins.date_cara" )
 column=(type=number updatewhereclause=yes key=yes name=soins_cle dbname="soins.cle" initial="zero" )
 column=(type=number updatewhereclause=yes key=yes name=soins_code dbname="soins.code" )
 column=(type=date updatewhereclause=yes name=soins_date_exe dbname="soins.date_exe" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" )
 column=(type=char(10) updatewhereclause=yes name=soins_type dbname="soins.type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_hn dbname="soins.hn" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"code_soins~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.fin_traitement~") COLUMN(NAME=~"patient.date_moulage~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"soins.date_cara~") COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"soins.date_exe~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"soins.hn~")    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_cara~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_exe~~~"~"   OP =~"<=~"    EXP2 =~"today(*)~" ) ) " update="soins" updatewhere=0 updatekeyinplace=yes  sort="nom A prenom A code A " )
