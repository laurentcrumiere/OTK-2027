$PBExportHeader$init_fonds_et_boutons.srf
global type init_fonds_et_boutons from function_object
end type

forward prototypes
global subroutine init_fonds_et_boutons ()
end prototypes

global subroutine init_fonds_et_boutons ();

string v_fond, v_bouton
v_fond = profilestring(dir_ini+inifile_orthokis,"COULEURS","image_fond_fenetres","Aucune")

if trim(v_fond) <> "Aucune" and v_fond <> "" then
	image_fond_fenetre = dir_ini + dir_fonds + v_fond + ".jpg"
else
	image_fond_fenetre = ""
end if


