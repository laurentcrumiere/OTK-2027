global function string nom_theme_2020 (integer index);choose case index
	case 1
		return "BLUE"
	case 2
		return "OLIVE"
	case 3
		return "SILVER"
	case 4
		return "CLASSIC"
	case 5
		return "BLACK"
	case 6
