$PBExportHeader$centrer_selon_fenetre.srf
$PBExportComments$Shani 1.0 / Centre une fenêtre de type Message
global type centrer_selon_fenetre from function_object
end type

forward prototypes
global subroutine centrer_sheet (window fenetre)
global subroutine centrer_selon_fenetre (window v_fenetre_fille, window v_fenetre_mere)
end prototypes

global subroutine centrer_sheet (window fenetre);// Centre une fenêtre de type Message

double haut,larg
environment env

GetEnvironment(env)
	
// Récupération de la taille de l'écran
larg = PixelsToUnits(env.ScreenWidth,XPixelsToUnits!)
haut = PixelsToUnits(env.ScreenHeight,YPixelsToUnits!)

// Ajustement de la fenêtre au centre de l'écran
fenetre.x = (larg - fenetre.Width) / 2
fenetre.y = (haut - fenetre.Height) / 2


end subroutine

global subroutine centrer_selon_fenetre (window v_fenetre_fille, window v_fenetre_mere);// Centre une fenêtre de type sheet , dans une mdi mdi

double haut,larg

	
// Récupération de la taille de l'écran
larg = v_fenetre_mere.width
haut =  v_fenetre_mere.height

// Ajustement de la fenêtre au centre de l'écran
v_fenetre_fille.x = (larg - v_fenetre_fille.Width) / 2
v_fenetre_fille.y = (haut - v_fenetre_fille.Height) / 2


end subroutine

