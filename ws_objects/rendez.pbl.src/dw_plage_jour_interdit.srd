table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_debut dbname="jours_interdits.date_debut" dbalias=".date_debut" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_fin dbname="jours_interdits.date_fin" dbalias=".date_fin" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=fauteuil_debut dbname="jours_interdits.fauteuil_debut" dbalias=".fauteuil_debut" initial="0" )
