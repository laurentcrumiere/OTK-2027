 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"jours_interdits~" ) COLUMN(NAME=~"jours_interdits.date_debut~") COLUMN(NAME=~"jours_interdits.date_fin~") COLUMN(NAME=~"jours_interdits.fauteuil_debut~") COLUMN(NAME=~"jours_interdits.fauteuil_fin~") COLUMN(NAME=~"jours_interdits.code_praticien~") COLUMN(NAME=~"jours_interdits.commentaire~")WHERE(    EXP1 =~":numero_fauteuil~"   OP =~"between~"    EXP2 =~"~~~"jours_interdits~~~".~~~"fauteuil_debut~~~" and ~~~"jours_interdits~~~".~~~"fauteuil_fin~~~"~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"jours_interdits~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":code_praticien_de and :code_praticien_a~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"jours_interdits~~~".~~~"date_debut~~~"~"   OP =~"between~"    EXP2 =~":debut_plage_libre and :fin_plage_libre~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"jours_interdits~~~".~~~"date_fin~~~"~"   OP =~"between~"    EXP2 =~":debut_plage_libre and :fin_plage_libre~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"jours_interdits~~~".~~~"date_debut~~~"~"   OP =~"<~"    EXP2 =~":debut_plage_libre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"jours_interdits~~~".~~~"date_fin~~~"~"   OP =~">~"    EXP2 =~":fin_plage_libre))~" ) ) ARG(NAME = ~"debut_plage_libre~" TYPE = datetime)  ARG(NAME = ~"fin_plage_libre~" TYPE = datetime)  ARG(NAME = ~"numero_fauteuil~" TYPE = number)  ARG(NAME = ~"code_praticien_de~" TYPE = string)  ARG(NAME = ~"code_praticien_a~" TYPE = string) " update="jours_interdits" updatewhere=1 updatekeyinplace=no arguments=(("debut_plage_libre", datetime),("fin_plage_libre", datetime),("numero_fauteuil", number),("code_praticien_de", string),("code_praticien_a", string)) )
