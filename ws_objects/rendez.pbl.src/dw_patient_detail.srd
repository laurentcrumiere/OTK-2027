 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"rdv_serie~" )  TABLE(NAME=~"mise_en_evidence~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"patient.somme_due~") COLUMN(NAME=~"patient.date_proc_reglt~") COLUMN(NAME=~"patient.mont_proc_reglt~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.prochain_rdv~") COLUMN(NAME=~"patient.prochain_rdv_tps~") COLUMN(NAME=~"patient.prochain_rdv_nb~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"patient.cmu~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.couleur1~") COLUMN(NAME=~"titre_personnes.nom~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.teldom2_parent1~") COLUMN(NAME=~"patient.teltra2_parent1~") COLUMN(NAME=~"patient.portable2_parent1~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.code~") COMPUTE(NAME=~" (SELECT max(dat)  FROM coment WHERE coment.code = patient.code and dat <= cast(getdate() as date) ) as Date_com~") COMPUTE(NAME=~" (select top 1 com  FROM coment WHERE  coment.code = patient.code order by dat desc, ordre desc) as Dern_com~") COMPUTE(NAME=~" (select top 1 acte_prevu  FROM coment WHERE coment.code = patient.code order by dat desc, ordre desc) as Dern_prevu~") COLUMN(NAME=~"patient.date_validite_cmu~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.code_dentiste~") COLUMN(NAME=~"patient.code_caisse~") COLUMN(NAME=~"patient.code_mutuelle~") COLUMN(NAME=~"patient.code_medecin~") COLUMN(NAME=~"patient.ecole~") COLUMN(NAME=~"patient.classe_scolaire~") COLUMN(NAME=~"patient.remarques~") COLUMN(NAME=~"patient.prochain_rdv_t_ou_s~") COLUMN(NAME=~"rdv_serie.libelle~") COLUMN(NAME=~"patient.pays_parent1~") COLUMN(NAME=~"mise_en_evidence.nom~") COLUMN(NAME=~"patient.portable_patient~") COLUMN(NAME=~"table_vide.d1~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COMPUTE(NAME=~" (SELECT max(~~~"date~~~") FROM coment_admini WHERE coment_admini.code = patient.code and ~~~"date~~~" <= cast(getdate() as date) ) as Date_com_admini~") COLUMN(NAME=~"patient.couleur2~") COLUMN(NAME=~"patient.mode_reglement_habituel~") COMPUTE(NAME=~"(select top 1 intervenant  FROM coment_admini WHERE  coment_admini.code = patient.code order by ~~~"date~~~" desc) as Dern_inter_admini~") COMPUTE(NAME=~" (select top 1 intervenant FROM coment WHERE  coment.code = patient.code order by dat desc, ordre desc) as Dern_inter~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.comtel1_parent1~") COLUMN(NAME=~"patient.comtel2_parent1~") COLUMN(NAME=~"patient.secu_patient~") COLUMN(NAME=~"patient.nom_parent1~") COMPUTE(NAME=~" (SELECT max(texte)  FROM coment_admini WHERE ~~~"date~~~" = (SELECT max(~~~"date~~~") FROM coment_admini WHERE coment_admini.code = patient.code and ~~~"date~~~" <= cast(getdate() as date) ) and coment_admini.code = patient.code ) as Dern_com_admini~") COMPUTE(NAME=~" (SELECT max(prevu)  FROM coment_admini WHERE ~~~"date~~~" = (SELECT max(~~~"date~~~") FROM coment_admini WHERE coment_admini.code = patient.code and ~~~"date~~~" <= cast(getdate() as date) ) and coment_admini.code = patient.code ) as Dern_prevu_admini~") COLUMN(NAME=~"patient.remarques_cliniques~") COLUMN(NAME=~"patient.vaccine_covid_19~") COLUMN(NAME=~"patient.assure~") COMPUTE(NAME=~"(SELECT v1 from table_vide) as fichier_photo_identite~") COLUMN(NAME=~"patient.champ_reprise3~") COMPUTE(NAME=~"(select isnull(langue.flag, '') from langue where patient.langue1 = langue.code) as flag1~") COMPUTE(NAME=~"(select isnull(langue.flag, '') from langue where patient.langue2 = langue.code) as flag2~") COLUMN(NAME=~"patient.langue1~") COLUMN(NAME=~"patient.langue2~") COLUMN(NAME=~"patient.sexe~") COLUMN(NAME=~"patient.couleur3~") COLUMN(NAME=~"patient.couleur4~")    JOIN (LEFT=~"patient.prochain_rdv~"    OP =~"=~"RIGHT=~"type_rdv.code~"    OUTER1 =~"patient.prochain_rdv~" )    JOIN (LEFT=~"patient.titre_patient~"    OP =~"=~"RIGHT=~"titre_personnes.code~"    OUTER1 =~"patient.titre_patient~" )    JOIN (LEFT=~"patient.prochain_rdv_serie~"    OP =~"=~"RIGHT=~"rdv_serie.code~"    OUTER1 =~"patient.prochain_rdv_serie~" )    JOIN (LEFT=~"patient.mise_en_evidence~"    OP =~"=~"RIGHT=~"mise_en_evidence.code~"    OUTER1 =~"patient.mise_en_evidence~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code~" ) ) ARG(NAME = ~"var_code~" TYPE = number)  ARG(NAME = ~"forme~" TYPE = string)  ARG(NAME = ~"couleur~" TYPE = string)  ARG(NAME = ~"epaisseur~" TYPE = number) " arguments=(("var_code", number),("forme", string),("couleur", string),("epaisseur", number)) )
