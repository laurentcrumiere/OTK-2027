table(column=(type=long updatewhereclause=yes name=nombre dbname="nombre" )
 column=(type=long updatewhereclause=yes name=ordre_trie dbname="type_rdv.ordre_trie" dbalias=".ordre_trie" )
 column=(type=long updatewhereclause=yes name=actif dbname="type_rdv.actif" dbalias=".actif" )
 column=(type=char(40) updatewhereclause=yes name=symbole dbname="type_rdv.symbole" dbalias=".symbole" )
 column=(type=char(40) updatewhereclause=yes name=couleur dbname="type_rdv.couleur" dbalias=".couleur" )
 column=(type=char(30) updatewhereclause=yes name=nom dbname="type_rdv.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=duree dbname="type_rdv.duree" dbalias=".duree" )
 column=(type=decimal(0) updatewhereclause=yes name=duree_totale dbname="duree_totale" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"type_rdv~" ) COMPUTE(NAME=~"(select isnull(count(*),0) as nombre from rdv, etat_rdv where rdv.code = :var_code_local and rdv.~~~"type~~~" = type_rdv.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' and cast(~~~"rdv~~~".~~~"rdv~~~" as date ) <= cast(getdate() as date) )~") COLUMN(NAME=~"type_rdv.ordre_trie~") COLUMN(NAME=~"type_rdv.actif~") COLUMN(NAME=~"type_rdv.symbole~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"type_rdv.duree~") COMPUTE(NAME=~"(select isnull(sum(duree),0) as duree_totale from rdv, etat_rdv where rdv.code = :var_code_local and rdv.~~~"type~~~" = type_rdv.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' and cast(~~~"rdv~~~".~~~"rdv~~~" as date ) <= cast(getdate() as date) )~")) ARG(NAME = ~"var_code_local~" TYPE = number) " filter=" nombre > 0"arguments=(("var_code_local", number))  sort="ordre_trie A nom A " )
