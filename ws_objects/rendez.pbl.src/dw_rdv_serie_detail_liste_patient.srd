 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdv_serie_detail~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"type_rdv~" ) COLUMN(NAME=~"rdv_serie_detail.type_rdv~") COLUMN(NAME=~"rdv_serie_detail.type_delai~") COLUMN(NAME=~"rdv_serie_detail.nb_delai~") COLUMN(NAME=~"rdv_serie_detail.unite_delai~") COLUMN(NAME=~"rdv_serie_detail.code_serie~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"rdv_serie_detail.ordre~") COLUMN(NAME=~"type_rdv.nom~") COMPUTE(NAME=~"(select table_vide.d1 from table_vide) as delai_absolu~")    JOIN (LEFT=~"rdv_serie_detail.type_rdv~"    OP =~"=~"RIGHT=~"type_rdv.code~" )WHERE(    EXP1 =~"~~~"rdv_serie_detail~~~".~~~"code_serie~~~"~"   OP =~"=~"    EXP2 =~":v_code_serie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":v_code_patient~" ) ) ARG(NAME = ~"v_code_patient~" TYPE = number)  ARG(NAME = ~"v_code_serie~" TYPE = number) " arguments=(("v_code_patient", number),("v_code_serie", number))  sort="ordre A " )
