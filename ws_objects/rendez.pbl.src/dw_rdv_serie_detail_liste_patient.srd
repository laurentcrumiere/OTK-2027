 column=(type=char(1) update=yes updatewhereclause=yes name=type_delai dbname="rdv_serie_detail.type_delai" dbalias=".type_delai" initial="D" values="% Début de Traitement	D/% Rdv Précédent	P/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=nb_delai dbname="rdv_serie_detail.nb_delai" dbalias=".nb_delai" initial="1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=unite_delai dbname="rdv_serie_detail.unite_delai" dbalias=".unite_delai" initial="S" values="Jours	J/Semaines	S/Mois	M/Années	A/" )
 column=(type=number update=yes updatewhereclause=yes name=code_serie dbname="rdv_serie_detail.code_serie" dbalias=".code_serie" )
