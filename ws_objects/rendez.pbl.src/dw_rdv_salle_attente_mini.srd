 column=(type=char(30) updatewhereclause=yes name=etat_rdv_nom dbname="etat_rdv.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=etat_rdv_couleur dbname="etat_rdv.couleur" dbalias=".couleur" )
 column=(type=time update=yes updatewhereclause=yes name=rdv_arrivee dbname="rdv.arrivee" dbalias=".arrivee" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" dbalias=".couleur" )
 column=(type=char(6) updatewhereclause=yes name=type_rdv_code dbname="type_rdv.code" dbalias=".code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) updatewhereclause=yes name=etat_rdv_code dbname="etat_rdv.code" dbalias=".code" )
 column=(type=char(2) updatewhereclause=yes name=dossier_code dbname="dossier.code" dbalias=".code" )
 column=(type=char(1) updatewhereclause=yes name=due dbname="param.vide" dbalias=".vide" )
 column=(type=char(6) updatewhereclause=yes name=rdv_user_modif dbname="rdv.user_modif" dbalias=".user_modif" )
 column=(type=datetime updatewhereclause=yes name=rdv_date_modif dbname="rdv.date_modif" dbalias=".date_modif" )
 column=(type=time updatewhereclause=yes name=min_arrivee dbname="min_arrivee" )
 column=(type=decimal(0) updatewhereclause=yes name=min_ecart_heure_courante dbname="min_ecart_heure_courante" )
 column=(type=decimal(0) updatewhereclause=yes name=ecart_heure_courante dbname="ecart_heure_courante" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(1) updatewhereclause=yes name=etat_rdv_salle_attente dbname="etat_rdv.salle_attente" dbalias=".salle_attente" )
 column=(type=char(1) updatewhereclause=yes name=patient_adulte dbname="patient.adulte" dbalias=".adulte" )
 column=(type=char(1) updatewhereclause=yes name=meme_famille dbname="table_vide.v1" dbalias=".v1" )
 column=(type=number updatewhereclause=yes name=rdv_code_interne dbname="rdv.code_interne" dbalias=".code_interne" )
 column=(type=number updatewhereclause=yes name=patient_couleur1 dbname="patient.couleur1" dbalias=".couleur1" )
 column=(type=number updatewhereclause=yes name=patient_couleur2 dbname="patient.couleur2" dbalias=".couleur2" )
 column=(type=char(2) updatewhereclause=yes name=patient_mise_en_evidence dbname="patient.mise_en_evidence" dbalias=".mise_en_evidence" )
 column=(type=date updatewhereclause=yes name=patient_date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=number updatewhereclause=yes name=patient_couleur3 dbname="patient.couleur3" dbalias=".couleur3" )
 column=(type=number updatewhereclause=yes name=patient_couleur4 dbname="patient.couleur4" dbalias=".couleur4" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"dossier~" )  TABLE(NAME=~"etat_rdv~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"patient.type_dossier~") COMPUTE(NAME=~"getdate() as heure_serveur~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"rdv.code~") COLUMN(NAME=~"etat_rdv.nom~") COLUMN(NAME=~"etat_rdv.couleur~") COLUMN(NAME=~"rdv.arrivee~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"type_rdv.code~") COLUMN(NAME=~"etat_rdv.code~") COLUMN(NAME=~"dossier.code~") COLUMN(NAME=~"param.vide~") COLUMN(NAME=~"rdv.user_modif~") COLUMN(NAME=~"rdv.date_modif~") COMPUTE(NAME=~"(select min(~~~"rdv2~~~".~~~"arrivee~~~") as min_arrivee from ~~~"rdv~~~" as ~~~"rdv2~~~" where cast(~~~"rdv2~~~".~~~"rdv~~~" as date) = :var_date and ~~~"rdv2~~~".~~~"absent~~~" = 'S' and ~~~"rdv2~~~".~~~"code_praticien~~~" between :prat_min and :prat_max and ~~~"rdv2~~~".~~~"fauteuil~~~" between :f_min and :f_max )~") COMPUTE(NAME=~"( select min (abs (datediff (minute, getdate(), rdv2.rdv)) * 1000 + datediff (minute, getdate(), rdv2.arrivee)  ) as min_ecart_heure_courante from ~~~"rdv~~~" as ~~~"rdv2~~~" where cast(~~~"rdv2~~~".~~~"rdv~~~" as date) = :var_date and ~~~"rdv2~~~".~~~"absent~~~" = 'S' and ~~~"rdv2~~~".~~~"code_praticien~~~" between :prat_min and :prat_max and ~~~"rdv2~~~".~~~"fauteuil~~~" between :f_min and :f_max )~") COMPUTE(NAME=~"abs ( datediff (minute, getdate(), rdv.rdv) ) * 1000 + datediff (minute, getdate(), rdv.arrivee) as ecart_heure_courante~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"etat_rdv.salle_attente~") COLUMN(NAME=~"patient.adulte~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"rdv.code_interne~") COLUMN(NAME=~"patient.couleur1~") COLUMN(NAME=~"patient.couleur2~") COLUMN(NAME=~"patient.mise_en_evidence~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.couleur3~") COLUMN(NAME=~"patient.couleur4~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"rdv.code~" )    JOIN (LEFT=~"rdv.type~"    OP =~"=~"RIGHT=~"type_rdv.code~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )    JOIN (LEFT=~"etat_rdv.code~"    OP =~"=~"RIGHT=~"rdv.absent~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"fauteuil~~~"~"   OP =~"between~"    EXP2 =~":f_min and :f_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cast(~~~"rdv~~~".~~~"rdv~~~" as date)~"   OP =~"=~"    EXP2 =~":var_date~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"elimine~~~"~"   OP =~"<>~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"salle_attente~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"var_date~" TYPE = date)  ARG(NAME = ~"f_min~" TYPE = number)  ARG(NAME = ~"f_max~" TYPE = number)  ARG(NAME = ~"alerte_dep~" TYPE = number)  ARG(NAME = ~"lim_dep_min~" TYPE = date)  ARG(NAME = ~"lim_dep_max~" TYPE = date)  ARG(NAME = ~"alerte_retard~" TYPE = number)  ARG(NAME = ~"souligner_adulte~" TYPE = string) " arguments=(("prat_min", string),("prat_max", string),("var_date", date),("f_min", number),("f_max", number),("alerte_dep", number),("lim_dep_min", date),("lim_dep_max", date),("alerte_retard", number),("souligner_adulte", string))  sort="rdv_rdv A patient_nom_cherche A rdv_code A rdv_fauteuil A " )
