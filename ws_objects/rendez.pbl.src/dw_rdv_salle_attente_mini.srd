table(column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" dbalias=".nom" )
 column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" dbalias=".rdv" initial="today" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_duree dbname="rdv.duree" dbalias=".duree" )
 column=(type=char(6) updatewhereclause=yes name=rdv_code_praticien dbname="rdv.code_praticien" dbalias=".code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_fauteuil dbname="rdv.fauteuil" dbalias=".fauteuil" )
 column=(type=number updatewhereclause=yes identity=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(6) update=yes updatewhereclause=yes name=rdv_absent dbname="rdv.absent" dbalias=".absent" initial="N" )
