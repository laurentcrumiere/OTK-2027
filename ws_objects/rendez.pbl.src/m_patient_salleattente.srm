global m_patient_salleattente m_patient_salleattente

forward prototypes
public function integer gestion_des_droits_salleattente ()
end prototypes

public function integer gestion_des_droits_salleattente ();//fx publique pour la Gestion suplémentaire des droits d'accés
//prend en compte les droit du menu hérité puis ceux rajoutés
//revoie -1 si pb
//renvoie 1 si OK



if gestion_des_droits() <> 1 then return -1


// Gestion des icones ...
if profilestring(dir_ini+inifile_orthokis,"UI_V2020","icones_2022","N") = "O" then
	
	this.m_agendagraphique.MenuImage	 =  icone_agenda_16

end if



///////////////////////////////////////////////////////////////////////////

//selon possession des modules

//module agenda graph
this.m_agendagraphique.enabled = rdv_graph

///////////////////////////////////////////////////////////////////////////

//selon droits utilisateurs

// Agenda Graphique
if droits_acces[16] = 'N'  then 
	this.m_agendagraphique.enabled = false
end if

// Rendez-vous 
if droits_acces[16] = 'N' then
	this.m_heurearrivee.enabled = false
	this.m_annulerarrivee.enabled = false
end if


// Annonce video en salle d'attente
this.m_annoncerensalledattente.enabled = video

//pas de gestion d'erreur
return 1
end function

on m_patient_salleattente.create
m_patient_salleattente=this
call super::create
this.text = "m_patient_salleattente"
this.toolbarstyle = contemporarytoolbar!
this.m_agendagraphique=create m_agendagraphique
this.m_6=create m_6
this.m_heurearrivee=create m_heurearrivee
this.m_annulerarrivee=create m_annulerarrivee
this.m_ticketderendezvous=create m_ticketderendezvous
this.m_-1=create m_-1
this.m_annoncerensalledattente=create m_annoncerensalledattente
this.m_-2=create m_-2
this.m_historiquedesetats=create m_historiquedesetats
this.m_5=create m_5
this.m_1=create m_1
this.m_salledattenteparametrable=create m_salledattenteparametrable
this.Item[UpperBound(this.Item)+1]=this.m_agendagraphique
this.Item[UpperBound(this.Item)+1]=this.m_6
this.Item[UpperBound(this.Item)+1]=this.m_heurearrivee
this.Item[UpperBound(this.Item)+1]=this.m_annulerarrivee
this.Item[UpperBound(this.Item)+1]=this.m_ticketderendezvous
this.Item[UpperBound(this.Item)+1]=this.m_-1
this.Item[UpperBound(this.Item)+1]=this.m_annoncerensalledattente
this.Item[UpperBound(this.Item)+1]=this.m_-2
this.Item[UpperBound(this.Item)+1]=this.m_historiquedesetats
this.Item[UpperBound(this.Item)+1]=this.m_5
this.Item[UpperBound(this.Item)+1]=this.m_1
this.Item[UpperBound(this.Item)+1]=this.m_salledattenteparametrable
end on

on m_patient_salleattente.destroy
call super::destroy
destroy(this.m_agendagraphique)
destroy(this.m_6)
destroy(this.m_heurearrivee)
destroy(this.m_annulerarrivee)
destroy(this.m_ticketderendezvous)
destroy(this.m_-1)
destroy(this.m_annoncerensalledattente)
destroy(this.m_-2)
destroy(this.m_historiquedesetats)
destroy(this.m_5)
destroy(this.m_1)
destroy(this.m_salledattenteparametrable)
end on

event clicked;call super::clicked;if this.checked then 
	w_rdv_salle_attente.dw_liste.object.nom_fauteuil.visible = 0
	this.checked = false
else
	w_rdv_salle_attente.dw_liste.object.nom_fauteuil.visible = 1
	this.checked = true
end if
end event

