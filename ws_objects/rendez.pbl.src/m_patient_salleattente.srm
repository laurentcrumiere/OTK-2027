event clicked;// Réinitialisation des valeurs pour avoir une salle propre
	
	Setprofilestring(dir_ini+inifile_orthokis,"rendez-vous","ordre_colonnes_salle_attente_parametrable","patient_mise_en_evidence=101,date=215,patient_nom_cherche=859,patient_numero_dossier=425,rdv_code_praticien=443,type_rdv_nom=800,rdv_duree=142,rdv_fauteuil=96,rdv_absent=526,dossier_code=553,rdv_arrivee=192,oval_retard=114")
	SetProfilestring(dir_ini+inifile_orthokis,"rendez-vous","largeur_colonnes_salle_attente_parametrable", " 00101 00215 00859 00425 00443 00800 00142 00096 00526 00553 00192 00114 00128 00517 00297 00247")
	SetProfilestring(dir_ini+inifile_orthokis,"rendez-vous","visibilite_colonnes_salle_attente_parametrable", "1111111111111000")

	w_rdv_salle_attente.triggerevent(open!)
	w_rdv_salle_attente.cb_rafraichir.triggerevent(clicked!)
end event

