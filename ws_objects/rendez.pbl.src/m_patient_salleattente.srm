type m_annoncerensalledattente from menu within m_patient_salleattente
end type

event clicked;if not WAIT_AND_SMILE then
	openwithparm(w_confirmation_annonce_salle, CodePatientCourant)
else
	
	// Envoi du message à Neotess
	uo_wait_and_smile uo_wait
	
	uo_wait = create uo_wait_and_smile
	
	uo_wait.appeler_patient(CodePatientCourant)
		
	
end if
end event

