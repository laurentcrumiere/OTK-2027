type m_ticketderendezvous from menu within m_patient_salleattente
end type

event clicked;if dw_click.rowcount() > 0 then
	
	double v_code_patient
	datetime v_rdv

	v_code_patient = dw_click.getItemNumber(dw_click.getrow(), "patient_code")
	v_rdv = dw_click.getItemDatetime(dw_click.getrow(), "rdv_rdv")
	
	// Mise en place du user objet utile pour impression mais avec coordonnées pour le masquer
	w_rdv_salle_attente.OpenUserObject(uo_edition_rtf, 30000, 30000)
	Impression_ticket_rdv (v_code_patient, v_rdv, uo_edition_rtf, false)

	
end if
end event

