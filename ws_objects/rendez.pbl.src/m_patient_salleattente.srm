type m_heurearrivee from menu within m_patient_salleattente
event clicked ( )
end type

event clicked;var_code = dw_click.getitemnumber(dw_click.getrow(),"patient_code")
var_nom = dw_click.getitemstring(dw_click.getrow(),"patient_nom_cherche")
var_nomp = ""
var_pay = ""
var_moul = ""

// On récupère l'heure du serveur
datetime heure_serveur

SELECT getdate() INTO :heure_serveur FROM "param" ;

dw_click.Setitem(dw_click.getrow(),"rdv_arrivee",time(heure_serveur))


// On vérifie les retards de chaque ligne pour les état de RDV automatique
// On a le meme scrpit dans le bouton "enregistrer" de la salle d'attente

// On ne vérifie le retard que si l'état est à 'N' (code par défgaut) AVANT

if 	dw_click.GetitemString(dw_click.getrow(),"rdv_absent") = 'N' then


	time heure_arrivee, heure_prevue
	long retard
	string etat_rdv
	heure_arrivee = dw_click.getitemtime(dw_click.getrow(),"rdv_arrivee")
	heure_prevue= time(dw_click.getitemDateTime(dw_click.getrow(),"rdv_rdv"))
	
	retard = secondsAfter(heure_prevue , heure_arrivee ) / 60
	
	if retard > 0 then
		// On recherche s'il y a un état de RDV pour ce retard
		SELECT min(code) INTO :etat_rdv FROM etat_rdv  WHERE :retard between retard_mini and retard_maxi and actif = 1;
		if sqlca.sqlcode = 0 and not isnull(etat_rdv) then
			// Un code trouvé ...
			dw_click.Setitem(dw_click.getrow(),"rdv_absent",etat_rdv)
		end if
	end if
end if
//----------------------------------------------------------------------------------------------------------------------------------------------------


if dw_click.update() = 1 then
	commit ;
else
	rollback ;
end if

end event

