 column=(type=char(6) updatewhereclause=yes name=user_modif dbname="rdv.user_modif" dbalias=".user_modif" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="rdv.date_modif" dbalias=".date_modif" )
