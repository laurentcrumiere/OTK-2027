 column=(type=char(1) updatewhereclause=yes name=nom_fauteuil dbname="nom_fauteuil" )
 column=(type=char(1) updatewhereclause=yes name=alerte_fs dbname="alerte_fs" )
 column=(type=char(1) updatewhereclause=yes name=alertes dbname="alertes" )
 column=(type=number updatewhereclause=yes name=code dbname="code" )
 column=(type=char(6) update=yes updatewhereclause=yes name=rdv_user_suivi_clinique dbname="rdv.user_suivi_clinique" dbalias=".user_suivi_clinique" validationmsg="~"Vous devez choisir un élément de la liste~"" )
 column=(type=date updatewhereclause=yes name=patient_date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=decimal(0) updatewhereclause=yes name=etat_rdv_couleur_fond dbname="etat_rdv.couleur_fond" dbalias=".couleur_fond" )
 column=(type=number updatewhereclause=yes name=patient_couleur2 dbname="patient.couleur2" dbalias=".couleur2" )
 column=(type=char(13) updatewhereclause=yes name=pastille_couleur2 dbname="pastille_couleur2" )
 retrieve="  SELECT ~"patient~".~"nom~" + (case when ~"patient~".~"prenom~" is null then '' else ' ' + ~"patient~".~"prenom~" end)  as patient_nom_cherche  ,
         ~"rdv~".~"rdv~",   
         ~"type_rdv~".~"nom~",   
         ~"rdv~".~"duree~",   
         ~"rdv~".~"fauteuil~",   
         ~"patient~".~"code~",   
         ~"patient~".~"prenom~",   
         ~"rdv~".~"absent~",   
         ~"patient~".~"type_dossier~",   
         getdate() as heure_serveur,   
         ~"dossier~".~"nom~",   
         ~"rdv~".~"type~",   
         ~"rdv~".~"code~",   
         ~"etat_rdv~".~"nom~",   
         ~"etat_rdv~".~"couleur~",   
         ~"rdv~".~"arrivee~",   
         ~"type_rdv~".~"couleur~",   
         ~"type_rdv~".~"code~",   
         ~"etat_rdv~".~"code~",   
         ~"dossier~".~"code~",   
         ~"param~".~"vide~",   
         (select min(date_impr) as date_impr from soins, code_soins where soins.~"type~" = code_soins.code and rdv.code = soins.code and code_soins.renouvt = 'O' and soins.date_demande between :limite_dep_min and :limite_dep_max ),   
         (select min(~"type~") as soin_dep from soins, code_soins where soins.~"type~" = code_soins.code and rdv.code = soins.code and code_soins.renouvt = 'O' and soins.date_demande between :limite_dep_min and :limite_dep_max ),   
         ~"agenda~".~"tous~",   
         ~"rdv~".~"user_modif~",   
         ~"rdv~".~"date_modif~",   
         (select min(~"rdv2~".~"arrivee~") as min_arrivee from ~"rdv~" as ~"rdv2~" where cast(~"rdv2~".~"rdv~" as date) = :var_date and ~"rdv2~".~"absent~" = 'S' and ~"rdv2~".~"code_praticien~" between :prat_min and :prat_max and ~"rdv2~".~"fauteuil~" between :f_min and :f_max ),   
         ( select min (abs (datediff (minute,getdate(), rdv2.rdv)) * 1000 + datediff (minute,getdate(), rdv2.arrivee)  ) as min_ecart_heure_courante from ~"rdv~" as ~"rdv2~" where cast(~"rdv2~".~"rdv~" as date) = :var_date and ~"rdv2~".~"absent~" = 'S' and ~"rdv2~".~"code_praticien~" between :prat_min and :prat_max and ~"rdv2~".~"fauteuil~" between :f_min and :f_max ),   
         abs ( datediff (minute,getdate(), rdv.rdv) ) * 1000 + datediff (minute,getdate(), rdv.arrivee) as ecart_heure_courante,   
         (case when ~"etat_rdv~".~"salle_attente~" = 'O'   then   datediff (minute, rdv.arrivee, getdate()) else null end ) as temps_attente,   
         ~"type_rdv~".~"duree_praticien_1~",   
         ~"rdv~".~"code_interne~",   
         ~"rdv~".~"commentaire~",   
         ~"patient~".~"numero_dossier~",   
         (select count(*) as cpt_dep_a_imp from soins, code_soins where soins.~"type~" = code_soins.code and rdv.code = soins.code and code_soins.renouvt = 'O' and soins.date_demande between :limite_dep_min and :limite_dep_max and date_impr is null ),   
         ~"etat_rdv~".~"salle_attente~",   
         ~"patient~".~"cmu~",   
         ~"rdv~".~"code_praticien~",   
         ~"prati~".~"barre_afficher_code~",   
         ~"prati~".~"barre_couleur_code~",   
         ~"patient~".~"couleur1~",   
         ~"patient~".~"adulte~",   
         ~"patient~".~"type_dossier~" as ancien_type_dossier,   
         ~"patient~".~"mise_en_evidence~",   
         (select isnull(count(*),0) from patient_alertes where ~"date~" <= cast(getdate() as date) and realisee <> 'O' and code_patient = patient.code ) as alertes_passees,   
         (select isnull(count(*),0) from patient_alertes where ~"date~" > cast(getdate() as date) and realisee <> 'O' and code_patient = patient.code ) as alertes_futures,   
         (select isnull(count(*),0) from patient_alertes,param where ~"date~" <= dateadd(day, delai_alerte_patient, cast(getdate() as date) ) and realisee <> 'O'  and code_patient = patient.code ) as alertes_presque_passees  ,
		~"table_vide~".~"v1~" as oval_retard,
         ~"patient~".~"code_praticien~",
         ~"patient~".~"moulage~"  ,
         (select top 1 v3 from table_vide) as meme_famille ,
         (select top 1 v2 from table_vide) as nom_fauteuil ,
         (select top 1 v4 from table_vide) as alerte_fs,
         (select top 1 v4 from table_vide) as alertes,
		(select patient.code from patient as p2 where patient.code = p2.code ) as code,
         ~"rdv~".~"user_suivi_clinique~" ,
		~"date_naissance~" as date_naissance ,
         ~"etat_rdv~".~"couleur_fond~"   ,
         ~"patient~".~"couleur2~"   , 
 		(select top 1 '             ' from table_vide) as pastille_couleur2 

    FROM ~"patient~",   
         ~"rdv~",   
         ~"type_rdv~",   
         ~"dossier~",   
         ~"etat_rdv~",   
         ~"param~",   
         ~"agenda~",   
         ~"prati~" ,
		~"table_vide~"  
   WHERE ( ~"patient~".~"code~" = ~"rdv~".~"code~" ) and  
         ( ~"rdv~".~"type~" = ~"type_rdv~".~"code~" ) and  
         ( ~"dossier~".~"code~" = ~"patient~".~"type_dossier~" ) and  
         ( ~"etat_rdv~".~"code~" = ~"rdv~".~"absent~" ) and  
         ( ~"rdv~".~"code_praticien~" = ~"prati~".~"code~" ) and  
         ( ( ~"rdv~".~"code_praticien~" between :prat_min and :prat_max ) AND  
         ( ~"rdv~".~"fauteuil~" between :f_min and :f_max ) AND  
         ( cast(~"rdv~".~"rdv~" as date) = :var_date ) AND (cast(~"rdv~".~"rdv~" as time) <= :heure_limite ) AND  
         ( ~"etat_rdv~".~"elimine~" <> 'O' ) )    
" update="rdv" updatewhere=0 updatekeyinplace=no arguments=(("prat_min", string),("prat_max", string),("var_date", date),("f_min", number),("f_max", number),("alerte_dep", number),("limite_dep_min", date),("limite_dep_max", date),("alerte_retard", number),("souligner_adulte", string),("heure_limite", time))  sort="rdv_rdv A patient_prenom A rdv_type A " )
