 column=(type=char(1) updatewhereclause=yes name=date_proc_reglt dbname="date_proc_reglt" )
 column=(type=char(1) updatewhereclause=yes name=montant_proc_reglt_tp dbname="montant_proc_reglt_tp" )
 column=(type=char(1) updatewhereclause=yes name=date_proc_reglt_tp dbname="date_proc_reglt_tp" )
 column=(type=number updatewhereclause=yes name=patient_couleur2 dbname="patient.couleur2" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_ville_parent1 dbname="patient.ville_parent1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dossier~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"etat_rdv~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"type_rdv.symbole~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"rdv.commentaire~") COMPUTE(NAME=~"patient.nom + ' '+ isnull(patient.prenom, '') as nom_patient~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"patient.remarques_html~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.adulte~") COLUMN(NAME=~"patient.mise_en_evidence~") COLUMN(NAME=~"patient.couleur1~") COMPUTE(NAME=~"(select top 1 dat from coment where coment.code = rdv.code order by dat desc) as date_dernier_commentaire~") COMPUTE(NAME=~"(select top 1 com from coment where coment.code = rdv.code order by dat desc) as commentaire_dernier_commentaire~") COMPUTE(NAME=~"(select top 1 acte_prevu from coment where coment.code = rdv.code order by dat desc) as acte_prevu_dernier_commentaire~") COMPUTE(NAME=~"(select top 1 com3 from coment where coment.code = rdv.code order by dat desc) as com3_dernier_commentaire~") COMPUTE(NAME=~"(select top 1 com4 from coment where coment.code = rdv.code order by dat desc) as com4_dernier_commentaire~") COMPUTE(NAME=~"(select top 1 com5 from coment where coment.code = rdv.code order by dat desc) as com5_dernier_commentaire~") COMPUTE(NAME=~"(select top 1 com6 from coment where coment.code = rdv.code order by dat desc) as com6_dernier_commentaire~") COMPUTE(NAME=~"(select top 1 'A' from param) as alertes~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient_alertes,param where ~~~"date~~~" <= dateadd(day, delai_alerte_patient, cast(getdate() as date)  ) and realisee <> 'O'  and code_patient = patient.code ) as alertes_presque_passees~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient_alertes where ~~~"date~~~" <= cast(getdate() as date) and realisee <> 'O' and code_patient = patient.code ) as alertes_passees~") COLUMN(NAME=~"etat_rdv.elimine_agenda~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.teldom2_parent1~") COLUMN(NAME=~"patient.teltra2_parent1~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.portable2_parent1~") COLUMN(NAME=~"patient.portable_patient~") COMPUTE(NAME=~"( select dba.somme_due_patient(rdv.code, cast(getdate() as date), 'N') as somme_due from param )~") COMPUTE(NAME=~"(select top 1 v1 as soins_courant from table_vide)~") COMPUTE(NAME=~"(select top 1 ~~~"date~~~" from coment_admini where coment_admini.code = rdv.code order by ~~~"date~~~" desc) as date_dernier_commentaire_administratif~") COMPUTE(NAME=~"(select top 1 texte from coment_admini where coment_admini.code = rdv.code order by ~~~"date~~~" desc) as commentaire_dernier_commentaire_administratif~") COMPUTE(NAME=~"(select top 1 prevu from coment_admini where coment_admini.code = rdv.code order by ~~~"date~~~" desc) as prevu_dernier_commentaire_administratif~") COLUMN(NAME=~"patient.code_praticien~") COMPUTE(NAME=~"(select top 1 intervenant from coment where coment.code = rdv.code order by dat desc) as interv_clinique~") COMPUTE(NAME=~"(select top 1 intervenant from coment_admini where coment_admini.code = rdv.code order by ~~~"date~~~" desc) as interv_administratif~") COLUMN(NAME=~"patient.date_naissance~") COMPUTE(NAME=~"(select top 1 v2 as alerte_FS from table_vide)~") COMPUTE(NAME=~"(select top 1 ~~~"rdv~~~".~~~"rdv~~~"  FROM ~~~"dba~~~".~~~"rdv~~~"  , ~~~"etat_rdv~~~"   WHERE ( ~~~"rdv~~~".~~~"code~~~" = patient.code) AND  ( cast(~~~"rdv~~~".~~~"rdv~~~" as date) > :v_date) and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O'  ORDER by rdv) as prochain_rdv~") COMPUTE(NAME=~"(select v1 from table_vide) as montant_proc_reglt~") COMPUTE(NAME=~"(select v1 from table_vide) as date_proc_reglt~") COMPUTE(NAME=~"(select v1 from table_vide) as montant_proc_reglt_tp~") COMPUTE(NAME=~"(select v1 from table_vide) as date_proc_reglt_tp~") COLUMN(NAME=~"patient.couleur2~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~")    JOIN (LEFT=~"patient.type_dossier~"    OP =~"=~"RIGHT=~"dossier.code~" )    JOIN (LEFT=~"rdv.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"type_rdv.code~"    OP =~"=~"RIGHT=~"rdv.type~" )    JOIN (LEFT=~"rdv.absent~"    OP =~"=~"RIGHT=~"etat_rdv.code~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":v_prat1 and :v_prat2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"date (~~~"rdv~~~".~~~"rdv~~~")~"   OP =~"=~"    EXP2 =~":v_date~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"fauteuil~~~"~"   OP =~"between~"    EXP2 =~":v_faut1 and :v_faut2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"elimine_agenda~~~"~"   OP =~"<>~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"v_prat1~" TYPE = string)  ARG(NAME = ~"v_prat2~" TYPE = string)  ARG(NAME = ~"v_date~" TYPE = date)  ARG(NAME = ~"v_date2~" TYPE = date)  ARG(NAME = ~"v_faut1~" TYPE = number)  ARG(NAME = ~"v_faut2~" TYPE = number)  ARG(NAME = ~"v_souligner_adultes~" TYPE = string) " arguments=(("v_prat1", string),("v_prat2", string),("v_date", date),("v_date2", date),("v_faut1", number),("v_faut2", number),("v_souligner_adultes", string))  sort="rdv_rdv A nom_patient A rdv_fauteuil A " )
