 column=(type=decimal(2) updatewhereclause=yes name=somme_due dbname="somme_due" )
 column=(type=char(1) updatewhereclause=yes name=soins_courant dbname="soins_courant" )
 column=(type=date updatewhereclause=yes name=date_commentaire_administratif dbname="date_dernier_commentaire_administratif" )
 column=(type=char(30000) updatewhereclause=yes name=commentaire_administratif dbname="commentaire_dernier_commentaire_administratif" )
 column=(type=char(30000) updatewhereclause=yes name=prevu_commentaire_administratif dbname="prevu_dernier_commentaire_administratif" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" )
 column=(type=char(6) updatewhereclause=yes name=interv_clinique dbname="interv_clinique" )
 column=(type=char(6) updatewhereclause=yes name=interv_administratif dbname="interv_administratif" )
