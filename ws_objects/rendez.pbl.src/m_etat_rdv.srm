m_etat9 m_etat9
m_etat10 m_etat10
end type
global m_etat_rdv m_etat_rdv

forward prototypes
public subroutine maj_ouverture (string v_etat)
end prototypes

public subroutine maj_ouverture (string v_etat);double v_code_rdv, v_code_patient, row

// On se sert de dw_click ... correspond à la mini salle d'attente

row = dw_click.getrow()

// mise à jour du rdv
v_code_rdv = round(dw_click.GetItemNumber(row, "rdv_code_interne"),0)

update rdv set absent = :v_etat
where round(code_interne,0) = :v_code_rdv ;

if sqlca.sqlcode = 0 then
	commit ;
	
else
	rollback ;
	Messagebox("ATTENTION", "Erreur dans la mise à jour du rendez-vous !~n~n" + Sqlca.sqlerrtext)
end if


// ouverture du patient
if row > 0 then

	var_code 				= 	dw_click.getitemnumber(row,"patient_code")
	var_numero_dossier 	= 	dw_click.getitemnumber(row,"patient_numero_dossier")
	var_nom 				= dw_click.getitemstring(row,"patient_nom_cherche")
	var_nomp 				= ""
	var_pay 					= ""
	var_moul 				= ""

	ajout_histo_etat_rdv(v_code_rdv,v_etat)
	ouverture_salle_attente()
end if



end subroutine

on m_etat_rdv.create
m_etat_rdv=this
call super::create
this.text = "m_etat_rdv"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_etat1=create m_etat1
this.m_etat2=create m_etat2
this.m_etat3=create m_etat3
this.m_etat4=create m_etat4
this.m_etat5=create m_etat5
this.m_etat6=create m_etat6
this.m_etat7=create m_etat7
this.m_etat8=create m_etat8
this.m_etat9=create m_etat9
this.m_etat10=create m_etat10
this.Item[UpperBound(this.Item)+1]=this.m_etat1
this.Item[UpperBound(this.Item)+1]=this.m_etat2
this.Item[UpperBound(this.Item)+1]=this.m_etat3
this.Item[UpperBound(this.Item)+1]=this.m_etat4
this.Item[UpperBound(this.Item)+1]=this.m_etat5
this.Item[UpperBound(this.Item)+1]=this.m_etat6
this.Item[UpperBound(this.Item)+1]=this.m_etat7
this.Item[UpperBound(this.Item)+1]=this.m_etat8
this.Item[UpperBound(this.Item)+1]=this.m_etat9
this.Item[UpperBound(this.Item)+1]=this.m_etat10
end on

on m_etat_rdv.destroy
call super::destroy
destroy(this.m_etat1)
destroy(this.m_etat2)
destroy(this.m_etat3)
destroy(this.m_etat4)
destroy(this.m_etat5)
destroy(this.m_etat6)
destroy(this.m_etat7)
destroy(this.m_etat8)
destroy(this.m_etat9)
destroy(this.m_etat10)
end on

type m_etat1 from menu within m_etat_rdv
end type

on m_etat1.create
call super::create
this.visible = false
this.text = "etat1"
this.menuimage = "lc_historique_etat_rdv.png"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_etat1.destroy
call super::destroy
end on

event clicked;
maj_ouverture(this.tag)
end event

