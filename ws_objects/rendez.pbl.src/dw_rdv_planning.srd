 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"etat_rdv~" )  TABLE(NAME=~"dossier~" )  TABLE(NAME=~"agenda~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"etat_rdv.nom~") COLUMN(NAME=~"etat_rdv.couleur~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"agenda.tous~") COMPUTE(NAME=~"(select ~~~"texte~~~"  from rdv_post_it where rdv_post_it.code_praticien = ~~~"rdv~~~".~~~"code_praticien~~~" and ~~~"rdv_post_it~~~".~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date)) as texte_prat~") COMPUTE(NAME=~"(select ~~~"texte~~~"  from rdv_post_it where rdv_post_it.code_praticien = 'TOUS' and ~~~"rdv_post_it~~~".~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date))  as texte_tous~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.cmu~") COLUMN(NAME=~"patient.couleur1~") COLUMN(NAME=~"patient.adulte~") COLUMN(NAME=~"prati.barre_afficher_code~") COLUMN(NAME=~"prati.barre_couleur_code~") COLUMN(NAME=~"etat_rdv.elimine_agenda~") COLUMN(NAME=~"patient.mise_en_evidence~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient_alertes where ~~~"date~~~" <= cast(getdate() as date) and realisee <> 'O' and code_patient = patient.code ) as alertes_passees~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient_alertes,param where ~~~"date~~~" <= dateadd(day, delai_alerte_patient ,  cast(getdate() as date) ) and realisee <> 'O'  and code_patient = patient.code ) as alertes_presque_passees~") COMPUTE(NAME=~"cast(~~~"rdv~~~".~~~"rdv~~~" as date) as date_rdv~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.teldom_parent2~") COLUMN(NAME=~"patient.teltra_parent2~") COLUMN(NAME=~"patient.teldom_payeur~") COLUMN(NAME=~"patient.teltra_payeur~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.portable_patient~") COLUMN(NAME=~"patient.teldom2_parent1~") COLUMN(NAME=~"patient.teltra2_parent1~") COLUMN(NAME=~"patient.portable2_parent1~") COLUMN(NAME=~"patient.teldom2_parent2~") COLUMN(NAME=~"patient.teltra2_parent2~") COLUMN(NAME=~"patient.portable1_parent2~") COLUMN(NAME=~"patient.portable2_parent2~") COLUMN(NAME=~"patient.teldom2_payeur~") COLUMN(NAME=~"patient.teltra2_payeur~") COLUMN(NAME=~"patient.portable1_payeur~") COLUMN(NAME=~"patient.portable2_payeur~")    JOIN (LEFT=~"etat_rdv.code~"    OP =~"=~"RIGHT=~"rdv.absent~"    OUTER2 =~"rdv.absent~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"rdv.code~" )    JOIN (LEFT=~"rdv.type~"    OP =~"=~"RIGHT=~"type_rdv.code~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )    JOIN (LEFT=~"rdv.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )WHERE(    EXP1 =~"cast(~~~"rdv~~~".~~~"rdv~~~" as date)~"   OP =~"between~"    EXP2 =~":var_date and :var_date2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"rdv.code_praticien~"   OP =~"between~"    EXP2 =~"cast(:prat_min as varchar(6)) and cast(:prat_max as varchar(6))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"rdv.fauteuil~"   OP =~"between~"    EXP2 =~":f_min and :f_max~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"var_date~" TYPE = date)  ARG(NAME = ~"var_date2~" TYPE = date)  ARG(NAME = ~"f_min~" TYPE = number)  ARG(NAME = ~"f_max~" TYPE = number)  ARG(NAME = ~"souligner_adulte~" TYPE = string) " arguments=(("prat_min", string),("prat_max", string),("var_date", date),("var_date2", date),("f_min", number),("f_max", number),("souligner_adulte", string))  sort="rdv_rdv A patient_nom A code A rdv_fauteuil A " )
