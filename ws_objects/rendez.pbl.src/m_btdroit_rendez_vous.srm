event clicked;
uo_pocket uo_poc


uo_poc = create uo_pocket

uo_poc.triggerevent(constructor!)

if uo_poc.is_dentalsms () then 
	
	string v_code_interne_string
	v_code_interne_string = string(w_click_rdv.dw_rdv_liste.getitemNumber(w_click_rdv.dw_rdv_liste.getrow(),"code_interne") )
	
	fxg_ouvrir_dentalsms("TR", v_code_interne_string)
	
else
	
	// Pocket Communication : suivi classique

	datetime v_rdv
	long v_numero_dossier
	
	select numero_dossier into :v_numero_dossier from patient where code = :w_click_rdv.var_code_local ;
	
	v_rdv = w_click_rdv.dw_rdv_liste.getitemDateTime(w_click_rdv.dw_rdv_liste.getrow(),"rdv") 
	
	w_mdi_2020.uo_powerdock.of_openDocument(w_sms_histo, "Suivi des envois de SMS", 'Export5!')
	
	
	// mise en place des datas ...
	
	w_sms_histo.em_min.text =  string(v_numero_dossier)
	w_sms_histo.em_max.text =  string(v_numero_dossier)
	
	w_sms_histo.em_date_min.SetDate(date(v_rdv))
	w_sms_histo.em_date_max.SetDate(date(v_rdv))
	
	
	w_sms_histo.em_date_envoi_min.SetDate( date(  year(date(v_rdv)) - 1 , 1 , 1))
	w_sms_histo.em_date_envoi_max.setdate(today())
	
	
	w_sms_histo.cb_ecran.triggerevent(clicked!)
	
end if

end event

type m_codeinternedurendezvous from menu within m_btdroit_rendez_vous
end type

event clicked;
string v_code_interne
// Affiche et copie le code interne du rdv  dans le clip board pour recherches ensuite
v_code_interne = string(w_click_rdv.dw_rdv_liste.getitemnumber(w_click_rdv.dw_rdv_liste.getrow() , "code_interne") ) 
Messagebox("Code interne du rendez-vous",v_code_interne ) 
clipboard(v_code_interne)



end event

