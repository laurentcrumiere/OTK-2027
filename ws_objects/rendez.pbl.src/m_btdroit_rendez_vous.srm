global type m_btdroit_rendez_vous from menu
m_historiquedesetats m_historiquedesetats
m_informationsdemodifications m_informationsdemodifications
m_suividesms m_suividesms
m_codeinternedurendezvous m_codeinternedurendezvous
end type
global m_btdroit_rendez_vous m_btdroit_rendez_vous

on m_btdroit_rendez_vous.create
m_btdroit_rendez_vous=this
call super::create
this.text = "m_btdroit_rendez_vous"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_historiquedesetats=create m_historiquedesetats
this.m_informationsdemodifications=create m_informationsdemodifications
this.m_suividesms=create m_suividesms
this.m_codeinternedurendezvous=create m_codeinternedurendezvous
this.Item[UpperBound(this.Item)+1]=this.m_historiquedesetats
this.Item[UpperBound(this.Item)+1]=this.m_informationsdemodifications
this.Item[UpperBound(this.Item)+1]=this.m_suividesms
this.Item[UpperBound(this.Item)+1]=this.m_codeinternedurendezvous
end on

on m_btdroit_rendez_vous.destroy
call super::destroy
destroy(this.m_historiquedesetats)
destroy(this.m_informationsdemodifications)
destroy(this.m_suividesms)
destroy(this.m_codeinternedurendezvous)
end on

