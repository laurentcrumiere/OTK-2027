 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"dossier~" )  TABLE(NAME=~"etat_rdv~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"agenda~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"patient.type_dossier~") COMPUTE(NAME=~"getdate() as heure_serveur~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"rdv.code~") COLUMN(NAME=~"etat_rdv.nom~") COLUMN(NAME=~"etat_rdv.couleur~") COLUMN(NAME=~"rdv.arrivee~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"type_rdv.code~") COLUMN(NAME=~"etat_rdv.code~") COLUMN(NAME=~"dossier.code~") COLUMN(NAME=~"param.vide~") COMPUTE(NAME=~"(select min(date_impr) as date_impr from soins, code_soins where soins.~~~"type~~~" = code_soins.code and rdv.code = soins.code and code_soins.renouvt = 'O' and soins.date_demande between :limite_dep_min and :limite_dep_max )~") COMPUTE(NAME=~"(select min(~~~"type~~~") as soin_dep from soins, code_soins where soins.~~~"type~~~" = code_soins.code and rdv.code = soins.code and code_soins.renouvt = 'O' and soins.date_demande between :limite_dep_min and :limite_dep_max )~") COMPUTE(NAME=~"(select ~~~"texte~~~" as texte_tous from rdv_post_it where rdv_post_it.code_praticien = 'TOUS' and ~~~"rdv_post_it~~~".~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date))~") COMPUTE(NAME=~"(select ~~~"texte~~~" as texte_prat from rdv_post_it where rdv_post_it.code_praticien = ~~~"rdv~~~".~~~"code_praticien~~~" and ~~~"rdv_post_it~~~".~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date))~") COLUMN(NAME=~"agenda.tous~") COLUMN(NAME=~"rdv.user_modif~") COLUMN(NAME=~"rdv.date_modif~") COMPUTE(NAME=~"(select min(~~~"rdv2~~~".~~~"arrivee~~~") as min_arrivee from ~~~"rdv~~~" as ~~~"rdv2~~~" where cast(~~~"rdv2~~~".~~~"rdv~~~" as date) = :var_date and ~~~"rdv2~~~".~~~"absent~~~" = 'S' and ~~~"rdv2~~~".~~~"code_praticien~~~" between :prat_min and :prat_max and ~~~"rdv2~~~".~~~"fauteuil~~~" between :f_min and :f_max )~") COMPUTE(NAME=~"( select min (abs (datediff (minute,getdate(), rdv2.rdv)) * 1000 + datediff (minute, getdate(), rdv2.arrivee)  ) as min_ecart_heure_courante from ~~~"rdv~~~" as ~~~"rdv2~~~" where cast(~~~"rdv2~~~".~~~"rdv~~~" as date) = :var_date and ~~~"rdv2~~~".~~~"absent~~~" = 'S' and ~~~"rdv2~~~".~~~"code_praticien~~~" between :prat_min and :prat_max and ~~~"rdv2~~~".~~~"fauteuil~~~" between :f_min and :f_max )~") COMPUTE(NAME=~"abs ( datediff (minute,getdate(), rdv.rdv) ) * 1000 + datediff (minute, getdate(), rdv.arrivee) as ecart_heure_courante~") COLUMN(NAME=~"type_rdv.duree_praticien_1~") COLUMN(NAME=~"rdv.code_interne~") COLUMN(NAME=~"rdv.commentaire~") COLUMN(NAME=~"patient.numero_dossier~") COMPUTE(NAME=~"(select ~~~"couleur~~~" as couleur_tous from rdv_post_it where rdv_post_it.code_praticien = 'TOUS' and ~~~"rdv_post_it~~~".~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date))~") COMPUTE(NAME=~"(select ~~~"couleur~~~" as couleur_prat from rdv_post_it where rdv_post_it.code_praticien = ~~~"rdv~~~".~~~"code_praticien~~~" and ~~~"rdv_post_it~~~".~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date))~") COMPUTE(NAME=~"(select count(*) as cpt_dep_a_imp from soins, code_soins where soins.~~~"type~~~" = code_soins.code and rdv.code = soins.code and code_soins.renouvt = 'O' and soins.date_demande between :limite_dep_min and :limite_dep_max and date_impr is null )~") COLUMN(NAME=~"etat_rdv.salle_attente~") COLUMN(NAME=~"patient.cmu~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"prati.barre_afficher_code~") COLUMN(NAME=~"prati.barre_couleur_code~") COLUMN(NAME=~"patient.couleur1~") COLUMN(NAME=~"patient.adulte~") COMPUTE(NAME=~"~~~"patient~~~".~~~"type_dossier~~~" as ancien_type_dossier~") COLUMN(NAME=~"patient.mise_en_evidence~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient_alertes where ~~~"date~~~" <= cast(getdate() as date) and realisee <> 'O' and code_patient = patient.code ) as alertes_passees~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient_alertes,param where ~~~"date~~~" <= dateadd(day, delai_alerte_patient, cast(getdate() as date) ) and realisee <> 'O'  and code_patient = patient.code ) as alertes_presque_passees~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"patient.mode_reglement_habituel~") COMPUTE(NAME=~"(select patient.code from patient as p2 where patient.code = p2.code ) as code~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"etat_rdv.couleur_fond~") COMPUTE(NAME=~"(select isnull(count(*),0) from patient_alertes where ~~~"date~~~" > cast(getdate() as date) and realisee <> 'O' and code_patient = patient.code ) as alertes_futures~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"rdv.code~" )    JOIN (LEFT=~"rdv.type~"    OP =~"=~"RIGHT=~"type_rdv.code~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )    JOIN (LEFT=~"etat_rdv.code~"    OP =~"=~"RIGHT=~"rdv.absent~" )    JOIN (LEFT=~"rdv.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"fauteuil~~~"~"   OP =~"between~"    EXP2 =~":f_min and :f_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cast(~~~"rdv~~~".~~~"rdv~~~" as date)~"   OP =~"=~"    EXP2 =~":var_date~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"elimine~~~"~"   OP =~"<>~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cast(~~~"rdv~~~".~~~"rdv~~~" as time)~"   OP =~"<=~"    EXP2 =~":heure_limite~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"var_date~" TYPE = date)  ARG(NAME = ~"f_min~" TYPE = number)  ARG(NAME = ~"f_max~" TYPE = number)  ARG(NAME = ~"alerte_dep~" TYPE = number)  ARG(NAME = ~"limite_dep_min~" TYPE = date)  ARG(NAME = ~"limite_dep_max~" TYPE = date)  ARG(NAME = ~"alerte_retard~" TYPE = number)  ARG(NAME = ~"souligner_adulte~" TYPE = string)  ARG(NAME = ~"heure_limite~" TYPE = time) " update="rdv" updatewhere=0 updatekeyinplace=no arguments=(("prat_min", string),("prat_max", string),("var_date", date),("f_min", number),("f_max", number),("alerte_dep", number),("limite_dep_min", date),("limite_dep_max", date),("alerte_retard", number),("souligner_adulte", string),("heure_limite", time))  sort="rdv_rdv A patient_nom_cherche A rdv_code A rdv_fauteuil A " )
