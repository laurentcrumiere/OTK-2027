table(column=(type=datetime updatewhereclause=yes key=yes name=rdv dbname="rdv.rdv" initial="today" )
 column=(type=char(6) updatewhereclause=yes key=yes name=type dbname="rdv.type" )
 column=(type=char(6) updatewhereclause=yes key=yes name=code_praticien dbname="rdv.code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=fauteuil dbname="rdv.fauteuil" initial="1" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=number updatewhereclause=yes key=yes name=code dbname="rdv.code" )
 column=(type=char(6) update=yes updatewhereclause=yes name=absent dbname="rdv.absent" initial="N" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="rdv.date_modif" )
 column=(type=time updatewhereclause=yes name=rdv_arrivee dbname="rdv.arrivee" )
 column=(type=char(6) updatewhereclause=yes name=user_modif dbname="rdv.user_modif" )
 column=(type=char(200) updatewhereclause=yes name=commentaire dbname="rdv.commentaire" )
 column=(type=number updatewhereclause=yes name=code_interne dbname="rdv.code_interne" )
 column=(type=decimal(0) updatewhereclause=yes name=duree dbname="rdv.duree" initial="10" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_suivi_clinique dbname="rdv.user_suivi_clinique" validationmsg="~"Vous devez choisir un élément de la liste~"" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" ) COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"rdv.code~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"rdv.date_modif~") COLUMN(NAME=~"rdv.arrivee~") COLUMN(NAME=~"rdv.user_modif~") COLUMN(NAME=~"rdv.commentaire~") COLUMN(NAME=~"rdv.code_interne~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.user_suivi_clinique~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"type_rdv.couleur~")    JOIN (LEFT=~"rdv.type~"    OP =~"=~"RIGHT=~"type_rdv.code~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code_interne~~~"~"   OP =~"=~"    EXP2 =~":v_code_interne~" ) ) ARG(NAME = ~"v_code_interne~" TYPE = number) " update="rdv" updatewhere=0 updatekeyinplace=yes arguments=(("v_code_interne", number)) )
