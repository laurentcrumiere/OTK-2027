table(column=(type=char(100) updatewhereclause=yes name=produit_designation dbname="produit.designation" dbalias=".designation" )
 column=(type=char(30) updatewhereclause=yes name=fournisseur_nom dbname="fournisseur.nom" dbalias=".nom" )
 column=(type=date updatewhereclause=yes name=commande_date_commande dbname="commande.date_commande" dbalias=".date_commande" )
 column=(type=datetime updatewhereclause=yes name=commande_date_envoi dbname="commande.date_envoi" dbalias=".date_envoi" )
 column=(type=decimal(0) updatewhereclause=yes name=ligne_commande_qte_commandee dbname="ligne_commande.qte_commandee" dbalias=".qte_commandee" )
 column=(type=decimal(0) updatewhereclause=yes name=ligne_commande_qte_livree dbname="ligne_commande.qte_livree" dbalias=".qte_livree" )
 column=(type=decimal(0) updatewhereclause=yes name=commande_numero_commande dbname="commande.numero_commande" dbalias=".numero_commande" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"commande~" )  TABLE(NAME=~"ligne_commande~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"fournisseur~" ) COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"fournisseur.nom~") COLUMN(NAME=~"commande.date_commande~") COLUMN(NAME=~"commande.date_envoi~") COLUMN(NAME=~"ligne_commande.qte_commandee~") COLUMN(NAME=~"ligne_commande.qte_livree~") COLUMN(NAME=~"commande.numero_commande~")    JOIN (LEFT=~"ligne_commande.numero_commande~"    OP =~"=~"RIGHT=~"commande.numero_commande~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"ligne_commande.code_produit~" )    JOIN (LEFT=~"fournisseur.code~"    OP =~"=~"RIGHT=~"commande.code_fournisseur~" )WHERE(    EXP1 =~"~~~"commande~~~".~~~"code_patient~~~"~"   OP =~"=~"    EXP2 =~":v_patient~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ligne_commande~~~".~~~"solde~~~"~"   OP =~"between~"    EXP2 =~":v_solde_min and :v_solde_max~" ) ) ARG(NAME = ~"v_patient~" TYPE = number)  ARG(NAME = ~"v_solde_min~" TYPE = string)  ARG(NAME = ~"v_solde_max~" TYPE = string) " arguments=(("v_patient", number),("v_solde_min", string),("v_solde_max", string))  sort="commande_date_commande A fournisseur_nom A produit_designation A " )
