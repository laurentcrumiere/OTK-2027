type m_acquisitionfichier from m_btdroit_gearbox`m_acquisitionfichier within m_btdroit_gearbox_fournisseur
end type

on m_acquisitionfichier.create
call super::create
this.menuimage = "lc_acquisition_fichier_16.png"
this.menuanimation = true
end on

on m_acquisitionfichier.destroy
call super::destroy
end on

event m_acquisitionfichier::clicked;string	pass_parameters	//string contenant infos a passer par "OPEN" de la fenetre acquisition fichier
string	cl_name	//pour passer le bon param suivant photos ARAKIS ou clinique
str_acqui_gear_param struct
gearbox_fournisseur gb_fournisseur

gb_fournisseur = gb2

cl_name = right(gb2.classname(),3)

//struct.code_fournisseur = nom_dossier_fournisseur
//struct.code_contact = nom_dossier_contact

struct.code_fournisseur = gb_fournisseur.dossier_fournisseur
struct.code_contact = gb_fournisseur.numero_contact
struct.code_produit = gb_fournisseur.numero_produit


if cl_name = "003" then
	struct.ajout_contact = false
	struct.ajout_produit = false
else
	if cl_name = "004" then
		struct.ajout_contact = true
		struct.ajout_produit = false
	else
		// cl_name = "005"
		struct.ajout_produit = true
	end if		
end if

//ouvre la fenétre d'acquisition fichier
openwithparm(w_acquisition_fichier_fournisseur,struct)

//affiche la photo fraichement acquise

if FileExists(gb2.fichier_photo) then
	gb2.ole_image.object.AutoRedraw = true
	gb2.ole_image.object.loadimage = gb2.fichier_photo
else
	gb2.ole_image.object.ClearImage = true
end if

end event

