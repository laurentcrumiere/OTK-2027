 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reference_bague~" ) COLUMN(NAME=~"reference_bague.code_fournisseur~") COLUMN(NAME=~"reference_bague.designation_ref~") COLUMN(NAME=~"reference_bague.code~") COLUMN(NAME=~"reference_bague.designation~") COLUMN(NAME=~"reference_bague.reference~")WHERE(    EXP1 =~"~~~"reference_bague~~~".~~~"code_fournisseur~~~"~"   OP =~"=~"    EXP2 =~":code_fournisseur~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"reference_bague~~~".~~~"designation_ref~~~"~"   OP =~"=~"    EXP2 =~":code_ref~" ) ) ARG(NAME = ~"code_fournisseur~" TYPE = string)  ARG(NAME = ~"code_ref~" TYPE = number) " update="reference_bague" updatewhere=1 updatekeyinplace=no arguments=(("code_fournisseur", string),("code_ref", number)) )
