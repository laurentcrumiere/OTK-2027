 column=(type=char(30) updatewhereclause=yes name=type_produit_type_produit dbname="type_produit.type_produit" dbalias=".type_produit" )
 column=(type=char(100) updatewhereclause=yes name=produit_designation dbname="produit.designation" dbalias=".designation" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(50) updatewhereclause=yes name=historique_es_libelle dbname="historique_es.libelle" dbalias=".libelle" )
 column=(type=char(6) updatewhereclause=yes name=historique_es_utilisateur dbname="historique_es.utilisateur" dbalias=".utilisateur" )
 column=(type=decimal(0) updatewhereclause=yes name=historique_es_quantite dbname="historique_es.quantite" dbalias=".quantite" )
 column=(type=char(6) updatewhereclause=yes name=stock_produit_code_lieu_stockage dbname="stock_produit.code_lieu_stockage" dbalias=".code_lieu_stockage" )
 column=(type=char(6) updatewhereclause=yes name=stock_produit_code_fournisseur dbname="stock_produit.code_fournisseur" dbalias=".code_fournisseur" )
 column=(type=char(6) updatewhereclause=yes name=historique_es_code_lieu_utilisation dbname="historique_es.code_lieu_utilisation" dbalias=".code_lieu_utilisation" )
 column=(type=char(6) updatewhereclause=yes name=stock_produit_code_praticien dbname="stock_produit.code_praticien" dbalias=".code_praticien" )
 column=(type=date updatewhereclause=yes name=stock_produit_date_peremption dbname="stock_produit.date_peremption" dbalias=".date_peremption" )
 column=(type=char(15) updatewhereclause=yes name=stock_produit_numero_lot dbname="stock_produit.numero_lot" dbalias=".numero_lot" )
 column=(type=long updatewhereclause=yes name=actif dbname="produit.actif" dbalias=".actif" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"categorie_produit~" )  TABLE(NAME=~"historique_es~" )  TABLE(NAME=~"param_stock_fournisseur~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"type_produit~" ) COLUMN(NAME=~"historique_es.code_es~") COLUMN(NAME=~"historique_es.date~") COLUMN(NAME=~"stock_produit.code_produit~") COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"categorie_produit.categorie_produit~") COLUMN(NAME=~"type_produit.type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"historique_es.libelle~") COLUMN(NAME=~"historique_es.utilisateur~") COLUMN(NAME=~"historique_es.quantite~") COLUMN(NAME=~"stock_produit.code_lieu_stockage~") COLUMN(NAME=~"stock_produit.code_fournisseur~") COLUMN(NAME=~"historique_es.code_lieu_utilisation~") COLUMN(NAME=~"stock_produit.code_praticien~") COLUMN(NAME=~"stock_produit.date_peremption~") COLUMN(NAME=~"stock_produit.numero_lot~") COLUMN(NAME=~"produit.actif~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_praticien~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"stock_produit.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"stock_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"stock_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"stock_produit.code_praticien~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_praticien~" )    JOIN (LEFT=~"stock_produit.code_barre~"    OP =~"=~"RIGHT=~"historique_es.code_barre~" )    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )    JOIN (LEFT=~"type_produit.code_categorie_produit~"    OP =~"=~"RIGHT=~"categorie_produit.code~" )WHERE(    EXP1 =~"~~~"historique_es~~~".~~~"code_es~~~"~"   OP =~"like~"    EXP2 =~":code_es~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":prati_min and :prati_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code~~~"~"   OP =~"like~"    EXP2 =~":code_type_produit~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"categorie_produit~~~".~~~"code~~~"~"   OP =~"like~"    EXP2 =~":code_type_categorie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"historique_es~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~" ) ) ORDER(NAME=~"stock_produit.code_produit~" ASC=yes ) ARG(NAME = ~"code_es~" TYPE = string)  ARG(NAME = ~"prati_min~" TYPE = string)  ARG(NAME = ~"prati_max~" TYPE = string)  ARG(NAME = ~"code_type_produit~" TYPE = string)  ARG(NAME = ~"code_type_categorie~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("code_es", string),("prati_min", string),("prati_max", string),("code_type_produit", string),("code_type_categorie", string),("date_min", date),("date_max", date))  sort="stock_produit_code_produit A historique_es_date A historique_es_code_es A " )
