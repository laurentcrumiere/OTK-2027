table(column=(type=char(1) updatewhereclause=yes name=historique_es_code_es dbname="historique_es.code_es" dbalias=".code_es" values="Entrée	e/Sortie	s/" )
 column=(type=date updatewhereclause=yes name=historique_es_date dbname="historique_es.date" dbalias=".date" )
 column=(type=char(20) updatewhereclause=yes name=stock_produit_code_produit dbname="stock_produit.code_produit" dbalias=".code_produit" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_code_barre dbname="stock_produit.code_barre" dbalias=".code_barre" )
