table(column=(type=decimal(0) updatewhereclause=yes name=commande_numero_commande dbname="commande.numero_commande" )
 column=(type=date updatewhereclause=yes name=commande_date_commande dbname="commande.date_commande" )
 column=(type=char(30) updatewhereclause=yes name=fournisseur_nom dbname="fournisseur.nom" )
 column=(type=char(6) updatewhereclause=yes name=commande_code_praticien dbname="commande.code_praticien" )
 column=(type=char(1) updatewhereclause=yes name=commande_controle_qualite dbname="commande.controle_qualite" )
 column=(type=char(1) updatewhereclause=yes name=commande_controle_delais dbname="commande.controle_delais" )
 column=(type=char(1) updatewhereclause=yes name=commande_controle_reactivite dbname="commande.controle_reactivite" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fournisseur~" )  TABLE(NAME=~"commande~" ) COLUMN(NAME=~"commande.numero_commande~") COLUMN(NAME=~"commande.date_commande~") COLUMN(NAME=~"fournisseur.nom~") COLUMN(NAME=~"commande.code_praticien~") COLUMN(NAME=~"commande.controle_qualite~") COLUMN(NAME=~"commande.controle_delais~") COLUMN(NAME=~"commande.controle_reactivite~")    JOIN (LEFT=~"fournisseur.code~"    OP =~"=~"RIGHT=~"commande.code_fournisseur~" )WHERE(    EXP1 =~"~~~"commande~~~".~~~"date_commande~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"fournisseur~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":four_min and :four_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"commande~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prati_min and :prati_max~" ) ) ARG(NAME = ~"prati_min~" TYPE = string)  ARG(NAME = ~"prati_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"four_min~" TYPE = string)  ARG(NAME = ~"four_max~" TYPE = string) " arguments=(("prati_min", string),("prati_max", string),("date_min", date),("date_max", date),("four_min", string),("four_max", string))  sort="commande_date_commande A fournisseur_nom A commande_numero_commande A " )
