table(column=(type=char(20) updatewhereclause=yes name=stock_produit_code_produit dbname="stock_produit.code_produit" )
 column=(type=char(6) updatewhereclause=yes name=produit_code_type_produit dbname="produit.code_type_produit" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"stock_produit~" ) COLUMN(NAME=~"stock_produit.code_produit~") COLUMN(NAME=~"produit.code_type_produit~")    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"stock_produit.code_produit~"    OP =~"=~"RIGHT=~"reference_produit.code_produit~" )    JOIN (LEFT=~"stock_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"reference_produit.code_fournisseur~" )WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_fournisseur~~~"~"   OP =~"=~"    EXP2 =~":var_code_fournisseur~" )  GROUP(NAME=~"produit.code_type_produit~") GROUP(NAME=~"stock_produit.code_produit~")) ARG(NAME = ~"var_code_fournisseur~" TYPE = string) " arguments=(("var_code_fournisseur", string)) )
