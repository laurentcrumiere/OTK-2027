 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"livraison~" )  TABLE(NAME=~"mode_transport~" ) COLUMN(NAME=~"mode_transport.mode_transport~") COLUMN(NAME=~"livraison.delai_livraison_mois~") COLUMN(NAME=~"livraison.delai_livraison_jours~") COLUMN(NAME=~"livraison.libelle~") COLUMN(NAME=~"livraison.code~")    JOIN (LEFT=~"mode_transport.code~"    OP =~"=~"RIGHT=~"livraison.code_mode_transport~" )WHERE(    EXP1 =~"~~~"livraison~~~".~~~"code_fournisseur~~~"~"   OP =~"=~"    EXP2 =~":var_code_fournisseur~" ) ) ARG(NAME = ~"var_code_fournisseur~" TYPE = string) " arguments=(("var_code_fournisseur", string))  sort="mode_transport_mode_transport A " )
