public subroutine listepopmenu (integer x, integer y, boolean maj_enabled, str_twostring refer, str_boolstring maj);
end subroutine

on m_btdroit_liste_produit.create
m_btdroit_liste_produit=this
call super::create
this.text = "m_btdroit_liste_produit"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_miseàjourproduit=create m_miseàjourproduit
this.m_référenceproduit=create m_référenceproduit
this.Item[UpperBound(this.Item)+1]=this.m_miseàjourproduit
this.Item[UpperBound(this.Item)+1]=this.m_référenceproduit
end on

on m_btdroit_liste_produit.destroy
call super::destroy
destroy(this.m_miseàjourproduit)
destroy(this.m_référenceproduit)
end on

