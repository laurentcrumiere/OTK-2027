end type
type m_référenceproduit from menu within m_btdroit_liste_produit
end type
global type m_btdroit_liste_produit from menu
m_miseàjourproduit m_miseàjourproduit
m_référenceproduit m_référenceproduit
end type
end forward

global type m_btdroit_liste_produit from menu
m_miseàjourproduit m_miseàjourproduit
m_référenceproduit m_référenceproduit
