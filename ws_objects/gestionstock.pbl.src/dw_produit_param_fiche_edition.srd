 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=char(6) updatewhereclause=yes name=prati_code dbname="prati.code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"param_stock_produit.code_produit~") COLUMN(NAME=~"param_stock_produit.code_praticien~") COLUMN(NAME=~"param_stock_produit.qte_stock_min~") COLUMN(NAME=~"param_stock_produit.code_lieu_stockage_habituel~") COLUMN(NAME=~"param_stock_produit.interdiction_commande~") COLUMN(NAME=~"param_stock_produit.type_gestion~") COLUMN(NAME=~"param_stock_produit.duree_limite_utilisation~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.code~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"code_produit~~~"~"   OP =~"=~"    EXP2 =~":var_code_produit~" ) ) ORDER(NAME=~"prati.nom~" ASC=yes ) ARG(NAME = ~"var_code_produit~" TYPE = string) " update="param_stock_produit" updatewhere=1 updatekeyinplace=no arguments=(("var_code_produit", string)) )
