table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=code_produit dbname="param_stock_produit.code_produit" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code_praticien dbname="param_stock_produit.code_praticien" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=qte_stock_min dbname="param_stock_produit.qte_stock_min" initial="1" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_lieu_stockage_habituel dbname="param_stock_produit.code_lieu_stockage_habituel" )
 column=(type=char(1) update=yes updatewhereclause=yes name=interdiction_commande dbname="param_stock_produit.interdiction_commande" values="oui	o/non	n/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=type_gestion dbname="param_stock_produit.type_gestion" values="normale	1/sans sortie	2/" )
