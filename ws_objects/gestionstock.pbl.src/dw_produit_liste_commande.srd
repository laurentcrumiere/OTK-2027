table(column=(type=char(20) update=yes updatewhereclause=yes name=code_interne dbname="produit.code_interne" dbalias=".code_interne" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_type_produit dbname="produit.code_type_produit" dbalias=".code_type_produit" )
 column=(type=decimal(0) updatewhereclause=yes name=couleur_texte dbname="produit.couleur_texte" dbalias=".couleur_texte" )
 column=(type=char(100) update=yes updatewhereclause=yes name=designation dbname="produit.designation" dbalias=".designation" )
 column=(type=char(40) updatewhereclause=yes name=reference_produit_reference dbname="reference_produit.reference" dbalias=".reference" )
 column=(type=char(30) updatewhereclause=yes name=fournisseur_nom dbname="fournisseur.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=quantite_stock dbname="quantite_stock" )
 column=(type=char(14) updatewhereclause=yes name=produit_gtin dbname="produit.gtin" dbalias=".gtin" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"fournisseur~" ) COLUMN(NAME=~"produit.code_interne~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"produit.couleur_texte~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"reference_produit.reference~") COLUMN(NAME=~"fournisseur.nom~") COMPUTE(NAME=~"(SELECT SUM(~~~"stock_produit~~~".~~~"quantite_colisee~~~") FROM ~~~"stock_produit~~~"  WHERE ~~~"stock_produit~~~".~~~"code_produit~~~" =  ~~~"produit~~~".~~~"code_interne~~~" and ~~~"stock_produit~~~".~~~"quantite_colisee~~~" > 0  ) as quantite_stock~") COLUMN(NAME=~"produit.gtin~")    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"reference_produit.code_produit~"    OUTER1 =~"produit.code_interne~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"fournisseur.code~" )WHERE(    EXP1 =~"~~~"reference_produit~~~".~~~"reference~~~"~"   OP =~"like~"    EXP2 =~":ref_four~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"designation~~~"~"   OP =~"like~"    EXP2 =~":desig~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_type_produit~~~"~"   OP =~"between~"    EXP2 =~":type_min and :type_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_interne~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reference_produit~~~".~~~"code_fournisseur~~~"~"   OP =~"=~"    EXP2 =~":v_code_fournisseur~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"produit~~~".~~~"gtin~~~"~"   OP =~"like~"    EXP2 =~":v_gtin~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"produit~~~".~~~"gtin~~~"~"   OP =~"is~"    EXP2 =~"null~"    LOGIC =~"And~" ) WHERE(    EXP1 =~":v_gtin~"   OP =~"=~"    EXP2 =~"'%'))~" ) ) ARG(NAME = ~"code_min~" TYPE = string)  ARG(NAME = ~"code_max~" TYPE = string)  ARG(NAME = ~"ref_four~" TYPE = string)  ARG(NAME = ~"desig~" TYPE = string)  ARG(NAME = ~"type_min~" TYPE = string)  ARG(NAME = ~"type_max~" TYPE = string)  ARG(NAME = ~"v_code_fournisseur~" TYPE = string)  ARG(NAME = ~"v_gtin~" TYPE = string) " arguments=(("code_min", string),("code_max", string),("ref_four", string),("desig", string),("type_min", string),("type_max", string),("v_code_fournisseur", string),("v_gtin", string))  sort="code_interne A " )
