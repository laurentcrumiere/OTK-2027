table(column=(type=number update=yes updatewhereclause=yes key=yes identity=yes name=code_interne dbname="sterilisation.code_interne" )
 column=(type=number update=yes updatewhereclause=yes name=code_patient dbname="sterilisation.code_patient" )
 column=(type=char(50) update=yes updatewhereclause=yes name=code_sterilisation dbname="sterilisation.code_sterilisation" )
 column=(type=date update=yes updatewhereclause=yes name=date_sterilisation dbname="sterilisation.date_sterilisation" )
 column=(type=date update=yes updatewhereclause=yes name=date_saisie dbname="sterilisation.date_saisie" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
