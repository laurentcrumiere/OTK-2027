 column=(type=char(500) update=yes updatewhereclause=yes name=sterilisation_commentaire dbname="sterilisation.commentaire" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sterilisation~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"sterilisation.code_interne~") COLUMN(NAME=~"sterilisation.code_patient~") COLUMN(NAME=~"sterilisation.code_sterilisation~") COLUMN(NAME=~"sterilisation.date_sterilisation~") COLUMN(NAME=~"sterilisation.date_saisie~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"sterilisation.commentaire~")    JOIN (LEFT=~"sterilisation.code_patient~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"sterilisation~~~".~~~"code_patient~~~"~"   OP =~"=~"    EXP2 =~":v_code_patient~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sterilisation~~~".~~~"date_saisie~~~"~"   OP =~"between~"    EXP2 =~":v_date_min and :v_date_max~" ) ) ARG(NAME = ~"v_code_patient~" TYPE = number)  ARG(NAME = ~"v_date_min~" TYPE = date)  ARG(NAME = ~"v_date_max~" TYPE = date) " update="sterilisation" updatewhere=0 updatekeyinplace=no arguments=(("v_code_patient", number),("v_date_min", date),("v_date_max", date))  sort="date_saisie A code_sterilisation A date_sterilisation A " )
