table(column=(type=char(20) updatewhereclause=yes name=param_stock_produit_code_produit dbname="param_stock_produit.code_produit" dbalias=".code_produit" )
 column=(type=char(100) updatewhereclause=yes name=produit_designation dbname="produit.designation" dbalias=".designation" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=type_produit_type_produit dbname="type_produit.type_produit" dbalias=".type_produit" )
 column=(type=char(40) updatewhereclause=yes name=categorie_produit_categorie_produit dbname="categorie_produit.categorie_produit" dbalias=".categorie_produit" )
 column=(type=char(30) updatewhereclause=yes name=fournisseur_nom dbname="fournisseur.nom" dbalias=".nom" )
 column=(type=char(40) updatewhereclause=yes name=reference_produit_reference dbname="reference_produit.reference" dbalias=".reference" )
 column=(type=decimal(2) updatewhereclause=yes name=reference_produit_prix dbname="reference_produit.prix" dbalias=".prix" )
 column=(type=char(3) updatewhereclause=yes name=reference_produit_code_type_taxe dbname="reference_produit.code_type_taxe" dbalias=".code_type_taxe" )
 column=(type=decimal(0) updatewhereclause=yes name=reference_produit_unite_vente dbname="reference_produit.unite_vente" dbalias=".unite_vente" )
 column=(type=char(1) updatewhereclause=yes name=param_stock_fournisseur_archive dbname="param_stock_fournisseur.archive" dbalias=".archive" values="	o/	n" )
 column=(type=char(6) updatewhereclause=yes name=param_stock_produit_code_praticien dbname="param_stock_produit.code_praticien" dbalias=".code_praticien" )
 column=(type=char(6) updatewhereclause=yes name=fournisseur_code dbname="fournisseur.code" dbalias=".code" )
 column=(type=long updatewhereclause=yes name=actif dbname="produit.actif" dbalias=".actif" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"type_produit~" )  TABLE(NAME=~"categorie_produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"param_stock_fournisseur~" )  TABLE(NAME=~"fournisseur~" ) COLUMN(NAME=~"param_stock_produit.code_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"type_produit.type_produit~") COLUMN(NAME=~"categorie_produit.categorie_produit~") COLUMN(NAME=~"fournisseur.nom~") COLUMN(NAME=~"reference_produit.reference~") COLUMN(NAME=~"reference_produit.prix~") COLUMN(NAME=~"reference_produit.code_type_taxe~") COLUMN(NAME=~"reference_produit.unite_vente~") COLUMN(NAME=~"param_stock_fournisseur.archive~") COLUMN(NAME=~"param_stock_produit.code_praticien~") COLUMN(NAME=~"fournisseur.code~") COLUMN(NAME=~"produit.actif~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )    JOIN (LEFT=~"categorie_produit.code~"    OP =~"=~"RIGHT=~"type_produit.code_categorie_produit~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"param_stock_fournisseur.code_produit~"    OP =~"=~"RIGHT=~"reference_produit.code_produit~" )    JOIN (LEFT=~"param_stock_fournisseur.code_fournisseur~"    OP =~"=~"RIGHT=~"reference_produit.code_fournisseur~" )    JOIN (LEFT=~"param_stock_fournisseur.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"fournisseur.code~"    OP =~"=~"RIGHT=~"reference_produit.code_fournisseur~" )WHERE(    EXP1 =~"~~~"reference_produit~~~".~~~"code_fournisseur~~~"~"   OP =~"like~"    EXP2 =~":code_fournisseur~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"param_stock_fournisseur~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prati_min and :prati_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_type_produit~~~"~"   OP =~"like~"    EXP2 =~":type_produit~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code_categorie_produit~~~"~"   OP =~"like~"    EXP2 =~":categorie_produit~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"param_stock_fournisseur~~~".~~~"archive~~~"~"   OP =~"=~"    EXP2 =~":archive~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"<>~"    EXP2 =~"'COMMUN'~" ) ) ORDER(NAME=~"param_stock_produit.code_produit~" ASC=yes ) ARG(NAME = ~"code_fournisseur~" TYPE = string)  ARG(NAME = ~"prati_min~" TYPE = string)  ARG(NAME = ~"prati_max~" TYPE = string)  ARG(NAME = ~"categorie_produit~" TYPE = string)  ARG(NAME = ~"type_produit~" TYPE = string)  ARG(NAME = ~"archive~" TYPE = string) " arguments=(("code_fournisseur", string),("prati_min", string),("prati_max", string),("categorie_produit", string),("type_produit", string),("archive", string)) )
