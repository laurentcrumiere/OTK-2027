table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=produit_code_interne dbname="produit.code_interne" )
 column=(type=char(6) update=yes updatewhereclause=yes name=produit_code_type_produit dbname="produit.code_type_produit" )
 column=(type=char(6) updatewhereclause=yes name=type_produit_code_categorie_produit dbname="type_produit.code_categorie_produit" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=produit_couleur_texte dbname="produit.couleur_texte" values="	1/	0" )
 column=(type=char(100) update=yes updatewhereclause=yes name=produit_designation dbname="produit.designation" )
