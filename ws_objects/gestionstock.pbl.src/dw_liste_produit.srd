 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produit~" )  TABLE(NAME=~"type_produit~" )  TABLE(NAME=~"param_stock_produit~" ) COLUMN(NAME=~"produit.code_interne~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"type_produit.code_categorie_produit~") COLUMN(NAME=~"produit.couleur_texte~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"produit.actif~")    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code_categorie_produit~~~"~"   OP =~"like~"    EXP2 =~":var_code_categorie~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_type_produit~~~"~"   OP =~"like~"    EXP2 =~":var_code_type~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"code_praticien~~~"~"   OP =~"<>~"    EXP2 =~"'COMMUN'~" )  GROUP(NAME=~"produit.code_interne~") GROUP(NAME=~"produit.code_type_produit~") GROUP(NAME=~"produit.designation~") GROUP(NAME=~"produit.couleur_texte~") GROUP(NAME=~"type_produit.code_categorie_produit~") GROUP(NAME=~"produit.actif~")) ORDER(NAME=~"produit.code_interne~" ASC=yes ) ARG(NAME = ~"var_code_categorie~" TYPE = string)  ARG(NAME = ~"var_code_type~" TYPE = string) " update="produit" updatewhere=0 updatekeyinplace=yes arguments=(("var_code_categorie", string),("var_code_type", string))  sort="produit_designation A produit_code_interne A " )
