table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" dbalias=".type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" dbalias=".code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" dbalias=".premiere_visite" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" dbalias=".relance" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" dbalias=".nom" )
 column=(type=char(1) updatewhereclause=yes name=cmu dbname="patient.cmu" dbalias=".cmu" )
 column=(type=char(20) update=yes updatewhereclause=yes name=classe dbname="patient.classe" dbalias=".classe" )
 column=(type=char(20) update=yes updatewhereclause=yes name=type dbname="patient.type" dbalias=".type" )
 column=(type=char(50) updatewhereclause=yes name=sterilisation_code_sterilisation dbname="sterilisation.code_sterilisation" dbalias=".code_sterilisation" )
 column=(type=date updatewhereclause=yes name=sterilisation_date_sterilisation dbname="sterilisation.date_sterilisation" dbalias=".date_sterilisation" )
 column=(type=date updatewhereclause=yes name=sterilisation_date_saisie dbname="sterilisation.date_saisie" dbalias=".date_saisie" )
 column=(type=char(500) updatewhereclause=yes name=sterilisation_commentaire dbname="sterilisation.commentaire" dbalias=".commentaire" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"dossier~" )  TABLE(NAME=~"sterilisation~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"patient.cmu~") COLUMN(NAME=~"patient.classe~") COLUMN(NAME=~"patient.type~") COLUMN(NAME=~"sterilisation.code_sterilisation~") COLUMN(NAME=~"sterilisation.date_sterilisation~") COLUMN(NAME=~"sterilisation.date_saisie~") COLUMN(NAME=~"sterilisation.commentaire~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"sterilisation.code_patient~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~" :prat_min  and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"sterilisation~~~".~~~"date_sterilisation~~~"~"   OP =~"between~"    EXP2 =~":date_ste_min and :date_ste_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"sterilisation~~~".~~~"date_saisie~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"sterilisation~~~".~~~"code_sterilisation~~~"~"   OP =~"between~"    EXP2 =~":code_ste_min and :code_ste_max~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"date_ste_min~" TYPE = date)  ARG(NAME = ~"date_ste_max~" TYPE = date)  ARG(NAME = ~"code_ste_min~" TYPE = string)  ARG(NAME = ~"code_ste_max~" TYPE = string) " arguments=(("prat_min", string),("prat_max", string),("code_min", number),("code_max", number),("date_min", date),("date_max", date),("date_ste_min", date),("date_ste_max", date),("code_ste_min", string),("code_ste_max", string))  sort="nom A patient_prenom A " )
