table(column=(type=char(6) updatewhereclause=yes name=type_produit_code_categorie_produit dbname="type_produit.code_categorie_produit" )
 column=(type=char(30) updatewhereclause=yes name=type_produit_type_produit dbname="type_produit.type_produit" )
