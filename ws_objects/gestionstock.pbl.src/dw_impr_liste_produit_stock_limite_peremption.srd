 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_qte_stock_min dbname="param_stock_produit.qte_stock_min" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_type_gestion dbname="param_stock_produit.type_gestion" )
 column=(type=char(20) updatewhereclause=yes name=param_stock_fournisseur_code_produit dbname="param_stock_fournisseur.code_produit" )
