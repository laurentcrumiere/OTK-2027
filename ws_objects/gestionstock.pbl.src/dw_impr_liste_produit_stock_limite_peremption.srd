 column=(type=long updatewhereclause=yes name=actif dbname="produit.actif" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param_stock_fournisseur~" )  TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"type_produit~" )  TABLE(NAME=~"stock_produit~" ) COLUMN(NAME=~"type_produit.code_categorie_produit~") COLUMN(NAME=~"type_produit.type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"param_stock_produit.qte_stock_min~") COLUMN(NAME=~"param_stock_produit.type_gestion~") COLUMN(NAME=~"param_stock_fournisseur.code_produit~") COLUMN(NAME=~"param_stock_fournisseur.code_praticien~") COLUMN(NAME=~"param_stock_produit.code_lieu_stockage_habituel~") COLUMN(NAME=~"stock_produit.code_produit~") COLUMN(NAME=~"param_stock_produit.etat_stock~") COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"stock_produit.quantite_colisee~") COLUMN(NAME=~"stock_produit.date_peremption~") COLUMN(NAME=~"stock_produit.numero_lot~") COLUMN(NAME=~"stock_produit.code_praticien~") COMPUTE(NAME=~"(select min(~~~"date~~~") as date_entree_stock from historique_es where stock_produit.code_barre = historique_es.code_barre and code_es = 'e')~") COLUMN(NAME=~"produit.actif~")    JOIN (LEFT=~"param_stock_fournisseur.code_produit~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_praticien~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )    JOIN (LEFT=~"stock_produit.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"stock_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"stock_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"stock_produit.code_praticien~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_praticien~" )WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"type_gestion~~~"~"   OP =~"between~"    EXP2 =~":type_min and :type_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code_categorie_produit~~~"~"   OP =~"like~"    EXP2 =~":code_categorie_produit~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_type_produit~~~"~"   OP =~"like~"    EXP2 =~":code_type_produit~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"quantite_colisee~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"date_peremption~~~"~"   OP =~"<=~"    EXP2 =~":date_limite~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"<>~"    EXP2 =~"'COMMUN'~" ) ) ARG(NAME = ~"type_min~" TYPE = number)  ARG(NAME = ~"type_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"code_type_produit~" TYPE = string)  ARG(NAME = ~"code_categorie_produit~" TYPE = string)  ARG(NAME = ~"date_limite~" TYPE = date) " arguments=(("type_min", number),("type_max", number),("prat_min", string),("prat_max", string),("code_type_produit", string),("code_categorie_produit", string),("date_limite", date))  sort="type_produit_code_categorie_produit A type_produit_type_produit A " )
