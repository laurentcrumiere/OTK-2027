table(column=(type=char(6) updatewhereclause=yes name=type_produit_code_categorie_produit dbname="type_produit.code_categorie_produit" dbalias=".code_categorie_produit" )
 column=(type=char(30) updatewhereclause=yes name=type_produit_type_produit dbname="type_produit.type_produit" dbalias=".type_produit" )
 column=(type=char(100) updatewhereclause=yes name=produit_designation dbname="produit.designation" dbalias=".designation" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_qte_stock_min dbname="param_stock_produit.qte_stock_min" dbalias=".qte_stock_min" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_type_gestion dbname="param_stock_produit.type_gestion" dbalias=".type_gestion" )
 column=(type=char(20) updatewhereclause=yes name=param_stock_fournisseur_code_produit dbname="param_stock_fournisseur.code_produit" dbalias=".code_produit" )
 column=(type=char(6) updatewhereclause=yes name=param_stock_fournisseur_code_praticien dbname="param_stock_fournisseur.code_praticien" dbalias=".code_praticien" )
 column=(type=char(6) updatewhereclause=yes name=param_stock_produit_code_lieu_stockage_h dbname="param_stock_produit.code_lieu_stockage_habituel" dbalias=".code_lieu_stockage_habituel" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_etat_stock dbname="param_stock_produit.etat_stock" dbalias=".etat_stock" values="vide	0/insuffisante	1/normale	2/excessive	3/" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_fournisseur_qte_com_min dbname="param_stock_fournisseur.qte_com_min" dbalias=".qte_com_min" )
 column=(type=char(30) updatewhereclause=yes name=nom_fournisseur_principal dbname="nom_fournisseur_principal" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_fournisseur_qte_colisee dbname="param_stock_fournisseur.qte_colisee" dbalias=".qte_colisee" )
 column=(type=char(6) updatewhereclause=yes name=code_fournisseur_principal dbname="code_fournisseur_principal" )
 column=(type=char(6) updatewhereclause=yes name=prati_code dbname="prati.code" dbalias=".code" )
 column=(type=decimal(0) updatewhereclause=yes name=quantite_deja_commande dbname="quantite_deja_commande" )
 column=(type=decimal(0) updatewhereclause=yes name=quantite_stock dbname="quantite_stock" )
 column=(type=long updatewhereclause=yes name=actif dbname="produit.actif" dbalias=".actif" )
 column=(type=char(1) updatewhereclause=yes name=reference_produit_fournisseur_par_defaut dbname="reference_produit.fournisseur_par_defaut" dbalias=".fournisseur_par_defaut" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param_stock_fournisseur~" )  TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"type_produit~" ) COLUMN(NAME=~"type_produit.code_categorie_produit~") COLUMN(NAME=~"type_produit.type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"param_stock_produit.qte_stock_min~") COLUMN(NAME=~"param_stock_produit.type_gestion~") COLUMN(NAME=~"param_stock_fournisseur.code_produit~") COLUMN(NAME=~"param_stock_fournisseur.code_praticien~") COLUMN(NAME=~"param_stock_produit.code_lieu_stockage_habituel~") COLUMN(NAME=~"param_stock_produit.etat_stock~") COLUMN(NAME=~"param_stock_fournisseur.qte_com_min~") COMPUTE(NAME=~"(select isnull(max(fournisseur.nom),'?') as nom_fournisseur_principal from fournisseur, reference_produit as ref2  where produit.code_interne = ref2.code_produit and fournisseur_par_defaut = 'O' and reference_produit.code_fournisseur = fournisseur.code )~") COLUMN(NAME=~"param_stock_fournisseur.qte_colisee~") COMPUTE(NAME=~"(select isnull(max(fournisseur.code),'?') as code_fournisseur_principal from fournisseur, reference_produit as ref2  where produit.code_interne = ref2.code_produit and fournisseur_par_defaut = 'O' and reference_produit.code_fournisseur = fournisseur.code )~") COLUMN(NAME=~"prati.code~") COMPUTE(NAME=~"(select sum(qte_commandee - isnull(qte_livree,0) ) as quantite_deja_commande from ligne_commande where ~~~"code_produit~~~" = produit.code_interne and solde <> 'O')~") COMPUTE(NAME=~"(select isnull(sum(quantite_colisee),0) as quantite_stock from stock_produit where ~~~"code_produit~~~" = produit.code_interne and ~~~"stock_produit~~~".~~~"quantite_colisee~~~" > 0 )~") COLUMN(NAME=~"produit.actif~") COLUMN(NAME=~"reference_produit.fournisseur_par_defaut~")    JOIN (LEFT=~"param_stock_fournisseur.code_produit~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_praticien~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"type_gestion~~~"~"   OP =~"between~"    EXP2 =~":type_min and :type_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code_categorie_produit~~~"~"   OP =~"like~"    EXP2 =~":code_categorie_produit ~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_type_produit~~~"~"   OP =~"like~"    EXP2 =~":code_type_produit~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"param_stock_fournisseur~~~".~~~"qte_colisee~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"param_stock_fournisseur~~~".~~~"archive~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"<>~"    EXP2 =~"'COMMUN'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"interdiction_commande~~~"~"   OP =~"<>~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"type_min~" TYPE = number)  ARG(NAME = ~"type_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"code_type_produit~" TYPE = string)  ARG(NAME = ~"code_categorie_produit~" TYPE = string) " arguments=(("type_min", number),("type_max", number),("prat_min", string),("prat_max", string),("code_type_produit", string),("code_categorie_produit", string))  sort="nom_fournisseur_principal A code_fournisseur_principal A type_produit_code_categorie_produit A type_produit_type_produit A param_stock_fournisseur_code_produit A " )
