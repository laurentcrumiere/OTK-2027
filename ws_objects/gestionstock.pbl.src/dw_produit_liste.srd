 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" ) COLUMN(NAME=~"produit.code_interne~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"reference_produit.code_fournisseur~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"produit.couleur_texte~")    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_interne~~~"~"   OP =~"=~"    EXP2 =~":var_code_produit~" ) ) ORDER(NAME=~"reference_produit.code_fournisseur~" ASC=yes ) ARG(NAME = ~"var_code_produit~" TYPE = string) " arguments=(("var_code_produit", string))  sort="reference_produit_code_fournisseur A " )
