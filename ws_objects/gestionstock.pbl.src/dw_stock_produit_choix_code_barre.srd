 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"fournisseur~" ) COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"stock_produit.code_fournisseur~") COLUMN(NAME=~"stock_produit.numero_lot~") COLUMN(NAME=~"stock_produit.code_lieu_stockage~") COLUMN(NAME=~"stock_produit.quantite~") COLUMN(NAME=~"stock_produit.code_praticien~") COLUMN(NAME=~"stock_produit.quantite_colisee~") COLUMN(NAME=~"fournisseur.nom~")    JOIN (LEFT=~"stock_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"stock_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"fournisseur.code~" )WHERE(    EXP1 =~"~~~"produit~~~".~~~"gtin~~~"~"   OP =~"=~"    EXP2 =~":var_code_di~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"numero_lot~~~"~"   OP =~"=~"    EXP2 =~":var_numero_lot~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"quantite_colisee~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"var_code_di~" TYPE = string)  ARG(NAME = ~"var_numero_lot~" TYPE = string) " arguments=(("var_code_di", string),("var_numero_lot", string))  sort="code_barre A code_fournisseur A " )
