table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=code_produit dbname="reference_produit.code_produit" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code_fournisseur dbname="reference_produit.code_fournisseur" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_fabricant dbname="reference_produit.code_fabricant" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=prix dbname="reference_produit.prix" )
 column=(type=char(3) update=yes updatewhereclause=yes name=code_type_taxe dbname="reference_produit.code_type_taxe" values="TTC	TTC/HT	HT/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=unite_vente dbname="reference_produit.unite_vente" )
 column=(type=char(250) update=yes updatewhereclause=yes name=description dbname="reference_produit.description" )
 column=(type=char(30) updatewhereclause=yes name=fournisseur_nom dbname="fournisseur.nom" )
 column=(type=char(6) updatewhereclause=yes name=statut_fournisseur_code dbname="statut_fournisseur.code" )
 column=(type=char(1) update=yes updatewhereclause=yes name=reference_produit_fournisseur_par_defaut dbname="reference_produit.fournisseur_par_defaut" values="Fournisseur principal	O/Fournisseur principal	N" )
 column=(type=char(40) update=yes updatewhereclause=yes name=reference dbname="reference_produit.reference" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"fournisseur~" )  TABLE(NAME=~"statut_fournisseur~" ) COLUMN(NAME=~"reference_produit.code_produit~") COLUMN(NAME=~"reference_produit.code_fournisseur~") COLUMN(NAME=~"reference_produit.code_fabricant~") COLUMN(NAME=~"reference_produit.prix~") COLUMN(NAME=~"reference_produit.code_type_taxe~") COLUMN(NAME=~"reference_produit.unite_vente~") COLUMN(NAME=~"reference_produit.description~") COLUMN(NAME=~"fournisseur.nom~") COLUMN(NAME=~"statut_fournisseur.code~") COLUMN(NAME=~"reference_produit.fournisseur_par_defaut~") COLUMN(NAME=~"reference_produit.reference~")    JOIN (LEFT=~"statut_fournisseur.code~"    OP =~"=~"RIGHT=~"fournisseur.statut~"    OUTER2 =~"fournisseur.statut~" )    JOIN (LEFT=~"fournisseur.code~"    OP =~"=~"RIGHT=~"reference_produit.code_fournisseur~" )WHERE(    EXP1 =~"~~~"reference_produit~~~".~~~"code_produit~~~"~"   OP =~"=~"    EXP2 =~":var_code_produit~" ) ) ORDER(NAME=~"fournisseur.nom~" ASC=yes ) ARG(NAME = ~"var_code_produit~" TYPE = string) " update="reference_produit" updatewhere=1 updatekeyinplace=no arguments=(("var_code_produit", string)) )
