 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"type_produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"fournisseur~" ) COLUMN(NAME=~"param_stock_produit.code_praticien~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"param_stock_produit.code_lieu_stockage_habituel~") COLUMN(NAME=~"produit.couleur_texte~") COLUMN(NAME=~"produit.code_interne~") COLUMN(NAME=~"reference_produit.reference~") COLUMN(NAME=~"fournisseur.nom~") COLUMN(NAME=~"produit.gtin~")    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"reference_produit.code_produit~"    OUTER1 =~"produit.code_interne~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"fournisseur.code~" )WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code_categorie_produit~~~"~"   OP =~"between~"    EXP2 =~":catego_min and :catego_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":type_min and :type_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"designation~~~"~"   OP =~"like~"    EXP2 =~":desig~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_interne~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"reference_produit~~~".~~~"reference~~~"~"   OP =~"like~"    EXP2 =~":reference_fournisseur~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"code_praticien~~~"~"   OP =~"<>~"    EXP2 =~":pour_catalogue~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"actif~~~"~"   OP =~"between~"    EXP2 =~":actif_min and :actif_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"produit~~~".~~~"gtin~~~"~"   OP =~"like~"    EXP2 =~":v_gtin~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"produit~~~".~~~"gtin~~~"~"   OP =~"is~"    EXP2 =~"null ~"    LOGIC =~"And~" ) WHERE(    EXP1 =~":v_gtin~"   OP =~"=~"    EXP2 =~"'%'))~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"catego_min~" TYPE = string)  ARG(NAME = ~"catego_max~" TYPE = string)  ARG(NAME = ~"type_min~" TYPE = string)  ARG(NAME = ~"type_max~" TYPE = string)  ARG(NAME = ~"desig~" TYPE = string)  ARG(NAME = ~"code_min~" TYPE = string)  ARG(NAME = ~"code_max~" TYPE = string)  ARG(NAME = ~"reference_fournisseur~" TYPE = string)  ARG(NAME = ~"pour_catalogue~" TYPE = string)  ARG(NAME = ~"actif_min~" TYPE = number)  ARG(NAME = ~"actif_max~" TYPE = number)  ARG(NAME = ~"v_gtin~" TYPE = string) " arguments=(("prat_min", string),("prat_max", string),("catego_min", string),("catego_max", string),("type_min", string),("type_max", string),("desig", string),("code_min", string),("code_max", string),("reference_fournisseur", string),("pour_catalogue", string),("actif_min", number),("actif_max", number),("v_gtin", string))  sort="param_stock_produit_code_praticien A produit_code_interne A " )
