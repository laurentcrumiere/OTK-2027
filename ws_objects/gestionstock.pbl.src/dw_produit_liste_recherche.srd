 column=(type=char(6) updatewhereclause=yes name=lieu_stockage dbname="param_stock_produit.code_lieu_stockage_habituel" dbalias=".code_lieu_stockage_habituel" )
 column=(type=decimal(0) updatewhereclause=yes name=produit_couleur_texte dbname="produit.couleur_texte" dbalias=".couleur_texte" )
 column=(type=char(20) updatewhereclause=yes name=produit_code_interne dbname="produit.code_interne" dbalias=".code_interne" )
 column=(type=char(40) updatewhereclause=yes name=reference_produit_reference dbname="reference_produit.reference" dbalias=".reference" )
