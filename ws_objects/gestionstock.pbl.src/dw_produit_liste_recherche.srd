table(column=(type=char(6) updatewhereclause=yes name=param_stock_produit_code_praticien dbname="param_stock_produit.code_praticien" dbalias=".code_praticien" )
 column=(type=char(6) updatewhereclause=yes name=produit_code_type_produit dbname="produit.code_type_produit" dbalias=".code_type_produit" )
