table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=produit_code_interne dbname="produit.code_interne" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) updatewhereclause=yes name=type_produit_code_categorie_produit dbname="type_produit.code_categorie_produit" )
 column=(type=char(6) update=yes updatewhereclause=yes name=produit_code_type_produit dbname="produit.code_type_produit" )
 column=(type=char(100) update=yes updatewhereclause=yes name=produit_designation dbname="produit.designation" )
 column=(type=long update=yes updatewhereclause=yes name=actif dbname="produit.actif" initial="1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produit~" )  TABLE(NAME=~"type_produit~" ) COLUMN(NAME=~"produit.code_interne~") COLUMN(NAME=~"type_produit.code_categorie_produit~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"produit.actif~")    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_interne~~~"~"   OP =~"=~"    EXP2 =~":var_code_produit~" ) ) ARG(NAME = ~"var_code_produit~" TYPE = string) " update="produit" updatewhere=0 updatekeyinplace=no arguments=(("var_code_produit", string)) )
