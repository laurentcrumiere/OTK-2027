 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"historique_es~" )  TABLE(NAME=~"stock_produit~" ) COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"stock_produit.numero_lot~") COLUMN(NAME=~"historique_es.date~") COLUMN(NAME=~"historique_es.prix~") COLUMN(NAME=~"historique_es.code_type_taxe~") COLUMN(NAME=~"historique_es.quantite~") COLUMN(NAME=~"stock_produit.code_lieu_stockage~") COLUMN(NAME=~"historique_es.utilisateur~") COLUMN(NAME=~"stock_produit.quantite~")    JOIN (LEFT=~"stock_produit.code_barre~"    OP =~"=~"RIGHT=~"historique_es.code_barre~" )WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"numero_commande~~~"~"   OP =~"=~"    EXP2 =~":numero_commande~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_produit~~~"~"   OP =~"=~"    EXP2 =~":var_code_produit~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"historique_es~~~".~~~"code_es~~~"~"   OP =~"=~"    EXP2 =~"'e'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~"   OP =~"not exists~"    EXP2 =~"(SELECT *FROM ~~~"historique_es~~~" WHERE ( ~~~"historique_es~~~".~~~"code_barre~~~" = ~~~"stock_produit~~~".~~~"code_barre~~~" ) AND ( ~~~"historique_es~~~".~~~"code_es~~~" = 's' ))~" ) ) ARG(NAME = ~"numero_commande~" TYPE = number)  ARG(NAME = ~"var_code_produit~" TYPE = string) " arguments=(("numero_commande", number),("var_code_produit", string))  sort="historique_es_date A stock_produit_code_barre A " )
