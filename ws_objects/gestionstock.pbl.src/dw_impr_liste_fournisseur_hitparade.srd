table(column=(type=decimal(0) updatewhereclause=yes name=historique_es_quantite dbname="historique_es.quantite" )
 column=(type=decimal(2) updatewhereclause=yes name=reference_produit_prix dbname="reference_produit.prix" )
 column=(type=char(3) updatewhereclause=yes name=reference_produit_code_type_taxe dbname="reference_produit.code_type_taxe" )
 column=(type=char(6) updatewhereclause=yes name=fournisseur_code dbname="fournisseur.code" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_facteur_colisage dbname="stock_produit.facteur_colisage" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=char(30) updatewhereclause=yes name=fournisseur_nom dbname="fournisseur.nom" )
 column=(type=date updatewhereclause=yes name=historique_es_date dbname="historique_es.date" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fournisseur~" )  TABLE(NAME=~"historique_es~" )  TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"param_stock_fournisseur~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"historique_es.quantite~") COLUMN(NAME=~"reference_produit.prix~") COLUMN(NAME=~"reference_produit.code_type_taxe~") COLUMN(NAME=~"fournisseur.code~") COLUMN(NAME=~"stock_produit.facteur_colisage~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"fournisseur.nom~") COLUMN(NAME=~"historique_es.date~")    JOIN (LEFT=~"stock_produit.code_barre~"    OP =~"=~"RIGHT=~"historique_es.code_barre~" )    JOIN (LEFT=~"param_stock_fournisseur.code_produit~"    OP =~"=~"RIGHT=~"stock_produit.code_produit~" )    JOIN (LEFT=~"param_stock_fournisseur.code_fournisseur~"    OP =~"=~"RIGHT=~"stock_produit.code_fournisseur~" )    JOIN (LEFT=~"param_stock_fournisseur.code_praticien~"    OP =~"=~"RIGHT=~"stock_produit.code_praticien~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"fournisseur.code~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_praticien~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"stock_produit.code_praticien~" )WHERE(    EXP1 =~"~~~"historique_es~~~".~~~"code_es~~~"~"   OP =~"=~"    EXP2 =~"'e'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prati_min and :prati_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(~~~"historique_es~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"historique_es~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min2 and :date_max2)~" ) ) ORDER(NAME=~"fournisseur.code~" ASC=yes ) ARG(NAME = ~"prati_min~" TYPE = string)  ARG(NAME = ~"prati_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"date_min2~" TYPE = date)  ARG(NAME = ~"date_max2~" TYPE = date) " arguments=(("prati_min", string),("prati_max", string),("date_min", date),("date_max", date),("date_min2", date),("date_max2", date))  sort="fournisseur_nom A " )
