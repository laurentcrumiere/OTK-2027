 column=(type=char(40) updatewhereclause=yes name=reference_produit_reference dbname="reference_produit.reference" dbalias=".reference" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_commande~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" ) COLUMN(NAME=~"ligne_commande.code_produit~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"ligne_commande.qte_commandee~") COLUMN(NAME=~"ligne_commande.qte_livree~") COLUMN(NAME=~"ligne_commande.solde~") COLUMN(NAME=~"reference_produit.reference~")    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"ligne_commande.code_produit~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )WHERE(    EXP1 =~"~~~"ligne_commande~~~".~~~"numero_commande~~~"~"   OP =~"=~"    EXP2 =~":var_numero_commande~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"reference_produit~~~".~~~"code_fournisseur~~~"~"   OP =~"=~"    EXP2 =~":var_code_fournisseur~" ) ) ARG(NAME = ~"var_numero_commande~" TYPE = number)  ARG(NAME = ~"var_code_fournisseur~" TYPE = number) " arguments=(("var_numero_commande", number),("var_code_fournisseur", number))  sort="ligne_commande_code_produit A reference_produit_reference A " )
