table(column=(type=char(20) updatewhereclause=yes name=ligne_commande_code_produit dbname="ligne_commande.code_produit" dbalias=".code_produit" )
 column=(type=char(6) updatewhereclause=yes name=produit_code_type_produit dbname="produit.code_type_produit" dbalias=".code_type_produit" )
 column=(type=char(30) updatewhereclause=yes name=produit_designation dbname="produit.designation" dbalias=".designation" )
 column=(type=decimal(0) updatewhereclause=yes name=ligne_commande_qte_commandee dbname="ligne_commande.qte_commandee" dbalias=".qte_commandee" )
 column=(type=decimal(0) updatewhereclause=yes name=ligne_commande_qte_livree dbname="ligne_commande.qte_livree" dbalias=".qte_livree" )
