table(column=(type=char(20) updatewhereclause=yes name=reference_produit_code_produit dbname="reference_produit.code_produit" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=fiche_tracabilite_code_barre dbname="fiche_tracabilite.code_barre" )
 column=(type=char(6) updatewhereclause=yes name=stock_produit_code_fournisseur dbname="stock_produit.code_fournisseur" )
 column=(type=char(15) updatewhereclause=yes name=stock_produit_numero_lot dbname="stock_produit.numero_lot" )
 column=(type=date update=yes updatewhereclause=yes name=fiche_tracabilite_date_sortie dbname="fiche_tracabilite.date_sortie" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=fiche_tracabilite_code_patient dbname="fiche_tracabilite.code_patient" )
 column=(type=date update=yes updatewhereclause=yes key=yes name=fiche_tracabilite_date_rdv dbname="fiche_tracabilite.date_rdv" )
 column=(type=decimal(0) updatewhereclause=yes name=fiche_tracabilite_couleur_ligne dbname="fiche_tracabilite.couleur_ligne" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_type_gestion dbname="param_stock_produit.type_gestion" )
 column=(type=date update=yes updatewhereclause=yes name=fiche_tracabilite_date_sterilisation dbname="fiche_tracabilite.date_sterilisation" )
 column=(type=char(30) updatewhereclause=yes name=produit_designation dbname="produit.designation" )
 column=(type=char(6) update=yes updatewhereclause=yes name=fiche_tracabilite_lieu dbname="fiche_tracabilite.lieu" )
 column=(type=char(6) updatewhereclause=yes name=stock_produit_code_praticien dbname="stock_produit.code_praticien" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=fiche_tracabilite_nb_unite dbname="fiche_tracabilite.nb_unite" )
 column=(type=char(30) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=date updatewhereclause=yes name=date_entree dbname="date_entree" )
 column=(type=char(40) updatewhereclause=yes name=reference_produit_reference dbname="reference_produit.reference" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fiche_tracabilite~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"reference_produit.code_produit~") COLUMN(NAME=~"fiche_tracabilite.code_barre~") COLUMN(NAME=~"stock_produit.code_fournisseur~") COLUMN(NAME=~"stock_produit.numero_lot~") COLUMN(NAME=~"fiche_tracabilite.date_sortie~") COLUMN(NAME=~"fiche_tracabilite.code_patient~") COLUMN(NAME=~"fiche_tracabilite.date_rdv~") COLUMN(NAME=~"fiche_tracabilite.couleur_ligne~") COLUMN(NAME=~"param_stock_produit.type_gestion~") COLUMN(NAME=~"fiche_tracabilite.date_sterilisation~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"fiche_tracabilite.lieu~") COLUMN(NAME=~"stock_produit.code_praticien~") COLUMN(NAME=~"fiche_tracabilite.nb_unite~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COMPUTE(NAME=~"(select min(~~~"date~~~") from historique_es where historique_es.code_barre = stock_produit.code_barre and code_es = 'E') as date_entree~") COLUMN(NAME=~"reference_produit.reference~")    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"stock_produit.code_produit~"    OP =~"=~"RIGHT=~"reference_produit.code_produit~" )    JOIN (LEFT=~"stock_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"reference_produit.code_fournisseur~" )    JOIN (LEFT=~"stock_produit.code_barre~"    OP =~"=~"RIGHT=~"fiche_tracabilite.code_barre~" )    JOIN (LEFT=~"param_stock_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"stock_produit.code_praticien~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"fiche_tracabilite.code_patient~" )WHERE(    EXP1 =~"~~~"fiche_tracabilite~~~".~~~"code_patient~~~"~"   OP =~"=~"    EXP2 =~":var_code_patient~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"fiche_tracabilite~~~".~~~"date_rdv~~~"~"   OP =~"between~"    EXP2 =~":var_date1 and :var_date2~" ) ) ORDER(NAME=~"reference_produit.code_produit~" ASC=yes ) ARG(NAME = ~"var_code_patient~" TYPE = number)  ARG(NAME = ~"var_date1~" TYPE = date)  ARG(NAME = ~"var_date2~" TYPE = date) " update="fiche_tracabilite" updatewhere=0 updatekeyinplace=no arguments=(("var_code_patient", number),("var_date1", date),("var_date2", date))  sort="fiche_tracabilite_date_rdv A fiche_tracabilite_code_barre A reference_produit_code_produit A stock_produit_code_fournisseur A " )
