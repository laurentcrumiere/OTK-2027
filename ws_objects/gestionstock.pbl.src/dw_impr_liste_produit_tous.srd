table(column=(type=char(20) updatewhereclause=yes name=param_stock_produit_code_produit dbname="param_stock_produit.code_produit" dbalias=".code_produit" )
 column=(type=char(100) updatewhereclause=yes name=produit_designation dbname="produit.designation" dbalias=".designation" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_qte_stock_min dbname="param_stock_produit.qte_stock_min" dbalias=".qte_stock_min" )
 column=(type=char(6) updatewhereclause=yes name=lieu_stockage dbname="param_stock_produit.code_lieu_stockage_habituel" dbalias=".code_lieu_stockage_habituel" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_type_gestion dbname="param_stock_produit.type_gestion" dbalias=".type_gestion" values="normale	1/sans sortie	2/" )
 column=(type=decimal(0) updatewhereclause=yes name=duree_limite_utilisation dbname="param_stock_produit.duree_limite_utilisation" dbalias=".duree_limite_utilisation" )
 column=(type=char(1) updatewhereclause=yes name=interdiction_commande dbname="param_stock_produit.interdiction_commande" dbalias=".interdiction_commande" values="	o/	n" )
 column=(type=char(30) updatewhereclause=yes name=type_produit_type_produit dbname="type_produit.type_produit" dbalias=".type_produit" )
 column=(type=char(40) updatewhereclause=yes name=categorie_produit_categorie_produit dbname="categorie_produit.categorie_produit" dbalias=".categorie_produit" )
 column=(type=char(6) updatewhereclause=yes name=param_stock_produit_code_praticien dbname="param_stock_produit.code_praticien" dbalias=".code_praticien" )
 column=(type=long updatewhereclause=yes name=actif dbname="produit.actif" dbalias=".actif" )
 column=(type=char(14) updatewhereclause=yes name=produit_gtin dbname="produit.gtin" dbalias=".gtin" )
 column=(type=char(20) updatewhereclause=yes name=produit_numero_cas dbname="produit.numero_cas" dbalias=".numero_cas" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"type_produit~" )  TABLE(NAME=~"categorie_produit~" ) COLUMN(NAME=~"param_stock_produit.code_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"param_stock_produit.qte_stock_min~") COLUMN(NAME=~"param_stock_produit.code_lieu_stockage_habituel~") COLUMN(NAME=~"param_stock_produit.type_gestion~") COLUMN(NAME=~"param_stock_produit.duree_limite_utilisation~") COLUMN(NAME=~"param_stock_produit.interdiction_commande~") COLUMN(NAME=~"type_produit.type_produit~") COLUMN(NAME=~"categorie_produit.categorie_produit~") COLUMN(NAME=~"param_stock_produit.code_praticien~") COLUMN(NAME=~"produit.actif~") COLUMN(NAME=~"produit.gtin~") COLUMN(NAME=~"produit.numero_cas~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )    JOIN (LEFT=~"categorie_produit.code~"    OP =~"=~"RIGHT=~"type_produit.code_categorie_produit~" )WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"type_gestion~~~"~"   OP =~"between~"    EXP2 =~":type_min and :type_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prati_min and :prati_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_type_produit~~~"~"   OP =~"like~"    EXP2 =~":type_produit~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code_categorie_produit~~~"~"   OP =~"like~"    EXP2 =~":categorie_produit~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"interdiction_commande~~~"~"   OP =~"like~"    EXP2 =~":interdiction~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"<>~"    EXP2 =~":pour_catalogue~" ) ) ARG(NAME = ~"type_min~" TYPE = number)  ARG(NAME = ~"type_max~" TYPE = number)  ARG(NAME = ~"prati_min~" TYPE = string)  ARG(NAME = ~"prati_max~" TYPE = string)  ARG(NAME = ~"categorie_produit~" TYPE = string)  ARG(NAME = ~"type_produit~" TYPE = string)  ARG(NAME = ~"interdiction~" TYPE = string)  ARG(NAME = ~"pour_catalogue~" TYPE = string) " arguments=(("type_min", number),("type_max", number),("prati_min", string),("prati_max", string),("categorie_produit", string),("type_produit", string),("interdiction", string),("pour_catalogue", string)) )
