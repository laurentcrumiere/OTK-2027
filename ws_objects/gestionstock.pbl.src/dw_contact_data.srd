 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"contact~" ) COLUMN(NAME=~"contact.code~") COLUMN(NAME=~"contact.code_fournisseur~") COLUMN(NAME=~"contact.fonction~") COLUMN(NAME=~"contact.nom~") COLUMN(NAME=~"contact.prenom~") COLUMN(NAME=~"contact.telephone~") COLUMN(NAME=~"contact.fax~") COLUMN(NAME=~"contact.tel_portable~") COLUMN(NAME=~"contact.adresse1~") COLUMN(NAME=~"contact.adresse2~") COLUMN(NAME=~"contact.code_postal~") COLUMN(NAME=~"contact.ville~") COLUMN(NAME=~"contact.code_pays~") COLUMN(NAME=~"contact.email~")WHERE(    EXP1 =~"~~~"contact~~~".~~~"code_fournisseur~~~"~"   OP =~"=~"    EXP2 =~":var_code_fournisseur~" ) ) ARG(NAME = ~"var_code_fournisseur~" TYPE = string) " update="contact" updatewhere=1 updatekeyinplace=no arguments=(("var_code_fournisseur", string)) )
