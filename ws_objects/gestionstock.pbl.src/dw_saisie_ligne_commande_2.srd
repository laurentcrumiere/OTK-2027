table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=ligne_commande_code_produit dbname="ligne_commande.code_produit" )
 column=(type=char(6) updatewhereclause=yes name=produit_code_type_produit dbname="produit.code_type_produit" )
 column=(type=char(30) updatewhereclause=yes name=produit_designation dbname="produit.designation" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=ligne_commande_numero_commande dbname="ligne_commande.numero_commande" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ligne_commande_solde dbname="ligne_commande.solde" )
 column=(type=decimal(2) updatewhereclause=yes name=reference_produit_prix dbname="reference_produit.prix" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=ligne_commande_prix dbname="ligne_commande.prix" )
 column=(type=char(3) updatewhereclause=yes name=ligne_commande_code_type_taxe dbname="ligne_commande.code_type_taxe" )
