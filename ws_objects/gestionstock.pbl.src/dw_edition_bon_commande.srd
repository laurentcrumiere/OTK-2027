 column=(type=char(3) updatewhereclause=yes name=reference_produit_code_type_taxe dbname="reference_produit.code_type_taxe" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_fournisseur_remise dbname="param_stock_fournisseur.remise" )
 column=(type=decimal(2) updatewhereclause=yes name=ligne_commande_prix dbname="ligne_commande.prix" )
