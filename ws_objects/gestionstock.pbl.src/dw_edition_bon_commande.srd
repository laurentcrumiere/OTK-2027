 column=(type=char(20) updatewhereclause=yes name=fournisseur_numero_client dbname="fournisseur.numero_client" )
 column=(type=char(40) updatewhereclause=yes name=reference_produit_reference dbname="reference_produit.reference" )
 column=(type=char(25) updatewhereclause=yes name=fournisseur_telephone dbname="fournisseur.telephone" )
 column=(type=char(25) updatewhereclause=yes name=fournisseur_fax dbname="fournisseur.fax" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"commande~" )  TABLE(NAME=~"fournisseur~" )  TABLE(NAME=~"ligne_commande~" )  TABLE(NAME=~"param_stock_fournisseur~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" ) COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"fournisseur.nom~") COLUMN(NAME=~"fournisseur.adresse1~") COLUMN(NAME=~"fournisseur.adresse2~") COLUMN(NAME=~"fournisseur.code_postal~") COLUMN(NAME=~"fournisseur.ville~") COLUMN(NAME=~"fournisseur.code_pays~") COLUMN(NAME=~"commande.numero_commande~") COLUMN(NAME=~"commande.date_commande~") COLUMN(NAME=~"commande.mode_transport~") COLUMN(NAME=~"commande.delai_livraison_mois~") COLUMN(NAME=~"commande.delai_livraison_jours~") COLUMN(NAME=~"commande.frais_port~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"ligne_commande.qte_commandee~") COLUMN(NAME=~"reference_produit.prix~") COLUMN(NAME=~"reference_produit.code_type_taxe~") COLUMN(NAME=~"param_stock_fournisseur.remise~") COLUMN(NAME=~"ligne_commande.prix~") COLUMN(NAME=~"param_stock_fournisseur.qte_colisee~") COLUMN(NAME=~"commande.reference_personnelle~") COLUMN(NAME=~"commande.commentaires~") COLUMN(NAME=~"fournisseur.numero_client~") COLUMN(NAME=~"reference_produit.reference~") COLUMN(NAME=~"fournisseur.telephone~") COLUMN(NAME=~"fournisseur.fax~")    JOIN (LEFT=~"fournisseur.code~"    OP =~"=~"RIGHT=~"commande.code_fournisseur~" )    JOIN (LEFT=~"ligne_commande.numero_commande~"    OP =~"=~"RIGHT=~"commande.numero_commande~" )    JOIN (LEFT=~"ligne_commande.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_praticien~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"commande.code_praticien~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"ligne_commande.code_produit~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"fournisseur.code~" )WHERE(    EXP1 =~"~~~"commande~~~".~~~"numero_commande~~~"~"   OP =~"=~"    EXP2 =~":var_numero~" ) ) ARG(NAME = ~"var_numero~" TYPE = number) " arguments=(("var_numero", number))  sort="reference_produit_reference A produit_designation A " )
