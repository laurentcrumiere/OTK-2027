table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=numero_commande dbname="commande.numero_commande" dbalias=".numero_commande" )
 column=(type=date update=yes updatewhereclause=yes name=date_commande dbname="commande.date_commande" dbalias=".date_commande" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_fournisseur dbname="commande.code_fournisseur" dbalias=".code_fournisseur" )
 column=(type=char(500) update=yes updatewhereclause=yes name=reference_personnelle dbname="commande.reference_personnelle" dbalias=".reference_personnelle" )
 column=(type=char(6) update=yes updatewhereclause=yes name=utilisateur dbname="commande.utilisateur" dbalias=".utilisateur" )
 column=(type=char(30) update=yes updatewhereclause=yes name=mode_transport dbname="commande.mode_transport" dbalias=".mode_transport" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=delai_livraison_mois dbname="commande.delai_livraison_mois" dbalias=".delai_livraison_mois" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=delai_livraison_jours dbname="commande.delai_livraison_jours" dbalias=".delai_livraison_jours" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=frais_port dbname="commande.frais_port" dbalias=".frais_port" )
 column=(type=char(3) update=yes updatewhereclause=yes name=code_type_taxe dbname="commande.code_type_taxe" dbalias=".code_type_taxe" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=valeur_tva dbname="commande.valeur_tva" dbalias=".valeur_tva" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=commentaires dbname="commande.commentaires" dbalias=".commentaires" )
 column=(type=char(200) update=yes updatewhereclause=yes name=libelle_livraison dbname="commande.libelle_livraison" dbalias=".libelle_livraison" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="commande.code_praticien" dbalias=".code_praticien" )
 column=(type=char(6) updatewhereclause=yes name=poste_utilisation dbname="commande.poste_utilisation" dbalias=".poste_utilisation" )
 column=(type=decimal(2) updatewhereclause=yes name=total_ttc_commande dbname="total_ttc_commande" )
 column=(type=char(98) updatewhereclause=yes name=nom_patient dbname="nom_patient" )
 column=(type=number updatewhereclause=yes name=code_patient dbname="commande.code_patient" dbalias=".code_patient" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"commande~" ) COLUMN(NAME=~"commande.numero_commande~") COLUMN(NAME=~"commande.date_commande~") COLUMN(NAME=~"commande.code_fournisseur~") COLUMN(NAME=~"commande.reference_personnelle~") COLUMN(NAME=~"commande.utilisateur~") COLUMN(NAME=~"commande.mode_transport~") COLUMN(NAME=~"commande.delai_livraison_mois~") COLUMN(NAME=~"commande.delai_livraison_jours~") COLUMN(NAME=~"commande.frais_port~") COLUMN(NAME=~"commande.code_type_taxe~") COLUMN(NAME=~"commande.valeur_tva~") COLUMN(NAME=~"commande.commentaires~") COLUMN(NAME=~"commande.libelle_livraison~") COLUMN(NAME=~"commande.code_praticien~") COLUMN(NAME=~"commande.poste_utilisation~") COMPUTE(NAME=~"(select sum(qte_commandee * prix) as total_ttc_commande from ligne_commande where numero_commande = :var_numero_commande)~") COMPUTE(NAME=~"(select nom + ' '+ prenom + ' (' + string(numero_dossier)+ ')' from patient where commande.code_patient = patient.code) as nom_patient~") COLUMN(NAME=~"commande.code_patient~")WHERE(    EXP1 =~"~~~"commande~~~".~~~"numero_commande~~~"~"   OP =~"=~"    EXP2 =~":var_numero_commande~" ) ) ARG(NAME = ~"var_numero_commande~" TYPE = number) " update="commande" updatewhere=1 updatekeyinplace=no arguments=(("var_numero_commande", number)) )
