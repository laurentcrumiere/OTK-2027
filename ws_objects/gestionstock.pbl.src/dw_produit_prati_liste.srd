 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"param_stock_produit.code_praticien~") COLUMN(NAME=~"param_stock_produit.code_produit~") COLUMN(NAME=~"param_stock_produit.qte_stock_min~") COLUMN(NAME=~"param_stock_produit.code_lieu_stockage_habituel~") COLUMN(NAME=~"param_stock_produit.interdiction_commande~") COLUMN(NAME=~"param_stock_produit.type_gestion~") COLUMN(NAME=~"param_stock_produit.duree_limite_utilisation~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.code~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"code_produit~~~"~"   OP =~"=~"    EXP2 =~":var_code_produit~" ) ) ARG(NAME = ~"var_code_produit~" TYPE = string) " arguments=(("var_code_produit", string))  sort="prati_nom A prati_prenom A " )
