table(column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="param_stock_produit.code_praticien" )
 column=(type=char(20) update=yes updatewhereclause=yes name=code_produit dbname="param_stock_produit.code_produit" )
