 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produit~" )  TABLE(NAME=~"categorie_produit~" )  TABLE(NAME=~"type_produit~" )  TABLE(NAME=~"param_stock_produit~" ) COLUMN(NAME=~"produit.code_interne~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"categorie_produit.categorie_produit~") COLUMN(NAME=~"type_produit.type_produit~") COLUMN(NAME=~"produit.actif~")    JOIN (LEFT=~"type_produit.code_categorie_produit~"    OP =~"=~"RIGHT=~"categorie_produit.code~" )    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )WHERE(    EXP1 =~"~~~"categorie_produit~~~".~~~"code~~~"~"   OP =~"like~"    EXP2 =~":v_catego~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code~~~"~"   OP =~"like~"    EXP2 =~":v_type~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"code_praticien~~~"~"   OP =~"<>~"    EXP2 =~"'COMMUN'~" ) ) ARG(NAME = ~"v_catego~" TYPE = string)  ARG(NAME = ~"v_type~" TYPE = string) " arguments=(("v_catego", string),("v_type", string))  sort="categorie_produit_categorie_produit A type_produit_type_produit A designation A " )
