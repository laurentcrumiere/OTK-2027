table(column=(type=char(20) updatewhereclause=yes name=stock_produit_code_produit dbname="stock_produit.code_produit" dbalias=".code_produit" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_code_barre dbname="stock_produit.code_barre" dbalias=".code_barre" )
 column=(type=char(6) updatewhereclause=yes name=type_produit_code_categorie_produit dbname="type_produit.code_categorie_produit" dbalias=".code_categorie_produit" )
 column=(type=char(30) updatewhereclause=yes name=type_produit_type_produit dbname="type_produit.type_produit" dbalias=".type_produit" )
 column=(type=char(100) updatewhereclause=yes name=produit_designation dbname="produit.designation" dbalias=".designation" )
 column=(type=char(6) updatewhereclause=yes name=stock_produit_code_fournisseur dbname="stock_produit.code_fournisseur" dbalias=".code_fournisseur" )
 column=(type=char(6) updatewhereclause=yes name=stock_produit_code_lieu_stockage dbname="stock_produit.code_lieu_stockage" dbalias=".code_lieu_stockage" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_quantite dbname="stock_produit.quantite" dbalias=".quantite" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_qte_stock_min dbname="param_stock_produit.qte_stock_min" dbalias=".qte_stock_min" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_type_gestion dbname="param_stock_produit.type_gestion" dbalias=".type_gestion" )
 column=(type=decimal(0) updatewhereclause=yes name=param_stock_produit_etat_stock dbname="param_stock_produit.etat_stock" dbalias=".etat_stock" values="vide	0/insuffisante	1/normale	2/excessive	3/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param_stock_fournisseur~" )  TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"type_produit~" ) COLUMN(NAME=~"stock_produit.code_produit~") COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"type_produit.code_categorie_produit~") COLUMN(NAME=~"type_produit.type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"stock_produit.code_fournisseur~") COLUMN(NAME=~"stock_produit.code_lieu_stockage~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"stock_produit.quantite~") COLUMN(NAME=~"param_stock_produit.qte_stock_min~") COLUMN(NAME=~"param_stock_produit.type_gestion~") COLUMN(NAME=~"param_stock_produit.etat_stock~")    JOIN (LEFT=~"param_stock_fournisseur.code_produit~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_praticien~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"stock_produit.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"stock_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"stock_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"stock_produit.code_praticien~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_praticien~" )    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"type_gestion~~~"~"   OP =~"between~"    EXP2 =~":type_min and :type_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code_categorie_produit~~~"~"   OP =~"like~"    EXP2 =~":code_categorie_produit~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_type_produit~~~"~"   OP =~"like~"    EXP2 =~":code_type_produit~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"quantite_colisee~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"param_stock_fournisseur~~~".~~~"archive~~~"~"   OP =~"=~"    EXP2 =~"'n'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"<>~"    EXP2 =~"'COMMUN'~" ) ) ORDER(NAME=~"stock_produit.code_produit~" ASC=yes ) ARG(NAME = ~"type_min~" TYPE = number)  ARG(NAME = ~"type_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"code_type_produit~" TYPE = string)  ARG(NAME = ~"code_categorie_produit~" TYPE = string) " arguments=(("type_min", number),("type_max", number),("prat_min", string),("prat_max", string),("code_type_produit", string),("code_categorie_produit", string)) )
