detail(height=60 color="536870912" )
table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=ligne_commande_code_produit dbname="ligne_commande.code_produit" )
 column=(type=char(20) updatewhereclause=yes name=reference_produit_reference dbname="reference_produit.reference" )
 column=(type=char(6) updatewhereclause=yes name=produit_code_type_produit dbname="produit.code_type_produit" )
 column=(type=char(30) updatewhereclause=yes name=produit_designation dbname="produit.designation" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=ligne_commande_prix dbname="ligne_commande.prix" )
 column=(type=char(3) update=yes updatewhereclause=yes name=ligne_commande_code_type_taxe dbname="ligne_commande.code_type_taxe" values="HT	HT/TTC	TTC/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=ligne_commande_qte_commandee dbname="ligne_commande.qte_commandee" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=ligne_commande_numero_commande dbname="ligne_commande.numero_commande" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ligne_commande_solde dbname="ligne_commande.solde" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_commande~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" ) COLUMN(NAME=~"ligne_commande.code_produit~") COLUMN(NAME=~"reference_produit.reference~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"ligne_commande.prix~") COLUMN(NAME=~"ligne_commande.code_type_taxe~") COLUMN(NAME=~"ligne_commande.qte_commandee~") COLUMN(NAME=~"ligne_commande.numero_commande~") COLUMN(NAME=~"ligne_commande.solde~")    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"ligne_commande.code_produit~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )WHERE(    EXP1 =~"~~~"ligne_commande~~~".~~~"numero_commande~~~"~"   OP =~"=~"    EXP2 =~":var_numero_commande~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"reference_produit~~~".~~~"code_fournisseur~~~"~"   OP =~"=~"    EXP2 =~":var_code_fournisseur~" ) ) ARG(NAME = ~"var_numero_commande~" TYPE = number)  ARG(NAME = ~"var_code_fournisseur~" TYPE = string) " update="ligne_commande" updatewhere=1 updatekeyinplace=no arguments=(("var_numero_commande", number),("var_code_fournisseur", string))  sort="ligne_commande_code_produit A reference_produit_reference A " )
