compute(band=footer alignment="2" expression="sum( if  (ligne_commande_code_type_taxe ='HT' ,  ligne_commande_prix  * 1.206 *  ligne_commande_qte_commandee, ligne_commande_prix  * ligne_commande_qte_commandee) for all)"border="0" color="0" x="3218" y="0" height="60" width="311" format="######.00 €"  name=compute_2  font.face="Arial" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="12632256" )
