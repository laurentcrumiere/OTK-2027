 column=(type=char(40) updatewhereclause=yes name=reference_produit dbname="reference_produit" )
 column=(type=char(6) updatewhereclause=yes name=commande_code_praticien dbname="commande.code_praticien" )
 column=(type=char(6) updatewhereclause=yes name=commande_code_fournisseur dbname="commande.code_fournisseur" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_commande~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"commande~" ) COLUMN(NAME=~"ligne_commande.code_produit~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"ligne_commande.prix~") COLUMN(NAME=~"ligne_commande.code_type_taxe~") COLUMN(NAME=~"ligne_commande.qte_commandee~") COLUMN(NAME=~"ligne_commande.qte_livree~") COLUMN(NAME=~"ligne_commande.solde~") COMPUTE(NAME=~"(select isnull(~~~"reference~~~",'?')  from reference_produit where code_fournisseur = :var_code_fournisseur and ligne_commande.code_produit = reference_produit.code_produit) as reference_produit~") COLUMN(NAME=~"commande.code_praticien~") COLUMN(NAME=~"commande.code_fournisseur~")    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"ligne_commande.code_produit~" )    JOIN (LEFT=~"ligne_commande.numero_commande~"    OP =~"=~"RIGHT=~"commande.numero_commande~" )WHERE(    EXP1 =~"~~~"ligne_commande~~~".~~~"numero_commande~~~"~"   OP =~"=~"    EXP2 =~":var_numero_commande~" ) ) ARG(NAME = ~"var_numero_commande~" TYPE = number)  ARG(NAME = ~"var_code_fournisseur~" TYPE = string) " arguments=(("var_numero_commande", number),("var_code_fournisseur", string))  sort="ligne_commande_code_produit A reference_produit A " )
