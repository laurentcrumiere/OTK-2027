table(column=(type=char(20) updatewhereclause=yes name=ligne_commande_code_produit dbname="ligne_commande.code_produit" )
 column=(type=char(6) updatewhereclause=yes name=produit_code_type_produit dbname="produit.code_type_produit" )
 column=(type=char(100) updatewhereclause=yes name=produit_designation dbname="produit.designation" )
 column=(type=decimal(2) updatewhereclause=yes name=ligne_commande_prix dbname="ligne_commande.prix" )
 column=(type=char(3) updatewhereclause=yes name=ligne_commande_code_type_taxe dbname="ligne_commande.code_type_taxe" values="HT	HT/TTC	TTC/" )
 column=(type=decimal(0) updatewhereclause=yes name=ligne_commande_qte_commandee dbname="ligne_commande.qte_commandee" )
 column=(type=decimal(0) updatewhereclause=yes name=ligne_commande_qte_livree dbname="ligne_commande.qte_livree" )
