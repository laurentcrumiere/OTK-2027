 column=(type=char(6) updatewhereclause=yes name=reference_produit_code_fournisseur dbname="reference_produit.code_fournisseur" dbalias=".code_fournisseur" )
 column=(type=decimal(2) updatewhereclause=yes name=reference_produit_prix dbname="reference_produit.prix" dbalias=".prix" )
 column=(type=char(3) updatewhereclause=yes name=reference_produit_code_type_taxe dbname="reference_produit.code_type_taxe" dbalias=".code_type_taxe" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_quantite dbname="stock_produit.quantite" dbalias=".quantite" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_code_barre dbname="stock_produit.code_barre" dbalias=".code_barre" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_quantite_colisee dbname="stock_produit.quantite_colisee" dbalias=".quantite_colisee" )
