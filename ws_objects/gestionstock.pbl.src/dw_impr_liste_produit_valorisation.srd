 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"type_produit~" )  TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"param_stock_fournisseur~" ) COLUMN(NAME=~"type_produit.code_categorie_produit~") COLUMN(NAME=~"type_produit.type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"reference_produit.code_fournisseur~") COLUMN(NAME=~"reference_produit.prix~") COLUMN(NAME=~"reference_produit.code_type_taxe~") COLUMN(NAME=~"stock_produit.quantite~") COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"stock_produit.quantite_colisee~") COLUMN(NAME=~"stock_produit.facteur_colisage~") COMPUTE(NAME=~"(SELECT isnull(sum(~~~"historique_es~~~".~~~"quantite~~~"),0) as entree_histo FROM ~~~"historique_es~~~" WHERE ( ~~~"historique_es~~~".~~~"code_barre~~~" = ~~~"stock_produit~~~".~~~"code_barre~~~" )  AND ( ~~~"historique_es~~~".~~~"code_es~~~" = 's' ) AND( ~~~"historique_es~~~".~~~"date~~~" between :date_valo and today() ) and code_es = 'E')~") COLUMN(NAME=~"produit.code_interne~") COLUMN(NAME=~"prati.code~") COMPUTE(NAME=~"(SELECT isnull(- sum(~~~"historique_es~~~".~~~"quantite~~~"),0) as sortie_histo FROM ~~~"historique_es~~~" WHERE ( ~~~"historique_es~~~".~~~"code_barre~~~" = ~~~"stock_produit~~~".~~~"code_barre~~~" )  AND ( ~~~"historique_es~~~".~~~"code_es~~~" = 's' ) AND( ~~~"historique_es~~~".~~~"date~~~" between :date_valo and today() ) and code_es = 'S')~") COLUMN(NAME=~"param_stock_fournisseur.qte_colisee~") COLUMN(NAME=~"produit.actif~") COLUMN(NAME=~"reference_produit.fournisseur_par_defaut~") COMPUTE(NAME=~"(select top 1 cast(cle as double) from table_vide) as valorisation~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )    JOIN (LEFT=~"produit.code_interne~"    OP =~"=~"RIGHT=~"param_stock_produit.code_produit~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )    JOIN (LEFT=~"stock_produit.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"stock_produit.code_produit~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"stock_produit.code_fournisseur~" )    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_produit~" )    JOIN (LEFT=~"reference_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"param_stock_fournisseur.code_fournisseur~" )    JOIN (LEFT=~"param_stock_fournisseur.code_praticien~"    OP =~"=~"RIGHT=~"param_stock_produit.code_praticien~" )WHERE(    EXP1 =~"~~~"param_stock_produit~~~".~~~"type_gestion~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"type_produit~~~".~~~"code_categorie_produit~~~"~"   OP =~"like~"    EXP2 =~":code_categorie_produit~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_type_produit~~~"~"   OP =~"like~"    EXP2 =~":code_type_produit~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_praticien~~~"~"   OP =~"like~"    EXP2 =~":praticien~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_praticien~~~"~"   OP =~"<>~"    EXP2 =~"'COMMUN'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"quantite_colisee~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"praticien~" TYPE = string)  ARG(NAME = ~"code_type_produit~" TYPE = string)  ARG(NAME = ~"code_categorie_produit~" TYPE = string)  ARG(NAME = ~"date_valo~" TYPE = date) " arguments=(("praticien", string),("code_type_produit", string),("code_categorie_produit", string),("date_valo", date))  sort="type_produit_code_categorie_produit A type_produit_type_produit A param_stock_fournisseur_code_produit A reference_produit_fournisseur_par_defaut D " )
