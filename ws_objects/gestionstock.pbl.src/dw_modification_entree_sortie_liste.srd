 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"historique_es~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"param_stock_fournisseur~" ) COLUMN(NAME=~"historique_es.code_es~") COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"stock_produit.numero_lot~") COLUMN(NAME=~"historique_es.date~") COLUMN(NAME=~"historique_es.heure~") COLUMN(NAME=~"historique_es.prix~") COLUMN(NAME=~"historique_es.code_type_taxe~") COLUMN(NAME=~"historique_es.quantite~") COLUMN(NAME=~"historique_es.utilisateur~") COLUMN(NAME=~"produit.couleur_texte~") COLUMN(NAME=~"stock_produit.numero_commande~") COLUMN(NAME=~"stock_produit.quantite~")    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"stock_produit.code_barre~"    OP =~"=~"RIGHT=~"historique_es.code_barre~" )    JOIN (LEFT=~"param_stock_fournisseur.code_produit~"    OP =~"=~"RIGHT=~"stock_produit.code_produit~" )    JOIN (LEFT=~"param_stock_fournisseur.code_fournisseur~"    OP =~"=~"RIGHT=~"stock_produit.code_fournisseur~" )    JOIN (LEFT=~"param_stock_fournisseur.code_praticien~"    OP =~"=~"RIGHT=~"stock_produit.code_praticien~" )    JOIN (LEFT=~"param_stock_fournisseur.code_produit~"    OP =~"=~"RIGHT=~"reference_produit.code_produit~" )    JOIN (LEFT=~"param_stock_fournisseur.code_fournisseur~"    OP =~"=~"RIGHT=~"reference_produit.code_fournisseur~" )WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_produit~~~"~"   OP =~"=~"    EXP2 =~":var_code_produit~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_fournisseur~~~"~"   OP =~"=~"    EXP2 =~":var_code_fournisseur~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":var_code_praticien~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"historique_es~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~" ) ) ARG(NAME = ~"var_code_produit~" TYPE = string)  ARG(NAME = ~"var_code_fournisseur~" TYPE = string)  ARG(NAME = ~"var_code_praticien~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("var_code_produit", string),("var_code_fournisseur", string),("var_code_praticien", string),("date_min", date),("date_max", date))  sort="historique_es_date A stock_produit_code_barre A historique_es_code_es A " )
