 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"index_taille~" ) COLUMN(NAME=~"index_taille.designation~") COLUMN(NAME=~"index_taille.code_fournisseur~") COLUMN(NAME=~"index_taille.code_index~") COLUMN(NAME=~"index_taille.debut~") COLUMN(NAME=~"index_taille.fin~") COLUMN(NAME=~"index_taille.type_index~") COLUMN(NAME=~"index_taille.format_designation~")WHERE(    EXP1 =~"~~~"index_taille~~~".~~~"code_fournisseur~~~"~"   OP =~"=~"    EXP2 =~":code_fournisseur~" ) ) ARG(NAME = ~"code_fournisseur~" TYPE = string) " update="index_taille" updatewhere=0 updatekeyinplace=no arguments=(("code_fournisseur", string)) )
