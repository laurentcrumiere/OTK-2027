 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produit~" )  TABLE(NAME=~"type_produit~" ) COLUMN(NAME=~"produit.code_interne~") COLUMN(NAME=~"type_produit.code_categorie_produit~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"produit.actif~") COLUMN(NAME=~"produit.gtin~") COLUMN(NAME=~"produit.numero_cas~")    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_interne~~~"~"   OP =~"=~"    EXP2 =~":var_code_produit~" ) ) ARG(NAME = ~"var_code_produit~" TYPE = string) " update="produit" updatewhere=1 updatekeyinplace=no arguments=(("var_code_produit", string)) )
