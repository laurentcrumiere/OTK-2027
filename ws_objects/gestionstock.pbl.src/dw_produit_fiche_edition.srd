 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"produit~" )  TABLE(NAME=~"type_produit~" )  TABLE(NAME=~"categorie_produit~" ) COLUMN(NAME=~"produit.code_interne~") COLUMN(NAME=~"type_produit.code_categorie_produit~") COLUMN(NAME=~"produit.code_type_produit~") COLUMN(NAME=~"categorie_produit.categorie_produit~") COLUMN(NAME=~"type_produit.type_produit~") COLUMN(NAME=~"produit.designation~")    JOIN (LEFT=~"type_produit.code~"    OP =~"=~"RIGHT=~"produit.code_type_produit~" )    JOIN (LEFT=~"type_produit.code_categorie_produit~"    OP =~"=~"RIGHT=~"categorie_produit.code~" )WHERE(    EXP1 =~"~~~"produit~~~".~~~"code_interne~~~"~"   OP =~"=~"    EXP2 =~":var_code_produit~" ) ) ARG(NAME = ~"var_code_produit~" TYPE = string) " arguments=(("var_code_produit", string)) )
