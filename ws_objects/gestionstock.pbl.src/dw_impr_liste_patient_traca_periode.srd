 column=(type=date update=yes updatewhereclause=yes name=fiche_tracabilite_date_rdv dbname="fiche_tracabilite.date_rdv" dbalias=".date_rdv" )
 column=(type=decimal(0) updatewhereclause=yes name=fiche_tracabilite_couleur_ligne dbname="fiche_tracabilite.couleur_ligne" dbalias=".couleur_ligne" )
