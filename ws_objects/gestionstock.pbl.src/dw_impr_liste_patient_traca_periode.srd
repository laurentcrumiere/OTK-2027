 column=(type=char(40) updatewhereclause=yes name=reference_produit_reference dbname="reference_produit.reference" dbalias=".reference" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fiche_tracabilite~" )  TABLE(NAME=~"produit~" )  TABLE(NAME=~"reference_produit~" )  TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"param_stock_produit~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"reference_produit.code_produit~") COLUMN(NAME=~"fiche_tracabilite.code_barre~") COLUMN(NAME=~"stock_produit.code_fournisseur~") COLUMN(NAME=~"stock_produit.numero_lot~") COLUMN(NAME=~"fiche_tracabilite.date_sortie~") COLUMN(NAME=~"fiche_tracabilite.code_patient~") COLUMN(NAME=~"fiche_tracabilite.date_rdv~") COLUMN(NAME=~"fiche_tracabilite.couleur_ligne~") COLUMN(NAME=~"param_stock_produit.type_gestion~") COLUMN(NAME=~"fiche_tracabilite.date_sterilisation~") COLUMN(NAME=~"produit.designation~") COLUMN(NAME=~"fiche_tracabilite.lieu~") COLUMN(NAME=~"stock_produit.code_praticien~") COLUMN(NAME=~"fiche_tracabilite.nb_unite~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"reference_produit.reference~")    JOIN (LEFT=~"reference_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"stock_produit.code_produit~"    OP =~"=~"RIGHT=~"reference_produit.code_produit~" )    JOIN (LEFT=~"stock_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"reference_produit.code_fournisseur~" )    JOIN (LEFT=~"stock_produit.code_barre~"    OP =~"=~"RIGHT=~"fiche_tracabilite.code_barre~" )    JOIN (LEFT=~"param_stock_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"stock_produit.code_praticien~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"fiche_tracabilite.code_patient~" )WHERE(    EXP1 =~"~~~"fiche_tracabilite~~~".~~~"date_rdv~~~"~"   OP =~"between~"    EXP2 =~":var_date1 and :var_date2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":pra_min and :pra_max~" ) ) ORDER(NAME=~"reference_produit.code_produit~" ASC=yes ) ARG(NAME = ~"pra_min~" TYPE = string)  ARG(NAME = ~"pra_max~" TYPE = string)  ARG(NAME = ~"var_date1~" TYPE = date)  ARG(NAME = ~"var_date2~" TYPE = date) " arguments=(("pra_min", string),("pra_max", string),("var_date1", date),("var_date2", date))  sort="fiche_tracabilite_code_patient A fiche_tracabilite_date_rdv A reference_produit_code_produit A fiche_tracabilite_code_barre A stock_produit_code_fournisseur A " )
