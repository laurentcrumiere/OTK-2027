detail(height=136 color="536870912" )
table(column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(30) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(15) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(15) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(30) updatewhereclause=yes name=correspondants_nom dbname="correspondants.nom" )
 column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" )
 column=(type=char(1) updatewhereclause=yes name=cmu dbname="patient.cmu" )
 column=(type=char(20) update=yes updatewhereclause=yes name=classe dbname="patient.classe" )
 column=(type=char(20) update=yes updatewhereclause=yes name=type dbname="patient.type" )
 column=(type=date updatewhereclause=yes name=fiche_tracabilite_date_rdv dbname="fiche_tracabilite.date_rdv" )
 column=(type=char(15) updatewhereclause=yes name=stock_produit_numero_lot dbname="stock_produit.numero_lot" )
 column=(type=decimal(0) updatewhereclause=yes name=stock_produit_code_barre dbname="stock_produit.code_barre" )
 column=(type=char(20) updatewhereclause=yes name=stock_produit_code_produit dbname="stock_produit.code_produit" )
 column=(type=char(30) updatewhereclause=yes name=fournisseur_nom dbname="fournisseur.nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"correspondants~" )  TABLE(NAME=~"dossier~" )  TABLE(NAME=~"fiche_tracabilite~" )  TABLE(NAME=~"stock_produit~" )  TABLE(NAME=~"fournisseur~" )  TABLE(NAME=~"produit~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"patient.cmu~") COLUMN(NAME=~"patient.classe~") COLUMN(NAME=~"patient.type~") COLUMN(NAME=~"fiche_tracabilite.date_rdv~") COLUMN(NAME=~"stock_produit.numero_lot~") COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"stock_produit.code_produit~") COLUMN(NAME=~"fournisseur.nom~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"correspondants.code~"    OP =~"=~"RIGHT=~"patient.code_correspondant~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )    JOIN (LEFT=~"fiche_tracabilite.code_patient~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"stock_produit.code_barre~"    OP =~"=~"RIGHT=~"fiche_tracabilite.code_barre~" )    JOIN (LEFT=~"stock_produit.code_fournisseur~"    OP =~"=~"RIGHT=~"fournisseur.code~" )    JOIN (LEFT=~"stock_produit.code_produit~"    OP =~"=~"RIGHT=~"produit.code_interne~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~" :prat_min  and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"fiche_tracabilite~~~".~~~"date_rdv~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("prat_min", string),("prat_max", string),("date_min", date),("date_max", date))  sort="nom A patient_prenom A " )
