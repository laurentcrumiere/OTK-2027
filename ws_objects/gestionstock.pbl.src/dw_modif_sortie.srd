 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"historique_es~" )  TABLE(NAME=~"stock_produit~" ) COLUMN(NAME=~"historique_es.code_barre~") COLUMN(NAME=~"historique_es.code_es~") COLUMN(NAME=~"historique_es.date~") COLUMN(NAME=~"historique_es.prix~") COLUMN(NAME=~"historique_es.quantite~") COLUMN(NAME=~"historique_es.utilisateur~") COLUMN(NAME=~"historique_es.libelle~") COLUMN(NAME=~"historique_es.code_type_taxe~") COLUMN(NAME=~"historique_es.code_lieu_utilisation~") COLUMN(NAME=~"stock_produit.code_barre~") COLUMN(NAME=~"stock_produit.code_produit~") COLUMN(NAME=~"stock_produit.code_fournisseur~") COLUMN(NAME=~"stock_produit.numero_lot~") COLUMN(NAME=~"stock_produit.code_lieu_stockage~") COLUMN(NAME=~"stock_produit.quantite~") COLUMN(NAME=~"stock_produit.quantite_colisee~") COLUMN(NAME=~"stock_produit.numero_commande~") COLUMN(NAME=~"stock_produit.code_praticien~") COLUMN(NAME=~"historique_es.poste_utilisation~") COLUMN(NAME=~"historique_es.heure~") COLUMN(NAME=~"stock_produit.date_peremption~")    JOIN (LEFT=~"stock_produit.code_barre~"    OP =~"=~"RIGHT=~"historique_es.code_barre~" )WHERE(    EXP1 =~"~~~"stock_produit~~~".~~~"code_barre~~~"~"   OP =~"=~"    EXP2 =~":var_code_barre~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"historique_es~~~".~~~"code_es~~~"~"   OP =~"=~"    EXP2 =~"'s'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"historique_es~~~".~~~"date~~~"~"   OP =~"=~"    EXP2 =~":date_sortie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"historique_es~~~".~~~"heure~~~"~"   OP =~"=~"    EXP2 =~":heure_sortie~" ) ) ARG(NAME = ~"var_code_barre~" TYPE = number)  ARG(NAME = ~"date_sortie~" TYPE = date)  ARG(NAME = ~"heure_sortie~" TYPE = time) " arguments=(("var_code_barre", number),("date_sortie", date),("heure_sortie", time)) )
