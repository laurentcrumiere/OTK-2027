table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=numero_commande dbname="commande.numero_commande" dbalias=".numero_commande" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_fournisseur dbname="commande.code_fournisseur" dbalias=".code_fournisseur" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="commande.code_praticien" dbalias=".code_praticien" )
 column=(type=date update=yes updatewhereclause=yes name=date_commande dbname="commande.date_commande" dbalias=".date_commande" )
 column=(type=char(30) update=yes updatewhereclause=yes name=mode_transport dbname="commande.mode_transport" dbalias=".mode_transport" )
 column=(type=char(6) update=yes updatewhereclause=yes name=utilisateur dbname="commande.utilisateur" dbalias=".utilisateur" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=commentaires dbname="commande.commentaires" dbalias=".commentaires" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=couleur_texte dbname="commande.couleur_texte" dbalias=".couleur_texte" )
 column=(type=datetime updatewhereclause=yes name=date_envoi dbname="commande.date_envoi" dbalias=".date_envoi" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"commande~" ) COLUMN(NAME=~"commande.numero_commande~") COLUMN(NAME=~"commande.code_fournisseur~") COLUMN(NAME=~"commande.code_praticien~") COLUMN(NAME=~"commande.date_commande~") COLUMN(NAME=~"commande.mode_transport~") COLUMN(NAME=~"commande.utilisateur~") COLUMN(NAME=~"commande.commentaires~") COLUMN(NAME=~"commande.couleur_texte~") COLUMN(NAME=~"commande.date_envoi~")WHERE(    EXP1 =~"~~~"commande~~~".~~~"date_commande~~~"~"   OP =~"between~"    EXP2 =~":date_debut and :date_fin~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"commande~~~".~~~"code_praticien~~~"~"   OP =~"like~"    EXP2 =~":code_praticien~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"commande~~~".~~~"code_fournisseur~~~"~"   OP =~"like~"    EXP2 =~":code_fournisseur~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~"   OP =~"exists~"    EXP2 =~"(SELECT *  FROM ~~~"ligne_commande~~~" WHERE ( ~~~"ligne_commande~~~".~~~"numero_commande~~~" =~~~"commande~~~". ~~~"numero_commande~~~" ) AND  ( ~~~"ligne_commande~~~".~~~"solde~~~" like :var_solde )  )~" ) ) ARG(NAME = ~"date_debut~" TYPE = date)  ARG(NAME = ~"date_fin~" TYPE = date)  ARG(NAME = ~"code_fournisseur~" TYPE = string)  ARG(NAME = ~"code_praticien~" TYPE = string)  ARG(NAME = ~"var_solde~" TYPE = string) " update="commande" updatewhere=1 updatekeyinplace=no arguments=(("date_debut", date),("date_fin", date),("code_fournisseur", string),("code_praticien", string),("var_solde", string))  sort="numero_commande A " )
