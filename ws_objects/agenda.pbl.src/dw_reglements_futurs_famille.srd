table(column=(type=char(81) updatewhereclause=yes name=nom dbname="nom_patient" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=date updatewhereclause=yes name=date_proc_reglt dbname="patient.date_proc_reglt" )
 column=(type=decimal(2) updatewhereclause=yes name=mont_proc_reglt dbname="patient.mont_proc_reglt" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=date updatewhereclause=yes name=date_proc_reglt_tp dbname="table_vide.date_proc_reglt_tp" )
 column=(type=char(1) updatewhereclause=yes name=mont_proc_reglt_tp dbname="table_vide.mont_proc_reglt_tp" )
 retrieve="  SELECT nom+' '+isnull(prenom, '') as nom_patient ,
		numero_dossier ,
		date_proc_reglt , 
		mont_proc_reglt ,
		code ,
		table_vide.d1 as date_proc_reglt_tp , 
		table_vide.v1 as mont_proc_reglt_tp 

    FROM patient, table_vide

   WHERE   code in  ( SELECT ~"patient_lien_parente~".~"code_patient2~"
    FROM ~"lien_parente~",   
         ~"patient~",   
         ~"patient_lien_parente~"  
   WHERE ( ~"patient_lien_parente~".~"code_patient2~" = ~"patient~".~"code~" ) and  
         ( ~"patient_lien_parente~".~"code_lien_parente~" = ~"lien_parente~".~"code~" ) and  
         (  ~"patient_lien_parente~".~"code_patient1~" = :v_code and   ~"patient_lien_parente~".~"liaison_financiere~" = 'O')    

UNION

  SELECT  ~"patient_lien_parente~".~"code_patient1~"
    FROM ~"lien_parente~",   
         ~"patient~",   
         ~"patient_lien_parente~"  
   WHERE ( ~"patient_lien_parente~".~"code_patient1~" = ~"patient~".~"code~" ) and  
         ( ~"patient_lien_parente~".~"code_lien_parente~" = ~"lien_parente~".~"code~" ) and  
         (  ~"patient_lien_parente~".~"code_patient2~" = :v_code and   ~"patient_lien_parente~".~"liaison_financiere~" = 'O')   


UNION
   
	 SELECT code 
    FROM ~"patient~"   
   WHERE ( ~"patient~".~"code~" = :v_code )    )" arguments=(("v_code", number))  sort="nom A " )
