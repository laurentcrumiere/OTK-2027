table(column=(type=datetime updatewhereclause=yes name=rdv dbname="rdv.rdv" dbalias=".rdv" initial="today" )
 column=(type=char(6) updatewhereclause=yes name=type dbname="rdv.type" dbalias=".type" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="rdv.code_praticien" dbalias=".code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=duree dbname="rdv.duree" dbalias=".duree" )
 column=(type=decimal(0) updatewhereclause=yes name=fauteuil dbname="rdv.fauteuil" dbalias=".fauteuil" )
 column=(type=char(6) updatewhereclause=yes name=absent dbname="rdv.absent" dbalias=".absent" )
 column=(type=number updatewhereclause=yes name=code dbname="rdv.code" dbalias=".code" )
 column=(type=char(81) updatewhereclause=yes name=nom dbname="nom_patient" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="numero_dossier" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" dbalias=".couleur" )
 column=(type=decimal(0) updatewhereclause=yes name=couleur_etat dbname="couleur_etat" )
 column=(type=long updatewhereclause=yes name=ecart_semaine dbname="ecart_semaine" )
 retrieve="  SELECT ~"rdv~".~"rdv~",   
         ~"rdv~".~"type~",   
         ~"rdv~".~"code_praticien~",   
         ~"rdv~".~"duree~",   
         ~"rdv~".~"fauteuil~",   
         ~"rdv~".~"absent~"  , ~"rdv~".~"code~", 
		(select nom+' '+isnull(prenom, '') from patient where patient.code = rdv.code) as nom_patient ,
		(select numero_dossier from patient where patient.code = rdv.code) as numero_dossier ,
		type_rdv.couleur, 
		(select couleur from etat_rdv where rdv.absent = etat_rdv.code) as couleur_etat ,
		datediff (week, (select top 1 rdv_pas.rdv from rdv as rdv_pas where rdv_pas.code = rdv.code and rdv_pas.rdv < rdv.rdv order by rdv_pas.rdv desc), rdv.rdv) as ecart_semaine

    FROM ~"rdv~"  , type_rdv 

   WHERE   cast(~"rdv~".~"rdv~" as date) >= cast(getdate() as date)  and  rdv.~"type~" = type_rdv.code  and  
rdv.code in  ( SELECT ~"patient_lien_parente~".~"code_patient2~"
    FROM ~"lien_parente~",   
         ~"patient~",   
         ~"patient_lien_parente~"  
   WHERE ( ~"patient_lien_parente~".~"code_patient2~" = ~"patient~".~"code~" ) and  
         ( ~"patient_lien_parente~".~"code_lien_parente~" = ~"lien_parente~".~"code~" ) and  
         (  ~"patient_lien_parente~".~"code_patient1~" = :v_code  )    and ( ~"patient_lien_parente~".~"liaison_financiere~" = 'O' or  ~"patient_lien_parente~".~"synchroniser~" = 'O' )  

UNION

  SELECT  ~"patient_lien_parente~".~"code_patient1~"
    FROM ~"lien_parente~",   
         ~"patient~",   
         ~"patient_lien_parente~"  
   WHERE ( ~"patient_lien_parente~".~"code_patient1~" = ~"patient~".~"code~" ) and  
         ( ~"patient_lien_parente~".~"code_lien_parente~" = ~"lien_parente~".~"code~" ) and  
         (  ~"patient_lien_parente~".~"code_patient2~" = :v_code ) and ( ~"patient_lien_parente~".~"liaison_financiere~" = 'O' or  ~"patient_lien_parente~".~"synchroniser~" = 'O' )   


UNION
   
	 SELECT code 
    FROM ~"patient~"   
   WHERE ( ~"patient~".~"code~" = :v_code )    )" arguments=(("v_code", number))  sort="nom A code A rdv A " )
