table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=rdv dbname="rdv.rdv" initial="today" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=type dbname="rdv.type" validationmsg="~"Le type de rendez-vous doit faire partie de la liste déroulante.~"" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code_praticien dbname="rdv.code_praticien" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=duree dbname="rdv.duree" initial="10" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=fauteuil dbname="rdv.fauteuil" initial="1" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="rdv.code" )
 column=(type=char(6) update=yes updatewhereclause=yes name=absent dbname="rdv.absent" initial="N" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_prochain_rdv_nb dbname="patient.prochain_rdv_nb" )
 column=(type=char(1) updatewhereclause=yes name=patient_prochain_rdv_tps dbname="patient.prochain_rdv_tps" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="rdv.user_modif" )
 column=(type=datetime update=yes updatewhereclause=yes name=date_modif dbname="rdv.date_modif" )
 column=(type=char(200) update=yes updatewhereclause=yes name=rdv_commentaire dbname="rdv.commentaire" )
 column=(type=number update=yes updatewhereclause=yes name=code_interne dbname="rdv.code_interne" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" )
 column=(type=time update=yes updatewhereclause=yes name=rdv_arrivee dbname="rdv.arrivee" )
 column=(type=char(6) update=yes updatewhereclause=yes name=rdv_user_suivi_clinique dbname="rdv.user_suivi_clinique" )
 column=(type=char(50) update=yes updatewhereclause=yes name=rdv_id_origine dbname="rdv.id_origine" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(30) updatewhereclause=yes name=utilisateurs_nom dbname="utilisateurs.nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdv~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"etat_rdv~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"utilisateurs~" ) COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"rdv.code~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"patient.prochain_rdv_nb~") COLUMN(NAME=~"patient.prochain_rdv_tps~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"rdv.user_modif~") COLUMN(NAME=~"rdv.date_modif~") COLUMN(NAME=~"rdv.commentaire~") COLUMN(NAME=~"rdv.code_interne~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"rdv.arrivee~") COLUMN(NAME=~"rdv.user_suivi_clinique~") COLUMN(NAME=~"rdv.id_origine~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"utilisateurs.nom~")    JOIN (LEFT=~"rdv.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"etat_rdv.code~"    OP =~"=~"RIGHT=~"rdv.absent~" )    JOIN (LEFT=~"patient.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"rdv.user_modif~"    OP =~"=~"RIGHT=~"utilisateurs.code~" )WHERE(    EXP1 =~"( ( ~~~"rdv~~~".~~~"fauteuil~~~"~"   OP =~"=~"    EXP2 =~":numero_fauteuil )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"rdv~~~".~~~"rdv~~~"~"   OP =~"between~"    EXP2 =~":date_rdv and :date_intervalle )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"rdv~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":praticien_de and :praticien_a ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"elimine_agenda~~~"~"   OP =~"<>~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"numero_fauteuil~" TYPE = number)  ARG(NAME = ~"date_rdv~" TYPE = datetime)  ARG(NAME = ~"date_intervalle~" TYPE = datetime)  ARG(NAME = ~"praticien_de~" TYPE = string)  ARG(NAME = ~"praticien_a~" TYPE = string) " update="rdv" updatewhere=0 updatekeyinplace=no arguments=(("numero_fauteuil", number),("date_rdv", datetime),("date_intervalle", datetime),("praticien_de", string),("praticien_a", string)) )
