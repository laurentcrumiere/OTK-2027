type m_historiquedesetatsdurendez-vous from menu within planning
end type

event clicked;//Declaration des variables locales
//---------------------------
long temp_code_patient_agenda
datetime temp_date_rdv_agenda

//Caclul des variables temp du code_patient et de la date dur RDV
//---------------------------------------------------
temp_code_patient_agenda=long(w_agenda.code_patient_agenda)
temp_date_rdv_agenda=datetime(date(left(w_agenda.date_rdv_agenda,10)),time(mid(w_agenda.date_rdv_agenda,12,8)))

double var_code_interne_local
SELECT  code_interne into :var_code_interne_local 
FROM Rdv	WHERE code=:temp_code_patient_agenda
							AND rdv=:temp_date_rdv_agenda
							AND "type"=:w_agenda.type_rdv_agenda
							AND code_praticien = :w_agenda.code_praticien_agenda;


openwithparm(w_rdv_histo_etat,  var_code_interne_local)

end event

