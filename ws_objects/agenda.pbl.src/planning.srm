event clicked;open(w_patience)

w_agenda w_agenda_ouvert

if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
	// Agenda à part
	w_agenda_ouvert = w_agenda_a_part
else
	w_agenda_ouvert = w_agenda
end if


// Calcul pour la demi-journée cliquée
//--------------------------------------------------------------------------


datetime date_min, date_max, date_heure_cliquee
date date_jour
string prat1,prat2

time v_pause_debut, v_pause_fin
string v_praticien


date_heure_cliquee = w_agenda_ouvert.param_rdv.date_debut

date_jour = date(date_heure_cliquee)



// Recherche des paramètres de pause 




if w_agenda_ouvert.dw_praticien.visible then
	
	// Agenda pour 1 praticien 
	v_praticien = w_agenda_ouvert.dw_praticien.gettext()
	
	string lib_fauteuil_praticien[10]

	// On charge les données de la table des options PAR praticien !!
	//-------------------------------------------------------------
		SELECT	pause_debut, pause_fin
		INTO		:v_pause_debut, :v_pause_fin
		FROM 	"agenda_praticien" 
		WHERE   code_praticien = :v_praticien ;

	
else

		//Recuperation des paramètres depuis la table agenda
		//-------------------------------------------------------------
		SELECT	top 1 pause_debut, pause_fin 
		INTO		:v_pause_debut, :v_pause_fin
		FROM 	"agenda" ;

end if

// si pas de pause 
if v_pause_debut = v_pause_fin then
	// pas de pause, on fixe à 13h la rupture de la 1/2 journée
	v_pause_debut = time("12:59")
	v_pause_fin =  time("13:00")
end if



// Matin ou après midi ???

if time(date_heure_cliquee) < v_pause_debut then 
	// c'est le matin
	date_min = datetime(date_jour, time("00:00"))
	date_max = datetime(date_jour, v_pause_debut)
	
else
	// c'est l'après midi !
	date_min = datetime(date_jour, v_pause_fin)
	date_max = datetime(date_jour, time("23:59"))
	
end if



// Praticiens
if left(w_agenda_ouvert.tous,1)<> 'O' then
		prat1=w_agenda_ouvert.dw_praticien.gettext()
		prat2 = prat1 
	else
		prat1 = '      '
		prat2 = 'ZZZZZZ'
	end if




// Appel de la Dw
w_agenda_ouvert.dw_synthese.retrieve(date_min, date_max,prat1,prat2, 0, 99)

w_agenda_ouvert.tab.visible = false
w_agenda_ouvert.dw_synthese.visible = true

close(w_patience)
end event

