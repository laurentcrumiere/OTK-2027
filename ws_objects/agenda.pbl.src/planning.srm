end on

event clicked;if CodePatientCourant < 0 then 
	if Doctolib then
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous Doctolib pour un patient non validé par Orthokis !")
	else
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous pris en ligne pour un patient non validé par Orthokis !")
	end if
else
	//Declaration des variables locales
	//---------------------------
	long temp_code_patient_agenda
	datetime  temp_date_rdv_agenda
	string rdv_agenda_string , v1
	
	//Demande de confirmation
	//---------------------
	
	double var_code_interne_local
	datetime v_proc 
	
	w_agenda w_agenda_ouvert
	
	if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
		// Agenda à part
		w_agenda_ouvert = w_agenda_a_part
	else
		w_agenda_ouvert = w_agenda
	end if
	
	//Caclul des variables temp du code_patient et de la date dur RDV
	//---------------------------------------------------
	temp_code_patient_agenda=long(w_agenda_ouvert.code_patient_agenda)
	
	if  temp_code_patient_agenda < 0 then
		// patient temporaire de doctolib ou autre ... on touche pas
		return
	end if
	
	
	if (messagebox("Suppression de rendez-vous.","Etes vous sûr de vouloir supprimer ce rendez-vous ?",Question!,YesNo!))=2 then
		return
	end if
	
	
	temp_date_rdv_agenda=datetime(date(left(w_agenda_ouvert.date_rdv_agenda,10)),time(mid(w_agenda_ouvert.date_rdv_agenda,12,12)))
	
	v1 = w_agenda_ouvert.date_rdv_agenda
	rdv_agenda_string = string( date(left(w_agenda_ouvert.date_rdv_agenda,10) ), 'yyyy-mm-dd') + " "+ mid(w_agenda_ouvert.date_rdv_agenda,12,12)
	
	// On récupère le code interne du rdv pour supprimer l'historique des états de rdv 
	SELECT  code_interne into :var_code_interne_local 
	FROM Rdv	WHERE code=:temp_code_patient_agenda
								//AND rdv= :temp_date_rdv_agenda
								AND rdv= datetime(:rdv_agenda_string) 
								AND "type"=:w_agenda_ouvert.type_rdv_agenda
								AND code_praticien = :w_agenda_ouvert.code_praticien_agenda;
	
	delete from historique_etat_rdv where round(code_interne,0) = :var_code_interne_local ;
	commit ;
	
	
	//Supprime le rdv grace a sa clef
	//-------------------------
	DELETE FROM Rdv	WHERE code=:temp_code_patient_agenda
								AND rdv=:temp_date_rdv_agenda
								AND "type"=:w_agenda_ouvert.type_rdv_agenda
								AND code_praticien = :w_agenda_ouvert.code_praticien_agenda;
								
	commit;
	
	if TEA then
		// le rdv a été supprimé
		fxg_lancer_commande_dsapi("appointment/delete/" + string(var_code_interne_local), "", "R", "G", temp_code_patient_agenda  )
	end if

	ajout_histo_actions(temp_code_patient_agenda,"SUPRDV",today(),"Rendez-vous du "+string(temp_date_rdv_agenda, "dd/mm/yyyy à hh:mm" ))
	
	// On a besoin de l'uo Pocket ensuite, meme pour Dental SMS
	uo_pocket uo_poc
	uo_poc = create uo_pocket
	uo_poc.triggerevent(constructor!)
	
	
	if OPERATEUR_SMS = 2 then 
		string s_host_dental_sms 
		s_host_dental_sms = uo_poc.get_host()
		fxg_maj_dental_sms(var_code_interne_local, "", s_host_dental_sms, 'S' )
	end if
	
	
	// On recherche si le patient à un prochain rendez-vous 
	
	v_proc = proc_rdv(temp_code_patient_agenda)
	
	if not isnull(v_proc) then
		Messagebox("ATTENTION","Ce patient a un autre rendez-vous prévu le "+string(v_proc, "dd/mm/yyyy à hh:mm")+".")
	end if
	
	//Bloque l'affichage
	//--------------
	w_agenda_ouvert.tab.object.redraw=FALSE
	
	//Rafraichit les RDV
	//---------------
	w_agenda_ouvert.Actualiser()
	
	//Recherche de la pause dejeuner et affiche des heures dans la colonne fixe
	// Utile surout pour matérialiser les heures fixes si besoin
	//-----------------------------------------------------------
	w_agenda_ouvert.recherche_pause_dejeuner(w_agenda_ouvert.pause_debut,w_agenda_ouvert.pause_fin,w_agenda_ouvert.nombre_intervalle)
	
	
	//Autorise l'affichage
	//----------------
	w_agenda_ouvert.tab.object.redraw=TRUE
	
end if
end event

