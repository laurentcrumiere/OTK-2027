event clicked;

// Selection du rendez-vous dans la fenetre


//"Rendez-vous en attente"
var_suite = false

openWithParm(w_rdv_en_attente, "S")
//guo_fenetre_modale.wf_ouvrir_param_string(w1, "S")

// récupration du rdv sélectionné 


st_rdv v_rdv_a_donner


if var_suite then
	
	v_rdv_a_donner = message.powerobjectparm
	
	w_agenda w_agenda_ouvert

	if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
		// Agenda à part
		w_agenda_ouvert = w_agenda_a_part
	else
		w_agenda_ouvert = w_agenda
	end if
	
	w_agenda_ouvert.param_rdv.patient_courant = true
	w_agenda_ouvert.param_rdv.nouveau = true
	
	w_agenda_ouvert.param_rdv.praticien_a = v_rdv_a_donner.praticien_a 
	w_agenda_ouvert.param_rdv.type_rdv = v_rdv_a_donner.type_rdv 
	w_agenda_ouvert.param_rdv.code_patient_courant = v_rdv_a_donner.code_patient_courant
	w_agenda_ouvert.param_rdv.rdv_en_attente = true
	
//	w_agenda_ouvert.param_rdv.praticien_a ='JC'
//	w_agenda_ouvert.param_rdv.type_rdv = '58'
//	w_agenda_ouvert.param_rdv.code_patient_courant = 13279

	
	openwithparm(w_detail_rdv, w_agenda_ouvert.param_rdv)
	
	if param_win [1] = "1" then 
		// le rendez vous a bien été pris
		
		// Actualisation de l'agenda
		w_agenda_ouvert.cb_rafraichir.triggerevent(clicked!)
		
		// Suppression du rdv a prendre dans la liste
		
		delete from rdv_en_attente where code = :v_rdv_a_donner.code_patient_courant and type_rdv = :v_rdv_a_donner.type_rdv  ;
		
		if sqlca.sqlcode = 0 then 
			commit ;
			
			w_agenda_ouvert.actualiser_nb_rdv_en_attente()
			
		else
			
			Messagebox("ATTENTION", "Erreur dans la suppresion du rendez-vous dans la liste d'attente !~n~n" + sqlca.sqlerrtext )
			rollback ;
			
			
		end if
		
	end if

end if
end event

