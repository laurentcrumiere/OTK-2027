forward prototypes
public subroutine ajout_rdv_patient_courant ()
public subroutine report_rdv (string v_type_report)
end prototypes

public subroutine ajout_rdv_patient_courant ();
// w_agenda.param_rdv doit être initialisée avant


if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
	// Agenda à part


	openwithparm(w_detail_rdv,w_agenda_a_part.param_rdv)
	
	//Bloque l'affichage
	//--------------
	w_agenda_a_part.tab.object.redraw=FALSE
	
	//Rafraichit les RDV
	//---------------
	w_agenda_a_part.Actualiser()
	
	//Recherche de la pause dejeuner et affiche des heures dans la colonne fixe
	// Utile surout pour matérialiser les heures fixes si besoin
	//-----------------------------------------------------------
	w_agenda_a_part.recherche_pause_dejeuner(w_agenda_a_part.pause_debut,w_agenda_a_part.pause_fin,w_agenda_a_part.nombre_intervalle)
	
	
	//Autorise l'affichage
	//----------------
	w_agenda_a_part.tab.object.redraw=TRUE
	
else

	openwithparm(w_detail_rdv,w_agenda.param_rdv)
	
	//Bloque l'affichage
	//--------------
	w_agenda.tab.object.redraw=FALSE
	
	//Rafraichit les RDV
	//---------------
	w_agenda.Actualiser()
	
	//Recherche de la pause dejeuner et affiche des heures dans la colonne fixe
	// Utile surout pour matérialiser les heures fixes si besoin
	//-----------------------------------------------------------
	w_agenda.recherche_pause_dejeuner(w_agenda.pause_debut,w_agenda.pause_fin,w_agenda.nombre_intervalle)
	
	
	//Autorise l'affichage
	//----------------
	w_agenda.tab.object.redraw=TRUE
	
end if

end subroutine

public subroutine report_rdv (string v_type_report);
// Paramètre : v_type_report
// C pour report Cabinet
// P pour report patient
// A pour mise en attente du rendez-vous -> report patient + mise en attente

// etat du rdv de report
string v_etat
integer v_cpt
boolean v_suite = true
string ls_libelle_report, ls_libelle2_report, v_type_rdv, v_commentaire

choose case v_type_report 
	case "C" 
		select top 1 etat_report_cabinet into :v_etat 
		from param ; 
		ls_libelle_report = "Le report"
		ls_libelle2_report = "reporter"
	case "P", "A"
		select top 1 etat_report_patient into :v_etat 
		from param ; 
		if v_type_report = "P" then
			ls_libelle_report = "Le report"
			ls_libelle2_report = "reporter"
		else
			ls_libelle_report = "La mise en attente"
			ls_libelle2_report = "mettre en attente"
		end if
end choose




// Vérif qu'il existe 
select count(*) into :v_cpt from etat_rdv where code = :v_etat ;

if v_cpt = 1 then 
	
	v_suite = true
else
	
	// faut définir les états
	if Messagebox("ATTENTION !", "Vous n'avez pas défini d'état pour le report de rendez-vous !~n~nSouhaitez-vous le définir ?", Question!, YesNo!, 1) = 1 then
		open(w_param_etats_reports)
		
		// En resteste ensuite car le user peut ne pas avoir mis à jour le bon ou les 2
		
		choose case v_type_report 
			case "C" 
				select top 1 etat_report_cabinet into :v_etat 
				from param ; 
			case "P", "A"
				select top 1 etat_report_patient into :v_etat 
				from param ; 
		end choose
		
		// Vérif qu'il existe 
		select count(*) into :v_cpt from etat_rdv where code = :v_etat ;
		
		if v_cpt = 1 then 
			v_suite = true
		else
			v_suite = false
			Messagebox("ATTENTION !", ls_libelle_report +" de rendez-vous est abandonné !")
		end if
	else
		v_suite = false
		Messagebox("ATTENTION !", ls_libelle_report + " de rendez-vous est abandonné !")
	end if
end if


if v_suite then
	
	w_agenda w_agenda_ouvert

	if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
		// Agenda à part
		w_agenda_ouvert = w_agenda_a_part
	else
		w_agenda_ouvert = w_agenda
	end if

	// Copie du rdv
	w_agenda_ouvert.code_patient_couper	=	w_agenda_ouvert.code_patient_agenda
	w_agenda_ouvert.rdv_couper				=	w_agenda_ouvert.date_rdv_agenda
	w_agenda_ouvert.type_couper				=	w_agenda_ouvert.type_rdv_agenda
	w_agenda_ouvert.code_praticien_couper	=	w_agenda_ouvert.code_praticien_agenda
	w_agenda_ouvert.couper						=	false
	w_agenda_ouvert.copier						=	true
	
	w_agenda_ouvert.code_interne_rdv_couper = w_agenda_ouvert.code_interne_agenda 

	
	
	// Y a t il pluisuers rdv qui se suivent pour la fratrie ?
	double db_codes_internes_fratrie[], db_code_patient
	integer i_nb_rdv_a_reporter, i_cpt
	boolean b_erreur
	datetime dt_rdv_report
	string s_nom_complet_patient, v_code_praticien
	
	i_nb_rdv_a_reporter = nombre_rdv_meme_famille_a_la_suite(   double(w_agenda.code_patient_couper),  datetime(w_agenda.rdv_couper) , w_agenda.code_interne_rdv_couper, db_codes_internes_fratrie, integer(integer(w_agenda_ouvert.numero_fauteuil_agenda)))
	
	
	if  i_nb_rdv_a_reporter > 1 then
		
		if Messagebox("ATTENTION", string(i_nb_rdv_a_reporter) + " rendez-vous à la suite concernent la même famille.~n~nSouhaitez vous tous les " + ls_libelle2_report + " ?", Question!, YesNo!, 1) = 2 then
			// On ne garde que le 1er
			i_nb_rdv_a_reporter = 1
		end if
	end if
	
	// Boucle pour traiter tous les rendez-vous
	b_erreur = false
	
	for i_cpt = 1 to i_nb_rdv_a_reporter
	
		
//		UPDATE rdv	 set absent = :v_etat, date_modif = getdate() , user_modif = :utilisateur_code 
//				WHERE convert(numeric(30), code_interne) = :db_codes_internes_fratrie[i_cpt] ;

		UPDATE rdv	 set absent = :v_etat, date_modif = getdate() , user_modif = :utilisateur_code 
				WHERE round(code_interne,0) = :db_codes_internes_fratrie[i_cpt] ;
	
	
		if sqlca.sqlcode = 0 then 
			

			commit ;
	
			// Memorisation de l'historique + info Dental SMS si besoin
			ajout_histo_etat_rdv(db_codes_internes_fratrie[i_cpt] , v_etat )
	
			// recherche des élements du rdv
			select code, rdv , code_praticien, "type"
			into :db_code_patient, :dt_rdv_report, :v_code_praticien , :v_type_rdv
			from rdv where round(code_interne,0) = :db_codes_internes_fratrie[i_cpt] ;
			
			// Mettre un commentaire de report de rdv ?
			// Vérification si saisie d'un commentaire clinique pour report du rdv ....
			
			//commentaire_clinique_absence ( double(w_agenda_ouvert.code_patient_agenda), date(w_agenda_ouvert.date_rdv_agenda),  v_etat)
			commentaire_clinique_absence (  db_code_patient , date(dt_rdv_report),  v_etat, db_codes_internes_fratrie[i_cpt] )
			
			if TEA then
				fxg_lancer_commande_dsapi("appointment/update/" + string(db_codes_internes_fratrie[i_cpt]), "", "R", "G", db_code_patient  )
				fxg_verif_envoi_questionnaire_tea(db_code_patient, dt_rdv_report, v_code_praticien, v_type_rdv)
			end if
	
			if v_type_report = "A" then 
				// Ajout des rendez-vous dans la liste des mise en attente
				v_commentaire = "Report du rendez-vous du " + string(dt_rdv_report, "dd/mm/yyyy à hh:mm")
				insert into "rdv_en_attente" ("code", "type_rdv", "a_partir", "code_praticien", "commentaire")
				values ( :db_code_patient, :v_type_rdv, date(:dt_rdv_report), :v_code_praticien, :v_commentaire  ) ;
				
				if sqlca.sqlcode = 0 then 
					commit ;
				else
					Messagebox("ATTENTION", "Erreur dans la mise en attente du rendez-vous du " +  string(dt_rdv_report, "dd/mm/yyyy à hh:mm") + " :~n~n" + sqlca.sqlerrtext + "~n~nLe rendez-vous est bien reporté mais pas consigné dans la liste !")
					rollback ;
				end if
			end if
	
		else
			
			// recherche des élements du rdv pour affichage erreur
			select nom + ' ' + isnull(prenom,'') , rdv into :s_nom_complet_patient, :dt_rdv_report 
			from rdv , patient where round(code_interne,0) = :db_codes_internes_fratrie[i_cpt] and rdv.code = patient.code ;
			
			Messagebox("ATTENTION", "Une erreur c'est produite dans le report du rendez-vous.~nPatient : " + s_nom_complet_patient + "Rendez-vous : " + string(dt_rdv_report, "dd/mm/yyyy à hh:mm" ) + "~n~n~nErreur N° : " + string(sqlca.sqlcode)  + "~n~nTexte : " + sqlca.sqlerrtext)
			b_erreur = true
			
			rollback ; 
		end if
		
	next
	
	if not b_erreur then
		// tout est OK ... on bascule le copier / coller 
		w_agenda_ouvert.couper						=	false
		w_agenda_ouvert.copier						=	true
		w_agenda_ouvert.db_codes_internes_fratrie = db_codes_internes_fratrie
		w_agenda_ouvert.i_nb_rdv_a_reporter = i_nb_rdv_a_reporter
	else
		setnull(w_agenda_ouvert.db_codes_internes_fratrie)
		w_agenda_ouvert.i_nb_rdv_a_reporter = 0
	end if

	if v_type_report = "A" then 
		// actualisation du compteur sur le bouton
		// y a  t il des rendez-vous en attente 
		w_agenda_ouvert.actualiser_nb_rdv_en_attente()
		
		// Actualisation de l'affichage de l'agenda
		w_agenda_ouvert.cb_rafraichir.postevent(clicked!)
	end if
	
end if
end subroutine

