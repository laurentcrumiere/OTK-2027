event clicked;
if CodePatientCourant < 0 then 
	if Doctolib then
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous Doctolib pour un patient non validé par Orthokis !")
	else
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous pris en ligne pour un patient non validé par Orthokis !")
	end if
else
	//Mise à jour des patients en mémoire
	MajTabPatientsCourants(CodePatientCourant)
	
	
	if not isnull(CodePatientCourant) and CodePatientCourant <> 0 then
		// uniquement pour compatibilité de l'appel
		datawindow dw 
		integer desti
		
		fxg_envoi_email_libre(CodePatientCourant, dw, desti)
	
	else
		son(5)
		MessageBox("ATTENTION","Aucun patient courant !",Exclamation!)
	end if	
end if

end event

