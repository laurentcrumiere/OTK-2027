	// Agenda à part
	w_agenda_ouvert = w_agenda_a_part
else
	w_agenda_ouvert = w_agenda
end if


// Calcul pour le jour cliqué
//--------------------------------------------------------------------------

date date_jour
datetime date_min, date_max
string prat1,prat2

date_jour = date(w_agenda_ouvert.param_rdv.date_debut)

date_min = datetime(date_jour, time("00:00"))
date_max = datetime(date_jour, time("23:59"))

// Praticiens
if left(w_agenda_ouvert.tous,1)<> 'O' then
		prat1=w_agenda_ouvert.dw_praticien.gettext()
		prat2 = prat1 
	else
		prat1 = '      '
		prat2 = 'ZZZZZZ'
	end if


// Appel de la Dw
w_agenda_ouvert.dw_synthese.retrieve(date_min, date_max,prat1,prat2, 0, 99)

