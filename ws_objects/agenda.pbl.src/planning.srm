type m_ticketderendez-vous from menu within planning
end type

event clicked;// Il peut y avoir plusieurs RDV sur la case
// => On imprime tous les tickets possibles !!!


// Les infos de la case sont ds la structure w_agenda.param_rdv

// Curseur sur les RDV qui pourraient correspondre

// Variable locales de recherche
integer v_fauteuil
string v_prat1,v_prat2
datetime v_date_debut, v_date_fin

// Rdv trouvés
double v_pat, patient_trouve[]
datetime v_rdv, rdv_trouve[]
integer cpt_trouve, i


w_agenda w_agenda_ouvert

if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
	// Agenda à part
	w_agenda_ouvert = w_agenda_a_part
else
	w_agenda_ouvert = w_agenda
end if



v_fauteuil = w_agenda_ouvert.param_rdv.numero_fauteuil
v_date_debut= w_agenda_ouvert.param_rdv.date_debut
v_date_fin = datetime( date(w_agenda_ouvert.param_rdv.date_fin) , relativetime(time(w_agenda_ouvert.param_rdv.date_fin) , -1))	// pour ne pas mordre sur le rdv suivant
v_prat1 = w_agenda_ouvert.param_rdv.praticien_de
v_prat2 = w_agenda_ouvert.param_rdv.praticien_a


DECLARE Cur_rdv_ticket CURSOR FOR 
SELECT rdv.code , rdv FROM "rdv" , "etat_rdv" 
WHERE "rdv"."code_praticien" between :v_prat1 and :v_prat2 and
"rdv" between :v_date_debut and :v_date_fin and
"fauteuil" = :v_fauteuil and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' ;


// On est obligé de mémorisé dans un tableau car, avec un curseur, soucis du fait de la fonction impression_ticket

cpt_trouve = 0
Open Cur_rdv_ticket ;

FETCH Cur_rdv_ticket INTO :v_pat, :v_rdv ;

DO WHILE sqlca.sqlcode = 0 
	
	cpt_trouve = cpt_trouve + 1
	
	patient_trouve[cpt_trouve] = v_pat
	rdv_trouve[cpt_trouve] = v_rdv
	
	FETCH Cur_rdv_ticket INTO :v_pat, :v_rdv ;
	
LOOP

Close Cur_rdv_ticket ;


for i = 1 to cpt_trouve 

	Impression_ticket_rdv (patient_trouve[i],rdv_trouve[i], w_agenda_ouvert.uo_edition, false)

next

end event

