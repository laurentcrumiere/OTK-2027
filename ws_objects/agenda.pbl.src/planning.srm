event clicked;if CodePatientCourant < 0 then 
	if Doctolib then
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous Doctolib pour un patient non validé par Orthokis !")
	else
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous pris en ligne pour un patient non validé par Orthokis !")
	end if
else
	//Declaration des variables locales
	//--------------------------
	double temp_code_patient
	datetime temp_rdv_date, temp_rdv_date2
	integer v_duree
	boolean ok_suite
	integer v_fauteuil_pris
	boolean ok_coller = false
	
	integer i_cpt, i_fauteuil
	double db_code_interne_lu
	string s_type, s_code_praticien
	
	w_agenda w_agenda_ouvert
	
	if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
		// Agenda à part
		w_agenda_ouvert = w_agenda_a_part
	else
		w_agenda_ouvert = w_agenda
	end if
	
	// On fait les vérification pour tous les rdv du tableau db_codes_internes_fratrie
	ok_suite = true
	
	for i_cpt = 1 to w_agenda_ouvert.i_nb_rdv_a_reporter
		
//		select code , "type", duree, code_praticien 
//		into :temp_code_patient, :s_type, :v_duree, :s_code_praticien 
//		from rdv where round(code_interne,0) = round(:w_agenda_ouvert.db_codes_internes_fratrie[i_cpt],0) ;

		select code , "type", duree, code_praticien 
		into :temp_code_patient, :s_type, :v_duree, :s_code_praticien 
		from rdv where ceiling(code_interne) = ceiling(:w_agenda_ouvert.db_codes_internes_fratrie[i_cpt]) ;

		// Vérifications
		// Vérifications par rapport aux blocages de fauteuil
		if verif_blocages(1, temp_code_patient, w_agenda_ouvert.param_rdv.date_debut, v_duree, s_code_praticien, w_agenda_ouvert.param_rdv.numero_fauteuil,  s_type) > 0 then
//			Messagebox("ATTENTION","Vous ne pouvez pas mettre ce rendez-vous sur ce fauteuil car il est bloqué par un autre rendez-vous !") 
//			ok_suite = false
			string v_autor_forcage_blocage_rdv
			// Est ce que l'utilisateur a le droit de forcer ?
			select isnull(autor_forcage_blocage_rdv, 'N') into :v_autor_forcage_blocage_rdv 
			from utilisateurs 
			where code = :utilisateur_code ;
			
			if v_autor_forcage_blocage_rdv = "N" then 
				Messagebox("ATTENTION","Vous ne pouvez pas saisir ce rendez-vous sur ce fauteuil car il est bloqué par un autre rendez-vous !") 
				ok_suite = false
			else
				if Messagebox("ATTENTION","Le fauteuil choisi pour ce rendez-vous est bloqué par un autre rendez-vous !~n~nSouhaitez-vous forcer ce blocage ?", Question!, YesNo!, 2)  = 1 then
					ok_suite = true
				else
					ok_suite = false
				end if

			end if



		end if
		
		// Vérifications du créneau en fonction du type de rendez-vous
		if ok_suite then 
			if not verif_creneau_interdiction(s_type , w_agenda_ouvert.param_rdv.date_debut, v_duree) then
				// Le message d'erreur est dans la fonction
				ok_suite = false
			end if
		end if
		
		
		if ok_suite then 
			// Vérifications par rapport aux blocages de fauteuil
			v_fauteuil_pris = verif_blocages(2, temp_code_patient, w_agenda_ouvert.param_rdv.date_debut, v_duree, s_code_praticien, w_agenda_ouvert.param_rdv.numero_fauteuil, s_type)
			if v_fauteuil_pris > 1 then
				Messagebox("ATTENTION","Ce type de rendez-vous nécessite le blocage de fauteuil(s).~n~nOr le fauteuil N°"+string(v_fauteuil_pris) + " est déjà pris !") 
				ok_suite = false
			end if
		end if
	

	next
	
	
	
	
	
	if ok_suite then
	
		// Calcul de l'écart du 1er rdv et on reportre ça sur les autres ..
		double db_ecart_jour, db_ecart_secondes
		
//		select  rdv
//		into :temp_rdv_date 
//		from rdv where round(code_interne,0) = :w_agenda_ouvert.db_codes_internes_fratrie[1] ;
//		
		
		select  rdv
		into :temp_rdv_date 
		from rdv where ceiling(code_interne) = ceiling(:w_agenda_ouvert.db_codes_internes_fratrie[1]) ;
		
		
		db_ecart_jour = daysAfter(date(temp_rdv_date), date(w_agenda_ouvert.param_rdv.date_debut))
		db_ecart_secondes = SecondsAfter(time(temp_rdv_date), time(w_agenda_ouvert.param_rdv.date_debut))
			
		// c'est un copier ou un couper ?
		if w_agenda_ouvert.couper then
			
			// C'est un COUPER
		
			//Met a jour le rdv avec les infos sauvegarde et la nouvelle date et fauteuil selectionne 
			//-------------------------------------------------------------------
		//		UPDATE rdv	SET rdv."rdv" = :w_agenda_ouvert.param_rdv.date_debut, rdv.fauteuil = :w_agenda_ouvert.param_rdv.numero_fauteuil, date_modif = getdate() , user_modif = :utilisateur_code 
		//							WHERE code_interne = :w_agenda_ouvert.code_interne_rdv_couper ;

			// Mise à jours des rendez-vous ... 
			
			for i_cpt = 1 to w_agenda_ouvert.i_nb_rdv_a_reporter
				select  rdv, "type"
				into :temp_rdv_date , :s_type
				from rdv where ceiling(code_interne) = :w_agenda_ouvert.db_codes_internes_fratrie[i_cpt] ;
				
				// Nouvelle date / heure du rdv 
				temp_rdv_date2 = datetime(relativedate(date(temp_rdv_date),db_ecart_jour ) , relativetime(time(temp_rdv_date),db_ecart_secondes ))
				
				//UPDATE rdv	SET rdv."rdv" = :temp_rdv_date2, rdv.fauteuil = :w_agenda_ouvert.param_rdv.numero_fauteuil, date_modif = getdate()  , user_modif = :utilisateur_code 
				//				WHERE round(code_interne,0) = :w_agenda_ouvert.db_codes_internes_fratrie[i_cpt] ;
	
				UPDATE rdv	SET rdv."rdv" = :temp_rdv_date2, rdv.fauteuil = :w_agenda_ouvert.param_rdv.numero_fauteuil, date_modif = getdate()  , user_modif = :utilisateur_code 
								WHERE ceiling(code_interne) = ceiling(:w_agenda_ouvert.db_codes_internes_fratrie[i_cpt]) ;

			
				if sqlca.sqlcode <> 0 then
					Messagebox("Erreur dans le déplacement du Rendez-vous du " + string(temp_rdv_date, "dd/mm/yyyy à hh:mm" ),"Erreur N°"+string(sqlca.sqlcode)+"~n~n"+sqlca.sqlerrtext)
					rollback ;
				else
					commit ;
					
					if TEA then 
						fxg_lancer_commande_dsapi("appointment/update/" + string(w_agenda_ouvert.db_codes_internes_fratrie[i_cpt]), "", "R", "G", temp_code_patient  )
						fxg_verif_envoi_questionnaire_tea(temp_code_patient, temp_rdv_date2, s_code_praticien, s_type)
					end if
				
					ok_coller = true
					// Mémo du déplacement 
					ajout_histo_actions(temp_code_patient,"MODRDV",today(),"Couper/Coller Agenda - Rendez-vous du "+string(temp_rdv_date, "dd/mm/yyyy à hh:mm" ) + " vers " + string(temp_rdv_date2, "dd/mm/yyyy à hh:mm" ))
				end if
		
			next
			
		else
								
			//Insertion du rdv copier 
			//-------------------------------------------------------------------
			
			// recherche du type du rdv sélectionnée
			string v_etat, v_commentaire
			double v_code_interne

			
			// Réinitialisation de l'état
			select min(code) into :v_etat from etat_rdv where ordre_trie = ( select min(ordre_trie) from etat_rdv ) ;

			
			for i_cpt = 1 to w_agenda_ouvert.i_nb_rdv_a_reporter
				
				select code , "type", duree, code_praticien , commentaire, rdv 
				into :temp_code_patient, :s_type, :v_duree, :s_code_praticien , :v_commentaire, :temp_rdv_date
				from rdv where round(code_interne,0) = :w_agenda_ouvert.db_codes_internes_fratrie[i_cpt] ;
				
				// Nouvelle date / heure du rdv 
				temp_rdv_date2 = datetime(relativedate(date(temp_rdv_date),db_ecart_jour ) , relativetime(time(temp_rdv_date),db_ecart_secondes ))
				
	
				v_code_interne = code_interne_rdv()
				INSERT INTO RDV ("code", "rdv", "type", "code_praticien", "duree", "fauteuil", "absent", "arrivee", "date_modif", "user_modif", "code_interne", "commentaire")
				values (:temp_code_patient, :temp_rdv_date2, :s_type, :s_code_praticien,  
				:v_duree, :w_agenda_ouvert.param_rdv.numero_fauteuil, :v_etat, null, getdate(), :utilisateur_code, :v_code_interne, :v_commentaire) ;
			
				if sqlca.sqlcode <> 0 then
					Messagebox("Erreur dans l'ajout du Rendez-vous du "+string(temp_rdv_date2, "dd/mm/yyyy à hh:mm" ) , " Erreur N°"+string(sqlca.sqlcode)+"~n~n"+sqlca.sqlerrtext)
					rollback ;
				else
					commit ;
				
					ok_coller = true
					
					if TEA then 
						fxg_lancer_commande_dsapi("appointment/create/" + string(v_code_interne), "", "R", "G" , temp_code_patient )
						fxg_verif_envoi_questionnaire_tea(temp_code_patient, temp_rdv_date2, s_code_praticien, s_type)
					end if
					
					// Ajout du blocage ...
					
					insert into rdv_blocages ("code_interne_rdv", "fauteuil") 
					select :v_code_interne , "fauteuil" from rdv_blocages where code_interne_rdv = :w_agenda_ouvert.db_codes_internes_fratrie[i_cpt] ;
					
					if sqlca.sqlcode <> 0 then
							Messagebox("Erreur dans l'ajout des blocages pour le Rendez-vous du "+string(temp_rdv_date2, "dd/mm/yyyy à hh:mm" ),"Erreur N°"+string(sqlca.sqlcode)+"~n~n"+sqlca.sqlerrtext)
							rollback ;
					else
						commit ;
					end if
		
					// Mémo du déplacement 
					ajout_histo_actions(temp_code_patient,"AJORDV",today(),"Copier/Coller Agenda - Rendez-vous du "+string(temp_rdv_date2, "dd/mm/yyyy à hh:mm" ))
			
		
				end if
		
				if ok_coller then
					string v_email_ticket_auto
					// Envoi d'un email automatique ...
					select isnull(min(email_ticket_auto), 'N') into :v_email_ticket_auto from param ;
				
					if v_email_ticket_auto = "O" then 
						w_mdi_2020.dw_lettre_ticket_rdv.settransobject(sqlca)
						w_mdi_2020.dw_lettre_ticket_rdv.retrieve(temp_code_patient,temp_rdv_date2 )
						if w_mdi_2020.dw_lettre_ticket_rdv.rowcount() > 0 then 
							// La dw passée en paramètre ne sert à rien .. uniquement pour format de la fonction
							fxg_envoi_email_libre(temp_code_patient, w_mdi_2020.dw_lettre_ticket_rdv, 2)
						end if
					end if
				end if
			
			next
		end if
		//Bloque l'affichage
		//----------------------
		w_agenda_ouvert.tab.object.redraw=FALSE
		
		//Rafraichit les RDV
		//---------------
		w_agenda_ouvert.Actualiser()
		
		//Recherche de la pause dejeuner et affiche des heures dans la colonne fixe
		// Utile surout pour matérialiser les heures fixes si besoin
		//-----------------------------------------------------------
		w_agenda_ouvert.recherche_pause_dejeuner(w_agenda_ouvert.pause_debut,w_agenda_ouvert.pause_fin,w_agenda_ouvert.nombre_intervalle)
		
		
		//Autorise l'affichage
		//----------------
		w_agenda_ouvert.tab.object.redraw=TRUE

	end if
		
		
	//Enlve les flag
	//----------
	w_agenda_ouvert.couper=False
	w_agenda_ouvert.copier=False

end if

end event

