type m_imagerie from menu within planning
end type

event clicked;if CodePatientCourant < 0 then 
	if Doctolib then
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous Doctolib pour un patient non validé par Orthokis !")
	else
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous pris en ligne pour un patient non validé par Orthokis !")
	end if
else
	//Mise à jour des patients en mémoire
	MajTabPatientsCourants(CodePatientCourant)
	
	
	
	if imagerie_2013 then
		// L'imagerie 2013 peut être en 1 fenetre 1 patient ... Pas l'ancienne
		if profilestring(dir_ini+inifile_orthokis,"explorateur_photos_2013","a_part","N") = "O" then
			// ouverture A part !
			setnull(fenetre_mere_imagerie_a_part)
			ouvrir_imagerie_2013_a_part ( var_code )
		else
			m_orthokis_2020.ouvrir_mdi(12)
		end if
	end if
end if

end event

