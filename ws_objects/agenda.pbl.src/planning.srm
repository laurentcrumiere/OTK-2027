event clicked;open(w_patience)

w_agenda w_agenda_ouvert

if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
	// Agenda à part
	w_agenda_ouvert = w_agenda_a_part
else
	w_agenda_ouvert = w_agenda
end if


// Calcul du jour du debut de la semaine et de la fin de la semaine
//--------------------------------------------------------------------------

datetime date_min, date_max
string prat1,prat2

// Lundi
date date_cal
time time_cal
w_agenda_ouvert.cal.getvalue(date_cal, time_cal)

date_min = datetime( relativedate(date_cal,2 - daynumber(date_cal)), time("00:00"))

// Dimanche
date_max = datetime(relativedate(date(date_min),6)	, time("23:59"))


// Praticiens
if left(w_agenda_ouvert.tous,1)<> 'O' then
		prat1=w_agenda_ouvert.dw_praticien.gettext()
		prat2 = prat1 
	else
		prat1 = '      '
		prat2 = 'ZZZZZZ'
	end if


// Appel de la Dw
w_agenda_ouvert.dw_synthese.retrieve(date_min, date_max,prat1,prat2, 0, 99)

w_agenda_ouvert.tab.visible = false
w_agenda_ouvert.dw_synthese.visible = true

close(w_patience)
end event

type m_synthèsepartypemois from menu within planning
end type

event clicked;open(w_patience)

w_agenda w_agenda_ouvert

if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
	// Agenda à part
	w_agenda_ouvert = w_agenda_a_part
else
	w_agenda_ouvert = w_agenda
end if


// Calcul du jour du debut du mois et de la fin du mois
//--------------------------------------------------------------------------

datetime date_min, date_max

string prat1,prat2

date date_base

time time_cal
w_agenda_ouvert.cal.getvalue(date_base, time_cal)
//date_base = date(w_agenda_ouvert.cal.value)


// debut du mois
date_min = datetime( date(string(year(date_base))+"/"+string(month(date_base))+"/01"),  time("00:00"))

relativedate(date(w_agenda_ouvert.cal.value),2 - daynumber(date(w_agenda_ouvert.cal.value)))
	
// fin du mois
//date_temp = relativedate(date(date_min),32)
//date_temp = date(string(year(date_temp))+"/"+string(month(date_temp))+"/01")
//date_temp = relativedate(date_temp, -1 )

date_max = datetime ( fin_mois(date(date_min)) , time("23:59"))

// Praticiens
if left(w_agenda_ouvert.tous,1)<> 'O' then
		prat1=w_agenda_ouvert.dw_praticien.gettext()
		prat2 = prat1 
	else
		prat1 = '      '
		prat2 = 'ZZZZZZ'
	end if


// Appel de la Dw
w_agenda_ouvert.dw_synthese.retrieve(date_min, date_max,prat1,prat2, 0, 99)

w_agenda_ouvert.tab.visible = false
w_agenda_ouvert.dw_synthese.visible = true

close(w_patience)
end event

