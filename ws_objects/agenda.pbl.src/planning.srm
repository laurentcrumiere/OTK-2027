event clicked;long lig, tot
long ecart_jours, ecart_secondes, ecart_fauteuils

datetime v_date_debut, v_date_fin
datetime v_date_debut_initiale, v_date_fin_initiale
integer 	v_fauteuil_debut, v_fauteuil_fin
integer 	v_fauteuil_debut_initial, v_fauteuil_fin_initial

string 	v_code_praticien, v_commentaire
double v_couleur 

// Recherche dans la table des jours interdits ... 
//--------------------------------------------------------
w_agenda w_agenda_ouvert

if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
	// Agenda à part
	w_agenda_ouvert = w_agenda_a_part
else
	w_agenda_ouvert = w_agenda
end if

// datastore sur les périodes concernées (possiblement superposées)
datastore dw_interdit 

dw_interdit = CREATE DataStore
dw_interdit.DataObject = "dw_jours_interdits_suppresion_agenda"
dw_interdit.SetTransObject(SQLCA)

dw_interdit.retrieve(w_agenda_ouvert.date_interdit_copier, w_agenda_ouvert.fauteuil_interdit_copier, w_agenda_ouvert.code_praticien_interdit_de_copier, w_agenda_ouvert.code_praticien_interdit_a_copier)

tot = dw_interdit.rowcount()

if tot > 0 then 
		
	for lig = 1 to tot
		ecart_jours = daysafter( date( w_agenda_ouvert.date_interdit_copier ) , date(w_agenda_ouvert.param_rdv.date_debut) )
		ecart_secondes = SecondsAfter(Time(w_agenda_ouvert.date_interdit_copier) , Time(w_agenda_ouvert.param_rdv.date_debut))
		ecart_fauteuils = w_agenda_ouvert.param_rdv.numero_fauteuil - w_agenda_ouvert.fauteuil_interdit_copier
		
		// champs à décaler
		v_date_debut = datetime ( RelativeDate( date(dw_interdit.getitemdatetime(lig, "date_debut")) , ecart_jours) , RelativeTime ( time(dw_interdit.getitemdatetime(lig, "date_debut")), ecart_secondes )   )
		v_date_fin = datetime ( RelativeDate( date(dw_interdit.getitemdatetime(lig, "date_fin")) , ecart_jours) , RelativeTime ( time(dw_interdit.getitemdatetime(lig, "date_fin")), ecart_secondes )   )
		v_fauteuil_debut = max(dw_interdit.getitemNumber(lig, "fauteuil_debut") + ecart_fauteuils, 0) 	// pas de fauteuil négatif
		v_fauteuil_fin = min(dw_interdit.getitemNumber(lig, "fauteuil_fin") + ecart_fauteuils , 99) // pas de fauteuil supérieur à 100
			
		if w_agenda_ouvert.copier_interdit then 
			// on duplique les périodes	
			
			// champs qui ne changent pas ...
			v_code_praticien = dw_interdit.getitemString(lig, "code_praticien")
			v_commentaire = dw_interdit.getitemString(lig, "jours_interdits_commentaire")
			v_couleur = dw_interdit.getitemNumber(lig, "couleur")
			
			
			insert into jours_interdits (date_debut, date_fin, fauteuil_debut, fauteuil_fin, code_praticien, commentaire, user_modif, date_modif, couleur)
			values(:v_date_debut, :v_date_fin, :v_fauteuil_debut, :v_fauteuil_fin, :v_code_praticien, :v_commentaire, :utilisateur_code, getdate(*), :v_couleur ) ;
			
			if sqlca.sqlcode = 0 then 
				commit ;
			else
				Messagebox("ATTENTION", "Erreur dans la copie de la nouvelle période du " + string(v_date_debut, "dd/mm/yyyy à hh:mm") + " au " + string(v_date_fin, "dd/mm/yyyy à hh:mm") + "~n~n" + sqlca.sqlerrtext)
				rollback ;
			end if
		
		
		else
			// on met à jour les périodes
			
			v_date_debut_initiale = dw_interdit.getitemdatetime(lig, "date_debut")
			v_date_fin_initiale = dw_interdit.getitemdatetime(lig, "date_fin")
			v_fauteuil_debut_initial = dw_interdit.getitemNumber(lig, "fauteuil_debut")
			v_fauteuil_fin_initial = dw_interdit.getitemNumber(lig, "fauteuil_fin")

			v_code_praticien = dw_interdit.getitemString(lig, "code_praticien")

			update jours_interdits 
			set date_debut = :v_date_debut, date_fin = :v_date_fin, fauteuil_debut = :v_fauteuil_debut, fauteuil_fin = :v_fauteuil_fin, user_modif = :utilisateur_code, date_modif = getdate(*)
			where date_debut = :v_date_debut_initiale and date_fin = :v_date_fin_initiale and fauteuil_debut = :v_fauteuil_debut_initial 
			and fauteuil_fin = :v_fauteuil_fin_initial and code_praticien = :v_code_praticien ;
			
			if sqlca.sqlcode = 0 then 
				commit ;
			else
				Messagebox("ATTENTION", "Erreur dans la mise à jour de la période du " + string(v_date_debut_initiale, "dd/mm/yyyy à hh:mm") + " au " + string(v_date_fin_initiale, "dd/mm/yyyy à hh:mm") + "~n~n" + sqlca.sqlerrtext)
				rollback ;
			end if
		
		
		end if		
			
	next
		

	
	//Rafraichit les RDV
	//---------------
	w_agenda_ouvert.Actualiser()
	
	//Recherche de la pause dejeuner et affiche des heures dans la colonne fixe
	// Utile surout pour matérialiser les heures fixes si besoin
	//-----------------------------------------------------------
	w_agenda_ouvert.recherche_pause_dejeuner(w_agenda_ouvert.pause_debut,w_agenda_ouvert.pause_fin,w_agenda_ouvert.nombre_intervalle)
	
	
	//Autorise l'affichage
	//----------------
	w_agenda_ouvert.tab.object.redraw=TRUE
	
	
else
	Messagebox("ATTENTION !", "Impossible de récupérer la/les période(s) interdite(s) !~n~nOpération annulée")		
	
end if

w_agenda_ouvert.copier_interdit = false
w_agenda_ouvert.couper_interdit = false


end event

