event clicked;if CodePatientCourant < 0 then 
	if Doctolib then
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous Doctolib pour un patient non validé par Orthokis !")
	else
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous pris en ligne pour un patient non validé par Orthokis !")
	end if
else
	//Sauvegarde les champs de la clef primaire du rdv
	//---------------------------------------
	
	w_agenda w_agenda_ouvert
	
	if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
		// Agenda à part
		w_agenda_ouvert = w_agenda_a_part
	else
		w_agenda_ouvert = w_agenda
	end if
	
	
	w_agenda_ouvert.code_patient_couper	=	w_agenda_ouvert.code_patient_agenda
	w_agenda_ouvert.rdv_couper				=	w_agenda_ouvert.date_rdv_agenda
	w_agenda_ouvert.type_couper				=	w_agenda_ouvert.type_rdv_agenda
	w_agenda_ouvert.code_praticien_couper	=	w_agenda_ouvert.code_praticien_agenda
	w_agenda_ouvert.couper						=	false
	w_agenda_ouvert.copier						=	true
	
	w_agenda_ouvert.code_interne_rdv_couper = verif_code_interne_rdv(w_agenda_ouvert.code_interne_agenda , w_agenda_ouvert)
	
	// Y a t il pluisuers rdv qui se suivent pour la fratrie ?
	double db_codes_internes_fratrie[]
	integer i_nb_rdv_a_reporter
	
	i_nb_rdv_a_reporter = nombre_rdv_meme_famille_a_la_suite(   double(w_agenda.code_patient_couper),  datetime(w_agenda.rdv_couper) , w_agenda.code_interne_rdv_couper, db_codes_internes_fratrie, integer(w_agenda_ouvert.numero_fauteuil_agenda))
	
	
	if  i_nb_rdv_a_reporter > 1 then
		
		if Messagebox("ATTENTION", string(i_nb_rdv_a_reporter) + " rendez-vous à la suite concernent la même famille.~n~nSouhaitez vous tous les copier ?", Question!, YesNo!, 1) = 2 then
			// On ne garde que le 1er
			i_nb_rdv_a_reporter = 1
		end if
	end if
	w_agenda_ouvert.i_nb_rdv_a_reporter = i_nb_rdv_a_reporter
	w_agenda_ouvert.db_codes_internes_fratrie = db_codes_internes_fratrie	
end if
end event

