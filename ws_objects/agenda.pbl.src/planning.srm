event clicked;if CodePatientCourant < 0 then 
	if Doctolib then
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous Doctolib pour un patient non validé par Orthokis !")
	else
		MessageBox("ATTENTION", "Fonction non autorisée !~n~nRendez-vous pris en ligne pour un patient non validé par Orthokis !")
	end if
else
	//Ouverture de la fentre de detail du rendez-vous
	//--------------------------------------------------------
	
	w_agenda w_agende_ouvert
	
	if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
		// Agenda à part
		w_agende_ouvert = w_agenda_a_part
	else
		w_agende_ouvert = w_agenda
	end if
	
	
	
	openwithparm(w_detail_rdv,w_agende_ouvert.param_rdv)
	
	//Bloque l'affichage
	//--------------
	w_agende_ouvert.tab.object.redraw=FALSE
	
	//Rafraichit les RDV
	//---------------
	w_agende_ouvert.Actualiser()
	
	//Recherche de la pause dejeuner et affiche des heures dans la colonne fixe
	// Utile surout pour matérialiser les heures fixes si besoin
	//-----------------------------------------------------------
	w_agende_ouvert.recherche_pause_dejeuner(w_agende_ouvert.pause_debut,w_agende_ouvert.pause_fin,w_agende_ouvert.nombre_intervalle)
	
	
	//Autorise l'affichage
	//----------------
	w_agende_ouvert.tab.object.redraw=TRUE

end if
end event

