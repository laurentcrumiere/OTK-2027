$PBExportHeader$m_interdit.srm
forward
global type m_interdit from menu
end type
type m_modificationduninterdit from menu within m_interdit
end type
type m_copierlinterdit from menu within m_interdit
end type
type m_couperlinterdit from menu within m_interdit
end type
global type m_interdit from menu
m_modificationduninterdit m_modificationduninterdit
m_copierlinterdit m_copierlinterdit
m_couperlinterdit m_couperlinterdit
end type
end forward

global type m_interdit from menu
m_modificationduninterdit m_modificationduninterdit
m_copierlinterdit m_copierlinterdit
m_couperlinterdit m_couperlinterdit
end type
global m_interdit m_interdit

on m_interdit.create
m_interdit=this
call super::create
this.text = "m_interdit"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_modificationduninterdit=create m_modificationduninterdit
this.m_copierlinterdit=create m_copierlinterdit
this.m_couperlinterdit=create m_couperlinterdit
this.Item[UpperBound(this.Item)+1]=this.m_modificationduninterdit
this.Item[UpperBound(this.Item)+1]=this.m_copierlinterdit
this.Item[UpperBound(this.Item)+1]=this.m_couperlinterdit
end on

on m_interdit.destroy
call super::destroy
destroy(this.m_modificationduninterdit)
destroy(this.m_copierlinterdit)
destroy(this.m_couperlinterdit)
end on

type m_modificationduninterdit from menu within m_interdit
end type

on m_modificationduninterdit.create
call super::create
this.text = "Modifier l~'Interdit"
this.menuimage = "lc_modifier_interdit.png"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_modificationduninterdit.destroy
call super::destroy
end on

event clicked;

// Recherche dans la table des jours interdits ... 
//--------------------------------------------------------
w_agenda w_agenda_ouvert

if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
	// Agenda à part
	w_agenda_ouvert = w_agenda_a_part
else
	w_agenda_ouvert = w_agenda
end if

openwithparm(w_jours_interdits_suppression_agenda,w_agenda_ouvert.param_rdv)

//Bloque l'affichage
//--------------
w_agenda_ouvert.tab.object.redraw=FALSE

//Rafraichit les RDV
//---------------
w_agenda_ouvert.Actualiser()

//Recherche de la pause dejeuner et affiche des heures dans la colonne fixe
// Utile surout pour matérialiser les heures fixes si besoin
//-----------------------------------------------------------
w_agenda_ouvert.recherche_pause_dejeuner(w_agenda_ouvert.pause_debut,w_agenda_ouvert.pause_fin,w_agenda_ouvert.nombre_intervalle)


//Autorise l'affichage
//----------------
w_agenda_ouvert.tab.object.redraw=TRUE

end event

type m_copierlinterdit from menu within m_interdit
end type

on m_copierlinterdit.create
call super::create
this.text = "Copier l~'Interdit"
this.menuimage = "lc_Copy.png"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
