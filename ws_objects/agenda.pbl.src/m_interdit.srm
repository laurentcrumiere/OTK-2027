on m_copierlinterdit.destroy
call super::destroy
end on

event clicked;// Recherche dans la table des jours interdits ... 
//--------------------------------------------------------
w_agenda w_agenda_ouvert

if profilestring(dir_ini+inifile_orthokis,"agenda","ouverture_fenetre_a_part","N") = "O" then
	// Agenda à part
	w_agenda_ouvert = w_agenda_a_part
else
	w_agenda_ouvert = w_agenda
end if

// recherche de la période interdite la plus proche en terme d'horaire et de fauteuil pour prendre l'heure et le fauteuil de début
datetime v_debut_recherche
integer v_fauteuil_cherche

select isnull(max(date_debut), :w_agenda_ouvert.param_rdv.date_debut)  into :v_debut_recherche from jours_interdits 
where date_debut < :w_agenda_ouvert.param_rdv.date_debut and code_praticien between :w_agenda_ouvert.param_rdv.praticien_de and :w_agenda_ouvert.param_rdv.praticien_a ;

// recherche du premier fauteuil ...
select isnull(min(fauteuil_debut), :w_agenda_ouvert.param_rdv.numero_fauteuil)  into :v_fauteuil_cherche from jours_interdits 
where date_debut = :v_debut_recherche and code_praticien between :w_agenda_ouvert.param_rdv.praticien_de and :w_agenda_ouvert.param_rdv.praticien_a ;

w_agenda_ouvert.date_interdit_copier = v_debut_recherche
w_agenda_ouvert.fauteuil_interdit_copier = v_fauteuil_cherche
w_agenda_ouvert.code_praticien_interdit_de_copier = w_agenda_ouvert.param_rdv.praticien_de
w_agenda_ouvert.code_praticien_interdit_a_copier = w_agenda_ouvert.param_rdv.praticien_a
w_agenda_ouvert.copier_interdit = true
w_agenda_ouvert.couper_interdit = false


end event

