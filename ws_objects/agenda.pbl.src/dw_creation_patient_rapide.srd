table(column=(type=number updatewhereclause=yes key=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=date update=yes updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=char(1) update=yes updatewhereclause=yes name=adulte dbname="patient.adulte" dbalias=".adulte" values="Oui	O/Non	N/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sexe dbname="patient.sexe" dbalias=".sexe" values="Masculin	M/Féminin	F/Neutre	N/" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(35) update=yes updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) update=yes updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) update=yes updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" dbalias=".premiere_visite" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" dbalias=".type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" dbalias=".code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_dentiste dbname="patient.code_dentiste" dbalias=".code_dentiste" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(25) update=yes updatewhereclause=yes name=portable dbname="patient.portable" dbalias=".portable" )
 column=(type=date update=yes updatewhereclause=yes name=date_contact dbname="patient.date_contact" dbalias=".date_contact" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=titre_parent1 dbname="patient.titre_parent1" dbalias=".titre_parent1" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_caisse dbname="patient.code_caisse" dbalias=".code_caisse" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=titre_patient dbname="patient.titre_patient" dbalias=".titre_patient" )
 column=(type=char(6) update=yes updatewhereclause=yes name=pays_parent1 dbname="patient.pays_parent1" dbalias=".pays_parent1" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(1) update=yes updatewhereclause=yes name=portable_sms dbname="patient.portable_sms" dbalias=".portable_sms" values="	O/	N/	?" )
 column=(type=char(100) update=yes updatewhereclause=yes name=email_patient dbname="patient.email_patient" dbalias=".email_patient" )
 column=(type=char(100) update=yes updatewhereclause=yes name=email dbname="patient.email" dbalias=".email" )
 column=(type=char(25) update=yes updatewhereclause=yes name=portable_patient dbname="patient.portable_patient" dbalias=".portable_patient" )
 column=(type=char(1) update=yes updatewhereclause=yes name=portable_patient_sms dbname="patient.portable_patient_sms" dbalias=".portable_patient_sms" values="	O/	N/	?" )
 column=(type=number update=yes updatewhereclause=yes name=patient_couleur1 dbname="patient.couleur1" dbalias=".couleur1" )
 column=(type=char(2) update=yes updatewhereclause=yes name=mise_en_evidence dbname="patient.mise_en_evidence" dbalias=".mise_en_evidence" )
 column=(type=char(1) update=yes updatewhereclause=yes name=assure dbname="patient.assure" dbalias=".assure" )
 column=(type=date update=yes updatewhereclause=yes name=date_naissance_assure dbname="patient.date_naissance_assure" dbalias=".date_naissance_assure" )
 column=(type=char(20) update=yes updatewhereclause=yes name=secu_patient dbname="patient.secu_patient" dbalias=".secu_patient" )
 column=(type=char(20) update=yes updatewhereclause=yes name=secu_parent1 dbname="patient.secu_parent1" dbalias=".secu_parent1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.adulte~") COLUMN(NAME=~"patient.sexe~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.code_dentiste~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.date_contact~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"patient.code_caisse~") COLUMN(NAME=~"patient.titre_patient~") COLUMN(NAME=~"patient.pays_parent1~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.portable_sms~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.portable_patient~") COLUMN(NAME=~"patient.portable_patient_sms~") COLUMN(NAME=~"patient.couleur1~") COLUMN(NAME=~"patient.mise_en_evidence~") COLUMN(NAME=~"patient.assure~") COLUMN(NAME=~"patient.date_naissance_assure~") COLUMN(NAME=~"patient.secu_patient~") COLUMN(NAME=~"patient.secu_parent1~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code~" ) ) ARG(NAME = ~"var_code~" TYPE = number) " update="patient" updatewhere=0 updatekeyinplace=yes arguments=(("var_code", number)) )
