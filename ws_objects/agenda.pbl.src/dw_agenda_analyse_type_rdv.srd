table(column=(type=char(6) updatewhereclause=yes name=type_rdv_code dbname="type_rdv.code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" )
 column=(type=long updatewhereclause=yes name=nombre dbname="nombre" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_symbole dbname="type_rdv.symbole" )
 column=(type=decimal(0) updatewhereclause=yes name=duree dbname="duree" )
 column=(type=char(30) updatewhereclause=yes name=prat1_nom dbname="prat1_nom" )
 column=(type=char(50) updatewhereclause=yes name=nom_famille dbname="nom_famille" )
 column=(type=number updatewhereclause=yes name=couleur_famille dbname="couleur_famille" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"agenda~" )  TABLE(NAME=~"etat_rdv~" ) COLUMN(NAME=~"type_rdv.code~") COLUMN(NAME=~"type_rdv.nom~") COMPUTE(NAME=~"count(*) AS nombre~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"type_rdv.symbole~") COMPUTE(NAME=~"Sum(rdv.duree)  AS duree~") COMPUTE(NAME=~"(SELECT nom from prati where code = :prat1 ) as prat1_nom~") COMPUTE(NAME=~"(select top 1 nom as nom_famille from famille_rdv,type_rdv_famille where type_rdv.code = type_rdv_famille.code_type_rdv and type_rdv_famille.code_famille_rdv = famille_rdv.code order by ordre_trie, nom )~") COMPUTE(NAME=~"(select top 1 couleur as couleur_famille from famille_rdv,type_rdv_famille where type_rdv.code = type_rdv_famille.code_type_rdv and type_rdv_famille.code_famille_rdv = famille_rdv.code order by ordre_trie, nom )~")    JOIN (LEFT=~"type_rdv.code~"    OP =~"=~"RIGHT=~"rdv.type~" )    JOIN (LEFT=~"etat_rdv.code~"    OP =~"=~"RIGHT=~"rdv.absent~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"rdv~~~"~"   OP =~"between~"    EXP2 =~":date1 and :date2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat1 and :prat2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"((~~~"rdv~~~".~~~"fauteuil~~~"~"   OP =~"<=~"    EXP2 =~"~~~"agenda~~~".~~~"nombre_fauteuil~~~" ~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"agenda~~~".~~~"urgence~~~"~"   OP =~"=~"    EXP2 =~"'N')~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"(~~~"rdv~~~".~~~"fauteuil~~~"~"   OP =~"<=~"    EXP2 =~"~~~"agenda~~~".~~~"nombre_fauteuil~~~"  + 1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"agenda~~~".~~~"urgence~~~"~"   OP =~"=~"    EXP2 =~"'O'))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"elimine_agenda~~~"~"   OP =~"<>~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"fauteuil~~~"~"   OP =~"between~"    EXP2 =~":faut_min and :faut_max~" )  GROUP(NAME=~"type_rdv.code~") GROUP(NAME=~"type_rdv.nom~") GROUP(NAME=~"type_rdv.symbole~") GROUP(NAME=~"type_rdv.couleur~")) ARG(NAME = ~"date1~" TYPE = datetime)  ARG(NAME = ~"date2~" TYPE = datetime)  ARG(NAME = ~"prat1~" TYPE = string)  ARG(NAME = ~"prat2~" TYPE = string)  ARG(NAME = ~"faut_min~" TYPE = number)  ARG(NAME = ~"faut_max~" TYPE = number) " arguments=(("date1", datetime),("date2", datetime),("prat1", string),("prat2", string),("faut_min", number),("faut_max", number))  sort="nom_famille A type_rdv_nom A " )
