table(column=(type=char(6) updatewhereclause=yes name=type_rdv_code dbname="type_rdv.code" dbalias=".code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" dbalias=".nom" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_symbole dbname="type_rdv.symbole" dbalias=".symbole" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" dbalias=".couleur" )
 column=(type=char(1) updatewhereclause=yes name=dispo dbname="table_vide.v1" dbalias=".v1" )
 column=(type=char(1) updatewhereclause=yes name=type_rdv_nb_rdv_bloquant dbname="type_rdv.nb_rdv_bloquant" dbalias=".nb_rdv_bloquant" )
 column=(type=char(1) updatewhereclause=yes name=type_rdv_nb_rdv_pour_tous dbname="type_rdv.nb_rdv_pour_tous" dbalias=".nb_rdv_pour_tous" )
 column=(type=decimal(0) updatewhereclause=yes name=type_rdv_nb_rdv_maxi dbname="type_rdv.nb_rdv_maxi" dbalias=".nb_rdv_maxi" )
 column=(type=decimal(0) updatewhereclause=yes name=type_rdv_nb_rdv_maxi_jour dbname="type_rdv.nb_rdv_maxi_jour" dbalias=".nb_rdv_maxi_jour" )
 column=(type=decimal(0) updatewhereclause=yes name=type_rdv_nb_rdv_maxi_mensuel dbname="type_rdv.nb_rdv_maxi_mensuel" dbalias=".nb_rdv_maxi_mensuel" )
