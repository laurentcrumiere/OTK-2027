 column=(type=long updatewhereclause=yes name=nb_rdv_mois dbname="nb_rdv_mois" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"table_vide~" )  TABLE(NAME=~"type_rdv~" ) COLUMN(NAME=~"type_rdv.code~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"type_rdv.symbole~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"type_rdv.nb_rdv_bloquant~") COLUMN(NAME=~"type_rdv.nb_rdv_pour_tous~") COLUMN(NAME=~"type_rdv.nb_rdv_maxi~") COLUMN(NAME=~"type_rdv.nb_rdv_maxi_jour~") COLUMN(NAME=~"type_rdv.nb_rdv_maxi_mensuel~") COMPUTE(NAME=~"(select isnull(count(*),0)  from rdv, etat_rdv where cast (rdv.rdv as date)  between :d1 and :d2 and ~~~"rdv~~~".~~~"type~~~" = type_rdv.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' and rdv.code_praticien between :prati1 and :prati2 ) as nb_rdv_semaine~") COMPUTE(NAME=~"(select isnull(count(*),0)  from rdv, etat_rdv where cast (rdv.rdv as date)  between :d1_mois and :d2_mois and ~~~"rdv~~~".~~~"type~~~" = type_rdv.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' and rdv.code_praticien between :prati1 and :prati2 ) as nb_rdv_mois~")WHERE(    EXP1 =~"~~~"type_rdv~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"isnull(~~~"type_rdv~~~".~~~"nb_rdv_maxi~~~",0) + isnull(~~~"type_rdv~~~".~~~"nb_rdv_maxi_mensuel~~~",0) + isnull(~~~"type_rdv~~~".~~~"nb_rdv_maxi_jour~~~",0)~"   OP =~">~"    EXP2 =~"0~" ) ) ORDER(NAME=~"type_rdv.ordre_trie~" ASC=yes ) ARG(NAME = ~"prati1~" TYPE = string)  ARG(NAME = ~"prati2~" TYPE = string)  ARG(NAME = ~"d1~" TYPE = date)  ARG(NAME = ~"d2~" TYPE = date)  ARG(NAME = ~"d1_mois~" TYPE = date)  ARG(NAME = ~"d2_mois~" TYPE = date) " arguments=(("prati1", string),("prati2", string),("d1", date),("d2", date),("d1_mois", date),("d2_mois", date)) )
