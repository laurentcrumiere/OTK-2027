table(column=(type=number updatewhereclause=yes key=yes identity=yes name=patient_code dbname="patient.code" )
 column=(type=date updatewhereclause=yes name=date_com dbname="date_com" )
 column=(type=char(30000) updatewhereclause=yes name=dern_com dbname="dern_com" )
 column=(type=char(30000) updatewhereclause=yes name=dern_prevu dbname="dern_prevu" )
 retrieve="  SELECT ~"patient~".~"code~",   
          (SELECT max(dat) as Date_com FROM coment WHERE coment.code = patient.code ),   
          (SELECT max(com) as Dern_com FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code and dat <= cast(getdate() as date) ) and coment.code = patient.code ),   
          (SELECT max(acte_prevu) as Dern_prevu FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code and dat <= cast(getdate() as date) ) and coment.code = patient.code )  
    FROM ~"patient~"  
   WHERE ~"patient~".~"code~" = :var_code    
" update="patient" updatewhere=0 updatekeyinplace=no arguments=(("var_code", number)) )
