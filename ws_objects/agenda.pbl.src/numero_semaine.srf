$PBExportHeader$numero_semaine.srf
$PBExportComments$Renvoie le n° de semaine pour un jour passé en param
global type numero_semaine from function_object
end type

forward prototypes
global function integer numero_semaine (date date_donnee)
end prototypes

global function integer numero_semaine (date date_donnee);
// Paramètre DA : Date pour laquelle on cherche la semaine

integer sem
string v_d

if SQL_Server then 
	SELECT TOP 1 DATEPART(week, :date_donnee) into :sem from param;
else
	// SQL Anywhere

	// aux US, le dimanche est sur la semaine suivante 
	// => si la date est un dimanche, on prend le n° de la semaine du samedi
	
	if daynumber(date_donnee) = 1 then 
		date_donnee = relativedate(date_donnee , -1)
	end if
	
	v_d = string(date_donnee, 'yyyymmdd')
	
	SELECT DATEPART(Calweekofyear , :v_d) into :sem from param ;

end if

//Renvoi du numero de semaine
//------------------------
return sem



