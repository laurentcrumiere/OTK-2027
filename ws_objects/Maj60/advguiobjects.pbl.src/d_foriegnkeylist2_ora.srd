 retrieve="SELECT '',
       c.owner || '.' || a.table_name,
       a2.owner || '.' || a2.table_name,
       a.column_name,
		  null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
       a2.column_name,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null,
		 null
  FROM all_constraints c
 JOIN all_cons_columns a
         ON a.owner = c.owner
            AND a.constraint_name = c.constraint_name
				AND a.table_name = c.table_name
	JOIN all_cons_columns a2
         ON a2.owner = c.r_owner
            AND a2.constraint_name = c.r_constraint_name
            AND a2.column_name = a.column_name
 WHERE c.constraint_type = 'R' 
   AND c.owner || '.' || a.table_name = :as_table" arguments=(("as_table", string)) )
