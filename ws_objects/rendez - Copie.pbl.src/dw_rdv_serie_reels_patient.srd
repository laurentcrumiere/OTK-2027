table(column=(type=datetime updatewhereclause=yes name=rdv dbname="rdv.rdv" initial="today" )
 column=(type=char(6) updatewhereclause=yes name=type dbname="rdv.type" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="rdv.code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=duree dbname="rdv.duree" )
 column=(type=decimal(0) updatewhereclause=yes name=fauteuil dbname="rdv.fauteuil" )
 column=(type=char(6) updatewhereclause=yes name=absent dbname="rdv.absent" )
 column=(type=time updatewhereclause=yes name=arrivee dbname="rdv.arrivee" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" )
 column=(type=char(30) updatewhereclause=yes name=etat_rdv_nom dbname="etat_rdv.nom" )
 column=(type=char(6) updatewhereclause=yes name=user_modif dbname="rdv.user_modif" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="rdv.date_modif" )
 column=(type=number updatewhereclause=yes name=code_interne dbname="rdv.code_interne" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" )
 column=(type=long updatewhereclause=yes name=nombre dbname="nombre" )
 column=(type=char(1) updatewhereclause=yes name=elimine_agenda dbname="etat_rdv.elimine_agenda" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"etat_rdv~" ) COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"rdv.arrivee~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"etat_rdv.nom~") COLUMN(NAME=~"rdv.user_modif~") COLUMN(NAME=~"rdv.date_modif~") COLUMN(NAME=~"rdv.code_interne~") COLUMN(NAME=~"type_rdv.couleur~") COMPUTE(NAME=~"(select isnull(count(*),0) as nombre from rdv, etat_rdv where rdv.code = :nocode and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda = 'O'  )~") COLUMN(NAME=~"etat_rdv.elimine_agenda~")    JOIN (LEFT=~"type_rdv.code~"    OP =~"=~"RIGHT=~"rdv.type~" )    JOIN (LEFT=~"etat_rdv.code~"    OP =~"=~"RIGHT=~"rdv.absent~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " filter=" elimine_agenda <> 'O'"arguments=(("nocode", number))  sort="rdv A code_praticien A " )
