table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=rdv dbname="rdv.rdv" initial="today" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=type dbname="rdv.type" validationmsg="~"Le type de rendez-vous doit faire partie de la liste déroulante.~"" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=code_praticien dbname="rdv.code_praticien" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=duree dbname="rdv.duree" initial="10" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=fauteuil dbname="rdv.fauteuil" initial="1" validation="real(gettext ())  >= 0" validationmsg="~"Ce nombre doit être supérieur ou égal à zéro~"" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="rdv.code" )
 column=(type=char(6) update=yes updatewhereclause=yes name=absent dbname="rdv.absent" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_prochain_rdv_nb dbname="patient.prochain_rdv_nb" )
 column=(type=char(1) updatewhereclause=yes name=patient_prochain_rdv_tps dbname="patient.prochain_rdv_tps" )
 column=(type=datetime update=yes updatewhereclause=yes name=date_modif dbname="rdv.date_modif" )
 column=(type=time update=yes updatewhereclause=yes name=rdv_arrivee dbname="rdv.arrivee" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="rdv.user_modif" )
 column=(type=char(200) update=yes updatewhereclause=yes name=commentaire dbname="rdv.commentaire" )
 column=(type=number update=yes updatewhereclause=yes name=code_interne dbname="rdv.code_interne" )
 column=(type=char(6) update=yes updatewhereclause=yes name=rdv_user_suivi_clinique dbname="rdv.user_suivi_clinique" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" )
 column=(type=char(50) update=yes updatewhereclause=yes name=rdv_id_origine dbname="rdv.id_origine" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdv~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"rdv.code~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"patient.prochain_rdv_nb~") COLUMN(NAME=~"patient.prochain_rdv_tps~") COLUMN(NAME=~"rdv.date_modif~") COLUMN(NAME=~"rdv.arrivee~") COLUMN(NAME=~"rdv.user_modif~") COLUMN(NAME=~"rdv.commentaire~") COLUMN(NAME=~"rdv.code_interne~") COLUMN(NAME=~"rdv.user_suivi_clinique~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"rdv.id_origine~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"rdv.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"patient.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )WHERE(    EXP1 =~"( ( ~~~"rdv~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"rdv~~~".~~~"rdv~~~"~"   OP =~"=~"    EXP2 =~":var_rdv )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"rdv~~~".~~~"type~~~"~"   OP =~"=~"    EXP2 =~":var_type )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"rdv~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":var_prat )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"rdv~~~".~~~"duree~~~"~"   OP =~"=~"    EXP2 =~":var_duree ) )~" ) ) ARG(NAME = ~"var_code~" TYPE = number)  ARG(NAME = ~"var_rdv~" TYPE = datetime)  ARG(NAME = ~"var_prat~" TYPE = string)  ARG(NAME = ~"var_type~" TYPE = string)  ARG(NAME = ~"var_duree~" TYPE = number) " update="rdv" updatewhere=0 updatekeyinplace=no arguments=(("var_code", number),("var_rdv", datetime),("var_prat", string),("var_type", string),("var_duree", number)) )
