table(column=(type=datetime updatewhereclause=yes name=rdv dbname="rdv.rdv" initial="today" )
 column=(type=char(6) updatewhereclause=yes name=type dbname="rdv.type" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="rdv.code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=duree dbname="rdv.duree" )
 column=(type=decimal(0) updatewhereclause=yes name=fauteuil dbname="rdv.fauteuil" )
 column=(type=char(6) updatewhereclause=yes name=absent dbname="rdv.absent" )
 column=(type=time updatewhereclause=yes name=arrivee dbname="rdv.arrivee" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" )
 column=(type=char(30) updatewhereclause=yes name=etat_rdv_nom dbname="etat_rdv.nom" )
 column=(type=char(6) updatewhereclause=yes name=user_modif dbname="rdv.user_modif" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="rdv.date_modif" )
 column=(type=number updatewhereclause=yes name=code_interne dbname="rdv.code_interne" )
 column=(type=long updatewhereclause=yes name=ecart_semaine dbname="ecart_semaine" )
 column=(type=long updatewhereclause=yes name=nb_sms dbname="nb_sms" )
 column=(type=number updatewhereclause=yes name=code dbname="rdv.code" )
 column=(type=char(81) updatewhereclause=yes name=prati_nom dbname="prati_nom" )
 column=(type=decimal(0) updatewhereclause=yes name=post_it_praticien dbname="post_it_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=post_it_tous dbname="post_it_tous" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"etat_rdv~" ) COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"rdv.arrivee~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"etat_rdv.nom~") COLUMN(NAME=~"rdv.user_modif~") COLUMN(NAME=~"rdv.date_modif~") COLUMN(NAME=~"rdv.code_interne~") COMPUTE(NAME=~"datediff (week , (select top 1 rdv_pas.rdv from rdv as rdv_pas where rdv_pas.code = rdv.code and rdv_pas.rdv < rdv.rdv order by rdv_pas.rdv desc), rdv.rdv) as ecart_semaine~") COMPUTE(NAME=~"(select isnull(count(*),0)  from historique_sms where code_patient = rdv.code and id_message_pocket like '%'+ cast(rdv.code_interne as char) +'%' ) as nb_sms~") COLUMN(NAME=~"rdv.code~") COMPUTE(NAME=~"(select trim(nom) + ' '+  isnull(prenom, '') from prati where rdv.code_praticien = prati.code) as prati_nom~") COMPUTE(NAME=~"(select top 1 isnull(couleur, 0) from rdv_post_it where rdv_post_it .~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date) and rdv_post_it.code_praticien = rdv.code_praticien) as post_it_praticien~") COMPUTE(NAME=~"(select top 1 isnull(couleur, 0) from rdv_post_it where rdv_post_it .~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date) and rdv_post_it.code_praticien = 'TOUS') as post_it_tous~")    JOIN (LEFT=~"type_rdv.code~"    OP =~"=~"RIGHT=~"rdv.type~" )    JOIN (LEFT=~"etat_rdv.code~"    OP =~"=~"RIGHT=~"rdv.absent~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " arguments=(("nocode", number))  sort="rdv A code_praticien A " )
