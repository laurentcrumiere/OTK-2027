 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"semaine_patient~" ) COLUMN(NAME=~"semaine_patient.code_patient~") COLUMN(NAME=~"semaine_patient.debut_rdv~") COLUMN(NAME=~"semaine_patient.fin_rdv~") COLUMN(NAME=~"semaine_patient.jour_semaine~")WHERE(    EXP1 =~"~~~"semaine_patient~~~".~~~"code_patient~~~"~"   OP =~"=~"    EXP2 =~":numero_patient~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"semaine_patient~~~".~~~"jour_semaine~~~"~"   OP =~"=~"    EXP2 =~":numero_jour~" ) ) ARG(NAME = ~"numero_patient~" TYPE = number)  ARG(NAME = ~"numero_jour~" TYPE = number) " update="semaine_patient" updatewhere=1 updatekeyinplace=no arguments=(("numero_patient", number),("numero_jour", number)) )
