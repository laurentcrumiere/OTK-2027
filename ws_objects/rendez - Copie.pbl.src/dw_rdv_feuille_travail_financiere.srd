table(column=(type=char(50) update=yes updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" initial="today" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_duree dbname="rdv.duree" )
 column=(type=char(6) updatewhereclause=yes name=rdv_code_praticien dbname="rdv.code_praticien" )
 column=(type=decimal(2) updatewhereclause=yes name=due dbname="patient.somme_due" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_fauteuil dbname="rdv.fauteuil" )
 column=(type=date updatewhereclause=yes name=date_proc_reglt dbname="patient.date_proc_reglt" )
 column=(type=decimal(2) updatewhereclause=yes name=mont_proc_reglt dbname="patient.mont_proc_reglt" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" )
 column=(type=decimal(0) updatewhereclause=yes name=param_nbr_jours_alerte_rglt dbname="param.nbr_jours_alerte_rglt" )
 column=(type=char(1) updatewhereclause=yes name=agenda_tous dbname="agenda.tous" )
 column=(type=char(2000) updatewhereclause=yes name=texte_prat dbname="texte_prat" )
 column=(type=char(2000) updatewhereclause=yes name=texte_tous dbname="texte_tous" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(1) updatewhereclause=yes name=patient_cmu dbname="patient.cmu" )
 column=(type=number updatewhereclause=yes name=patient_couleur1 dbname="patient.couleur1" )
 column=(type=char(1) updatewhereclause=yes name=patient_adulte dbname="patient.adulte" )
 column=(type=char(1) updatewhereclause=yes name=prati_barre_afficher_code dbname="prati.barre_afficher_code" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_barre_couleur_code dbname="prati.barre_couleur_code" )
 column=(type=char(2) updatewhereclause=yes name=patient_mise_en_evidence dbname="patient.mise_en_evidence" )
 column=(type=char(1) updatewhereclause=yes name=due_tp dbname="due_tp" )
 column=(type=char(1) updatewhereclause=yes name=date_proc_reglt_tp dbname="date_proc_reglt_tp" )
 column=(type=char(1) updatewhereclause=yes name=mont_proc_reglt_tp dbname="mont_proc_reglt_tp" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"agenda~" )  TABLE(NAME=~"etat_rdv~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"type_rdv~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"patient.somme_due~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"patient.date_proc_reglt~") COLUMN(NAME=~"patient.mont_proc_reglt~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"param.nbr_jours_alerte_rglt~") COLUMN(NAME=~"agenda.tous~") COMPUTE(NAME=~"(select ~~~"texte~~~" as texte_prat from rdv_post_it where rdv_post_it.code_praticien = ~~~"rdv~~~".~~~"code_praticien~~~" and ~~~"rdv_post_it~~~".~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date))~") COMPUTE(NAME=~"(select ~~~"texte~~~" as texte_tous from rdv_post_it where rdv_post_it.code_praticien = 'TOUS' and ~~~"rdv_post_it~~~".~~~"date~~~" = cast(~~~"rdv~~~".~~~"rdv~~~" as date))~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.cmu~") COLUMN(NAME=~"patient.couleur1~") COLUMN(NAME=~"patient.adulte~") COLUMN(NAME=~"prati.barre_afficher_code~") COLUMN(NAME=~"prati.barre_couleur_code~") COLUMN(NAME=~"patient.mise_en_evidence~") COMPUTE(NAME=~"(select v1 from table_vide) as due_tp~") COMPUTE(NAME=~"(select v2 from table_vide) as date_proc_reglt_tp~") COMPUTE(NAME=~"(select v2 from table_vide) as mont_proc_reglt_tp~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"type_rdv.nom~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"rdv.code~" )    JOIN (LEFT=~"etat_rdv.code~"    OP =~"=~"RIGHT=~"rdv.absent~" )    JOIN (LEFT=~"rdv.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"rdv.type~"    OP =~"=~"RIGHT=~"type_rdv.code~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"fauteuil~~~"~"   OP =~"between~"    EXP2 =~":f_min and :f_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cast(~~~"rdv~~~".~~~"rdv~~~" as date)~"   OP =~"=~"    EXP2 =~":var_date~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"elimine_agenda~~~"~"   OP =~"=~"    EXP2 =~"'N'~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"var_date~" TYPE = date)  ARG(NAME = ~"f_min~" TYPE = number)  ARG(NAME = ~"f_max~" TYPE = number)  ARG(NAME = ~"souligner_adultes~" TYPE = string) " arguments=(("prat_min", string),("prat_max", string),("var_date", date),("f_min", number),("f_max", number),("souligner_adultes", string))  sort="rdv_rdv A patient_nom A code A rdv_fauteuil A " )
