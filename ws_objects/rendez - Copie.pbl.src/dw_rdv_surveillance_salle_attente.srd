 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prati~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"etat_rdv~" ) COLUMN(NAME=~"prati.code~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"type_rdv.symbole~") COLUMN(NAME=~"rdv.rdv~")    JOIN (LEFT=~"rdv.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"type_rdv.code~"    OP =~"=~"RIGHT=~"rdv.type~" )    JOIN (LEFT=~"rdv.absent~"    OP =~"=~"RIGHT=~"etat_rdv.code~" )WHERE(    EXP1 =~"~~~"prati~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"type_rdv~~~".~~~"surveillance_volet_salle_attente~~~"~"   OP =~"=~"    EXP2 =~"'O'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cast(~~~"rdv~~~".~~~"rdv~~~" as date)~"   OP =~"between~"    EXP2 =~"cast(getdate() as date) and :date_limite~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"elimine_agenda~~~"~"   OP =~"<>~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"date_limite~" TYPE = date) " arguments=(("date_limite", date))  sort="type_rdv_symbole A " )
