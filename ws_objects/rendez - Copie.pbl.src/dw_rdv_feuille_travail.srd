table(column=(type=char(50) update=yes updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=number update=yes updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" initial="today" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_duree dbname="rdv.duree" )
 column=(type=char(6) updatewhereclause=yes name=rdv_code_praticien dbname="rdv.code_praticien" )
 column=(type=decimal(2) updatewhereclause=yes name=due dbname="patient.somme_due" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_fauteuil dbname="rdv.fauteuil" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=patient_remarques dbname="patient.remarques" )
 column=(type=char(10) update=yes updatewhereclause=yes name=patient_moulage dbname="patient.moulage" )
 column=(type=date updatewhereclause=yes name=date_proc_reglt dbname="patient.date_proc_reglt" )
 column=(type=decimal(2) updatewhereclause=yes name=mont_proc_reglt dbname="patient.mont_proc_reglt" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=date updatewhereclause=yes name=cdate_com dbname="date_com" )
 column=(type=char(30000) updatewhereclause=yes name=cdern_com dbname="dern_com" )
 column=(type=date updatewhereclause=yes name=date_soin dbname="date_soin" )
 column=(type=char(30000) updatewhereclause=yes name=dern_prevu dbname="dern_prevu" )
 column=(type=decimal(2) updatewhereclause=yes name=total_soin dbname="total_soin" )
 column=(type=decimal(2) updatewhereclause=yes name=total_paye dbname="total_paye" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" )
 column=(type=char(2000) updatewhereclause=yes name=texte_tous dbname="texte_tous" )
 column=(type=char(2000) updatewhereclause=yes name=texte_prat dbname="texte_prat" )
 column=(type=char(1) updatewhereclause=yes name=agenda_tous dbname="agenda.tous" )
 column=(type=char(200) updatewhereclause=yes name=rdv_commentaire dbname="rdv.commentaire" )
 column=(type=char(1) updatewhereclause=yes name=patient_cmu dbname="patient.cmu" )
 column=(type=number updatewhereclause=yes name=patient_couleur1 dbname="patient.couleur1" )
 column=(type=char(1) updatewhereclause=yes name=patient_adulte dbname="patient.adulte" )
 column=(type=char(2) updatewhereclause=yes name=patient_mise_en_evidence dbname="patient.mise_en_evidence" )
 column=(type=long updatewhereclause=yes name=alertes_passees dbname="alertes_passees" )
 column=(type=long updatewhereclause=yes name=alertes_presque_passees dbname="alertes_presque_passees" )
 retrieve="SELECT ~"patient~".~"nom~",
 ~"patient~".~"code~",
 ~"rdv~".~"rdv~",
 ~"type_rdv~".~"nom~",
 ~"rdv~".~"duree~",
 ~"rdv~".~"code_praticien~",
 ~"patient~".~"somme_due~",
 ~"rdv~".~"fauteuil~",
 ~"patient~".~"remarques~",
 ~"patient~".~"moulage~",
 ~"patient~".~"date_proc_reglt~",
 ~"patient~".~"mont_proc_reglt~",
~"patient~".~"numero_dossier~", 
 (SELECT max(dat) FROM coment WHERE coment.code = patient.code ) as Date_com ,
 (SELECT max(com) FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code and dat <= cast(getdate() as date) ) and coment.code = patient.code )  as Dern_com ,
dba.date_soins_dus_patient(patient.code,:var_date) as date_soin,
 (SELECT max(acte_prevu) FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code and dat <= cast(getdate() as date) ) and coment.code = patient.code ) as Dern_prevu ,
 dba.soins_dus_patient(patient.code,:var_date,'N') as total_soin   ,
 dba.paye_patient( patient.code , 'N') as total_paye , 
 ~"patient~".~"prenom~",
 ~"type_rdv~".~"couleur~",
  (select ~"texte~" from rdv_post_it where rdv_post_it.code_praticien = 'TOUS' and ~"rdv_post_it~".~"date~" = cast(~"rdv~".~"rdv~" as date)) as texte_tous ,
  (select ~"texte~" from rdv_post_it where rdv_post_it.code_praticien = ~"rdv~".~"code_praticien~" and ~"rdv_post_it~".~"date~" = cast(~"rdv~".~"rdv~" as date)) as texte_prat ,
 ~"agenda~".~"tous~",
~"rdv~".~"commentaire~",
~"patient~".~"cmu~"  ,
~"patient~".~"couleur1~" ,
~"patient~".~"adulte~" ,
~"patient~".~"mise_en_evidence~" ,
 (select isnull(count(*),0) from patient_alertes where ~"date~" <= cast(getdate() as date) and realisee <> 'O' and code_patient = patient.code ) as alertes_passees,   
 (select isnull(count(*),0) from patient_alertes,param where ~"date~" <= dateadd(day, delai_alerte_patient, cast(getdate() as date) ) and realisee <> 'O'  and code_patient = patient.code ) as alertes_presque_passees  



FROM ~"patient~", ~"rdv~", ~"type_rdv~", ~"agenda~" , ~"etat_rdv~", ~"param~"
WHERE ( ~"patient~".~"code~" = ~"rdv~".~"code~" ) and ( ~"rdv~".~"absent~" = ~"etat_rdv~".~"code~" ) and 
( ~"rdv~".~"type~" = ~"type_rdv~".~"code~" ) and ~"etat_rdv~".~"elimine_agenda~" = 'N' and 
( ( ~"rdv~".~"code_praticien~" between :prat_min and :prat_max ) AND 
( cast ( ~"rdv~".~"rdv~" as date ) = :var_date ) AND ( ~"rdv~".~"fauteuil~" between :f_min and :f_max ) ) " arguments=(("prat_min", string),("prat_max", string),("var_date", date),("var_date2", date),("f_min", number),("f_max", number),("souligner_adultes", string))  sort="rdv_rdv A patient_nom A code A rdv_fauteuil A " )
