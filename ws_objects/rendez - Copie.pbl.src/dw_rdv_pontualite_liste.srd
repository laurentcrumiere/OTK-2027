table(column=(type=number updatewhereclause=yes name=rdv_code_interne dbname="rdv.code_interne" )
 column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" initial="today" )
 column=(type=datetime updatewhereclause=yes name=pris_en_clinique dbname="pris_en_clinique" )
 column=(type=time updatewhereclause=yes name=rdv_arrivee dbname="rdv.arrivee" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"etat_rdv~" )  TABLE(NAME=~"rdv~" ) COLUMN(NAME=~"rdv.code_interne~") COLUMN(NAME=~"rdv.rdv~") COMPUTE(NAME=~"(select min (date_modif) as pris_en_clinique from historique_etat_rdv , etat_rdv where historique_etat_rdv.etat = etat_rdv.code and etat_rdv.ouverture_automatique = 'O' and rdv.code_interne = historique_etat_rdv.code_interne)~") COLUMN(NAME=~"rdv.arrivee~")    JOIN (LEFT=~"rdv.absent~"    OP =~"=~"RIGHT=~"etat_rdv.code~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":v_code~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"elimine_agenda~~~"~"   OP =~"<>~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"v_code~" TYPE = number) " arguments=(("v_code", number)) )
