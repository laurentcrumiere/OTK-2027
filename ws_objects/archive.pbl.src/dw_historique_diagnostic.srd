 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"historique_traitement~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"historique_traitement.traitement_effectue~") COLUMN(NAME=~"historique_traitement.plan_traitement~") COLUMN(NAME=~"historique_traitement.code~") COLUMN(NAME=~"historique_traitement.basal_max_pro~") COLUMN(NAME=~"historique_traitement.basal_max_retro~") COLUMN(NAME=~"historique_traitement.basal_mand_pro~") COLUMN(NAME=~"historique_traitement.basal_mand_retro~") COLUMN(NAME=~"historique_traitement.basal_max_endo~") COLUMN(NAME=~"historique_traitement.basal_max_exo~") COLUMN(NAME=~"historique_traitement.basal_mand_endo~") COLUMN(NAME=~"historique_traitement.basal_mand_exo~") COLUMN(NAME=~"historique_traitement.hypodivergence~") COLUMN(NAME=~"historique_traitement.hyperdivergence~") COLUMN(NAME=~"historique_traitement.alveo_max_pro~") COLUMN(NAME=~"historique_traitement.alveo_max_retro~") COLUMN(NAME=~"historique_traitement.alveo_mand_pro~") COLUMN(NAME=~"historique_traitement.alveo_mand_retro~") COLUMN(NAME=~"historique_traitement.alveo_max_endo~") COLUMN(NAME=~"historique_traitement.alveo_max_exo~") COLUMN(NAME=~"historique_traitement.alveo_mand_endo~") COLUMN(NAME=~"historique_traitement.alveo_mand_exo~") COLUMN(NAME=~"historique_traitement.supraclusion~") COLUMN(NAME=~"historique_traitement.infraclusion~") COLUMN(NAME=~"historique_traitement.mol_cl1~") COLUMN(NAME=~"historique_traitement.mol_cl2~") COLUMN(NAME=~"historique_traitement.mol_cl3~") COLUMN(NAME=~"historique_traitement.can_cl1~") COLUMN(NAME=~"historique_traitement.can_cl2~") COLUMN(NAME=~"historique_traitement.can_cl3~") COLUMN(NAME=~"historique_traitement.molaire~") COLUMN(NAME=~"historique_traitement.canine~") COLUMN(NAME=~"historique_traitement.dento_max~") COLUMN(NAME=~"historique_traitement.dento_dent~") COLUMN(NAME=~"historique_traitement.date_sauvegarde~") COLUMN(NAME=~"historique_traitement.agenesie~") COLUMN(NAME=~"historique_traitement.surnum~") COLUMN(NAME=~"historique_traitement.malposition~") COLUMN(NAME=~"historique_traitement.occl_dte~") COLUMN(NAME=~"historique_traitement.occl_gche~") COLUMN(NAME=~"historique_traitement.occl_ant~") COLUMN(NAME=~"historique_traitement.facteur~") COLUMN(NAME=~"historique_traitement.commentaire~") COLUMN(NAME=~"historique_traitement.titre~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.code~")    JOIN (LEFT=~"historique_traitement.code~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"historique_traitement~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code~" ) ) ARG(NAME = ~"var_code~" TYPE = number) " arguments=(("var_code", number))  sort="date_sauvegarde A " )
