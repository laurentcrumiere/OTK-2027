event show;


clinique_affichee = true

secondes_attente = 3
timer(1)
end event

event timer;
secondes_attente = secondes_attente - 1

if secondes_attente = 1 then
	copie_ecran_fenetre_clipboard()
end if

if secondes_attente = 0 then
	close(this)
end if
end event

