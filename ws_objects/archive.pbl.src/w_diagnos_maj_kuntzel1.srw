forward prototypes
public subroutine init ()
end prototypes

public subroutine init ();modif = false

sle_radiologue.text = RightTrim(mid(page,1,20))

em_date1.text = RightTrim(mid(page,30,10))
em_date2.text = RightTrim(mid(page,40,10))
em_date3.text = RightTrim(mid(page,50,10))

em_a1.text = RightTrim(mid(page,60,5))
em_a2.text = RightTrim(mid(page,65,5))
