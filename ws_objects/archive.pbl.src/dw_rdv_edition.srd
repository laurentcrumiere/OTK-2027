table(column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" initial="today" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_duree dbname="rdv.duree" )
 column=(type=char(6) updatewhereclause=yes name=rdv_code_praticien dbname="rdv.code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_fauteuil dbname="rdv.fauteuil" )
 column=(type=char(6) updatewhereclause=yes name=rdv_absent dbname="rdv.absent" initial="N" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" )
 column=(type=decimal(0) updatewhereclause=yes name=etat_rdv_couleur dbname="etat_rdv.couleur" )
 column=(type=time updatewhereclause=yes name=rdv_arrivee dbname="rdv.arrivee" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdv~" )  TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"etat_rdv~" ) COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"etat_rdv.couleur~") COLUMN(NAME=~"rdv.arrivee~")    JOIN (LEFT=~"rdv.type~"    OP =~"=~"RIGHT=~"type_rdv.code~" )    JOIN (LEFT=~"rdv.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"rdv.absent~"    OP =~"=~"RIGHT=~"etat_rdv.code~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":pat~" ) ) ARG(NAME = ~"pat~" TYPE = number) " arguments=(("pat", number))  sort="rdv_rdv A " )
