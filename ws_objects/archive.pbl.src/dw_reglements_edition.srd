 column=(type=char(1) updatewhereclause=yes name=paye_origine_tp dbname="paye.origine_tp" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"paye~" ) COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.date_accord~") COLUMN(NAME=~"soins.scp_accord~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"soins.tp~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.cadre_bas_page~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS doit_tp FROM ligne_soins WHERE soins.code = ligne_soins.code and ligne_soins.cle = soins.cle and ligne_soins.~~~"date~~~" <= today(*)  and ligne_soins.tp = 'O')~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS doit FROM ligne_soins WHERE soins.code = ligne_soins.code and ligne_soins.cle = soins.cle and ligne_soins.~~~"date~~~" <= today(*) and ligne_soins.tp <> 'O' )~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS paye FROM paye WHERE soins.code = paye.code and soins.cle = paye.cle and paye.tp <> 'O')~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) AS paye_tp FROM paye WHERE soins.code = paye.code and soins.cle = paye.cle and paye.tp = 'O')~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"param.edition_entete_visible~") COLUMN(NAME=~"param.edition_baspage_visible~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.nom~") COMPUTE(NAME=~"(SELECT min(~~~"ligne_soins~~~".~~~"date~~~") AS date_ligne FROM ligne_soins WHERE ligne_soins.code = soins.code and ligne_soins.cle = soins.cle)~") COLUMN(NAME=~"patient.nom_payeur~") COLUMN(NAME=~"patient.adr1_payeur~") COLUMN(NAME=~"patient.adr2_payeur~") COLUMN(NAME=~"patient.codep_payeur~") COLUMN(NAME=~"patient.ville_payeur~") COLUMN(NAME=~"patient.titre_payeur~") COMPUTE(NAME=~"(SELECT nom as nom_titre_parent1 from titre_personnes where titre_parent1 = titre_personnes .code)~") COMPUTE(NAME=~"(SELECT nom as nom_titre_payeur from titre_personnes where titre_payeur = titre_personnes .code)~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.origine_tp~")    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"paye.code~"    OUTER1 =~"soins.code~" )    JOIN (LEFT=~"soins.cle~"    OP =~"=~"RIGHT=~"paye.cle~"    OUTER1 =~"soins.cle~" )    JOIN (LEFT=~"patient.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )WHERE(    EXP1 =~" ~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_demande~~~"~"   OP =~">=~"    EXP2 =~":datedebut~" ) ) ORDER(NAME=~"soins.date_demande~" ASC=no) ARG(NAME = ~"nocode~" TYPE = number)  ARG(NAME = ~"datedebut~" TYPE = date) " arguments=(("nocode", number),("datedebut", date))  sort="date_demande A date_ligne A cle A code_soins_nom A numero A " )
