table(column=(type=char(30) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=number update=yes updatewhereclause=yes key=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=date updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=char(30) updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.numero_dossier~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat1 and :prat2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"type_dossier~~~"~"   OP =~"between~"    EXP2 =~":typ_dos1 and :typ_dos2~" ) ) ARG(NAME = ~"prat1~" TYPE = string)  ARG(NAME = ~"prat2~" TYPE = string)  ARG(NAME = ~"typ_dos1~" TYPE = string)  ARG(NAME = ~"typ_dos2~" TYPE = string) " update="patient" updatewhere=1 updatekeyinplace=no arguments=(("prat1", string),("prat2", string),("typ_dos1", string),("typ_dos2", string))  sort="code A nom A prenom A " )
