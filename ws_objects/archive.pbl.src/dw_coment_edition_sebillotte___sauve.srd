table(column=(type=date update=yes updatewhereclause=yes name=dat dbname="coment.dat" initial="today" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=com dbname="coment.com" initial="null" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=coul_texte dbname="coment.coul_texte" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=coul_fond dbname="coment.coul_fond" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=code dbname="coment.code" )
 column=(type=number update=yes updatewhereclause=yes name=ordre dbname="coment.ordre" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=acte_prevu dbname="coment.acte_prevu" )
 column=(type=char(100) update=yes updatewhereclause=yes name=hygiene_v10 dbname="coment.hygiene_v10" )
 column=(type=char(100) update=yes updatewhereclause=yes name=elastique_v10 dbname="coment.elastique_v10" )
 column=(type=char(200) update=yes updatewhereclause=yes name=maxillaire dbname="coment.maxillaire" )
 column=(type=char(200) update=yes updatewhereclause=yes name=mandibule dbname="coment.mandibule" )
 column=(type=char(30) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coment~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"coment.dat~") COLUMN(NAME=~"coment.com~") COLUMN(NAME=~"coment.coul_texte~") COLUMN(NAME=~"coment.coul_fond~") COLUMN(NAME=~"coment.code~") COLUMN(NAME=~"coment.ordre~") COLUMN(NAME=~"coment.acte_prevu~") COLUMN(NAME=~"coment.hygiene_v10~") COLUMN(NAME=~"coment.elastique_v10~") COLUMN(NAME=~"coment.maxillaire~") COLUMN(NAME=~"coment.mandibule~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~")    JOIN (LEFT=~"coment.code~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"coment~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ORDER(NAME=~"coment.ordre~" ASC=yes ) ARG(NAME = ~"numero~" TYPE = number) " arguments=(("numero", number))  sort="dat A ordre A " )
