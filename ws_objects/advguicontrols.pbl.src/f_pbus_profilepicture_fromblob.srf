$PBExportHeader$f_pbus_profilepicture_fromblob.srf
global type f_pbus_profilepicture_fromblob from function_object
end type

forward prototypes
global function boolean f_pbus_profilepicture_fromblob (ulong ahdc, long ax, long ay, long awidth, long aheight, string aidentifier, string aprimarykey, integer aframethickness, string aframetype, string atheme)
end prototypes

global function boolean f_pbus_profilepicture_fromblob (ulong ahdc, long ax, long ay, long awidth, long aheight, string aidentifier, string aprimarykey, integer aframethickness, string aframetype, string atheme);CONSTANT String CIRCLE = "CIRCLE"
CONSTANT String SQUARE = "SQUARE"
CONSTANT String ROUNDEDSQUARE = "ROUNDEDSQUARE"

GdiplusStartupInput  istr_input
GdiplusStartupOutput istr_output
LongPtr iul_GdiToken

LongPtr iul_Pen
LongPtr iul_colorRGB

LongPtr iul_hBitmap
LongPtr iul_Path
LongPtr iul_Graphic

LongPtr iul_pImageStream = 0
LongPtr iul_pGlobalBuffer = 0
LongPtr iul_hGlobal = 0

Long ll_circle

Long ll_Length
Constant ULong GMEM_MOVEABLE = 2

n_cst_win32 inv_win32

n_cst_pbus_lic iu_lic
IF NOT iu_lic.of_Registered() AND &
   iu_lic.of_Key() = "38017E06-84A2-4B73-9CE5-87C0BD9A39A8" THEN
	RETURN FALSE
END IF

inv_win32 = CREATE n_cst_win32

//Setup
istr_input.GdiplusVersion = 1
inv_win32.GdiplusStartup(iul_GdiToken, istr_input, istr_output)
inv_win32.GdipCreateFromHDC(ahdc, iul_Graphic)
inv_win32.GdipSetSmoothingMode(iul_Graphic, 5)
inv_win32.GdipSetPageUnit(iul_Graphic, 2)
ll_circle = Min(awidth, aheight) - (aframethickness * 2)

//Load Image

blob bimage
bimage = f_pbus_getbinarydata(aidentifier, aprimarykey)
ll_Length = Len(bimage)

IF ll_length = 0 THEN
	RETURN FALSE
END IF
// Allocate memory to hold the image
iul_hGlobal = inv_win32.GlobalAlloc(GMEM_MOVEABLE, ll_Length)
If iul_hGlobal > 0 Then
	// Lock the memory
	iul_pGlobalBuffer = inv_win32.GlobalLock(iul_hGlobal)
	If iul_pGlobalBuffer > 0 Then
		// Copy the image from the string buffer to global memory
		inv_win32.CopyMemory(iul_pGlobalBuffer, bimage, ll_Length)
		// Create a stream in global memory
		If inv_win32.CreateStreamOnHGlobal(iul_hGlobal, False, iul_pImageStream) = 0 Then
			// Create bitmap from the data contained in the stream
			inv_win32.GdipCreateBitmapFromStreamICM(iul_pImageStream, iul_hBitmap)
		End If
	End If
End If

//Create Pen
int ai_red, ai_green, ai_blue
ULong lul_color, lul_color2

n_uspb_colors lnv_colors
lnv_colors.of_GetColor(aTheme, ai_red, ai_green, ai_blue)

//Get color for circle fill
lul_color = inv_win32.PBUSMakeARGB (255, ai_red, ai_green, ai_blue)

int i
i = inv_win32.GetDeviceCaps(ahdc,2)

IF i = 2 THEN
	inv_win32.GdipCreatePen1(lul_color,aframethickness, 3, iul_Pen)	
ELSE
	inv_win32.GdipCreatePen1(lul_color,aframethickness, 2, iul_Pen)	
END IF

//Create Path
//Calc full path
inv_win32.GdipCreatePath(0, iul_path)

CHOOSE CASE Upper(aframetype)
	CASE SQUARE
		inv_win32.GdipAddPathRectangleI(iul_path, aframethickness + ax,aframethickness + ay,ll_circle - aframethickness - aframethickness, ll_circle - aframethickness - aframethickness)
	CASE ROUNDEDSQUARE
		Rect Corner
		Int CornerRadius = 6
		
		Corner.Left = aframethickness + ax //x
		Corner.Top = aframethickness + ay //y
		Corner.Right = CornerRadius + CornerRadius //radius
		Corner.Bottom =CornerRadius + CornerRadius//radius
		// top left
		inv_win32.GdipAddPathArcI(iul_path, Corner.Left, Corner.Top, Corner.Right,Corner.Bottom, 180, 90);
		// top right
		Corner.Left += (ll_circle - CornerRadius - CornerRadius  - 1);
		inv_win32.GdipAddPathArcI(iul_path, Corner.Left, Corner.Top, Corner.Right,Corner.Bottom,  270, 90);
		
		// bottom right
		Corner.Top += (ll_circle - CornerRadius - CornerRadius - 1);
		inv_win32.GdipAddPathArcI(iul_path, Corner.Left, Corner.Top, Corner.Right,Corner.Bottom, 0, 90);
		
		// bottom left
		Corner.Left -= (ll_circle - CornerRadius - CornerRadius - 1);
		inv_win32.GdipAddPathArcI(iul_path, Corner.Left, Corner.Top, Corner.Right,Corner.Bottom, 90, 90);
		
		inv_win32.GdipClosePathFigure(iul_path)
	CASE ELSE
		
		inv_win32.GdipAddPathArcI(iul_path, aframethickness + ax, aframethickness + ay, ll_circle, ll_circle, -90, 360);
END CHOOSE


//Draw Image
Constant Long UnitPixel = 2
unsignedlong lul_Attribs, lul_path
RECT lstr_Rect
RECTF lstr_gRect
Long ll_Units, ll_x, ll_y, ll_width, ll_height
Double ld_factor, ld_xfactor, ld_yfactor

inv_win32.GdipGetImageBounds(iul_hBitmap, lstr_gRect, ll_Units)
inv_win32.GdipSetInterpolationMode(iul_Graphic, 7)
inv_win32.GdipSetClipPath(iul_Graphic, iul_path, 0)

ll_Width  = lstr_gRect.Width
ll_Height = lstr_gRect.Height

IF ll_width > 0 THEN
	ld_xfactor = ll_circle / ll_width
	ld_yfactor = ll_circle / ll_height
END IF

ld_factor = Max(ld_xfactor, ld_yfactor)

ll_width = ll_width * ld_factor
ll_Height = ll_Height * ld_factor

ll_x = (ll_circle - ll_Width) / 2 + ax + aframethickness
ll_y = (ll_circle - ll_Height) / 2 + ay + aframethickness

SetNull(lul_Attribs)

inv_win32.GdipDrawImageRectRectI(iul_Graphic, iul_hBitmap, &
					ll_x, ll_y, ll_Width, ll_Height, &
					0, 0, lstr_gRect.Width, lstr_gRect.Height, &
					UnitPixel, lul_Attribs, 0, 0)

inv_win32.GdipResetClip(iul_Graphic)

//Draw Path
If aframethickness > 0 Then inv_win32.GdipDrawPath(iul_graphic, iul_Pen, iul_path);

//Clean Up
IF iul_Pen > 0 THEN
	inv_win32.GdipDeletePen(iul_Pen)
END IF

IF iul_hBitmap > 0 THEN
	inv_win32.GdipDisposeImage(iul_hBitmap)
END IF

IF iul_path > 0 THEN
	inv_win32.GdipDeletePath(iul_path)
END IF

IF iul_Graphic > 0 THEN
	inv_win32.GdipDeleteGraphics(iul_Graphic)
END IF

IF iul_pGlobalBuffer > 0 THEN
	inv_win32.GlobalUnlock(iul_pGlobalBuffer)
END IF

IF iul_hGlobal > 0 THEN
	inv_win32.GlobalFree(iul_hGlobal)
END IF

inv_win32.GdiplusShutdown(iul_GdiToken)

DESTROY inv_win32

RETURN TRUE
end function

