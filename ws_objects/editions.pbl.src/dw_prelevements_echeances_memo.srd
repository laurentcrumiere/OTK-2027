 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_soins~" ) COLUMN(NAME=~"ligne_soins.cle~") COLUMN(NAME=~"ligne_soins.code~") COLUMN(NAME=~"ligne_soins.date~") COLUMN(NAME=~"ligne_soins.montant~") COLUMN(NAME=~"ligne_soins.tp~") COLUMN(NAME=~"ligne_soins.origine_tp~") COLUMN(NAME=~"ligne_soins.non_prelevement~") COLUMN(NAME=~"ligne_soins.code_prelevement~")WHERE(    EXP1 =~"~~~"ligne_soins~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":v_code~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ligne_soins~~~".~~~"cle~~~"~"   OP =~"=~"    EXP2 =~":v_cle~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ligne_soins~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":v_date_min and :v_date_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ligne_soins~~~".~~~"tp~~~"~"   OP =~"=~"    EXP2 =~"'N'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"isnull(~~~"ligne_soins~~~".~~~"non_prelevement~~~",'N')~"   OP =~"<>~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"v_code~" TYPE = number)  ARG(NAME = ~"v_cle~" TYPE = number)  ARG(NAME = ~"v_date_min~" TYPE = date)  ARG(NAME = ~"v_date_max~" TYPE = date) " update="ligne_soins" updatewhere=1 updatekeyinplace=no arguments=(("v_code", number),("v_cle", number),("v_date_min", date),("v_date_max", date)) )
