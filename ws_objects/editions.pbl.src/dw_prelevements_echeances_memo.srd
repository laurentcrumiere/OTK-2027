table(column=(type=number updatewhereclause=yes key=yes name=cle dbname="ligne_soins.cle" dbalias=".cle" )
 column=(type=number updatewhereclause=yes key=yes name=code dbname="ligne_soins.code" dbalias=".code" )
 column=(type=date updatewhereclause=yes key=yes name=date dbname="ligne_soins.date" dbalias=".date" )
