table(column=(type=long updatewhereclause=yes name=nb_mois1 dbname="nb_mois1" )
 column=(type=char(30) updatewhereclause=yes name=prat1_nom dbname="prat1_nom" )
 column=(type=long updatewhereclause=yes name=nb_mois2 dbname="nb_mois2" )
 column=(type=long updatewhereclause=yes name=nb_annee1 dbname="nb_annee1" )
 column=(type=long updatewhereclause=yes name=nb_annee2 dbname="nb_annee2" )
 column=(type=char(6) updatewhereclause=yes key=yes name=code dbname="etat_rdv.code" dbalias=".code" )
 column=(type=char(30) updatewhereclause=yes name=nom dbname="etat_rdv.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=couleur dbname="etat_rdv.couleur" dbalias=".couleur" )
 retrieve="  SELECT (select isnull(count(*),0) as nb_mois1 from rdv, agenda,patient where rdv.~"absent~" = etat_rdv.code and rdv.code = patient.code and patient.numero_dossier between :code1 and :code2 and year(rdv) = :annee1 and month(rdv) = :mois and  ~"rdv~".~"code_praticien~" between :prat1 and :prat2  AND   ((~"rdv~".~"fauteuil~" <= ~"agenda~".~"nombre_fauteuil~"  AND    ~"agenda~".~"urgence~" = 'N') OR   (~"rdv~".~"fauteuil~" <= ~"agenda~".~"nombre_fauteuil~"  + 1 AND   ~"agenda~".~"urgence~" = 'O')) ),   
         (SELECT nom from prati where code = :prat1 ) as prat1_nom,   
         (select isnull(count(*),0) as nb_mois2 from rdv, agenda, patient where rdv.~"absent~" = etat_rdv.code and  rdv.code = patient.code and patient.numero_dossier between :code1 and :code2 and year(rdv) = :annee2 and month(rdv) = :mois and  ~"rdv~".~"code_praticien~" between :prat1 and :prat2  AND   ((~"rdv~".~"fauteuil~" <= ~"agenda~".~"nombre_fauteuil~"  AND    ~"agenda~".~"urgence~" = 'N') OR   (~"rdv~".~"fauteuil~" <= ~"agenda~".~"nombre_fauteuil~"  + 1 AND   ~"agenda~".~"urgence~" = 'O')) ),   
         (select isnull(count(*),0) as nb_annee1 from rdv, agenda, patient where rdv.~"absent~" = etat_rdv.code and rdv.code = patient.code and patient.numero_dossier between :code1 and :code2 and year(rdv) = :annee1 and month(rdv) <= :mois and  ~"rdv~".~"code_praticien~" between :prat1 and :prat2  AND   ((~"rdv~".~"fauteuil~" <= ~"agenda~".~"nombre_fauteuil~"  AND    ~"agenda~".~"urgence~" = 'N') OR   (~"rdv~".~"fauteuil~" <= ~"agenda~".~"nombre_fauteuil~"  + 1 AND   ~"agenda~".~"urgence~" = 'O'))  ),   
         (select isnull(count(*),0) as nb_annee2 from rdv, agenda, patient where rdv.~"absent~" = etat_rdv.code and rdv.code = patient.code and patient.numero_dossier between :code1 and :code2 and year(rdv) = :annee2 and month(rdv) <= :mois and  ~"rdv~".~"code_praticien~" between :prat1 and :prat2  AND   ((~"rdv~".~"fauteuil~" <= ~"agenda~".~"nombre_fauteuil~"  AND    ~"agenda~".~"urgence~" = 'N') OR   (~"rdv~".~"fauteuil~" <= ~"agenda~".~"nombre_fauteuil~"  + 1 AND   ~"agenda~".~"urgence~" = 'O')) ),   
         ~"etat_rdv~".~"code~",   
         ~"etat_rdv~".~"nom~",   
         ~"etat_rdv~".~"couleur~"  
    FROM ~"etat_rdv~"   
" update="etat_rdv" updatewhere=0 updatekeyinplace=no filter=" nb_annee1 + nb_annee2 > 0"arguments=(("code1", number),("code2", number),("prat1", string),("prat2", string),("mois", number),("annee1", number),("annee2", number))  sort="nom A " )
