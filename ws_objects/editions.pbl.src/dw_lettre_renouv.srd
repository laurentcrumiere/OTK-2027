table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=date updatewhereclause=yes name=date_demande dbname="soins.date_demande" dbalias=".date_demande" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_scp_demande dbname="soins.scp_demande" dbalias=".scp_demande" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" dbalias=".numero" )
 column=(type=char(6) update=yes updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=number updatewhereclause=yes name=soins_cle dbname="soins.cle" dbalias=".cle" )
 column=(type=number updatewhereclause=yes name=soins_code dbname="soins.code" dbalias=".code" )
 column=(type=char(10) updatewhereclause=yes name=soins_type dbname="soins.type" dbalias=".type" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" dbalias=".code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(35) updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_titre_parent1 dbname="patient.titre_parent1" dbalias=".titre_parent1" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(80) updatewhereclause=yes name=prati_entete dbname="prati.entete" dbalias=".entete" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=char(1) updatewhereclause=yes name=code_soins_renouvt dbname="code_soins.renouvt" dbalias=".renouvt" )
 column=(type=date updatewhereclause=yes name=cdate_jour dbname="date_jour" )
 column=(type=char(20) updatewhereclause=yes name=titre dbname="titre_personnes.nom" dbalias=".nom" )
 column=(type=date updatewhereclause=yes name=soins_date_impr dbname="soins.date_impr" dbalias=".date_impr" )
 column=(type=char(30) updatewhereclause=yes name=pays_parent1 dbname="pays.nom" dbalias=".nom" )
 column=(type=decimal(2) updatewhereclause=yes name=somme_due dbname="patient.somme_due" dbalias=".somme_due" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" dbalias=".email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" dbalias=".email_patient" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"pays~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"code_soins.renouvt~") COMPUTE(NAME=~"cast(getdate() as date) as date_jour~") COLUMN(NAME=~"titre_personnes.nom~") COLUMN(NAME=~"soins.date_impr~") COLUMN(NAME=~"pays.nom~") COLUMN(NAME=~"patient.somme_due~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"titre_personnes.code~"    OP =~"=~"RIGHT=~"patient.titre_parent1~"    OUTER2 =~"patient.titre_parent1~" )    JOIN (LEFT=~"pays.code~"    OP =~"=~"RIGHT=~"patient.pays_parent1~"    OUTER2 =~"patient.pays_parent1~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_demande~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"adulte~~~"~"   OP =~"between~"    EXP2 =~":adu_min and :adu_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"code_soins~~~".~~~"renouvt~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"adu_min~" TYPE = string)  ARG(NAME = ~"adu_max~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("adu_min", string),("adu_max", string))  sort="prati_nom A nom A prenom A " )
