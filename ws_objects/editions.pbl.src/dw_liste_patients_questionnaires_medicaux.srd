table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=date updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" dbalias=".type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" dbalias=".code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" dbalias=".premiere_visite" )
 column=(type=char(10) updatewhereclause=yes name=moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=date updatewhereclause=yes name=relance dbname="patient.relance" dbalias=".relance" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(30) updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=correspondants_nom dbname="correspondants.nom" dbalias=".nom" )
 column=(type=char(20) updatewhereclause=yes name=classe dbname="patient.classe" dbalias=".classe" )
 column=(type=char(20) updatewhereclause=yes name=type dbname="patient.type" dbalias=".type" )
 column=(type=char(25) updatewhereclause=yes name=portable dbname="patient.portable" dbalias=".portable" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" dbalias=".com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" dbalias=".secu_parent1" )
 column=(type=datetime updatewhereclause=yes key=yes name=envoi dbname="patient_questionnaires_medicaux.envoi" dbalias=".envoi" )
 column=(type=datetime updatewhereclause=yes name=validation dbname="patient_questionnaires_medicaux.validation" dbalias=".validation" )
 column=(type=char(1) update=yes updatewhereclause=yes name=archive dbname="patient_questionnaires_medicaux.archive" dbalias=".archive" values="	O/	N" )
 column=(type=number updatewhereclause=yes key=yes name=patient_questionnaires_medicaux_code dbname="patient_questionnaires_medicaux.code" dbalias=".code" )
 column=(type=long updatewhereclause=yes name=patient_questionnaires_medicaux_id_questionnaire dbname="patient_questionnaires_medicaux.id_questionnaire" dbalias=".id_questionnaire" )
 column=(type=datetime updatewhereclause=yes name=patient_prochain_rdv dbname="patient_prochain_rdv" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" dbalias=".email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" dbalias=".email_patient" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_parent2 dbname="patient.email_parent2" dbalias=".email_parent2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"dossier~" )  TABLE(NAME=~"correspondants~" )  TABLE(NAME=~"patient_questionnaires_medicaux~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"patient.classe~") COLUMN(NAME=~"patient.type~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient_questionnaires_medicaux.envoi~") COLUMN(NAME=~"patient_questionnaires_medicaux.validation~") COLUMN(NAME=~"patient_questionnaires_medicaux.archive~") COLUMN(NAME=~"patient_questionnaires_medicaux.code~") COLUMN(NAME=~"patient_questionnaires_medicaux.id_questionnaire~") COMPUTE(NAME=~"(SELECT min(rdv) as patient_prochain_rdv  FROM rdv, etat_rdv WHERE rdv >= getdate() and rdv.code = patient.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' )~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.email_parent2~")    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )    JOIN (LEFT=~"correspondants.code~"    OP =~"=~"RIGHT=~"patient.code_correspondant~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"patient_questionnaires_medicaux.code~" )WHERE(    EXP1 =~"( ( ~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cast(~~~"patient_questionnaires_medicaux~~~".~~~"envoi~~~" as date)~"   OP =~"between~"    EXP2 =~":v_date_min and :v_date_max ) )~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"v_date_min~" TYPE = date)  ARG(NAME = ~"v_date_max~" TYPE = date) " update="patient_questionnaires_medicaux" updatewhere=0 updatekeyinplace=no arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("v_date_min", date),("v_date_max", date))  sort="nom A prenom A " )
