 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"soins~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"param_secu~" )  TABLE(NAME=~"caisse~" ) COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.nom_parent2~") COLUMN(NAME=~"patient.secu_parent2~") COLUMN(NAME=~"patient.nom_payeur~") COLUMN(NAME=~"patient.secu_payeur~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"prati.typort~") COLUMN(NAME=~"param.payassu~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.plan_traitement~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.basal_max_pro~") COLUMN(NAME=~"patient.basal_max_retro~") COLUMN(NAME=~"patient.basal_mand_pro~") COLUMN(NAME=~"patient.basal_mand_retro~") COLUMN(NAME=~"patient.basal_max_endo~") COLUMN(NAME=~"patient.basal_max_exo~") COLUMN(NAME=~"patient.basal_mand_endo~") COLUMN(NAME=~"patient.basal_mand_exo~") COLUMN(NAME=~"patient.hypodivergence~") COLUMN(NAME=~"patient.hyperdivergence~") COLUMN(NAME=~"patient.alveo_max_pro~") COLUMN(NAME=~"patient.alveo_max_retro~") COLUMN(NAME=~"patient.alveo_mand_pro~") COLUMN(NAME=~"patient.alveo_mand_retro~") COLUMN(NAME=~"patient.alveo_max_endo~") COLUMN(NAME=~"patient.alveo_max_exo~") COLUMN(NAME=~"patient.alveo_mand_endo~") COLUMN(NAME=~"patient.alveo_mand_exo~") COLUMN(NAME=~"patient.supraclusion~") COLUMN(NAME=~"patient.infraclusion~") COLUMN(NAME=~"patient.mol_cl1~") COLUMN(NAME=~"patient.mol_cl2~") COLUMN(NAME=~"patient.mol_cl3~") COLUMN(NAME=~"patient.can_cl1~") COLUMN(NAME=~"patient.can_cl2~") COLUMN(NAME=~"patient.can_cl3~") COLUMN(NAME=~"patient.molaire~") COLUMN(NAME=~"patient.canine~") COLUMN(NAME=~"patient.dento_max~") COLUMN(NAME=~"patient.dento_dent~") COLUMN(NAME=~"patient.occl_dte~") COLUMN(NAME=~"patient.occl_gche~") COLUMN(NAME=~"patient.occl_ant~") COLUMN(NAME=~"patient.commentaire~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"code_soins.renouvt~") COMPUTE(NAME=~"( datediff (year , date_naissance, CURRENT DATE ) ) AS AGE~") COLUMN(NAME=~"patient.assure~") COLUMN(NAME=~"patient.devis_remis~") COLUMN(NAME=~"param_secu.renouv_date_x~") COLUMN(NAME=~"param_secu.renouv_date_y~") COLUMN(NAME=~"patient.plan_imprime~") COLUMN(NAME=~"param_secu.renouv_r_x~") COLUMN(NAME=~"param_secu.renouv_r_y~") COLUMN(NAME=~"param_secu.renouv_hr_x~") COLUMN(NAME=~"param_secu.renouv_hr_y~") COLUMN(NAME=~"patient.agenesie~") COLUMN(NAME=~"patient.surnum~") COLUMN(NAME=~"patient.malposition~") COLUMN(NAME=~"patient.facteur~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"patient.dep_imprime~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"prati.institution_perceptrice~") COLUMN(NAME=~"param_secu.renouv_date_jour~") COLUMN(NAME=~"patient.secu_patient~") COLUMN(NAME=~"code_soins.decomposition~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.numero_structure~") COLUMN(NAME=~"caisse.nom~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )    JOIN (LEFT=~"patient.code_caisse~"    OP =~"=~"RIGHT=~"caisse.code~" )WHERE(    EXP1 =~"( ( ~~~"soins~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":numero_dossier )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"soins~~~".~~~"cle~~~"~"   OP =~"=~"    EXP2 =~":cle_soins ) )~" ) ) ARG(NAME = ~"numero_dossier~" TYPE = number)  ARG(NAME = ~"cle_soins~" TYPE = number) " filter="/*( soins_type = 'S' )  or ( soins_type  = 'C' ) or ( soins_type = 'D' and  soins_scp_demande = 10 )*/
 code_soins_renouvt = 'O'"arguments=(("numero_dossier", number),("cle_soins", number)) )
