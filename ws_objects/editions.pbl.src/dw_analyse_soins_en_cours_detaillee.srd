table(column=(type=char(10) updatewhereclause=yes name=type dbname="soins.type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=decimal(2) updatewhereclause=yes name=scp_demande dbname="soins.scp_demande" initial="null" )
 column=(type=decimal(2) updatewhereclause=yes name=hn dbname="soins.hn" )
 column=(type=decimal(2) updatewhereclause=yes name=total dbname="soins.total" )
 column=(type=char(3) updatewhereclause=yes name=prati_typort dbname="prati.typort" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" )
 column=(type=char(200) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" )
 retrieve="  SELECT ~"soins~".~"type~",   
         ~"soins~".~"scp_demande~",   
         ~"soins~".~"hn~",   
         ~"soins~".~"total~",   
         ~"prati~".~"typort~",   
         ~"soins~".~"numero~" ,
			~"code_soins~".~"nom~",
			~"code_soins~".~"lettre~"  
    FROM ~"soins~",   
         ~"prati~",   
         ~"patient~",
			~"code_soins~",  
   WHERE ( ~"prati~".~"code~" = ~"patient~".~"code_praticien~" ) and  
         ( ~"patient~".~"code~" = ~"soins~".~"code~" ) and  
         ( ~"prati~".~"code~" = :prat ) AND 
			( ~"code_soins~".~"code~" = ~"soins~".~"type~" ) AND ~"code_soins~".~"duree~" > 0 and 
         ( :date_ref between ~"soins~".~"date_demande~" and dateadd(day,~"code_soins~".~"duree~" * 30, ~"soins~".~"date_demande~"))
" arguments=(("prat", string),("date_ref", date))  sort="code_soins_nom A soins_numero A scp_demande A " )
