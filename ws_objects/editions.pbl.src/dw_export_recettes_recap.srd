table(column=(type=date updatewhereclause=yes name=date dbname="paye.date" initial="today" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_cheques dbname="montant_cheques" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_especes dbname="montant_especes" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_virement dbname="montant_virement" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_cb dbname="montant_cb" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"paye~" ) COLUMN(NAME=~"paye.date~") COMPUTE(NAME=~"(select sum(montant) as montant_cheques from paye as paye2, soins where paye2.code = soins.code and paye2.cle = soins.cle and soins.~~~"type~~~" between :typ_min and :typ_max and paye2.~~~"date~~~" = paye.~~~"date~~~" and ~~~"mode~~~" in ('C', 'P') and paye2.banque between :banq_min and :banq_max and paye2.~~~"mode~~~" between :mod_min and :mod_max and paye2.code_praticien between :prat_min and :prat_max )~") COMPUTE(NAME=~"(select sum(montant) as montant_especes from paye as paye2, soins where paye2.code = soins.code and paye2.cle = soins.cle and soins.~~~"type~~~" between :typ_min and :typ_max and paye2.~~~"date~~~" = paye.~~~"date~~~" and ~~~"mode~~~" in ('E') and paye2.banque between :banq_min and :banq_max and paye2.~~~"mode~~~" between :mod_min and :mod_max and paye2.code_praticien between :prat_min and :prat_max )~") COMPUTE(NAME=~"(select sum(montant) as montant_virement from paye as paye2, soins where paye2.code = soins.code and paye2.cle = soins.cle and soins.~~~"type~~~" between :typ_min and :typ_max and paye2.~~~"date~~~" = paye.~~~"date~~~" and ~~~"mode~~~" in ('V', 'M', 'R', 'D') and paye2.banque between :banq_min and :banq_max and paye2.~~~"mode~~~" between :mod_min and :mod_max and paye2.code_praticien between :prat_min and :prat_max )~") COMPUTE(NAME=~"(select sum(montant) as montant_cb from paye as paye2, soins where paye2.code = soins.code and paye2.cle = soins.cle and soins.~~~"type~~~" between :typ_min and :typ_max and paye2.~~~"date~~~" = paye.~~~"date~~~" and ~~~"mode~~~" in ('B', 'I') and paye2.banque between :banq_min and :banq_max and paye2.~~~"mode~~~" between :mod_min and :mod_max and paye2.code_praticien between :prat_min and :prat_max )~")WHERE(    EXP1 =~"~~~"paye~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":d1 and :d2~" )  GROUP(NAME=~"paye.date~")) ARG(NAME = ~"d1~" TYPE = date)  ARG(NAME = ~"d2~" TYPE = date)  ARG(NAME = ~"typ_min~" TYPE = string)  ARG(NAME = ~"typ_max~" TYPE = string)  ARG(NAME = ~"banq_min~" TYPE = string)  ARG(NAME = ~"banq_max~" TYPE = string)  ARG(NAME = ~"mod_min~" TYPE = string)  ARG(NAME = ~"mod_max~" TYPE = string)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string) " arguments=(("d1", date),("d2", date),("typ_min", string),("typ_max", string),("banq_min", string),("banq_max", string),("mod_min", string),("mod_max", string),("prat_min", string),("prat_max", string))  sort="date A " )
