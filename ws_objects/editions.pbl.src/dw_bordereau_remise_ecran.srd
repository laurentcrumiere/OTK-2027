table(column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=char(50) updatewhereclause=yes name=prati_ident dbname="prati.ident" )
 column=(type=char(50) updatewhereclause=yes name=prati_banq1 dbname="prati.banq1" )
 column=(type=char(50) updatewhereclause=yes name=prati_banq2 dbname="prati.banq2" )
 column=(type=char(26) updatewhereclause=yes name=prati_rib dbname="prati.rib" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=date updatewhereclause=yes key=yes name=paye_date dbname="paye.date" initial="today" )
 column=(type=decimal(2) updatewhereclause=yes key=yes name=paye_montant dbname="paye.montant" )
 column=(type=char(50) updatewhereclause=yes name=paye_payeur dbname="paye.payeur" )
 column=(type=date updatewhereclause=yes key=yes name=paye_dateremise dbname="paye.dateremise" initial="today" )
 column=(type=char(40) updatewhereclause=yes key=yes name=paye_commentaire dbname="paye.commentaire" )
 column=(type=char(1) updatewhereclause=yes key=yes name=paye_mode dbname="paye.mode" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=decimal(2) updatewhereclause=yes name=paye_montant_monnaie dbname="paye.montant_monnaie" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=paye_deja_imprime dbname="paye.deja_imprime" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=numero_ligne dbname="numero_ligne" )
 column=(type=char(6) updatewhereclause=yes name=paye_code_praticien dbname="paye.code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=datetime updatewhereclause=yes name=paye_heure_saisie dbname="paye.heure_saisie" )
 column=(type=number update=yes updatewhereclause=yes name=paye_code_remise dbname="paye.code_remise" )
 column=(type=number updatewhereclause=yes key=yes name=paye_code dbname="paye.code" )
 column=(type=number updatewhereclause=yes key=yes name=paye_cle dbname="paye.cle" )
 column=(type=char(20) updatewhereclause=yes name=mode_reglement_nom dbname="mode_reglement.nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"paye~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"banque~" )  TABLE(NAME=~"mode_reglement~" ) COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.ident~") COLUMN(NAME=~"prati.banq1~") COLUMN(NAME=~"prati.banq2~") COLUMN(NAME=~"prati.rib~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"paye.montant_monnaie~") COLUMN(NAME=~"paye.deja_imprime~") COMPUTE(NAME=~"row_number() over (order by patient.code )  as numero_ligne~") COLUMN(NAME=~"paye.code_praticien~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"paye.heure_saisie~") COLUMN(NAME=~"paye.code_remise~") COLUMN(NAME=~"paye.code~") COLUMN(NAME=~"paye.cle~") COLUMN(NAME=~"mode_reglement.nom~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"paye.code~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"banque.code~"    OP =~"=~"RIGHT=~"paye.banque~" )    JOIN (LEFT=~"paye.mode~"    OP =~"=~"RIGHT=~"mode_reglement.code~" )WHERE(    EXP1 =~"~~~"paye~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":pra_min and :pra_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"dateremise~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"monnaie~~~"~"   OP =~"=~"    EXP2 =~":monnaie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"montant~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"banque~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":banque~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"code_remise~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) ARG(NAME = ~"pra_min~" TYPE = string)  ARG(NAME = ~"pra_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"monnaie~" TYPE = string)  ARG(NAME = ~"banque~" TYPE = string) " update="paye" updatewhere=0 updatekeyinplace=no arguments=(("pra_min", string),("pra_max", string),("date_min", date),("date_max", date),("monnaie", string),("banque", string))  sort="paye_dateremise A paye_heure_saisie A paye_payeur A paye_mode A paye_commentaire A paye_date A patient_nom A patient_prenom A paye_code_praticien A " )
