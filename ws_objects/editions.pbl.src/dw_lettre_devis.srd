 column=(type=decimal(0) updatewhereclause=yes name=prati_cadre_entete dbname="prati.cadre_entete" dbalias=".cadre_entete" initial="0" values="Aucun	0/Ombré	1/Rectangle	2/Ligne	4/3D en creux	5/3D en relief	6/" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_cadre_bas_page dbname="prati.cadre_bas_page" dbalias=".cadre_bas_page" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=patient_titre_parent1 dbname="patient.titre_parent1" dbalias=".titre_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(20) update=yes updatewhereclause=yes name=titre dbname="titre_personnes.nom" dbalias=".nom" )
 column=(type=date updatewhereclause=yes name=cdate_jour dbname="date_jour" )
 column=(type=char(1) updatewhereclause=yes name=date_litterale dbname="table_vide.v3" dbalias=".v3" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=pays_parent1 dbname="pays.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" dbalias=".code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"param~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"table_vide~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"pays~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"param.parag_secu_devis~") COLUMN(NAME=~"param.parag_content_devis~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"table_vide.v2~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"prati.cadre_bas_page~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"titre_personnes.nom~") COMPUTE(NAME=~"cast(getdate() as date) as date_jour~") COLUMN(NAME=~"table_vide.v3~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"pays.nom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.code~")    JOIN (LEFT=~"titre_personnes.code~"    OP =~"=~"RIGHT=~"patient.titre_parent1~"    OUTER2 =~"patient.titre_parent1~" )    JOIN (LEFT=~"pays.code~"    OP =~"=~"RIGHT=~"patient.pays_parent1~"    OUTER2 =~"patient.pays_parent1~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " arguments=(("nocode", number)) )
