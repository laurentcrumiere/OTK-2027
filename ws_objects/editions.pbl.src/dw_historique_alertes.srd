table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=date updatewhereclause=yes name=patient_alertes_date dbname="patient_alertes.date" )
 column=(type=char(500) updatewhereclause=yes name=patient_alertes_commentaire dbname="patient_alertes.commentaire" )
 column=(type=char(1) updatewhereclause=yes name=patient_alertes_realisee dbname="patient_alertes.realisee" values="	O/	N" )
 column=(type=datetime updatewhereclause=yes name=historique_alertes_date_action dbname="historique_alertes.date_action" )
 column=(type=char(1) updatewhereclause=yes name=historique_alertes_type_action dbname="historique_alertes.type_action" values="Ajout	A/Modification 	M/Suppression	S/" )
 column=(type=char(1) updatewhereclause=yes name=historique_alertes_automatique dbname="historique_alertes.automatique" values="	O/	N" )
 column=(type=char(30) updatewhereclause=yes name=utilisateurs_nom dbname="utilisateurs.nom" )
 column=(type=char(200) updatewhereclause=yes name=alertes_nom dbname="alertes.nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"utilisateurs~" )  TABLE(NAME=~"alertes~" )  TABLE(NAME=~"historique_alertes~" )  TABLE(NAME=~"patient_alertes~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient_alertes.date~") COLUMN(NAME=~"patient_alertes.commentaire~") COLUMN(NAME=~"patient_alertes.realisee~") COLUMN(NAME=~"historique_alertes.date_action~") COLUMN(NAME=~"historique_alertes.type_action~") COLUMN(NAME=~"historique_alertes.automatique~") COLUMN(NAME=~"utilisateurs.nom~") COLUMN(NAME=~"alertes.nom~")    JOIN (LEFT=~"patient_alertes.code_alerte~"    OP =~"=~"RIGHT=~"alertes.code~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"patient_alertes.code_patient~" )    JOIN (LEFT=~"patient_alertes.code_patient~"    OP =~"=~"RIGHT=~"historique_alertes.code_patient~" )    JOIN (LEFT=~"patient_alertes.code_alerte~"    OP =~"=~"RIGHT=~"historique_alertes.code_alerte~" )    JOIN (LEFT=~"patient_alertes.date~"    OP =~"=~"RIGHT=~"historique_alertes.date~" )    JOIN (LEFT=~"historique_alertes.user~"    OP =~"=~"RIGHT=~"utilisateurs.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"historique_alertes~~~".~~~"user~~~"~"   OP =~"between~"    EXP2 =~":user_min and :user_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"alertes~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":type_min and :type_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"historique_alertes~~~".~~~"date_action~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"type_min~" TYPE = number)  ARG(NAME = ~"type_max~" TYPE = number)  ARG(NAME = ~"date_min~" TYPE = datetime)  ARG(NAME = ~"date_max~" TYPE = datetime)  ARG(NAME = ~"user_min~" TYPE = string)  ARG(NAME = ~"user_max~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("type_min", number),("type_max", number),("date_min", datetime),("date_max", datetime),("user_min", string),("user_max", string))  sort="nom_prenom A numero_dossier A historique_alertes_date_action A " )
