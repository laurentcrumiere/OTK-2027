 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"param_secu~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"param.numero_appareil_radio~") COLUMN(NAME=~"param_secu.remb_retro_x~") COLUMN(NAME=~"param_secu.remb_retro_y~") COLUMN(NAME=~"param_secu.remb_pano_x~") COLUMN(NAME=~"param_secu.remb_pano_y~") COLUMN(NAME=~"param_secu.remb_tele_x~") COLUMN(NAME=~"param_secu.remb_tele_y~") COLUMN(NAME=~"param_secu.remb_date_x~") COLUMN(NAME=~"param_secu.remb_date_y~") COLUMN(NAME=~"prati.institution_perceptrice~")    JOIN (LEFT=~"patient.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":num~" ) ) ARG(NAME = ~"num~" TYPE = number) " arguments=(("num", number)) )
