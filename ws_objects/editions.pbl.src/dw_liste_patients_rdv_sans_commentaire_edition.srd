table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" dbalias=".type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" dbalias=".relance" )
 column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" dbalias=".rdv" )
 column=(type=char(6) updatewhereclause=yes name=rdv_type dbname="rdv.type" dbalias=".type" )
 column=(type=char(6) updatewhereclause=yes name=rdv_code_praticien dbname="rdv.code_praticien" dbalias=".code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_duree dbname="rdv.duree" dbalias=".duree" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_fauteuil dbname="rdv.fauteuil" dbalias=".fauteuil" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" dbalias=".nom" )
 column=(type=char(20) update=yes updatewhereclause=yes name=patient_classe dbname="patient.classe" dbalias=".classe" )
 column=(type=char(20) update=yes updatewhereclause=yes name=patient_type dbname="patient.type" dbalias=".type" )
 column=(type=long updatewhereclause=yes name=nb_commentaire dbname="nb_commentaire" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(6) updatewhereclause=yes name=rdv_absent dbname="rdv.absent" dbalias=".absent" )
 column=(type=char(30) updatewhereclause=yes name=etat_rdv_nom dbname="etat_rdv.nom" dbalias=".nom" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" dbalias=".com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" dbalias=".secu_parent1" )
 column=(type=long updatewhereclause=yes name=nb_tracabilite dbname="nb_tracabilite" )
 column=(type=long updatewhereclause=yes name=nb_sterilisation dbname="nb_sterilisation" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" dbalias=".nom" )
 column=(type=long updatewhereclause=yes name=nb_acte_prevu dbname="nb_acte_prevu" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"dossier~" )  TABLE(NAME=~"etat_rdv~" )  TABLE(NAME=~"type_rdv~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"patient.classe~") COLUMN(NAME=~"patient.type~") COMPUTE(NAME=~"(SELECT isnull(count(*),0) AS nb_commentaire  FROM coment WHERE cast (rdv.rdv as date)  = Coment.dat and coment.code = rdv.code )~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"etat_rdv.nom~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COMPUTE(NAME=~"(select count(*) as nb_tracabilite from fiche_tracabilite where fiche_tracabilite.code_patient = rdv.code and  cast (rdv.rdv as date)  = fiche_tracabilite.date_rdv )~") COMPUTE(NAME=~"(select count(*) as nb_sterilisation from sterilisation where sterilisation.code_patient = rdv.code and cast (rdv.rdv as date)   = sterilisation.date_saisie )~") COLUMN(NAME=~"type_rdv.nom~") COMPUTE(NAME=~"(SELECT isnull(count(*),0) AS nb_acte_prevu  FROM coment WHERE cast (rdv.rdv as date)  = Coment.dat and coment.code = rdv.code and trim(isnull(acte_prevu_html, '')) <> '' )~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"rdv.code~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )    JOIN (LEFT=~"rdv.absent~"    OP =~"=~"RIGHT=~"etat_rdv.code~" )    JOIN (LEFT=~"rdv.type~"    OP =~"=~"RIGHT=~"type_rdv.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cast(~~~"rdv~~~".~~~"rdv~~~" as date )~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"etat_rdv~~~".~~~"elimine_agenda~~~"~"   OP =~"<>~"    EXP2 =~"'O'~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date))  sort="rdv_rdv A nom A patient_prenom A " )
