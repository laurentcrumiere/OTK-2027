table(column=(type=number update=yes updatewhereclause=yes key=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=date updatewhereclause=yes name=patient_relance dbname="patient.relance" )
 column=(type=datetime updatewhereclause=yes name=dernier_rdv dbname="dernier_rdv" )
 column=(type=char(25) updatewhereclause=yes name=portable dbname="patient.portable" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(35) updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(200) updatewhereclause=yes name=com_parent1 dbname="patient.com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=secu_parent1 dbname="patient.secu_parent1" )
 column=(type=long updatewhereclause=yes name=nb_soins_demande dbname="nb_soins_demande" )
 column=(type=date updatewhereclause=yes name=prem_date_soins_demande dbname="prem_date_soins_demande" )
 column=(type=long updatewhereclause=yes name=nb_soins_305631 dbname="nb_soins_305631" )
 column=(type=date updatewhereclause=yes name=prem_date_305631 dbname="prem_date_305631" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.relance~") COMPUTE(NAME=~"(select max(rdv) as dernier_rdv from rdv, etat_rdv where rdv.code = patient.code and cast (rdv.rdv as date)  <= cast(getdate() as date) and absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O')~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COMPUTE(NAME=~"(select count(*) from soins, code_soins where soins.code = patient.code and soins.~~~"type~~~" = code_soins.code and code_soins.renouvt = 'O' and soins.scp_demande >= 45) as nb_soins_demande~") COMPUTE(NAME=~"(select min(date_demande) from soins, code_soins where soins.code = patient.code and soins.~~~"type~~~" = code_soins.code and code_soins.renouvt = 'O' and soins.scp_demande >= 45) as prem_date_soins_demande~") COMPUTE(NAME=~"(select count(*) from soins where soins.code = patient.code and soins.~~~"type~~~" = '305631' ) as nb_soins_305631~") COMPUTE(NAME=~"(select min(date_demande) from soins where soins.code = patient.code and soins.~~~"type~~~" = '305631') as prem_date_305631~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":num_dossier_min and :num_dossier_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"debut_traitement~~~"~"   OP =~"is~"    EXP2 =~"null~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"num_dossier_min~" TYPE = number)  ARG(NAME = ~"num_dossier_max~" TYPE = number) " update="patient" updatewhere=1 updatekeyinplace=no arguments=(("prat_min", string),("prat_max", string),("num_dossier_min", number),("num_dossier_max", number))  sort="nom A prenom A code A " )
