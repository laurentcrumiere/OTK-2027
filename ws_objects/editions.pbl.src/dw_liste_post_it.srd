 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdv_post_it~" ) COLUMN(NAME=~"rdv_post_it.texte~") COLUMN(NAME=~"rdv_post_it.couleur~") COLUMN(NAME=~"rdv_post_it.alerte_prise_de_rdv~") COLUMN(NAME=~"rdv_post_it.user_modif~") COLUMN(NAME=~"rdv_post_it.date_modif~") COLUMN(NAME=~"rdv_post_it.date~") COMPUTE(NAME=~"(select isnull(~~~"nom~~~" + ' ' + ~~~"prenom~~~", '') from prati where prati.code = code_praticien) as nom_praticien~") COLUMN(NAME=~"rdv_post_it.code_praticien~")WHERE(    EXP1 =~"(~~~"rdv_post_it~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"rdv_post_it~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~"'TOUS')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdv_post_it~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " update="rdv_post_it" updatewhere=0 updatekeyinplace=no arguments=(("prat_min", string),("prat_max", string),("date_min", date),("date_max", date))  sort="nom_praticien A rdv_post_it_date A " )
