table(column=(type=long updatewhereclause=yes name=nb_contact1 dbname="nb_contact1" )
 column=(type=char(30) updatewhereclause=yes name=prat1_nom dbname="prat1_nom" )
 column=(type=long updatewhereclause=yes name=nb_contact2 dbname="nb_contact2" )
 column=(type=char(20) updatewhereclause=yes name=nom dbname="mois.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=numero dbname="mois.numero" dbalias=".numero" )
 column=(type=long updatewhereclause=yes name=nb_visite1 dbname="nb_visite1" )
 column=(type=long updatewhereclause=yes name=nb_visite2 dbname="nb_visite2" )
 column=(type=long updatewhereclause=yes name=nb_debut1 dbname="nb_debut1" )
 column=(type=long updatewhereclause=yes name=nb_debut2 dbname="nb_debut2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mois~" ) COMPUTE(NAME=~"(select isnull(count(*),0) as nb_contact1 from patient where patient.numero_dossier between :code1 and :code2 and year(date_contact) = :annee1 and month(date_contact) = mois.numero and  ~~~"patient~~~".~~~"code_praticien~~~" between :prat1 and :prat2 and isnull(patient.adulte,'N') between :v_adulte_min and :v_adulte_max and isnull(patient.mise_en_evidence,'') between :v_evidence_min and :v_evidence_max  )~") COMPUTE(NAME=~"(SELECT nom from prati where code = :prat1 ) as prat1_nom~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_contact2 from patient where patient.numero_dossier between :code1 and :code2 and year(date_contact) = :annee2 and month(date_contact) = mois.numero and  ~~~"patient~~~".~~~"code_praticien~~~" between :prat1 and :prat2  and isnull(patient.adulte,'N') between :v_adulte_min and :v_adulte_max and isnull(patient.mise_en_evidence,'') between :v_evidence_min and :v_evidence_max   )~") COLUMN(NAME=~"mois.nom~") COLUMN(NAME=~"mois.numero~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_visite1 from patient where patient.numero_dossier between :code1 and :code2 and year(premiere_visite) = :annee1 and month(premiere_visite) = mois.numero and  ~~~"patient~~~".~~~"code_praticien~~~" between :prat1 and :prat2  and isnull(patient.adulte,'N') between :v_adulte_min and :v_adulte_max and isnull(patient.mise_en_evidence,'') between :v_evidence_min and :v_evidence_max   )~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_visite2 from patient where patient.numero_dossier between :code1 and :code2 and year(premiere_visite) = :annee2 and month(premiere_visite) = mois.numero and  ~~~"patient~~~".~~~"code_praticien~~~" between :prat1 and :prat2  and isnull(patient.adulte,'N') between :v_adulte_min and :v_adulte_max and isnull(patient.mise_en_evidence,'') between :v_evidence_min and :v_evidence_max   )~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_debut1 from patient where patient.numero_dossier between :code1 and :code2 and year(debut_traitement) = :annee1 and month(debut_traitement) = mois.numero and  ~~~"patient~~~".~~~"code_praticien~~~" between :prat1 and :prat2  and isnull(patient.adulte,'N') between :v_adulte_min and :v_adulte_max and isnull(patient.mise_en_evidence,'') between :v_evidence_min and :v_evidence_max   )~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_debut2 from patient where patient.numero_dossier between :code1 and :code2 and year(debut_traitement) = :annee2 and month(debut_traitement) = mois.numero and  ~~~"patient~~~".~~~"code_praticien~~~" between :prat1 and :prat2  and isnull(patient.adulte,'N') between :v_adulte_min and :v_adulte_max and isnull(patient.mise_en_evidence,'') between :v_evidence_min and :v_evidence_max   )~")) ARG(NAME = ~"code1~" TYPE = number)  ARG(NAME = ~"code2~" TYPE = number)  ARG(NAME = ~"prat1~" TYPE = string)  ARG(NAME = ~"prat2~" TYPE = string)  ARG(NAME = ~"mois~" TYPE = number)  ARG(NAME = ~"annee1~" TYPE = number)  ARG(NAME = ~"annee2~" TYPE = number)  ARG(NAME = ~"v_adulte_min~" TYPE = string)  ARG(NAME = ~"v_adulte_max~" TYPE = string)  ARG(NAME = ~"v_evidence_min~" TYPE = string)  ARG(NAME = ~"v_evidence_max~" TYPE = string) " update="mois" updatewhere=0 updatekeyinplace=no arguments=(("code1", number),("code2", number),("prat1", string),("prat2", string),("mois", number),("annee1", number),("annee2", number),("v_adulte_min", string),("v_adulte_max", string),("v_evidence_min", string),("v_evidence_max", string))  sort="numero A " )
