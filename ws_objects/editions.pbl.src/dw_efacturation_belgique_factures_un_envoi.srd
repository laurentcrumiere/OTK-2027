table(column=(type=date updatewhereclause=yes name=efacture_belgique_date_facture dbname="efacture_belgique.date_facture" )
 column=(type=decimal(0) updatewhereclause=yes name=efacture_belgique_numero_facture dbname="efacture_belgique.numero_facture" )
 column=(type=char(3) updatewhereclause=yes name=efacture_belgique_code_oa_destination dbname="efacture_belgique.code_oa_destination" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_facture dbname="montant_facture" )
 column=(type=char(1) updatewhereclause=yes name=efacture_belgique_statut_my_carenet dbname="efacture_belgique.statut_my_carenet" values="Non envoyée	 /Envoyée	E/A renvoyer	A/Validée	V/Refusée	R/" )
 column=(type=char(6) updatewhereclause=yes name=efacture_belgique_code_praticien dbname="efacture_belgique.code_praticien" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=char(1) updatewhereclause=yes name=efacture_belgique_type_facture dbname="efacture_belgique.type_facture" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"efacture_belgique~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"ligne_envoi_efacture_belgique~" ) COLUMN(NAME=~"efacture_belgique.date_facture~") COLUMN(NAME=~"efacture_belgique.numero_facture~") COLUMN(NAME=~"efacture_belgique.code_oa_destination~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.numero_dossier~") COMPUTE(NAME=~"(select sum(montant_rembourse_oa) from ligne_efacture_belgique where ligne_efacture_belgique.numero_facture = efacture_belgique.numero_facture) as montant_facture~") COLUMN(NAME=~"efacture_belgique.statut_my_carenet~") COLUMN(NAME=~"efacture_belgique.code_praticien~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"efacture_belgique.type_facture~")    JOIN (LEFT=~"efacture_belgique.code_patient~"    OP =~"=~"RIGHT=~"patient.code~"    OUTER1 =~"efacture_belgique.code_patient~" )    JOIN (LEFT=~"efacture_belgique.numero_facture~"    OP =~"=~"RIGHT=~"ligne_envoi_efacture_belgique.numero_facture~" )    JOIN (LEFT=~"efacture_belgique.type_facture~"    OP =~"=~"RIGHT=~"ligne_envoi_efacture_belgique.type_facture~" )WHERE(    EXP1 =~"~~~"ligne_envoi_efacture_belgique~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":v_code_praticien~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ligne_envoi_efacture_belgique~~~".~~~"code_oa~~~"~"   OP =~"=~"    EXP2 =~":v_code_oa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"ligne_envoi_efacture_belgique~~~".~~~"date_envoi~~~"~"   OP =~"=~"    EXP2 =~":v_date_envoi~" ) ) ARG(NAME = ~"v_code_praticien~" TYPE = string)  ARG(NAME = ~"v_code_oa~" TYPE = string)  ARG(NAME = ~"v_date_envoi~" TYPE = date) " arguments=(("v_code_praticien", string),("v_code_oa", string),("v_date_envoi", date))  sort="efacture_belgique_date_facture A efacture_belgique_numero_facture A " )
