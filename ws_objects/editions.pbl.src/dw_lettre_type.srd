 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"pays~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"prati.nom~") COMPUTE(NAME=~"cast(getdate() as date) as date_jour~") COLUMN(NAME=~"titre_personnes.nom~") COLUMN(NAME=~"pays.nom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"titre_personnes.code~"    OP =~"=~"RIGHT=~"patient.titre_parent1~"    OUTER2 =~"patient.titre_parent1~" )    JOIN (LEFT=~"pays.code~"    OP =~"=~"RIGHT=~"patient.pays_parent1~"    OUTER2 =~"patient.pays_parent1~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )WHERE(    EXP1 =~":nocode~"   OP =~"=~"    EXP2 =~"~~~"patient~~~".~~~"code~~~"~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " arguments=(("nocode", number)) )
