 column=(type=char(50) updatewhereclause=yes name=praticien_adresse1_banque dbname="praticien_adresse1_banque" )
 column=(type=char(50) updatewhereclause=yes name=praticien_adresse2_banque dbname="praticien_adresse2_banque" )
 column=(type=char(26) updatewhereclause=yes name=praticien_rib_banque dbname="praticien_rib_banque" )
 column=(type=char(11) updatewhereclause=yes name=praticien_bic_banque dbname="praticien_bic_banque" )
 column=(type=char(30) updatewhereclause=yes name=praticien_ics_banque dbname="praticien_ics_banque" )
 column=(type=char(30) updatewhereclause=yes name=praticien_iban_banque dbname="praticien_iban_banque" )
 column=(type=char(1) updatewhereclause=yes name=date_du_jour dbname="table_vide.date_du_jour" dbalias=".date_du_jour" )
 column=(type=decimal(5) updatewhereclause=yes name=param_valeur_euro dbname="param.valeur_euro" dbalias=".valeur_euro" )
 column=(type=char(200) updatewhereclause=yes name=param_secu_pour_devis dbname="param.secu_pour_devis" dbalias=".secu_pour_devis" )
 column=(type=char(200) updatewhereclause=yes name=param_contention_pour_devis dbname="param.contention_pour_devis" dbalias=".contention_pour_devis" )
 column=(type=char(1) updatewhereclause=yes name=signature_numerique_1 dbname="table_vide.signature_numerique_1" dbalias=".signature_numerique_1" )
 column=(type=char(1) updatewhereclause=yes name=signature_numerique_2 dbname="table_vide.signature_numerique_2" dbalias=".signature_numerique_2" )
 column=(type=char(1) updatewhereclause=yes name=signature_numerique_3 dbname="table_vide.signature_numerique_3" dbalias=".signature_numerique_3" )
 column=(type=char(2) updatewhereclause=yes name=table_vide_fin_de_ligne dbname="table_vide.fin_de_ligne" dbalias=".fin_de_ligne" )
 retrieve="  SELECT ~"patient~".~"numero_dossier~" as patient_numero,   
		~"patient~".~"code~" as patient_numero_interne, 
         (SELECT titre_personnes.nom from titre_personnes where titre_personnes.code = titre_patient) as patient_titre,   
         ~"patient~".~"nom~" as patient_nom,   
         ~"patient~".~"prenom~" as patient_prenom,   
         ~"patient~".~"sexe~" as patient_sexe,   
         ~"patient~".~"adulte~" as patient_adulte,   
         ~"dossier~".~"nom~" as patient_type_dossier,   
         ~"patient~".~"classe~" as patient_classe,   
         ~"patient~".~"type~" as patient_type,   
         ~"patient~".~"moulage~" as patient_numero_moulage,   
         ~"patient~".~"motif_relance_admini~" as patient_motif_relance,   
         ~"patient~".~"remarques_html~" as patient_remarques_administratives,   
         ~"patient~".~"date_naissance~" as patient_date_naissance,   
         STRING(if month(today()) < month( patient_date_naissance ) then year(today()) - year( patient_date_naissance ) - 1 else year(today()) - year( patient_date_naissance ) endif, ' ans ', if month(today()) < month( patient_date_naissance ) then month(today()) - month( patient_date_naissance ) +12 else month(today()) - month( patient_date_naissance ) endif, ' mois') as patient_age,   
         ~"patient~".~"date_prem_demande~" as patient_date_premiere_demande,   
         ~"patient~".~"date_contact~" as patient_date_premier_contact,   
         ~"patient~".~"premiere_visite~" as patient_date_premiere_visite,   
         ~"patient~".~"relance~" as patient_date_recontact,   
         ~"patient~".~"date_moulage~" as patient_date_moulage,   
         ~"patient~".~"debut_traitement~" as patient_date_debut_traitement,   
         ~"patient~".~"fin_traitement~" as patient_date_fin_traitement,   
         ~"patient~".~"debut_contention~" as patient_date_debut_contention,
         ~"patient~".~"fin_contention~" as patient_date_fin_contention,   
         ~"patient~".~"date_relance_admini~" as patient_date_relance_administrative,   
         ~"patient~".~"date_interruption~" as patient_date_interruption,   
         ~"patient~".~"date_reprise~" as patient_date_reprise,   
         ~"patient~".~"plan_traitement_html~" as patient_plan_de_traitement,   
         ~"patient~".~"plan_complement_html~" as patient_complement_plan_de_traitement,   
         ~"patient~".~"traitement_effectue_html~" as patient_diagnostic,    
         ~"patient~".~"diag_dentaire_html~" as patient_diagnostic_dentaire,   
         ~"patient~".~"diag_fonctionnel_html~" as patient_diagnostic_fonctionnel,   
         ~"patient~".~"diag_alveolaire_html~" as patient_diagnostic_alveolaire,   
         ~"patient~".~"duree_traitement~" as patient_duree_traitement,   
         ~"patient~".~"extraction~" as patient_extraction,   
         ~"patient~".~"dents_soins~" as patient_dents_soins,   
         ~"patient~".~"remarques_cliniques_html~" as patient_remarques_cliniques,   

		(SELECT dateformat(max(rdv), param.format_rdv_courrier) FROM rdv, etat_rdv WHERE rdv <= getdate() and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O'  AND rdv.code = patient.code) as patient_dernier_rdv_passe,  	
		(SELECT jours.nom FROM jours WHERE jours.num =  (SELECT dow(max(rdv)) from rdv, etat_rdv WHERE rdv <= getdate() and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O'  AND rdv.code = patient.code)) as patient_jour_dernier_rdv_passe,  
		(SELECT dateformat(max(rdv), param.format_rdv_courrier) FROM rdv, etat_rdv WHERE rdv <= getdate() and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda = 'O'  AND rdv.code = patient.code) as patient_dernier_rdv_non_honore,  		
		(SELECT jours.nom FROM jours WHERE jours.num =  (SELECT dow(max(rdv)) from rdv, etat_rdv WHERE rdv <= getdate() and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda = 'O'  AND rdv.code = patient.code)) as patient_jour_dernier_rdv_non_honore,  
		(SELECT dateformat(min(rdv), param.format_rdv_courrier) FROM rdv, etat_rdv WHERE rdv >= getdate() and rdv.code = patient.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O') as patient_prochain_rdv,  
		(SELECT jours.nom FROM jours WHERE jours.num =  (SELECT dow(min(rdv)) from rdv, etat_rdv  WHERE rdv >= getdate() AND rdv.code = patient.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O')) as patient_jour_prochain_rdv,  
         ~"patient~".~"portable_patient~" as patient_telephone_portable,   
		~"patient~".~"email_patient~" as patient_email,  
		~"patient~".~"mdp_patient~" as patient_mot_de_passe_portail ,
		~"patient~".~"somme_due~" as patient_somme_due_a_ce_jour,
		~"patient~".~"somme_due~" as patient_somme_due_famille_a_ce_jour,
		~"patient~".~"date_proc_reglt~" as patient_date_prochain_reglement,
		~"patient~".~"mont_proc_reglt~" as patient_montant_prochain_reglement,
		~"patient~".~"nom_assure~" as patient_nom_assure,

		(SELECT sum(montant) from paye where patient.code = paye.code and paye.~"date~" = cast(getdate() as date) and paye.tp = 'N') as patient_montant_paye_ce_jour,


		(SELECT nom from mode_reglement where patient.mode_reglement_habituel = mode_reglement.code) as patient_mode_reglement,
		(SELECT ident from banque where patient.code_banque = banque.code) as patient_nom_banque,
		(SELECT banq1 from banque where patient.code_banque = banque.code) as patient_adresse1_banque,
		(SELECT banq2 from banque where patient.code_banque = banque.code) as patient_adresse2_banque,
		~"patient~".~"iban~" as patient_iban,  
		~"patient~".~"bic~" as patient_bic,  
		~"patient~".~"rum~" as patient_rum,  
		~"patient~".~"date_mandat~" as date_mandat,  
		~"table_vide~".~"v1~" as patient_prochain_rendez_vous,
		~"table_vide~".~"v2~" as patient_duree_prochain_rendez_vous,
		~"table_vide~".~"v3~" as patient_type_prochain_rendez_vous,

		~"table_vide~".~"v1~" as patient_rendez_vous_du_jour,
		~"table_vide~".~"v2~" as patient_duree_rendez_vous_du_jour,
		~"table_vide~".~"v3~" as patient_type_rendez_vous_du_jour,
		~"table_vide~".~"v4~" as patient_jour_rendez_vous_du_jour,


         (SELECT ecole.nom from ecole where ecole.code = patient.ecole) as patient_etablissement_scolaire,   
         ~"patient~".~"classe_scolaire~" as patient_classe_scolaire,   
		(select ( if mise_en_evidence = 'C' then 'CMU' else  if mise_en_evidence = 'M' then 'MGEN' else '' endif endif  )) as patient_cmu_mgen, 
		(select ~"mise_en_evidence~".~"nom~" from ~"mise_en_evidence~" where ~"patient~".~"mise_en_evidence~" = ~"mise_en_evidence~".~"code~") as patient_mise_en_evidence,
		~"patient~".~"date_validite_cmu~" as patient_date_validite_cmu,
		~"patient~".~"secu_patient~" as patient_num_secu,

		 (SELECT max(dat) FROM coment WHERE coment.code = patient.code ) as patient_date_dernier_commentaire_clinique,
		 (SELECT max(com_html)  FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code and dat <= cast(getdate() as date) ) and coment.code = patient.code )  as patient_dernier_commentaire_clinique ,
		 (SELECT max(acte_prevu_html) FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code and dat <= cast(getdate() as date) ) and coment.code = patient.code )  as patient_dernier_acte_prevu ,


         (SELECT caisse.nom from caisse where caisse.code = code_caisse) as caisse_nom,   
         (SELECT caisse.adr1 from caisse where caisse.code = code_caisse) as caisse_adresse1,   
         (SELECT caisse.adr2 from caisse where caisse.code = code_caisse) as caisse_adresse2,   
         (SELECT caisse.codep from caisse where caisse.code = code_caisse) as caisse_codep,   
         (SELECT caisse.ville from caisse where caisse.code = code_caisse) as caisse_ville,   
         (SELECT caisse.pays from caisse where caisse.code = code_caisse) as caisse_pays,   
	
         (SELECT mutuelle.nom from mutuelle where mutuelle.code = code_mutuelle) as mutuelle_nom,   
         (SELECT mutuelle.adr1 from mutuelle where mutuelle.code = code_mutuelle) as mutuelle_adresse1,   
         (SELECT mutuelle.adr2 from mutuelle where mutuelle.code = code_mutuelle) as mutuelle_adresse2,   
         (SELECT mutuelle.codep from mutuelle where mutuelle.code = code_mutuelle) as mutuelle_codep,   
         (SELECT mutuelle.ville from mutuelle where mutuelle.code = code_mutuelle) as mutuelle_ville,   
         (SELECT mutuelle.pays from mutuelle where mutuelle.code = code_mutuelle) as mutuelle_pays,   
	
         (SELECT mutuelle.nom from mutuelle where mutuelle.code = code_mutuelle2) as mutuelle2_nom,   
         (SELECT mutuelle.adr1 from mutuelle where mutuelle.code = code_mutuelle2) as mutuelle2_adresse1,   
         (SELECT mutuelle.adr2 from mutuelle where mutuelle.code = code_mutuelle2) as mutuelle2_adresse2,   
         (SELECT mutuelle.codep from mutuelle where mutuelle.code = code_mutuelle2) as mutuelle2_codep,   
         (SELECT mutuelle.ville from mutuelle where mutuelle.code = code_mutuelle2) as mutuelle2_ville,   
         (SELECT mutuelle.pays from mutuelle where mutuelle.code = code_mutuelle2) as mutuelle2_pays,   

         (SELECT titre_personnes.nom from titre_personnes where titre_personnes.code = titre_parent1) as parent1_titre,   
         ~"patient~".~"nom_parent1~" as parent1_nom,   
         ~"patient~".~"adr1_parent1~" as parent1_adresse1,   
         ~"patient~".~"adr2_parent1~" as parent1_adresse2,   
         ~"patient~".~"codep_parent1~" as parent1_codep,   
         ~"patient~".~"ville_parent1~" as parent1_ville,   
         (SELECT pays.nom from pays where pays.code = pays_parent1) as parent1_pays,   
         ~"patient~".~"teldom_parent1~" as parent1_telephone_domicile,   
		~"patient~".~"teldom2_parent1~" as parent1_telephone_domicile2,   
         ~"patient~".~"teltra_parent1~" as parent1_telephone_travail,   
         ~"patient~".~"teltra2_parent1~" as parent1_telephone_travail2,   
         ~"patient~".~"portable~" as parent1_telephone_portable,   
         ~"patient~".~"portable2_parent1~" as parent1_telephone_portable2,   
         ~"patient~".~"email~" as parent1_email,   
		~"patient~".~"mdp_parent1~" as parent1_mot_de_passe_portail ,
         ~"patient~".~"secu_parent1~" as parent1_num_secu,   
         ~"patient~".~"prof_parent1~" as parent1_profession1,   
         ~"patient~".~"prof2_parent1~" as parent1_profession2,   
         ~"patient~".~"com_parent1~" as parent1_commentaires,   
		
         (SELECT titre_personnes.nom from titre_personnes where titre_personnes.code = titre_parent2) as parent2_titre,   
         ~"patient~".~"nom_parent2~" as parent2_nom,   
         ~"patient~".~"adr1_parent2~" as parent2_adresse1,   
         ~"patient~".~"adr2_parent2~" as parent2_adresse2,   
         ~"patient~".~"codep_parent2~" as parent2_codep,   
         ~"patient~".~"ville_parent2~" as parent2_ville,   
         (SELECT pays.nom from pays where pays.code = pays_parent2) as parent2_pays,   
         ~"patient~".~"teldom_parent2~" as parent2_telephone_domicile,   
         ~"patient~".~"teldom2_parent2~" as parent2_telephone_domicile2,   
         ~"patient~".~"teltra_parent2~" as parent2_telephone_travail,   
         ~"patient~".~"teltra2_parent2~" as parent2_telephone_travail2,   
         ~"patient~".~"portable1_parent2~" as parent2_telephone_portable,   
         ~"patient~".~"portable2_parent2~" as parent2_telephone_portable2,   
         ~"patient~".~"email_parent2~" as parent2_email,   
		~"patient~".~"mdp_parent2~" as parent2_mot_de_passe_portail ,
         ~"patient~".~"secu_parent2~" as parent2_num_secu,   
         ~"patient~".~"prof_parent2~" as parent2_profession1,   
         ~"patient~".~"prof2_parent2~" as parent2_profession2,   
         ~"patient~".~"com_parent2~" as parent2_commentaires,   

         (SELECT titre_personnes.nom from titre_personnes where titre_personnes.code = titre_payeur) as payeur_titre,   
         ~"patient~".~"nom_payeur~" as payeur_nom,   
         ~"patient~".~"adr1_payeur~" as payeur_adresse1,   
         ~"patient~".~"adr2_payeur~" as payeur_adresse2,   
         ~"patient~".~"codep_payeur~" as payeur_codep,   
         ~"patient~".~"ville_payeur~" as payeur_ville,   
         (SELECT pays.nom from pays where pays.code = pays_payeur) as payeur_pays,   
         ~"patient~".~"teldom_payeur~" as payeur_telephone_domicile,   
         ~"patient~".~"teldom2_payeur~" as payeur_telephone_domicile2,   
         ~"patient~".~"teltra_payeur~" as payeur_telephone_travail,   
         ~"patient~".~"teltra2_payeur~" as payeur_telephone_travail2,  
         ~"patient~".~"portable1_payeur~" as payeur_telephone_portable,   
         ~"patient~".~"portable2_payeur~" as payeur_telephone_portable2,   
         ~"patient~".~"email_payeur~" as payeur_email,   
		~"patient~".~"mdp_payeur~" as payeur_mot_de_passe_portail ,
         ~"patient~".~"secu_payeur~" as payeur_num_secu,   
         ~"patient~".~"prof_payeur~" as payeur_profession1,   
         ~"patient~".~"prof2_payeur~" as payeur_profession2,   
         ~"patient~".~"com_payeur~" as payeur_commentaires,   

		(case when ~"nom_payeur~" is null then ~"parent1_titre~" else ~"payeur_titre~" end) as payeur_ou_parent1_titre,   
		(case when ~"nom_payeur~" is null then ~"nom_parent1~" else ~"nom_payeur~" end) as payeur_ou_parent1_nom,   
		(case when ~"nom_payeur~" is null then ~"adr1_parent1~" else ~"adr1_payeur~" end) as payeur_ou_parent1_adresse1,   
		(case when ~"nom_payeur~" is null then ~"adr2_parent1~" else ~"adr2_payeur~" end) as payeur_ou_parent1_adresse2,   
		(case when ~"nom_payeur~" is null then ~"codep_parent1~" else ~"codep_payeur~" end) as payeur_ou_parent1_codep,   
		(case when ~"nom_payeur~" is null then ~"ville_parent1~" else ~"ville_payeur~" end) as payeur_ou_parent1_ville,   
   		(case when ~"nom_payeur~" is null then ~"parent1_pays~" else ~"payeur_pays~" end) as payeur_ou_parent1_pays,   
		(case when ~"nom_payeur~" is null then ~"parent1_telephone_domicile~" else ~"payeur_telephone_domicile~" end) as payeur_ou_parent1_telephone_domicile,   
		(case when ~"nom_payeur~" is null then ~"parent1_telephone_domicile2~" else ~"payeur_telephone_domicile2~" end) as payeur_ou_parent1_telephone_domicile2,   
		(case when ~"nom_payeur~" is null then ~"parent1_telephone_travail~" else ~"payeur_telephone_travail~" end) as payeur_ou_parent1_telephone_travail,   
		(case when ~"nom_payeur~" is null then ~"parent1_telephone_travail2~" else ~"payeur_telephone_travail2~" end) as payeur_ou_parent1_telephone_travail2,   
		(case when ~"nom_payeur~" is null then ~"parent1_telephone_portable~" else ~"payeur_telephone_portable~" end) as payeur_ou_parent1_telephone_portable,   
		(case when ~"nom_payeur~" is null then ~"parent1_telephone_portable2~" else ~"payeur_telephone_portable2~" end) as payeur_ou_parent1_telephone_portable2,   
		(case when ~"nom_payeur~" is null then ~"parent1_email~" else ~"payeur_email~" end) as payeur_ou_parent1_email,   
		(case when ~"nom_payeur~" is null then ~"secu_parent1~" else ~"secu_payeur~" end) as payeur_ou_parent1_num_secu,   

         if patient.assure = '2' then parent2_titre else if patient.assure = '3' then payeur_titre else parent1_titre endif endif as assure_titre,   
         if patient.assure = '4' then patient.nom + ' '+ patient.prenom else if patient.assure = '2' then parent2_nom else if patient.assure = '3' then payeur_nom else parent1_nom endif endif endif as assure_nom,   
         if patient.assure = '2' then parent2_adresse1 else if patient.assure = '3' then payeur_adresse1 else parent1_adresse1 endif endif as assure_adresse1,   
         if patient.assure = '2' then parent2_adresse2 else if patient.assure = '3' then payeur_adresse2 else parent1_adresse2 endif endif as assure_adresse2,   
         if patient.assure = '2' then parent2_codep else if patient.assure = '3' then payeur_codep else parent1_codep endif endif as assure_codep,   
         if patient.assure = '2' then parent2_ville else if patient.assure = '3' then payeur_ville else parent1_ville endif endif as assure_ville,   
         if patient.assure = '2' then parent2_pays else if patient.assure = '3' then payeur_pays else parent1_pays endif endif as assure_pays,   
         if patient.assure = '2' then parent2_telephone_domicile else if patient.assure = '3' then payeur_telephone_domicile else parent1_telephone_domicile endif endif as assure_telephone_domicile,   
		if patient.assure = '2' then parent2_telephone_domicile2 else if patient.assure = '3' then payeur_telephone_domicile2 else parent1_telephone_domicile2 endif endif as assure_telephone_domicile2,   
         if patient.assure = '2' then parent2_telephone_travail else if patient.assure = '3' then payeur_telephone_travail else parent1_telephone_travail endif endif as assure_telephone_travail,   
		if patient.assure = '2' then parent2_telephone_travail2 else if patient.assure = '3' then payeur_telephone_travail2 else parent1_telephone_travail2 endif endif as assure_telephone_travail2,   
		if patient.assure = '4' then patient.portable_patient else if patient.assure = '2' then parent2_telephone_portable else if patient.assure = '3' then payeur_telephone_portable else parent1_telephone_portable endif endif endif as assure_telephone_portable,   
		if patient.assure = '2' then parent2_telephone_portable2 else if patient.assure = '3' then payeur_telephone_portable2 else parent1_telephone_portable2 endif endif as assure_telephone_portable2,   
		if patient.assure = '4' then patient.email_patient else if patient.assure = '2' then parent2_email else if patient.assure = '3' then payeur_email else parent1_email endif endif endif as assure_email,   
         if patient.assure = '4' then patient.secu_patient else if patient.assure = '2' then parent2_num_secu else if patient.assure = '3' then payeur_num_secu else parent1_num_secu endif endif endif as assure_num_secu,   

         (SELECT titre_personnes.nom from correspondants, titre_personnes where correspondants.code = code_correspondant AND titre_personnes.code = correspondants.titre) as correspondant_titre,   
         (SELECT correspondants.nom from correspondants where correspondants.code = code_correspondant) as correspondant_nom,   
         (SELECT correspondants.prenom from correspondants where correspondants.code = code_correspondant) as correspondant_prenom,   
         (SELECT correspondants.adr1 from correspondants where correspondants.code = code_correspondant) as correspondant_adresse1,   
         (SELECT correspondants.adr2 from correspondants where correspondants.code = code_correspondant) as correspondant_adresse2,   
         (SELECT correspondants.codep from correspondants where correspondants.code = code_correspondant) as correspondant_codep,   
         (SELECT correspondants.ville from correspondants where correspondants.code = code_correspondant) as correspondant_ville,   
         (SELECT pays.nom from correspondants, pays where  correspondants.code = code_correspondant AND pays.code = correspondants.pays) as correspondant_pays,   
         (SELECT correspondants.tel from correspondants where correspondants.code = code_correspondant) as correspondant_telephone,   
         (SELECT correspondants.email from correspondants where correspondants.code = code_correspondant) as correspondant_email,   
         (SELECT correspondants.mdp_correspondant from correspondants where correspondants.code = code_correspondant) as correspondant_mot_de_passe_portail,   
         (SELECT correspondants.formule_politesse from correspondants where correspondants.code = code_correspondant) as correspondant_formule_de_politesse,   
         (SELECT correspondants.sexe from correspondants where correspondants.code = code_correspondant) as correspondant_sexe,   
         (SELECT correspondants.relation from correspondants where correspondants.code = code_correspondant) as correspondant_relation,   
         (SELECT categories.nom from correspondants, categories where correspondants.code = code_correspondant AND categories.code = correspondants.categorie) as correspondant_categorie,   


         (SELECT titre_personnes.nom from correspondants, titre_personnes where correspondants.code = code_dentiste AND titre_personnes.code = correspondants.titre) as dentiste_titre,   
         (SELECT correspondants.nom from correspondants where correspondants.code = code_dentiste ) as dentiste_nom,   
         (SELECT correspondants.prenom from correspondants where correspondants.code = code_dentiste ) as dentiste_prenom,   
         (SELECT correspondants.adr1 from correspondants where correspondants.code = code_dentiste ) as dentiste_adresse1,   
         (SELECT correspondants.adr2 from correspondants where correspondants.code = code_dentiste ) as dentiste_adresse2,   
         (SELECT correspondants.codep from correspondants where correspondants.code = code_dentiste ) as dentiste_codep,   
         (SELECT correspondants.ville from correspondants where correspondants.code = code_dentiste ) as dentiste_ville,   
         (SELECT pays.nom from correspondants, pays where  correspondants.code = code_dentiste AND pays.code = correspondants.pays) as dentiste_pays,   
         (SELECT correspondants.tel from correspondants where correspondants.code = code_dentiste ) as dentiste_telephone,   
         (SELECT correspondants.email from correspondants where correspondants.code = code_dentiste) as dentiste_email,   
         (SELECT correspondants.mdp_correspondant from correspondants where correspondants.code = code_dentiste) as dentiste_mot_de_passe_portail,   
         (SELECT correspondants.formule_politesse from correspondants where correspondants.code = code_dentiste) as dentiste_formule_de_politesse,   
         (SELECT correspondants.sexe from correspondants where correspondants.code = code_dentiste) as  dentiste_sexe,   
         (SELECT correspondants.relation from correspondants where correspondants.code = code_dentiste) as  dentiste_relation,   
         (SELECT categories.nom from correspondants, categories where correspondants.code = code_dentiste AND categories.code = correspondants.categorie) as dentiste_categorie,   

         (SELECT titre_personnes.nom from correspondants, titre_personnes where correspondants.code = code_medecin AND titre_personnes.code = correspondants.titre) as autre_dentiste_titre,   
         (SELECT correspondants.nom from correspondants where correspondants.code = code_medecin ) as autre_dentiste_nom,   
         (SELECT correspondants.prenom from correspondants where correspondants.code = code_medecin ) as autre_dentiste_prenom,   
         (SELECT correspondants.adr1 from correspondants where correspondants.code = code_medecin ) as autre_dentiste_adresse1,   
         (SELECT correspondants.adr2 from correspondants where correspondants.code = code_medecin ) as autre_dentiste_adresse2,   
         (SELECT correspondants.codep from correspondants where correspondants.code = code_medecin ) as autre_dentiste_codep,   
         (SELECT correspondants.ville from correspondants where correspondants.code = code_medecin ) as autre_dentiste_ville,   
         (SELECT pays.nom from correspondants, pays where  correspondants.code = code_medecin AND pays.code = correspondants.pays) as autre_dentiste_pays,   
         (SELECT correspondants.tel from correspondants where correspondants.code = code_medecin ) as autre_dentiste_telephone,   
         (SELECT correspondants.email from correspondants where correspondants.code = code_medecin) as autre_dentiste_email,   
         (SELECT correspondants.mdp_correspondant from correspondants where correspondants.code = code_medecin) as autre_dentiste_mot_de_passe_portail,   
         (SELECT correspondants.formule_politesse from correspondants where correspondants.code = code_medecin) as autre_dentiste_formule_de_politesse,   
         (SELECT correspondants.sexe from correspondants where correspondants.code = code_medecin) as  autre_dentiste_sexe,   
         (SELECT correspondants.relation from correspondants where correspondants.code = code_medecin) as  autre_dentiste_relation,   
         (SELECT categories.nom from correspondants, categories where correspondants.code = code_medecin AND categories.code = correspondants.categorie) as autre_dentiste_categorie,   

		'{confrere_titre}' as confrere_titre,
		'{confrere_nom}' as confrere_nom,
		'{confrere_prenom}' as confrere_prenom,
		'{confrere_adresse1}' as confrere_adresse1,
		'{confrere_adresse2}' as confrere_adresse2,
		'{confrere_codep}' as confrere_codep,
		'{confrere_ville}' as confrere_ville,
		'{confrere_pays}' as confrere_pays,
		'{confrere_formule_politesse}' as confrere_formule_politesse,
		'{confrere_telephone}' as confrere_telephone,
		'{confrere_portable}' as confrere_portable,
		'{confrere_email}' as confrere_email,

         ~"prati~".~"code~" as praticien_code,   
         ~"prati~".~"nom~" as praticien_nom,   
         ~"prati~".~"prenom~" as praticien_prenom,   
         ~"prati~".~"adresse1~" as praticien_adresse1,   
         ~"prati~".~"adresse2~" as praticien_adresse2,   
         ~"prati~".~"code_postal~" as praticien_code_postal,   
         ~"prati~".~"ville~" as praticien_ville,   
         ~"prati~".~"telephone~" as praticien_telephone,   
         ~"prati~".~"email~" as praticien_email,   
         ~"prati~".~"site_internet~" as praticien_site_internet,   
       	~"prati~".~"chemin_complet_entete~" as praticien_entete,   
         ~"prati~".~"chemin_complet_bas_page~" as praticien_bas_page,   
         ~"prati~".~"nom_carte_cps~" as praticien_inami,   
         ~"prati~".~"identifiant_rpps~" as praticien_identifiant_rpps,   
         ~"prati~".~"nom_structure~" as praticien_identification_structure,   
         ~"prati~".~"numero_structure~" as praticien_numero_structure,   
         ~"prati~".~"duree_validite_devis~" as praticien_duree_validite_devis_conventionnel,   
         ~"prati~".~"institution_perceptrice~" as praticien_institution,   
         ~"prati~".~"nom_remplacant~" as praticien_remplacant_nom,   
         ~"prati~".~"identifiant_remplacant~" as praticien_remplacant_identifiant,   
         ~"prati~".~"chemin_complet_logo~" as praticien_logo,   
         ~"prati~".~"chemin_complet_logo2~" as praticien_logo2,   
         ~"prati~".~"chemin_complet_logo3~" as praticien_logo3,   
         ~"prati~".~"chemin_complet_signature~" as praticien_signature,   

		(SELECT ident from banque where prati.banque = banque.code) as praticien_nom_banque,
		(SELECT banq1 from banque where prati.banque = banque.code) as praticien_adresse1_banque,
		(SELECT banq2 from banque where prati.banque = banque.code) as praticien_adresse2_banque,
		(SELECT rib from banque where prati.banque = banque.code) as praticien_rib_banque,
		(SELECT bic from banque where prati.banque = banque.code) as praticien_bic_banque,
		(SELECT ics from banque where prati.banque = banque.code) as praticien_ics_banque,
		(SELECT iban from banque where prati.banque = banque.code) as praticien_iban_banque,

		~"table_vide~".~"v4~" as date_du_jour,
         ~"param~".~"euro~" as valeur_euro,   
         ~"param~".~"parag_secu_devis~" as secu_pour_devis,   
         ~"param~".~"parag_content_devis~" as contention_pour_devis,   

		~"table_vide~".~"v1~" as signature_numerique_1,
		~"table_vide~".~"v2~" as signature_numerique_2,
		~"table_vide~".~"v3~" as signature_numerique_3,

         ~"table_vide~".~"fin_ligne_export~" as fin_de_ligne  
    FROM ~"patient~",
         ~"dossier~",   
         ~"prati~",   
         ~"param~",   
         ~"table_vide~"  
   WHERE ( ~"dossier~".~"code~" = ~"patient~".~"type_dossier~" ) and  
         ( ~"prati~".~"code~" = ~"patient~".~"code_praticien~" ) and  
         ( ( ~"patient~".~"code~" in ( :liste_codes ) ) )    
" arguments=(("liste_codes", numberlist))  sort="patient_patient_nom A patient_patient_prenom A patient_patient_numero A patient_numero_interne A " )
