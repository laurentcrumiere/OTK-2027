table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(40) updatewhereclause=yes name=codes_editions_nom dbname="codes_editions.nom" )
 column=(type=date updatewhereclause=yes name=date_document dbname="historique_editions.date_document" )
 column=(type=datetime updatewhereclause=yes name=historique_editions_date_modif dbname="historique_editions.date_modif" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(200) updatewhereclause=yes name=historique_editions_libelle dbname="historique_editions.libelle" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(30) updatewhereclause=yes name=utilisateurs_nom dbname="utilisateurs.nom" )
 column=(type=char(1) updatewhereclause=yes name=historique_editions_nature dbname="historique_editions.nature" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(1) updatewhereclause=yes name=historique_editions_invisible dbname="historique_editions.invisible" )
 column=(type=char(6) updatewhereclause=yes name=historique_editions_code_courrier dbname="historique_editions.code_courrier" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"codes_editions~" )  TABLE(NAME=~"historique_editions~" )  TABLE(NAME=~"utilisateurs~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"codes_editions.nom~") COLUMN(NAME=~"historique_editions.date_document~") COLUMN(NAME=~"historique_editions.date_modif~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"historique_editions.libelle~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"utilisateurs.nom~") COLUMN(NAME=~"historique_editions.nature~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"historique_editions.invisible~") COLUMN(NAME=~"historique_editions.code_courrier~")    JOIN (LEFT=~"historique_editions.user_modif~"    OP =~"=~"RIGHT=~"utilisateurs.code~" )    JOIN (LEFT=~"historique_editions.code_courrier~"    OP =~"=~"RIGHT=~"codes_editions.code~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"historique_editions.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"codes_editions~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":type_min and :type_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"historique_editions~~~".~~~"date_modif~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"historique_editions~~~".~~~"user_modif~~~"~"   OP =~"between~"    EXP2 =~":user_min and :user_max~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"type_min~" TYPE = string)  ARG(NAME = ~"type_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = datetime)  ARG(NAME = ~"date_max~" TYPE = datetime)  ARG(NAME = ~"user_min~" TYPE = string)  ARG(NAME = ~"user_max~" TYPE = string) " filter=" historique_editions_invisible <> 'O' or isnull( historique_editions_invisible )"arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("type_min", string),("type_max", string),("date_min", datetime),("date_max", datetime),("user_min", string),("user_max", string))  sort="historique_editions_date_modif A numero_dossier A " )
