table(column=(type=date updatewhereclause=yes name=efacture_belgique_date_facture dbname="efacture_belgique.date_facture" )
 column=(type=decimal(0) updatewhereclause=yes name=efacture_belgique_numero_facture dbname="efacture_belgique.numero_facture" )
 column=(type=char(3) updatewhereclause=yes name=efacture_belgique_code_oa_destination dbname="efacture_belgique.code_oa_destination" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_facture dbname="montant_facture" )
 column=(type=char(1) updatewhereclause=yes name=efacture_belgique_statut_my_carenet dbname="efacture_belgique.statut_my_carenet" values="Non envoyée	 /Envoyée	E/A renvoyer	A/Validée	V/Refusée	R/Rejet Informatif	I/Reçue par l'OA	U/" )
 column=(type=char(6) updatewhereclause=yes name=efacture_belgique_code_praticien dbname="efacture_belgique.code_praticien" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=char(3) updatewhereclause=yes name=organismes_assureurs_belgique_envoi dbname="organismes_assureurs_belgique.envoi" )
 column=(type=char(1) updatewhereclause=yes name=efacture_belgique_type_facture dbname="efacture_belgique.type_facture" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"efacture_belgique~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"organismes_assureurs_belgique~" ) COLUMN(NAME=~"efacture_belgique.date_facture~") COLUMN(NAME=~"efacture_belgique.numero_facture~") COLUMN(NAME=~"efacture_belgique.code_oa_destination~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.numero_dossier~") COMPUTE(NAME=~"(select sum(montant_rembourse_oa) from ligne_efacture_belgique where ligne_efacture_belgique.numero_facture = efacture_belgique.numero_facture and  ligne_efacture_belgique.type_facture = efacture_belgique.type_facture ) as montant_facture~") COLUMN(NAME=~"efacture_belgique.statut_my_carenet~") COLUMN(NAME=~"efacture_belgique.code_praticien~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"organismes_assureurs_belgique.envoi~") COLUMN(NAME=~"efacture_belgique.type_facture~")    JOIN (LEFT=~"efacture_belgique.code_patient~"    OP =~"=~"RIGHT=~"patient.code~"    OUTER1 =~"efacture_belgique.code_patient~" )    JOIN (LEFT=~"efacture_belgique.code_oa_destination~"    OP =~"=~"RIGHT=~"organismes_assureurs_belgique.code~" )WHERE(    EXP1 =~"~~~"efacture_belgique~~~".~~~"date_facture~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"efacture_belgique~~~".~~~"code_oa_destination~~~"~"   OP =~"between~"    EXP2 =~":oa_min and :oa_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"efacture_belgique~~~".~~~"statut_my_carenet~~~"~"   OP =~"between~"    EXP2 =~":statut_min and :statut_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"efacture_belgique~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~" ) ) ARG(NAME = ~"oa_min~" TYPE = string)  ARG(NAME = ~"oa_max~" TYPE = string)  ARG(NAME = ~"statut_min~" TYPE = string)  ARG(NAME = ~"statut_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string) " arguments=(("oa_min", string),("oa_max", string),("statut_min", string),("statut_max", string),("date_min", date),("date_max", date),("prat_min", string),("prat_max", string))  sort="organismes_assureurs_belgique_envoi A efacture_belgique_code_oa_destination A efacture_belgique_date_facture A efacture_belgique_numero_facture A " )
