table(column=(type=decimal(0) updatewhereclause=yes name=numero_memoire dbname="ememoire_luxembourg.numero_memoire" dbalias=".numero_memoire" )
 column=(type=date updatewhereclause=yes name=date dbname="ememoire_luxembourg.date" dbalias=".date" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(1) updatewhereclause=yes name=etat dbname="ememoire_luxembourg.etat" dbalias=".etat" values="Non simulé	N/Simulation OK	S/Simulation non OK	K/Validation OK	V/Validation non OK	L/Annulation auto	A/Contestation	C/Annulation man.	M/" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="ememoire_luxembourg.code_praticien" dbalias=".code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=decimal(2) updatewhereclause=yes name=total_montant_caisse dbname="total_montant_caisse" )
 column=(type=decimal(2) updatewhereclause=yes name=total_montant_patient dbname="total_montant_patient" )
 column=(type=decimal(2) updatewhereclause=yes name=total_montant_total dbname="total_montant_total" )
 column=(type=char(1) updatewhereclause=yes name=etat_rd dbname="ememoire_luxembourg.etat_rd" dbalias=".etat_rd" values="Non envoyé	N/Envoyé	E/Annulé	/" )
 retrieve="  SELECT ~"ememoire_luxembourg~".~"numero_memoire~",   
         ~"ememoire_luxembourg~".~"date~",   
         ~"patient~".~"nom~",   
         ~"patient~".~"prenom~",   
         ~"ememoire_luxembourg~".~"etat~",   
         ~"ememoire_luxembourg~".~"code_praticien~",   
         ~"patient~".~"numero_dossier~",   
         ~"patient~".~"code~",   
         (select sum(montant_caisse) from ligne_ememoire_luxembourg where ememoire_luxembourg.numero_memoire = ligne_ememoire_luxembourg.numero_memoire) as total_montant_caisse,   
         (select sum(montant_patient) from ligne_ememoire_luxembourg where ememoire_luxembourg.numero_memoire = ligne_ememoire_luxembourg.numero_memoire) as total_montant_patient,   
         (select sum(montant_total) from ligne_ememoire_luxembourg where ememoire_luxembourg.numero_memoire = ligne_ememoire_luxembourg.numero_memoire) as total_montant_total,   
         ~"ememoire_luxembourg~".~"etat_rd~"  
    FROM ~"ememoire_luxembourg~",   
         ~"patient~"  
   WHERE ( ~"ememoire_luxembourg~".~"code_patient~" = ~"patient~".~"code~" ) and  
         ( ( ~"ememoire_luxembourg~".~"code_praticien~" between :prat_min and :prat_max ) AND  
         ( ~"ememoire_luxembourg~".~"date~" between :date_min and :date_max ) AND  
         ( ~"patient~".~"numero_dossier~" between :dossier_min and :dossier_max ) )    
" arguments=(("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("dossier_min", number),("dossier_max", number))  sort="date A numero_memoire A " )
