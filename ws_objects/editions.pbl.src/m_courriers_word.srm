on m_courriers_word.create
m_courriers_word=this
call super::create
this.text = "m_courriers_word"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_ajouterundossier=create m_ajouterundossier
this.m_ajouterundocument=create m_ajouterundocument
this.m_modifier_element=create m_modifier_element
this.m_modifier_modele=create m_modifier_modele
this.m_supprimer_element=create m_supprimer_element
this.m_dupliquerlélément=create m_dupliquerlélément
this.Item[UpperBound(this.Item)+1]=this.m_ajouterundossier
this.Item[UpperBound(this.Item)+1]=this.m_ajouterundocument
this.Item[UpperBound(this.Item)+1]=this.m_modifier_element
this.Item[UpperBound(this.Item)+1]=this.m_modifier_modele
this.Item[UpperBound(this.Item)+1]=this.m_supprimer_element
this.Item[UpperBound(this.Item)+1]=this.m_dupliquerlélément
end on

on m_courriers_word.destroy
call super::destroy
destroy(this.m_ajouterundossier)
destroy(this.m_ajouterundocument)
destroy(this.m_modifier_element)
destroy(this.m_modifier_modele)
destroy(this.m_supprimer_element)
destroy(this.m_dupliquerlélément)
end on

