 retrieve="  SELECT DISTINCT ~"soins~".~"date_demande~",   
         ~"soins~".~"scp_demande~",   
         ~"soins~".~"numero~",   
         ~"patient~".~"nom~",   
         ~"patient~".~"nom_parent1~",   
         ~"patient~".~"secu_parent1~",   
         ~"patient~".~"nom_parent2~",   
         ~"patient~".~"secu_parent2~",   
         ~"patient~".~"nom_payeur~",   
         ~"patient~".~"secu_payeur~",   
         ~"patient~".~"debut_traitement~",   
         ~"prati~".~"typort~",   
         ~"param~".~"payassu~",   
         ~"prati~".~"entete~",   
         ~"prati~".~"cadre_entete~",   
         ~"patient~".~"date_naissance~",   
         ~"patient~".~"plan_traitement~",   
         ~"patient~".~"prenom~",   
         ~"patient~".~"basal_max_pro~",   
         ~"patient~".~"basal_max_retro~",   
         ~"patient~".~"basal_mand_pro~",   
         ~"patient~".~"basal_mand_retro~",   
         ~"patient~".~"basal_max_endo~",   
         ~"patient~".~"basal_max_exo~",   
         ~"patient~".~"basal_mand_endo~",   
         ~"patient~".~"basal_mand_exo~",   
         ~"patient~".~"hypodivergence~",   
         ~"patient~".~"hyperdivergence~",   
         ~"patient~".~"alveo_max_pro~",   
         ~"patient~".~"alveo_max_retro~",   
         ~"patient~".~"alveo_mand_pro~",   
         ~"patient~".~"alveo_mand_retro~",   
         ~"patient~".~"alveo_max_endo~",   
         ~"patient~".~"alveo_max_exo~",   
         ~"patient~".~"alveo_mand_endo~",   
         ~"patient~".~"alveo_mand_exo~",   
         ~"patient~".~"supraclusion~",   
         ~"patient~".~"infraclusion~",   
         ~"patient~".~"mol_cl1~",   
         ~"patient~".~"mol_cl2~",   
         ~"patient~".~"mol_cl3~",   
         ~"patient~".~"can_cl1~",   
         ~"patient~".~"can_cl2~",   
         ~"patient~".~"can_cl3~",   
         ~"patient~".~"molaire~",   
         ~"patient~".~"canine~",   
         ~"patient~".~"dento_max~",   
         ~"patient~".~"dento_dent~",   
         ~"patient~".~"occl_dte~",   
         ~"patient~".~"occl_gche~",   
         ~"patient~".~"occl_ant~",   
         ~"code_soins~".~"nom~",   
         ~"code_soins~".~"renouvt~",   
         ( datediff (year ,  ~"date_naissance~", CURRENT DATE ) ) AS AGE,   
         ~"patient~".~"assure~",   
         ~"patient~".~"devis_remis~",   
         ~"param_secu~".~"renouv_date_x~",   
         ~"param_secu~".~"renouv_date_y~",   
         ~"patient~".~"plan_imprime~",   
         ~"param_secu~".~"renouv_r_x~",   
         ~"param_secu~".~"renouv_r_y~",   
         ~"param_secu~".~"renouv_hr_x~",   
         ~"param_secu~".~"renouv_hr_y~",   
         ~"patient~".~"agenesie~",   
         ~"patient~".~"surnum~",   
         ~"patient~".~"malposition~",   
         ~"patient~".~"facteur~",   
         ~"soins~".~"type~",   
         ~"patient~".~"dep_imprime~",   
         ~"code_soins~".~"lettre~",   
         ~"patient~".~"commentaire~",   
         ~"prati~".~"institution_perceptrice~",   
         ~"param_secu~".~"renouv_date_jour~",   
         ~"patient~".~"secu_patient~",   
         ~"prati~".~"nom~" as nom_praticien,   
         ~"prati~".~"numero_structure~",   
         ~"caisse~".~"nom~",   
         ~"code_soins~".~"decomposition~"   
    FROM ~"soins~",   
         ~"patient~",   
         ~"prati~",   
         ~"param~",   
         ~"code_soins~",   
         ~"param_secu~",   
         ~"caisse~"  
   WHERE ( ~"patient~".~"code~" = ~"soins~".~"code~" ) and  
         ( ~"prati~".~"code~" = ~"patient~".~"code_praticien~" ) and  
         ( ~"code_soins~".~"code~" = ~"soins~".~"type~" ) and  
         ( ~"patient~".~"code_caisse~" = ~"caisse~".~"code~" ) and  
         ( ( ~"soins~".~"code~" = :numero_dossier ) AND  
         ( ~"soins~".~"cle~" = :cle_soins ) )    
" filter="/*( soins_type = 'S' )  or ( soins_type  = 'C' ) or ( soins_type = 'D' and  soins_scp_demande = 10 )*/
 code_soins_renouvt = 'O'"arguments=(("numero_dossier", number),("cle_soins", number)) )
