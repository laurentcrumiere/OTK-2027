table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(40) updatewhereclause=yes name=codes_editions_nom dbname="codes_editions.nom" dbalias=".nom" )
 column=(type=date updatewhereclause=yes name=historique_editions_date_document dbname="historique_editions.date_document" dbalias=".date_document" )
 column=(type=datetime updatewhereclause=yes name=historique_editions_date_modif dbname="historique_editions.date_modif" dbalias=".date_modif" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(500) updatewhereclause=yes name=historique_editions_libelle dbname="historique_editions.libelle" dbalias=".libelle" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(1) updatewhereclause=yes name=historique_editions_nature dbname="historique_editions.nature" dbalias=".nature" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(1) updatewhereclause=yes name=historique_editions_invisible dbname="historique_editions.invisible" dbalias=".invisible" )
 column=(type=datetime updatewhereclause=yes name=patient_prochain_rdv dbname="patient_prochain_rdv" )
 column=(type=datetime updatewhereclause=yes name=patient_dernier_rdv dbname="patient_dernier_rdv" )
 column=(type=char(150) updatewhereclause=yes name=historique_editions_nom_courrier dbname="historique_editions.nom_courrier" dbalias=".nom_courrier" )
 column=(type=char(6) updatewhereclause=yes name=historique_editions_code_courrier dbname="historique_editions.code_courrier" dbalias=".code_courrier" )
 column=(type=number updatewhereclause=yes name=historique_editions_code dbname="historique_editions.code" dbalias=".code" )
 column=(type=char(1) update=yes updatewhereclause=yes name=a_lire dbname="historique_editions.a_lire" dbalias=".a_lire" )
 column=(type=char(6) updatewhereclause=yes name=historique_editions_user_modif dbname="historique_editions.user_modif" dbalias=".user_modif" )
 column=(type=char(1) updatewhereclause=yes name=historique_editions_public_web_patient dbname="historique_editions.public_web_patient" dbalias=".public_web_patient" )
 column=(type=number updatewhereclause=yes name=historique_editions_id_doc_cloud dbname="historique_editions.id_doc_cloud" dbalias=".id_doc_cloud" )
 column=(type=char(2) updatewhereclause=yes name=historique_editions_statut_signature dbname="historique_editions.statut_signature" dbalias=".statut_signature" )
 column=(type=char(75) updatewhereclause=yes name=historique_editions_code_interne dbname="historique_editions.code_interne" dbalias=".code_interne" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"codes_editions~" )  TABLE(NAME=~"historique_editions~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"codes_editions.nom~") COLUMN(NAME=~"historique_editions.date_document~") COLUMN(NAME=~"historique_editions.date_modif~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"historique_editions.libelle~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"historique_editions.nature~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"historique_editions.invisible~") COMPUTE(NAME=~"(SELECT min(rdv) as patient_prochain_rdv  FROM rdv, etat_rdv WHERE rdv > getdate() and rdv.code = patient.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' )~") COMPUTE(NAME=~"(SELECT max(rdv) as patient_dernier_rdv  FROM rdv, etat_rdv WHERE rdv < getdate() and rdv.code = patient.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' )~") COLUMN(NAME=~"historique_editions.nom_courrier~") COLUMN(NAME=~"historique_editions.code_courrier~") COLUMN(NAME=~"historique_editions.code~") COLUMN(NAME=~"historique_editions.a_lire~") COLUMN(NAME=~"historique_editions.user_modif~") COLUMN(NAME=~"historique_editions.public_web_patient~") COLUMN(NAME=~"historique_editions.id_doc_cloud~") COLUMN(NAME=~"historique_editions.statut_signature~") COLUMN(NAME=~"historique_editions.code_interne~")    JOIN (LEFT=~"historique_editions.code_courrier~"    OP =~"=~"RIGHT=~"codes_editions.code~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"historique_editions.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cast(~~~"historique_editions~~~".~~~"date_document~~~" as date)~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"historique_editions~~~".~~~"statut_signature~~~"~"   OP =~"in~"    EXP2 =~"('A1', 'A2', 'A3')~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " filter=" historique_editions_invisible <> 'O' or isnull( historique_editions_invisible )"arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date))  sort="historique_editions_date_document A nom_prenom A numero_dossier A historique_editions_date_modif A " )
