 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"correspondants~" )  TABLE(NAME=~"dossier~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"patient.cmu~") COLUMN(NAME=~"patient.classe~") COLUMN(NAME=~"patient.type~") COLUMN(NAME=~"patient.date_relance_admini~") COLUMN(NAME=~"patient.motif_relance_admini~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.portable_patient~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.teldom2_parent1~") COLUMN(NAME=~"patient.teltra2_parent1~") COLUMN(NAME=~"patient.portable2_parent1~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_parent2~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"correspondants.code~"    OP =~"=~"RIGHT=~"patient.code_correspondant~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )WHERE(    EXP1 =~"( ( ~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"patient~~~".~~~"date_relance_admini~~~"~"   OP =~"between~"    EXP2 =~":da1 and :da2 ) )~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"da1~" TYPE = date)  ARG(NAME = ~"da2~" TYPE = date) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("da1", date),("da2", date))  sort="nom A patient_prenom A " )
