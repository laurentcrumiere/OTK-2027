table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=decimal(2) updatewhereclause=yes name=somme_due dbname="patient.somme_due" dbalias=".somme_due" )
 column=(type=date updatewhereclause=yes name=date_proc_reglt dbname="patient.date_proc_reglt" dbalias=".date_proc_reglt" )
 column=(type=decimal(2) updatewhereclause=yes name=mont_proc_reglt dbname="patient.mont_proc_reglt" dbalias=".mont_proc_reglt" )
 column=(type=datetime updatewhereclause=yes name=proc_rdv dbname="patient.proc_rdv" dbalias=".proc_rdv" )
 column=(type=char(30) updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(80) updatewhereclause=yes name=prati_entete dbname="prati.entete" dbalias=".entete" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=date updatewhereclause=yes name=cdate_jour dbname="date_jour" )
 column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" dbalias=".rdv" initial="today" )
 column=(type=char(16) updatewhereclause=yes name=date_rdv dbname="date_rdv" )
 column=(type=char(16) updatewhereclause=yes name=date_rdv2 dbname="date_rdv2" )
 column=(type=char(16) updatewhereclause=yes name=date_rdv3 dbname="date_rdv3" )
 column=(type=char(16) updatewhereclause=yes name=date_rdv4 dbname="date_rdv4" )
 column=(type=char(16) updatewhereclause=yes name=date_rdv5 dbname="date_rdv5" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(20) updatewhereclause=yes name=titre_parent1 dbname="titre_personnes.nom" dbalias=".nom" )
 column=(type=char(200) updatewhereclause=yes name=rdv_commentaire dbname="rdv.commentaire" dbalias=".commentaire" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(1) updatewhereclause=yes name=mois_annee_prochain_reglement dbname="mois_annee_prochain_reglement" )
 column=(type=char(1) updatewhereclause=yes name=somme_due_date_rdv dbname="table_vide.v1" dbalias=".v1" )
 column=(type=number updatewhereclause=yes identity=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(16) updatewhereclause=yes name=date_rdv6 dbname="date_rdv6" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.somme_due~") COLUMN(NAME=~"patient.date_proc_reglt~") COLUMN(NAME=~"patient.mont_proc_reglt~") COLUMN(NAME=~"patient.proc_rdv~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.bas_page~") COMPUTE(NAME=~"cast(getdate() as date) as date_jour~") COLUMN(NAME=~"rdv.rdv~") COMPUTE(NAME=~"dateformat(~~~"rdv~~~".~~~"rdv~~~",'dd/mm/yyyy hh:mm') As Date_rdv~") COMPUTE(NAME=~"dateformat(~~~"rdv~~~".~~~"rdv~~~",'dd/mm/yyyy hh:mm') As Date_rdv2~") COMPUTE(NAME=~"dateformat(~~~"rdv~~~".~~~"rdv~~~",'dd/mm/yyyy hh:mm') As Date_rdv3~") COMPUTE(NAME=~"dateformat(~~~"rdv~~~".~~~"rdv~~~",'dd/mm/yyyy hh:mm') As Date_rdv4~") COMPUTE(NAME=~"dateformat(~~~"rdv~~~".~~~"rdv~~~",'dd/mm/yyyy hh:mm') As Date_rdv5~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"titre_personnes.nom~") COLUMN(NAME=~"rdv.commentaire~") COLUMN(NAME=~"patient.numero_dossier~") COMPUTE(NAME=~"'' as Mois_Annee_Prochain_Reglement~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"patient.code~") COMPUTE(NAME=~"dateformat(~~~"rdv~~~".~~~"rdv~~~",'dd/mm/yyyy hh:mm') As Date_rdv6~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"patient.titre_parent1~"    OP =~"=~"RIGHT=~"titre_personnes.code~"    OUTER1 =~"patient.titre_parent1~" )    JOIN (LEFT=~"rdv.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"rdv.code~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"rdv~~~"~"   OP =~"=~"    EXP2 =~":date_rdv~" ) ) ARG(NAME = ~"nocode~" TYPE = number)  ARG(NAME = ~"date_rdv~" TYPE = datetime) " arguments=(("nocode", number),("date_rdv", datetime)) )
