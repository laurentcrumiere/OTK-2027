table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" )
 column=(type=date update=yes updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" )
 column=(type=date updatewhereclause=yes name=fin_traitement dbname="patient.fin_traitement" )
 column=(type=date updatewhereclause=yes name=date_moulage dbname="patient.date_moulage" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" )
 column=(type=char(6) updatewhereclause=yes name=soins_code_praticien dbname="soins.code_praticien" )
 column=(type=decimal(2) updatewhereclause=yes name=total_paye dbname="total_paye" )
 column=(type=decimal(2) updatewhereclause=yes name=total_espece dbname="total_espece" )
 column=(type=decimal(2) updatewhereclause=yes name=total_virement dbname="total_virement" )
 column=(type=decimal(2) updatewhereclause=yes name=total_carte dbname="total_carte" )
 column=(type=decimal(2) updatewhereclause=yes name=total_autres dbname="total_autres" )
 column=(type=date updatewhereclause=yes name=soins_date_fs dbname="soins.date_fs" )
 column=(type=char(100) updatewhereclause=yes name=soins_ar_eattest dbname="soins.ar_eattest" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.fin_traitement~") COLUMN(NAME=~"patient.date_moulage~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"soins.code_praticien~") COMPUTE(NAME=~"(select sum(montant) as total_paye from paye where soins.cle = paye.cle and soins.code = paye.code)~") COMPUTE(NAME=~"(select sum(montant) as total_espece from paye where soins.cle = paye.cle and soins.code = paye.code and ~~~"mode~~~" = 'E')~") COMPUTE(NAME=~"(select sum(montant) as total_virement from paye where soins.cle = paye.cle and soins.code = paye.code and ~~~"mode~~~" = 'V')~") COMPUTE(NAME=~"(select sum(montant) as total_carte from paye where soins.cle = paye.cle and soins.code = paye.code and ~~~"mode~~~" = 'B')~") COMPUTE(NAME=~"(select sum(montant) as total_autres from paye where soins.cle = paye.cle and soins.code = paye.code and ~~~"mode~~~" not in('V', 'B',  'E'))~") COLUMN(NAME=~"soins.date_fs~") COLUMN(NAME=~"soins.ar_eattest~")    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_fs~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"ar_eattest~~~"~"   OP =~"is not~"    EXP2 =~"null~" ) ) ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("date_min", date),("date_max", date))  sort="soins_date_fs A soins_ar_eattest A " )
