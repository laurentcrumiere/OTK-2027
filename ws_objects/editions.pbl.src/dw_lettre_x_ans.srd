table(column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=date update=yes updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" dbalias=".type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" dbalias=".code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" dbalias=".premiere_visite" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" dbalias=".relance" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(35) updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=decimal(0) updatewhereclause=yes name=titre_parent1 dbname="patient.titre_parent1" dbalias=".titre_parent1" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(80) updatewhereclause=yes name=prati_entete dbname="prati.entete" dbalias=".entete" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=char(20) updatewhereclause=yes name=titre dbname="titre_personnes.nom" dbalias=".nom" )
 column=(type=date updatewhereclause=yes name=cdate_jour dbname="date_jour" )
 column=(type=char(30) updatewhereclause=yes name=pays_parent1 dbname="pays.nom" dbalias=".nom" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"pays~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"titre_personnes.nom~") COMPUTE(NAME=~"cast(getdate() as date) as date_jour~") COLUMN(NAME=~"pays.nom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"patient.titre_parent1~"    OP =~"=~"RIGHT=~"titre_personnes.code~"    OUTER1 =~"patient.titre_parent1~" )    JOIN (LEFT=~"patient.pays_parent1~"    OP =~"=~"RIGHT=~"pays.code~"    OUTER1 =~"patient.pays_parent1~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )WHERE(    EXP1 =~" ~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":code_patient~" ) ) ARG(NAME = ~"code_patient~" TYPE = number) " arguments=(("code_patient", number))  sort="prati_nom A nom A prenom A " )
