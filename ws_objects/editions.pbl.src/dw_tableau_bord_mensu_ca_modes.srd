table(column=(type=decimal(2) updatewhereclause=yes name=ca_mois1 dbname="ca_mois1" )
 column=(type=char(30) updatewhereclause=yes name=prat1_nom dbname="prat1_nom" )
 column=(type=decimal(2) updatewhereclause=yes name=ca_mois2 dbname="ca_mois2" )
 column=(type=decimal(2) updatewhereclause=yes name=ca_annee1 dbname="ca_annee1" )
 column=(type=decimal(2) updatewhereclause=yes name=ca_annee2 dbname="ca_annee2" )
 column=(type=char(20) updatewhereclause=yes name=mode_reglement_nom dbname="mode_reglement.nom" )
 retrieve="  SELECT (select isnull(sum(paye.montant),0) as ca_mois1 from  patient, paye where  paye.~"mode~" = mode_reglement.code and paye.code = patient.code and patient.numero_dossier between :code1 and :code2 and year(paye.~"date~") = :annee1 and month(paye.~"date~") = :mois and  ~"paye~".~"code_praticien~" between :prat1 and :prat2   ),   
         (SELECT nom from prati where code = :prat1 ) as prat1_nom,   
         (select isnull(sum(paye.montant),0) as ca_mois2 from patient, paye where paye.~"mode~" = mode_reglement.code and paye.code = patient.code and patient.numero_dossier between :code1 and :code2 and year(paye.~"date~") = :annee2 and month(paye.~"date~") = :mois and  ~"paye~".~"code_praticien~" between :prat1 and :prat2   ),   
         (select isnull(sum(paye.montant),0) as ca_annee1 from patient, paye where paye.~"mode~" = mode_reglement.code and paye.code = patient.code and patient.numero_dossier between :code1 and :code2 and year(paye.~"date~") = :annee1 and month(paye.~"date~") <= :mois and  ~"paye~".~"code_praticien~" between :prat1 and :prat2    ),   
         (select isnull(sum(paye.montant),0) as ca_annee2 from  patient, paye where paye.~"mode~" = mode_reglement.code and paye.code = patient.code and patient.numero_dossier between :code1 and :code2 and year(paye.~"date~") = :annee2 and month(paye.~"date~") <= :mois and  ~"paye~".~"code_praticien~" between :prat1 and :prat2    ),   
         ~"mode_reglement~".~"nom~"  
    FROM ~"mode_reglement~"   
" filter="   ca_annee1 +  ca_annee2 > 0 "arguments=(("code1", number),("code2", number),("prat1", string),("prat2", string),("mois", number),("annee1", number),("annee2", number))  sort="mode_reglement_nom A " )
