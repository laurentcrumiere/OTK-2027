table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" )
 column=(type=date update=yes updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" )
 column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" )
 column=(type=date updatewhereclause=yes name=fin_traitement dbname="patient.fin_traitement" )
 column=(type=char(25) updatewhereclause=yes name=portable dbname="patient.portable" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(200) updatewhereclause=yes name=alertes_nom dbname="alertes.nom" )
 column=(type=date updatewhereclause=yes name=patient_alertes_date dbname="patient_alertes.date" )
 column=(type=char(500) updatewhereclause=yes name=patient_alertes_commentaire dbname="patient_alertes.commentaire" )
 column=(type=char(1) updatewhereclause=yes name=patient_alertes_realisee dbname="patient_alertes.realisee" values="	O/	N" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" )
 column=(type=char(1) updatewhereclause=yes name=dernier_rdv dbname="dernier_rdv" )
 column=(type=decimal(2) updatewhereclause=yes name=somme_due dbname="patient.somme_due" )
 column=(type=datetime updatewhereclause=yes name=proc_rdv dbname="patient.proc_rdv" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_parent2 dbname="patient.email_parent2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"dossier~" )  TABLE(NAME=~"alertes~" )  TABLE(NAME=~"patient_alertes~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"patient.fin_traitement~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"alertes.nom~") COLUMN(NAME=~"patient_alertes.date~") COLUMN(NAME=~"patient_alertes.commentaire~") COLUMN(NAME=~"patient_alertes.realisee~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COMPUTE(NAME=~"(select v1 as dernier_rdv from table_vide)~") COLUMN(NAME=~"patient.somme_due~") COLUMN(NAME=~"patient.proc_rdv~") COLUMN(NAME=~"patient.email_parent2~")    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )    JOIN (LEFT=~"patient_alertes.code_alerte~"    OP =~"=~"RIGHT=~"alertes.code~" )    JOIN (LEFT=~"patient_alertes.code_patient~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~" ~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient_alertes~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"type_dossier~~~"~"   OP =~"between~"    EXP2 =~":dos_min and :dos_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient_alertes~~~".~~~"code_alerte~~~"~"   OP =~"between~"    EXP2 =~":alerte1 and :alerte2~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"dos_min~" TYPE = string)  ARG(NAME = ~"dos_max~" TYPE = string)  ARG(NAME = ~"alerte1~" TYPE = number)  ARG(NAME = ~"alerte2~" TYPE = number) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("dos_min", string),("dos_max", string),("alerte1", number),("alerte2", number))  sort="nom A prenom A code A " )
