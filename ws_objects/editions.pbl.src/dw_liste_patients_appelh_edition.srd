table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" )
 column=(type=char(1) updatewhereclause=yes name=param_appelh_non dbname="param.appelh_oui" values="	O/	N" )
 column=(type=number update=yes updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=decimal(2) updatewhereclause=yes name=cdeja_paye_soin dbname="deja_paye_soin" )
 column=(type=decimal(2) updatewhereclause=yes name=cmontant_soin dbname="montant_soin" )
 column=(type=date updatewhereclause=yes name=cdate_soin dbname="date_soin" )
 column=(type=decimal(2) updatewhereclause=yes name=csoins_dus_avant_soin dbname="soins_dus_avant_soin" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" )
 column=(type=char(1) updatewhereclause=yes name=patient_mode_reglement_habituel dbname="patient.mode_reglement_habituel" )
 column=(type=datetime updatewhereclause=yes name=prochain_rdv dbname="prochain_rdv" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"param~" ALIAS=~"param_a~" )  TABLE(NAME=~"param~" ALIAS=~"param_b~" )  TABLE(NAME=~"code_soins~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"param_a.appelh_oui~") COLUMN(NAME=~"patient.code~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0)  FROM paye WHERE paye.code = patient.code and :date_limite_paye <= paye.~~~"date~~~" and  paye.~~~"date~~~" <= :date_max and soins.cle = paye.cle and paye.tp = 'N') AS deja_paye_soin~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0)  FROM ligne_soins WHERE ligne_soins.~~~"date~~~" between :date_min and :date_max and ligne_soins.code = soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'N') AS montant_soin~") COMPUTE(NAME=~"(SELECT isnull(max(~~~"date~~~"),cast('1900-01-01' as date))  FROM ligne_soins WHERE ligne_soins.code = patient.code and ligne_soins.~~~"date~~~" between :date_min and :date_max and ligne_soins.code = soins.code  and soins.cle = ligne_soins.cle and ligne_soins.tp = 'N') AS date_soin~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0)  FROM ligne_soins WHERE ligne_soins.code = patient.code and :date_limite_paye <= ligne_soins.~~~"date~~~" and ligne_soins.~~~"date~~~" < :date_min and ligne_soins.code = soins.code  and soins.cle = ligne_soins.cle and ligne_soins.tp = 'N') AS soins_dus_avant_soin~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"param_b.monnaie_base~") COLUMN(NAME=~"param_b.symbole_franc~") COLUMN(NAME=~"param_b.symbole_euro~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.mode_reglement_habituel~") COMPUTE(NAME=~"(SELECT min(rdv.rdv) FROM rdv, etat_rdv WHERE ( ~~~"rdv~~~".~~~"code~~~" = soins.code ) AND  ( cast(~~~"rdv~~~".~~~"rdv~~~" as date) >= cast(getdate() as date) ) and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' ) as prochain_rdv~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"param_a.cle~"    OP =~"=~"RIGHT=~"param_b.cle~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":var_prat_min and :var_prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"code~~~"~"   OP =~"in~"    EXP2 =~"(SELECT code FROM ligne_soins WHERE ~~~"ligne_soins~~~".~~~"date~~~" between :date_min and :date_max and soins.cle = ligne_soins.cle)~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"var_prat_min~" TYPE = string)  ARG(NAME = ~"var_prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"date_limite_paye~" TYPE = date) " filter="param_appelh_non = ~"O~""arguments=(("code_min", number),("code_max", number),("var_prat_min", string),("var_prat_max", string),("date_min", date),("date_max", date),("date_limite_paye", date))  sort="nom A patient_prenom A " )
