table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(50) updatewhereclause=yes name=paye_payeur dbname="paye.payeur" )
 column=(type=date updatewhereclause=yes name=paye_dateremise dbname="paye.dateremise" )
 column=(type=decimal(2) updatewhereclause=yes name=paye_montant dbname="paye.montant" )
 column=(type=date updatewhereclause=yes name=paye_date dbname="paye.date" )
 column=(type=char(1) updatewhereclause=yes name=paye_mode dbname="paye.mode" values="Chèque	C/Espèces	E/Virement 	V/CCP	P/Carte Bancaire	B/Solde	S/Mandat Postal	M/" )
 column=(type=char(6) update=yes updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" )
 column=(type=char(40) updatewhereclause=yes name=paye_commentaire dbname="paye.commentaire" )
 column=(type=number update=yes updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(6) updatewhereclause=yes name=paye_code_praticien dbname="paye.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=char(1) updatewhereclause=yes name=paye_monnaie dbname="paye.monnaie" )
 column=(type=long updatewhereclause=yes name=numero_ligne dbname="numero_ligne" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" )
 column=(type=char(20) updatewhereclause=yes name=mode_reglement_nom dbname="mode_reglement.nom" )
 column=(type=char(2) updatewhereclause=yes name=patient_type_dossier dbname="patient.type_dossier" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_portable dbname="patient.portable" )
 column=(type=char(200) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" initial="null" )
 column=(type=date updatewhereclause=yes name=date_fin_soin dbname="date_fin_soin" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_parent2 dbname="patient.email_parent2" )
 column=(type=date updatewhereclause=yes name=patient_debut_traitement dbname="patient.debut_traitement" )
 column=(type=date updatewhereclause=yes name=patient_fin_traitement dbname="patient.fin_traitement" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"paye~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"mode_reglement~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"soins~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"paye.code_praticien~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"paye.monnaie~") COMPUTE(NAME=~"row_number() over (order by patient.code )  as numero_ligne~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"mode_reglement.nom~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.date_demande~") COMPUTE(NAME=~"(cast (dateadd ( month , code_soins.duree, soins.date_demande ) as date)) as date_fin_soin~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.email_parent2~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.fin_traitement~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"paye.code~" )    JOIN (LEFT=~"paye.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"paye.mode~"    OP =~"=~"RIGHT=~"mode_reglement.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"paye.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"paye.cle~"    OP =~"=~"RIGHT=~"soins.cle~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"dateremise~~~"~"   OP =~"between~"    EXP2 =~":date_debut and :date_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":pra_min and :pra_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"mode~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"pra_min~" TYPE = string)  ARG(NAME = ~"pra_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"date_debut~" TYPE = date)  ARG(NAME = ~"date_fin~" TYPE = date) " arguments=(("code_min", number),("code_max", number),("pra_min", string),("pra_max", string),("date_min", date),("date_max", date),("date_debut", date),("date_fin", date))  sort="prati_nom A paye_date A paye_payeur A paye_mode A paye_commentaire A paye_dateremise A paye_code_praticien A " )
