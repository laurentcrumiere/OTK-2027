 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"courriers~" ) COLUMN(NAME=~"courriers.type_courrier~") COLUMN(NAME=~"courriers.code~") COLUMN(NAME=~"courriers.nom_courrier~")WHERE(    EXP1 =~"~~~"courriers~~~".~~~"type_courrier~~~"~"   OP =~"<>~"    EXP2 =~"1~" ) ) " update="courriers" updatewhere=0 updatekeyinplace=no  sort="type_courrier A " )
