table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(35) update=yes updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) update=yes updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) update=yes updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" dbalias=".type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_titre_parent1 dbname="patient.titre_parent1" dbalias=".titre_parent1" )
 column=(type=char(20) updatewhereclause=yes name=titre dbname="titre_personnes.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(80) updatewhereclause=yes name=prati_entete dbname="prati.entete" dbalias=".entete" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=char(30) updatewhereclause=yes name=pays_parent1 dbname="pays.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"pays~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"titre_personnes.nom~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"pays.nom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"patient.titre_parent1~"    OP =~"=~"RIGHT=~"titre_personnes.code~"    OUTER1 =~"patient.titre_parent1~" )    JOIN (LEFT=~"pays.code~"    OP =~"=~"RIGHT=~"patient.pays_parent1~"    OUTER2 =~"patient.pays_parent1~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":code_min AND :code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min AND :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"type_dossier~~~"~"   OP =~"between~"    EXP2 =~":type_dossier_min AND :type_dossier_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"not in~"    EXP2 =~"(select code from rdv_futur)~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"type_dossier_min~" TYPE = string)  ARG(NAME = ~"type_dossier_max~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("type_dossier_min", string),("type_dossier_max", string))  sort="code_praticien A nom A prenom A " )
