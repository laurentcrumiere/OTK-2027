table(column=(type=char(50) updatewhereclause=yes name=paye_payeur dbname="paye.payeur" dbalias=".payeur" )
 column=(type=date updatewhereclause=yes name=paye_dateremise dbname="paye.dateremise" dbalias=".dateremise" )
 column=(type=date updatewhereclause=yes name=paye_date dbname="paye.date" dbalias=".date" )
 column=(type=char(1) updatewhereclause=yes name=paye_mode dbname="paye.mode" dbalias=".mode" values="Chèque	C/Espèces	E/Virement 	V/CCP	P/Carte Bancaire	B/Solde	S/Mandat Postal	M/" )
 column=(type=char(40) updatewhereclause=yes name=paye_commentaire dbname="paye.commentaire" dbalias=".commentaire" )
 column=(type=decimal(2) updatewhereclause=yes name=paye_montant dbname="montant" )
 column=(type=decimal(2) updatewhereclause=yes name=paye_montant_monnaie dbname="montant_monnaie" )
 column=(type=char(1) updatewhereclause=yes name=compute_0008 dbname="compute_0008" )
 column=(type=char(81) updatewhereclause=yes name=nom dbname="nom_patient" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="code_praticien" )
 column=(type=char(3) updatewhereclause=yes name=symbole_franc dbname="symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=symbole_euro dbname="symbole_euro" )
 column=(type=number updatewhereclause=yes name=code dbname="code" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"paye~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"paye.commentaire~") COMPUTE(NAME=~"sum(paye.montant) as montant~") COMPUTE(NAME=~"sum(paye.montant_monnaie) as montant_monnaie~") COMPUTE(NAME=~"min(monnaie)~") COMPUTE(NAME=~"min(patient.nom+' '+isnull(patient.prenom,'')) as nom_patient~") COMPUTE(NAME=~"min(paye.code_praticien) as code_praticien~") COMPUTE(NAME=~"(select min(symbole_franc) as symbole_franc from param)~") COMPUTE(NAME=~"(select min(symbole_euro) as symbole_euro from param)~") COMPUTE(NAME=~"min(paye.code) as code~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"paye.code~" )    JOIN (LEFT=~"paye.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )WHERE(    EXP1 =~" ~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":pra_min and :pra_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"mode~~~"~"   OP =~"=~"    EXP2 =~":type_regl~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"monnaie~~~"~"   OP =~"=~"    EXP2 =~":monnaie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"montant~~~"~"   OP =~"between~"    EXP2 =~":montant_min and :montant_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"payeur~~~"~"   OP =~"like~"    EXP2 =~":v_payeur~" )  GROUP(NAME=~"paye.date~") GROUP(NAME=~"paye.payeur~") GROUP(NAME=~"paye.dateremise~") GROUP(NAME=~"paye.commentaire~") GROUP(NAME=~"paye.monnaie~") GROUP(NAME=~"paye.mode~") GROUP(NAME=~"prati.nom~") GROUP(NAME=~"patient.numero_dossier~") GROUP(NAME=~"prati.prenom~")) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"pra_min~" TYPE = string)  ARG(NAME = ~"pra_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"type_regl~" TYPE = string)  ARG(NAME = ~"monnaie~" TYPE = string)  ARG(NAME = ~"montant_min~" TYPE = number)  ARG(NAME = ~"montant_max~" TYPE = number)  ARG(NAME = ~"v_payeur~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("pra_min", string),("pra_max", string),("date_min", date),("date_max", date),("type_regl", string),("monnaie", string),("montant_min", number),("montant_max", number),("v_payeur", string))  sort="patient_code_praticien A paye_payeur A paye_date A paye_dateremise A paye_commentaire A nom A " )
