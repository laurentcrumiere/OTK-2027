table(column=(type=number updatewhereclause=yes identity=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(50) updatewhereclause=yes name=banque_ident dbname="banque.ident" dbalias=".ident" )
 column=(type=char(40) updatewhereclause=yes name=patient_iban dbname="patient.iban" dbalias=".iban" )
 column=(type=char(20) updatewhereclause=yes name=patient_bic dbname="patient.bic" dbalias=".bic" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(200) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" dbalias=".nom" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_scp_demande dbname="soins.scp_demande" dbalias=".scp_demande" initial="null" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" dbalias=".numero" )
 column=(type=char(1) updatewhereclause=yes name=code_soins_nature dbname="code_soins.nature" dbalias=".nature" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" dbalias=".lettre" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" dbalias=".date_demande" initial="null" )
 column=(type=number updatewhereclause=yes name=soins_cle dbname="soins.cle" dbalias=".cle" initial="zero" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_soins dbname="montant_soins" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_paye dbname="montant_paye" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" )
 column=(type=char(6) updatewhereclause=yes name=prati_banque dbname="prati.banque" dbalias=".banque" )
 column=(type=char(25) updatewhereclause=yes name=patient_rum dbname="patient.rum" dbalias=".rum" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_echeances dbname="ligne_soins.montant" dbalias=".montant" )
 column=(type=date updatewhereclause=yes name=date_echeances dbname="ligne_soins.date" dbalias=".date" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom_payeur dbname="patient.nom_payeur" dbalias=".nom_payeur" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"banque~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"ligne_soins~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"banque.ident~") COLUMN(NAME=~"patient.iban~") COLUMN(NAME=~"patient.bic~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"code_soins.nature~") COLUMN(NAME=~"code_soins.lettre~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.cle~") COMPUTE(NAME=~"dba.lignes_soins_dues_un_soin(soins.code, soins.cle, :date_max , 'N') as montant_soins~") COMPUTE(NAME=~"dba.paye_un_soin(soins.code, soins.cle, 'N') as montant_paye~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"prati.banque~") COLUMN(NAME=~"patient.rum~") COLUMN(NAME=~"ligne_soins.montant~") COLUMN(NAME=~"ligne_soins.date~") COLUMN(NAME=~"patient.nom_payeur~")    JOIN (LEFT=~"patient.code_banque~"    OP =~"=~"RIGHT=~"banque.code~"    OUTER1 =~"patient.code_banque~" )    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"patient.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"soins.cle~"    OP =~"=~"RIGHT=~"ligne_soins.cle~" )    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"ligne_soins.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"mode_reglement_habituel~~~"~"   OP =~"=~"    EXP2 =~"'R'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"cle~~~"~"   OP =~"in~"    EXP2 =~"(select ligne_soins.cle from ligne_soins where soins.code = ligne_soins.code and ~~~"ligne_soins~~~".~~~"date~~~" between :date_min and :date_max)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"isnull(ligne_soins.non_prelevement, 'N')~"   OP =~"<>~"    EXP2 =~"'O'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"isnull(~~~"ligne_soins~~~".~~~"code_prelevement~~~",0)~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ligne_soins~~~".~~~"tp~~~"~"   OP =~"=~"    EXP2 =~"'N'~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"is_prelev_min~" TYPE = string)  ARG(NAME = ~"is_prelev_max~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("is_prelev_min", string),("is_prelev_max", string))  sort="patient_nom A patient_prenom A patient_code A soins_cle A " )
