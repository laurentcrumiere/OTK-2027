table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" )
 column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" )
 column=(type=char(6) updatewhereclause=yes name=rdv_type dbname="rdv.type" )
 column=(type=char(6) updatewhereclause=yes name=rdv_code_praticien dbname="rdv.code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_duree dbname="rdv.duree" )
 column=(type=decimal(0) updatewhereclause=yes name=rdv_fauteuil dbname="rdv.fauteuil" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(6) updatewhereclause=yes name=rdv_absent dbname="rdv.absent" )
 column=(type=char(30) updatewhereclause=yes name=etat_rdv_nom dbname="etat_rdv.nom" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=datetime updatewhereclause=yes name=date_modif dbname="rdv.date_modif" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_portable dbname="patient.portable" )
 column=(type=char(25) updatewhereclause=yes name=patient_portable_patient dbname="patient.portable_patient" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" )
 column=(type=char(25) updatewhereclause=yes name=patient_teldom2_parent1 dbname="patient.teldom2_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teltra2_parent1 dbname="patient.teltra2_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_portable2_parent1 dbname="patient.portable2_parent1" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_parent2 dbname="patient.email_parent2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"etat_rdv~" )  TABLE(NAME=~"type_rdv~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"rdv.rdv~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"rdv.duree~") COLUMN(NAME=~"rdv.fauteuil~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"rdv.absent~") COLUMN(NAME=~"etat_rdv.nom~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"rdv.date_modif~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.portable_patient~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.teldom2_parent1~") COLUMN(NAME=~"patient.teltra2_parent1~") COLUMN(NAME=~"patient.portable2_parent1~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_parent2~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"rdv.code~" )    JOIN (LEFT=~"etat_rdv.code~"    OP =~"=~"RIGHT=~"rdv.absent~" )    JOIN (LEFT=~"type_rdv.code~"    OP =~"=~"RIGHT=~"rdv.type~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"rdv~~~".~~~"date_modif~~~"~"   OP =~"between~"    EXP2 =~":modif_min and :modif_max ~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"user_modif~~~"~"   OP =~"between~"    EXP2 =~":user_min and :user_max~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"modif_min~" TYPE = datetime)  ARG(NAME = ~"modif_max~" TYPE = datetime)  ARG(NAME = ~"user_min~" TYPE = string)  ARG(NAME = ~"user_max~" TYPE = string) " arguments=(("prat_min", string),("prat_max", string),("modif_min", datetime),("modif_max", datetime),("user_min", string),("user_max", string))  sort="rdv_rdv A nom A patient_prenom A " )
