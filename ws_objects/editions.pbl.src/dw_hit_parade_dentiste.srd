table(column=(type=char(30) update=yes updatewhereclause=yes name=correspondants_nom dbname="correspondants.nom" dbalias=".nom" )
 column=(type=char(30) update=yes updatewhereclause=yes name=correspondants_ville dbname="correspondants.ville" dbalias=".ville" )
 column=(type=char(30) updatewhereclause=yes name=correspondants_prenom dbname="correspondants.prenom" dbalias=".prenom" )
 column=(type=long updatewhereclause=yes name=nb_contact dbname="nb_contact" )
 column=(type=long updatewhereclause=yes name=nb_debutes dbname="nb_debutes" )
 column=(type=long updatewhereclause=yes name=nb_vus dbname="nb_vus" )
 column=(type=char(30) updatewhereclause=yes name=adr1 dbname="correspondants.adr1" dbalias=".adr1" )
 column=(type=char(30) updatewhereclause=yes name=adr2 dbname="correspondants.adr2" dbalias=".adr2" )
 column=(type=char(5) updatewhereclause=yes name=codep dbname="correspondants.codep" dbalias=".codep" )
 column=(type=char(1) updatewhereclause=yes name=sexe dbname="correspondants.sexe" dbalias=".sexe" initial="M" values="Masculin	M/Féminin	F/" )
 column=(type=char(15) updatewhereclause=yes name=tel dbname="correspondants.tel" dbalias=".tel" )
 column=(type=char(15) updatewhereclause=yes name=fax dbname="correspondants.fax" dbalias=".fax" )
 column=(type=char(1000) updatewhereclause=yes name=commentaires dbname="correspondants.commentaires" dbalias=".commentaires" )
 column=(type=decimal(0) updatewhereclause=yes name=titre dbname="correspondants.titre" dbalias=".titre" )
 column=(type=char(100) updatewhereclause=yes name=email dbname="correspondants.email" dbalias=".email" )
 column=(type=char(15) updatewhereclause=yes name=tel2 dbname="correspondants.tel2" dbalias=".tel2" )
 column=(type=char(6) updatewhereclause=yes name=categorie dbname="correspondants.categorie" dbalias=".categorie" )
 column=(type=char(6) updatewhereclause=yes name=pays dbname="correspondants.pays" dbalias=".pays" )
 column=(type=char(1) updatewhereclause=yes name=relation dbname="correspondants.relation" dbalias=".relation" )
 column=(type=char(6) updatewhereclause=yes key=yes name=code dbname="correspondants.code" dbalias=".code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"correspondants~" ) COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"correspondants.ville~") COLUMN(NAME=~"correspondants.prenom~") COMPUTE(NAME=~"(select count(*) as nb_contact from patient where code_dentiste = correspondants.code and patient.numero_dossier between :code_min and :code_max and code_praticien between :prat_min and :prat_max and date_contact between :date_min and :date_max and isnull(patient.adulte, 'N') between :adulte_min and :adulte_max)~") COMPUTE(NAME=~"(select count(*) as nb_debutes from patient where code_dentiste = correspondants.code and patient.numero_dossier between :code_min and :code_max and code_praticien between :prat_min and :prat_max and date_contact between :date_min and :date_max and debut_traitement is not null and isnull(patient.adulte, 'N') between :adulte_min and :adulte_max)~") COMPUTE(NAME=~"(select count(*) as nb_vus from patient where code_dentiste = correspondants.code and patient.numero_dossier between :code_min and :code_max and code_praticien between :prat_min and :prat_max and date_contact between :date_min and :date_max and premiere_visite is not null and isnull(patient.adulte, 'N') between :adulte_min and :adulte_max)~") COLUMN(NAME=~"correspondants.adr1~") COLUMN(NAME=~"correspondants.adr2~") COLUMN(NAME=~"correspondants.codep~") COLUMN(NAME=~"correspondants.sexe~") COLUMN(NAME=~"correspondants.tel~") COLUMN(NAME=~"correspondants.fax~") COLUMN(NAME=~"correspondants.commentaires~") COLUMN(NAME=~"correspondants.titre~") COLUMN(NAME=~"correspondants.email~") COLUMN(NAME=~"correspondants.tel2~") COLUMN(NAME=~"correspondants.categorie~") COLUMN(NAME=~"correspondants.pays~") COLUMN(NAME=~"correspondants.relation~") COLUMN(NAME=~"correspondants.code~")WHERE(    EXP1 =~"~~~"correspondants~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"adulte_min~" TYPE = string)  ARG(NAME = ~"adulte_max~" TYPE = string) " update="correspondants" updatewhere=0 updatekeyinplace=no filter=" nb_contact > 0"arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("adulte_min", string),("adulte_max", string))  sort="nb_contact D correspondants_nom A correspondants_prenom A correspondants_ville A " )
