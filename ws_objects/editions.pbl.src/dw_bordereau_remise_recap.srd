table(column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" dbalias=".nom" )
 column=(type=date updatewhereclause=yes name=paye_date dbname="paye.date" dbalias=".date" initial="today" )
 column=(type=char(50) updatewhereclause=yes name=paye_payeur dbname="paye.payeur" dbalias=".payeur" )
 column=(type=date updatewhereclause=yes name=paye_dateremise dbname="paye.dateremise" dbalias=".dateremise" initial="today" )
 column=(type=char(40) updatewhereclause=yes name=paye_commentaire dbname="paye.commentaire" dbalias=".commentaire" )
 column=(type=char(1) updatewhereclause=yes name=paye_mode dbname="paye.mode" dbalias=".mode" )
 column=(type=char(50) updatewhereclause=yes name=banque_ident dbname="banque.ident" dbalias=".ident" )
 column=(type=char(26) updatewhereclause=yes name=banque_rib dbname="banque.rib" dbalias=".rib" )
 column=(type=char(50) updatewhereclause=yes name=banque_banq1 dbname="banque.banq1" dbalias=".banq1" )
 column=(type=char(50) updatewhereclause=yes name=banque_banq2 dbname="banque.banq2" dbalias=".banq2" )
 column=(type=number updatewhereclause=yes identity=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" dbalias=".monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" dbalias=".symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" dbalias=".symbole_euro" )
 column=(type=decimal(2) updatewhereclause=yes name=paye_montant_monnaie dbname="paye.montant_monnaie" dbalias=".montant_monnaie" )
 column=(type=decimal(2) updatewhereclause=yes name=paye_montant dbname="paye.montant" dbalias=".montant" )
 column=(type=char(6) updatewhereclause=yes name=paye_code_praticien dbname="paye.code_praticien" dbalias=".code_praticien" )
 column=(type=datetime update=yes updatewhereclause=yes name=paye_date_impression_remise dbname="paye.date_impression_remise" dbalias=".date_impression_remise" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=paye_deja_imprime dbname="paye.deja_imprime" dbalias=".deja_imprime" )
 column=(type=long updatewhereclause=yes name=numero_ligne dbname="numero_ligne" )
 column=(type=number updatewhereclause=yes name=paye_code dbname="paye.code" dbalias=".code" )
 column=(type=number updatewhereclause=yes name=paye_cle dbname="paye.cle" dbalias=".cle" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=datetime updatewhereclause=yes name=paye_heure_saisie dbname="paye.heure_saisie" dbalias=".heure_saisie" )
 column=(type=datetime updatewhereclause=yes name=remises_date_generation dbname="remises.date_generation" dbalias=".date_generation" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(20) updatewhereclause=yes name=mode_reglement_nom dbname="mode_reglement.nom" dbalias=".nom" )
 column=(type=number updatewhereclause=yes identity=yes name=remises_code dbname="remises.code" dbalias=".code" )
 column=(type=char(32766) updatewhereclause=no name=liste_praticiens dbname="liste_praticiens" )
 column=(type=long updatewhereclause=yes name=nb_elements_remise dbname="nb_elements_remise" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_remise dbname="montant_remise" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"paye~" )  TABLE(NAME=~"banque~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"remises~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"mode_reglement~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"banque.ident~") COLUMN(NAME=~"banque.rib~") COLUMN(NAME=~"banque.banq1~") COLUMN(NAME=~"banque.banq2~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"paye.montant_monnaie~") COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.code_praticien~") COLUMN(NAME=~"paye.date_impression_remise~") COLUMN(NAME=~"paye.deja_imprime~") COMPUTE(NAME=~"row_number() over (order by patient.code )  as numero_ligne~") COLUMN(NAME=~"paye.code~") COLUMN(NAME=~"paye.cle~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"paye.heure_saisie~") COLUMN(NAME=~"remises.date_generation~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"mode_reglement.nom~") COLUMN(NAME=~"remises.code~") COMPUTE(NAME=~"(SELECT list(nom, ' , ' order by nom) from prati where prati.code in (select paye2.code_praticien from paye as paye2 where  paye2.code_remise = remises.code ) ) as liste_praticiens~") COMPUTE(NAME=~"(select  count( distinct isnull(~~~"payeur~~~", '') + isnull(~~~"commentaire~~~",'') + ~~~"mode~~~" + string(dateremise)+string(~~~"date~~~"))  from paye as p2 where p2.code_remise = remises.code ) as nb_elements_remise~") COMPUTE(NAME=~"(select sum(montant)  from paye as p2 where p2.code_remise = remises.code  ) as montant_remise~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"paye.code~" )    JOIN (LEFT=~"paye.banque~"    OP =~"=~"RIGHT=~"banque.code~" )    JOIN (LEFT=~"paye.code_remise~"    OP =~"=~"RIGHT=~"remises.code~" )    JOIN (LEFT=~"paye.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"paye.mode~"    OP =~"=~"RIGHT=~"mode_reglement.code~" )WHERE(    EXP1 =~"( date(~~~"remises~~~".~~~"date_generation~~~")~"   OP =~"between~"    EXP2 =~":v_date_min and :v_date_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"paye~~~".~~~"mode~~~"~"   OP =~"between~"    EXP2 =~":v_mode_min and :v_mode_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"paye~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":v_prat_min and :v_prat_max )~" ) ) ARG(NAME = ~"v_date_min~" TYPE = date)  ARG(NAME = ~"v_date_max~" TYPE = date)  ARG(NAME = ~"v_mode_min~" TYPE = string)  ARG(NAME = ~"v_mode_max~" TYPE = string)  ARG(NAME = ~"v_prat_min~" TYPE = string)  ARG(NAME = ~"v_prat_max~" TYPE = string) " arguments=(("v_date_min", date),("v_date_max", date),("v_mode_min", string),("v_mode_max", string),("v_prat_min", string),("v_prat_max", string))  sort="remises_date_generation A paye_dateremise A paye_heure_saisie A paye_payeur A paye_mode A paye_commentaire A patient_nom A patient_prenom A paye_code_praticien A " )
