 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"correspondants~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"correspondants.ville~") COMPUTE(NAME=~"count(~~~"patient~~~".~~~"code~~~" )~") COLUMN(NAME=~"correspondants.prenom~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"correspondants.adr1~") COLUMN(NAME=~"correspondants.adr2~") COLUMN(NAME=~"correspondants.codep~") COLUMN(NAME=~"correspondants.sexe~") COLUMN(NAME=~"correspondants.tel~") COLUMN(NAME=~"correspondants.fax~") COLUMN(NAME=~"correspondants.commentaires~") COLUMN(NAME=~"correspondants.titre~") COLUMN(NAME=~"correspondants.email~") COLUMN(NAME=~"correspondants.tel2~") COLUMN(NAME=~"correspondants.relation~") COLUMN(NAME=~"correspondants.categorie~") COLUMN(NAME=~"correspondants.pays~") COLUMN(NAME=~"correspondants.code~")    JOIN (LEFT=~"correspondants.code~"    OP =~"=~"RIGHT=~"patient.code_correspondant~" )WHERE(    EXP1 =~"( :code_min~"   OP =~"<=~"    EXP2 =~"~~~"patient~~~".~~~"numero_dossier~~~" )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"<=~"    EXP2 =~":code_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( :prat_min~"   OP =~"<=~"    EXP2 =~"~~~"patient~~~".~~~"code_praticien~~~" )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"<=~"    EXP2 =~":prat_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(:date_min~"   OP =~"<=~"    EXP2 =~"~~~"patient~~~".~~~"premiere_visite~~~")~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(:date_max~"   OP =~">=~"    EXP2 =~"~~~"patient~~~".~~~"premiere_visite~~~")~" )  GROUP(NAME=~"correspondants.nom~") GROUP(NAME=~"correspondants.prenom~") GROUP(NAME=~"correspondants.adr1~") GROUP(NAME=~"correspondants.adr2~") GROUP(NAME=~"correspondants.codep~") GROUP(NAME=~"correspondants.ville~") GROUP(NAME=~"correspondants.sexe~") GROUP(NAME=~"correspondants.tel~") GROUP(NAME=~"correspondants.fax~") GROUP(NAME=~"correspondants.commentaires~") GROUP(NAME=~"correspondants.titre~") GROUP(NAME=~"correspondants.email~") GROUP(NAME=~"correspondants.tel2~") GROUP(NAME=~"correspondants.relation~") GROUP(NAME=~"correspondants.categorie~") GROUP(NAME=~"correspondants.pays~") GROUP(NAME=~"table_vide.v1~") GROUP(NAME=~"correspondants.code~")) ORDER(NAME=~"3~" ASC=no) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date)) )
