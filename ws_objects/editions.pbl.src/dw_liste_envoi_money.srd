table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) updatewhereclause=yes name=paye_payeur dbname="paye.payeur" dbalias=".payeur" )
 column=(type=date updatewhereclause=yes key=yes name=paye_dateremise dbname="paye.dateremise" dbalias=".dateremise" )
 column=(type=decimal(2) updatewhereclause=yes key=yes name=paye_montant dbname="paye.montant" dbalias=".montant" )
 column=(type=date updatewhereclause=yes key=yes name=paye_date dbname="paye.date" dbalias=".date" )
 column=(type=char(1) updatewhereclause=yes key=yes name=paye_mode dbname="paye.mode" dbalias=".mode" values="Chèque	C/Espèces	E/Virement 	V/CCP	P/Carte Bancaire	B/Solde	S/Mandat Postal	M/" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" )
 column=(type=date update=yes updatewhereclause=yes name=paye_transfert dbname="paye.transfert" dbalias=".transfert" )
 column=(type=number updatewhereclause=yes key=yes name=paye_cle dbname="paye.cle" dbalias=".cle" )
 column=(type=char(40) updatewhereclause=yes key=yes name=paye_commentaire dbname="paye.commentaire" dbalias=".commentaire" )
 column=(type=char(1) updatewhereclause=yes name=paye_tp dbname="paye.tp" dbalias=".tp" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=number updatewhereclause=yes key=yes name=paye_code dbname="paye.code" dbalias=".code" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(50) updatewhereclause=yes name=banque_ident dbname="banque.ident" dbalias=".ident" )
 column=(type=char(20) updatewhereclause=yes name=banque_compte_comptable dbname="banque.compte_comptable" dbalias=".compte_comptable" )
 column=(type=char(20) updatewhereclause=yes name=prati_code_comptable dbname="prati.code_comptable" dbalias=".code_comptable" )
 column=(type=decimal(0) updatewhereclause=yes name=facture_numero dbname="facture.numero" dbalias=".numero" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"paye~" )  TABLE(NAME=~"banque~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"facture~" )  TABLE(NAME=~"soins~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"paye.transfert~") COLUMN(NAME=~"paye.cle~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"paye.tp~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"paye.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"banque.ident~") COLUMN(NAME=~"banque.compte_comptable~") COLUMN(NAME=~"prati.code_comptable~") COLUMN(NAME=~"facture.numero~")    JOIN (LEFT=~"soins.numero_facture~"    OP =~"=~"RIGHT=~"facture.numero~"    OUTER1 =~"soins.numero_facture~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"paye.code~" )    JOIN (LEFT=~"banque.code~"    OP =~"=~"RIGHT=~"paye.banque~" )    JOIN (LEFT=~"paye.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"paye.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"paye.cle~"    OP =~"=~"RIGHT=~"soins.cle~" )WHERE(    EXP1 =~"~~~"paye~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":prat~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"date~~~"~"   OP =~"<=~"    EXP2 =~":da~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(case when ~~~"paye~~~".~~~"transfert~~~"  is null then 1 else 2 end)~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"prat~" TYPE = string)  ARG(NAME = ~"da~" TYPE = date) " update="paye" updatewhere=0 updatekeyinplace=no filter=" paye_mode  <>  'S'"arguments=(("prat", string),("da", date))  sort="paye_date A paye_mode A banque_compte_comptable A paye_payeur A code A " )
