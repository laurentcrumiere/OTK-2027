 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"correspondants~" ALIAS=~"correspondants_a~" )  TABLE(NAME=~"correspondants~" ALIAS=~"correspondants_b~" )  TABLE(NAME=~"correspondants~" ALIAS=~"correspondants_c~" ) COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_parent2~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.email_payeur~") COLUMN(NAME=~"correspondants_a.email~") COLUMN(NAME=~"correspondants_b.email~") COLUMN(NAME=~"correspondants_c.email~")    JOIN (LEFT=~"correspondants_a.code~"    OP =~"=~"RIGHT=~"patient.code_correspondant~" )    JOIN (LEFT=~"patient.code_dentiste~"    OP =~"=~"RIGHT=~"correspondants_b.code~" )    JOIN (LEFT=~"correspondants_c.code~"    OP =~"=~"RIGHT=~"patient.code_medecin~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":id_patient~" ) ) ARG(NAME = ~"id_patient~" TYPE = number) " arguments=(("id_patient", number)) )
