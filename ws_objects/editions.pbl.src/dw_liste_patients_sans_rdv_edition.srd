table(column=(type=number update=yes updatewhereclause=yes key=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=date updatewhereclause=yes name=patient_relance dbname="patient.relance" )
 column=(type=datetime updatewhereclause=yes name=dernier_rdv dbname="dernier_rdv" )
 column=(type=char(25) updatewhereclause=yes name=portable dbname="patient.portable" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(35) updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(200) updatewhereclause=yes name=com_parent1 dbname="patient.com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=secu_parent1 dbname="patient.secu_parent1" )
 column=(type=char(6) updatewhereclause=yes name=prochain_rdv dbname="patient.prochain_rdv" )
 column=(type=decimal(0) updatewhereclause=yes name=prochain_rdv_nb dbname="patient.prochain_rdv_nb" )
 column=(type=char(1) updatewhereclause=yes name=prochain_rdv_tps dbname="patient.prochain_rdv_tps" )
 column=(type=number updatewhereclause=yes name=prochain_rdv_serie dbname="patient.prochain_rdv_serie" )
 column=(type=char(1) updatewhereclause=yes name=prochain_rdv_t_ou_s dbname="patient.prochain_rdv_t_ou_s" )
 column=(type=char(30) updatewhereclause=yes name=nom_prochain_rdv dbname="nom_prochain_rdv" )
 column=(type=char(50) updatewhereclause=yes name=nom_serie_prochain_rdv dbname="nom_serie_prochain_rdv" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" )
 column=(type=char(100) updatewhereclause=yes name=email_parent2 dbname="patient.email_parent2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.relance~") COMPUTE(NAME=~"(select max(rdv) as dernier_rdv from rdv, etat_rdv where rdv.code = patient.code and cast (rdv.rdv as date)  <= cast(getdate() as date) and absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O')~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.prochain_rdv~") COLUMN(NAME=~"patient.prochain_rdv_nb~") COLUMN(NAME=~"patient.prochain_rdv_tps~") COLUMN(NAME=~"patient.prochain_rdv_serie~") COLUMN(NAME=~"patient.prochain_rdv_t_ou_s~") COMPUTE(NAME=~"(select nom from type_rdv where type_rdv.code = prochain_rdv) as nom_prochain_rdv~") COMPUTE(NAME=~"(select libelle from rdv_serie where rdv_serie.code = prochain_rdv_serie) as nom_serie_prochain_rdv~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_parent2~")) " update="patient" updatewhere=1 updatekeyinplace=no  sort="nom A prenom A code A " )
