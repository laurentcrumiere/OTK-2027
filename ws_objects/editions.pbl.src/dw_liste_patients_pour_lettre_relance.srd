table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" )
 column=(type=decimal(0) updatewhereclause=yes name=lettre_relance dbname="patient.lettre_relance" validation="double(gettext()) >= 0 and double(gettext()) <= 3" validationmsg="~"Ce nombre doit être compris entre 0 et 3~"" )
 column=(type=datetime updatewhereclause=yes name=cprochain_rdv dbname="prochain_rdv" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_soin dbname="total_soin" )
 column=(type=date updatewhereclause=yes name=cdate_soin dbname="date_soin" )
 column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(1) updatewhereclause=yes name=patient_mode_reglement_habituel dbname="patient.mode_reglement_habituel" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_paye dbname="total_paye" )
 column=(type=char(25) updatewhereclause=yes name=patient_portable dbname="patient.portable" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_parent2 dbname="patient.email_parent2" )
 column=(type=char(1) updatewhereclause=yes name=patient_adulte dbname="patient.adulte" values="Adulte	O/Adulte	N" )
 retrieve="  SELECT ~"patient~".~"nom~",   
         ~"patient~".~"nom_parent1~",   
         ~"patient~".~"ville_parent1~",   
         ~"patient~".~"teldom_parent1~",   
         ~"patient~".~"teltra_parent1~",   
         ~"patient~".~"code_praticien~",   
         ~"patient~".~"relance~",   
         ~"patient~".~"lettre_relance~",   
         (SELECT min(rdv.rdv) as prochain_rdv FROM rdv, etat_rdv WHERE ( ~"rdv~".~"code~" = soins.code ) AND  ( cast(~"rdv~".~"rdv~" as date) >= cast(getdate() as date) ) and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' ),   
         ~"patient~".~"code~",   
         ~"patient~".~"prenom~",   
         ~"param~".~"symbole_euro~",   
         ~"param~".~"symbole_franc~",   
         ~"param~".~"monnaie_base~",   
         ~"patient~".~"moulage~",   
         dba.lignes_soins_dues_un_soin (soins.code, soins.cle, :daref2, 'N') as total_soin,   
         (SELECT max(~"date~")  FROM ligne_soins WHERE soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'N' and ligne_soins.~"date~" <= :daref2) as date_soin,   
         ~"dossier~".~"nom~",   
         ~"patient~".~"numero_dossier~",   
         ~"patient~".~"mode_reglement_habituel~",   
         ~"patient~".~"email~",   
         ~"patient~".~"email_patient~",   
         (select isnull(sum(paye.montant),0)  from paye where paye.tp = 'N' and  paye.code = soins.code and paye.cle = soins.cle and paye.~"date~" <= :daregl) as total_paye,   
         ~"patient~".~"portable~",   
         ~"patient~".~"email_parent2~"  , 
         ~"patient~".~"adulte~"  
    FROM ~"patient~",   
         ~"soins~",   
         ~"param~",   
         ~"dossier~",   
         ~"ligne_soins~" 
   WHERE ( ~"soins~".~"code~" = ~"patient~".~"code~" ) and  
         ( ~"dossier~".~"code~" = ~"patient~".~"type_dossier~" ) and  
         ( ~"ligne_soins~".~"cle~" = ~"soins~".~"cle~" ) and  
         ( ~"ligne_soins~".~"code~" = ~"soins~".~"code~" ) and  
         ( ( ~"patient~".~"numero_dossier~"  between :code_min and :code_max ) AND  
         ( ~"patient~".~"code_praticien~" between :var_pra_min and :var_pra_max ) AND  
         ( ~"ligne_soins~".~"date~" between :daref and :daref2  ) AND  
         ( ~"ligne_soins~".~"tp~" <> 'O' ) )   
GROUP BY ~"soins~".~"code~",   
         ~"soins~".~"cle~",   
         ~"patient~".~"nom~",   
         ~"patient~".~"code~",   
         ~"patient~".~"nom_parent1~",   
         ~"patient~".~"ville_parent1~",   
         ~"patient~".~"teldom_parent1~",   
         ~"patient~".~"teltra_parent1~",   
         ~"patient~".~"code_praticien~",   
         ~"patient~".~"moulage~",   
         ~"patient~".~"lettre_relance~",   
         ~"patient~".~"relance~",   
         ~"patient~".~"prenom~",   
         ~"param~".~"monnaie_base~",   
         ~"patient~".~"portable~",   
         ~"patient~".~"numero_dossier~",   
         ~"param~".~"symbole_franc~",   
         ~"param~".~"symbole_euro~",   
         ~"dossier~".~"nom~",   
         ~"patient~".~"mode_reglement_habituel~",   
         ~"patient~".~"email~",   
         ~"patient~".~"email_patient~",   
         ~"patient~".~"email_parent2~"   ,
         ~"patient~".~"adulte~"   
" arguments=(("code_min", number),("code_max", number),("var_pra_min", string),("var_pra_max", string),("daref", date),("daref2", date),("daregl", date))  sort="nom A patient_prenom A code A cdate_soin A " )
