table(column=(type=char(10) updatewhereclause=yes name=type dbname="soins.type" dbalias=".type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=decimal(2) updatewhereclause=yes name=scp_demande dbname="soins.scp_demande" dbalias=".scp_demande" initial="null" )
 column=(type=decimal(2) updatewhereclause=yes name=hn dbname="soins.hn" dbalias=".hn" )
 column=(type=decimal(2) updatewhereclause=yes name=total dbname="soins.total" dbalias=".total" )
 column=(type=char(3) updatewhereclause=yes name=prati_typort dbname="prati.typort" dbalias=".typort" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" dbalias=".numero" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" dbalias=".nom" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" dbalias=".lettre" )
 column=(type=number updatewhereclause=yes name=code_soins_suivis dbname="code_soins_suivis" )
 column=(type=long updatewhereclause=yes name=tri_soins_suivis dbname="tri_soins_suivis" )
 column=(type=char(40) updatewhereclause=yes name=nom_soins_suivis dbname="nom_soins_suivis" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"code_soins~" ) COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"prati.typort~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"code_soins.lettre~") COMPUTE(NAME=~"(SELECT min(code_soins_suivis) as code_soins_suivis FROM soins_suivis_detail where soins.type = code_soins and isnull(soins.numero,0) between numero_min and numero_max)~") COMPUTE(NAME=~"(select ordre_trie as tri_soins_suivis from soins_suivis where code = (SELECT min(code_soins_suivis) as code_soins_suivis FROM soins_suivis_detail where soins.type = code_soins and isnull(soins.numero,0) between numero_min and numero_max))~") COMPUTE(NAME=~"(select nom as nom_soins_suivis from soins_suivis where code = (SELECT min(code_soins_suivis) as code_soins_suivis FROM soins_suivis_detail where soins.type = code_soins and isnull(soins.numero,0) between numero_min and numero_max))~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )WHERE(    EXP1 =~"( ~~~"prati~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":prat )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"code_soins~~~".~~~"duree~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( :date_ref~"   OP =~"between~"    EXP2 =~"~~~"soins~~~".~~~"date_demande~~~" and dateadd(day,~~~"code_soins~~~".~~~"duree~~~" * 30 , ~~~"soins~~~".~~~"date_demande~~~"))~" ) ) ARG(NAME = ~"prat~" TYPE = string)  ARG(NAME = ~"date_ref~" TYPE = date) " filter="not isnull( code_soins_suivis )"arguments=(("prat", string),("date_ref", date))  sort="tri_soins_suivis A nom_soins_suivis A code_soins_suivis A " )
