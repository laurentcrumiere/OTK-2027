table(column=(type=number updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_caisse dbname="patient.code_caisse" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(1) updatewhereclause=yes name=param_payassu dbname="param.payassu" initial="O" values="Oui	O/Non	N/" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_payeur dbname="patient.secu_payeur" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent2 dbname="patient.secu_parent2" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(1) updatewhereclause=yes name=origine_tp dbname="ligne_soins.origine_tp" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_mutuelle dbname="patient.code_mutuelle" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) updatewhereclause=yes name=mutuelle_nom dbname="mutuelle.nom" )
 column=(type=char(30) updatewhereclause=yes name=caisse_nom dbname="caisse.nom" )
 column=(type=char(1) updatewhereclause=yes name=patient_assure dbname="patient.assure" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_soins_mutuelle dbname="total_soins_mutuelle" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_soins_caisse dbname="total_soins_caisse" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_paye_caisse dbname="total_paye_caisse" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_paye_mutuelle dbname="total_paye_mutuelle" )
 column=(type=date updatewhereclause=yes name=date_soin_mutuelle dbname="date_soin_mutuelle" )
 column=(type=date updatewhereclause=yes name=date_soin_caisse dbname="date_soin_caisse" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=datetime updatewhereclause=yes name=proc_rdv dbname="proc_rdv" )
 retrieve="  SELECT ~"patient~".~"code~",   
         ~"patient~".~"nom~",   
         ~"patient~".~"nom_parent1~",   
         ~"patient~".~"code_praticien~",   
         ~"patient~".~"code_caisse~",   
         ~"param~".~"payassu~",   
         ~"patient~".~"secu_payeur~",   
         ~"patient~".~"secu_parent2~",   
         ~"patient~".~"secu_parent1~",   
         ~"patient~".~"prenom~",   
         ~"ligne_soins~".~"origine_tp~",   
         ~"patient~".~"code_mutuelle~",   
         ~"mutuelle~".~"nom~",   
         ~"caisse~".~"nom~",   
         ~"patient~".~"assure~",   
		~"patient~".~"numero_dossier~",
		(SELECT isnull(sum(montant),0) as total_soins_mutuelle FROM ligne_soins WHERE soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'O' and ~"ligne_soins~".~"origine_tp~" = 'M'  and ligne_soins.~"date~" <= :date_ref2 and ((:que_fs = 'O' and fse_edite in ('M','V')) or (:que_fs = 'N'))) ,
		(SELECT isnull(sum(montant),0) as total_soins_caisse FROM ligne_soins WHERE soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'O' and ~"ligne_soins~".~"origine_tp~" = 'C'  and ligne_soins.~"date~" <= :date_ref2 and ((:que_fs = 'O' and fse_edite in ('M','V')) or (:que_fs = 'N'))) , 
		(SELECT isnull(sum(paye.montant),0) as total_paye_caisse FROM paye WHERE soins.code = paye.code and soins.cle = paye.cle and ~"paye~".~"tp~" = 'O' and ~"paye~".~"origine_tp~" = 'C' and ((:que_fs = 'O' and fse_edite in ('M','V')) or (:que_fs = 'N')) ) ,
		(SELECT isnull(sum(paye.montant),0) as total_paye_mutuelle FROM paye WHERE soins.code = paye.code and soins.cle = paye.cle and ~"paye~".~"tp~" = 'O' and ~"paye~".~"origine_tp~" = 'M' and ((:que_fs = 'O' and fse_edite in ('M','V')) or (:que_fs = 'N'))  ) ,
		(SELECT max(~"date~") as date_soin_mutuelle FROM ligne_soins WHERE soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'O' and ~"ligne_soins~".~"origine_tp~" = 'M' and ligne_soins.~"date~" <= :date_ref2 and ((:que_fs = 'O' and fse_edite in ('M','V')) or (:que_fs = 'N'))) ,
		(SELECT max(~"date~") as date_soin_caisse FROM ligne_soins WHERE soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'O' and ~"ligne_soins~".~"origine_tp~" = 'C' and ligne_soins.~"date~" <= :date_ref2 and ((:que_fs = 'O' and fse_edite in ('M','V')) or (:que_fs = 'N'))) ,
	   ~"param~".~"monnaie_base~",
	   ~"param~".~"symbole_franc~",
	   ~"param~".~"symbole_euro~",
		(select min(rdv) from rdv, etat_rdv where rdv.absent = etat_rdv.code and rdv.code = patient.code and etat_rdv.elimine_agenda <> 'O' and cast (rdv.rdv as date)  > cast(getdate() as date)) as proc_rdv 
    FROM ~"patient~",   
         ~"param~",   
         ~"ligne_soins~",   
         ~"soins~",    
         ~"mutuelle~",   
         ~"caisse~" ,
	    ~"param~" 
   WHERE ( ~"ligne_soins~".~"code~" = ~"patient~".~"code~" ) and  
	 	( ~"soins~".~"code~" = ~"patient~".~"code~" ) and 
		  ( ~"ligne_soins~".~"cle~" = ~"soins~".~"cle~" ) and  
         ( ~"ligne_soins~".~"code~" = ~"soins~".~"code~" ) and  
         ( ~"mutuelle~".~"code~" = ~"patient~".~"code_mutuelle~" ) and  
         ( ~"caisse~".~"code~" = ~"patient~".~"code_caisse~" ) and  
         (~"patient~".~"numero_dossier~" between :code_min and :code_max)   and 
         (~"ligne_soins~".~"date~" between :date_ref and :date_ref2) and  
         ( ~"ligne_soins~".~"tp~" = 'O') AND  
         ( ~"patient~".~"code_praticien~" between :var_pra_min and :var_pra_max)   AND
         ( ~"patient~".~"code_caisse~" between :caisse_min and :caisse_max)   AND
         ( ~"patient~".~"code_mutuelle~" between :mutuelle_min and :mutuelle_max)   
  GROUP BY ~"patient~".~"code~",   
			~"soins~".~"code~",   
         ~"soins~".~"cle~",   
		~"soins~".~"fse_edite~",
         ~"patient~".~"code_mutuelle~",   
         ~"ligne_soins~".~"origine_tp~",   
         ~"caisse~".~"nom~",   
         ~"mutuelle~".~"nom~",   
         ~"patient~".~"nom~",   
         ~"patient~".~"nom_parent1~",   
         ~"patient~".~"code_praticien~",   
         ~"patient~".~"code_caisse~",   
         ~"param~".~"payassu~",   
         ~"patient~".~"secu_payeur~",   
         ~"patient~".~"secu_parent2~",   
         ~"patient~".~"secu_parent1~",   
         ~"patient~".~"assure~",   
         ~"patient~".~"prenom~" ,  
	   ~"param~".~"monnaie_base~",
	   ~"param~".~"symbole_franc~",
	   ~"param~".~"symbole_euro~",
	~"patient~".~"numero_dossier~"


" filter="due > 0"arguments=(("code_min", number),("code_max", number),("var_pra_min", string),("var_pra_max", string),("date_ref", date),("date_ref2", date),("que_fs", string),("caisse_min", string),("caisse_max", string),("mutuelle_min", string),("mutuelle_max", string))  sort="patient_code_praticien A origine_tp A code_aff A caisse_nom A mutuelle_nom A patient_nom A patient_prenom A " )
