 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.nom_parent2~") COLUMN(NAME=~"patient.nom_payeur~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.prof_parent1~") COLUMN(NAME=~"patient.prof_parent2~") COLUMN(NAME=~"patient.prof_payeur~") COLUMN(NAME=~"patient.prof2_parent1~") COLUMN(NAME=~"patient.prof2_parent2~") COLUMN(NAME=~"patient.prof2_payeur~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.adr1_parent2~") COLUMN(NAME=~"patient.adr2_parent2~") COLUMN(NAME=~"patient.codep_parent2~") COLUMN(NAME=~"patient.ville_parent2~") COLUMN(NAME=~"patient.teldom_parent2~") COLUMN(NAME=~"patient.teltra_parent2~") COLUMN(NAME=~"patient.com_parent2~") COLUMN(NAME=~"patient.secu_parent2~") COLUMN(NAME=~"patient.adr1_payeur~") COLUMN(NAME=~"patient.codep_payeur~") COLUMN(NAME=~"patient.adr2_payeur~") COLUMN(NAME=~"patient.ville_payeur~") COLUMN(NAME=~"patient.teldom_payeur~") COLUMN(NAME=~"patient.teltra_payeur~") COLUMN(NAME=~"patient.com_payeur~") COLUMN(NAME=~"patient.secu_payeur~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.email_parent2~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"prof_parent1~~~"~"   OP =~"like~"    EXP2 =~":prof~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"prof_parent2~~~"~"   OP =~"like~"    EXP2 =~":prof~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"prof_payeur~~~"~"   OP =~"like~"    EXP2 =~":prof~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"prof2_parent1~~~"~"   OP =~"like~"    EXP2 =~":prof~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"prof2_parent2~~~"~"   OP =~"like~"    EXP2 =~":prof~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"prof2_payeur~~~"~"   OP =~"like~"    EXP2 =~":prof~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"prof~" TYPE = string) " update="patient" updatewhere=0 updatekeyinplace=no arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("prof", string))  sort="nom A prenom A " )
