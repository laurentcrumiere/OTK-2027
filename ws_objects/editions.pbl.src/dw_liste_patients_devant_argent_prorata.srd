table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" )
 column=(type=decimal(0) updatewhereclause=yes name=lettre_relance dbname="patient.lettre_relance" validation="double(gettext()) >= 0 and double(gettext()) <= 3" validationmsg="~"Ce nombre doit être compris entre 0 et 3~"" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" )
 column=(type=decimal(0) updatewhereclause=yes name=code_soins_duree dbname="code_soins.duree" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" initial="null" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" )
 column=(type=decimal(2) updatewhereclause=yes name=total_paye_soin dbname="total_paye_soin" )
 column=(type=datetime updatewhereclause=yes name=date_fin dbname="date_fin" )
 column=(type=long updatewhereclause=yes name=nb_jours dbname="nb_jours" )
 column=(type=char(1) updatewhereclause=yes name=du_prorata dbname="table_vide.du_prorata" )
 column=(type=char(1) updatewhereclause=yes name=soins_total_proratise dbname="table_vide.soins_total_proratise" )
 column=(type=char(1) updatewhereclause=yes name=somme_due_patient dbname="table_vide.somme_due_patient" )
 column=(type=char(1) updatewhereclause=yes name=total_soins_patient dbname="table_vide.total_soins_patient" )
 column=(type=char(1) updatewhereclause=yes name=soins_periode_patient dbname="table_vide.soins_periode_patient" )
 column=(type=char(1) updatewhereclause=yes name=reglements_patient dbname="table_vide.reglements_patient" )
 column=(type=char(40) updatewhereclause=yes name=libelle_soin dbname="code_soins.libelle_soin" )
 column=(type=decimal(1) updatewhereclause=yes name=numero_soin dbname="soins.numero_soin" )
 retrieve="  SELECT ~"patient~".~"nom~",   
         ~"patient~".~"nom_parent1~",   
         ~"patient~".~"ville_parent1~",   
         ~"patient~".~"teldom_parent1~",   
         ~"patient~".~"teltra_parent1~",   
         ~"patient~".~"code_praticien~",   
         ~"patient~".~"relance~",   
         ~"patient~".~"lettre_relance~",   
         ~"patient~".~"code~",   
         ~"patient~".~"prenom~",   
         ~"param~".~"symbole_euro~",   
         ~"param~".~"symbole_franc~",   
         ~"param~".~"monnaie_base~",   
         ~"patient~".~"moulage~",  
		~"patient~".~"numero_dossier~", 
         ~"dossier~".~"nom~",   
         ~"code_soins~".~"duree~",   
         ~"soins~".~"date_demande~",   
         ~"soins~".~"total~",   
         (SELECT isnull(sum(paye.montant),0) FROM paye WHERE soins.code = paye.code and soins.cle = paye.cle and paye.~"date~" <= :daref2  ) as total_paye_soin ,   
         dateadd (month,code_soins.duree, soins.date_demande) as date_fin  ,
		datediff (day, ~"soins~".~"date_demande~" , cast(:daref2 as date)) as nb_jours,
		table_vide.v1 as du_prorata ,
		table_vide.v1 as soins_total_proratise ,
		table_vide.v1 as somme_due_patient, 
		table_vide.v1 as total_soins_patient, 
		table_vide.v1 as soins_periode_patient, 
		table_vide.v1 as reglements_patient ,
		code_soins.nom as libelle_soin,
		soins.numero as numero_soin 

    FROM ~"patient~",   
         ~"soins~",   
         ~"param~",   
         ~"dossier~",   
         ~"code_soins~"   , 
		~"table_vide~" 
   WHERE ( ~"soins~".~"code~" = ~"patient~".~"code~" ) and  
         ( ~"dossier~".~"code~" = ~"patient~".~"type_dossier~" ) and  
         ( ~"code_soins~".~"code~" = ~"soins~".~"type~" ) and  
         ( ( ~"patient~".~"numero_dossier~"  between :code_min and :code_max ) AND  
         ( ~"patient~".~"code_praticien~" between :var_pra_min and :var_pra_max ) AND  
         ( ~"soins~".~"date_demande~" between :daref and :daref2 ) AND  
         ( date_fin between :fin1 and :fin2 ) )    
" arguments=(("code_min", number),("code_max", number),("var_pra_min", string),("var_pra_max", string),("daref", date),("daref2", date),("fin1", date),("fin2", date))  sort="code_praticien A nom A patient_prenom A numero_dossier A soins_date_demande A " )
