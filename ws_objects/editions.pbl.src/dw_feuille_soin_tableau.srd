 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"feuille_soins~" ) COLUMN(NAME=~"feuille_soins.date~") COLUMN(NAME=~"feuille_soins.dent~") COLUMN(NAME=~"feuille_soins.lettre~") COLUMN(NAME=~"feuille_soins.nb_lettre~") COLUMN(NAME=~"feuille_soins.motif~") COLUMN(NAME=~"feuille_soins.montant~") COLUMN(NAME=~"feuille_soins.ep~") COLUMN(NAME=~"feuille_soins.libelle~")WHERE(    EXP1 =~"~~~"feuille_soins~~~".~~~"ep~~~"~"   OP =~"=~"    EXP2 =~":v_ep~" ) ) ARG(NAME = ~"v_ep~" TYPE = string) " arguments=(("v_ep", string))  sort="date A lettre A nb_lettre A " )
