 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pile_doctolib~" ) COLUMN(NAME=~"pile_doctolib.date_event~") COLUMN(NAME=~"pile_doctolib.type~") COLUMN(NAME=~"pile_doctolib.action~") COLUMN(NAME=~"pile_doctolib.origine~") COLUMN(NAME=~"pile_doctolib.status~") COLUMN(NAME=~"pile_doctolib.nb_essais~") COLUMN(NAME=~"pile_doctolib.prochain_essai~") COLUMN(NAME=~"pile_doctolib.orthokis_id~") COLUMN(NAME=~"pile_doctolib.doctolib_id~") COLUMN(NAME=~"pile_doctolib.code_retour~") COLUMN(NAME=~"pile_doctolib.message_retour~") COLUMN(NAME=~"pile_doctolib.data_event~")WHERE(    EXP1 =~"~~~"pile_doctolib~~~".~~~"date_event~~~"~"   OP =~"between~"    EXP2 =~":dt_min and :dt_max~" ) ) ARG(NAME = ~"dt_min~" TYPE = datetime)  ARG(NAME = ~"dt_max~" TYPE = datetime) " arguments=(("dt_min", datetime),("dt_max", datetime))  sort="date_event A " )
