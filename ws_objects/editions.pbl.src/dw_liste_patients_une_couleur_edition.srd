gence~") COLUMN(NAME=~"patient.alveo_max_pro~") COLUMN(NAME=~"patient.alveo_max_retro~") COLUMN(NAME=~"patient.alveo_mand_pro~") COLUMN(NAME=~"patient.alveo_mand_retro~") COLUMN(NAME=~"patient.alveo_max_endo~") COLUMN(NAME=~"patient.alveo_max_exo~") COLUMN(NAME=~"patient.alveo_mand_endo~") COLUMN(NAME=~"patient.alveo_mand_exo~") COLUMN(NAME=~"patient.supraclusion~") COLUMN(NAME=~"patient.infraclusion~") COLUMN(NAME=~"patient.mol_cl1~") COLUMN(NAME=~"patient.mol_cl2~") COLUMN(NAME=~"patient.mol_cl3~") COLUMN(NAME=~"patient.can_cl1~") COLUMN(NAME=~"patient.can_cl2~") COLUMN(NAME=~"patient.can_cl3~") COLUMN(NAME=~"patient.molaire~") COLUMN(NAME=~"patient.canine~") COLUMN(NAME=~"patient.dento_max~") COLUMN(NAME=~"patient.dento_dent~") COLUMN(NAME=~"patient.agenesie~") COLUMN(NAME=~"patient.surnum~") COLUMN(NAME=~"patient.malposition~") COLUMN(NAME=~"patient.occl_dte~") COLUMN(NAME=~"patient.occl_gche~") COLUMN(NAME=~"patient.occl_ant~") COLUMN(NAME=~"patient.facteur~") COLUMN(NAME=~"patient.id_invisalign~") COLUMN(NAME=~"patient.diag_dentaire_html~") COLUMN(NAME=~"patient.diag_fonctionnel_html~") COLUMN(NAME=~"patient.plan_complement_html~") COLUMN(NAME=~"patient.extraction~") COLUMN(NAME=~"patient.date_fin_tpi~") COLUMN(NAME=~"patient.mode_reglement_habituel~") COLUMN(NAME=~"patient.code_banque~") COLUMN(NAME=~"patient.iban~") COLUMN(NAME=~"patient.bic~") COLUMN(NAME=~"patient.champ_reprise1~") COLUMN(NAME=~"patient.champ_reprise2~") COLUMN(NAME=~"patient.champ_reprise3~") COLUMN(NAME=~"patient.duree_traitement_unite~") COLUMN(NAME=~"patient.diag_alveolaire_html~") COLUMN(NAME=~"patient.secu_patient~") COLUMN(NAME=~"patient.barre_avancement~") COLUMN(NAME=~"patient.code_comptable~") COMPUTE(NAME=~"(select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_correspondant) as nom_correspondant~") COMPUTE(NAME=~"(select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_dentiste) as nom_dentiste~") COMPUTE(NAME=~"(select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_medecin) as nom_autre1~") COMPUTE(NAME=~"(select nom from dossier where dossier.code = patient.type_dossier) as nom_type_dossier~") COMPUTE(NAME=~"(select nom from prati where prati.code = patient.code_praticien) as nom_praticien~") COMPUTE(NAME=~"(select nom from caisse where caisse.code = patient.code_caisse) as nom_caisse~") COMPUTE(NAME=~"(select nom from mutuelle where mutuelle.code = patient.code_mutuelle) as nom_mutuelle~") COMPUTE(NAME=~"(select nom from ecole where ecole.code = patient.ecole) as nom_ecole~") COMPUTE(NAME=~"(select nom from motif_fin_traitement where motif_fin_traitement.code = patient.motif_fin_traitement) as nom_motif_fin_traitement~") COMPUTE(NAME=~"(select nom from qualite_traitement where qualite_traitement.code = patient.qualite_traitement) as nom_qualite_traitement~") COMPUTE(NAME=~"(select nom from utilisateurs where utilisateurs.code = patient.user_modif) as nom_utilisateur_dernier_modif~") COMPUTE(NAME=~"(select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_medecin2) as nom_autre2~") COMPUTE(NAME=~"(select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_medecin3) as nom_autre3~") COMPUTE(NAME=~"(select nom+ ' '+ isnull(prenom, '') from correspondants where correspondants.code = patient.code_medecin4) as nom_autre4~") COLUMN(NAME=~"patient.autor_rdv_portail_patient~")    JOIN (LEFT=~"pays.code~"    OP =~"=~"RIGHT=~"patient.pays_parent1~"    OUTER2 =~"patient.pays_parent1~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"correspondants.code~"    OP =~"=~"RIGHT=~"patient.code_correspondant~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )) ARG(NAME = ~"v_couleur1~" TYPE = number)  ARG(NAME = ~"v_couleur2~" TYPE = number)  ARG(NAME = ~"v_couleur3~" TYPE = number)  ARG(NAME = ~"v_couleur4~" TYPE = number) " arguments=(("v_couleur1", number),("v_couleur2", number),("v_couleur3", number),("v_couleur4", number))  sort="nom A patient_prenom A " )
