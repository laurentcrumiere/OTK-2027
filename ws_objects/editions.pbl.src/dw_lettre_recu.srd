 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"paye~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"dossier~" )  TABLE(NAME=~"pays~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.date_accord~") COLUMN(NAME=~"soins.scp_accord~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"soins.tp~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"prati.typort~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.nom_parent2~") COLUMN(NAME=~"patient.nom_payeur~") COLUMN(NAME=~"param.payassu~") COLUMN(NAME=~"patient.secu_parent2~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.secu_payeur~") COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"prati.cadre_bas_page~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"param.euro~") COLUMN(NAME=~"patient.nom_assure~") COLUMN(NAME=~"patient.assure~") COLUMN(NAME=~"code_soins.lettre~") COMPUTE(NAME=~"cast(getdate() as date) as date_jour~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"titre_personnes.nom~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"pays.nom~") COMPUTE(NAME=~"(case when nom_payeur is null then nom_parent1 else nom_payeur end) as nom_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then adr1_parent1 else adr1_payeur end) as adr1_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then codep_parent1 else codep_payeur end) as codep_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then ville_parent1 else ville_payeur end) as ville_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then (SELECT titre_personnes.nom from titre_personnes where titre_personnes.code = titre_parent1 )  else  (SELECT titre_personnes.nom from titre_personnes where titre_personnes.code = titre_payeur )  end) as titre_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then (SELECT pays.nom from pays where pays.code = pays_parent1 ) else    (SELECT pays.nom from pays where pays.code = pays_payeur ) end ) as pays_payeur_ou_parent1~") COLUMN(NAME=~"soins.date_exe~") COMPUTE(NAME=~"patient.numero_dossier~") COMPUTE(NAME=~"(case when nom_payeur is null then adr2_parent1 else adr2_payeur end) as adr2_payeur_ou_parent1~") COMPUTE(NAME=~"(select mode_reglement.nom as ~~~"mode~~~" from mode_reglement where paye.~~~"mode~~~" = mode_reglement.code )~") COLUMN(NAME=~"table_vide.v1~") COMPUTE(NAME=~" (SELECT sum(montant) AS paye_total FROM paye WHERE :nocode = paye.code and :nocle = paye.cle )~") COLUMN(NAME=~"patient.somme_due~") COLUMN(NAME=~"patient.secu_patient~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"prati.prenom~") COLUMN(NAME=~"paye.payeur~")    JOIN (LEFT=~"titre_personnes.code~"    OP =~"=~"RIGHT=~"patient.titre_parent1~"    OUTER2 =~"patient.titre_parent1~" )    JOIN (LEFT=~"pays.code~"    OP =~"=~"RIGHT=~"patient.pays_parent1~"    OUTER2 =~"patient.pays_parent1~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"soins.cle~"    OP =~"=~"RIGHT=~"paye.cle~" )    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"paye.code~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )    JOIN (LEFT=~"patient.type_dossier~"    OP =~"=~"RIGHT=~"dossier.code~" )WHERE(    EXP1 =~" ~~~"dba~~~".~~~"paye~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":nocode ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"cle~~~"~"   OP =~"=~"    EXP2 =~":nocle ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"paye~~~".~~~"date~~~"~"   OP =~"=~"    EXP2 =~":da ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"dba~~~".~~~"paye~~~".~~~"montant~~~"~"   OP =~"=~"    EXP2 =~":mo ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"mode~~~"~"   OP =~"=~"    EXP2 =~":var_mode~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"commentaire~~~"~"   OP =~"=~"    EXP2 =~":var_comment~" ) ) ARG(NAME = ~"nocode~" TYPE = number)  ARG(NAME = ~"nocle~" TYPE = number)  ARG(NAME = ~"da~" TYPE = date)  ARG(NAME = ~"mo~" TYPE = number)  ARG(NAME = ~"var_mode~" TYPE = string)  ARG(NAME = ~"var_comment~" TYPE = string) " arguments=(("nocode", number),("nocle", number),("da", date),("mo", number),("var_mode", string),("var_comment", string)) )
