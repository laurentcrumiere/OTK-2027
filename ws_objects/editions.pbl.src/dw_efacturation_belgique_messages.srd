 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"message_efacture_belgique~" ) COLUMN(NAME=~"message_efacture_belgique.code_oa~") COLUMN(NAME=~"message_efacture_belgique.date_envoi~") COLUMN(NAME=~"message_efacture_belgique.date_message~") COLUMN(NAME=~"message_efacture_belgique.type_message~") COLUMN(NAME=~"message_efacture_belgique.message~") COLUMN(NAME=~"message_efacture_belgique.code_praticien~") COLUMN(NAME=~"message_efacture_belgique.message_traite~") COLUMN(NAME=~"message_efacture_belgique.liste_references~") COMPUTE(NAME=~"(select top 1 v1 from table_vide ) as selection~") COLUMN(NAME=~"message_efacture_belgique.numero_envoi~") COLUMN(NAME=~"message_efacture_belgique.factures_acceptees~") COLUMN(NAME=~"message_efacture_belgique.factures_refusees~")WHERE(    EXP1 =~"~~~"message_efacture_belgique~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":v_code_praticien_min and :v_code_praticien_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"message_efacture_belgique~~~".~~~"date_message~~~"~"   OP =~"between~"    EXP2 =~":v_date_message_min and :v_date_message_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"message_efacture_belgique~~~".~~~"message_traite~~~"~"   OP =~"between~"    EXP2 =~":v_traite_min and :v_traite_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"message_efacture_belgique~~~".~~~"code_oa~~~"~"   OP =~"between~"    EXP2 =~":v_code_oa_min and :v_code_oa_max~" ) ) ARG(NAME = ~"v_code_praticien_min~" TYPE = string)  ARG(NAME = ~"v_code_praticien_max~" TYPE = string)  ARG(NAME = ~"v_code_oa_min~" TYPE = string)  ARG(NAME = ~"v_code_oa_max~" TYPE = string)  ARG(NAME = ~"v_date_message_min~" TYPE = date)  ARG(NAME = ~"v_date_message_max~" TYPE = date)  ARG(NAME = ~"v_traite_min~" TYPE = string)  ARG(NAME = ~"v_traite_max~" TYPE = string) " update="message_efacture_belgique" updatewhere=0 updatekeyinplace=no arguments=(("v_code_praticien_min", string),("v_code_praticien_max", string),("v_code_oa_min", string),("v_code_oa_max", string),("v_date_message_min", date),("v_date_message_max", date),("v_traite_min", string),("v_traite_max", string))  sort="code_oa A numero_envoi A date_envoi A date_message A " )
