ionnel~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"diag_alveolaire_html~~~"~"   OP =~"like~"    EXP2 =~":v_diag_alveolaire~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"plan_complement_html~~~"~"   OP =~"like~"    EXP2 =~":v_plan_complement~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"pra_min~" TYPE = string)  ARG(NAME = ~"pra_max~" TYPE = string)  ARG(NAME = ~"v_traitement_effectue~" TYPE = string)  ARG(NAME = ~"v_diag_alveolaire~" TYPE = string)  ARG(NAME = ~"v_diag_dentaire~" TYPE = string)  ARG(NAME = ~"v_plan_traitement~" TYPE = string)  ARG(NAME = ~"v_plan_complement~" TYPE = string)  ARG(NAME = ~"v_diag_fonctionnel~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("pra_min", string),("pra_max", string),("v_traitement_effectue", string),("v_diag_alveolaire", string),("v_diag_dentaire", string),("v_plan_traitement", string),("v_plan_complement", string),("v_diag_fonctionnel", string))  sort="nom A prenom A " )
