 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"ememoire_luxembourg~" )  TABLE(NAME=~"ligne_ememoire_luxembourg~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"soins~" ) COLUMN(NAME=~"ememoire_luxembourg.numero_memoire~") COLUMN(NAME=~"ememoire_luxembourg.date~") COLUMN(NAME=~"ememoire_luxembourg.identifiant_facturier~") COLUMN(NAME=~"ememoire_luxembourg.matricule_patient~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"ligne_ememoire_luxembourg.code_acte~") COLUMN(NAME=~"ligne_ememoire_luxembourg.nombre_acte~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"ligne_ememoire_luxembourg.montant_total~") COLUMN(NAME=~"ligne_ememoire_luxembourg.date_execution~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"prati.prenom~") COLUMN(NAME=~"prati.adresse1~") COLUMN(NAME=~"prati.adresse2~") COLUMN(NAME=~"prati.code_postal~") COLUMN(NAME=~"prati.ville~") COMPUTE(NAME=~"number(*) as numero_ligne~") COLUMN(NAME=~"ligne_ememoire_luxembourg.numero_seance~") COLUMN(NAME=~"ligne_ememoire_luxembourg.lieu_execution~") COLUMN(NAME=~"ligne_ememoire_luxembourg.identifiant_executant~") COMPUTE(NAME=~"(select isnull(sum(montant),0) from paye where paye.code = ememoire_luxembourg.code_patient and paye.cle = ligne_ememoire_luxembourg.cle and paye.tp <> 'O') as montant_paye_soin~") COLUMN(NAME=~"ememoire_luxembourg.numero_memoire_uuid~") COLUMN(NAME=~"ememoire_luxembourg.reponse_simulation_uuid~") COLUMN(NAME=~"ligne_ememoire_luxembourg.dent~") COLUMN(NAME=~"ligne_ememoire_luxembourg.sufix~") COLUMN(NAME=~"ememoire_luxembourg.identifiant_externe_document~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.pays_parent1~") COMPUTE(NAME=~"(select max(~~~"date~~~") from paye where paye.tp <> 'O' and  paye.code = ememoire_luxembourg.code_patient and paye.cle in (select cle from ligne_ememoire_luxembourg where ligne_ememoire_luxembourg.numero_memoire = :v_numero) ) as date_paye_max~") COLUMN(NAME=~"prati.email~") COLUMN(NAME=~"prati.telephone~") COLUMN(NAME=~"ligne_ememoire_luxembourg.montant_caisse~") COLUMN(NAME=~"ligne_ememoire_luxembourg.cle~") COLUMN(NAME=~"prati.code~") COLUMN(NAME=~"soins.date_demande~")    JOIN (LEFT=~"ligne_ememoire_luxembourg.numero_memoire~"    OP =~"=~"RIGHT=~"ememoire_luxembourg.numero_memoire~" )    JOIN (LEFT=~"ligne_ememoire_luxembourg.code_acte~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"ememoire_luxembourg.code_patient~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"ememoire_luxembourg.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"ligne_ememoire_luxembourg.cle~"    OP =~"=~"RIGHT=~"soins.cle~" )WHERE(    EXP1 =~"~~~"ememoire_luxembourg~~~".~~~"numero_memoire~~~"~"   OP =~"=~"    EXP2 =~":v_numero~" ) ) ORDER(NAME=~"ligne_ememoire_luxembourg.date_execution~" ASC=yes )  ORDER(NAME=~"ligne_ememoire_luxembourg.cle~" ASC=yes ) ARG(NAME = ~"v_numero~" TYPE = number) " arguments=(("v_numero", number))  sort="numero_ligne A " )
