table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=long updatewhereclause=yes name=cnext dbname="next" )
 column=(type=char(30) updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(35) updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=datetime updatewhereclause=yes name=rdv_rdv dbname="rdv.rdv" dbalias=".rdv" initial="today" )
 column=(type=char(30) updatewhereclause=yes name=date_rdv dbname="date_rdv" )
 column=(type=date updatewhereclause=yes name=cdate_jour dbname="cdate_jour" )
 column=(type=char(6) updatewhereclause=yes name=rdv_code_praticien dbname="rdv.code_praticien" dbalias=".code_praticien" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(6) updatewhereclause=yes name=rdv_type dbname="rdv.type" dbalias=".type" )
 column=(type=char(20) updatewhereclause=yes name=titre dbname="titre_personnes.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_titre_parent1 dbname="patient.titre_parent1" dbalias=".titre_parent1" )
 column=(type=char(80) updatewhereclause=yes name=prati_entete dbname="prati.entete" dbalias=".entete" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=char(30) updatewhereclause=yes name=pays_parent1 dbname="pays.nom" dbalias=".nom" )
 column=(type=long updatewhereclause=yes name=next_2 dbname="next_2" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(30) updatewhereclause=yes name=param_format_rdv_courrier dbname="param.format_rdv_courrier" dbalias=".format_rdv_courrier" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"rdv~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"pays~" )  TABLE(NAME=~"param~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COMPUTE(NAME=~"(SELECT count(*) AS next FROM rdv WHERE cast (rdv.rdv as date)  >= cast(getdate() as date) and rdv.code = patient.code)~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"rdv.rdv~") COMPUTE(NAME=~"dateformat(~~~"rdv~~~".~~~"rdv~~~", param.format_rdv_courrier) As Date_rdv~") COMPUTE(NAME=~"cast(getdate() as date) as cdate_jour~") COLUMN(NAME=~"rdv.code_praticien~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"rdv.type~") COLUMN(NAME=~"titre_personnes.nom~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"pays.nom~") COMPUTE(NAME=~"(SELECT count(*) AS next_2 FROM rdv as RDV2 WHERE cast(rdv2.rdv as date) > cast (rdv.rdv as date)  and cast(rdv2.rdv as date) < cast(getdate() as date)  and rdv2.absent <> rdv.absent and rdv2.code = patient.code)~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"param.format_rdv_courrier~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"titre_personnes.code~"    OP =~"=~"RIGHT=~"patient.titre_parent1~"    OUTER2 =~"patient.titre_parent1~" )    JOIN (LEFT=~"pays.code~"    OP =~"=~"RIGHT=~"patient.pays_parent1~"    OUTER2 =~"patient.pays_parent1~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"rdv.code~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"rdv.code_praticien~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cast(~~~"rdv~~~".~~~"rdv~~~" as date)~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdv~~~".~~~"absent~~~"~"   OP =~"=~"    EXP2 =~":absent~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"absent~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("absent", string))  sort="rdv_code_praticien A nom A prenom A " )
