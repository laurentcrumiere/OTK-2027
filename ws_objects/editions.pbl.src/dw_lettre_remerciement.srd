table(column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" )
 column=(type=char(30) updatewhereclause=yes name=cor_nom dbname="correspondants.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=cor_adr1 dbname="correspondants.adr1" dbalias=".adr1" )
 column=(type=char(30) updatewhereclause=yes name=cor_adr2 dbname="correspondants.adr2" dbalias=".adr2" )
 column=(type=char(5) updatewhereclause=yes name=cor_codep dbname="correspondants.codep" dbalias=".codep" )
 column=(type=char(30) updatewhereclause=yes name=cor_ville dbname="correspondants.ville" dbalias=".ville" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(80) updatewhereclause=yes name=prati_entete dbname="prati.entete" dbalias=".entete" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=decimal(0) updatewhereclause=yes name=correspondants_titre dbname="correspondants.titre" dbalias=".titre" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=char(30000) updatewhereclause=yes name=patient_traitement_effectue dbname="patient.traitement_effectue" dbalias=".traitement_effectue" )
 column=(type=char(30000) updatewhereclause=yes name=patient_plan_traitement dbname="patient.plan_traitement" dbalias=".plan_traitement" )
 column=(type=date updatewhereclause=yes name=cdate_jour dbname="date_jour" )
 column=(type=char(20) updatewhereclause=yes name=titre dbname="titre_personnes.nom" dbalias=".nom" )
 column=(type=date updatewhereclause=yes name=dernier_rdv dbname="dernier_rdv" )
 column=(type=char(30) updatewhereclause=yes name=cor_pays dbname="pays.nom" dbalias=".nom" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"correspondants~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"pays~" ) COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"correspondants.adr1~") COLUMN(NAME=~"correspondants.adr2~") COLUMN(NAME=~"correspondants.codep~") COLUMN(NAME=~"correspondants.ville~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"correspondants.titre~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.traitement_effectue~") COLUMN(NAME=~"patient.plan_traitement~") COMPUTE(NAME=~"cast(getdate() as date) as date_jour~") COLUMN(NAME=~"titre_personnes.nom~") COMPUTE(NAME=~"(select dernier_rdv from rdv_passe_le_plus_recent where code = :nocode)~") COLUMN(NAME=~"pays.nom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"titre_personnes.code~"    OP =~"=~"RIGHT=~"correspondants.titre~"    OUTER2 =~"correspondants.titre~" )    JOIN (LEFT=~"pays.code~"    OP =~"=~"RIGHT=~"correspondants.pays~"    OUTER2 =~"correspondants.pays~" )    JOIN (LEFT=~"correspondants.code~"    OP =~"=~"RIGHT=~"patient.code_correspondant~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )WHERE(    EXP1 =~":nocode~"   OP =~"=~"    EXP2 =~"~~~"patient~~~".~~~"code~~~"~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " arguments=(("nocode", number)) )
