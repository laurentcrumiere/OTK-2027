table(column=(type=char(6) updatewhereclause=yes name=type_rdv_code dbname="type_rdv.code" dbalias=".code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" dbalias=".nom" )
 column=(type=long updatewhereclause=yes name=nb_mois1 dbname="nb_mois1" )
 column=(type=char(50) updatewhereclause=yes name=famille_rdv_nom dbname="famille_rdv.nom" dbalias=".nom" )
 column=(type=number updatewhereclause=yes name=famille_rdv_couleur dbname="famille_rdv.couleur" dbalias=".couleur" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" dbalias=".couleur" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_symbole dbname="type_rdv.symbole" dbalias=".symbole" )
 column=(type=char(30) updatewhereclause=yes name=prat1_nom dbname="prat1_nom" )
 column=(type=long updatewhereclause=yes name=nb_mois2 dbname="nb_mois2" )
 column=(type=long updatewhereclause=yes name=nb_annee1 dbname="nb_annee1" )
 column=(type=long updatewhereclause=yes name=nb_annee2 dbname="nb_annee2" )
 column=(type=char(50) updatewhereclause=yes name=nom_famille dbname="nom_famille" )
 column=(type=number updatewhereclause=yes name=couleur_famille dbname="couleur_famille" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"famille_rdv~" ) COLUMN(NAME=~"type_rdv.code~") COLUMN(NAME=~"type_rdv.nom~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_mois1 from rdv, etat_rdv, agenda where rdv.~~~"type~~~" = type_rdv.code and  rdv.absent = etat_rdv.code and rdv.code between :code1 and :code2 and year(rdv) = :annee1 and month(rdv) = :mois and  ~~~"rdv~~~".~~~"code_praticien~~~" between :prat1 and :prat2  AND   ((~~~"rdv~~~".~~~"fauteuil~~~" <= ~~~"agenda~~~".~~~"nombre_fauteuil~~~"  AND    ~~~"agenda~~~".~~~"urgence~~~" = 'N') OR   (~~~"rdv~~~".~~~"fauteuil~~~" <= ~~~"agenda~~~".~~~"nombre_fauteuil~~~"  + 1 AND   ~~~"agenda~~~".~~~"urgence~~~" = 'O')) AND  ~~~"etat_rdv~~~".~~~"elimine_agenda~~~" <> 'O'  )~") COLUMN(NAME=~"famille_rdv.nom~") COLUMN(NAME=~"famille_rdv.couleur~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"type_rdv.symbole~") COMPUTE(NAME=~"(SELECT nom from prati where code = :prat1 ) as prat1_nom~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_mois2 from rdv, etat_rdv, agenda where rdv.~~~"type~~~" = type_rdv.code and  rdv.absent = etat_rdv.code and rdv.code between :code1 and :code2 and year(rdv) = :annee2 and month(rdv) = :mois and  ~~~"rdv~~~".~~~"code_praticien~~~" between :prat1 and :prat2  AND   ((~~~"rdv~~~".~~~"fauteuil~~~" <= ~~~"agenda~~~".~~~"nombre_fauteuil~~~"  AND    ~~~"agenda~~~".~~~"urgence~~~" = 'N') OR   (~~~"rdv~~~".~~~"fauteuil~~~" <= ~~~"agenda~~~".~~~"nombre_fauteuil~~~"  + 1 AND   ~~~"agenda~~~".~~~"urgence~~~" = 'O')) AND  ~~~"etat_rdv~~~".~~~"elimine_agenda~~~" <> 'O'  )~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_annee1 from rdv, etat_rdv, agenda where rdv.~~~"type~~~" = type_rdv.code and  rdv.absent = etat_rdv.code and rdv.code between :code1 and :code2 and year(rdv) = :annee1 and month(rdv) <= :mois and  ~~~"rdv~~~".~~~"code_praticien~~~" between :prat1 and :prat2  AND   ((~~~"rdv~~~".~~~"fauteuil~~~" <= ~~~"agenda~~~".~~~"nombre_fauteuil~~~"  AND    ~~~"agenda~~~".~~~"urgence~~~" = 'N') OR   (~~~"rdv~~~".~~~"fauteuil~~~" <= ~~~"agenda~~~".~~~"nombre_fauteuil~~~"  + 1 AND   ~~~"agenda~~~".~~~"urgence~~~" = 'O')) AND  ~~~"etat_rdv~~~".~~~"elimine_agenda~~~" <> 'O'  )~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_annee2 from rdv, etat_rdv, agenda where rdv.~~~"type~~~" = type_rdv.code and  rdv.absent = etat_rdv.code and rdv.code between :code1 and :code2 and year(rdv) = :annee2 and month(rdv) <= :mois and  ~~~"rdv~~~".~~~"code_praticien~~~" between :prat1 and :prat2  AND   ((~~~"rdv~~~".~~~"fauteuil~~~" <= ~~~"agenda~~~".~~~"nombre_fauteuil~~~"  AND    ~~~"agenda~~~".~~~"urgence~~~" = 'N') OR   (~~~"rdv~~~".~~~"fauteuil~~~" <= ~~~"agenda~~~".~~~"nombre_fauteuil~~~"  + 1 AND   ~~~"agenda~~~".~~~"urgence~~~" = 'O')) AND  ~~~"etat_rdv~~~".~~~"elimine_agenda~~~" <> 'O'  )~") COMPUTE(NAME=~"(select top 1 nom as nom_famille from famille_rdv,type_rdv_famille where type_rdv.code = type_rdv_famille.code_type_rdv and type_rdv_famille.code_famille_rdv = famille_rdv.code order by ordre_trie, nom )~") COMPUTE(NAME=~"(select top 1 couleur as couleur_famille from famille_rdv,type_rdv_famille where type_rdv.code = type_rdv_famille.code_type_rdv and type_rdv_famille.code_famille_rdv = famille_rdv.code order by ordre_trie, nom )~")    JOIN (LEFT=~"famille_rdv.code~"    OP =~"=~"RIGHT=~"type_rdv.famille~"    OUTER2 =~"type_rdv.famille~" )) ARG(NAME = ~"code1~" TYPE = number)  ARG(NAME = ~"code2~" TYPE = number)  ARG(NAME = ~"prat1~" TYPE = string)  ARG(NAME = ~"prat2~" TYPE = string)  ARG(NAME = ~"mois~" TYPE = number)  ARG(NAME = ~"annee1~" TYPE = number)  ARG(NAME = ~"annee2~" TYPE = number) " filter=" nb_annee1 + nb_annee2 > 0"arguments=(("code1", number),("code2", number),("prat1", string),("prat2", string),("mois", number),("annee1", number),("annee2", number))  sort="nom_famille A type_rdv_nom A " )
