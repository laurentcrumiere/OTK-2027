table(column=(type=char(20) updatewhereclause=yes name=mode_reglement_nom dbname="mode_reglement_nom" )
 column=(type=decimal(0) updatewhereclause=yes name=paye_montant dbname="paye_montant" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mode_reglement~" )  TABLE(NAME=~"paye~" ) COLUMN(NAME=~"mode_reglement.nom~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.montant~") COMPUTE(NAME=~"right(string( 100 + month(~~~"date~~~"))+' - '+string(year(~~~"date~~~")),9) as mois_annee~")    JOIN (LEFT=~"mode_reglement.code~"    OP =~"=~"RIGHT=~"paye.mode~" )WHERE(    EXP1 =~"~~~"paye~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date))  sort="mode_reglement_nom A " )
