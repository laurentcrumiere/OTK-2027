ment~~~".~~~"acte_prevu_html~~~"~"   OP =~"like~"    EXP2 =~":texte2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"coment~~~".~~~"com3_html~~~"~"   OP =~"like~"    EXP2 =~":texte3~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"coment~~~".~~~"com4_html~~~"~"   OP =~"like~"    EXP2 =~":texte4~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"coment~~~".~~~"com5_html~~~"~"   OP =~"like~"    EXP2 =~":texte5~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"coment~~~".~~~"com6_html~~~"~"   OP =~"like~"    EXP2 =~":texte6~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"texte_recherche~" TYPE = string)  ARG(NAME = ~"texte2~" TYPE = string)  ARG(NAME = ~"texte3~" TYPE = string)  ARG(NAME = ~"texte4~" TYPE = string)  ARG(NAME = ~"texte5~" TYPE = string)  ARG(NAME = ~"texte6~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("texte_recherche", string),("texte2", string),("texte3", string),("texte4", string),("texte5", string),("texte6", string))  sort="nom A patient_prenom A numero_dossier A coment_dat A coment_com A " )
