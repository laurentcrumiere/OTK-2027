$PBExportHeader$dw_tableau_premier_visite.srd
release 7;
datawindow(units=0 timer_interval=0 color=1090519039 processing=4 HTMLDW=no print.documentname="" print.orientation = 1 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no  crosstab.dynamic = yes grid.lines=0 grid.columnmove=no selected.mouse=no )
header[1](height=0 color="536870912" )
header[2](height=92 color="536870912" )
summary(height=96 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=nom dbname="nom" )
 column=(type=number updatewhereclause=yes name=annee_premiere_visite dbname="annee_premiere_visite" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" ) COLUMN(NAME=~"prati.nom~") COMPUTE(NAME=~"(case when patient.premiere_visite is null then 0 else year(patient.premiere_visite) end) as annee_premiere_visite~")    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":cmin and :cmax~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":pramin and :pramax~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"premiere_visite~~~"~"   OP =~"between~"    EXP2 =~":dmin  and :dmax~" ) ) ARG(NAME = ~"cmin~" TYPE = number)  ARG(NAME = ~"cmax~" TYPE = number)  ARG(NAME = ~"pramin~" TYPE = string)  ARG(NAME = ~"pramax~" TYPE = string)  ARG(NAME = ~"dmin~" TYPE = date)  ARG(NAME = ~"dmax~" TYPE = date) " arguments=(("cmin", number),("cmax", number),("pramin", string),("pramax", string),("dmin", date),("dmax", date))  sort="nom A " )
text(band=header[1] alignment="0" text="Count Of Annee Premiere Visite" border="0" color="0" x="9" y="4" height="52" width="617"  name=t_1  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
