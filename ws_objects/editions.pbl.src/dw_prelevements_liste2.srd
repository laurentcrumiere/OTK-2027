table(column=(type=datetime updatewhereclause=yes name=prelevements_date_generation dbname="prelevements.date_generation" dbalias=".date_generation" )
 column=(type=char(200) updatewhereclause=yes name=prelevements_commentaire dbname="prelevements.commentaire" dbalias=".commentaire" )
 column=(type=char(6) updatewhereclause=yes name=prelevements_user_modif dbname="prelevements.user_modif" dbalias=".user_modif" )
 column=(type=date updatewhereclause=yes name=ligne_prelevements_date_prelevement dbname="ligne_prelevements.date_prelevement" dbalias=".date_prelevement" )
 column=(type=decimal(2) updatewhereclause=yes name=ligne_prelevements_montant_prelevement dbname="ligne_prelevements.montant_prelevement" dbalias=".montant_prelevement" )
 column=(type=char(30) updatewhereclause=yes name=utilisateurs_nom dbname="utilisateurs.nom" dbalias=".nom" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" dbalias=".nom" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" dbalias=".numero" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" dbalias=".date_demande" initial="null" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=number updatewhereclause=yes name=ligne_prelevements_code dbname="ligne_prelevements.code" dbalias=".code" )
 column=(type=number updatewhereclause=yes name=ligne_prelevements_code_prelevement dbname="ligne_prelevements.code_prelevement" dbalias=".code_prelevement" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" dbalias=".email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" dbalias=".email_patient" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_parent2 dbname="patient.email_parent2" dbalias=".email_parent2" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" dbalias=".code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ligne_prelevements~" )  TABLE(NAME=~"prelevements~" )  TABLE(NAME=~"utilisateurs~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"soins~" ) COLUMN(NAME=~"prelevements.date_generation~") COLUMN(NAME=~"prelevements.commentaire~") COLUMN(NAME=~"prelevements.user_modif~") COLUMN(NAME=~"ligne_prelevements.date_prelevement~") COLUMN(NAME=~"ligne_prelevements.montant_prelevement~") COLUMN(NAME=~"utilisateurs.nom~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"ligne_prelevements.code~") COLUMN(NAME=~"ligne_prelevements.code_prelevement~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.email_parent2~") COLUMN(NAME=~"patient.code~")    JOIN (LEFT=~"prelevements.user_modif~"    OP =~"=~"RIGHT=~"utilisateurs.code~"    OUTER1 =~"prelevements.user_modif~" )    JOIN (LEFT=~"prelevements.code~"    OP =~"=~"RIGHT=~"ligne_prelevements.code_prelevement~" )    JOIN (LEFT=~"ligne_prelevements.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"ligne_prelevements.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"ligne_prelevements.cle_soins~"    OP =~"=~"RIGHT=~"soins.cle~" )WHERE(    EXP1 =~"~~~"ligne_prelevements~~~".~~~"code_prelevement~~~"~"   OP =~"=~"    EXP2 =~":v_code_prelevement~" ) ) ARG(NAME = ~"v_code_prelevement~" TYPE = number) " arguments=(("v_code_prelevement", number))  sort="patient_nom A patient_prenom A ligne_prelevements_date_prelevement A ligne_prelevements_montant_prelevement A " )
