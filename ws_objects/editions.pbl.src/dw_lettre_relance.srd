table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(35) update=yes updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) update=yes updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) update=yes updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=somme_due_franc dbname="patient.somme_due" dbalias=".somme_due" )
 column=(type=char(6) update=yes updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" )
 column=(type=char(80) updatewhereclause=yes name=prati_entete dbname="prati.entete" dbalias=".entete" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=patient_titre_parent1 dbname="patient.titre_parent1" dbalias=".titre_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(30) updatewhereclause=yes name=prati_nom dbname="prati.nom" dbalias=".nom" )
 column=(type=date updatewhereclause=yes name=cdate_jour dbname="date_jour" )
 column=(type=decimal(2) updatewhereclause=yes name=somme_due_euro dbname="patient.mont_proc_reglt" dbalias=".mont_proc_reglt" )
 column=(type=char(50) updatewhereclause=yes name=nom_payeur_ou_parent1 dbname="nom_payeur_ou_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr1_payeur_ou_parent1 dbname="adr1_payeur_ou_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr2_payeur_ou_parent1 dbname="adr2_payeur_ou_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_payeur_ou_parent1 dbname="codep_payeur_ou_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_payeur_ou_parent1 dbname="ville_payeur_ou_parent1" )
 column=(type=char(20) updatewhereclause=yes name=titre_payeur_ou_parent1 dbname="titre_payeur_ou_parent1" )
 column=(type=char(20) updatewhereclause=yes name=titre dbname="titre_personnes.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=pays_parent1 dbname="pays.nom" dbalias="pays_a.nom" )
 column=(type=char(30) updatewhereclause=yes name=pays_payeur_ou_parent1 dbname="pays_payeur_ou_parent1" )
 column=(type=decimal(0) updatewhereclause=yes name=code dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) updatewhereclause=yes name=prati_prenom dbname="prati.prenom" dbalias=".prenom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"titre_personnes~" )  TABLE(NAME=~"pays~" ALIAS=~"pays_a~" )  TABLE(NAME=~"pays~" ALIAS=~"pays_b~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.somme_due~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"patient.titre_parent1~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"prati.nom~") COMPUTE(NAME=~"cast(getdate() as date) as date_jour~") COLUMN(NAME=~"patient.mont_proc_reglt~") COMPUTE(NAME=~"(case when nom_payeur is null then nom_parent1 else nom_payeur end) as nom_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then adr1_parent1 else adr1_payeur end) as adr1_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then adr2_parent1 else adr2_payeur end) as adr2_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then codep_parent1 else codep_payeur end) as codep_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then ville_parent1 else ville_payeur end) as ville_payeur_ou_parent1~") COMPUTE(NAME=~"(case when nom_payeur is null then (SELECT titre_personnes.nom from titre_personnes where titre_personnes.code = titre_parent1 )  else  (SELECT titre_personnes.nom from titre_personnes where titre_personnes.code = titre_payeur )  end) as titre_payeur_ou_parent1~") COLUMN(NAME=~"titre_personnes.nom~") COLUMN(NAME=~"pays_a.nom~") COMPUTE(NAME=~"(case when nom_payeur is null then pays_a.nom else  pays_b.nom end) as pays_payeur_ou_parent1~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"prati.prenom~")    JOIN (LEFT=~"titre_personnes.code~"    OP =~"=~"RIGHT=~"patient.titre_parent1~"    OUTER2 =~"patient.titre_parent1~" )    JOIN (LEFT=~"pays_a.code~"    OP =~"=~"RIGHT=~"patient.pays_parent1~"    OUTER2 =~"patient.pays_parent1~" )    JOIN (LEFT=~"patient.pays_payeur~"    OP =~"=~"RIGHT=~"pays_b.nom~"    OUTER1 =~"patient.pays_payeur~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )WHERE(    EXP1 =~":nocode~"   OP =~"=~"    EXP2 =~"~~~"patient~~~".~~~"code~~~"~" ) ) ARG(NAME = ~"nocode~" TYPE = number) " arguments=(("nocode", number)) )
