table(column=(type=char(10) updatewhereclause=yes key=yes name=cle dbname="param.cle" dbalias=".cle" )
 column=(type=long updatewhereclause=yes name=total dbname="total" )
 column=(type=long updatewhereclause=yes name=pas_debut dbname="pas_debut" )
 column=(type=long updatewhereclause=yes name=mois1 dbname="mois1" )
 column=(type=long updatewhereclause=yes name=mois2 dbname="mois2" )
 column=(type=long updatewhereclause=yes name=mois3 dbname="mois3" )
