 retrieve="  SELECT ~"param~".~"cle~",   
         (select count(*) as total from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max),   
         (select count(*) as pas_debut from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and premiere_visite is null),   
         (select count(*) as mois1 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) <= 30),   
         (select count(*) as mois2 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 31 and 60),   
         (select count(*) as mois3 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 61 and 90),   
         (select count(*) as mois4 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 91 and 120),   
         (select count(*) as mois5 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 121 and 150),   
         (select count(*) as mois6 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 151 and 180),   
         (select count(*) as mois7 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 181 and 210),   
         (select count(*) as mois8 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 211 and 240),   
         (select count(*) as mois9 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 241 and 270),   
         (select count(*) as mois10 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 271 and 300),   
         (select count(*) as mois11 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 301 and 330),   
         (select count(*) as mois12 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 331 and 365),   
         (select count(*) as mois18 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 366 and 547),   
         (select count(*) as mois24 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) between 548 and 730),   
         (select count(*) as mois99 from patient where numero_dossier between :code_min and :code_max and date_contact between :date_min and :date_max and code_praticien between :prat_min and :prat_max and type_dossier between :dos_min and :dos_max and datediff (day, date_contact, premiere_visite) > 730)   
    FROM ~"param~"   
" update="param" updatewhere=1 updatekeyinplace=no arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("dos_min", string),("dos_max", string)) )
