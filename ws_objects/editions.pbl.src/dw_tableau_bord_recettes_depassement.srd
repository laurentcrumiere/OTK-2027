table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) updatewhereclause=yes name=paye_payeur dbname="paye.payeur" dbalias=".payeur" )
 column=(type=date updatewhereclause=yes name=paye_dateremise dbname="paye.dateremise" dbalias=".dateremise" )
 column=(type=decimal(2) updatewhereclause=yes name=paye_montant dbname="paye.montant" dbalias=".montant" )
 column=(type=date updatewhereclause=yes name=paye_date dbname="paye.date" dbalias=".date" )
 column=(type=char(1) updatewhereclause=yes name=paye_mode dbname="paye.mode" dbalias=".mode" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" )
 column=(type=char(40) updatewhereclause=yes name=paye_commentaire dbname="paye.commentaire" dbalias=".commentaire" )
 column=(type=char(10) updatewhereclause=yes name=soins_type dbname="soins.type" dbalias=".type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_scp_demande dbname="soins.scp_demande" dbalias=".scp_demande" initial="null" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_hn dbname="soins.hn" dbalias=".hn" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" dbalias=".total" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(6) updatewhereclause=yes name=paye_code_praticien dbname="paye.code_praticien" dbalias=".code_praticien" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=number update=yes updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(1) updatewhereclause=yes name=paye_monnaie dbname="paye.monnaie" dbalias=".monnaie" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" dbalias=".lettre" )
 column=(type=long updatewhereclause=yes name=numero_ligne dbname="numero_ligne" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" dbalias=".nom" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" dbalias=".code" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"paye~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"code_soins~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"paye.code_praticien~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"paye.monnaie~") COLUMN(NAME=~"code_soins.lettre~") COMPUTE(NAME=~"row_number() over (order by patient.code )  as numero_ligne~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"patient.numero_dossier~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"paye.code~" )    JOIN (LEFT=~"paye.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"paye.cle~"    OP =~"=~"RIGHT=~"soins.cle~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":var_prat_min and :var_prat_max~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"var_prat_min~" TYPE = string)  ARG(NAME = ~"var_prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " filter=" paye_mode  <>  'S'"arguments=(("code_min", number),("code_max", number),("var_prat_min", string),("var_prat_max", string),("date_min", date),("date_max", date))  sort="code_soins_nom A code_soins_code A paye_date A nom A patient_prenom A code A paye_commentaire A " )
