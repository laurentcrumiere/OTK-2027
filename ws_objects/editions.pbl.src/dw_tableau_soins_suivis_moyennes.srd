table(column=(type=char(40) updatewhereclause=yes name=soins_suivis_nom dbname="soins_suivis.nom" )
 column=(type=number updatewhereclause=yes name=nombre_moyen dbname="nombre_moyen" )
 column=(type=long updatewhereclause=yes name=actif dbname="soins_suivis.actif" )
 column=(type=long updatewhereclause=yes name=ordre_trie dbname="soins_suivis.ordre_trie" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"soins_suivis~" ) COLUMN(NAME=~"soins_suivis.nom~") COMPUTE(NAME=~"(select avg(nombre) as nombre_moyen from soins_suivis_statistiques where soins_suivis.code = soins_suivis_statistiques .code_soins_suivis)~") COLUMN(NAME=~"soins_suivis.actif~") COLUMN(NAME=~"soins_suivis.ordre_trie~")WHERE(    EXP1 =~"~~~"soins_suivis~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) "  sort="ordre_trie A soins_suivis_nom A " )
