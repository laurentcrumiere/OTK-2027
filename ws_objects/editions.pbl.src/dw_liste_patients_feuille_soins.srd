table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_scp_demande dbname="soins.scp_demande" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=number updatewhereclause=yes name=soins_cle dbname="soins.cle" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=number updatewhereclause=yes name=soins_code dbname="soins.code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(1) updatewhereclause=yes name=code_soins_renouvt dbname="code_soins.renouvt" )
 column=(type=char(30) updatewhereclause=yes name=caisse_nom dbname="caisse.nom" )
 column=(type=char(10) updatewhereclause=yes name=soins_type dbname="soins.type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" )
 column=(type=char(40) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" )
 column=(type=char(1) updatewhereclause=yes name=soins_fse_edite dbname="soins.fse_edite" )
 column=(type=date updatewhereclause=yes name=soins_date_exe dbname="soins.date_exe" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" )
 column=(type=date updatewhereclause=yes name=soins_date_fs dbname="soins.date_fs" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_soin dbname="montant_soin" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_paye dbname="montant_paye" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" )
 column=(type=char(1) updatewhereclause=yes name=mode_reglement_habituel dbname="mode_reglement_habituel" )
 column=(type=datetime updatewhereclause=yes name=prochain_rdv dbname="prochain_rdv" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_parent2 dbname="patient.email_parent2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"caisse~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"code_soins.renouvt~") COLUMN(NAME=~"caisse.nom~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"code_soins.nom~") COLUMN(NAME=~"soins.fse_edite~") COLUMN(NAME=~"soins.date_exe~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"soins.date_fs~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COMPUTE(NAME=~"(select isnull(sum(ligne_soins.montant),0) from ligne_soins where soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = :v_tp) as montant_soin~") COMPUTE(NAME=~"(select isnull(sum(paye.montant),0) from paye where soins.code = paye.code and soins.cle = paye.cle and paye.tp = :v_tp) as montant_paye~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COMPUTE(NAME=~"isnull(patient.mode_reglement_habituel,'') as mode_reglement_habituel~") COMPUTE(NAME=~"( SELECT min(~~~"rdv~~~".~~~"rdv~~~") FROM ~~~"dba~~~".~~~"rdv~~~"  , ~~~"etat_rdv~~~"   WHERE ( ~~~"rdv~~~".~~~"code~~~" = patient.code ) AND  ( ~~~"rdv~~~".~~~"rdv~~~" > dateadd( minute, 60 , getdate()) ) and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' ) as prochain_rdv~") COLUMN(NAME=~"patient.email_parent2~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"caisse.code~"    OP =~"=~"RIGHT=~"patient.code_caisse~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_exe~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"adulte~~~"~"   OP =~"between~"    EXP2 =~":adu_min and :adu_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"code_soins~~~".~~~"fs~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"adu_min~" TYPE = string)  ARG(NAME = ~"adu_max~" TYPE = string)  ARG(NAME = ~"v_tp~" TYPE = string) " filter="/*( soins_type = 'S' )  or ( soins_type  = 'C' ) or ( soins_type = 'D' and  soins_scp_demande = 10 )*/
 code_soins_renouvt = 'O'"arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("adu_min", string),("adu_max", string),("v_tp", string))  sort="nom A patient_prenom A " )
