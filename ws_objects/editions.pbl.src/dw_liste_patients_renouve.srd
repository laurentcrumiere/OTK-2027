table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=date updatewhereclause=yes name=soins_date_demande dbname="soins.date_demande" dbalias=".date_demande" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_scp_demande dbname="soins.scp_demande" dbalias=".scp_demande" )
 column=(type=decimal(1) updatewhereclause=yes name=soins_numero dbname="soins.numero" dbalias=".numero" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=number updatewhereclause=yes name=soins_cle dbname="soins.cle" dbalias=".cle" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=number updatewhereclause=yes name=soins_code dbname="soins.code" dbalias=".code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(1) updatewhereclause=yes name=code_soins_renouvt dbname="code_soins.renouvt" dbalias=".renouvt" )
 column=(type=char(30) updatewhereclause=yes name=caisse_nom dbname="caisse.nom" dbalias=".nom" )
 column=(type=date updatewhereclause=yes name=soins_date_impr dbname="soins.date_impr" dbalias=".date_impr" )
 column=(type=char(20) updatewhereclause=yes name=soins_type dbname="soins.type" dbalias=".type" values="Semestre	S/Contention	C/Divers	D/Consultation	O/Radio	R/Hors Nomenclature	H/" )
 column=(type=char(20) updatewhereclause=yes name=code_soins_code dbname="code_soins.code" dbalias=".code" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=char(200) updatewhereclause=yes name=code_soins_nom dbname="code_soins.nom" dbalias=".nom" )
 column=(type=char(30000) updatewhereclause=yes name=dern_com dbname="dern_com" )
 column=(type=date updatewhereclause=yes name=date_com dbname="date_com" )
 column=(type=char(30000) updatewhereclause=yes name=dern_acte_prevu dbname="dern_acte_prevu" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(1) updatewhereclause=yes name=cmu dbname="patient.cmu" dbalias=".cmu" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" dbalias=".com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" dbalias=".secu_parent1" )
 column=(type=decimal(2) updatewhereclause=yes name=soins_total dbname="soins.total" dbalias=".total" )
 column=(type=char(2) updatewhereclause=yes name=mise_en_evidence dbname="patient.mise_en_evidence" dbalias=".mise_en_evidence" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" dbalias=".email_patient" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" dbalias=".email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_parent2 dbname="patient.email_parent2" dbalias=".email_parent2" )
 column=(type=date updatewhereclause=yes name=patient_date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=date updatewhereclause=yes name=patient_debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"caisse~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"soins.date_demande~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.numero~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"soins.cle~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"soins.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"code_soins.renouvt~") COLUMN(NAME=~"caisse.nom~") COLUMN(NAME=~"soins.date_impr~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"code_soins.code~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"code_soins.nom~") COMPUTE(NAME=~" (SELECT max(com) as Dern_com FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code ) and coment.code = patient.code )~") COMPUTE(NAME=~" (SELECT max(dat) as Date_com FROM coment WHERE coment.code = patient.code )~") COMPUTE(NAME=~" (SELECT max(acte_prevu) as Dern_acte_prevu FROM coment WHERE dat = (SELECT max(dat) FROM coment WHERE coment.code = patient.code ) and coment.code = patient.code )~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.cmu~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"patient.mise_en_evidence~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_parent2~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.debut_traitement~")    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"soins.type~"    OP =~"=~"RIGHT=~"code_soins.code~" )    JOIN (LEFT=~"caisse.code~"    OP =~"=~"RIGHT=~"patient.code_caisse~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~" ~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"date_demande~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"adulte~~~"~"   OP =~"between~"    EXP2 =~":adu_min and :adu_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"code_soins~~~".~~~"renouvt~~~"~"   OP =~"=~"    EXP2 =~"'O'~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"adu_min~" TYPE = string)  ARG(NAME = ~"adu_max~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("adu_min", string),("adu_max", string))  sort="nom A patient_prenom A " )
