table(column=(type=decimal(2) updatewhereclause=yes name=montant_facture dbname="montant_facture" )
 column=(type=char(3) updatewhereclause=yes name=code_oa dbname="envoi_efacture_belgique.code_oa" dbalias=".code_oa" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="envoi_efacture_belgique.code_praticien" dbalias=".code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_envoi dbname="envoi_efacture_belgique.numero_envoi" dbalias=".numero_envoi" )
 column=(type=date updatewhereclause=yes name=date_envoi dbname="envoi_efacture_belgique.date_envoi" dbalias=".date_envoi" )
 column=(type=char(1) updatewhereclause=yes name=statut_envoi dbname="envoi_efacture_belgique.statut_envoi" dbalias=".statut_envoi" values="A envoyer	 /Envoyé	E/Accepté	A/Non accepté	N/Traité	T/Rejeté	R/Reçu par l'OA	U/Rejets informatif	I/" )
 column=(type=decimal(0) updatewhereclause=yes name=efacture_belgique_numero_facture dbname="efacture_belgique.numero_facture" dbalias=".numero_facture" )
 column=(type=date updatewhereclause=yes name=efacture_belgique_date_facture dbname="efacture_belgique.date_facture" dbalias=".date_facture" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=decimal(2) updatewhereclause=yes name=montant_facture_a_encaisser dbname="montant_facture_a_encaisser" )
 column=(type=char(1) updatewhereclause=yes name=efacture_belgique_paiement_effectue dbname="efacture_belgique.paiement_effectue" dbalias=".paiement_effectue" )
 column=(type=char(1) updatewhereclause=yes name=efacture_belgique_statut_my_carenet dbname="efacture_belgique.statut_my_carenet" dbalias=".statut_my_carenet" values="Non envoyée	 /Envoyée	E/A renvoyer	A/Validée	V/Refusée	R/Rejet Informatif	I/Reçue par l'OA	U/" )
 column=(type=char(1) updatewhereclause=yes name=efacture_belgique_type_facture dbname="efacture_belgique.type_facture" dbalias=".type_facture" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"envoi_efacture_belgique~" )  TABLE(NAME=~"efacture_belgique~" )  TABLE(NAME=~"ligne_envoi_efacture_belgique~" )  TABLE(NAME=~"patient~" ) COMPUTE(NAME=~"(select sum(montant_rembourse_oa) from ligne_efacture_belgique where ligne_efacture_belgique.numero_facture =  ligne_envoi_efacture_belgique.numero_facture ) as montant_facture~") COLUMN(NAME=~"envoi_efacture_belgique.code_oa~") COLUMN(NAME=~"envoi_efacture_belgique.code_praticien~") COLUMN(NAME=~"envoi_efacture_belgique.numero_envoi~") COLUMN(NAME=~"envoi_efacture_belgique.date_envoi~") COLUMN(NAME=~"envoi_efacture_belgique.statut_envoi~") COLUMN(NAME=~"efacture_belgique.numero_facture~") COLUMN(NAME=~"efacture_belgique.date_facture~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.code~") COMPUTE(NAME=~"(select isnull(sum(montant_rembourse_oa),0) from efacture_belgique, ligne_efacture_belgique where efacture_belgique.numero_facture  = ligne_efacture_belgique.numero_facture  and ligne_efacture_belgique.numero_facture =  ligne_envoi_efacture_belgique.numero_facture and efacture_belgique.statut_my_carenet in ('V', 'I') and efacture_belgique.paiement_effectue<> 'O') as montant_facture_a_encaisser~") COLUMN(NAME=~"efacture_belgique.paiement_effectue~") COLUMN(NAME=~"efacture_belgique.statut_my_carenet~") COLUMN(NAME=~"efacture_belgique.type_facture~")    JOIN (LEFT=~"efacture_belgique.numero_facture~"    OP =~"=~"RIGHT=~"ligne_envoi_efacture_belgique.numero_facture~" )    JOIN (LEFT=~"envoi_efacture_belgique.code_praticien~"    OP =~"=~"RIGHT=~"ligne_envoi_efacture_belgique.code_praticien~" )    JOIN (LEFT=~"envoi_efacture_belgique.code_oa~"    OP =~"=~"RIGHT=~"ligne_envoi_efacture_belgique.code_oa~" )    JOIN (LEFT=~"envoi_efacture_belgique.numero_envoi~"    OP =~"=~"RIGHT=~"ligne_envoi_efacture_belgique.numero_envoi~" )    JOIN (LEFT=~"envoi_efacture_belgique.date_envoi~"    OP =~"=~"RIGHT=~"ligne_envoi_efacture_belgique.date_envoi~" )    JOIN (LEFT=~"efacture_belgique.code_patient~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"ligne_envoi_efacture_belgique.type_facture~"    OP =~"=~"RIGHT=~"efacture_belgique.type_facture~" )WHERE(    EXP1 =~"~~~"envoi_efacture_belgique~~~".~~~"code_oa~~~"~"   OP =~"=~"    EXP2 =~":oa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"envoi_efacture_belgique~~~".~~~"statut_envoi~~~"~"   OP =~"in~"    EXP2 =~"('A', 'I')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"envoi_efacture_belgique~~~".~~~"date_envoi~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"envoi_efacture_belgique~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":prat~" ) ) ARG(NAME = ~"oa~" TYPE = string)  ARG(NAME = ~"prat~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("oa", string),("prat", string),("date_min", date),("date_max", date))  sort="code_oa A date_envoi A numero_envoi A efacture_belgique_date_facture A efacture_belgique_numero_facture A " )
