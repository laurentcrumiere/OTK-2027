table(column=(type=char(20) updatewhereclause=yes name=nom dbname="dossier.nom" dbalias=".nom" )
 column=(type=long updatewhereclause=yes name=ordre_trie dbname="dossier.ordre_trie" dbalias=".ordre_trie" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=date updatewhereclause=yes name=patient_premiere_visite dbname="patient.premiere_visite" dbalias=".premiere_visite" )
 column=(type=date updatewhereclause=yes name=patient_debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dossier~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"dossier.ordre_trie~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code~")    JOIN (LEFT=~"patient.type_dossier_temporaire~"    OP =~"=~"RIGHT=~"dossier.code~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"in~"    EXP2 =~"(select rdv.code from rdv, etat_rdv  where cast(~~~"rdv~~~".~~~"rdv~~~" as date) between :date_min and :date_max and ~~~"rdv~~~".~~~"type~~~" = :type_rdv and ~~~"etat_rdv~~~".~~~"elimine_agenda~~~" <> 'O' and rdv.~~~"absent~~~" = etat_rdv.code)~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"type_rdv~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("type_rdv", string))  sort="ordre_trie A nom A patient_nom A patient_prenom A patient_numero_dossier A " )
