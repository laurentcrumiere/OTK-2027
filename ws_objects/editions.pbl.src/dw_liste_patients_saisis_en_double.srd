table(column=(type=number update=yes updatewhereclause=yes key=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" dbalias=".type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(25) updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=datetime updatewhereclause=yes name=dernier_rdv dbname="dernier_rdv" )
 column=(type=char(25) updatewhereclause=yes name=portable dbname="patient.portable" dbalias=".portable" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=date updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=date updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 column=(type=date updatewhereclause=yes name=date_prem_demande dbname="patient.date_prem_demande" dbalias=".date_prem_demande" )
 column=(type=date updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" dbalias=".premiere_visite" )
 column=(type=date updatewhereclause=yes name=date_moulage dbname="patient.date_moulage" dbalias=".date_moulage" )
 column=(type=date updatewhereclause=yes name=fin_traitement dbname="patient.fin_traitement" dbalias=".fin_traitement" )
 column=(type=date updatewhereclause=yes name=date_contact dbname="patient.date_contact" dbalias=".date_contact" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(200) updatewhereclause=yes name=com_parent1 dbname="patient.com_parent1" dbalias=".com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=secu_parent1 dbname="patient.secu_parent1" dbalias=".secu_parent1" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COMPUTE(NAME=~"(select max(rdv) as dernier_rdv from rdv, etat_rdv where rdv.code = patient.code and cast (rdv.rdv as date)  <= cast(getdate() as date) and absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O')~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.date_prem_demande~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.date_moulage~") COLUMN(NAME=~"patient.fin_traitement~") COLUMN(NAME=~"patient.date_contact~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":num_doss_min and :num_doss_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( select count(*) from patient as patient2 where patient.nom = patient2.nom and patient.prenom = patient2.prenom and patient.code <> patient2.code)~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"num_doss_min~" TYPE = number)  ARG(NAME = ~"num_doss_max~" TYPE = number) " update="patient" updatewhere=1 updatekeyinplace=no arguments=(("prat_min", string),("prat_max", string),("num_doss_min", number),("num_doss_max", number))  sort="nom A prenom A date_naissance A code A " )
