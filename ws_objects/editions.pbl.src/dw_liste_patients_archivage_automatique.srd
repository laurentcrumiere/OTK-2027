table(column=(type=number update=yes updatewhereclause=yes key=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" dbalias=".type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) update=yes updatewhereclause=yes name=prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(50) updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=date updatewhereclause=yes name=patient_relance dbname="patient.relance" dbalias=".relance" )
 column=(type=datetime updatewhereclause=yes name=dernier_rdv dbname="dernier_rdv" )
 column=(type=char(25) updatewhereclause=yes name=portable dbname="patient.portable" dbalias=".portable" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(35) updatewhereclause=yes name=adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(200) updatewhereclause=yes name=com_parent1 dbname="patient.com_parent1" dbalias=".com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=secu_parent1 dbname="patient.secu_parent1" dbalias=".secu_parent1" )
 column=(type=char(6) updatewhereclause=yes name=prochain_rdv dbname="patient.prochain_rdv" dbalias=".prochain_rdv" )
 column=(type=decimal(0) updatewhereclause=yes name=prochain_rdv_nb dbname="patient.prochain_rdv_nb" dbalias=".prochain_rdv_nb" )
 column=(type=char(1) updatewhereclause=yes name=prochain_rdv_tps dbname="patient.prochain_rdv_tps" dbalias=".prochain_rdv_tps" )
 column=(type=number updatewhereclause=yes name=prochain_rdv_serie dbname="patient.prochain_rdv_serie" dbalias=".prochain_rdv_serie" )
 column=(type=char(1) updatewhereclause=yes name=prochain_rdv_t_ou_s dbname="patient.prochain_rdv_t_ou_s" dbalias=".prochain_rdv_t_ou_s" )
 column=(type=date updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=date updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 column=(type=datetime updatewhereclause=yes name=date_fin_dernier_soin dbname="date_fin_dernier_soin" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.relance~") COMPUTE(NAME=~"(select max(rdv) as dernier_rdv from rdv, etat_rdv where rdv.code = patient.code and absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O')~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"patient.prochain_rdv~") COLUMN(NAME=~"patient.prochain_rdv_nb~") COLUMN(NAME=~"patient.prochain_rdv_tps~") COLUMN(NAME=~"patient.prochain_rdv_serie~") COLUMN(NAME=~"patient.prochain_rdv_t_ou_s~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.debut_traitement~") COMPUTE(NAME=~"(select max(dateadd (month, duree, date_demande)) AS date_fin_dernier_soin from soins, code_soins where soins.code = patient.code and code_soins.code  = soins.type )~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"<~"    EXP2 =~"100000000~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"type_dossier~~~"~"   OP =~"between~"    EXP2 =~":dos_min and :dos_max~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"dos_min~" TYPE = string)  ARG(NAME = ~"dos_max~" TYPE = string) " update="patient" updatewhere=1 updatekeyinplace=no arguments=(("prat_min", string),("prat_max", string),("dos_min", string),("dos_max", string))  sort="nom A prenom A code A " )
