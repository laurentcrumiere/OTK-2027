table(column=(type=char(30) updatewhereclause=yes name=correspondants_nom dbname="correspondants.nom" )
 column=(type=char(30) updatewhereclause=yes name=correspondants_prenom dbname="correspondants.prenom" )
 column=(type=char(30) updatewhereclause=yes name=correspondants_adr1 dbname="correspondants.adr1" )
 column=(type=char(30) updatewhereclause=yes name=correspondants_adr2 dbname="correspondants.adr2" )
 column=(type=char(5) updatewhereclause=yes name=correspondants_codep dbname="correspondants.codep" )
 column=(type=char(30) updatewhereclause=yes name=correspondants_ville dbname="correspondants.ville" )
 column=(type=char(15) updatewhereclause=yes name=correspondants_tel dbname="correspondants.tel" )
 column=(type=char(6) updatewhereclause=yes name=correspondants_code dbname="correspondants.code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(50) updatewhereclause=yes name=categories_nom dbname="categories.nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"categories~" )  TABLE(NAME=~"correspondants~" ) COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"correspondants.prenom~") COLUMN(NAME=~"correspondants.adr1~") COLUMN(NAME=~"correspondants.adr2~") COLUMN(NAME=~"correspondants.codep~") COLUMN(NAME=~"correspondants.ville~") COLUMN(NAME=~"correspondants.tel~") COLUMN(NAME=~"correspondants.code~") COLUMN(NAME=~"categories.nom~")    JOIN (LEFT=~"categories.code~"    OP =~"=~"RIGHT=~"correspondants.categorie~" )WHERE(    EXP1 =~"~~~"correspondants~~~".~~~"categorie~~~"~"   OP =~"=~"    EXP2 =~":categorie~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"correspondants~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"categorie~" TYPE = string) " arguments=(("categorie", string)) )
