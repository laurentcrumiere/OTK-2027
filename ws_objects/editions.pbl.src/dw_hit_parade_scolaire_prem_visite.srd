table(column=(type=char(30) update=yes updatewhereclause=yes name=correspondants_nom dbname="correspondants.nom" )
 column=(type=char(30) updatewhereclause=yes name=correspondants_prenom dbname="correspondants.prenom" )
 column=(type=char(30) updatewhereclause=yes name=ecole_nom dbname="ecole.nom" )
 column=(type=char(5) updatewhereclause=yes name=ecole_codep dbname="ecole.codep" )
 column=(type=char(30) updatewhereclause=yes name=ecole_ville dbname="ecole.ville" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(100) updatewhereclause=yes name=patient_email dbname="patient.email" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_patient dbname="patient.email_patient" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=date updatewhereclause=yes name=patient_premiere_visite dbname="patient.premiere_visite" )
 column=(type=char(10) updatewhereclause=yes name=patient_moulage dbname="patient.moulage" )
 column=(type=date updatewhereclause=yes name=patient_date_contact dbname="patient.date_contact" )
 column=(type=char(100) updatewhereclause=yes name=patient_email_parent2 dbname="patient.email_parent2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"correspondants~" )  TABLE(NAME=~"ecole~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"correspondants.nom~") COLUMN(NAME=~"correspondants.prenom~") COLUMN(NAME=~"ecole.nom~") COLUMN(NAME=~"ecole.codep~") COLUMN(NAME=~"ecole.ville~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.email~") COLUMN(NAME=~"patient.email_patient~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.date_contact~") COLUMN(NAME=~"patient.email_parent2~")    JOIN (LEFT=~"patient.ecole~"    OP =~"=~"RIGHT=~"ecole.code~"    OUTER1 =~"patient.ecole~" )    JOIN (LEFT=~"correspondants.code~"    OP =~"=~"RIGHT=~"patient.code_correspondant~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"premiere_visite~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"type_dossier~~~"~"   OP =~"between~"    EXP2 =~":dos_min and :dos_max~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"dos_min~" TYPE = string)  ARG(NAME = ~"dos_max~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("dos_min", string),("dos_max", string))  sort="ecole_nom A ecole_codep A ecole_ville A patient_nom A patient_prenom A " )
