table(column=(type=number updatewhereclause=yes name=patient_code dbname="patient.code" dbalias=".code" )
 column=(type=char(30) updatewhereclause=yes name=patient_nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_caisse dbname="patient.code_caisse" dbalias=".code_caisse" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(1) updatewhereclause=yes name=param_payassu dbname="param.payassu" dbalias=".payassu" initial="O" values="Oui	O/Non	N/" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_payeur dbname="patient.secu_payeur" dbalias=".secu_payeur" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent2 dbname="patient.secu_parent2" dbalias=".secu_parent2" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" dbalias=".secu_parent1" )
 column=(type=char(80) updatewhereclause=yes name=prati_entete dbname="prati.entete" dbalias=".entete" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_cadre_entete dbname="prati.cadre_entete" dbalias=".cadre_entete" initial="0" values="Aucun	0/Ombré	1/Rectangle	2/Ligne	4/3D en creux	5/3D en relief	6/" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_cadre_bas_page dbname="prati.cadre_bas_page" dbalias=".cadre_bas_page" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_mutuelle dbname="patient.code_mutuelle" dbalias=".code_mutuelle" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(1) updatewhereclause=yes name=ligne_soins_origine_tp dbname="ligne_soins.origine_tp" dbalias=".origine_tp" )
 column=(type=char(30) updatewhereclause=yes name=caisse_nom dbname="caisse.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=caisse_adr1 dbname="caisse.adr1" dbalias=".adr1" )
 column=(type=char(30) updatewhereclause=yes name=caisse_adr2 dbname="caisse.adr2" dbalias=".adr2" )
 column=(type=char(5) updatewhereclause=yes name=caisse_codep dbname="caisse.codep" dbalias=".codep" )
 column=(type=char(30) updatewhereclause=yes name=caisse_ville dbname="caisse.ville" dbalias=".ville" )
 column=(type=char(30) updatewhereclause=yes name=mutuelle_nom dbname="mutuelle.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=mutuelle_adr1 dbname="mutuelle.adr1" dbalias=".adr1" )
 column=(type=char(30) updatewhereclause=yes name=mutuelle_adr2 dbname="mutuelle.adr2" dbalias=".adr2" )
 column=(type=char(5) updatewhereclause=yes name=mutuelle_codep dbname="mutuelle.codep" dbalias=".codep" )
 column=(type=char(30) updatewhereclause=yes name=mutuelle_ville dbname="mutuelle.ville" dbalias=".ville" )
 column=(type=char(1) updatewhereclause=yes name=patient_assure dbname="patient.assure" dbalias=".assure" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" dbalias=".monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" dbalias=".symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" dbalias=".symbole_euro" )
 column=(type=decimal(2) updatewhereclause=yes name=total_soins_mutuelle dbname="total_soins_mutuelle" )
 column=(type=decimal(2) updatewhereclause=yes name=total_soins_caisse dbname="total_soins_caisse" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_paye_caisse dbname="total_paye_caisse" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_paye_mutuelle dbname="total_paye_mutuelle" )
 column=(type=date updatewhereclause=yes name=date_soin_mutuelle dbname="date_soin_mutuelle" )
 column=(type=date updatewhereclause=yes name=date_soin_caisse dbname="date_soin_caisse" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"ligne_soins~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"caisse~" )  TABLE(NAME=~"mutuelle~" )  TABLE(NAME=~"soins~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.code_caisse~") COLUMN(NAME=~"param.payassu~") COLUMN(NAME=~"patient.secu_payeur~") COLUMN(NAME=~"patient.secu_parent2~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"prati.cadre_bas_page~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.code_mutuelle~") COLUMN(NAME=~"ligne_soins.origine_tp~") COLUMN(NAME=~"caisse.nom~") COLUMN(NAME=~"caisse.adr1~") COLUMN(NAME=~"caisse.adr2~") COLUMN(NAME=~"caisse.codep~") COLUMN(NAME=~"caisse.ville~") COLUMN(NAME=~"mutuelle.nom~") COLUMN(NAME=~"mutuelle.adr1~") COLUMN(NAME=~"mutuelle.adr2~") COLUMN(NAME=~"mutuelle.codep~") COLUMN(NAME=~"mutuelle.ville~") COLUMN(NAME=~"patient.assure~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) as total_soins_mutuelle FROM ligne_soins WHERE soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'O' and ~~~"ligne_soins~~~".~~~"origine_tp~~~" = 'M'  and ligne_soins.~~~"date~~~" <= :date_ref2)~") COMPUTE(NAME=~"(SELECT isnull(sum(montant),0) as total_soins_caisse FROM ligne_soins WHERE soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'O' and ~~~"ligne_soins~~~".~~~"origine_tp~~~" = 'C'  and ligne_soins.~~~"date~~~" <= :date_ref2)~") COMPUTE(NAME=~"(SELECT isnull(sum(paye.montant),0) as total_paye_caisse FROM paye WHERE soins.code = paye.code and soins.cle = paye.cle and ~~~"paye~~~".~~~"tp~~~" = 'O' and ~~~"paye~~~".~~~"origine_tp~~~" = 'C'  )~") COMPUTE(NAME=~"(SELECT isnull(sum(paye.montant),0) as total_paye_mutuelle FROM paye WHERE soins.code = paye.code and soins.cle = paye.cle and ~~~"paye~~~".~~~"tp~~~" = 'O' and ~~~"paye~~~".~~~"origine_tp~~~" = 'M'  )~") COMPUTE(NAME=~"(SELECT max(~~~"date~~~") as date_soin_mutuelle FROM ligne_soins WHERE soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'O' and ~~~"ligne_soins~~~".~~~"origine_tp~~~" = 'M' and ligne_soins.~~~"date~~~" <= :date_ref2)~") COMPUTE(NAME=~"(SELECT max(~~~"date~~~") as date_soin_caisse FROM ligne_soins WHERE soins.code = ligne_soins.code and soins.cle = ligne_soins.cle and ligne_soins.tp = 'O' and ~~~"ligne_soins~~~".~~~"origine_tp~~~" = 'C' and ligne_soins.~~~"date~~~" <= :date_ref2)~")    JOIN (LEFT=~"ligne_soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"caisse.code~"    OP =~"=~"RIGHT=~"patient.code_caisse~" )    JOIN (LEFT=~"mutuelle.code~"    OP =~"=~"RIGHT=~"patient.code_mutuelle~" )    JOIN (LEFT=~"soins.cle~"    OP =~"=~"RIGHT=~"ligne_soins.cle~" )    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"ligne_soins.code~" )    JOIN (LEFT=~"soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )WHERE(    EXP1 =~"(~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~">=~"    EXP2 =~":code_min)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"<=~"    EXP2 =~":code_max)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ligne_soins~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_ref and :date_ref2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ligne_soins~~~".~~~"tp~~~"~"   OP =~"=~"    EXP2 =~"'O')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":var_pra)~" )  GROUP(NAME=~"patient.code~") GROUP(NAME=~"patient.code_mutuelle~") GROUP(NAME=~"patient.assure~") GROUP(NAME=~"mutuelle.ville~") GROUP(NAME=~"mutuelle.codep~") GROUP(NAME=~"mutuelle.adr2~") GROUP(NAME=~"mutuelle.adr1~") GROUP(NAME=~"mutuelle.nom~") GROUP(NAME=~"ligne_soins.origine_tp~") GROUP(NAME=~"patient.nom~") GROUP(NAME=~"patient.nom_parent1~") GROUP(NAME=~"patient.code_praticien~") GROUP(NAME=~"patient.code_caisse~") GROUP(NAME=~"param.payassu~") GROUP(NAME=~"patient.secu_payeur~") GROUP(NAME=~"patient.secu_parent2~") GROUP(NAME=~"patient.secu_parent1~") GROUP(NAME=~"prati.entete~") GROUP(NAME=~"prati.cadre_entete~") GROUP(NAME=~"prati.bas_page~") GROUP(NAME=~"prati.cadre_bas_page~") GROUP(NAME=~"caisse.ville~") GROUP(NAME=~"caisse.codep~") GROUP(NAME=~"caisse.adr2~") GROUP(NAME=~"caisse.adr1~") GROUP(NAME=~"patient.prenom~") GROUP(NAME=~"caisse.nom~") GROUP(NAME=~"param.monnaie_base~") GROUP(NAME=~"param.symbole_franc~") GROUP(NAME=~"param.symbole_euro~") GROUP(NAME=~"soins.cle~") GROUP(NAME=~"soins.code~")) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"var_pra~" TYPE = string)  ARG(NAME = ~"date_ref~" TYPE = date)  ARG(NAME = ~"date_ref2~" TYPE = date) " filter=" due >0"arguments=(("code_min", number),("code_max", number),("var_pra", string),("date_ref", date),("date_ref2", date))  sort="ligne_soins_origine_tp A caisse_nom A mutuelle_nom A patient_nom A patient_prenom A " )
