LUMN(NAME=~"patient.alveo_max_pro~") COLUMN(NAME=~"patient.alveo_max_retro~") COLUMN(NAME=~"patient.alveo_mand_pro~") COLUMN(NAME=~"patient.alveo_mand_retro~") COLUMN(NAME=~"patient.alveo_max_endo~") COLUMN(NAME=~"patient.alveo_max_exo~") COLUMN(NAME=~"patient.alveo_mand_endo~") COLUMN(NAME=~"patient.alveo_mand_exo~") COLUMN(NAME=~"patient.supraclusion~") COLUMN(NAME=~"patient.infraclusion~") COLUMN(NAME=~"patient.mol_cl1~") COLUMN(NAME=~"patient.mol_cl2~") COLUMN(NAME=~"patient.mol_cl3~") COLUMN(NAME=~"patient.can_cl1~") COLUMN(NAME=~"patient.can_cl2~") COLUMN(NAME=~"patient.can_cl3~") COLUMN(NAME=~"patient.molaire~") COLUMN(NAME=~"patient.canine~") COLUMN(NAME=~"patient.dento_max~") COLUMN(NAME=~"patient.dento_dent~") COLUMN(NAME=~"patient.agenesie~") COLUMN(NAME=~"patient.surnum~") COLUMN(NAME=~"patient.malposition~") COLUMN(NAME=~"patient.occl_dte~") COLUMN(NAME=~"patient.occl_gche~") COLUMN(NAME=~"patient.occl_ant~") COLUMN(NAME=~"patient.facteur~") COLUMN(NAME=~"banque.ident~") COLUMN(NAME=~"mode_reglement.nom~") COLUMN(NAME=~"patient.iban~") COLUMN(NAME=~"patient.bic~") COMPUTE(NAME=~"(select isnull(count(*),0) as nb_echeances from ligne_soins where ligne_soins.~~~"date~~~" >= :date_alerte and tp ='N' and ligne_soins.code = patient.code)~")    JOIN (LEFT=~"pays.code~"    OP =~"=~"RIGHT=~"patient.pays_parent1~"    OUTER2 =~"patient.pays_parent1~" )    JOIN (LEFT=~"patient.code_banque~"    OP =~"=~"RIGHT=~"banque.code~"    OUTER1 =~"patient.code_banque~" )    JOIN (LEFT=~"patient.mode_reglement_habituel~"    OP =~"=~"RIGHT=~"mode_reglement.code~"    OUTER1 =~"patient.mode_reglement_habituel~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~" :prat_min  and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"isnull(~~~"patient~~~".~~~"mode_reglement_habituel~~~",'')~"   OP =~"between~"    EXP2 =~":mode_min and :mode_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"isnull(~~~"patient~~~".~~~"code_banque~~~",'')~"   OP =~"between~"    EXP2 =~":banque_min and :banque_max~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"mode_min~" TYPE = string)  ARG(NAME = ~"mode_max~" TYPE = string)  ARG(NAME = ~"banque_min~" TYPE = string)  ARG(NAME = ~"banque_max~" TYPE = string)  ARG(NAME = ~"date_alerte~" TYPE = date) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("mode_min", string),("mode_max", string),("banque_min", string),("banque_max", string),("date_alerte", date))  sort="nom A patient_prenom A " )
