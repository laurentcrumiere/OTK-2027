 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(6) updatewhereclause=yes name=paye_code_praticien dbname="paye.code_praticien" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=number update=yes updatewhereclause=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" )
 column=(type=char(1) updatewhereclause=yes name=paye_monnaie dbname="paye.monnaie" )
 column=(type=char(10) updatewhereclause=yes name=code_soins_lettre dbname="code_soins.lettre" )
 column=(type=long updatewhereclause=yes name=numero_ligne dbname="numero_ligne" )
 column=(type=datetime updatewhereclause=yes name=paye_date_impression_remise dbname="paye.date_impression_remise" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=datetime updatewhereclause=yes name=paye_heure_saisie dbname="paye.heure_saisie" )
 column=(type=char(6) updatewhereclause=yes name=paye_banque dbname="paye.banque" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom_parent1 dbname="patient.nom_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=patient_ville_parent1 dbname="patient.ville_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teldom_parent1 dbname="patient.teldom_parent1" )
 column=(type=char(25) updatewhereclause=yes name=patient_teltra_parent1 dbname="patient.teltra_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" )
 column=(type=datetime updatewhereclause=yes name=remises_date_generation dbname="remises.date_generation" )
 column=(type=decimal(0) updatewhereclause=yes name=mode_reglement_colonne dbname="mode_reglement.colonne" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_facture_ligne dbname="soins.numero_facture" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"paye~" )  TABLE(NAME=~"soins~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"code_soins~" )  TABLE(NAME=~"remises~" )  TABLE(NAME=~"mode_reglement~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"paye.payeur~") COLUMN(NAME=~"paye.dateremise~") COLUMN(NAME=~"paye.montant~") COLUMN(NAME=~"paye.date~") COLUMN(NAME=~"paye.mode~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"paye.commentaire~") COLUMN(NAME=~"soins.type~") COLUMN(NAME=~"soins.scp_demande~") COLUMN(NAME=~"soins.hn~") COLUMN(NAME=~"soins.total~") COLUMN(NAME=~"patient.moulage~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"paye.code_praticien~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"paye.monnaie~") COLUMN(NAME=~"code_soins.lettre~") COMPUTE(NAME=~"number(*) as numero_ligne~") COLUMN(NAME=~"paye.date_impression_remise~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"paye.heure_saisie~") COLUMN(NAME=~"paye.banque~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"remises.date_generation~") COLUMN(NAME=~"mode_reglement.colonne~") COLUMN(NAME=~"soins.numero_facture~")    JOIN (LEFT=~"paye.code_remise~"    OP =~"=~"RIGHT=~"remises.code~"    OUTER1 =~"paye.code_remise~" )    JOIN (LEFT=~"patient.code~"    OP =~"=~"RIGHT=~"paye.code~" )    JOIN (LEFT=~"paye.code~"    OP =~"=~"RIGHT=~"soins.code~" )    JOIN (LEFT=~"paye.cle~"    OP =~"=~"RIGHT=~"soins.cle~" )    JOIN (LEFT=~"code_soins.code~"    OP =~"=~"RIGHT=~"soins.type~" )    JOIN (LEFT=~"mode_reglement.code~"    OP =~"=~"RIGHT=~"paye.mode~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"date~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":var_prat_min and :var_prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"monnaie~~~"~"   OP =~"between~"    EXP2 =~":monnaie_min and :monnaie_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"soins~~~".~~~"type~~~"~"   OP =~"between~"    EXP2 =~":soin_min and :soin_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"isnull(~~~"soins~~~".~~~"numero~~~",0,~~~"soins~~~".~~~"numero~~~")~"   OP =~"between~"    EXP2 =~":num_min and :num_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"mode~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"paye~~~".~~~"mode~~~"~"   OP =~"<>~"    EXP2 =~"'O'~" ) ) ORDER(NAME=~"patient.nom~" ASC=yes ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"var_prat_min~" TYPE = string)  ARG(NAME = ~"var_prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"monnaie_min~" TYPE = string)  ARG(NAME = ~"monnaie_max~" TYPE = string)  ARG(NAME = ~"soin_min~" TYPE = string)  ARG(NAME = ~"soin_max~" TYPE = string)  ARG(NAME = ~"num_min~" TYPE = number)  ARG(NAME = ~"num_max~" TYPE = number) " filter=" paye_mode  <>  'S'"arguments=(("code_min", number),("code_max", number),("var_prat_min", string),("var_prat_max", string),("date_min", date),("date_max", date),("monnaie_min", string),("monnaie_max", string),("soin_min", string),("soin_max", string),("num_min", number),("num_max", number))  sort="paye_date A paye_payeur A paye_mode A paye_dateremise A paye_commentaire A paye_code_praticien A nom A " )
