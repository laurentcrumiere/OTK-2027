 column=(type=decimal(0) updatewhereclause=yes name=prati_cadre_entete dbname="prati.cadre_entete" dbalias=".cadre_entete" initial="0" values="Aucun	0/Ombré	1/Rectangle	2/Ligne	4/3D en creux	5/3D en relief	6/" )
 column=(type=char(80) updatewhereclause=yes name=prati_bas_page dbname="prati.bas_page" dbalias=".bas_page" )
 column=(type=decimal(0) updatewhereclause=yes name=prati_cadre_bas_page dbname="prati.cadre_bas_page" dbalias=".cadre_bas_page" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_soins dbname="total_soins" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_paye dbname="total_paye" )
 column=(type=char(6) updatewhereclause=yes name=patient_code_mutuelle dbname="patient.code_mutuelle" dbalias=".code_mutuelle" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(1) updatewhereclause=yes name=ligne_soins_origine_tp dbname="ligne_soins.origine_tp" dbalias=".origine_tp" )
 column=(type=decimal(2) updatewhereclause=yes name=total_soins_mutuelle dbname="total_soins_mutuelle" )
 column=(type=char(30) updatewhereclause=yes name=caisse_nom dbname="caisse.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=caisse_adr1 dbname="caisse.adr1" dbalias=".adr1" )
 column=(type=char(30) updatewhereclause=yes name=caisse_adr2 dbname="caisse.adr2" dbalias=".adr2" )
 column=(type=char(5) updatewhereclause=yes name=caisse_codep dbname="caisse.codep" dbalias=".codep" )
 column=(type=char(30) updatewhereclause=yes name=caisse_ville dbname="caisse.ville" dbalias=".ville" )
 column=(type=char(30) updatewhereclause=yes name=mutuelle_nom dbname="mutuelle.nom" dbalias=".nom" )
 column=(type=char(30) updatewhereclause=yes name=mutuelle_adr1 dbname="mutuelle.adr1" dbalias=".adr1" )
 column=(type=char(30) updatewhereclause=yes name=mutuelle_adr2 dbname="mutuelle.adr2" dbalias=".adr2" )
 column=(type=char(5) updatewhereclause=yes name=mutuelle_codep dbname="mutuelle.codep" dbalias=".codep" )
 column=(type=char(30) updatewhereclause=yes name=mutuelle_ville dbname="mutuelle.ville" dbalias=".ville" )
 column=(type=char(1) updatewhereclause=yes name=patient_assure dbname="patient.assure" dbalias=".assure" )
 column=(type=decimal(2) updatewhereclause=yes name=total_soins_caisse dbname="total_soins_caisse" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_paye_caisse dbname="total_paye_caisse" )
 column=(type=decimal(2) updatewhereclause=yes name=ctotal_paye_mutuelle dbname="total_paye_mutuelle" )
 column=(type=char(1) updatewhereclause=yes name=param_monnaie_base dbname="param.monnaie_base" dbalias=".monnaie_base" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_franc dbname="param.symbole_franc" dbalias=".symbole_franc" )
 column=(type=char(3) updatewhereclause=yes name=param_symbole_euro dbname="param.symbole_euro" dbalias=".symbole_euro" )
 column=(type=decimal(0) updatewhereclause=yes name=patient_numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"param~" )  TABLE(NAME=~"ligne_soins~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"caisse~" )  TABLE(NAME=~"mutuelle~" ) COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.code_caisse~") COLUMN(NAME=~"param.payassu~") COLUMN(NAME=~"patient.secu_payeur~") COLUMN(NAME=~"patient.secu_parent2~") COLUMN(NAME=~"patient.secu_parent1~") COLUMN(NAME=~"prati.entete~") COLUMN(NAME=~"prati.cadre_entete~") COLUMN(NAME=~"prati.bas_page~") COLUMN(NAME=~"prati.cadre_bas_page~") COLUMN(NAME=~"patient.prenom~") COMPUTE(NAME=~"isnull((SELECT sum(montant) FROM ligne_soins WHERE code = PATIENT.code and ~~~"ligne_soins~~~".~~~"date~~~" <= :date_ref and ~~~"ligne_soins~~~".~~~"tp~~~" = 'O' ),0) AS total_soins~") COMPUTE(NAME=~"isnull((SELECT sum(montant) FROM paye WHERE code = PATIENT.code and ~~~"paye~~~".~~~"tp~~~" = 'O' ),0)  AS total_paye~") COLUMN(NAME=~"patient.code_mutuelle~") COLUMN(NAME=~"ligne_soins.origine_tp~") COMPUTE(NAME=~"isnull((SELECT sum(montant) FROM ligne_soins WHERE code = PATIENT.code and ~~~"ligne_soins~~~".~~~"date~~~" <= :date_ref and ~~~"ligne_soins~~~".~~~"tp~~~" = 'O' and ~~~"ligne_soins~~~".~~~"origine_tp~~~" = 'M'  ),0) AS total_soins_mutuelle~") COLUMN(NAME=~"caisse.nom~") COLUMN(NAME=~"caisse.adr1~") COLUMN(NAME=~"caisse.adr2~") COLUMN(NAME=~"caisse.codep~") COLUMN(NAME=~"caisse.ville~") COLUMN(NAME=~"mutuelle.nom~") COLUMN(NAME=~"mutuelle.adr1~") COLUMN(NAME=~"mutuelle.adr2~") COLUMN(NAME=~"mutuelle.codep~") COLUMN(NAME=~"mutuelle.ville~") COLUMN(NAME=~"patient.assure~") COMPUTE(NAME=~"isnull((SELECT sum(montant) FROM ligne_soins WHERE code = PATIENT.code and ~~~"ligne_soins~~~".~~~"date~~~" <= :date_ref and ~~~"ligne_soins~~~".~~~"tp~~~" = 'O' and ~~~"ligne_soins~~~".~~~"origine_tp~~~" = 'C' ),0) AS total_soins_caisse~") COMPUTE(NAME=~"isnull((SELECT sum(montant) FROM paye WHERE code = PATIENT.code and ~~~"paye~~~".~~~"tp~~~" = 'O' and ~~~"paye~~~".~~~"origine_tp~~~" = 'C'),0)  AS total_paye_caisse~") COMPUTE(NAME=~"isnull((SELECT sum(montant) FROM paye WHERE code = PATIENT.code and ~~~"paye~~~".~~~"tp~~~" = 'O' and  ~~~"paye~~~".~~~"origine_tp~~~" = 'M' ),0)  AS total_paye_mutuelle~") COLUMN(NAME=~"param.monnaie_base~") COLUMN(NAME=~"param.symbole_franc~") COLUMN(NAME=~"param.symbole_euro~") COLUMN(NAME=~"patient.numero_dossier~")    JOIN (LEFT=~"ligne_soins.code~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"prati.code~"    OP =~"=~"RIGHT=~"patient.code_praticien~" )    JOIN (LEFT=~"caisse.code~"    OP =~"=~"RIGHT=~"patient.code_caisse~" )    JOIN (LEFT=~"mutuelle.code~"    OP =~"=~"RIGHT=~"patient.code_mutuelle~" )WHERE(    EXP1 =~"(~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~">=~"    EXP2 =~":code_min)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"<=~"    EXP2 =~":code_max)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ligne_soins~~~".~~~"date~~~"~"   OP =~"<=~"    EXP2 =~":date_ref )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"ligne_soins~~~".~~~"tp~~~"~"   OP =~"=~"    EXP2 =~"'O')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"=~"    EXP2 =~":var_pra)~" )  GROUP(NAME=~"patient.code~") GROUP(NAME=~"patient.code_mutuelle~") GROUP(NAME=~"patient.assure~") GROUP(NAME=~"mutuelle.ville~") GROUP(NAME=~"mutuelle.codep~") GROUP(NAME=~"mutuelle.adr2~") GROUP(NAME=~"mutuelle.adr1~") GROUP(NAME=~"mutuelle.nom~") GROUP(NAME=~"ligne_soins.origine_tp~") GROUP(NAME=~"patient.nom~") GROUP(NAME=~"patient.nom_parent1~") GROUP(NAME=~"patient.code_praticien~") GROUP(NAME=~"patient.code_caisse~") GROUP(NAME=~"param.payassu~") GROUP(NAME=~"patient.numero_dossier~") GROUP(NAME=~"patient.secu_payeur~") GROUP(NAME=~"patient.secu_parent2~") GROUP(NAME=~"patient.secu_parent1~") GROUP(NAME=~"prati.entete~") GROUP(NAME=~"prati.cadre_entete~") GROUP(NAME=~"prati.bas_page~") GROUP(NAME=~"prati.cadre_bas_page~") GROUP(NAME=~"caisse.ville~") GROUP(NAME=~"caisse.codep~") GROUP(NAME=~"caisse.adr2~") GROUP(NAME=~"caisse.adr1~") GROUP(NAME=~"patient.prenom~") GROUP(NAME=~"caisse.nom~") GROUP(NAME=~"param.monnaie_base~") GROUP(NAME=~"param.symbole_franc~") GROUP(NAME=~"param.symbole_euro~")) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"var_pra~" TYPE = string)  ARG(NAME = ~"date_ref~" TYPE = date) " filter="(Ctotal_soins - Ctotal_paye ) > 0 "arguments=(("code_min", number),("code_max", number),("var_pra", string),("date_ref", date))  sort="ligne_soins_origine_tp A caisse_nom A mutuelle_nom A patient_nom A patient_prenom A " )
