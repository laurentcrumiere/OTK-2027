table(column=(type=char(6) updatewhereclause=yes name=type_rdv_code dbname="type_rdv.code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(30) updatewhereclause=yes name=type_rdv_nom dbname="type_rdv.nom" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_couleur dbname="type_rdv.couleur" )
 column=(type=char(40) updatewhereclause=yes name=type_rdv_symbole dbname="type_rdv.symbole" )
 column=(type=char(30) updatewhereclause=yes name=prat1_nom dbname="prat1_nom" )
 column=(type=char(1) updatewhereclause=yes name=nombre dbname="table_vide.v1" )
 column=(type=char(1) updatewhereclause=yes name=mini dbname="table_vide.v2" )
 column=(type=char(1) updatewhereclause=yes name=maxi dbname="table_vide.v3" )
 column=(type=char(1) updatewhereclause=yes name=moyenne dbname="table_vide.v4" )
 column=(type=char(30) updatewhereclause=yes name=nom_etat1 dbname="nom_etat1" )
 column=(type=char(30) updatewhereclause=yes name=nom_etat2 dbname="nom_etat2" )
 column=(type=decimal(0) updatewhereclause=yes name=type_rdv_duree dbname="type_rdv.duree" )
 column=(type=char(50) updatewhereclause=yes name=nom_famille dbname="nom_famille" )
 column=(type=number updatewhereclause=yes name=couleur_famille dbname="couleur_famille" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"type_rdv~" )  TABLE(NAME=~"table_vide~" ) COLUMN(NAME=~"type_rdv.code~") COLUMN(NAME=~"type_rdv.nom~") COLUMN(NAME=~"type_rdv.couleur~") COLUMN(NAME=~"type_rdv.symbole~") COMPUTE(NAME=~"(SELECT nom from prati where code = :prat1 ) as prat1_nom~") COLUMN(NAME=~"table_vide.v1~") COLUMN(NAME=~"table_vide.v2~") COLUMN(NAME=~"table_vide.v3~") COLUMN(NAME=~"table_vide.v4~") COMPUTE(NAME=~"(select nom as nom_etat1 from etat_rdv where code = :etat1)~") COMPUTE(NAME=~"(select nom as nom_etat2 from etat_rdv where code = :etat2)~") COLUMN(NAME=~"type_rdv.duree~") COMPUTE(NAME=~"(select top 1 nom as nom_famille from famille_rdv,type_rdv_famille where type_rdv.code = type_rdv_famille.code_type_rdv and type_rdv_famille.code_famille_rdv = famille_rdv.code order by ordre_trie, nom )~") COMPUTE(NAME=~"(select top 1 couleur as couleur_famille from famille_rdv,type_rdv_famille where type_rdv.code = type_rdv_famille.code_type_rdv and type_rdv_famille.code_famille_rdv = famille_rdv.code order by ordre_trie, nom )~")WHERE(    EXP1 =~"~~~"type_rdv~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"date1~" TYPE = date)  ARG(NAME = ~"date2~" TYPE = date)  ARG(NAME = ~"prat1~" TYPE = string)  ARG(NAME = ~"prat2~" TYPE = string)  ARG(NAME = ~"etat1~" TYPE = string)  ARG(NAME = ~"etat2~" TYPE = string) " arguments=(("date1", date),("date2", date),("prat1", string),("prat2", string),("etat1", string),("etat2", string))  sort="nom_famille A type_rdv_nom A " )
group(level=1 header.height=84 trailer.height=0 by=("nom_famille" ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.count="0" header.gradient.repetition.length="100" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.count="0" trailer.gradient.repetition.length="100" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
