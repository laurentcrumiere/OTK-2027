table(column=(type=long updatewhereclause=yes name=nombre dbname="nombre" )
 column=(type=char(5) updatewhereclause=yes name=codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(30) updatewhereclause=yes name=ville dbname="ville" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COMPUTE(NAME=~"count(*) as nombre~") COLUMN(NAME=~"patient.codep_parent1~") COMPUTE(NAME=~"(select min(ville) as ville from code_postaux where trim(codep_parent1) = trim(code) )~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~" ~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"codep_parent1~~~"~"   OP =~"between~"    EXP2 =~":cp_min and :cp_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"type_dossier~~~"~"   OP =~"between~"    EXP2 =~":dos_min and :dos_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"date_contact~~~"~"   OP =~"between~"    EXP2 =~":date_min and :date_max~" )  GROUP(NAME=~"patient.codep_parent1~")) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"cp_min~" TYPE = string)  ARG(NAME = ~"cp_max~" TYPE = string)  ARG(NAME = ~"dos_min~" TYPE = string)  ARG(NAME = ~"dos_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("cp_min", string),("cp_max", string),("dos_min", string),("dos_max", string),("date_min", date),("date_max", date))  sort="codep_parent1 A " )
