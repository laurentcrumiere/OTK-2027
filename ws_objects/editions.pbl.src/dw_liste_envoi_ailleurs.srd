COLUMN(NAME=~"patient.traitement_effectue~") COLUMN(NAME=~"patient.plan_traitement~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.moulage~")) ORDER(NAME=~"patient.nom~" ASC=yes ) " update="patient" updatewhere=1 updatekeyinplace=no )
