table(column=(type=char(20) updatewhereclause=yes name=nom dbname="nom" )
 column=(type=number updatewhereclause=yes name=type_dossier_temporaire dbname="type_dossier_temporaire" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dossier~" )  TABLE(NAME=~"prati~" )  TABLE(NAME=~"patient~" ) COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"prati.nom~") COLUMN(NAME=~"patient.type_dossier_temporaire~")    JOIN (LEFT=~"patient.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"patient.type_dossier_temporaire~"    OP =~"=~"RIGHT=~"dossier.code~" )WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":pra_min and :pra_max~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"pra_min~" TYPE = string)  ARG(NAME = ~"pra_max~" TYPE = string) " arguments=(("code_min", number),("code_max", number),("pra_min", string),("pra_max", string))  sort="nom A " )
