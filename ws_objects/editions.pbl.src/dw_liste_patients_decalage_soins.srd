table(column=(type=char(50) update=yes updatewhereclause=yes name=nom dbname="patient.nom" dbalias=".nom" )
 column=(type=char(50) update=yes updatewhereclause=yes name=nom_parent1 dbname="patient.nom_parent1" dbalias=".nom_parent1" )
 column=(type=char(30) update=yes updatewhereclause=yes name=ville_parent1 dbname="patient.ville_parent1" dbalias=".ville_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teldom_parent1 dbname="patient.teldom_parent1" dbalias=".teldom_parent1" )
 column=(type=char(25) update=yes updatewhereclause=yes name=teltra_parent1 dbname="patient.teltra_parent1" dbalias=".teltra_parent1" )
 column=(type=date update=yes updatewhereclause=yes name=date_naissance dbname="patient.date_naissance" dbalias=".date_naissance" )
 column=(type=date update=yes updatewhereclause=yes name=debut_traitement dbname="patient.debut_traitement" dbalias=".debut_traitement" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_praticien dbname="patient.code_praticien" dbalias=".code_praticien" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) update=yes updatewhereclause=yes name=type_dossier dbname="patient.type_dossier" dbalias=".type_dossier" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(6) update=yes updatewhereclause=yes name=code_correspondant dbname="patient.code_correspondant" dbalias=".code_correspondant" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=date update=yes updatewhereclause=yes name=premiere_visite dbname="patient.premiere_visite" dbalias=".premiere_visite" )
 column=(type=date update=yes updatewhereclause=yes name=relance dbname="patient.relance" dbalias=".relance" )
 column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" dbalias=".nom" )
 column=(type=number updatewhereclause=yes identity=yes name=code dbname="patient.code" dbalias=".code" )
 column=(type=char(30) update=yes updatewhereclause=yes name=patient_prenom dbname="patient.prenom" dbalias=".prenom" )
 column=(type=char(10) update=yes updatewhereclause=yes name=moulage dbname="patient.moulage" dbalias=".moulage" )
 column=(type=date updatewhereclause=yes name=date_soin dbname="date_soin" )
 column=(type=char(25) updatewhereclause=yes name=portable dbname="patient.portable" dbalias=".portable" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" dbalias=".numero_dossier" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr1_parent1 dbname="patient.adr1_parent1" dbalias=".adr1_parent1" )
 column=(type=char(35) updatewhereclause=yes name=patient_adr2_parent1 dbname="patient.adr2_parent1" dbalias=".adr2_parent1" )
 column=(type=char(5) updatewhereclause=yes name=patient_codep_parent1 dbname="patient.codep_parent1" dbalias=".codep_parent1" )
 column=(type=char(200) updatewhereclause=yes name=patient_com_parent1 dbname="patient.com_parent1" dbalias=".com_parent1" )
 column=(type=char(20) updatewhereclause=yes name=patient_secu_parent1 dbname="patient.secu_parent1" dbalias=".secu_parent1" )
 column=(type=char(40) updatewhereclause=yes name=nom_soin dbname="nom_soin" )
 column=(type=datetime updatewhereclause=yes name=prochain_rdv dbname="prochain_rdv" )
 column=(type=datetime updatewhereclause=yes name=dernier_rdv dbname="dernier_rdv" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" )  TABLE(NAME=~"dossier~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.nom_parent1~") COLUMN(NAME=~"patient.ville_parent1~") COLUMN(NAME=~"patient.teldom_parent1~") COLUMN(NAME=~"patient.teltra_parent1~") COLUMN(NAME=~"patient.date_naissance~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.code_praticien~") COLUMN(NAME=~"patient.type_dossier~") COLUMN(NAME=~"patient.code_correspondant~") COLUMN(NAME=~"patient.premiere_visite~") COLUMN(NAME=~"patient.relance~") COLUMN(NAME=~"dossier.nom~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"patient.moulage~") COMPUTE(NAME=~"(select min(date_demande) from soins, code_soins where soins.code = patient.code and soins.~~~"type~~~" = code_soins.code and code_soins.duree > 0 and date_demande <= :date_ref and :date_ref < dateadd( month, code_soins.duree, date_demande  ) and soins.total > 0)  AS date_soin~") COLUMN(NAME=~"patient.portable~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.adr1_parent1~") COLUMN(NAME=~"patient.adr2_parent1~") COLUMN(NAME=~"patient.codep_parent1~") COLUMN(NAME=~"patient.com_parent1~") COLUMN(NAME=~"patient.secu_parent1~") COMPUTE(NAME=~"(select top 1 code_soins.nom from soins, code_soins where soins.code = patient.code and soins.~~~"type~~~" = code_soins.code and code_soins.duree > 0 and date_demande =  date_soin and soins.total > 0      )  AS nom_soin~") COMPUTE(NAME=~"(select min(rdv) as prochain_rdv from rdv, etat_rdv  where rdv.code = patient.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' and cast (rdv.rdv as date)  > cast(getdate() as date))~") COMPUTE(NAME=~"(select max(rdv) as dernier_rdv from rdv, etat_rdv  where rdv.code = patient.code and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' and cast (rdv.rdv as date)  <= cast(getdate() as date))~")    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":code_min and :code_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"patient~~~".~~~"type_dossier~~~"~"   OP =~"between~"    EXP2 =~":dos_min and :dos_max~" ) ) ARG(NAME = ~"code_min~" TYPE = number)  ARG(NAME = ~"code_max~" TYPE = number)  ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"dos_min~" TYPE = string)  ARG(NAME = ~"dos_max~" TYPE = string)  ARG(NAME = ~"date_ref~" TYPE = date) " arguments=(("code_min", number),("code_max", number),("prat_min", string),("prat_max", string),("dos_min", string),("dos_max", string),("date_ref", date))  sort="nom A patient_prenom A " )
