table(column=(type=decimal(0) updatewhereclause=yes name=numero_memoire dbname="ememoire_luxembourg.numero_memoire" )
 column=(type=date updatewhereclause=yes name=date dbname="ememoire_luxembourg.date" )
 column=(type=char(50) updatewhereclause=yes name=patient_nom dbname="patient.nom" )
 column=(type=char(30) updatewhereclause=yes name=patient_prenom dbname="patient.prenom" )
 column=(type=char(1) updatewhereclause=yes name=etat dbname="ememoire_luxembourg.etat" values="Non simulé	N/Simulation OK	S/Simulation non OK	K/Validation OK	V/Validation non OK	L/Annulation auto	A/Contestation	C/Annulation man.	M/" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien dbname="ememoire_luxembourg.code_praticien" )
 column=(type=decimal(0) updatewhereclause=yes name=numero_dossier dbname="patient.numero_dossier" )
 column=(type=number updatewhereclause=yes name=code dbname="patient.code" )
 column=(type=decimal(2) updatewhereclause=yes name=total_montant_caisse dbname="total_montant_caisse" )
 column=(type=char(1) updatewhereclause=yes name=ememoire_luxembourg_operations_type_operation dbname="ememoire_luxembourg_operations.type_operation" values="Simulation	S/Contestation	C/Validation	V/Envoi eMémoire	E/Génération PDF	G/Annulation eMémoire	A/" )
 column=(type=char(1) updatewhereclause=yes name=ememoire_luxembourg_operations_success dbname="ememoire_luxembourg_operations.success" values="OK	O/Echec	N/" )
 column=(type=datetime updatewhereclause=yes name=ememoire_luxembourg_operations_date_heure dbname="ememoire_luxembourg_operations.date_heure" )
 column=(type=char(1) updatewhereclause=yes name=etat_rd dbname="ememoire_luxembourg.etat_rd" values="Non envoyé	N/Envoyé	E/Annulé	A/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ememoire_luxembourg~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"ememoire_luxembourg_operations~" ) COLUMN(NAME=~"ememoire_luxembourg.numero_memoire~") COLUMN(NAME=~"ememoire_luxembourg.date~") COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.prenom~") COLUMN(NAME=~"ememoire_luxembourg.etat~") COLUMN(NAME=~"ememoire_luxembourg.code_praticien~") COLUMN(NAME=~"patient.numero_dossier~") COLUMN(NAME=~"patient.code~") COMPUTE(NAME=~"(select sum(montant_caisse) from ligne_ememoire_luxembourg where ememoire_luxembourg.numero_memoire = ligne_ememoire_luxembourg.numero_memoire) as total_montant_caisse~") COLUMN(NAME=~"ememoire_luxembourg_operations.type_operation~") COLUMN(NAME=~"ememoire_luxembourg_operations.success~") COLUMN(NAME=~"ememoire_luxembourg_operations.date_heure~") COLUMN(NAME=~"ememoire_luxembourg.etat_rd~")    JOIN (LEFT=~"ememoire_luxembourg.code_patient~"    OP =~"=~"RIGHT=~"patient.code~" )    JOIN (LEFT=~"ememoire_luxembourg.numero_memoire~"    OP =~"=~"RIGHT=~"ememoire_luxembourg_operations.numero_memoire~" )WHERE(    EXP1 =~"( ( ~~~"ememoire_luxembourg~~~".~~~"code_praticien~~~"~"   OP =~"between~"    EXP2 =~":prat_min and :prat_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( date(~~~"ememoire_luxembourg_operations~~~".~~~"date_heure~~~")~"   OP =~"between~"    EXP2 =~":date_min and :date_max )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":dossier_min and :dossier_max ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"ememoire_luxembourg_operations~~~".~~~"type_operation~~~"~"   OP =~"between~"    EXP2 =~":operation_min and :operation_max~" ) ) ARG(NAME = ~"prat_min~" TYPE = string)  ARG(NAME = ~"prat_max~" TYPE = string)  ARG(NAME = ~"date_min~" TYPE = date)  ARG(NAME = ~"date_max~" TYPE = date)  ARG(NAME = ~"dossier_min~" TYPE = number)  ARG(NAME = ~"dossier_max~" TYPE = number)  ARG(NAME = ~"operation_min~" TYPE = string)  ARG(NAME = ~"operation_max~" TYPE = string) " arguments=(("prat_min", string),("prat_max", string),("date_min", date),("date_max", date),("dossier_min", number),("dossier_max", number),("operation_min", string),("operation_max", string))  sort="date A numero_memoire A ememoire_luxembourg_operations_date_heure A " )
