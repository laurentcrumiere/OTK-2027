table(column=(type=char(20) updatewhereclause=yes name=dossier_nom dbname="dossier.nom" dbalias=".nom" )
 column=(type=long updatewhereclause=yes name=nb_dossiers dbname="nb_dossiers" )
 column=(type=char(6) updatewhereclause=yes name=prati_code dbname="prati.code" dbalias=".code" validation="len ( trim ( gettext() )) > 0" validationmsg="~"Ce code doit être obligatoirement saisi~"" )
 column=(type=char(2) updatewhereclause=yes name=dossier_code dbname="dossier.code" dbalias=".code" )
 column=(type=char(81) updatewhereclause=yes name=prati_nom dbname="prati_nom" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prati~" )  TABLE(NAME=~"patient~" )  TABLE(NAME=~"dossier~" ) COLUMN(NAME=~"dossier.nom~") COMPUTE(NAME=~"count(*) as nb_dossiers~") COLUMN(NAME=~"prati.code~") COLUMN(NAME=~"dossier.code~") COMPUTE(NAME=~"(prati.nom + ' ' + isnull(prati.prenom, '')) as prati_nom~")    JOIN (LEFT=~"patient.code_praticien~"    OP =~"=~"RIGHT=~"prati.code~" )    JOIN (LEFT=~"dossier.code~"    OP =~"=~"RIGHT=~"patient.type_dossier~" )WHERE(    EXP1 =~"~~~"patient~~~".~~~"numero_dossier~~~"~"   OP =~"between~"    EXP2 =~":num_min  and :num_max~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"prati~~~".~~~"code~~~"~"   OP =~"between~"    EXP2 =~":prati_min and :prati_max~" )  GROUP(NAME=~"dossier.code~") GROUP(NAME=~"prati.code~") GROUP(NAME=~"dossier.nom~") GROUP(NAME=~"prati.nom~") GROUP(NAME=~"prati.prenom~")) ARG(NAME = ~"num_min~" TYPE = number)  ARG(NAME = ~"num_max~" TYPE = number)  ARG(NAME = ~"prati_min~" TYPE = string)  ARG(NAME = ~"prati_max~" TYPE = string) " arguments=(("num_min", number),("num_max", number),("prati_min", string),("prati_max", string))  sort="dossier_nom A prati_nom A " )
