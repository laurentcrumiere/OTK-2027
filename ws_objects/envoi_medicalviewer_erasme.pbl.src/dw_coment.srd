table(column=(type=date update=yes updatewhereclause=yes name=dat dbname="coment.dat" dbalias=".dat" initial="today" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com_html dbname="coment.com_html" dbalias=".com_html" initial="null" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=coul_texte dbname="coment.coul_texte" dbalias=".coul_texte" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=coul_fond dbname="coment.coul_fond" dbalias=".coul_fond" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="coment.code" dbalias=".code" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=ordre dbname="coment.ordre" dbalias=".ordre" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=acte_prevu_html dbname="coment.acte_prevu_html" dbalias=".acte_prevu_html" )
 column=(type=char(100) update=yes updatewhereclause=yes name=hygiene_v10 dbname="coment.hygiene_v10" dbalias=".hygiene_v10" )
 column=(type=char(100) update=yes updatewhereclause=yes name=elastique_v10 dbname="coment.elastique_v10" dbalias=".elastique_v10" )
 column=(type=long updatewhereclause=yes name=nb_tracabilite dbname="nb_tracabilite" )
 column=(type=char(80) updatewhereclause=yes name=rdv dbname="rdv" )
 column=(type=char(6) update=yes updatewhereclause=yes name=intervenant dbname="coment.intervenant" dbalias=".intervenant" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="coment.user_modif" dbalias=".user_modif" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_modif dbname="coment.date_modif" dbalias=".date_modif" initial="today" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com dbname="coment.com" dbalias=".com" initial="null" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=acte_prevu dbname="coment.acte_prevu" dbalias=".acte_prevu" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com3_html dbname="coment.com3_html" dbalias=".com3_html" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com4_html dbname="coment.com4_html" dbalias=".com4_html" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com5_html dbname="coment.com5_html" dbalias=".com5_html" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com6_html dbname="coment.com6_html" dbalias=".com6_html" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com3 dbname="coment.com3" dbalias=".com3" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com4 dbname="coment.com4" dbalias=".com4" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com5 dbname="coment.com5" dbalias=".com5" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com6 dbname="coment.com6" dbalias=".com6" )
 column=(type=long updatewhereclause=yes name=nb_sterilisation dbname="nb_sterilisation" )
 column=(type=long updatewhereclause=yes name=ecart_semaine dbname="ecart_semaine" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coment~" ) COLUMN(NAME=~"coment.dat~") COLUMN(NAME=~"coment.com_html~") COLUMN(NAME=~"coment.coul_texte~") COLUMN(NAME=~"coment.coul_fond~") COLUMN(NAME=~"coment.code~") COLUMN(NAME=~"coment.ordre~") COLUMN(NAME=~"coment.acte_prevu_html~") COLUMN(NAME=~"coment.hygiene_v10~") COLUMN(NAME=~"coment.elastique_v10~") COMPUTE(NAME=~"(select count(*) as nb_tracabilite from fiche_tracabilite where fiche_tracabilite.code_patient = coment.code and coment.dat = fiche_tracabilite.date_rdv )~") COMPUTE(NAME=~"(select first  left( isnull(symbole,'')+repeat(' ',40)      , 40) + left(  isnull(type_rdv.couleur,'')+repeat(' ',40)   , 40)     as rdv from rdv, type_rdv, etat_rdv where rdv.code = coment.code and coment.dat = date(rdv.rdv) and rdv.~~~"type~~~" = type_rdv.code and rdv.absent = etat_rdv.code order by etat_rdv.elimine_agenda asc, rdv.rdv desc )~") COLUMN(NAME=~"coment.intervenant~") COLUMN(NAME=~"coment.user_modif~") COLUMN(NAME=~"coment.date_modif~") COLUMN(NAME=~"coment.com~") COLUMN(NAME=~"coment.acte_prevu~") COLUMN(NAME=~"coment.com3_html~") COLUMN(NAME=~"coment.com4_html~") COLUMN(NAME=~"coment.com5_html~") COLUMN(NAME=~"coment.com6_html~") COLUMN(NAME=~"coment.com3~") COLUMN(NAME=~"coment.com4~") COLUMN(NAME=~"coment.com5~") COLUMN(NAME=~"coment.com6~") COMPUTE(NAME=~"(select count(*) as nb_sterilisation from sterilisation where sterilisation.code_patient = coment.code and coment.dat = sterilisation.date_saisie )~") COMPUTE(NAME=~"weeks ((select first coment_pas.dat from coment as coment_pas where coment_pas.code = coment.code and coment_pas.dat < coment.dat order by coment_pas.dat desc), coment.dat) as ecart_semaine~")WHERE(    EXP1 =~"~~~"coment~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":numero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"coment~~~".~~~"dat~~~"~"   OP =~"=~"    EXP2 =~":v_date~" ) ) ORDER(NAME=~"coment.ordre~" ASC=yes ) ARG(NAME = ~"numero~" TYPE = number)  ARG(NAME = ~"v_date~" TYPE = date) " update="coment" updatewhere=0 updatekeyinplace=yes arguments=(("numero", number),("v_date", date))  sort="dat A ordre A " )
