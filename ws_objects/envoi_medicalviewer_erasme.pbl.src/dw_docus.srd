table(column=(type=datetime updatewhereclause=yes name=historique_editions_date_modif dbname="historique_editions.date_modif" dbalias=".date_modif" )
 column=(type=char(150) updatewhereclause=yes name=nom_courrier dbname="historique_editions.nom_courrier" dbalias=".nom_courrier" )
 column=(type=number updatewhereclause=yes name=code dbname="historique_editions.code" dbalias=".code" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"historique_editions~" ) COLUMN(NAME=~"historique_editions.date_modif~") COLUMN(NAME=~"historique_editions.nom_courrier~") COLUMN(NAME=~"historique_editions.code~")WHERE(    EXP1 =~"date(~~~"historique_editions~~~".~~~"date_modif~~~")~"   OP =~"=~"    EXP2 =~":date_min ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"trim(isnull(nom_courrier, ''))~"   OP =~"<>~"    EXP2 =~"''~" ) ) ARG(NAME = ~"date_min~" TYPE = date) " arguments=(("date_min", date))  sort="historique_editions_date_modif A " )
