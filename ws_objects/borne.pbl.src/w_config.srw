global type w_config from window
integer width = 4526
integer height = 3040
boolean titlebar = true
string title = "Paramétrage et Configuration de la Borne"
boolean controlmenu = true
windowtype windowtype = response!
long backcolor = 15780518
string icon = "AppIcon!"
boolean center = true
cb_fermer cb_fermer
pb_enregistrer pb_enregistrer
pb_annuler pb_annuler
cb_restau cb_restau
cb_memo cb_memo
cb_pronostic cb_pronostic
tab_1 tab_1
end type
global w_config w_config

type variables


// pour fermeture automatique
double v_fermeture


string v_rep_mise_jour_centralise
end variables

on w_config.create
this.cb_fermer=create cb_fermer
this.pb_enregistrer=create pb_enregistrer
this.pb_annuler=create pb_annuler
this.cb_restau=create cb_restau
this.cb_memo=create cb_memo
this.cb_pronostic=create cb_pronostic
this.tab_1=create tab_1
this.Control[]={this.cb_fermer,&
this.pb_enregistrer,&
this.pb_annuler,&
this.cb_restau,&
this.cb_memo,&
this.cb_pronostic,&
this.tab_1}
end on

on w_config.destroy
destroy(this.cb_fermer)
destroy(this.pb_enregistrer)
destroy(this.pb_annuler)
destroy(this.cb_restau)
destroy(this.cb_memo)
destroy(this.cb_pronostic)
destroy(this.tab_1)
end on

event open;	

// pour fermeture automatique
v_fermeture = message.doubleparm

//pb_enregistrer.PictureName = 	"pb_390_120.jpg"
//pb_fermer.PictureName = 		"pb_390_120.jpg"
//pb_annuler.PictureName = 		"pb_390_120.jpg"
//
//pb_enregistrer.DisabledName = 	"pb_390_120_not.jpg"
//pb_fermer.DisabledName = 		"pb_390_120_not.jpg"
//pb_annuler.DisabledName = 		"pb_390_120_not.jpg"


tab_1.tabpage_autre.dw_etat_rdv.settransobject(sqlca)
tab_1.tabpage_autre.dw_etat_rdv.retrieve()



pb_annuler.triggerevent(clicked!)

if SERIAL = "87284" then
	cb_pronostic.visible = true
end if


string v_maj

select top 1  maj_orthokis_centralisee, chemin_maj_orthokis_centralisee
into :v_maj, :v_rep_mise_jour_centralise 
from param ;

if v_maj = "O" then 
	cb_memo.visible = true
	cb_restau.visible = true
end if


tab_1.tabpage_non_trouve.st_son2.visible = true
tab_1.tabpage_non_trouve.sle_son2.visible = true
tab_1.tabpage_non_trouve.pb_jouer_son2.visible = true
tab_1.tabpage_non_trouve.pb_chercher_son2.visible = true


if v_fermeture = 1 then
	Timer(0.01)
end if



end event

event timer;if v_fermeture = 1 then
	close(this)
end if

end event

type cb_fermer from uo_picturebutton_390x120 within w_config
integer x = 3538
integer y = 2772
integer width = 613
integer height = 164
integer taborder = 50
integer textsize = -12
fontcharset fontcharset = ansi!
string text = "&Fermer"
string iconname = "ACTIONS_fermer.png"
end type

event clicked;call super::clicked;close(parent)
end event

type pb_enregistrer from uo_picturebutton_390x120 within w_config
integer x = 2885
integer y = 2772
integer width = 613
integer height = 164
integer taborder = 40
integer textsize = -12
fontcharset fontcharset = ansi!
string text = "&Enregistrer"
string iconname = "ACTIONS_enregistrer.png"
end type

event clicked;call super::clicked;

tab_1.tabpage_principale.uo_cabinet.sauver("cabinet")
tab_1.tabpage_principale.uo_etat.sauver("etat")

// Onglet principal
SetprofileString(dir_ini+"orthokis.ini","Borne","taille_clavier",tab_1.tabpage_principale.em_taille.text)

// position clavier
if tab_1.tabpage_principale.rb_normale.checked then
	SetprofileString (dir_ini+"orthokis.ini","Borne","position_clavier","N")
else
	if tab_1.tabpage_principale.rb_bas.checked then
		SetprofileString (dir_ini+"orthokis.ini","Borne","position_clavier","B")
	else
		SetprofileString (dir_ini+"orthokis.ini","Borne","position_clavier","A")
	end if
end if

SetprofileString (dir_ini+"orthokis.ini","Borne","position_x", tab_1.tabpage_principale.em_x.text)
SetprofileString (dir_ini+"orthokis.ini","Borne","position_y", tab_1.tabpage_principale.em_y.text)


SetprofileString (dir_ini+"orthokis.ini","Borne","fichier_clavier","B")


if tab_1.tabpage_principale.rb_alpha.checked then
	SetprofileString (dir_ini+"orthokis.ini","Borne","disposition_clavier","A")
else
	SetprofileString (dir_ini+"orthokis.ini","Borne","disposition_clavier","Z")
end if

// Touches ...

string fichier_pour_touches
integer index_fichier_pour_touches

index_fichier_pour_touches = tab_1.tabpage_principale.ddplb_touches.FindItem ( tab_1.tabpage_principale.ddplb_touches.Text, 0 )

fichier_pour_touches = tab_1.tabpage_principale.ddplb_touches.PictureName[index_fichier_pour_touches]



SetprofileString (dir_ini+"orthokis.ini","Borne","image_fond_principale",trim(tab_1.tabpage_principale.sle_image_de_fond.text))

SetprofileString (dir_ini+"orthokis.ini","Borne","mot_pour_quitter",trim(tab_1.tabpage_principale.sle_mot_pour_quitter.text))
SetprofileString (dir_ini+"orthokis.ini","Borne","fichier_pour_touches", fichier_pour_touches )
SetprofileString (dir_ini+"orthokis.ini","Borne","index_fichier_pour_touches", string(index_fichier_pour_touches) )

if  tab_1.tabpage_principale.cbx_masquer_prenom.checked then
	SetProfileString (dir_ini+"orthokis.ini","Borne","avec_prenom","N")
else
	SetProfileString (dir_ini+"orthokis.ini","Borne","avec_prenom","O")
end if


if tab_1.tabpage_principale.cbx_activer_sons.checked then 
	SetProfileString (dir_ini+"orthokis.ini","Borne","activer_son","O")
else
	SetProfileString (dir_ini+"orthokis.ini","Borne","activer_sons","N")
end if


// Onglet Bienvenue

tab_1.tabpage_bienvenue.uo_bienvenue.sauver("bienvenue")
tab_1.tabpage_bienvenue.uo_adulte.sauver("bienvenue_adulte")
SetProfileString (dir_ini+"orthokis.ini","Borne","attente_bienvenue",tab_1.tabpage_bienvenue.em_attente.text)
SetprofileString (dir_ini+"orthokis.ini","Borne","image_fond_bienvenue",trim(tab_1.tabpage_bienvenue.sle_image_de_fond_bienvenue.text))

SetprofileString (dir_ini+"orthokis.ini","Borne","son1",trim(tab_1.tabpage_bienvenue.sle_son1.text))



// Onglet retard
tab_1.tabpage_retard.uo_retard.sauver("retard")
tab_1.tabpage_retard.uo_retard_adulte.sauver("retard_adulte")
SetProfileString (dir_ini+"orthokis.ini","Borne","tolerance_retard",tab_1.tabpage_retard.em_tolerance.text)
SetprofileString (dir_ini+"orthokis.ini","Borne","image_fond_retard",trim(tab_1.tabpage_retard.sle_image_de_fond_retard.text))
SetprofileString (dir_ini+"orthokis.ini","Borne","son3",trim(tab_1.tabpage_retard.sle_son3.text))

// Onglet avance
tab_1.tabpage_avance.uo_avance.sauver("avance")
tab_1.tabpage_avance.uo_avance_adulte.sauver("avance_adulte")
SetProfileString (dir_ini+"orthokis.ini","Borne","delai_avance",tab_1.tabpage_avance.em_delai_avance.text)
SetprofileString (dir_ini+"orthokis.ini","Borne","image_fond_avance",trim(tab_1.tabpage_avance.sle_image_de_fond_avance.text))
SetprofileString (dir_ini+"orthokis.ini","Borne","son4",trim(tab_1.tabpage_avance.sle_son4.text))

// Onglet non trouvé
tab_1.tabpage_non_trouve.uo_non_trouve.sauver("non_trouve")
SetProfileString (dir_ini+"orthokis.ini","Borne","attente_non_trouve",tab_1.tabpage_non_trouve.em_attente_non_trouve.text)
SetprofileString (dir_ini+"orthokis.ini","Borne","image_fond_non_trouve",trim(tab_1.tabpage_non_trouve.sle_image_de_fond_non_trouve.text))
SetprofileString (dir_ini+"orthokis.ini","Borne","son2",trim(tab_1.tabpage_non_trouve.sle_son2.text))

//--------------------------------- FENETRE ANNIVERSAIRE   ----------------------
if tab_1.tabpage_anniversaire.cbx_souhaiter_anniversaire.checked then
	SetProfileString (dir_ini+"orthokis.ini","Borne","souhaiter_anniversaire","O") 
else
	SetProfileString (dir_ini+"orthokis.ini","Borne","souhaiter_anniversaire","N") 
end if
if tab_1.tabpage_anniversaire.cbx_souhaiter_anniversaire_adultes.checked then
	SetProfileString (dir_ini+"orthokis.ini","Borne","souhaiter_anniversaire_adulte","O")
else
	SetProfileString (dir_ini+"orthokis.ini","Borne","souhaiter_anniversaire_adulte","N")
end if
tab_1.tabpage_anniversaire.uo_anniversaire.sauver("anniversaire")
tab_1.tabpage_anniversaire.uo_anniversaire_adulte.sauver("anniversaire_adulte")
SetprofileString (dir_ini+"orthokis.ini","Borne","image_fond_anniversaire",trim(tab_1.tabpage_anniversaire.sle_image_de_fond_anniversaire.text))
SetprofileString (dir_ini+"orthokis.ini","Borne","son5",trim(tab_1.tabpage_anniversaire.sle_son5.text))



//--------------------------------- FENETRE RETARD DE REGLEMENT   ----------------------
SetProfileString (dir_ini+"orthokis.ini","Borne","montant_minimal_retard",tab_1.tabpage_reglement.em_montant_minimal_retard.text) 
tab_1.tabpage_reglement.uo_reglement.sauver("reglement")
tab_1.tabpage_reglement.uo_reglement_adulte.sauver("reglement_adulte")
SetProfileString (dir_ini+"orthokis.ini","Borne","image_fond_reglement",tab_1.tabpage_reglement.sle_image_de_fond_reglement.text)
SetprofileString (dir_ini+"orthokis.ini","Borne","son6",trim(tab_1.tabpage_reglement.sle_son6.text))



//Onglet Autre
SetProfileString (dir_ini+"orthokis.ini","Borne","etat_salle_attente",tab_1.tabpage_autre.dw_etat_rdv.gettext())

if  tab_1.tabpage_autre.cbx_eliminer_transparence.checked then
	SetProfileString (dir_ini+"orthokis.ini","Borne","avec_transparence","N")
else
	SetProfileString (dir_ini+"orthokis.ini","Borne","avec_transparence","O")
end if

SetProfileString (dir_ini+ "orthokis.ini","Borne","rafraichissement_saisies",tab_1.tabpage_autre.em_rafraichissement_saisies.text)

Setprofilestring(dir_ini+inifile_orthokis,"connexion","url_licences",tab_1.tabpage_autre.sle_url_licences.text)

if tab_1.tabpage_autre.cbx_licence_logicielle.checked  then
	SetProfilestring(dir_ini+inifile_orthokis,"connexion","licence_logicielle","O")	
else
	SetProfilestring(dir_ini+inifile_orthokis,"connexion","licence_logicielle","N")	
end if




end event

type pb_annuler from uo_picturebutton_390x120 within w_config
integer x = 2231
integer y = 2772
integer width = 613
integer height = 164
integer taborder = 50
integer textsize = -12
fontcharset fontcharset = ansi!
string text = "&Annuler"
string iconname = "ACTIONS_annuler.png"
end type

event clicked;call super::clicked;
// ---------------------            FENETRE PRINCIPALE          --------------------------

tab_1.tabpage_principale.uo_cabinet.charger("cabinet","Cabinet du Dr Albert Molaire")
tab_1.tabpage_principale.uo_etat.charger("etat","Veuillez indiquer votre nom ou votre prénom (au moins 3 lettres) puis cliquez sur Rechercher")




tab_1.tabpage_principale.em_taille.text  = string(profileint(dir_ini+"orthokis.ini","Borne","taille_clavier",4))

string pos
pos =  profilestring(dir_ini+"orthokis.ini","Borne","position_clavier","B")
if pos = "N" then
	tab_1.tabpage_principale.rb_normale.checked = true
	tab_1.tabpage_principale.rb_bas.checked = false
	tab_1.tabpage_principale.rb_autre.checked = false
else
	if pos = "B" then
		tab_1.tabpage_principale.rb_normale.checked = false
		tab_1.tabpage_principale.rb_bas.checked = true
		tab_1.tabpage_principale.rb_autre.checked = false
	else
		tab_1.tabpage_principale.rb_normale.checked = false
		tab_1.tabpage_principale.rb_bas.checked = false
		tab_1.tabpage_principale.rb_autre.checked = true
	end if
end if

tab_1.tabpage_principale.em_x.text = profileString (dir_ini+"orthokis.ini","Borne","position_x", "32")
tab_1.tabpage_principale.em_y.text = profileString (dir_ini+"orthokis.ini","Borne","position_y", "2770")

pos =  profilestring(dir_ini+"orthokis.ini","Borne","disposition_clavier","Z")
if pos = "A" then
	tab_1.tabpage_principale.rb_alpha.checked = true
	tab_1.tabpage_principale.rb_azerty.checked = false
else
	tab_1.tabpage_principale.rb_alpha.checked = false
	tab_1.tabpage_principale.rb_azerty.checked = true
end if


tab_1.tabpage_principale.sle_mot_pour_quitter.text = profileString (dir_ini+"orthokis.ini","Borne","mot_pour_quitter","ARAKIS")

tab_1.tabpage_principale.ddplb_touches.SelectItem (  ProfileInt (dir_ini+"orthokis.ini","Borne","index_fichier_pour_touches", 1 ) )


tab_1.tabpage_principale.sle_image_de_fond.text = ProfileString (dir_ini+"orthokis.ini","Borne","image_fond_principale","")

if  ProfileString (dir_ini+"orthokis.ini","Borne","avec_prenom","O") = "N" then
	tab_1.tabpage_principale.cbx_masquer_prenom.checked = true
else
	tab_1.tabpage_principale.cbx_masquer_prenom.checked = false
end if

if  ProfileString (dir_ini+"orthokis.ini","Borne","activer_sons","O") = "O" then
	tab_1.tabpage_principale.cbx_activer_sons.checked = true
else
	tab_1.tabpage_principale.cbx_activer_sons.checked = false
end if


//--------------------------------- FENETRE BIENVENUE  ----------------------
tab_1.tabpage_bienvenue.uo_bienvenue.charger("bienvenue","Bonjour {prenom}, Merci de patienter en Salle d'Attente")
tab_1.tabpage_bienvenue.uo_adulte.charger("bienvenue_adulte","Bonjour {titre} {nom}, Merci de patienter en Salle d'Attente")

tab_1.tabpage_bienvenue.em_attente.text = ProfileString (dir_ini+"orthokis.ini","Borne","attente_bienvenue","5")
tab_1.tabpage_bienvenue.sle_image_de_fond_bienvenue.text = ProfileString (dir_ini+"orthokis.ini","Borne","image_fond_bienvenue","")
tab_1.tabpage_bienvenue.sle_son1.text = ProfileString (dir_ini+"orthokis.ini","Borne","son1","")


//--------------------------------- FENETRE RETARD  ----------------------
tab_1.tabpage_retard.em_tolerance.text = ProfileString (dir_ini+"orthokis.ini","Borne","tolerance_retard","5")
tab_1.tabpage_retard.uo_retard.charger("retard","Bonjour {prenom}, Tu avais rendez-vous à {heure_rdv} : tu es en retard ! Merci de te présenter au Secrétariat")
tab_1.tabpage_retard.uo_retard_adulte.charger("retard_adulte","Bonjour {titre} {nom}, Vous aviez rendez-vous à {heure_rdv} : vous êtes en retard ! Merci de vous présenter au Secrétariat")
tab_1.tabpage_retard.sle_image_de_fond_retard.text = ProfileString (dir_ini+"orthokis.ini","Borne","image_fond_retard",tab_1.tabpage_bienvenue.sle_image_de_fond_bienvenue.text)
tab_1.tabpage_retard.sle_son3.text = ProfileString (dir_ini+"orthokis.ini","Borne","son3","")

//--------------------------------- FENETRE AVANCE   ----------------------
tab_1.tabpage_avance.em_delai_avance.text = ProfileString (dir_ini+"orthokis.ini","Borne","delai_avance","30")
tab_1.tabpage_avance.uo_avance.charger("avance","Bonjour {prenom}, Tu as rendez-vous à {heure_rdv} : tu es en avance ! Merci de te présenter au Secrétariat")
tab_1.tabpage_avance.uo_avance_adulte.charger("avance_adulte","Bonjour {titre} {nom}, Vous avez rendez-vous à {heure_rdv} : vous êtes en avance ! Merci de vous présenter au Secrétariat")
tab_1.tabpage_avance.sle_image_de_fond_avance.text = ProfileString (dir_ini+"orthokis.ini","Borne","image_fond_avance",tab_1.tabpage_bienvenue.sle_image_de_fond_bienvenue.text)
tab_1.tabpage_avance.sle_son4.text = ProfileString (dir_ini+"orthokis.ini","Borne","son4","")

//--------------------------------- FENETRE NON TROUVE  ----------------------
tab_1.tabpage_non_trouve.uo_non_trouve.charger("non_trouve","Nous sommes désolés mais nous ne trouvons pas de patient pour ces critères ! Veuillez réessayer ou vous présenter au secrétariat.")
tab_1.tabpage_non_trouve.em_attente_non_trouve.text = ProfileString (dir_ini+"orthokis.ini","Borne","attente_non_trouve","5")
tab_1.tabpage_non_trouve.sle_image_de_fond_non_trouve.text = ProfileString (dir_ini+"orthokis.ini","Borne","image_fond_non_trouve","")
tab_1.tabpage_non_trouve.sle_son2.text = ProfileString (dir_ini+"orthokis.ini","Borne","son2","")



//--------------------------------- FENETRE ANNIVERSAIRE   ----------------------
if  ProfileString (dir_ini+"orthokis.ini","Borne","souhaiter_anniversaire","N") = "O" then
	tab_1.tabpage_anniversaire.cbx_souhaiter_anniversaire.checked = true
else
	tab_1.tabpage_anniversaire.cbx_souhaiter_anniversaire.checked = false
end if
if  ProfileString (dir_ini+"orthokis.ini","Borne","souhaiter_anniversaire_adulte","N") = "O" then
	tab_1.tabpage_anniversaire.cbx_souhaiter_anniversaire_adultes.checked = true
else
	tab_1.tabpage_anniversaire.cbx_souhaiter_anniversaire_adultes.checked = false
end if
tab_1.tabpage_anniversaire.uo_anniversaire.charger("anniversaire","{prenom}, C'est ton anniversaire aujourd'hui alors toute l'équipe te souhaite un TRES BON ANNIVERSAIRE !")
tab_1.tabpage_anniversaire.uo_anniversaire_adulte.charger("anniversaire_adulte","{titre} {nom}, C'est votre anniversaire aujourd'hui alors toute l'équipe vous souhaite un TRES BON ANNIVERSAIRE !")
tab_1.tabpage_anniversaire.sle_image_de_fond_anniversaire.text = ProfileString (dir_ini+"orthokis.ini","Borne","image_fond_anniversaire",tab_1.tabpage_bienvenue.sle_image_de_fond_bienvenue.text)
tab_1.tabpage_anniversaire.sle_son5.text = ProfileString (dir_ini+"orthokis.ini","Borne","son5","")


//--------------------------------- FENETRE RETARD DE REGLEMENT   ----------------------
tab_1.tabpage_reglement.em_montant_minimal_retard.text = ProfileString (dir_ini+"orthokis.ini","Borne","montant_minimal_retard","999999.99") 
tab_1.tabpage_reglement.uo_reglement.charger("reglement","Bonjour {prenom}, Merci de te présenter au secrétariat pour mettre à jour ton dossier.")
tab_1.tabpage_reglement.uo_reglement_adulte.charger("reglement_adulte","Bonjour {titre} {nom}, Merci de vous présenter au secrétariat pour mettre à jour votre dossier.")
tab_1.tabpage_reglement.sle_image_de_fond_reglement.text = ProfileString (dir_ini+"orthokis.ini","Borne","image_fond_reglement",tab_1.tabpage_reglement.sle_image_de_fond_reglement.text)
tab_1.tabpage_reglement.sle_son6.text = ProfileString (dir_ini+"orthokis.ini","Borne","son6","")



//---------------------- AUTRE ---------------------------

string etat_salle_attente
long lig
etat_salle_attente = ProfileString (dir_ini+"orthokis.ini","Borne","etat_salle_attente","S")

lig = tab_1.tabpage_autre.dw_etat_rdv.find("code = '"+etat_salle_attente+ "'", 1, 99999)

if lig > 0 then
	// le précédent ETAT configuré existe toujours !!
	tab_1.tabpage_autre.dw_etat_rdv.scrolltorow(lig)
else
	// le précendent état n'existe plus => On mémorise le 1er pour éviter les boulettes
	select min(code) into :etat_salle_attente from etat_rdv where actif = 1 and salle_attente = 'O' ;
	SetProfileString (dir_ini+"orthokis.ini","Borne","etat_salle_attente",etat_salle_attente)
end if

if  ProfileString (dir_ini+"orthokis.ini","Borne","avec_transparence","N") = "N" then
	tab_1.tabpage_autre.cbx_eliminer_transparence.checked = true
else
	tab_1.tabpage_autre.cbx_eliminer_transparence.checked = false
end if

tab_1.tabpage_autre.em_rafraichissement_saisies.text = ProfileString (dir_ini+"orthokis.ini" ,"Borne","rafraichissement_saisies","0")


tab_1.tabpage_autre.sle_url_licences.text = Profilestring(dir_ini+inifile_orthokis,"connexion","url_licences","")

if  Profilestring(dir_ini+inifile_orthokis,"connexion","licence_logicielle","O") = "O" then
	tab_1.tabpage_autre.cbx_licence_logicielle.checked = true
else
	tab_1.tabpage_autre.cbx_licence_logicielle.checked = false
end if


end event

