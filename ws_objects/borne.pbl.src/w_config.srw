on tabpage_bienvenue.create
this.pb_jouer_son1=create pb_jouer_son1
this.pb_chercher_son1=create pb_chercher_son1
this.sle_son1=create sle_son1
this.st_son1=create st_son1
this.st_11=create st_11
this.uo_adulte=create uo_adulte
this.st_3=create st_3
this.pb_2=create pb_2
this.sle_image_de_fond_bienvenue=create sle_image_de_fond_bienvenue
this.st_6=create st_6
this.em_attente=create em_attente
this.st_10=create st_10
this.uo_bienvenue=create uo_bienvenue
this.gb_1=create gb_1
this.gb_4=create gb_4
this.Control[]={this.pb_jouer_son1,&
this.pb_chercher_son1,&
this.sle_son1,&
this.st_son1,&
this.st_11,&
this.uo_adulte,&
this.st_3,&
this.pb_2,&
this.sle_image_de_fond_bienvenue,&
this.st_6,&
this.em_attente,&
this.st_10,&
this.uo_bienvenue,&
this.gb_1,&
this.gb_4}
end on

on tabpage_bienvenue.destroy
destroy(this.pb_jouer_son1)
destroy(this.pb_chercher_son1)
destroy(this.sle_son1)
destroy(this.st_son1)
destroy(this.st_11)
destroy(this.uo_adulte)
destroy(this.st_3)
destroy(this.pb_2)
destroy(this.sle_image_de_fond_bienvenue)
destroy(this.st_6)
destroy(this.em_attente)
destroy(this.st_10)
destroy(this.uo_bienvenue)
destroy(this.gb_1)
destroy(this.gb_4)
end on

