alignment alignment = center!
integer selectedtab = 1
tabpage_principale tabpage_principale
tabpage_bienvenue tabpage_bienvenue
tabpage_retard tabpage_retard
tabpage_avance tabpage_avance
tabpage_non_trouve tabpage_non_trouve
tabpage_anniversaire tabpage_anniversaire
tabpage_reglement tabpage_reglement
tabpage_autre tabpage_autre
end type

on tab_1.create
this.tabpage_principale=create tabpage_principale
this.tabpage_bienvenue=create tabpage_bienvenue
this.tabpage_retard=create tabpage_retard
this.tabpage_avance=create tabpage_avance
this.tabpage_non_trouve=create tabpage_non_trouve
this.tabpage_anniversaire=create tabpage_anniversaire
this.tabpage_reglement=create tabpage_reglement
this.tabpage_autre=create tabpage_autre
this.Control[]={this.tabpage_principale,&
this.tabpage_bienvenue,&
this.tabpage_retard,&
this.tabpage_avance,&
this.tabpage_non_trouve,&
this.tabpage_anniversaire,&
this.tabpage_reglement,&
this.tabpage_autre}
end on

on tab_1.destroy
destroy(this.tabpage_principale)
destroy(this.tabpage_bienvenue)
destroy(this.tabpage_retard)
destroy(this.tabpage_avance)
destroy(this.tabpage_non_trouve)
destroy(this.tabpage_anniversaire)
destroy(this.tabpage_reglement)
destroy(this.tabpage_autre)
end on

