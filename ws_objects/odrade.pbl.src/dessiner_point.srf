$PBExportHeader$dessiner_point.srf
global type dessiner_point from function_object
end type

forward prototypes
global subroutine dessiner_point (long xpos, long ypos, long epaisseur, long couleur, picture image)
end prototypes

global subroutine dessiner_point (long xpos, long ypos, long epaisseur, long couleur, picture image);point_type point_prec
ulong hpen
long l_device,l_handle

l_handle = handle(image)
l_device = GetDC(l_handle)

hpen = CreatePen(0, epaisseur, couleur)
SelectObject(l_device, hpen)

MoveToEx(l_device, xpos - 4, ypos, point_prec)
LineTo(l_device, xpos + 5, ypos)
MoveToEx(l_device, xpos, ypos - 4, point_prec)
LineTo(l_device, xpos , ypos + 5)


end subroutine

