global type calcul_age_selon_date from function_object
end type

forward prototypes
global function string calcul_age_selon_date (date naissance, date date_relative)
end prototypes

global function string calcul_age_selon_date (date naissance, date date_relative);// But de la fonction :
// Calculer l'age d'une personne

// Explications des variables : 
//				 naissance_string : date de naissance sous forme de string
//				 age : retourne l'age sous la forme an + mois

string age
long  an_naissance, mois_naissance



IF naissance = date('00/00/0000') OR IsNull(naissance)  THEN
	age = "0 an 0 mois"
ELSE	
	// Calcul de l'an
	IF month(date_relative) < month( naissance ) THEN
		an_naissance = year(date_relative) - year( naissance ) - 1
	ELSE
		an_naissance = year(date_relative) - year( naissance )
	END IF
	
	// Calcul du mois
	IF month(date_relative) < month( naissance ) THEN
		mois_naissance = month(date_relative) - month( naissance ) +12
	ELSE
		mois_naissance = month(date_relative) - month( naissance )
	END IF
	age = string(an_naissance) + " ans " + string(mois_naissance)
END IF
return age
end function

