$PBExportHeader$tracer_cercles.srf
global type tracer_cercles from function_object
end type

forward prototypes
global subroutine tracer_cercles (long code_patient, long code_radio, long code_trace, picture image, real resolution_x, real resolution_y, real pourcentage)
end prototypes

global subroutine tracer_cercles (long code_patient, long code_radio, long code_trace, picture image, real resolution_x, real resolution_y, real pourcentage);// Variables

ulong l_handle, l_device
double x,y
long num_cercle
ulong hpen
string visible
long couleur,epaisseur
real rayon


point_type point1, point2, point3, point_prec
point_type pointA ,pointB

// Recherche de la couleur de tracé des cercles
SELECT couleur_droite, epaisseur_droite into :couleur, :epaisseur from traces where code_trace = :code_trace and code_patient = :code_patient 
and code_radio = :code_radio using t_Odrade  ;


l_handle = handle(image)
l_device = GetDC(l_handle)
hpen = CreatePen(0, epaisseur, couleur)
SelectObject(l_device, hpen)


// Recherche des points dans la base ...


// LISTE DES CERCLES DU TRACE
DECLARE cur_cercle CURSOR FOR 
Select code_cercle, rayon  from cercles where code_patient = :code_patient and code_radio = :code_radio and code_trace = :code_trace 
order by code_cercle using t_Odrade ;


open cur_cercle   ;

fetch cur_cercle into :num_cercle, :rayon ;

// Parcours de tous les cercles du tracé
do while t_Odrade.sqlcode = 0	
		
	// Point N°1 = centre
	Select x, y into :x,:y from points_accr_cercles,points_traces where points_accr_cercles.code_patient = :code_patient 
	and points_accr_cercles.code_radio = :code_radio 	and points_accr_cercles.code_trace = :code_trace 
	and points_accr_cercles.code_patient = points_traces.code_patient 	and points_accr_cercles.code_radio = points_traces.code_radio 
	and points_accr_cercles.code_point_trace = points_traces.code_point_trace	
	and points_accr_cercles.code_trace = points_traces.code_trace	and points_accr_cercles.code_cercle = :num_cercle and rang = 1 using t_Odrade ;
	point1.x = x * resolution_x * pourcentage /100
	point1.y = y * resolution_y * pourcentage /100
	
	// Point N°2 = directtion N°1
	Select x, y into :x,:y from points_accr_cercles,points_traces where points_accr_cercles.code_patient = :code_patient 
	and points_accr_cercles.code_radio = :code_radio 	and points_accr_cercles.code_trace = :code_trace 
	and points_accr_cercles.code_patient = points_traces.code_patient 	and points_accr_cercles.code_radio = points_traces.code_radio 
	and points_accr_cercles.code_point_trace = points_traces.code_point_trace	
	and points_accr_cercles.code_trace = points_traces.code_trace	and points_accr_cercles.code_cercle = :num_cercle and rang = 2 using t_Odrade ;
	point2.x = x * resolution_x * pourcentage / 100
	point2.y = y * resolution_y * pourcentage /100
	
	// Point N°3 = direction N°2
	Select x, y into :x,:y from points_accr_cercles,points_traces where points_accr_cercles.code_patient = :code_patient 
	and points_accr_cercles.code_radio = :code_radio 	and points_accr_cercles.code_trace = :code_trace 
	and points_accr_cercles.code_patient = points_traces.code_patient 	and points_accr_cercles.code_radio = points_traces.code_radio 
	and points_accr_cercles.code_point_trace = points_traces.code_point_trace	
	and points_accr_cercles.code_trace = points_traces.code_trace	and points_accr_cercles.code_cercle = :num_cercle and rang = 3 using t_Odrade ;
	point3.x = x * resolution_x * pourcentage / 100
	point3.y = y * resolution_y * pourcentage /100
	
	rayon = rayon * resolution_x * pourcentage / 100

	// Coin en haut à gauche
	pointA.x = Point1.x - rayon
	pointA.y = Point1.y - rayon

	// Coin en bas à droite
	pointB.x = Point1.x + rayon
	pointB.y = Point1.y + rayon
	
	Arc(l_device, pointA.x, pointA.y, pointB.x, pointB.y, point2.x, point2.y,point3.x, point3.y)

	
	fetch cur_cercle into :num_cercle , :rayon ;
	
loop

close cur_cercle ;





end subroutine

