global uov_pbwc_ie uov_pbwc_ie

type variables
n_cst_pbwc_string inv_string
n_cst_pbwc_config inv_config
end variables

event documentcomplete(oleobject pdisp, any url);IF isvalid(pdisp) =FALSE THEN return
string ls_command
//disables context menu
//ls_command = "document.oncontextmenu = function() {    return false;}"
//this.object.document.ParentWindow.ExecScript(ls_command)


//triggers ue_filename event (if url is blank.htm, triggers "ue_blank" event)
// page display is made in another thread, after the navigate function
// you must wait the page to be displayed to continue the powerbuilder code
string ls_url,ls_event
ls_url = url
ls_event = gnv_config.of_get_filename(ls_url,TRUE)
this.triggerevent("ue_"+ls_event)
end event

event navigateerror(oleobject pdisp, any url, any frame, any statuscode, ref boolean ab_cancel);if url = "javascript:void(0);" THEN return
end event

event externalexception;action = ExceptionIgnore! 
end event

on uov_pbwc_ie.create
end on

on uov_pbwc_ie.destroy
end on


