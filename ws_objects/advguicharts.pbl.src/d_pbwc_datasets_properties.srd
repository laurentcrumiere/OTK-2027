text(band=detail alignment="0" text="Borderdash" border="0" color="33554432" x="14" y="1340" height="52" width="1202" html.valueishtml="0"  name=borderdash_t visible="1"  font.face="Tahoma" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="31903971" tooltip.delay.initial="1500" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="1" tooltip.isbubble="1" tooltip.maxwidth="1" tooltip.textcolor="134217751" tooltip.tip="Length and spacing of dashes. 
An Array of numbers which specify distances to alternately draw a line and a gap (in coordinate space units). If the number of elements in the array is odd, the elements of the array get copied and concatenated. For example, [5, 15, 25] will become [5, 15, 25, 5, 15, 25]. If the array is empty, the line dash list is cleared and line strokes return to being solid." tooltip.title="borderdash" tooltip.transparency="1" transparency="0" )
text(band=detail alignment="0" text="Borderdashoffset" border="0" color="33554432" x="14" y="1472" height="52" width="1202" html.valueishtml="0"  name=borderdashoffset_t visible="1"  font.face="Tahoma" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="31903971" tooltip.delay.initial="1500" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="1" tooltip.isbubble="1" tooltip.maxwidth="1" tooltip.textcolor="134217751" tooltip.tip="Offset for line dashes" tooltip.title="borderdashoffset" tooltip.transparency="1" transparency="0" )
text(band=detail alignment="0" text="Bordercapstyle" border="0" color="33554432" x="14" y="1604" height="52" width="1202" html.valueishtml="0"  name=bordercapstyle_t visible="1"  font.face="Tahoma" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="31903971" tooltip.delay.initial="1500" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="1" tooltip.isbubble="1" tooltip.maxwidth="1" tooltip.textcolor="134217751" tooltip.tip="Cap style of the line
butt:
The ends of lines are squared off at the endpoints.
round:
The ends of lines are rounded.
square:
The ends of lines are squared off by adding a box with an equal width and half the height of the line's thickness." tooltip.title="bordercapstyle" tooltip.transparency="1" transparency="0" )
text(band=detail alignment="0" text="Borderjoinstyle" border="0" color="33554432" x="14" y="1736" height="52" width="1202" html.valueishtml="0"  name=borderjoinstyle_t visible="1"  font.face="Tahoma" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="31903971" tooltip.delay.initial="1500" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="1" tooltip.isbubble="1" tooltip.maxwidth="1" tooltip.textcolor="134217751" tooltip.tip="Line joint style
round:
Rounds off the corners of a shape by filling an additional sector of disc centered at the common endpoint of connected segments. The radius for these rounded corners is equal to the line width.
bevel:
Fills an additional triangular area between the common endpoint of connected segments, and the separate outside rectangular corners of each segment.
miter:
Connected segments are joined by extending their outside edges to connect at a single point, with the effect of filling an additional lozenge-shaped area. This setting is affected by the miterLimit property." tooltip.title="$" tooltip.transparency="1" transparency="0" )
text(band=detail alignment="0" text="Cubicinterpolationmode" border="0" color="33554432" x="14" y="1868" height="52" width="1202" html.valueishtml="0"  name=cubicinterpolationmode_t visible="1"  font.face="Tahoma" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="31903971" tooltip.delay.initial="1500" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="1" tooltip.isbubble="1" tooltip.maxwidth="1" tooltip.textcolor="134217751" tooltip.tip="Algorithm used to interpolate a smooth curve from the discrete data points.~tGroup=HTML	Order=0	Style=EditText	Label=Link Target	Help=911	Expression=true" tooltip.title="cubicinterpolationmode" tooltip.transparency="1" transparency="0" )
