as_code+='~r~n'
as_code+='function hsv2hwb(args) {~r~n'
as_code+='  return rgb2hwb(hsv2rgb(args))~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsv2cmyk(args) {~r~n'
as_code+='  return rgb2cmyk(hsv2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsv2keyword(args) {~r~n'
as_code+='  return rgb2keyword(hsv2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='// http://dev.w3.org/csswg/css-color/#hwb-to-rgb~r~n'
as_code+='function hwb2rgb(hwb) {~r~n'
as_code+='  var h = hwb[0] / 360,~r~n'
as_code+='      wh = hwb[1] / 100,~r~n'
as_code+='      bl = hwb[2] / 100,~r~n'
as_code+='      ratio = wh + bl,~r~n'
as_code+='      i, v, f, n;~r~n'
as_code+='~r~n'
as_code+='  // wh + bl cant be > 1~r~n'
as_code+='  if (ratio > 1) {~r~n'
as_code+='    wh /= ratio;~r~n'
as_code+='    bl /= ratio;~r~n'
as_code+='  }~r~n'
as_code+='~r~n'
as_code+='  i = Math.floor(6 * h);~r~n'
as_code+='  v = 1 - bl;~r~n'
as_code+='  f = 6 * h - i;~r~n'
as_code+='  if ((i & 0x01) != 0) {~r~n'
as_code+='    f = 1 - f;~r~n'
as_code+='  }~r~n'
as_code+='  n = wh + f * (v - wh);  // linear interpolation~r~n'
as_code+='~r~n'
as_code+='  switch (i) {~r~n'
as_code+='    default:~r~n'
as_code+='    case 6:~r~n'
as_code+='    case 0: r = v; g = n; b = wh; break;~r~n'
as_code+='    case 1: r = n; g = v; b = wh; break;~r~n'
as_code+='    case 2: r = wh; g = v; b = n; break;~r~n'
as_code+='    case 3: r = wh; g = n; b = v; break;~r~n'
as_code+='    case 4: r = n; g = wh; b = v; break;~r~n'
as_code+='    case 5: r = v; g = wh; b = n; break;~r~n'
as_code+='  }~r~n'
as_code+='~r~n'
as_code+='  return [r * 255, g * 255, b * 255];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hwb2hsl(args) {~r~n'
as_code+='  return rgb2hsl(hwb2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hwb2hsv(args) {~r~n'
as_code+='  return rgb2hsv(hwb2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hwb2cmyk(args) {~r~n'
as_code+='  return rgb2cmyk(hwb2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hwb2keyword(args) {~r~n'
as_code+='  return rgb2keyword(hwb2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2rgb(cmyk) {~r~n'
as_code+='  var c = cmyk[0] / 100,~r~n'
as_code+='      m = cmyk[1] / 100,~r~n'
as_code+='      y = cmyk[2] / 100,~r~n'
as_code+='      k = cmyk[3] / 100,~r~n'
as_code+='      r, g, b;~r~n'
as_code+='~r~n'
as_code+='  r = 1 - Math.min(1, c * (1 - k) + k);~r~n'
as_code+='  g = 1 - Math.min(1, m * (1 - k) + k);~r~n'
as_code+='  b = 1 - Math.min(1, y * (1 - k) + k);~r~n'
as_code+='  return [r * 255, g * 255, b * 255];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2hsl(args) {~r~n'
as_code+='  return rgb2hsl(cmyk2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2hsv(args) {~r~n'
as_code+='  return rgb2hsv(cmyk2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2hwb(args) {~r~n'
as_code+='  return rgb2hwb(cmyk2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2keyword(args) {~r~n'
as_code+='  return rgb2keyword(cmyk2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='~r~n'
as_code+='function xyz2rgb(xyz) {~r~n'
as_code+='  var x = xyz[0] / 100,~r~n'
as_code+='      y = xyz[1] / 100,~r~n'
as_code+='      z = xyz[2] / 100,~r~n'
as_code+='      r, g, b;~r~n'
as_code+='~r~n'
as_code+='  r = (x * 3.2406) + (y * -1.5372) + (z * -0.4986);~r~n'
as_code+='  g = (x * -0.9689) + (y * 1.8758) + (z * 0.0415);~r~n'
as_code+='  b = (x * 0.0557) + (y * -0.2040) + (z * 1.0570);~r~n'
as_code+='~r~n'
as_code+='  // assume sRGB~r~n'
as_code+='  r = r > 0.0031308 ? ((1.055 * Math.pow(r, 1.0 / 2.4)) - 0.055)~r~n'
as_code+='    : r = (r * 12.92);~r~n'
as_code+='~r~n'
as_code+='  g = g > 0.0031308 ? ((1.055 * Math.pow(g, 1.0 / 2.4)) - 0.055)~r~n'
as_code+='    : g = (g * 12.92);~r~n'
as_code+='~r~n'
as_code+='  b = b > 0.0031308 ? ((1.055 * Math.pow(b, 1.0 / 2.4)) - 0.055)~r~n'
as_code+='    : b = (b * 12.92);~r~n'
as_code+='~r~n'
as_code+='  r = Math.min(Math.max(0, r), 1);~r~n'
as_code+='  g = Math.min(Math.max(0, g), 1);~r~n'
as_code+='  b = Math.min(Math.max(0, b), 1);~r~n'
as_code+='~r~n'
as_code+='  return [r * 255, g * 255, b * 255];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function xyz2lab(xyz) {~r~n'
as_code+='  var x = xyz[0],~r~n'
as_code+='      y = xyz[1],~r~n'
as_code+='      z = xyz[2],~r~n'
as_code+='      l, a, b;~r~n'
as_code+='~r~n'
as_code+='  x /= 95.047;~r~n'
as_code+='  y /= 100;~r~n'
as_code+='  z /= 108.883;~r~n'
as_code+='~r~n'
as_code+='  x = x > 0.008856 ? Math.pow(x, 1/3) : (7.787 * x) + (16 / 116);~r~n'
as_code+='  y = y > 0.008856 ? Math.pow(y, 1/3) : (7.787 * y) + (16 / 116);~r~n'
as_code+='  z = z > 0.008856 ? Math.pow(z, 1/3) : (7.787 * z) + (16 / 116);~r~n'
as_code+='~r~n'
as_code+='  l = (116 * y) - 16;~r~n'
as_code+='  a = 500 * (x - y);~r~n'
as_code+='  b = 200 * (y - z);~r~n'
as_code+='~r~n'
as_code+='  return [l, a, b];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function xyz2lch(args) {~r~n'
as_code+='  return lab2lch(xyz2lab(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lab2xyz(lab) {~r~n'
as_code+='  var l = lab[0],~r~n'
as_code+='      a = lab[1],~r~n'
as_code+='      b = lab[2],~r~n'
as_code+='      x, y, z, y2;~r~n'
as_code+='~r~n'
as_code+='  if (l <= 8) {~r~n'
as_code+='    y = (l * 100) / 903.3;~r~n'
as_code+='    y2 = (7.787 * (y / 100)) + (16 / 116);~r~n'
as_code+='  } else {~r~n'
as_code+='    y = 100 * Math.pow((l + 16) / 116, 3);~r~n'
as_code+='    y2 = Math.pow(y / 100, 1/3);~r~n'
as_code+='  }~r~n'
as_code+='~r~n'
as_code+='  x = x / 95.047 <= 0.008856 ? x = (95.047 * ((a / 500) + y2 - (16 / 116))) / 7.787 : 95.047 * Math.pow((a / 500) + y2, 3);~r~n'
as_code+='~r~n'
as_code+='  z = z / 108.883 <= 0.008859 ? z = (108.883 * (y2 - (b / 200) - (16 / 116))) / 7.787 : 108.883 * Math.pow(y2 - (b / 200), 3);~r~n'
as_code+='~r~n'
as_code+='  return [x, y, z];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lab2lch(lab) {~r~n'
as_code+='  var l = lab[0],~r~n'
as_code+='      a = lab[1],~r~n'
as_code+='      b = lab[2],~r~n'
as_code+='      hr, h, c;~r~n'
as_code+='~r~n'
as_code+='  hr = Math.atan2(b, a);~r~n'
as_code+='  h = hr * 360 / 2 / Math.PI;~r~n'
as_code+='  if (h < 0) {~r~n'
as_code+='    h += 360;~r~n'
as_code+='  }~r~n'
as_code+='  c = Math.sqrt(a * a + b * b);~r~n'
as_code+='  return [l, c, h];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lab2rgb(args) {~r~n'
as_code+='  return xyz2rgb(lab2xyz(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lch2lab(lch) {~r~n'
as_code+='  var l = lch[0],~r~n'
as_code+='      c = lch[1],~r~n'
as_code+='      h = lch[2],~r~n'
as_code+='      a, b, hr;~r~n'
as_code+='~r~n'
as_code+='  hr = h / 360 * 2 * Math.PI;~r~n'
as_code+='  a = c * Math.cos(hr);~r~n'
as_code+='  b = c * Math.sin(hr);~r~n'
as_code+='  return [l, a, b];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lch2xyz(args) {~r~n'
as_code+='  return lab2xyz(lch2lab(args));~r~n'
as_code+='}~r~n'
