as_code+='        }~r~n'
as_code+='        // test the regex~r~n'
as_code+='        if (strict && format === ~'MMMM~' && this._longMonthsParse[i].test(monthName)) {~r~n'
as_code+='            return i;~r~n'
as_code+='        } else if (strict && format === ~'MMM~' && this._shortMonthsParse[i].test(monthName)) {~r~n'
as_code+='            return i;~r~n'
as_code+='        } else if (!strict && this._monthsParse[i].test(monthName)) {~r~n'
