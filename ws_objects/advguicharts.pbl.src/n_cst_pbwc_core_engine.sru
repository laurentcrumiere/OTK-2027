as_code+='      b = 1 - 1/255 * Math.max(r, Math.max(g, b));~r~n'
as_code+='~r~n'
as_code+='  return [h, w * 100, b * 100];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function rgb2cmyk(rgb) {~r~n'
as_code+='  var r = rgb[0] / 255,~r~n'
as_code+='      g = rgb[1] / 255,~r~n'
as_code+='      b = rgb[2] / 255,~r~n'
as_code+='      c, m, y, k;~r~n'
as_code+='~r~n'
as_code+='  k = Math.min(1 - r, 1 - g, 1 - b);~r~n'
as_code+='  c = (1 - r - k) / (1 - k) || 0;~r~n'
as_code+='  m = (1 - g - k) / (1 - k) || 0;~r~n'
as_code+='  y = (1 - b - k) / (1 - k) || 0;~r~n'
as_code+='  return [c * 100, m * 100, y * 100, k * 100];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function rgb2keyword(rgb) {~r~n'
as_code+='  return reverseKeywords[JSON.stringify(rgb)];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function rgb2xyz(rgb) {~r~n'
as_code+='  var r = rgb[0] / 255,~r~n'
as_code+='      g = rgb[1] / 255,~r~n'
as_code+='      b = rgb[2] / 255;~r~n'
as_code+='~r~n'
as_code+='  // assume sRGB~r~n'
as_code+='  r = r > 0.04045 ? Math.pow(((r + 0.055) / 1.055), 2.4) : (r / 12.92);~r~n'
as_code+='  g = g > 0.04045 ? Math.pow(((g + 0.055) / 1.055), 2.4) : (g / 12.92);~r~n'
as_code+='  b = b > 0.04045 ? Math.pow(((b + 0.055) / 1.055), 2.4) : (b / 12.92);~r~n'
as_code+='~r~n'
as_code+='  var x = (r * 0.4124) + (g * 0.3576) + (b * 0.1805);~r~n'
as_code+='  var y = (r * 0.2126) + (g * 0.7152) + (b * 0.0722);~r~n'
as_code+='  var z = (r * 0.0193) + (g * 0.1192) + (b * 0.9505);~r~n'
as_code+='~r~n'
as_code+='  return [x * 100, y *100, z * 100];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function rgb2lab(rgb) {~r~n'
as_code+='  var xyz = rgb2xyz(rgb),~r~n'
as_code+='        x = xyz[0],~r~n'
as_code+='        y = xyz[1],~r~n'
as_code+='        z = xyz[2],~r~n'
as_code+='        l, a, b;~r~n'
as_code+='~r~n'
as_code+='  x /= 95.047;~r~n'
as_code+='  y /= 100;~r~n'
as_code+='  z /= 108.883;~r~n'
as_code+='~r~n'
as_code+='  x = x > 0.008856 ? Math.pow(x, 1/3) : (7.787 * x) + (16 / 116);~r~n'
as_code+='  y = y > 0.008856 ? Math.pow(y, 1/3) : (7.787 * y) + (16 / 116);~r~n'
as_code+='  z = z > 0.008856 ? Math.pow(z, 1/3) : (7.787 * z) + (16 / 116);~r~n'
as_code+='~r~n'
as_code+='  l = (116 * y) - 16;~r~n'
as_code+='  a = 500 * (x - y);~r~n'
as_code+='  b = 200 * (y - z);~r~n'
as_code+='~r~n'
as_code+='  return [l, a, b];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function rgb2lch(args) {~r~n'
as_code+='  return lab2lch(rgb2lab(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsl2rgb(hsl) {~r~n'
as_code+='  var h = hsl[0] / 360,~r~n'
as_code+='      s = hsl[1] / 100,~r~n'
as_code+='      l = hsl[2] / 100,~r~n'
as_code+='      t1, t2, t3, rgb, val;~r~n'
as_code+='~r~n'
as_code+='  if (s == 0) {~r~n'
as_code+='    val = l * 255;~r~n'
as_code+='    return [val, val, val];~r~n'
as_code+='  }~r~n'
as_code+='~r~n'
as_code+='  if (l < 0.5)~r~n'
as_code+='    t2 = l * (1 + s);~r~n'
as_code+='  else~r~n'
as_code+='    t2 = l + s - l * s;~r~n'
as_code+='  t1 = 2 * l - t2;~r~n'
as_code+='~r~n'
as_code+='  rgb = [0, 0, 0];~r~n'
as_code+='  for (var i = 0; i < 3; i++) {~r~n'
as_code+='    t3 = h + 1 / 3 * - (i - 1);~r~n'
as_code+='    t3 < 0 && t3++;~r~n'
as_code+='    t3 > 1 && t3--;~r~n'
as_code+='~r~n'
as_code+='    if (6 * t3 < 1)~r~n'
as_code+='      val = t1 + (t2 - t1) * 6 * t3;~r~n'
as_code+='    else if (2 * t3 < 1)~r~n'
as_code+='      val = t2;~r~n'
as_code+='    else if (3 * t3 < 2)~r~n'
as_code+='      val = t1 + (t2 - t1) * (2 / 3 - t3) * 6;~r~n'
as_code+='    else~r~n'
as_code+='      val = t1;~r~n'
as_code+='~r~n'
as_code+='    rgb[i] = val * 255;~r~n'
as_code+='  }~r~n'
as_code+='~r~n'
as_code+='  return rgb;~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsl2hsv(hsl) {~r~n'
as_code+='  var h = hsl[0],~r~n'
as_code+='      s = hsl[1] / 100,~r~n'
as_code+='      l = hsl[2] / 100,~r~n'
as_code+='      sv, v;~r~n'
as_code+='~r~n'
as_code+='  if(l === 0) {~r~n'
as_code+='      // no need to do calc on black~r~n'
as_code+='      // also avoids divide by 0 error~r~n'
as_code+='      return [0, 0, 0];~r~n'
as_code+='  }~r~n'
as_code+='~r~n'
as_code+='  l *= 2;~r~n'
as_code+='  s *= (l <= 1) ? l : 2 - l;~r~n'
as_code+='  v = (l + s) / 2;~r~n'
as_code+='  sv = (2 * s) / (l + s);~r~n'
as_code+='  return [h, sv * 100, v * 100];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsl2hwb(args) {~r~n'
as_code+='  return rgb2hwb(hsl2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsl2cmyk(args) {~r~n'
as_code+='  return rgb2cmyk(hsl2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsl2keyword(args) {~r~n'
as_code+='  return rgb2keyword(hsl2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='~r~n'
as_code+='function hsv2rgb(hsv) {~r~n'
as_code+='  var h = hsv[0] / 60,~r~n'
as_code+='      s = hsv[1] / 100,~r~n'
as_code+='      v = hsv[2] / 100,~r~n'
as_code+='      hi = Math.floor(h) % 6;~r~n'
as_code+='~r~n'
as_code+='  var f = h - Math.floor(h),~r~n'
as_code+='      p = 255 * v * (1 - s),~r~n'
as_code+='      q = 255 * v * (1 - (s * f)),~r~n'
as_code+='      t = 255 * v * (1 - (s * (1 - f))),~r~n'
as_code+='      v = 255 * v;~r~n'
end subroutine

public subroutine of_chart_2 (ref string as_code);
as_code+='~r~n'
as_code+='  switch(hi) {~r~n'
as_code+='    case 0:~r~n'
as_code+='      return [v, t, p];~r~n'
as_code+='    case 1:~r~n'
as_code+='      return [q, v, p];~r~n'
as_code+='    case 2:~r~n'
as_code+='      return [p, v, t];~r~n'
as_code+='    case 3:~r~n'
as_code+='      return [p, q, v];~r~n'
as_code+='    case 4:~r~n'
as_code+='      return [t, p, v];~r~n'
as_code+='    case 5:~r~n'
as_code+='      return [v, p, q];~r~n'
as_code+='  }~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsv2hsl(hsv) {~r~n'
as_code+='  var h = hsv[0],~r~n'
as_code+='      s = hsv[1] / 100,~r~n'
as_code+='      v = hsv[2] / 100,~r~n'
as_code+='      sl, l;~r~n'
as_code+='~r~n'
as_code+='  l = (2 - s) * v;~r~n'
as_code+='  sl = s * v;~r~n'
as_code+='  sl /= (l <= 1) ? l : 2 - l;~r~n'
as_code+='  sl = sl || 0;~r~n'
as_code+='  l /= 2;~r~n'
as_code+='  return [h, sl * 100, l * 100];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsv2hwb(args) {~r~n'
as_code+='  return rgb2hwb(hsv2rgb(args))~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsv2cmyk(args) {~r~n'
as_code+='  return rgb2cmyk(hsv2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hsv2keyword(args) {~r~n'
as_code+='  return rgb2keyword(hsv2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='// http://dev.w3.org/csswg/css-color/#hwb-to-rgb~r~n'
as_code+='function hwb2rgb(hwb) {~r~n'
as_code+='  var h = hwb[0] / 360,~r~n'
as_code+='      wh = hwb[1] / 100,~r~n'
as_code+='      bl = hwb[2] / 100,~r~n'
as_code+='      ratio = wh + bl,~r~n'
as_code+='      i, v, f, n;~r~n'
as_code+='~r~n'
as_code+='  // wh + bl cant be > 1~r~n'
as_code+='  if (ratio > 1) {~r~n'
as_code+='    wh /= ratio;~r~n'
as_code+='    bl /= ratio;~r~n'
as_code+='  }~r~n'
as_code+='~r~n'
as_code+='  i = Math.floor(6 * h);~r~n'
as_code+='  v = 1 - bl;~r~n'
as_code+='  f = 6 * h - i;~r~n'
as_code+='  if ((i & 0x01) != 0) {~r~n'
as_code+='    f = 1 - f;~r~n'
as_code+='  }~r~n'
as_code+='  n = wh + f * (v - wh);  // linear interpolation~r~n'
as_code+='~r~n'
as_code+='  switch (i) {~r~n'
as_code+='    default:~r~n'
as_code+='    case 6:~r~n'
as_code+='    case 0: r = v; g = n; b = wh; break;~r~n'
as_code+='    case 1: r = n; g = v; b = wh; break;~r~n'
as_code+='    case 2: r = wh; g = v; b = n; break;~r~n'
as_code+='    case 3: r = wh; g = n; b = v; break;~r~n'
as_code+='    case 4: r = n; g = wh; b = v; break;~r~n'
as_code+='    case 5: r = v; g = wh; b = n; break;~r~n'
as_code+='  }~r~n'
as_code+='~r~n'
as_code+='  return [r * 255, g * 255, b * 255];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hwb2hsl(args) {~r~n'
as_code+='  return rgb2hsl(hwb2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hwb2hsv(args) {~r~n'
as_code+='  return rgb2hsv(hwb2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hwb2cmyk(args) {~r~n'
as_code+='  return rgb2cmyk(hwb2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function hwb2keyword(args) {~r~n'
as_code+='  return rgb2keyword(hwb2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2rgb(cmyk) {~r~n'
as_code+='  var c = cmyk[0] / 100,~r~n'
as_code+='      m = cmyk[1] / 100,~r~n'
as_code+='      y = cmyk[2] / 100,~r~n'
as_code+='      k = cmyk[3] / 100,~r~n'
as_code+='      r, g, b;~r~n'
as_code+='~r~n'
as_code+='  r = 1 - Math.min(1, c * (1 - k) + k);~r~n'
as_code+='  g = 1 - Math.min(1, m * (1 - k) + k);~r~n'
as_code+='  b = 1 - Math.min(1, y * (1 - k) + k);~r~n'
as_code+='  return [r * 255, g * 255, b * 255];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2hsl(args) {~r~n'
as_code+='  return rgb2hsl(cmyk2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2hsv(args) {~r~n'
as_code+='  return rgb2hsv(cmyk2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2hwb(args) {~r~n'
as_code+='  return rgb2hwb(cmyk2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function cmyk2keyword(args) {~r~n'
as_code+='  return rgb2keyword(cmyk2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='~r~n'
as_code+='function xyz2rgb(xyz) {~r~n'
as_code+='  var x = xyz[0] / 100,~r~n'
as_code+='      y = xyz[1] / 100,~r~n'
as_code+='      z = xyz[2] / 100,~r~n'
as_code+='      r, g, b;~r~n'
as_code+='~r~n'
as_code+='  r = (x * 3.2406) + (y * -1.5372) + (z * -0.4986);~r~n'
as_code+='  g = (x * -0.9689) + (y * 1.8758) + (z * 0.0415);~r~n'
as_code+='  b = (x * 0.0557) + (y * -0.2040) + (z * 1.0570);~r~n'
as_code+='~r~n'
as_code+='  // assume sRGB~r~n'
as_code+='  r = r > 0.0031308 ? ((1.055 * Math.pow(r, 1.0 / 2.4)) - 0.055)~r~n'
as_code+='    : r = (r * 12.92);~r~n'
as_code+='~r~n'
as_code+='  g = g > 0.0031308 ? ((1.055 * Math.pow(g, 1.0 / 2.4)) - 0.055)~r~n'
as_code+='    : g = (g * 12.92);~r~n'
as_code+='~r~n'
as_code+='  b = b > 0.0031308 ? ((1.055 * Math.pow(b, 1.0 / 2.4)) - 0.055)~r~n'
as_code+='    : b = (b * 12.92);~r~n'
as_code+='~r~n'
as_code+='  r = Math.min(Math.max(0, r), 1);~r~n'
as_code+='  g = Math.min(Math.max(0, g), 1);~r~n'
as_code+='  b = Math.min(Math.max(0, b), 1);~r~n'
as_code+='~r~n'
as_code+='  return [r * 255, g * 255, b * 255];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function xyz2lab(xyz) {~r~n'
as_code+='  var x = xyz[0],~r~n'
as_code+='      y = xyz[1],~r~n'
as_code+='      z = xyz[2],~r~n'
as_code+='      l, a, b;~r~n'
as_code+='~r~n'
as_code+='  x /= 95.047;~r~n'
as_code+='  y /= 100;~r~n'
as_code+='  z /= 108.883;~r~n'
as_code+='~r~n'
as_code+='  x = x > 0.008856 ? Math.pow(x, 1/3) : (7.787 * x) + (16 / 116);~r~n'
as_code+='  y = y > 0.008856 ? Math.pow(y, 1/3) : (7.787 * y) + (16 / 116);~r~n'
as_code+='  z = z > 0.008856 ? Math.pow(z, 1/3) : (7.787 * z) + (16 / 116);~r~n'
as_code+='~r~n'
as_code+='  l = (116 * y) - 16;~r~n'
as_code+='  a = 500 * (x - y);~r~n'
as_code+='  b = 200 * (y - z);~r~n'
as_code+='~r~n'
as_code+='  return [l, a, b];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function xyz2lch(args) {~r~n'
as_code+='  return lab2lch(xyz2lab(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lab2xyz(lab) {~r~n'
as_code+='  var l = lab[0],~r~n'
as_code+='      a = lab[1],~r~n'
as_code+='      b = lab[2],~r~n'
as_code+='      x, y, z, y2;~r~n'
as_code+='~r~n'
as_code+='  if (l <= 8) {~r~n'
as_code+='    y = (l * 100) / 903.3;~r~n'
as_code+='    y2 = (7.787 * (y / 100)) + (16 / 116);~r~n'
as_code+='  } else {~r~n'
as_code+='    y = 100 * Math.pow((l + 16) / 116, 3);~r~n'
as_code+='    y2 = Math.pow(y / 100, 1/3);~r~n'
as_code+='  }~r~n'
as_code+='~r~n'
as_code+='  x = x / 95.047 <= 0.008856 ? x = (95.047 * ((a / 500) + y2 - (16 / 116))) / 7.787 : 95.047 * Math.pow((a / 500) + y2, 3);~r~n'
as_code+='~r~n'
as_code+='  z = z / 108.883 <= 0.008859 ? z = (108.883 * (y2 - (b / 200) - (16 / 116))) / 7.787 : 108.883 * Math.pow(y2 - (b / 200), 3);~r~n'
as_code+='~r~n'
as_code+='  return [x, y, z];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lab2lch(lab) {~r~n'
as_code+='  var l = lab[0],~r~n'
as_code+='      a = lab[1],~r~n'
as_code+='      b = lab[2],~r~n'
as_code+='      hr, h, c;~r~n'
as_code+='~r~n'
as_code+='  hr = Math.atan2(b, a);~r~n'
as_code+='  h = hr * 360 / 2 / Math.PI;~r~n'
as_code+='  if (h < 0) {~r~n'
as_code+='    h += 360;~r~n'
as_code+='  }~r~n'
as_code+='  c = Math.sqrt(a * a + b * b);~r~n'
as_code+='  return [l, c, h];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lab2rgb(args) {~r~n'
as_code+='  return xyz2rgb(lab2xyz(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lch2lab(lch) {~r~n'
as_code+='  var l = lch[0],~r~n'
as_code+='      c = lch[1],~r~n'
as_code+='      h = lch[2],~r~n'
as_code+='      a, b, hr;~r~n'
as_code+='~r~n'
as_code+='  hr = h / 360 * 2 * Math.PI;~r~n'
as_code+='  a = c * Math.cos(hr);~r~n'
as_code+='  b = c * Math.sin(hr);~r~n'
as_code+='  return [l, a, b];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lch2xyz(args) {~r~n'
as_code+='  return lab2xyz(lch2lab(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function lch2rgb(args) {~r~n'
as_code+='  return lab2rgb(lch2lab(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function keyword2rgb(keyword) {~r~n'
as_code+='  return cssKeywords[keyword];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function keyword2hsl(args) {~r~n'
as_code+='  return rgb2hsl(keyword2rgb(args));~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function keyword2hsv(args) {~r~n'
as_code+='  return rgb2hsv(keyword2rgb(args));~r~n'
