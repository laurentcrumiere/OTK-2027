as_code+='~t~t~t~t}~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Don~'t bother fitting the ticks if we are not showing them~r~n'
as_code+='~t~t~tif (tickOpts.display && display) {~r~n'
as_code+='~t~t~t~tvar largestTextWidth = helpers.longestText(me.ctx, tickFont.font, labels, me.longestTextCache);~r~n'
as_code+='~t~t~t~tvar tallestLabelHeightInLines = helpers.numberOfLabelLines(labels);~r~n'
as_code+='~t~t~t~tvar lineSpace = tickFont.size * 0.5;~r~n'
as_code+='~t~t~t~tvar tickPadding = me.options.ticks.padding;~r~n'
as_code+='~r~n'
as_code+='~t~t~t~tif (isHorizontal) {~r~n'
as_code+='~t~t~t~t~t// A horizontal axis is more constrained by the height.~r~n'
as_code+='~t~t~t~t~tme.longestLabelWidth = largestTextWidth;~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~tvar angleRadians = helpers.toRadians(me.labelRotation);~r~n'
as_code+='~t~t~t~t~tvar cosRotation = Math.cos(angleRadians);~r~n'
as_code+='~t~t~t~t~tvar sinRotation = Math.sin(angleRadians);~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~t// TODO - improve this calculation~r~n'
as_code+='~t~t~t~t~tvar labelHeight = (sinRotation * largestTextWidth)~r~n'
as_code+='~t~t~t~t~t~t+ (tickFont.size * tallestLabelHeightInLines)~r~n'
as_code+='~t~t~t~t~t~t+ (lineSpace * (tallestLabelHeightInLines - 1))~r~n'
as_code+='~t~t~t~t~t~t+ lineSpace; // padding~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~tminSize.height = Math.min(me.maxHeight, minSize.height + labelHeight + tickPadding);~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~tme.ctx.font = tickFont.font;~r~n'
as_code+='~t~t~t~t~tvar firstLabelWidth = computeTextSize(me.ctx, labels[0], tickFont.font);~r~n'
as_code+='~t~t~t~t~tvar lastLabelWidth = computeTextSize(me.ctx, labels[labels.length - 1], tickFont.font);~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~t// Ensure that our ticks are always inside the canvas. When rotated, ticks are right aligned~r~n'
as_code+='~t~t~t~t~t// which means that the right padding is dominated by the font height~r~n'
as_code+='~t~t~t~t~tif (me.labelRotation !== 0) {~r~n'
as_code+='~t~t~t~t~t~tme.paddingLeft = opts.position === ~'bottom~' ? (cosRotation * firstLabelWidth) + 3 : (cosRotation * lineSpace) + 3; // add 3 px to move away from canvas edges~r~n'
as_code+='~t~t~t~t~t~tme.paddingRight = opts.position === ~'bottom~' ? (cosRotation * lineSpace) + 3 : (cosRotation * lastLabelWidth) + 3;~r~n'
as_code+='~t~t~t~t~t} else {~r~n'
as_code+='~t~t~t~t~t~tme.paddingLeft = firstLabelWidth / 2 + 3; // add 3 px to move away from canvas edges~r~n'
as_code+='~t~t~t~t~t~tme.paddingRight = lastLabelWidth / 2 + 3;~r~n'
as_code+='~t~t~t~t~t}~r~n'
as_code+='~t~t~t~t} else {~r~n'
as_code+='~t~t~t~t~t// A vertical axis is more constrained by the width. Labels are the~r~n'
as_code+='~t~t~t~t~t// dominant factor here, so get that length first and account for padding~r~n'
as_code+='~t~t~t~t~tif (tickOpts.mirror) {~r~n'
as_code+='~t~t~t~t~t~tlargestTextWidth = 0;~r~n'
as_code+='~t~t~t~t~t} else {~r~n'
as_code+='~t~t~t~t~t~t// use lineSpace for consistency with horizontal axis~r~n'
as_code+='~t~t~t~t~t~t// tickPadding is not implemented for horizontal~r~n'
as_code+='~t~t~t~t~t~tlargestTextWidth += tickPadding + lineSpace;~r~n'
as_code+='~t~t~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~tminSize.width = Math.min(me.maxWidth, minSize.width + largestTextWidth);~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~tme.paddingTop = tickFont.size / 2;~r~n'
as_code+='~t~t~t~t~tme.paddingBottom = tickFont.size / 2;~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~tme.handleMargins();~r~n'
as_code+='~r~n'
as_code+='~t~t~tme.width = minSize.width;~r~n'
as_code+='~t~t~tme.height = minSize.height;~r~n'
as_code+='~t~t},~r~n'
as_code+='~r~n'
as_code+='~t~t/**~r~n'
as_code+='~t~t * Handle margins and padding interactions~r~n'
as_code+='~t~t * @private~r~n'
as_code+='~t~t */~r~n'
as_code+='~t~thandleMargins: function() {~r~n'
as_code+='~t~t~tvar me = this;~r~n'
as_code+='~t~t~tif (me.margins) {~r~n'
as_code+='~t~t~t~tme.paddingLeft = Math.max(me.paddingLeft - me.margins.left, 0);~r~n'
as_code+='~t~t~t~tme.paddingTop = Math.max(me.paddingTop - me.margins.top, 0);~r~n'
as_code+='~t~t~t~tme.paddingRight = Math.max(me.paddingRight - me.margins.right, 0);~r~n'
as_code+='~t~t~t~tme.paddingBottom = Math.max(me.paddingBottom - me.margins.bottom, 0);~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~t~t},~r~n'
as_code+='~r~n'
as_code+='~t~tafterFit: function() {~r~n'
as_code+='~t~t~thelpers.callback(this.options.afterFit, [this]);~r~n'
as_code+='~t~t},~r~n'
as_code+='~r~n'
as_code+='~t~t// Shared Methods~r~n'
as_code+='~t~tisHorizontal: function() {~r~n'
as_code+='~t~t~treturn this.options.position === ~'top~' || this.options.position === ~'bottom~';~r~n'
as_code+='~t~t},~r~n'
as_code+='~t~tisFullWidth: function() {~r~n'
as_code+='~t~t~treturn (this.options.fullWidth);~r~n'
as_code+='~t~t},~r~n'
as_code+='~r~n'
as_code+='~t~t// Get the correct value. NaN bad inputs, If the value type is object get the x or y based on whether we are horizontal or not~r~n'
as_code+='~t~tgetRightValue: function(rawValue) {~r~n'
as_code+='~t~t~t// Null and undefined values first~r~n'
as_code+='~t~t~tif (helpers.isNullOrUndef(rawValue)) {~r~n'
as_code+='~t~t~t~treturn NaN;~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~t~t~t// isNaN(object) returns true, so make sure NaN is checking for a number; Discard Infinite values~r~n'
as_code+='~t~t~tif (typeof rawValue === ~'number~' && !isFinite(rawValue)) {~r~n'
as_code+='~t~t~t~treturn NaN;~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~t~t~t// If it is in fact an object, dive in one more level~r~n'
as_code+='~t~t~tif (rawValue) {~r~n'
as_code+='~t~t~t~tif (this.isHorizontal()) {~r~n'
as_code+='~t~t~t~t~tif (rawValue.x !== undefined) {~r~n'
as_code+='~t~t~t~t~t~treturn this.getRightValue(rawValue.x);~r~n'
as_code+='~t~t~t~t~t}~r~n'
as_code+='~t~t~t~t} else if (rawValue.y !== undefined) {~r~n'
as_code+='~t~t~t~t~treturn this.getRightValue(rawValue.y);~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Value is good, return it~r~n'
as_code+='~t~t~treturn rawValue;~r~n'
as_code+='~t~t},~r~n'
as_code+='~r~n'
as_code+='~t~t// Used to get the value to display in the tooltip for the data at the given index~r~n'
as_code+='~t~t// function getLabelForIndex(index, datasetIndex)~r~n'
as_code+='~t~tgetLabelForIndex: helpers.noop,~r~n'
as_code+='~r~n'
as_code+='~t~t// Used to get data value locations.  Value can either be an index or a numerical value~r~n'
as_code+='~t~tgetPixelForValue: helpers.noop,~r~n'
as_code+='~r~n'
as_code+='~t~t// Used to get the data value from a given pixel. This is the inverse of getPixelForValue~r~n'
as_code+='~t~tgetValueForPixel: helpers.noop,~r~n'
as_code+='~r~n'
as_code+='~t~t// Used for tick location, should~r~n'
as_code+='~t~tgetPixelForTick: function(index) {~r~n'
as_code+='~t~t~tvar me = this;~r~n'
as_code+='~t~t~tvar offset = me.options.offset;~r~n'
as_code+='~t~t~tif (me.isHorizontal()) {~r~n'
as_code+='~t~t~t~tvar innerWidth = me.width - (me.paddingLeft + me.paddingRight);~r~n'
as_code+='~t~t~t~tvar tickWidth = innerWidth / Math.max((me._ticks.length - (offset ? 0 : 1)), 1);~r~n'
as_code+='~t~t~t~tvar pixel = (tickWidth * index) + me.paddingLeft;~r~n'
as_code+='~r~n'
as_code+='~t~t~t~tif (offset) {~r~n'
as_code+='~t~t~t~t~tpixel += tickWidth / 2;~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t~tvar finalVal = me.left + Math.round(pixel);~r~n'
