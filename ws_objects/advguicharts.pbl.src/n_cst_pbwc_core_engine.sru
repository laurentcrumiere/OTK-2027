as_code+='~t~t~t}~r~n'
as_code+='~t~t} else {~r~n'
as_code+='~t~t~tctx.fillText(text, position.x, position.y);~r~n'
as_code+='~t~t}~r~n'
as_code+='~t}~r~n'
as_code+='~r~n'
as_code+='~tfunction adjustPointPositionForLabelHeight(angle, textSize, position) {~r~n'
as_code+='~t~tif (angle === 90 || angle === 270) {~r~n'
as_code+='~t~t~tposition.y -= (textSize.h / 2);~r~n'
as_code+='~t~t} else if (angle > 270 || angle < 90) {~r~n'
as_code+='~t~t~tposition.y -= textSize.h;~r~n'
as_code+='~t~t}~r~n'
as_code+='~t}~r~n'
as_code+='~r~n'
as_code+='~tfunction drawPointLabels(scale) {~r~n'
as_code+='~t~tvar ctx = scale.ctx;~r~n'
as_code+='~t~tvar valueOrDefault = helpers.valueOrDefault;~r~n'
as_code+='~t~tvar opts = scale.options;~r~n'
