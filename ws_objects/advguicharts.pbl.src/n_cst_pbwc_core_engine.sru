as_code+='~r~n'
as_code+='    var shortPieces = [], longPieces = [], mixedPieces = [],~r~n'
as_code+='        i, mom;~r~n'
as_code+='    for (i = 0; i < 12; i++) {~r~n'
as_code+='        // make the regex if we don~'t have it already~r~n'
as_code+='        mom = createUTC([2000, i]);~r~n'
as_code+='        shortPieces.push(this.monthsShort(mom, ~'~'));~r~n'
