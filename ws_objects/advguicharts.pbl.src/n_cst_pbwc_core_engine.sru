as_code+='        }~r~n'
as_code+='        if (match[3]) {~r~n'
as_code+='            for (i = 0, l = isoTimes.length; i < l; i++) {~r~n'
as_code+='                if (isoTimes[i][1].exec(match[3])) {~r~n'
as_code+='                    // match[2] should be ~'T~' or space~r~n'
