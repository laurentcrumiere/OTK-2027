as_code+='            if (parsedInput) {~r~n'
as_code+='                getParsingFlags(config).empty = false;~r~n'
as_code+='            }~r~n'
as_code+='            else {~r~n'
as_code+='                getParsingFlags(config).unusedTokens.push(token);~r~n'
as_code+='            }~r~n'
as_code+='            addTimeToArrayFromToken(token, parsedInput, config);~r~n'
as_code+='        }~r~n'
as_code+='        else if (config._strict && !parsedInput) {~r~n'
as_code+='            getParsingFlags(config).unusedTokens.push(token);~r~n'
