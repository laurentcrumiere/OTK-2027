as_code+='~t~t~tb: 0~r~n'
as_code+='~t~t};~r~n'
as_code+='~t~tvar furthestAngles = {};~r~n'
as_code+='~t~tvar i, textSize, pointPosition;~r~n'
as_code+='~r~n'
as_code+='~t~tscale.ctx.font = plFont.font;~r~n'
as_code+='~t~tscale._pointLabelSizes = [];~r~n'
as_code+='~r~n'
as_code+='~t~tvar valueCount = getValueCount(scale);~r~n'
as_code+='~t~tfor (i = 0; i < valueCount; i++) {~r~n'
as_code+='~t~t~tpointPosition = scale.getPointPosition(i, largestPossibleRadius);~r~n'
as_code+='~t~t~ttextSize = measureLabelSize(scale.ctx, plFont.size, scale.pointLabels[i] || ~'~');~r~n'
as_code+='~t~t~tscale._pointLabelSizes[i] = textSize;~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Add quarter circle to make degree 0 mean top of circle~r~n'
as_code+='~t~t~tvar angleRadians = scale.getIndexAngle(i);~r~n'
as_code+='~t~t~tvar angle = helpers.toDegrees(angleRadians) % 360;~r~n'
as_code+='~t~t~tvar hLimits = determineLimits(angle, pointPosition.x, textSize.w, 0, 180);~r~n'
as_code+='~t~t~tvar vLimits = determineLimits(angle, pointPosition.y, textSize.h, 90, 270);~r~n'
as_code+='~r~n'
as_code+='~t~t~tif (hLimits.start < furthestLimits.l) {~r~n'
as_code+='~t~t~t~tfurthestLimits.l = hLimits.start;~r~n'
as_code+='~t~t~t~tfurthestAngles.l = angleRadians;~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~tif (hLimits.end > furthestLimits.r) {~r~n'
as_code+='~t~t~t~tfurthestLimits.r = hLimits.end;~r~n'
as_code+='~t~t~t~tfurthestAngles.r = angleRadians;~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~tif (vLimits.start < furthestLimits.t) {~r~n'
as_code+='~t~t~t~tfurthestLimits.t = vLimits.start;~r~n'
as_code+='~t~t~t~tfurthestAngles.t = angleRadians;~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~tif (vLimits.end > furthestLimits.b) {~r~n'
as_code+='~t~t~t~tfurthestLimits.b = vLimits.end;~r~n'
as_code+='~t~t~t~tfurthestAngles.b = angleRadians;~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~t~t}~r~n'
as_code+='~r~n'
