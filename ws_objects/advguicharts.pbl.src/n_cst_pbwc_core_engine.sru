as_code+='~r~n'
as_code+='    // add remaining unparsed input length to the string~r~n'
as_code+='    getParsingFlags(config).charsLeftOver = stringLength - totalParsedInputLength;~r~n'
as_code+='    if (string.length > 0) {~r~n'
as_code+='        getParsingFlags(config).unusedInput.push(string);~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    // clear _12h flag if hour is <= 12~r~n'
as_code+='    if (config._a[HOUR] <= 12 &&~r~n'
as_code+='        getParsingFlags(config).bigHour === true &&~r~n'
as_code+='        config._a[HOUR] > 0) {~r~n'
