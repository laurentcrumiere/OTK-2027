public function integer  of_gauge (string as_filename);is_source=''
of_gauge_1(is_source)
return of_write_file(as_filename)
end function

public function integer of_init (string as_exe_name, string as_web_browser);is_web_browser = as_web_browser
return this.of_init(as_exe_name)
	
end function

