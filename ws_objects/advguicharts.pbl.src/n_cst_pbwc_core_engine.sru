as_code+=');~r~n'
as_code+='~r~n'
as_code+='// Pick the first defined of two or three arguments.~r~n'
as_code+='function defaults(a, b, c) {~r~n'
as_code+='    if (a != null) {~r~n'
as_code+='        return a;~r~n'
as_code+='    }~r~n'
as_code+='    if (b != null) {~r~n'
as_code+='        return b;~r~n'
as_code+='    }~r~n'
as_code+='    return c;~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function currentDateArray(config) {~r~n'
as_code+='    // hooks is actually the exported moment object~r~n'
as_code+='    var nowValue = new Date(hooks.now());~r~n'
as_code+='    if (config._useUTC) {~r~n'
as_code+='        return [nowValue.getUTCFullYear(), nowValue.getUTCMonth(), nowValue.getUTCDate()];~r~n'
as_code+='    }~r~n'
as_code+='    return [nowValue.getFullYear(), nowValue.getMonth(), nowValue.getDate()];~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='// convert an array to a date.~r~n'
as_code+='// the array should mirror the parameters below~r~n'
as_code+='// note: all values past the year are optional and will default to the lowest possible value.~r~n'
as_code+='// [year, month, day , hour, minute, second, millisecond]~r~n'
as_code+='function configFromArray (config) {~r~n'
as_code+='    var i, date, input = [], currentDate, yearToUse;~r~n'
as_code+='~r~n'
as_code+='    if (config._d) {~r~n'
as_code+='        return;~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    currentDate = currentDateArray(config);~r~n'
as_code+='~r~n'
as_code+='    //compute day of the year from weeks and weekdays~r~n'
as_code+='    if (config._w && config._a[DATE] == null && config._a[MONTH] == null) {~r~n'
as_code+='        dayOfYearFromWeekInfo(config);~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    //if the day of the year is set, figure out what it is~r~n'
as_code+='    if (config._dayOfYear != null) {~r~n'
as_code+='        yearToUse = defaults(config._a[YEAR], currentDate[YEAR]);~r~n'
as_code+='~r~n'
as_code+='        if (config._dayOfYear > daysInYear(yearToUse) || config._dayOfYear === 0) {~r~n'
as_code+='            getParsingFlags(config)._overflowDayOfYear = true;~r~n'
as_code+='        }~r~n'
as_code+='~r~n'
as_code+='        date = createUTCDate(yearToUse, 0, config._dayOfYear);~r~n'
as_code+='        config._a[MONTH] = date.getUTCMonth();~r~n'
as_code+='        config._a[DATE] = date.getUTCDate();~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    // Default to current date.~r~n'
as_code+='    // * if no year, month, day of month are given, default to today~r~n'
as_code+='    // * if day of month is given, default month and year~r~n'
as_code+='    // * if month is given, default only year~r~n'
as_code+='    // * if year is given, don~'t default anything~r~n'
as_code+='    for (i = 0; i < 3 && config._a[i] == null; ++i) {~r~n'
as_code+='        config._a[i] = input[i] = currentDate[i];~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    // Zero out whatever was not defaulted, including time~r~n'
as_code+='    for (; i < 7; i++) {~r~n'
as_code+='        config._a[i] = input[i] = (config._a[i] == null) ? (i === 2 ? 1 : 0) : config._a[i];~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    // Check for 24:00:00.000~r~n'
as_code+='    if (config._a[HOUR] === 24 &&~r~n'
as_code+='            config._a[MINUTE] === 0 &&~r~n'
as_code+='            config._a[SECOND] === 0 &&~r~n'
as_code+='            config._a[MILLISECOND] === 0) {~r~n'
as_code+='        config._nextDay = true;~r~n'
as_code+='        config._a[HOUR] = 0;~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    config._d = (config._useUTC ? createUTCDate : createDate).apply(null, input);~r~n'
