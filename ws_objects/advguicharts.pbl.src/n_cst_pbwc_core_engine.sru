as_code+='~r~n'
as_code+='// start-of-first-week - start-of-year~r~n'
as_code+='function firstWeekOffset(year, dow, doy) {~r~n'
as_code+='    var // first-week day -- which january is always in the first week (4 for iso, 1 for other)~r~n'
