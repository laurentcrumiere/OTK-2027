as_code+='~r~n'
as_code+='~t~tctx.textBaseline = ~'top~';~r~n'
as_code+='~r~n'
as_code+='~t~tfor (var i = getValueCount(scale) - 1; i >= 0; i--) {~r~n'
as_code+='~t~t~tif (angleLineOpts.display) {~r~n'
