as_code+='    }~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='// MOMENTS~r~n'
as_code+='~r~n'
as_code+='function setMonth (mom, value) {~r~n'
as_code+='    var dayOfMonth;~r~n'
as_code+='~r~n'
as_code+='    if (!mom.isValid()) {~r~n'
as_code+='        // No op~r~n'
as_code+='        return mom;~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    if (typeof value === ~'string~') {~r~n'
