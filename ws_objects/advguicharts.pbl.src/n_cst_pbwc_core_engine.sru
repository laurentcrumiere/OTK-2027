as_code+='    // see sorting in computeMonthsParse~r~n'
as_code+='    for (i = 0; i < 12; i++) {~r~n'
as_code+='        // make the regex if we don~'t have it already~r~n'
as_code+='        mom = createUTC([2000, i]);~r~n'
as_code+='        if (strict && !this._longMonthsParse[i]) {~r~n'
as_code+='            this._longMonthsParse[i] = new RegExp(~'^~' + this.months(mom, ~'~').replace(~'.~', ~'~') + ~'$~', ~'i~');~r~n'
