as_code+='}~r~n'
as_code+='~r~n'
as_code+='// RFC 2822 regex: For details see https://tools.ietf.org/html/rfc2822#section-3.3~r~n'
as_code+='var basicRfcRegex = /^((?:Mon|Tue|Wed|Thu|Fri|Sat|Sun),?\s)?(\d?\d\s(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s(?:\d\d)?\d\d\s)(\d\d:\d\d)(\:\d\d)?(\s(?:UT|GMT|[ECMP][SD]T|[A-IK-Za-ik-z]|[+-]\d{4}))$/;~r~n'
as_code+='~r~n'
as_code+='// date and time from ref 2822 format~r~n'
as_code+='function configFromRFC2822(config) {~r~n'
as_code+='    var string, match, dayFormat,~r~n'
as_code+='        dateFormat, timeFormat, tzFormat;~r~n'
as_code+='    var timezones = {~r~n'
as_code+='        ~' GMT~': ~' +0000~',~r~n'
as_code+='        ~' EDT~': ~' -0400~',~r~n'
as_code+='        ~' EST~': ~' -0500~',~r~n'
as_code+='        ~' CDT~': ~' -0500~',~r~n'
as_code+='        ~' CST~': ~' -0600~',~r~n'
as_code+='        ~' MDT~': ~' -0600~',~r~n'
as_code+='        ~' MST~': ~' -0700~',~r~n'
as_code+='        ~' PDT~': ~' -0700~',~r~n'
as_code+='        ~' PST~': ~' -0800~'~r~n'
as_code+='    };~r~n'
as_code+='    var military = ~'YXWVUTSRQPONZABCDEFGHIKLM~';~r~n'
as_code+='    var timezone, timezoneIndex;~r~n'
as_code+='~r~n'
as_code+='    string = config._i~r~n'
as_code+='        .replace(/\([^\)]*\)|[\n\t]/g, ~' ~') // Remove comments and folding whitespace~r~n'
as_code+='        .replace(/(\s\s+)/g, ~' ~') // Replace multiple-spaces with a single space~r~n'
as_code+='        .replace(/^\s|\s$/g, ~'~'); // Remove leading and trailing spaces~r~n'
as_code+='    match = basicRfcRegex.exec(string);~r~n'
as_code+='~r~n'
as_code+='    if (match) {~r~n'
as_code+='        dayFormat = match[1] ? ~'ddd~' + ((match[1].length === 5) ? ~', ~' : ~' ~') : ~'~';~r~n'
as_code+='        dateFormat = ~'D MMM ~' + ((match[2].length > 10) ? ~'YYYY ~' : ~'YY ~');~r~n'
as_code+='        timeFormat = ~'HH:mm~' + (match[4] ? ~':ss~' : ~'~');~r~n'
as_code+='~r~n'
as_code+='        // TODO: Replace the vanilla JS Date object with an indepentent day-of-week check.~r~n'
as_code+='        if (match[1]) { // day of week given~r~n'
as_code+='            var momentDate = new Date(match[2]);~r~n'
as_code+='            var momentDay = [~'Sun~',~'Mon~',~'Tue~',~'Wed~',~'Thu~',~'Fri~',~'Sat~'][momentDate.getDay()];~r~n'
as_code+='~r~n'
as_code+='            if (match[1].substr(0,3) !== momentDay) {~r~n'
as_code+='                getParsingFlags(config).weekdayMismatch = true;~r~n'
as_code+='                config._isValid = false;~r~n'
as_code+='                return;~r~n'
as_code+='            }~r~n'
as_code+='        }~r~n'
as_code+='~r~n'
as_code+='        switch (match[5].length) {~r~n'
as_code+='            case 2: // military~r~n'
as_code+='                if (timezoneIndex === 0) {~r~n'
as_code+='                    timezone = ~' +0000~';~r~n'
as_code+='                } else {~r~n'
as_code+='                    timezoneIndex = military.indexOf(match[5][1].toUpperCase()) - 12;~r~n'
as_code+='                    timezone = ((timezoneIndex < 0) ? ~' -~' : ~' +~') +~r~n'
as_code+='                        ((~'~' + timezoneIndex).replace(/^-?/, ~'0~')).match(/..$/)[0] + ~'00~';~r~n'
as_code+='                }~r~n'
as_code+='                break;~r~n'
as_code+='            case 4: // Zone~r~n'
as_code+='                timezone = timezones[match[5]];~r~n'
as_code+='                break;~r~n'
as_code+='            default: // UT or +/-9999~r~n'
as_code+='                timezone = timezones[~' GMT~'];~r~n'
as_code+='        }~r~n'
as_code+='        match[5] = timezone;~r~n'
as_code+='        config._i = match.splice(1).join(~'~');~r~n'
as_code+='        tzFormat = ~' ZZ~';~r~n'
as_code+='        config._f = dayFormat + dateFormat + timeFormat + tzFormat;~r~n'
as_code+='        configFromStringAndFormat(config);~r~n'
as_code+='        getParsingFlags(config).rfc2822 = true;~r~n'
as_code+='    } else {~r~n'
as_code+='        config._isValid = false;~r~n'
as_code+='    }~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='// date from iso format or fallback~r~n'
as_code+='function configFromString(config) {~r~n'
as_code+='    var matched = aspNetJsonRegex.exec(config._i);~r~n'
as_code+='~r~n'
as_code+='    if (matched !== null) {~r~n'
as_code+='        config._d = new Date(+matched[1]);~r~n'
as_code+='        return;~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    configFromISO(config);~r~n'
as_code+='    if (config._isValid === false) {~r~n'
as_code+='        delete config._isValid;~r~n'
as_code+='    } else {~r~n'
as_code+='        return;~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    configFromRFC2822(config);~r~n'
as_code+='    if (config._isValid === false) {~r~n'
as_code+='        delete config._isValid;~r~n'
as_code+='    } else {~r~n'
as_code+='        return;~r~n'
