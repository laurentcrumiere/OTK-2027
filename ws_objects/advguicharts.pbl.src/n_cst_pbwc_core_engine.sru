as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    if (config._nextDay) {~r~n'
as_code+='        config._a[HOUR] = 24;~r~n'
as_code+='    }~r~n'
as_code+='}~r~n'
as_code+='~r~n'
as_code+='function dayOfYearFromWeekInfo(config) {~r~n'
as_code+='    var w, weekYear, week, weekday, dow, doy, temp, weekdayOverflow;~r~n'
as_code+='~r~n'
as_code+='    w = config._w;~r~n'
as_code+='    if (w.GG != null || w.W != null || w.E != null) {~r~n'
as_code+='        dow = 1;~r~n'
as_code+='        doy = 4;~r~n'
as_code+='~r~n'
as_code+='        // TODO: We need to take the current isoWeekYear, but that depends on~r~n'
as_code+='        // how we interpret now (local, utc, fixed offset). So create~r~n'
as_code+='        // a now version of current config (take local/utc/offset flags, and~r~n'
as_code+='        // create now).~r~n'
as_code+='        weekYear = defaults(w.GG, config._a[YEAR], weekOfYear(createLocal(), 1, 4).year);~r~n'
as_code+='        week = defaults(w.W, 1);~r~n'
as_code+='        weekday = defaults(w.E, 1);~r~n'
as_code+='        if (weekday < 1 || weekday > 7) {~r~n'
as_code+='            weekdayOverflow = true;~r~n'
as_code+='        }~r~n'
as_code+='    } else {~r~n'
as_code+='        dow = config._locale._week.dow;~r~n'
as_code+='        doy = config._locale._week.doy;~r~n'
as_code+='~r~n'
as_code+='        var curWeek = weekOfYear(createLocal(), dow, doy);~r~n'
as_code+='~r~n'
as_code+='        weekYear = defaults(w.gg, config._a[YEAR], curWeek.year);~r~n'
as_code+='~r~n'
as_code+='        // Default to current week.~r~n'
as_code+='        week = defaults(w.w, curWeek.week);~r~n'
as_code+='~r~n'
as_code+='        if (w.d != null) {~r~n'
as_code+='            // weekday -- low day numbers are considered next week~r~n'
as_code+='            weekday = w.d;~r~n'
as_code+='            if (weekday < 0 || weekday > 6) {~r~n'
as_code+='                weekdayOverflow = true;~r~n'
as_code+='            }~r~n'
as_code+='        } else if (w.e != null) {~r~n'
as_code+='            // local weekday -- counting starts from begining of week~r~n'
as_code+='            weekday = w.e + dow;~r~n'
as_code+='            if (w.e < 0 || w.e > 6) {~r~n'
as_code+='                weekdayOverflow = true;~r~n'
as_code+='            }~r~n'
as_code+='        } else {~r~n'
as_code+='            // default to begining of week~r~n'
as_code+='            weekday = dow;~r~n'
as_code+='        }~r~n'
as_code+='    }~r~n'
as_code+='    if (week < 1 || week > weeksInYear(weekYear, dow, doy)) {~r~n'
