as_code+='~r~n'
as_code+='addParseToken([~'YYYYY~', ~'YYYYYY~'], YEAR);~r~n'
as_code+='addParseToken(~'YYYY~', function (input, array) {~r~n'
as_code+='    array[YEAR] = input.length === 2 ? hooks.parseTwoDigitYear(input) : toInt(input);~r~n'
as_code+='});~r~n'
