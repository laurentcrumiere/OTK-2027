as_code+='~t~t},~r~n'
as_code+='~t~tfit: function() {~r~n'
as_code+='~t~t~tvar me = this;~r~n'
as_code+='~t~t~t// Reset~r~n'
as_code+='~t~t~tvar minSize = me.minSize = {~r~n'
as_code+='~t~t~t~twidth: 0,~r~n'
as_code+='~t~t~t~theight: 0~r~n'
as_code+='~t~t~t};~r~n'
as_code+='~r~n'
as_code+='~t~t~tvar labels = labelsFromTicks(me._ticks);~r~n'
as_code+='~r~n'
as_code+='~t~t~tvar opts = me.options;~r~n'
as_code+='~t~t~tvar tickOpts = opts.ticks;~r~n'
as_code+='~t~t~tvar scaleLabelOpts = opts.scaleLabel;~r~n'
as_code+='~t~t~tvar gridLineOpts = opts.gridLines;~r~n'
as_code+='~t~t~tvar display = opts.display;~r~n'
as_code+='~t~t~tvar isHorizontal = me.isHorizontal();~r~n'
as_code+='~r~n'
as_code+='~t~t~tvar tickFont = parseFontOptions(tickOpts);~r~n'
as_code+='~t~t~tvar tickMarkLength = opts.gridLines.tickMarkLength;~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Width~r~n'
as_code+='~t~t~tif (isHorizontal) {~r~n'
as_code+='~t~t~t~t// subtract the margins to line up with the chartArea if we are a full width scale~r~n'
as_code+='~t~t~t~tminSize.width = me.isFullWidth() ? me.maxWidth - me.margins.left - me.margins.right : me.maxWidth;~r~n'
as_code+='~t~t~t} else {~r~n'
as_code+='~t~t~t~tminSize.width = display && gridLineOpts.drawTicks ? tickMarkLength : 0;~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t// height~r~n'
as_code+='~t~t~tif (isHorizontal) {~r~n'
as_code+='~t~t~t~tminSize.height = display && gridLineOpts.drawTicks ? tickMarkLength : 0;~r~n'
as_code+='~t~t~t} else {~r~n'
as_code+='~t~t~t~tminSize.height = me.maxHeight; // fill all the height~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Are we showing a title for the scale?~r~n'
as_code+='~t~t~tif (scaleLabelOpts.display && display) {~r~n'
as_code+='~t~t~t~tvar scaleLabelLineHeight = parseLineHeight(scaleLabelOpts);~r~n'
as_code+='~t~t~t~tvar scaleLabelPadding = helpers.options.toPadding(scaleLabelOpts.padding);~r~n'
as_code+='~t~t~t~tvar deltaHeight = scaleLabelLineHeight + scaleLabelPadding.height;~r~n'
as_code+='~r~n'
as_code+='~t~t~t~tif (isHorizontal) {~r~n'
as_code+='~t~t~t~t~tminSize.height += deltaHeight;~r~n'
as_code+='~t~t~t~t} else {~r~n'
