as_code+='~r~n'
as_code+='~t~tvar outerDistance = scale.getDistanceFromCenterForValue(opts.ticks.reverse ? scale.min : scale.max);~r~n'
as_code+='~r~n'
as_code+='~t~t// Point Label Font~r~n'
