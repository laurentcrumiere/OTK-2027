as_code+='~t~t~t~tvar labelWidth = originalLabelWidth;~r~n'
as_code+='~t~t~t~tvar cosRotation, sinRotation;~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t// Allow 3 pixels x2 padding either side for label readability~r~n'
