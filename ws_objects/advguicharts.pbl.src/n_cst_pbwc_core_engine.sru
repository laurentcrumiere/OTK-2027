as_code+='}~r~n'
as_code+='~r~n'
as_code+='~r~n'
as_code+='function meridiemFixWrap (locale, hour, meridiem) {~r~n'
as_code+='    var isPm;~r~n'
as_code+='~r~n'
as_code+='    if (meridiem == null) {~r~n'
as_code+='        // nothing to do~r~n'
as_code+='        return hour;~r~n'
