as_code+='~t * @prop {Number} width - Width of item. Must be valid after update()~r~n'
as_code+='~t * @prop {Number} height - Height of item. Must be valid after update()~r~n'
as_code+='~t * @prop {Number} left - Left edge of the item. Set by layout system and cannot be used in update~r~n'
as_code+='~t * @prop {Number} top - Top edge of the item. Set by layout system and cannot be used in update~r~n'
as_code+='~t * @prop {Number} right - Right edge of the item. Set by layout system and cannot be used in update~r~n'
as_code+='~t * @prop {Number} bottom - Bottom edge of the item. Set by layout system and cannot be used in update~r~n'
as_code+='~t */~r~n'
as_code+='~r~n'
as_code+='~t// The layout service is very self explanatory.  It~'s responsible for the layout within a chart.~r~n'
as_code+='~t// Scales, Legends and Plugins all rely on the layout service and can easily register to be placed anywhere they need~r~n'
as_code+='~t// It is this service~'s responsibility of carrying out that layout.~r~n'
as_code+='~tChart.layoutService = {~r~n'
as_code+='~t~tdefaults: {},~r~n'
as_code+='~r~n'
as_code+='~t~t/**~r~n'
as_code+='~t~t * Register a box to a chart.~r~n'
as_code+='~t~t * A box is simply a reference to an object that requires layout. eg. Scales, Legend, Title.~r~n'
as_code+='~t~t * @param {Chart} chart - the chart to use~r~n'
as_code+='~t~t * @param {ILayoutItem} item - the item to add to be layed out~r~n'
as_code+='~t~t */~r~n'
as_code+='~t~taddBox: function(chart, item) {~r~n'
as_code+='~t~t~tif (!chart.boxes) {~r~n'
as_code+='~t~t~t~tchart.boxes = [];~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t// initialize item with default values~r~n'
as_code+='~t~t~titem.fullWidth = item.fullWidth || false;~r~n'
as_code+='~t~t~titem.position = item.position || ~'top~';~r~n'
as_code+='~t~t~titem.weight = item.weight || 0;~r~n'
as_code+='~r~n'
as_code+='~t~t~tchart.boxes.push(item);~r~n'
as_code+='~t~t},~r~n'
as_code+='~r~n'
as_code+='~t~t/**~r~n'
as_code+='~t~t * Remove a layoutItem from a chart~r~n'
as_code+='~t~t * @param {Chart} chart - the chart to remove the box from~r~n'
as_code+='~t~t * @param {Object} layoutItem - the item to remove from the layout~r~n'
as_code+='~t~t */~r~n'
as_code+='~t~tremoveBox: function(chart, layoutItem) {~r~n'
as_code+='~t~t~tvar index = chart.boxes ? chart.boxes.indexOf(layoutItem) : -1;~r~n'
as_code+='~t~t~tif (index !== -1) {~r~n'
as_code+='~t~t~t~tchart.boxes.splice(index, 1);~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~t~t},~r~n'
as_code+='~r~n'
as_code+='~t~t/**~r~n'
as_code+='~t~t * Sets (or updates) options on the given `item`.~r~n'
as_code+='~t~t * @param {Chart} chart - the chart in which the item lives (or will be added to)~r~n'
as_code+='~t~t * @param {Object} item - the item to configure with the given options~r~n'
as_code+='~t~t * @param {Object} options - the new item options.~r~n'
as_code+='~t~t */~r~n'
as_code+='~t~tconfigure: function(chart, item, options) {~r~n'
as_code+='~t~t~tvar props = [~'fullWidth~', ~'position~', ~'weight~'];~r~n'
as_code+='~t~t~tvar ilen = props.length;~r~n'
as_code+='~t~t~tvar i = 0;~r~n'
as_code+='~t~t~tvar prop;~r~n'
as_code+='~r~n'
as_code+='~t~t~tfor (; i < ilen; ++i) {~r~n'
as_code+='~t~t~t~tprop = props[i];~r~n'
as_code+='~t~t~t~tif (options.hasOwnProperty(prop)) {~r~n'
as_code+='~t~t~t~t~titem[prop] = options[prop];~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~t~t},~r~n'
as_code+='~r~n'
as_code+='~t~t/**~r~n'
as_code+='~t~t * Fits boxes of the given chart into the given size by having each box measure itself~r~n'
as_code+='~t~t * then running a fitting algorithm~r~n'
as_code+='~t~t * @param {Chart} chart - the chart~r~n'
as_code+='~t~t * @param {Number} width - the width to fit into~r~n'
as_code+='~t~t * @param {Number} height - the height to fit into~r~n'
as_code+='~t~t */~r~n'
as_code+='~t~tupdate: function(chart, width, height) {~r~n'
as_code+='~t~t~tif (!chart) {~r~n'
as_code+='~t~t~t~treturn;~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~tvar layoutOptions = chart.options.layout || {};~r~n'
as_code+='~t~t~tvar padding = helpers.options.toPadding(layoutOptions.padding);~r~n'
as_code+='~t~t~tvar leftPadding = padding.left;~r~n'
as_code+='~t~t~tvar rightPadding = padding.right;~r~n'
as_code+='~t~t~tvar topPadding = padding.top;~r~n'
as_code+='~t~t~tvar bottomPadding = padding.bottom;~r~n'
as_code+='~r~n'
as_code+='~t~t~tvar leftBoxes = filterByPosition(chart.boxes, ~'left~');~r~n'
as_code+='~t~t~tvar rightBoxes = filterByPosition(chart.boxes, ~'right~');~r~n'
as_code+='~t~t~tvar topBoxes = filterByPosition(chart.boxes, ~'top~');~r~n'
as_code+='~t~t~tvar bottomBoxes = filterByPosition(chart.boxes, ~'bottom~');~r~n'
as_code+='~t~t~tvar chartAreaBoxes = filterByPosition(chart.boxes, ~'chartArea~');~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Sort boxes by weight. A higher weight is further away from the chart area~r~n'
as_code+='~t~t~tsortByWeight(leftBoxes, true);~r~n'
as_code+='~t~t~tsortByWeight(rightBoxes, false);~r~n'
as_code+='~t~t~tsortByWeight(topBoxes, true);~r~n'
as_code+='~t~t~tsortByWeight(bottomBoxes, false);~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Essentially we now have any number of boxes on each of the 4 sides.~r~n'
as_code+='~t~t~t// Our canvas looks like the following.~r~n'
as_code+='~t~t~t// The areas L1 and L2 are the left axes. R1 is the right axis, T1 is the top axis and~r~n'
as_code+='~t~t~t// B1 is the bottom axis~r~n'
as_code+='~t~t~t// There are also 4 quadrant-like locations (left to right instead of clockwise) reserved for chart overlays~r~n'
as_code+='~t~t~t// These locations are single-box locations only, when trying to register a chartArea location that is already taken,~r~n'
as_code+='~t~t~t// an error will be thrown.~r~n'
as_code+='~t~t~t//~r~n'
as_code+='~t~t~t// |----------------------------------------------------|~r~n'
as_code+='~t~t~t// |                  T1 (Full Width)                   |~r~n'
as_code+='~t~t~t// |----------------------------------------------------|~r~n'
as_code+='~t~t~t// |    |    |                 T2                  |    |~r~n'
as_code+='~t~t~t// |    |----|-------------------------------------|----|~r~n'
as_code+='~t~t~t// |    |    | C1 |                           | C2 |    |~r~n'
as_code+='~t~t~t// |    |    |----|                           |----|    |~r~n'
as_code+='~t~t~t// |    |    |                                     |    |~r~n'
as_code+='~t~t~t// | L1 | L2 |           ChartArea (C0)            | R1 |~r~n'
as_code+='~t~t~t// |    |    |                                     |    |~r~n'
as_code+='~t~t~t// |    |    |----|                           |----|    |~r~n'
as_code+='~t~t~t// |    |    | C3 |                           | C4 |    |~r~n'
as_code+='~t~t~t// |    |----|-------------------------------------|----|~r~n'
as_code+='~t~t~t// |    |    |                 B1                  |    |~r~n'
as_code+='~t~t~t// |----------------------------------------------------|~r~n'
as_code+='~t~t~t// |                  B2 (Full Width)                   |~r~n'
as_code+='~t~t~t// |----------------------------------------------------|~r~n'
as_code+='~t~t~t//~r~n'
as_code+='~t~t~t// What we do to find the best sizing, we do the following~r~n'
as_code+='~t~t~t// 1. Determine the minimum size of the chart area.~r~n'
as_code+='~t~t~t// 2. Split the remaining width equally between each vertical axis~r~n'
as_code+='~t~t~t// 3. Split the remaining height equally between each horizontal axis~r~n'
as_code+='~t~t~t// 4. Give each layout the maximum size it can be. The layout will return it~'s minimum size~r~n'
as_code+='~t~t~t// 5. Adjust the sizes of each axis based on it~'s minimum reported size.~r~n'
as_code+='~t~t~t// 6. Refit each axis~r~n'
as_code+='~t~t~t// 7. Position each axis in the final location~r~n'
as_code+='~t~t~t// 8. Tell the chart the final location of the chart area~r~n'
as_code+='~t~t~t// 9. Tell any axes that overlay the chart area the positions of the chart area~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Step 1~r~n'
as_code+='~t~t~tvar chartWidth = width - leftPadding - rightPadding;~r~n'
as_code+='~t~t~tvar chartHeight = height - topPadding - bottomPadding;~r~n'
as_code+='~t~t~tvar chartAreaWidth = chartWidth / 2; // min 50%~r~n'
as_code+='~t~t~tvar chartAreaHeight = chartHeight / 2; // min 50%~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Step 2~r~n'
as_code+='~t~t~tvar verticalBoxWidth = (width - chartAreaWidth) / (leftBoxes.length + rightBoxes.length);~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Step 3~r~n'
as_code+='~t~t~tvar horizontalBoxHeight = (height - chartAreaHeight) / (topBoxes.length + bottomBoxes.length);~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Step 4~r~n'
as_code+='~t~t~tvar maxChartAreaWidth = chartWidth;~r~n'
as_code+='~t~t~tvar maxChartAreaHeight = chartHeight;~r~n'
as_code+='~t~t~tvar minBoxSizes = [];~r~n'
as_code+='~r~n'
as_code+='~t~t~tfunction getMinimumBoxSize(box) {~r~n'
as_code+='~t~t~t~tvar minSize;~r~n'
as_code+='~t~t~t~tvar isHorizontal = box.isHorizontal();~r~n'
as_code+='~r~n'
as_code+='~t~t~t~tif (isHorizontal) {~r~n'
as_code+='~t~t~t~t~tminSize = box.update(box.fullWidth ? chartWidth : maxChartAreaWidth, horizontalBoxHeight);~r~n'
as_code+='~t~t~t~t~tmaxChartAreaHeight -= minSize.height;~r~n'
as_code+='~t~t~t~t} else {~r~n'
as_code+='~t~t~t~t~tminSize = box.update(verticalBoxWidth, chartAreaHeight);~r~n'
as_code+='~t~t~t~t~tmaxChartAreaWidth -= minSize.width;~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t~tminBoxSizes.push({~r~n'
as_code+='~t~t~t~t~thorizontal: isHorizontal,~r~n'
as_code+='~t~t~t~t~tminSize: minSize,~r~n'
as_code+='~t~t~t~t~tbox: box,~r~n'
as_code+='~t~t~t~t});~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~thelpers.each(leftBoxes.concat(rightBoxes, topBoxes, bottomBoxes), getMinimumBoxSize);~r~n'
as_code+='~r~n'
as_code+='~t~t~t// If a horizontal box has padding, we move the left boxes over to avoid ugly charts (see issue #2478)~r~n'
as_code+='~t~t~tvar maxHorizontalLeftPadding = 0;~r~n'
as_code+='~t~t~tvar maxHorizontalRightPadding = 0;~r~n'
as_code+='~t~t~tvar maxVerticalTopPadding = 0;~r~n'
as_code+='~t~t~tvar maxVerticalBottomPadding = 0;~r~n'
as_code+='~r~n'
as_code+='~t~t~thelpers.each(topBoxes.concat(bottomBoxes), function(horizontalBox) {~r~n'
as_code+='~t~t~t~tif (horizontalBox.getPadding) {~r~n'
as_code+='~t~t~t~t~tvar boxPadding = horizontalBox.getPadding();~r~n'
as_code+='~t~t~t~t~tmaxHorizontalLeftPadding = Math.max(maxHorizontalLeftPadding, boxPadding.left);~r~n'
as_code+='~t~t~t~t~tmaxHorizontalRightPadding = Math.max(maxHorizontalRightPadding, boxPadding.right);~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~thelpers.each(leftBoxes.concat(rightBoxes), function(verticalBox) {~r~n'
as_code+='~t~t~t~tif (verticalBox.getPadding) {~r~n'
as_code+='~t~t~t~t~tvar boxPadding = verticalBox.getPadding();~r~n'
as_code+='~t~t~t~t~tmaxVerticalTopPadding = Math.max(maxVerticalTopPadding, boxPadding.top);~r~n'
as_code+='~t~t~t~t~tmaxVerticalBottomPadding = Math.max(maxVerticalBottomPadding, boxPadding.bottom);~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~t// At this point, maxChartAreaHeight and maxChartAreaWidth are the size the chart area could~r~n'
as_code+='~t~t~t// be if the axes are drawn at their minimum sizes.~r~n'
as_code+='~t~t~t// Steps 5 & 6~r~n'
as_code+='~t~t~tvar totalLeftBoxesWidth = leftPadding;~r~n'
as_code+='~t~t~tvar totalRightBoxesWidth = rightPadding;~r~n'
as_code+='~t~t~tvar totalTopBoxesHeight = topPadding;~r~n'
as_code+='~t~t~tvar totalBottomBoxesHeight = bottomPadding;~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Function to fit a box~r~n'
as_code+='~t~t~tfunction fitBox(box) {~r~n'
as_code+='~t~t~t~tvar minBoxSize = helpers.findNextWhere(minBoxSizes, function(minBox) {~r~n'
as_code+='~t~t~t~t~treturn minBox.box === box;~r~n'
as_code+='~t~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~t~tif (minBoxSize) {~r~n'
as_code+='~t~t~t~t~tif (box.isHorizontal()) {~r~n'
as_code+='~t~t~t~t~t~tvar scaleMargin = {~r~n'
as_code+='~t~t~t~t~t~t~tleft: Math.max(totalLeftBoxesWidth, maxHorizontalLeftPadding),~r~n'
as_code+='~t~t~t~t~t~t~tright: Math.max(totalRightBoxesWidth, maxHorizontalRightPadding),~r~n'
as_code+='~t~t~t~t~t~t~ttop: 0,~r~n'
as_code+='~t~t~t~t~t~t~tbottom: 0~r~n'
as_code+='~t~t~t~t~t~t};~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~t~t// Don~'t use min size here because of label rotation. When the labels are rotated, their rotation highly depends~r~n'
as_code+='~t~t~t~t~t~t// on the margin. Sometimes they need to increase in size slightly~r~n'
as_code+='~t~t~t~t~t~tbox.update(box.fullWidth ? chartWidth : maxChartAreaWidth, chartHeight / 2, scaleMargin);~r~n'
as_code+='~t~t~t~t~t} else {~r~n'
as_code+='~t~t~t~t~t~tbox.update(minBoxSize.minSize.width, maxChartAreaHeight);~r~n'
as_code+='~t~t~t~t~t}~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Update, and calculate the left and right margins for the horizontal boxes~r~n'
as_code+='~t~t~thelpers.each(leftBoxes.concat(rightBoxes), fitBox);~r~n'
as_code+='~r~n'
as_code+='~t~t~thelpers.each(leftBoxes, function(box) {~r~n'
as_code+='~t~t~t~ttotalLeftBoxesWidth += box.width;~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~thelpers.each(rightBoxes, function(box) {~r~n'
as_code+='~t~t~t~ttotalRightBoxesWidth += box.width;~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Set the Left and Right margins for the horizontal boxes~r~n'
as_code+='~t~t~thelpers.each(topBoxes.concat(bottomBoxes), fitBox);~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Figure out how much margin is on the top and bottom of the vertical boxes~r~n'
as_code+='~t~t~thelpers.each(topBoxes, function(box) {~r~n'
as_code+='~t~t~t~ttotalTopBoxesHeight += box.height;~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~thelpers.each(bottomBoxes, function(box) {~r~n'
as_code+='~t~t~t~ttotalBottomBoxesHeight += box.height;~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~tfunction finalFitVerticalBox(box) {~r~n'
as_code+='~t~t~t~tvar minBoxSize = helpers.findNextWhere(minBoxSizes, function(minSize) {~r~n'
as_code+='~t~t~t~t~treturn minSize.box === box;~r~n'
as_code+='~t~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~t~tvar scaleMargin = {~r~n'
as_code+='~t~t~t~t~tleft: 0,~r~n'
as_code+='~t~t~t~t~tright: 0,~r~n'
as_code+='~t~t~t~t~ttop: totalTopBoxesHeight,~r~n'
as_code+='~t~t~t~t~tbottom: totalBottomBoxesHeight~r~n'
as_code+='~t~t~t~t};~r~n'
as_code+='~r~n'
as_code+='~t~t~t~tif (minBoxSize) {~r~n'
as_code+='~t~t~t~t~tbox.update(minBoxSize.minSize.width, maxChartAreaHeight, scaleMargin);~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Let the left layout know the final margin~r~n'
as_code+='~t~t~thelpers.each(leftBoxes.concat(rightBoxes), finalFitVerticalBox);~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Recalculate because the size of each layout might have changed slightly due to the margins (label rotation for instance)~r~n'
as_code+='~t~t~ttotalLeftBoxesWidth = leftPadding;~r~n'
as_code+='~t~t~ttotalRightBoxesWidth = rightPadding;~r~n'
as_code+='~t~t~ttotalTopBoxesHeight = topPadding;~r~n'
as_code+='~t~t~ttotalBottomBoxesHeight = bottomPadding;~r~n'
as_code+='~r~n'
as_code+='~t~t~thelpers.each(leftBoxes, function(box) {~r~n'
as_code+='~t~t~t~ttotalLeftBoxesWidth += box.width;~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~thelpers.each(rightBoxes, function(box) {~r~n'
as_code+='~t~t~t~ttotalRightBoxesWidth += box.width;~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~thelpers.each(topBoxes, function(box) {~r~n'
as_code+='~t~t~t~ttotalTopBoxesHeight += box.height;~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~t~t~thelpers.each(bottomBoxes, function(box) {~r~n'
as_code+='~t~t~t~ttotalBottomBoxesHeight += box.height;~r~n'
as_code+='~t~t~t});~r~n'
as_code+='~r~n'
as_code+='~t~t~t// We may be adding some padding to account for rotated x axis labels~r~n'
as_code+='~t~t~tvar leftPaddingAddition = Math.max(maxHorizontalLeftPadding - totalLeftBoxesWidth, 0);~r~n'
as_code+='~t~t~ttotalLeftBoxesWidth += leftPaddingAddition;~r~n'
as_code+='~t~t~ttotalRightBoxesWidth += Math.max(maxHorizontalRightPadding - totalRightBoxesWidth, 0);~r~n'
as_code+='~r~n'
as_code+='~t~t~tvar topPaddingAddition = Math.max(maxVerticalTopPadding - totalTopBoxesHeight, 0);~r~n'
as_code+='~t~t~ttotalTopBoxesHeight += topPaddingAddition;~r~n'
as_code+='~t~t~ttotalBottomBoxesHeight += Math.max(maxVerticalBottomPadding - totalBottomBoxesHeight, 0);~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Figure out if our chart area changed. This would occur if the dataset layout label rotation~r~n'
as_code+='~t~t~t// changed due to the application of the margins in step 6. Since we can only get bigger, this is safe to do~r~n'
as_code+='~t~t~t// without calling `fit` again~r~n'
as_code+='~t~t~tvar newMaxChartAreaHeight = height - totalTopBoxesHeight - totalBottomBoxesHeight;~r~n'
as_code+='~t~t~tvar newMaxChartAreaWidth = width - totalLeftBoxesWidth - totalRightBoxesWidth;~r~n'
