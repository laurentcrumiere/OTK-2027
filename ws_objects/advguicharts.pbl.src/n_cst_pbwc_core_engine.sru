as_code+='        getParsingFlags(config)._overflowWeekday = true;~r~n'
as_code+='    } else {~r~n'
as_code+='        temp = dayOfYearFromWeeks(weekYear, week, weekday, dow, doy);~r~n'
as_code+='        config._a[YEAR] = temp.year;~r~n'
as_code+='        config._dayOfYear = temp.dayOfYear;~r~n'
as_code+='    }~r~n'
as_code+='}~r~n'
as_code+='~r~n'
end subroutine

public subroutine of_chart_bundle_5 (ref string as_code);
as_code+='// constant that refers to the ISO standard~r~n'
as_code+='hooks.ISO_8601 = function () {};~r~n'
as_code+='~r~n'
as_code+='// constant that refers to the RFC 2822 form~r~n'
as_code+='hooks.RFC_2822 = function () {};~r~n'
as_code+='~r~n'
as_code+='// date from string and format string~r~n'
as_code+='function configFromStringAndFormat(config) {~r~n'
as_code+='    // TODO: Move this to another part of the creation flow to prevent circular deps~r~n'
as_code+='    if (config._f === hooks.ISO_8601) {~r~n'
as_code+='        configFromISO(config);~r~n'
as_code+='        return;~r~n'
as_code+='    }~r~n'
as_code+='    if (config._f === hooks.RFC_2822) {~r~n'
as_code+='        configFromRFC2822(config);~r~n'
as_code+='        return;~r~n'
as_code+='    }~r~n'
as_code+='    config._a = [];~r~n'
as_code+='    getParsingFlags(config).empty = true;~r~n'
as_code+='~r~n'
as_code+='    // This array is used to make a Date, either with `new Date` or `Date.UTC`~r~n'
as_code+='    var string = ~'~' + config._i,~r~n'
as_code+='        i, parsedInput, tokens, token, skipped,~r~n'
as_code+='        stringLength = string.length,~r~n'
as_code+='        totalParsedInputLength = 0;~r~n'
as_code+='~r~n'
as_code+='    tokens = expandFormat(config._f, config._locale).match(formattingTokens) || [];~r~n'
as_code+='~r~n'
as_code+='    for (i = 0; i < tokens.length; i++) {~r~n'
as_code+='        token = tokens[i];~r~n'
as_code+='        parsedInput = (string.match(getParseRegexForToken(token, config)) || [])[0];~r~n'
as_code+='        // console.log(~'token~', token, ~'parsedInput~', parsedInput,~r~n'
as_code+='        //         ~'regex~', getParseRegexForToken(token, config));~r~n'
as_code+='        if (parsedInput) {~r~n'
as_code+='            skipped = string.substr(0, string.indexOf(parsedInput));~r~n'
as_code+='            if (skipped.length > 0) {~r~n'
as_code+='                getParsingFlags(config).unusedInput.push(skipped);~r~n'
as_code+='            }~r~n'
as_code+='            string = string.slice(string.indexOf(parsedInput) + parsedInput.length);~r~n'
as_code+='            totalParsedInputLength += parsedInput.length;~r~n'
as_code+='        }~r~n'
as_code+='        // don~'t parse if it~'s not a known token~r~n'
