as_code+='~t~t~treturn Math.min(tickOpts.maxTicksLimit ? tickOpts.maxTicksLimit : 11, Math.ceil(this.drawingArea / (1.5 * tickFontSize)));~r~n'
as_code+='~t~t},~r~n'
