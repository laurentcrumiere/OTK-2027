as_code+='~r~n'
as_code+='~tfunction numberOrZero(param) {~r~n'
as_code+='~t~treturn helpers.isNumber(param) ? param : 0;~r~n'
as_code+='~t}~r~n'
as_code+='~r~n'
as_code+='~tvar LinearRadialScale = Chart.LinearScaleBase.extend({~r~n'
as_code+='~t~tsetDimensions: function() {~r~n'
as_code+='~t~t~tvar me = this;~r~n'
