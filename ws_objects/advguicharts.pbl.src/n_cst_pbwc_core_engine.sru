as_code+='~t~t},~r~n'
as_code+='~t~tcalculateTickRotation: function() {~r~n'
as_code+='~t~t~tvar me = this;~r~n'
as_code+='~t~t~tvar context = me.ctx;~r~n'
as_code+='~t~t~tvar tickOpts = me.options.ticks;~r~n'
as_code+='~t~t~tvar labels = labelsFromTicks(me._ticks);~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Get the width of each grid by calculating the difference~r~n'
