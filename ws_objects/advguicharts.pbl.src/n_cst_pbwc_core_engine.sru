as_code+='~t~t},~r~n'
as_code+='~t~tcalculateTickRotation: function() {~r~n'
as_code+='~t~t~tvar me = this;~r~n'
as_code+='~t~t~tvar context = me.ctx;~r~n'
as_code+='~t~t~tvar tickOpts = me.options.ticks;~r~n'
as_code+='~t~t~tvar labels = labelsFromTicks(me._ticks);~r~n'
as_code+='~r~n'
as_code+='~t~t~t// Get the width of each grid by calculating the difference~r~n'
as_code+='~t~t~t// between x offsets between 0 and 1.~r~n'
as_code+='~t~t~tvar tickFont = parseFontOptions(tickOpts);~r~n'
as_code+='~t~t~tcontext.font = tickFont.font;~r~n'
as_code+='~r~n'
as_code+='~t~t~tvar labelRotation = tickOpts.minRotation || 0;~r~n'
as_code+='~r~n'
as_code+='~t~t~tif (labels.length && me.options.display && me.isHorizontal()) {~r~n'
as_code+='~t~t~t~tvar originalLabelWidth = helpers.longestText(context, tickFont.font, labels, me.longestTextCache);~r~n'
as_code+='~t~t~t~tvar labelWidth = originalLabelWidth;~r~n'
as_code+='~t~t~t~tvar cosRotation, sinRotation;~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t// Allow 3 pixels x2 padding either side for label readability~r~n'
as_code+='~t~t~t~tvar tickWidth = me.getPixelForTick(1) - me.getPixelForTick(0) - 6;~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t// Max label rotation can be set or default to 90 - also act as a loop counter~r~n'
as_code+='~t~t~t~twhile (labelWidth > tickWidth && labelRotation < tickOpts.maxRotation) {~r~n'
as_code+='~t~t~t~t~tvar angleRadians = helpers.toRadians(labelRotation);~r~n'
as_code+='~t~t~t~t~tcosRotation = Math.cos(angleRadians);~r~n'
as_code+='~t~t~t~t~tsinRotation = Math.sin(angleRadians);~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~tif (sinRotation * originalLabelWidth > me.maxHeight) {~r~n'
as_code+='~t~t~t~t~t~t// go back one step~r~n'
as_code+='~t~t~t~t~t~tlabelRotation--;~r~n'
as_code+='~t~t~t~t~t~tbreak;~r~n'
as_code+='~t~t~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~t~t~tlabelRotation++;~r~n'
as_code+='~t~t~t~t~tlabelWidth = cosRotation * originalLabelWidth;~r~n'
as_code+='~t~t~t~t}~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~r~n'
as_code+='~t~t~tme.labelRotation = labelRotation;~r~n'
