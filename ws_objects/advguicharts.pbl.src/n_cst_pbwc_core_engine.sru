as_code+='~r~n'
as_code+='function createDate (y, m, d, h, M, s, ms) {~r~n'
as_code+='    // can~'t just apply() to create a date:~r~n'
as_code+='    // https://stackoverflow.com/q/181348~r~n'
as_code+='    var date = new Date(y, m, d, h, M, s, ms);~r~n'
as_code+='~r~n'
as_code+='    // the date constructor remaps years 0-99 to 1900-1999~r~n'
as_code+='    if (y < 100 && y >= 0 && isFinite(date.getFullYear())) {~r~n'
