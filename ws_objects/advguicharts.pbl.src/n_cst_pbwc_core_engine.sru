as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    dayOfMonth = Math.min(mom.date(), daysInMonth(mom.year(), value));~r~n'
as_code+='    mom._d[~'set~' + (mom._isUTC ? ~'UTC~' : ~'~') + ~'Month~'](value, dayOfMonth);~r~n'
