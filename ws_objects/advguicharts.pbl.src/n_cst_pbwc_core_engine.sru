as_code+='~r~n'
as_code+='hooks.createFromInputFallback = deprecate(~r~n'
as_code+='    ~'value provided is not in a recognized RFC2822 or ISO format. moment construction falls back to js Date(), ~' +~r~n'
as_code+='    ~'which is not reliable across all browsers and versions. Non RFC2822/ISO date formats are ~' +~r~n'
as_code+='    ~'discouraged and will be removed in an upcoming major release. Please refer to ~' +~r~n'
as_code+='    ~'http://momentjs.com/guides/#/warnings/js-date/ for more info.~',~r~n'
as_code+='    function (config) {~r~n'
as_code+='        config._d = new Date(config._i + (config._useUTC ? ~' UTC~' : ~'~'));~r~n'
