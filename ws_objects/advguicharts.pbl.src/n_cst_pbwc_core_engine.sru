as_code+='~r~n'
as_code+='    getParsingFlags(config).parsedDateParts = config._a.slice(0);~r~n'
as_code+='    getParsingFlags(config).meridiem = config._meridiem;~r~n'
as_code+='    // handle meridiem~r~n'
