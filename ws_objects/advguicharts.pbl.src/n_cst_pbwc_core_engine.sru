public function boolean of_check_version (string as_path, string as_module, string as_version);// 01/01/2026	FFasolin	Added support for char.js 4.5
string ls_file,ls_version
int li_ret
//check if file exists, if not, create it.
ls_file = as_path + "\"+"pbwc.ver"
If fileexists(ls_file) = FALSE THEN
	integer li_FileNum
	li_FileNum = FileOpen(ls_file,   textmode!, Write!, LockWrite!, Replace!)
	string ls_chapter = "[PBWC]"
	li_ret = filewriteex(li_FileNum,ls_chapter)
	fileclose(li_FileNum)
END IF
setpointer(hourglass!)
ls_version = profilestring(ls_file,"PBWC",as_module,"")
IF as_version<>ls_version THEN
	CHOOSE CASE as_module
		CASE "chart_js"
			setpointer(hourglass!)
			of_chart(as_path+"\Chart.js")
			of_chart_bundle(as_path+"\Chart.bundle.js")
			of_chart_umd(as_path+"\Chart.umd.js")
			of_luxon(as_path+"\luxon.min.js")
			of_chartjs_adapter_luxon(as_path+"\chartjs-adapter-luxon.js")
			setpointer(hourglass!)
			
		CASE "chart_js_datalabels"
			setpointer(hourglass!)
			of_chart_datalabels(as_path+"\chartjs-plugin-datalabels.js")
			of_chartjs_plugin_datalabels(as_path+"\chartjs-plug-in-datalabels.js")
		CASE "gauge_js"
			setpointer(hourglass!)
			of_gauge(as_path+"\gauge.js")
	END CHOOSE
	
	setprofilestring(ls_file,"PBWC",as_module,as_version)
END IF


return TRUE
end function

public function integer of_write_file (string as_filename);//writes a file
integer li_FileNum, li_ret
li_FileNum = FileOpen(as_filename, textMode!, Write!, LockWrite!, Replace!)
li_ret = filewriteex(li_FileNum,is_source)
fileclose(li_FileNum)
return li_ret
end function

