as_code+='~r~n'
as_code+='~t~t// Shared Methods~r~n'
as_code+='~t~tisHorizontal: function() {~r~n'
as_code+='~t~t~treturn this.options.position === ~'top~' || this.options.position === ~'bottom~';~r~n'
as_code+='~t~t},~r~n'
as_code+='~t~tisFullWidth: function() {~r~n'
as_code+='~t~t~treturn (this.options.fullWidth);~r~n'
as_code+='~t~t},~r~n'
as_code+='~r~n'
as_code+='~t~t// Get the correct value. NaN bad inputs, If the value type is object get the x or y based on whether we are horizontal or not~r~n'
as_code+='~t~tgetRightValue: function(rawValue) {~r~n'
as_code+='~t~t~t// Null and undefined values first~r~n'
as_code+='~t~t~tif (helpers.isNullOrUndef(rawValue)) {~r~n'
as_code+='~t~t~t~treturn NaN;~r~n'
as_code+='~t~t~t}~r~n'
as_code+='~t~t~t// isNaN(object) returns true, so make sure NaN is checking for a number; Discard Infinite values~r~n'
as_code+='~t~t~tif (typeof rawValue === ~'number~' && !isFinite(rawValue)) {~r~n'
