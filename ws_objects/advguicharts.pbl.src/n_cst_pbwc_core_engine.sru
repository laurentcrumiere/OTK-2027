as_code+='~r~n'
as_code+='// https://en.wikipedia.org/wiki/ISO_week_date#Calculating_a_date_given_the_year.2C_week_number_and_weekday~r~n'
as_code+='function dayOfYearFromWeeks(year, week, weekday, dow, doy) {~r~n'
as_code+='    var localWeekday = (7 + weekday - dow) % 7,~r~n'
