as_code+='        resYear = year;~r~n'
as_code+='        resDayOfYear = dayOfYear;~r~n'
as_code+='    }~r~n'
as_code+='~r~n'
as_code+='    return {~r~n'
as_code+='        year: resYear,~r~n'
as_code+='        dayOfYear: resDayOfYear~r~n'
as_code+='    };~r~n'
