end type
global uo_schema_clinique uo_schema_clinique

type variables
private double	idbl_var_num_dossier
private string	istr_rep_photo_patient
private string	istr_full_path_image

string	default_pic
string	pic_save_name
end variables

event dblclick();Security_Attributes		IpSecurityAttributes
string 						lstr_ligne_de_cmd


if not fxg_fileexists(istr_rep_photo_patient) then
// si pour ce patient pas encore de rep photo --> on le crée
	CreateDirectoryA( istr_rep_photo_patient, IpSecurityAttributes)
end if

if not fileexists(istr_full_path_image) then
// si aucun fichier pour ce shéma ds rep photo du patient
	// on sauve l'image par defaut avec le nom "pic_save_name"
	this.object.SaveFormat = IG_SAVE_BMP;		// en bmp
	this.object.SaveImage = istr_full_path_image;
end if

if gfx_generer_cmd_retouche_image(istr_full_path_image, lstr_ligne_de_cmd) = 1 then
// si on a généré une ligne de commande valide -> on la lance
//	runwait(lstr_ligne_de_cmd, 1)
	run( lstr_ligne_de_cmd )
	sleep(2000)
	messagebox("Poursuivre ...", "Une fois l'édition du schéma terminée, ~nappuyez sur 'OK' pour poursuivre ...")
	// on charge l'image retouchée
	this.object.delimage = true
	this.object.LoadImage =  istr_full_path_image

else
// un pb avec ligne de commande
	messagebox("ATTENTION ...", "Impossible d'éditer le schéma. ~n~nCause possible : ~naucun logiciel de retouche photo n'est indiqué ~ndans les paramétrages avancés de l'imagerie.", Exclamation!)
end if

end event

on uo_schema_clinique.create
end on

on uo_schema_clinique.destroy
end on

event constructor;string	lstr_rep_photo


// recup num client
idbl_var_num_dossier = message.doubleparm

// recup rep photo
lstr_rep_photo = fxg_get_rep_photos()

if lstr_rep_photo <> "" then
// si rep photo bien indiqué
	// création du path complet du rep patient
	istr_rep_photo_patient = lstr_rep_photo + string(idbl_var_num_dossier) + "\"
	
	// création du path complet de l'image à sauvegarder ds rep patient
	istr_full_path_image = istr_rep_photo_patient + pic_save_name

	// init imagegear
	this.object.AutoRedraw = true
	this.object.backcolor = rgb(255,255,255)
	
	if FileExists(istr_full_path_image) then
	// si un fichier image existe déjà -> on le charge
		this.object.LoadImage =  istr_full_path_image
	else
	// pas présent donc -> on charge l'image standard (de base)
		this.object.LoadImage =  DIR_INI + default_pic
	end if
	
	// on indique à imagegear d'afficher l'image au format 1:1
	this.object.dsplFitMethodSet(3) //IG_DSPL_ACTUAL_SIZE
	this.object.dsplAspectSet(0, 1); //IG_DSPL_ASPECT_FIXED
	
	//// redimentionne le conteneur uo power builder ds la fenêtre
	//this.width = PixelsToUnits(this.object.imagewidth, XPixelsToUnits!)
	//this.height = PixelsToUnits(this.object.imageheight, YPixelsToUnits!)

end if

end event

event rbuttondown;if FileExists(istr_full_path_image) then
// si un schéma déjà présent ds rep photo du patient
	if messagebox("QUESTION ...", "Voulez-vous recharger le schéma vierge ?", Question!, YesNo! ) = 1 then
	// si l'utilisateur souhaite repartir de l'image de base
		this.object.delimage = true
		this.object.LoadImage =  DIR_INI + default_pic
		
		if DeleteFileA(istr_full_path_image) = 0 then
			messagebox("ERREUR ...", "impossible d'achever la recharge du schéma vierge.", StopSign!)
		end if
	end if
end if
end event


