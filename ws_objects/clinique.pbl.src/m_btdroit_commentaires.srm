event clicked;
double db_code_interne_rdv 


if commentaires_2010 then
	fxg_get_infos_modifs(w_click_coment_2010.dw_coment, w_click_coment_2010.dw_coment.getrow() )
	db_code_interne_rdv = w_click_coment_2010.dw_coment.GetItemNumber( w_click_coment_2010.dw_coment.getrow(), "code_interne_rdv")
	// reche
else
	fxg_get_infos_modifs(w_click_coment.dw_coment, w_click_coment.dw_coment.getrow() )
	db_code_interne_rdv = w_click_coment.dw_coment.GetItemNumber( w_click_coment.dw_coment.getrow(), "code_interne_rdv")
end if

// Rechecher des éléments du rdv
datetime dt_rdv
string s_type_rdv



select  first rdv , isnull(type_rdv.nom , '')
into :dt_rdv, :s_type_rdv 
from rdv, type_rdv 
where rdv.code_interne = :db_code_interne_rdv and rdv."type" = type_rdv.code  ;

if s_type_rdv= '' then
	Messagebox("INFORMATION","Aucun rendez-vous n'est associé à ce comemntaire !")
else
	Messagebox("INFORMATIONS SUR LE RENDEZ-VOUS ASSOCIE","Rendez-vous du " + string(dt_rdv , "dd/mm/yyyy à hh:mm") +" pour " + s_type_rdv )
end if
end event

type m_exporter from menu within m_btdroit_commentaires
end type

event clicked;int ret 

if commentaires_2010 then
	w_click_coment_2010.dw_coment_export = create datastore
	w_click_coment_2010.dw_coment_export.dataobject = "dw_coment_export"

	w_click_coment_2010.dw_coment_export.SetTransObject(sqlca)
	w_click_coment_2010.dw_coment_export.retrieve(w_click_coment_2010.var_code_local)

	param_win[1] = "E"
	openWithParm(w_exporter_datastore_excel,  w_click_coment_2010.dw_coment_export)
else
	w_click_coment.dw_coment_export = create datastore
	w_click_coment.dw_coment_export.dataobject = "dw_coment_export"
	w_click_coment.dw_coment_export.object.datawindow.print.DocumentName = "Commentaires Cliniques"

	
	ret = w_click_coment.dw_coment_export.SetTransObject(sqlca)
	ret = w_click_coment.dw_coment_export.retrieve(w_click_coment.var_code_local)

	// Variable d'instance passée ....
	param_win[1] = "E"
	openWithParm(w_exporter_datastore_excel,  w_click_coment.dw_coment_export)
end if

end event

