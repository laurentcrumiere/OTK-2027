this.m_com1=create m_com1
this.m_acteprévu=create m_acteprévu
this.m_com30=create m_com30
this.m_comn4=create m_comn4
this.m_comn5=create m_comn5
this.m_comn6=create m_comn6
this.Item[UpperBound(this.Item)+1]=this.m_com1
this.Item[UpperBound(this.Item)+1]=this.m_acteprévu
this.Item[UpperBound(this.Item)+1]=this.m_com30
this.Item[UpperBound(this.Item)+1]=this.m_comn4
