forward prototypes
public subroutine restaure_texte (string colname)
end prototypes

public subroutine restaure_texte (string colname);if not 	commentaires_2010 then

	if w_click_coment.dw_coment.rowcount() > 0 then
		long lig 
		string v_texte
		
		lig = w_click_coment.dw_coment.getrow()
		
		Clipboard (w_click_coment.dw_coment.getItemString(lig, colName + "_html") )

		w_click_coment.dw_coment.setItem(lig, colName,"")
		w_click_coment.dw_coment.setColumn(colName)
		w_click_coment.dw_coment.setfocus()
		police_rtf_par_defaut(w_click_coment.dw_coment)
		
		w_click_coment.dw_coment.paste()
		
		
//		w_click_coment.dw_coment.setItem(lig, colName,w_click_coment.dw_coment.getItemString(lig, colName + "_html"))
		
//		w_click_coment.dw_coment.setItem(lig, colName, string_to_rtf(w_click_coment.dw_coment.getItemString(lig, colName + "_html"), couleur_noire, couleur_blanche))
	end if
end if
end subroutine

