table(column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="coment.code" dbalias=".code" )
 column=(type=date update=yes updatewhereclause=yes name=dat dbname="coment.dat" dbalias=".dat" initial="today" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=ordre dbname="coment.ordre" dbalias=".ordre" )
 column=(type=char(100) update=yes updatewhereclause=yes name=hygiene_v10 dbname="coment.hygiene_v10" dbalias=".hygiene_v10" )
 column=(type=char(100) update=yes updatewhereclause=yes name=elastique_v10 dbname="coment.elastique_v10" dbalias=".elastique_v10" )
 column=(type=char(6) update=yes updatewhereclause=yes name=intervenant dbname="coment.intervenant" dbalias=".intervenant" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="coment.user_modif" dbalias=".user_modif" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_modif dbname="coment.date_modif" dbalias=".date_modif" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com_html dbname="coment.com_html" dbalias=".com_html" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=acte_prevu_html dbname="coment.acte_prevu_html" dbalias=".acte_prevu_html" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com3_html dbname="coment.com3_html" dbalias=".com3_html" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com4_html dbname="coment.com4_html" dbalias=".com4_html" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com5_html dbname="coment.com5_html" dbalias=".com5_html" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com6_html dbname="coment.com6_html" dbalias=".com6_html" )
 column=(type=long updatewhereclause=yes name=ecart_semaine dbname="ecart_semaine" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coment~" ) COLUMN(NAME=~"coment.code~") COLUMN(NAME=~"coment.dat~") COLUMN(NAME=~"coment.ordre~") COLUMN(NAME=~"coment.hygiene_v10~") COLUMN(NAME=~"coment.elastique_v10~") COLUMN(NAME=~"coment.intervenant~") COLUMN(NAME=~"coment.user_modif~") COLUMN(NAME=~"coment.date_modif~") COLUMN(NAME=~"coment.com_html~") COLUMN(NAME=~"coment.acte_prevu_html~") COLUMN(NAME=~"coment.com3_html~") COLUMN(NAME=~"coment.com4_html~") COLUMN(NAME=~"coment.com5_html~") COLUMN(NAME=~"coment.com6_html~") COMPUTE(NAME=~"datediff (week , (select top 1 coment_pas.dat from coment as coment_pas where coment_pas.code = coment.code and coment_pas.dat < coment.dat order by coment_pas.dat desc), coment.dat) as ecart_semaine~")WHERE(    EXP1 =~"~~~"coment~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":v_code~" ) ) ARG(NAME = ~"v_code~" TYPE = number) " update="coment" updatewhere=1 updatekeyinplace=no arguments=(("v_code", number))  sort="dat A ordre A " )
