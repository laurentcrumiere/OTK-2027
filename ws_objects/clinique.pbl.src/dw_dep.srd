 retrieve="  SELECT ~"patient~".~"code~",   
         ~"patient~".~"basal_max_pro~",   
         ~"patient~".~"basal_max_retro~",   
         ~"patient~".~"basal_mand_pro~",   
         ~"patient~".~"basal_mand_retro~",   
         ~"patient~".~"basal_max_endo~",   
         ~"patient~".~"basal_max_exo~",   
         ~"patient~".~"basal_mand_endo~",   
         ~"patient~".~"basal_mand_exo~",   
         ~"patient~".~"hypodivergence~",   
         ~"patient~".~"hyperdivergence~",   
         ~"patient~".~"alveo_max_pro~",   
         ~"patient~".~"alveo_max_retro~",   
         ~"patient~".~"alveo_mand_pro~",   
         ~"patient~".~"alveo_mand_retro~",   
         ~"patient~".~"alveo_max_endo~",   
         ~"patient~".~"alveo_max_exo~",   
         ~"patient~".~"alveo_mand_endo~",   
         ~"patient~".~"alveo_mand_exo~",   
         ~"patient~".~"supraclusion~",   
         ~"patient~".~"infraclusion~",   
         ~"patient~".~"mol_cl1~",   
         ~"patient~".~"mol_cl2~",   
         ~"patient~".~"mol_cl3~",   
         ~"patient~".~"can_cl1~",   
         ~"patient~".~"can_cl2~",   
         ~"patient~".~"can_cl3~",   
         ~"patient~".~"molaire~",   
         ~"patient~".~"canine~",   
         ~"patient~".~"dento_max~",   
         ~"patient~".~"dento_dent~",   
         ~"patient~".~"agenesie~",   
         ~"patient~".~"surnum~",   
         ~"patient~".~"malposition~",   
         ~"patient~".~"occl_dte~",   
         ~"patient~".~"occl_gche~",   
         ~"patient~".~"occl_ant~",   
         ~"patient~".~"facteur~",   
         ~"patient~".~"commentaire~",   
         ~"patient~".~"devis_remis~"   
    FROM ~"patient~"  
   WHERE ~"patient~".~"code~" = :var_code    
" update="patient" updatewhere=0 updatekeyinplace=yes arguments=(("var_code", number)) )
