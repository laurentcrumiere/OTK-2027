 column=(type=decimal(1) update=yes updatewhereclause=yes name=duree_traitement dbname="patient.duree_traitement" dbalias=".duree_traitement" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.duree_traitement_surveillance~") COLUMN(NAME=~"patient.duree_traitement_apres~") COLUMN(NAME=~"patient.fin_traitement_estimee~") COLUMN(NAME=~"patient.qualite_traitement~") COLUMN(NAME=~"patient.motif_fin_traitement~") COLUMN(NAME=~"patient.commentaire_traitement~") COLUMN(NAME=~"patient.fin_traitement~") COLUMN(NAME=~"patient.date_reprise~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.debut_traitement~") COLUMN(NAME=~"patient.duree_traitement_unite~") COLUMN(NAME=~"patient.duree_traitement~")WHERE(    EXP1 =~"~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code~" ) ) ARG(NAME = ~"var_code~" TYPE = number) " update="patient" updatewhere=0 updatekeyinplace=yes arguments=(("var_code", number)) )
