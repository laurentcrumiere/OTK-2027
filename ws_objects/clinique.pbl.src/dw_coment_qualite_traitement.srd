table(column=(type=decimal(0) update=yes updatewhereclause=yes name=duree_traitement_surveillance dbname="patient.duree_traitement_surveillance" dbalias=".duree_traitement_surveillance" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=duree_traitement_apres dbname="patient.duree_traitement_apres" dbalias=".duree_traitement_apres" )
 column=(type=date update=yes updatewhereclause=yes name=fin_traitement_estimee dbname="patient.fin_traitement_estimee" dbalias=".fin_traitement_estimee" )
 column=(type=number update=yes updatewhereclause=yes name=qualite_traitement dbname="patient.qualite_traitement" dbalias=".qualite_traitement" )
