table(column=(type=char(50) updatewhereclause=yes name=nom dbname="patient.nom" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=traitement_effectue dbname="patient.traitement_effectue" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=plan_traitement dbname="patient.plan_traitement" )
 column=(type=number updatewhereclause=yes key=yes identity=yes name=code dbname="patient.code" )
 column=(type=char(1) updatewhereclause=yes name=devis_remis dbname="patient.devis_remis" )
 column=(type=char(1) update=yes updatewhereclause=yes name=plan_imprime dbname="patient.plan_imprime" values="Plan de traitement imprimé (semestre 2 et +)	O/Plan de traitement imprimé (semestre 2 et +)	N" )
