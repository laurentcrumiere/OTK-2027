 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"patient~" ) COLUMN(NAME=~"patient.nom~") COLUMN(NAME=~"patient.traitement_effectue~") COLUMN(NAME=~"patient.plan_traitement~") COLUMN(NAME=~"patient.code~") COLUMN(NAME=~"patient.devis_remis~") COLUMN(NAME=~"patient.plan_imprime~") COLUMN(NAME=~"patient.duree_traitement~") COLUMN(NAME=~"patient.traitement_effectue_html~") COLUMN(NAME=~"patient.plan_traitement_html~") COLUMN(NAME=~"patient.duree_traitement_unite~") COLUMN(NAME=~"patient.extraction~") COLUMN(NAME=~"patient.dents_soins~")WHERE(    EXP1 =~" ~~~"patient~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":var_code ~" ) ) ARG(NAME = ~"var_code~" TYPE = number) " update="patient" updatewhere=2 updatekeyinplace=yes arguments=(("var_code", number)) )
