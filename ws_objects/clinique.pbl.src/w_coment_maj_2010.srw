type pb_courrier from picturebutton within w_coment_maj_2010
integer x = 4160
integer y = 348
integer width = 142
integer height = 124
integer taborder = 70
boolean bringtotop = true
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "lc_docu.png"
string disabledname = "lc_docu.png"
alignment htextalign = left!
string powertiptext = "Lance un aperçu - impression du courrier clinique / Lance un aperçu - email du courrier clinique"
long backcolor = 553648127
end type

event clicked;

if belgique then
	// Hector !!
	
	if dw_patient.rowcount() > 0 then
		//fxg_lancer_prescription_hector(var_code_local, utilisateur_code)
		datawindow dw_null
		fxg_ehealth ("P", var_code_local, dw_null )

	end if
	
else
	// Courrier Word
	uo_lien_word  v_uo_lien_word
	
	v_uo_lien_word = create uo_lien_word
	
	string v_chemin, v_nom
	
	
	string chemin_document_clinique, v_nom_praticien
	
	
	// Document Word en raccourci
	select isnull(chemin_document_clinique, ''), prati.nom into :v_chemin_document_clinique, :v_nom_praticien
	from prati, patient 
	where patient.code_praticien = prati.code and patient.code = :var_code_local ;
	

	v_chemin = gfx_extraire_path_fichier(v_chemin_document_clinique)
	v_nom = gfx_extraire_nom_fichier(v_chemin_document_clinique)
	
	
	// On Gruge pour utiliser le patient coutant
	
	double var_code_sauve
	
	var_code_sauve = var_code
	var_code = var_code_local
	
	if v_uo_lien_word.traiter_avec_word(Service_MajEtVisualise, v_chemin, v_nom, true) <> 1 then
		
		Messagebox("ATTENTION", "Erreur dans la génération du document !")
	end if
	
	var_code = var_code_sauve
	
	destroy v_uo_lien_word
end if
end event

event rbuttondown;

if belgique then
	// Hector !!
	
	if dw_patient.rowcount() > 0 then
		//fxg_lancer_prescription_hector(var_code_local, utilisateur_code)
		datawindow dw_null
		fxg_ehealth ("P", var_code_local, dw_null )
	end if
	
else
	// Courrier Word
	uo_lien_word  v_uo_lien_word
	
	v_uo_lien_word = create uo_lien_word
	
	string v_chemin, v_nom
	
	
	string chemin_document_clinique, v_nom_praticien
	
	
	// Document Word en raccourci
	select isnull(chemin_document_clinique, ''), prati.nom into :v_chemin_document_clinique, :v_nom_praticien
	from prati, patient 
	where patient.code_praticien = prati.code and patient.code = :var_code_local ;
	

	v_chemin = gfx_extraire_path_fichier(v_chemin_document_clinique)
	v_nom = gfx_extraire_nom_fichier(v_chemin_document_clinique)
	
	
	// On Gruge pour utiliser le patient coutant
	
	double var_code_sauve
	
	var_code_sauve = var_code
	var_code = var_code_local
	
	if v_uo_lien_word.traiter_avec_word(Service_MajEtEmail, v_chemin, v_nom, true) <> 1 then
		
		Messagebox("ATTENTION", "Erreur dans la génération du document !")
	end if
	
	var_code = var_code_sauve
	
	destroy v_uo_lien_word
end if
end event

