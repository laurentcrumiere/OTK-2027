pb_7.PowerTipText = tab[7]
pb_8.PowerTipText = tab[8]
pb_9.PowerTipText = tab[9]
pb_10.PowerTipText = tab[10]
pb_11.PowerTipText = tab[11]
pb_12.PowerTipText = tab[12]
pb_13.PowerTipText = tab[13]
pb_14.PowerTipText = tab[14]
pb_15.PowerTipText = tab[15]
pb_16.PowerTipText = tab[16]
pb_17.PowerTipText = tab[17]
