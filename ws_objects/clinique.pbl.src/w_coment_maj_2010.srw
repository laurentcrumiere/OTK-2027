event rbuttondown;long l_cpt 

select count(*) into :l_cpt from message_prochain_rdv ;

if l_cpt > 0 then
	
	
	// depuis 2017, possibilité d'avoir une liiste de messages :  on affiche l'aide les messages
	type_aide = "M"
	afficher_aide_saisie(xpos, ypos)
	

else
	// y a pas de message, on rend invisible ... comme avant 2017

	if this.visible then
		this.visible = false
		dw_qualite.visible = true
	end if
end if

end event

