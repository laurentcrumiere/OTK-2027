// recherche du rdv du jour pour le patient !!
v_code_interne_local = fxg_rdv_pour_commentaire(var_code_local,datetime(today(), now()))

dw_suivi.settransobject(SQLCA)
dw_suivi.retrieve(v_code_interne_local)



end subroutine

public subroutine liste_deroulante (string nom_colonne, datawindow dw);

string rs, filtre
integer ri

// Installe une liste déroulante sur la colonne N° x

dw.Modify( nom_colonne + ".dddw.Name='dw_clinique_listes_deroulantes_ddlb'" )
dw.Modify( nom_colonne + ".dddw.DataColumn='libelle'")
dw.Modify( nom_colonne + ".dddw.DisplayColumn='libelle' ")
dw.Modify( nom_colonne + ".dddw.AllowEdit='yes' ")
dw.Modify( nom_colonne + ".height.autosize = 'yes'")

// Actualisation de la dddw
DataWindowChild dw_fille
dw.GetChild(nom_colonne, dw_fille) 
dw_fille.settransobject(sqlca)
dw_fille.retrieve()

// Les colonnes sont sous la forme com3_html, les options dans la table sont com3
filtre =  left(nom_colonne, 4) + " = 'O'"

ri = dw_fille.Setfilter( filtre )
ri = dw_fille.filter()

end subroutine

public subroutine saisie_modif_a_part (boolean v_visible);// on passe en mode saisie à part
mode_saisie_modif_a_part = v_visible
dw_ligne.visible = v_visible

if v_visible then
	dw_coment.height = dw_coment.height - dw_ligne.height
else
	dw_coment.height = dw_coment.height + dw_ligne.height
end if

// on vire ceratains boutons
cb_ajouter.visible = not v_visible
cb_supprimer.visible = not v_visible
if stock then
	cb_tracabilite.visible = not v_visible
end if
cb_imprimer.visible = not v_visible
cb_rdv.visible = not v_visible
cb_dates.visible = not v_visible
cb_diag.visible = not v_visible
cb_photos.visible = not v_visible
cb_qualite.visible = not v_visible
pb_bis.visible = not v_visible
if VIDEO or WAIT_AND_SMILE then
	cb_annonce.visible = not v_visible
end if


if not enregistrement_automatique then
	cb_enregistrer.visible = not v_visible
	cb_annuler.visible = not v_visible
else
	cb_rafraichir.visible = not v_visible
end if

// Boutons pour ajout / modif de ligne à part
cb_enregistrer_a_part.visible= v_visible
cb_annuler_a_part.visible= v_visible

positionnement_dw()

end subroutine

public function string recherche_acte_prevu ();string acte = ""
long ligne, tot
long cpt_rdv_honore = 0
date v_date_rdv

// Recherche dans la ligne la plus récente
if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","ordre_tri","D") = "D" then
	// Décroissant
	ligne  = dw_coment.find("dat < date('"+string(today())+"')", 999999, 1)

	// On prend le dernier acte prevu trouvé .. sauf si aucun acte prevu au dernier rdv_honoré
	do while ligne > 0 and cpt_rdv_honore = 0 and acte = ""
		v_date_rdv = dw_coment.GetItemDate(ligne, "dat") 
		select isnull(count(*),0) into :cpt_rdv_honore from rdv, etat_rdv where cast (rdv.rdv as date)  = :v_date_rdv and 
		rdv.code = :var_code_local and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' ;
		if cpt_rdv_honore > 0 then 
			acte = string_non_nulle( dw_coment.getitemstring(ligne,"acte_prevu_html"))
		else
			if acte = "" then 
				acte = string_non_nulle( dw_coment.getitemstring(ligne,"acte_prevu_html"))
			end if
		end if
		ligne = ligne - 1 
	loop 

else
	// Croissant
	ligne  = dw_coment.find("dat < date('"+string(today())+"')", 1, 999999)
	if ligne > 0 then 
		tot = dw_coment.rowcount()

		// On prend le dernier acte prevu trouvé .. sauf si aucun acte prevu au dernier rdv_honoré
		do while ligne <= tot and cpt_rdv_honore = 0 and acte = ""
			v_date_rdv = dw_coment.GetItemDate(ligne, "dat") 
			select isnull(count(*),0) into :cpt_rdv_honore from rdv, etat_rdv where cast (rdv.rdv as date)  = :v_date_rdv and 
			rdv.code = :var_code_local and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' ;
			if cpt_rdv_honore > 0 then 
				acte = dw_coment.getitemstring(ligne,"acte_prevu_html")
			else
				if acte = "" then 
					acte = string_non_nulle( dw_coment.getitemstring(ligne,"acte_prevu_html"))
				end if
			end if
			ligne = ligne + 1 
		loop 
	end if

end if

if isnull(acte) then acte = ""

return acte

end function

public subroutine saisie_modif_a_part_a_part (string v_quoi);// Saisie modif dans une fenêtre a part - formulaire

cb_enregistrer.triggerevent(clicked!)
str_coment v_coment
long lig

if v_quoi = "A" then
	// C'est un ajout	
	v_coment.code = var_code_local
	v_coment.ordre = dw_coment.rowcount() + 1
	v_coment.date_modif = datetime (today(), now())
	v_coment.com_html = recherche_acte_prevu()
	v_coment.code_interne_rdv = v_code_interne_local

else
	// C'est une modif
		lig = dw_coment.getrow()
		v_coment.code = var_code_local
		v_coment.ordre = dw_coment.getItemNumber(lig, "ordre")
		v_coment.date_modif = dw_coment.getItemDateTime(lig, "date_modif")
end if

v_coment.avec_rtf = false

// colonnes visibles ou pas ... 
if dw_coment.object.intervenant.visible  = '1' then
	v_coment.intervenant_visible = true
else
	v_coment.intervenant_visible = false
end if
if dw_coment.object.hygiene_v10.visible  = '1' then
	v_coment.hygiene_visible = true
else
	v_coment.hygiene_visible = false
end if
if dw_coment.object.elastique_v10.visible  = '1' then
	v_coment.elastique_visible = true
else
	v_coment.elastique_visible = false
end if

if dw_coment.object.com3_html.visible  = '1' then
	v_coment.com3_visible = true
else
	v_coment.com3_visible = false
end if
if dw_coment.object.com4_html.visible  = '1' then
	v_coment.com4_visible = true
else
	v_coment.com4_visible = false
end if
if dw_coment.object.com5_html.visible  = '1' then
	v_coment.com5_visible = true
else
	v_coment.com5_visible = false
end if
if dw_coment.object.com6_html.visible  = '1' then
	v_coment.com6_visible = true
else
	v_coment.com6_visible = false
end if

openwithparm(w_coment_saisie_a_part, v_coment)


cb_rafraichir.triggerevent(clicked!)
end subroutine

public subroutine rdv_du_jour (datawindow dw, long lig);// recherche si un rdv ce jour pour mettre l'acte par défaut
// idem w_coment_maj
if nom_datawindow = "dw_coment_maj_2010" then
	string v_rdv 

	select min( left( isnull(symbole,'')+replicate(' ',40)      , 40) + left(  isnull(type_rdv.couleur,'')+replicate(' ',40)   , 40) )    into :v_rdv  
	from rdv, type_rdv, etat_rdv 
	where code_interne = :v_code_interne_local and rdv."type" = type_rdv.code  ;   
	
	if not isnull(v_rdv) then
		dw.setitem(lig,"rdv",v_rdv)
		dw.setitem(lig,"code_interne_rdv",v_code_interne_local)
	end if
	
	
	
	
	dw.SetFocus()
end if

end subroutine

public subroutine ajouter_commentaire_predefini (boolean b_avec_ajout);

// Ajout du commentaire qui est dans le MLE
long lig
string s_texte_non_nul

if len(trim(mle_commentaire.text)) > 0 then

	// Ajout de la ligne
	param_win [1] = ""
	param_win [2] = ""
	
	if (b_avec_ajout or (not b_avec_ajout and dw_coment.rowcount() = 0)) and not mode_saisie_modif_a_part  then
		
	
		// On vérifier d'abors si pas une ligne déja ajoutée à cette date et vierge de commentaire ... si c'est le cas, pas d'ajout
		if dw_coment.getrow() > 0 then 
			if dw_coment.getitemDate(dw_coment.getrow(), "dat") = today() and trim(dw_coment.getitemString(dw_coment.getrow(), "com_html")) = "" then 
				// pas d'ajout
			else
				cb_ajouter.triggerEvent(clicked!)
			end if
		else
			cb_ajouter.triggerEvent(clicked!)
		end if
		

	end if
	
	if mode_saisie_modif_a_part then
		
		dw_ligne.AcceptText()
		
		// recopie des infos du mle si on est en ajout
		if b_avec_ajout then
			dw_ligne.setitem(1,"coul_texte",double(mle_commentaire.TextColor))
			dw_ligne.setitem(1,"coul_fond",double(mle_commentaire.BackColor))
		end if
		if b_avec_ajout then
			// C'est une nouvelle ligne
			dw_ligne.setitem(1,"com_html",mle_commentaire.text)
		else
			// C'est une ligne existante
			dw_ligne.accepttext()
			s_texte_non_nul = string_non_nulle ( dw_ligne.GetitemString (1,"com_html") )
			dw_ligne.setitem(1,"com_html",  s_texte_non_nul +  mle_commentaire.text)
		end if
		
		cb_annuler_predefini.triggerEvent(clicked!)
		
		dw_ligne.setColumn("com_html")
		
		// pour mettre le point d'insertion à la fin
		dw_ligne.SelectText(len(dw_ligne.GetText()) + 1, 0)
		
	else
		// Mode normal  / Pas saisie à part !
		dw_coment.AcceptText()
		
		if b_avec_ajout then
			// Quelle la ligne ajoutée
			
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","ordre_tri","D") = "D" then
				// Décroissant => Ajout à la fin
				lig = dw_coment.rowcount()
			else
				// Croissant => Insertion au début
				lig  = 1
			end if
		else
			// on reste sur la liste courante !!
			lig = dw_coment.getrow()
		end if
		// recopie des infos du mle si on est en ajout
		if b_avec_ajout then
			dw_coment.setitem(lig,"coul_texte",double(mle_commentaire.TextColor))
			dw_coment.setitem(lig,"coul_fond",double(mle_commentaire.BackColor))
		end if
		if b_avec_ajout then
			// C'est une nouvelle ligne
			dw_coment.setitem(lig,"com_html",mle_commentaire.text)
		else
			// C'est une ligne existante
			s_texte_non_nul = string_non_nulle ( dw_coment.GetitemString (lig ,"com_html") )
			dw_coment.setitem(lig,"com_html",  s_texte_non_nul +  mle_commentaire.text)
		end if
		
		cb_annuler_predefini.triggerEvent(clicked!)
		dw_coment.setColumn("com_html")
		// pour mettre le point d'insertion à la fin
		dw_coment.SelectText(len(dw_coment.GetText()) + 1, 0)
	end if
end if

end subroutine

public subroutine ajouter_acte_prevu (boolean b_avec_ajout);string s_texte_non_nul 


// Mise en place de l'acte prévue sur le commentaire de la date du jour s'il existe !!


if len(trim(mle_commentaire.text)) > 0 then

	long cptlig, nblig ,lig
	
	// recherche de la date
	
	if b_avec_ajout then
		// ATTENTION , On met un for beacause, sans comprendre pouquoi, 
		// le find ci dessous ne marche pas (renvoie toujours 0)
		nblig = dw_coment.Rowcount()
		for cptlig = nblig to 1 step -1
			
			if today() = dw_coment.getItemDate(cptlig, "dat") then
				lig = cptlig
				// pour quitter de suite
				cptlig = 0
			end if
			
		next
	else
		lig = dw_coment.getrow()
	end if
	
	
	
	//lig = dw_coment.find("dat >= today()",1,9999999) 
	
	if lig = 0 then 
		// pas de commentaire "encore"  à ce jour
		
		// Ajout d'un commentaire "vierge"
		cb_ajouter.triggerEvent(clicked!)
		
		if mode_saisie_modif_a_part then
			if b_avec_ajout then 
				dw_ligne.setitem(1,"coul_texte",double(mle_commentaire.TextColor))
				dw_ligne.setitem(1,"coul_fond",double(mle_commentaire.BackColor))
				dw_ligne.setitem(1,"com_html"," ")
			end if
		else
			if b_avec_ajout then
				if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","ordre_tri","D") = "D" then
					// Décroissant => Ajout à la fin
					lig = dw_coment.rowcount()
				else
					// Croissant => Insertion au début
					lig  = 1
				end if
				dw_coment.setitem(lig,"coul_texte",double(mle_commentaire.TextColor))
				dw_coment.setitem(lig,"coul_fond",double(mle_commentaire.BackColor))
				dw_coment.setitem(lig,"com_html"," ")
			else
				lig = dw_coment.getrow()
			end if

		end if
	else
		// lig >  .. on passe en mode modif si modif à part
		dw_coment.setrow(lig)
		//modifier_ligne()


	end if
	
	
	// recopie des infos du mle
	
	if mode_saisie_modif_a_part then
		
		if b_avec_ajout then
			// C'est une nouvelle ligne
			dw_ligne.setitem(1,"acte_prevu_html",mle_commentaire.text)
		else
			// C'est une ligne existante
			dw_ligne.accepttext()
			s_texte_non_nul = string_non_nulle ( dw_ligne.GetitemString (1 ,"acte_prevu_html") )
			dw_ligne.setitem(1,"acte_prevu_html",  s_texte_non_nul +  mle_commentaire.text)
		end if

		cb_annuler_predefini.triggerEvent(clicked!)
		
		dw_ligne.setColumn("acte_prevu_html")
	
		// pour mettre le point d'insertion à la fin
		dw_ligne.SelectText(len(dw_ligne.GetText()) + 1, 0)
	else
		if b_avec_ajout then
			// C'est une nouvelle ligne
			dw_coment.setitem(lig,"acte_prevu_html",mle_commentaire.text)
		else
			// C'est une ligne existante
			s_texte_non_nul = string_non_nulle ( dw_ligne.GetitemString (lig ,"acte_prevu_html") )
			dw_coment.setitem(lig,"acte_prevu_html",  s_texte_non_nul +  mle_commentaire.text)
		end if

		cb_annuler_predefini.triggerEvent(clicked!)
		
		dw_coment.setColumn("acte_prevu_html")
	
		// pour mettre le point d'insertion à la fin
		dw_coment.SelectText(len(dw_coment.GetText()) + 1, 0)
	end if

end if
end subroutine

public subroutine modifier_ligne ();long lig, v_ordre
datetime v_date_modif



	// On clique ailleurs => modif ou autre
	
	if saisie_modif_a_part = "M" then
		
		if dw_coment.rowcount() > 0 and not mode_saisie_modif_a_part then
			
			lig = dw_coment.getrow()
			v_ordre = dw_coment.getItemNumber(lig, "ordre")
			v_date_modif = dw_coment.getItemDateTime(lig, "date_modif")

			if enregistrement_automatique then
				cb_enregistrer.triggerevent(clicked!)
			end if
			
			dw_ligne.retrieve(var_code_local)
			dw_ligne.setfilter("ordre = "+string(v_ordre) + " and string(date_modif) = '" + string(v_date_modif)+"'")
			dw_ligne.filter()
			
			saisie_modif_a_part(true)
		end if
		
	else
		if dw_coment.rowcount() > 0  and saisie_modif_a_part = "A" then
			// Modif dans une fenetre a part
			saisie_modif_a_part_a_part("M")
		else
			
			// pour lancement de la tracabilité à une date donnée
			
			if stock then
				
				//opensheet(w_fiche_traca,w_mdi,0,layered!)
				if dw_coment.rowcount() > 0 then
					
			
					// On regarde sur quoi à double cliqué le user
					
					string ls_col, ls_col_total
					integer li_pos
				
					
					/*******************************************************/
					/* Donne le nom de l'objet cliqué sous la forme nom + tabultaion + N° de ligne     */
					/*******************************************************/
					
					ls_col_total = dw_coment.GetObjectAtPointer()
				
				
					/*******************************************************/
					/* On isole ce qui est avant la tabulation						 */
					/*******************************************************/
					li_pos = Pos(ls_col_total, "~t")
				
					/*******************************************************/
					/* Check last 2 characters 									 */
					/*******************************************************/
					ls_col = Left(ls_col_total, li_pos - 1)
					
					
					if ls_col = "tracabilite" then 
						
						// On est sur la bonne colonne => faut déduite la ligne
						lig = long( mid ( ls_col_total, li_pos + 1 , len(ls_col_total) - (li_pos + 1) + 1    )   )
						
						//On enregistre le commentaire clinique avant
						if dw_coment.update() = 1 then
							commit ;
						else
							rollback ;
						end if
						str_traca struct
						struct.date_rdv = dw_coment.getitemdate(lig,"dat")
						struct.code_patient = dw_coment.getitemnumber(lig,"code")
						struct.code_praticien = dw_patient.getitemstring(lig,"code_praticien")
						OpenWithParm(w_tracabilite_fiche,struct)
						
						
						// pour remettre à jour le symbole "T" en premiere colonne
						dw_coment.retrieve(var_code_local) ;
						dw_coment.Scrolltorow(9999)
						dw_coment.setfocus()
					end if
				end if
				
			end if
		end if
	end if

end subroutine

public subroutine afficher_aide_saisie (integer x_pos, integer y_pos);
string s_premier, s_second 

dw_aide.visible = false
dw_aide.reset()
//colore_datawindow(dw_aide)
s_premier = left(type_aide, 1)


choose case s_premier
	case 'M'
		// Messages prochains rdv
		dw_aide.title = "Messages Prochain Rendez-vous"
		dw_aide.dataobject = "dw_message_prochain_rdv_affichage"
		dw_aide.width = 1536
		dw_aide.height = 1612
		dw_aide.x = dw_patient_prochain_rdv_message.x - dw_aide.width - 100
		dw_aide.y = dw_patient_prochain_rdv_message.y
	case 'P'
		// Plan de traitement
		dw_aide.title = "Plans de Traitement"
		dw_aide.dataobject = "dw_plan_ttt_affichage"
		dw_aide.width = 1616
		dw_aide.height = 1992
		dw_aide.x = x_pos + 500
		dw_aide.y = y_pos
	case 'D'
		// Plan de traitement
		dw_aide.title = "Diagnostics"
		dw_aide.dataobject = "dw_diagnostic_affichage"
		dw_aide.width = 1696
		dw_aide.height = 1992
		dw_aide.x = x_pos + 500
		dw_aide.y = y_pos
		
	case 'R'
		dw_aide.title = "Prochaine Rendez-vous du Patient"
		dw_aide.dataobject = "dw_rdv_futurs"
		dw_aide.width = 2682
		dw_aide.height = 628
		dw_aide.x = 18
		dw_aide.y = 200
		
		
end choose


dw_aide.setTransObject(sqlca)

if s_premier  = "D" and len(type_aide) = 2 then
	// il faut appliquer des filtre
	s_second = right(type_aide,1)
	choose case s_second
		case "A"
			dw_aide.title = "Diagnostics Alvéolaires"
		case "S"
			dw_aide.title = "Diagnostics Squelettiques"
		case "F"
			dw_aide.title = "Diagnostics Fonctionnels"
		case "D"
			dw_aide.title = "Diagnostics Dentaires"
			
	end choose
	dw_aide.SetFilter("type_diag = '" + s_second + "'")
end if

if  s_premier = 'R'  then
	dw_aide.retrieve(var_code_local)
else
	dw_aide.retrieve()
end if
dw_aide.visible = true
dw_aide.setfocus()
end subroutine

public subroutine charger_image_gearbox (integer v_numero_cadre);// Mets la photo d'une image cliquée (droit ou gauche) dans la gearbox de travail
gb_tempo.fichier_photo = uoi[v_numero_cadre].nom_fichier_complet 
gb_tempo.nom_cadre_ole =uoi[v_numero_cadre].nom_cadre_ole
gb_tempo.var_num_dossier =	uoi[v_numero_cadre].var_code_local
gb_tempo.fichier_vignette = uoi[v_numero_cadre].nom_fichier_vignette_complet
gb_tempo.numero_cadre_uo_image = v_numero_cadre
gb_tempo.type_cadre = 3


gb_tempo.charger_image()

end subroutine

event open;call super::open;
// On passe en paramètre si on veut un resize automatique ou pas
// OUI en mode normal
// NON en mode MDI patient pour éciter 3 Resize


integer num_cadre
string  nom_cadre, nom_cadre_humain
string v_fichier_image



Try 

	Trace ("==== OUVERTURE COMMENTAIRES CLINIQUES 2010 ====")

	// Désactivation des saisies suggérées ?
	if profilestring(dir_ini+inifile_orthokis,"recherche","desactiver_saisies_suggerees","N") = "O" then
	
		dw_patient.Object.code_correspondant.dddw.AllowEdit = 'No'
		dw_patient.Object.code_dentiste.dddw.AllowEdit = 'No'
		dw_patient.Object.type_dossier.dddw.AllowEdit = 'No'
		dw_patient.Object.ecole.dddw.AllowEdit = 'No'
		dw_patient.Object.prochain_rdv.dddw.AllowEdit = 'No'
		dw_patient.Object.prochain_rdv_serie.dddw.AllowEdit = 'No'

		dw_suivi.Object.user_suivi_clinique.dddw.AllowEdit = 'No'
	end if



	// Patient courant
	var_code_local = var_code
	var_nom_local = var_nom
	var_numero_dossier_local = var_numero_dossier
	
	
	resize_automatique = integer(param_win[1])
	
	open(w_patience_locale)
	
	w_patience_locale.Wf_SetValue(0)

	// raprochement rendez-vous <-> commentaires 
	maj_code_rdv_dans_commentaires(var_code_local)
	
	w_patience_locale.Wf_SetValue(10)

	// utilie pour la gestion des images 2013
	choix_image_2013 = create uo_choix_image_2013
	
	// COMMENTAIRES CLINIQUES SPECIAUX
	// RECHERCHE DE LA DATAWINDOWS SPECIFIQUE DES COMMENTAIRES SI BESOIN
	
	nom_datawindow = commentaires_cliniques_datawindow(serial)
	
	
	trace("Nom de la datawindow des commentairaires : " +nom_datawindow  )
	// Lecture des options de présentations
	

	// Pour les s de traitement multiples ou non
	if SERIAL = "87669" then  // SPECIAL ERASME
		//  Dw sans autoresize
		Setprofilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","plans_mutiples","N")
		Setprofilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","diag_non_rtf","O")
		Setprofilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","avec_diag","O")
		//dw_diagnostic.dataobject = "dw_diag_erasme"
		dw_diagnostic.dataobject = "dw_diag_html"
		dw_diagnostic.object.traitement_effectue_html.Height.Autosize = "No"
		dw_diagnostic.object.plan_traitement_html.Height.Autosize = "No"
		
		date v_date_naissance 
		select date_naissance into :v_date_naissance from patient where code = :var_code_local ;
		// age 
		st_erasme_age.text = calcul_age(string(v_date_naissance))
		// somme due
		st_erasme_du.text = string(due(var_code_local, today()))
	else
			
	
		if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","plans_mutiples","N") = "O" then
			dw_diagnostic.dataobject = "dw_diag_bis"
	
		else
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","diag_non_rtf","N") = "O" then
				dw_diagnostic.dataobject = "dw_diag_html"
				dw_diagnostic.height = 652
			else
				dw_diagnostic.dataobject = "dw_diag"
				dw_diagnostic.height = 652
			end if
		end if
	end if

	// zone remarques en rtf ou pas
	if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","remarques_sans_rtf","N") = "O" then 
		dw_patient.object.remarques_cliniques_html.visible = true
		dw_patient.object.remarques_html.visible = true
	else
		dw_patient.object.remarques_cliniques.visible = true
		dw_patient.object.remarques.visible = true
	end if


	if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","avec_diag","N") = "O" then
		avec_diag = true
	else
		avec_diag = false
	end if
	
	saisie_modif_a_part = profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","saisie_modif_a_part","N")
	
	if stock then
		cb_tracabilite.visible = true
		if nom_datawindow = "dw_coment_maj_2010" then
			dw_coment.Object.tracabilite.visible = true
		end if
	else
		cb_tracabilite.visible = false
		if nom_datawindow = "dw_coment_maj_2010" then
			dw_coment.Object.tracabilite.visible = false
		end if
	end if

	
	dw_ligne.settransobject(sqlca)

	if trace then trace ("w_coment_maj_2010 - Open 2")
		
	largeur_dw_coment	= dw_coment.width
	
	// Annonce vidéo en salle d'attente
	if VIDEO then
		cb_annonce.text = ""
		cb_annonce.width = 150
		cb_annonce.iconname = "lc_annoncer.png"
