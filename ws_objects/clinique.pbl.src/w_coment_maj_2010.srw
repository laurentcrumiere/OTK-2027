event clicked;reset(lb_liste)
integer cpt

FOR cpt=1 TO 20
	if len(trim(tab[cpt])) > 0 then
		lb_liste.additem(string(cpt,'00')+" -> "+tab[cpt])
	end if
NEXT

lb_liste.visible = true
end event

