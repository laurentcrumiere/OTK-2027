type cb_enregistrer_a_part from uo_picturebutton_390x120 within w_coment_maj_2010
boolean visible = false
integer x = 1998
integer y = 2500
integer width = 453
integer taborder = 60
boolean bringtotop = true
string text = "&Enregistrer"
string iconname = "ACTIONS_enregistrer.png"
end type

event clicked;call super::clicked;dw_ligne.accepttext()

// Histoire de sécuriser  / Surtout si enregistrement automatique
if dw_ligne.rowcount() > 0 then
	
	long v_coul_texte, v_coul_fond
	
	// Mise à jour des colonnes rtf
	
	v_coul_texte = dw_ligne.getitemNumber(1, "coul_texte")
	v_coul_fond = dw_ligne.getitemNumber(1, "coul_fond")
	
	// Le champ a été a été ajoutée ou modifiée
	if dw_ligne.GetItemStatus (1, 'com_html', Primary!) <> NotModified! then
		dw_ligne.setItem(1, "com", String_To_RTF(dw_ligne.getitemString(1, "com_html"), v_coul_texte, v_coul_fond))
	end if
	
	if dw_ligne.GetItemStatus (1, 'acte_prevu_html', Primary!) <> NotModified! then
		dw_ligne.setItem(1, "acte_prevu", String_To_RTF(dw_ligne.getitemString(1, "acte_prevu_html"),  v_coul_texte, v_coul_fond))
	end if
	
	if nom_datawindow = "dw_ligne_maj_2010" then			// Commentaires non spécifiques !!
	
		if dw_ligne.GetItemStatus (1, 'com3_html', Primary!) <> NotModified! then
			dw_ligne.setItem(1, "com3", String_To_RTF(dw_ligne.getitemString(1, "com3_html"),  v_coul_texte, v_coul_fond))
		end if
		if dw_ligne.GetItemStatus (1, 'com4_html', Primary!) <> NotModified! then
			dw_ligne.setItem(1, "com4", String_To_RTF(dw_ligne.getitemString(1, "com4_html"),  v_coul_texte, v_coul_fond))
		end if
		if dw_ligne.GetItemStatus (1, 'com5_html', Primary!) <> NotModified! then
			dw_ligne.setItem(1, "com5", String_To_RTF(dw_ligne.getitemString(1, "com5_html"),  v_coul_texte, v_coul_fond))
		end if
		if dw_ligne.GetItemStatus (1, 'com6_html', Primary!) <> NotModified! then
			dw_ligne.setItem(1, "com6", String_To_RTF(dw_ligne.getitemString(1, "com6_html"),  v_coul_texte, v_coul_fond))
		end if
	end if
	
	
	if dw_ligne.update() = 1 then
		commit ; 
		dw_coment.retrieve(var_code_local)
		positionnement_dw()
	else
		Messagebox("ATTENTION", "Erreur dans la saisie du commentaire.~n~n"+ sqlca.sqlerrtext)
		rollback ;
	end if
	
	// Elimination du filtre éventuel de la modif
	dw_ligne.setfilter("")
	dw_ligne.filter()
	
	saisie_modif_a_part(false)
end if
end event

