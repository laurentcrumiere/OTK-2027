public subroutine ajapdef (integer num);// Ajout d'un acte prévu prédéfini
// Si l'acte prédéfini existe, si la ligne est sélectionnée, si on n'a pas rentré d'acte 
//     pour cette ligne
// sinon on a des messages pour avertir l'utilisateur

string acte

if tabap[num] <> "" then
	if saisie_modif_a_part = "M" then
		if not mode_saisie_modif_a_part then
			cb_ajouter.triggerevent(clicked!)
		end if
		
		if serial = "87008" then
			// Spécial MALINS
			acte = dw_coment.getitemstring( dw_coment.getrow(), "com4_html") 
		else
			acte = dw_coment.getitemstring( dw_coment.getrow(), "acte_prevu_html") 
		end if
	
		IF acte = "" OR IsNull (acte) THEN
			
			if serial = "87008" then
				// Spécial MALINS
				dw_ligne.setitem(dw_ligne.rowcount(),"com_html"," ")
				dw_ligne.setitem(dw_ligne.getrow(),"com4_html",tabap[num])
			else
				dw_ligne.setitem(dw_ligne.getrow(),"acte_prevu_html",tabap[num])
			end if
		
			
			if enregistrement_automatique then
				cb_enregistrer.triggerevent(clicked!)
			end if
			dw_ligne.SetFocus()
		end if
		
	else
	
		
		
		IF dw_coment.getRow() <>  0 THEN
			if serial = "87008" then
				// Spécial MALINS
				acte = dw_coment.getitemstring( dw_coment.getrow(), "com4_html") 
			else
				acte = dw_coment.getitemstring( dw_coment.getrow(), "acte_prevu_html") 
			end if
			
			IF trim(acte) = "" OR IsNull (acte) THEN
				if serial = "87008" then
					// Spécial MALINS
					dw_coment.setitem(dw_coment.rowcount(),"com_html"," ")
					dw_coment.setitem(dw_coment.getrow(),"com4_html",tabap[num])
				else
					dw_coment.setitem(dw_coment.getrow(),"acte_prevu_html",tabap[num])
				end if
				if enregistrement_automatique then
					cb_enregistrer.triggerevent(clicked!)
				end if
				dw_coment.SetFocus()
			ELSE
				MessageBox("ATTENTION !","L'acte prévu existe déjà ! " + "~r" + "~n" + acte)
			END IF	
		ELSE			
			MessageBox("ATTENTION !","Vous n'avez pas sélectionné la ligne pour insérer votre acte prévu ou il n'existe pas de commentaire associé ! " )	
		END IF
	end if
else
	MessageBox("ATTENTION !","L'acte prévu N°"+string(num)+" est vierge !")
end if


end subroutine

public subroutine maj_couleur (datawindow dw);

// Mise à jour de la couleur de la qualité du traitement

if dw.rowcount() > 0 then
	// En principe pas possible mais 
	
	long v_code_qualite
	long v_couleur
	
	string rc
	
	v_code_qualite = dw.getitemnumber(dw.getrow(),"qualite_traitement")
	
	if isnull(v_code_qualite) then
		dw.modify ("t_couleur.text = '?????''")
	else
		select couleur into :v_couleur from qualite_traitement where code = :v_code_qualite;
		dw.modify ("t_couleur.text = '''")
		dw.modify ("t_couleur.background.color = '"+string(v_couleur)+"'")
	end if
	

	
end if
end subroutine

public subroutine maj_dates (datawindow dw);

// mise à jour des dates en auto 


dw.accepttext()


date v_debut, v_reprise, v_fin_estimee, v_fin_reelle

long  duree1
integer duree2, duree3


if dw.rowcount() > 0 then
	
	v_debut = dw.getitemdate(dw.getrow(),"debut_traitement")
	v_reprise = dw.getitemdate(dw.getrow(),"date_reprise")
	v_fin_reelle = dw.getitemdate(dw.getrow(),"fin_traitement")
	
	duree1 = dw.getitemnumber(dw.getrow(),"duree_traitement")
	duree2 = dw.getitemnumber(dw.getrow(),"duree_traitement_surveillance")
	duree3 = dw.getitemnumber(dw.getrow(),"duree_traitement_apres")
	
	zerol(duree1)
	zeroi(duree2)
	zeroi(duree3)
	
	
	
	if not isnull(v_debut) and duree1 + duree2 + duree3 > 0 then
		
		if not isnull(v_reprise) then
			v_fin_estimee = ajout_x_mois ( v_reprise , duree3 * 6)
		else
			v_fin_estimee = ajout_x_mois ( v_debut , (duree1 + duree2) * 6)
		end if
	
	
	
		dw.setitem(dw.getrow(),"fin_traitement_estimee",v_fin_estimee)
		
		
		
		
		long v_ecart
		long v_couleur
		
		string rc
		
		// On ne prend pas écart dans la dw because pas encore mise à jour
		//v_ecart = dw.getitemnumber(dw.getrow(),"ecart")
		v_ecart = daysafter( v_fin_estimee ,  v_fin_reelle ) 
		declare cur cursor for select couleur  from respect_delai_traitement where jours_ecart > :v_ecart order by jours_ecart asc  ;
		
		
		open cur ;
		fetch cur into :v_couleur ;
		close cur ;
		
		dw.modify ("t_couleur_respect.text = '''")
		dw.modify ("t_couleur_respect.background.color = '"+string(v_couleur)+"'")
	

	else
		setnull(v_fin_estimee)
		dw.modify ("t_couleur_respect.text = '?????''")
	end if

	
	
	
end if

end subroutine

public subroutine positionnement_dw ();// positionnnement de la DataWindow

// Y a t il des commentaires saisis par avance ....


long lig


if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","ordre_tri","D") = "C" then
	// Ordre Croissant
	
	lig = dw_coment.find("dat > today()" , 1,99999 )
	
	if lig > 1 and dw_coment.rowcount() >= 2  then 
		dw_coment.Scrolltorow(lig + 1)
		dw_coment.Setrow( lig + 1)
	else
		if dw_coment.rowcount() > 0 then
			dw_coment.Scrolltorow( 1 )
			dw_coment.Setrow(1 )
		end if
	end if
	
	
else
	// Ordre Décroissant (normal)
	
	lig = dw_coment.find("dat > today()" , 1,99999 )
	
	if lig > 1 then 
		dw_coment.Scrolltorow(lig - 1)
		dw_coment.Setrow( lig - 1)
	else
		dw_coment.Scrolltorow( dw_coment.rowcount() )
		dw_coment.Setrow( dw_coment.rowcount() )
	end if
		
	
end if

if nom_datawindow = "dw_coment_maj_2010" then
	// commentaires non spécifiques
 	if serial = "87388" then
		 dw_coment.setColumn("dat")
	else
		 dw_coment.setColumn("com_html")
	end if
	 
end if

dw_coment.setfocus()

return


end subroutine

