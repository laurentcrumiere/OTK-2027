type cb_photos from uo_picturebutton_390x120 within w_coment_maj_2010
integer x = 2359
integer y = 2500
integer width = 238
integer taborder = 30
string text = "&Clin"
string tiptext = "Pages cliniques"
end type

event clicked;call super::clicked;window	W_photos
window	w_presentation
String	page_photos
string	page_presentation
long 	dernier_carac, avant_dernier_carac, nbr_total_carac
str_param_string param_passe  


if profilestring(dir_ini+inifile_orthokis,"Clinique","assistant","N") = "O" then
	
	// Assistant diagnostoc
	
	w_mdi_patient w_mdi_patient_instance
	w_mdi_patient_instance = parent.ParentWindow()
	w_mdi_patient_instance.ouvre_partie(10.5)

else
	
	// page clinique
	
	
	page_photos = profilestring(dir_ini+inifile_orthokis,"photos","page_clinique","w_diagnos_maj_photos")
	
	if isnull(page_photos) or page_photos = '' then
		Messagebox("ATTENTION","Aucune page n'est renseignée dans les paramètres du poste de travail !~n~nPour définir cette page, vous devez contacter ARAKIS",Exclamation!)
	else
		// on a bien récup le nom d'une page
		nbr_total_carac = len (page_photos)
		dernier_carac = long (mid (page_photos, nbr_total_carac, 1))	//long(right(page_photos, 1))
		avant_dernier_carac = long (mid (page_photos, nbr_total_carac -1, 1))
		// selon un choix définit ds opts poste de travail onglet divers
		if ProfileString( dir_ini + inifile_orthokis, "photos", "page_clinique_presentation", oui ) = oui then
			if dernier_carac <> 0 then
				// si le dernier carac du nom de la page est un chiffre
				
				if avant_dernier_carac <> 0 then
				// si les 2 derniers carac forme un nombre
				// on suppose que personne aura plus de 99 page cliniques perso !
					page_presentation = left(page_photos, len(page_photos) -2)
					
				else
				// juste 1 carac
					page_presentation = left(page_photos, len(page_photos) -1)
				end if
				
				// on ouvre la page de présentation clinique
				w_mdi_2020.uo_powerdock.of_openDocument(w_presentation, page_presentation , "Pages Cliniques", "lc_clinique.png")
				
				// selon un choix définit ds opts poste de travail onglet divers
				//if ProfileString( dir_ini + inifile_orthokis, "photos", "page_clinique_presentation", oui ) = non then close(w_presentation)
			end if
		end if
		// on ouvre la page clinique en racourci
		//param_passe.param = string(var_code_local)
		//w_mdi_2020.uo_powerdock.of_openDocument(W_photos, page_photos, param_passe, "Pages Cliniques", "lc_clinique.png")
		OpenWithParm(W_photos,var_code_local,page_photos,w_mdi_2020 )

		
	end if
end if

end event

type cb_enregistrer from uo_picturebutton_390x120 within w_coment_maj_2010
integer x = 4233
integer y = 2500
integer width = 462
integer taborder = 50
string text = "&Enregistrer"
string iconname = "ACTIONS_enregistrer.png"
end type

event clicked;call super::clicked;
// permet de gérer les TriggerEvent et interdiction de MAJ

//Messagebox("suivi modif début du enregistrer",dw_suivi.modifiedcount())


if this.enabled then

	dw_coment.accepttext()
	dw_patient.accepttext()
	dw_suivi.accepttext()
	dw_patient_prochain_rdv_message.accepttext()

	// Mise à jour de la zone pour comptatilité avec MyOrthokis
	if dw_patient.modifiedcount() > 0 then
		// Depuis 2024 .. rtf ou pas
		if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","remarques_sans_rtf","N") = "O" then 
			dw_patient.setItem(1, "remarques", string_to_rtf(dw_patient.getitemString(1, "remarques_html"), couleur_noire, couleur_blanche))
			dw_patient.setItem(1, "remarques_cliniques", string_to_rtf(dw_patient.getitemString(1, "remarques_cliniques_html"), couleur_noire, couleur_blanche))
		else
			dw_patient.setItem(1, "remarques_html", dw_patient.getitemString(1, "texte_brut_remarques"))
			dw_patient.setItem(1, "remarques_cliniques_html", dw_patient.getitemString(1, "texte_brut_remarques_cliniques"))
		end if
	end if
	
	if cb_enregistrer_a_part.visible then
		// On est en cours de saisie à part de la liste => on enregistre
		cb_enregistrer_a_part.triggerevent(clicked!)
	end if
	
	if avec_diag then

		dw_diagnostic.accepttext()	
		
		// Que si on a fait des mofis
		if dw_diagnostic.modifiedcount() > 0 then

			// Mise à jour des zones pour myOrthokis
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","plans_mutiples","N") = "O" then
				// Saisie en texte => conversion en RTF
				dw_diagnostic.setItem(1, "traitement_effectue", string_To_Rtf(dw_diagnostic.getitemString(1, "patient_traitement_effectue_html"), couleur_noire, couleur_blanche))
				dw_diagnostic.setItem(1, "plan_traitement", string_To_Rtf(dw_diagnostic.getitemString(1, "patient_plan_traitement_html"), couleur_noire, couleur_blanche))
			else
				if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","diag_non_rtf","N") = "O" then
					// Saisie en texte => conversion en RTF
					dw_diagnostic.setItem(1, "traitement_effectue", string_To_Rtf(dw_diagnostic.getitemString(1, "traitement_effectue_html"), couleur_noire, couleur_blanche))
					dw_diagnostic.setItem(1, "plan_traitement", string_To_Rtf(dw_diagnostic.getitemString(1, "plan_traitement_html"), couleur_noire, couleur_blanche))
				else
					dw_diagnostic.setItem(1, "patient_traitement_effectue_html", dw_diagnostic.getitemString(1, "texte_brut_traitement_effectue"))
					dw_diagnostic.setItem(1, "patient_plan_traitement_html", dw_diagnostic.getitemString(1, "texte_brut_plan_traitement"))
				end if
			end if

			dw_diagnostic.update()
			commit ;
		end if
	end if
	
	
	if message_rdv_sans_rtf and dw_patient_prochain_rdv_message.modifiedcount() > 0 then
		// Si message sans RTF, faut convertir en RTF
		dw_patient_prochain_rdv_message.setItem(1, "prochain_rdv_message", String_To_RTF(dw_patient_prochain_rdv_message.getitemString(1, "prochain_rdv_message_html"), couleur_noire, couleur_blanche))
	else
		if dw_patient_prochain_rdv_message.modifiedcount() > 0 then
			dw_patient_prochain_rdv_message.setItem(1, "prochain_rdv_message_html", dw_patient_prochain_rdv_message.getitemString(1, "texte_brut_prochain_rdv_message"))
		end if
	end if

	
	
	if dw_coment.modifiedcount() > 0 then
		// Mise à jour des commentaires HTML pour compatibilité MyOrthokis 
		// On met le texte brut
		long lig, tot
		long v_coul_texte, v_coul_fond
		
		tot = dw_coment.rowcount()
		for lig = 1 to tot
				v_coul_texte = dw_coment.getitemNumber(lig, "coul_texte")
				v_coul_fond = dw_coment.getitemNumber(lig, "coul_fond")
				// Le champ a été a été ajoutée ou modifiée
				if dw_coment.GetItemStatus (lig, 'com_html', Primary!) <> NotModified! then
					dw_coment.setItem(lig, "com", String_To_RTF(dw_coment.getitemString(lig, "com_html"), v_coul_texte, v_coul_fond))
				end if
				if dw_coment.GetItemStatus (lig, 'acte_prevu_html', Primary!) <> NotModified! then
					dw_coment.setItem(lig, "acte_prevu", String_To_RTF(dw_coment.getitemString(lig, "acte_prevu_html"),  v_coul_texte, v_coul_fond))
				end if

				if nom_datawindow = "dw_coment_maj_2010" then			// Commentaires non spécifiques !!

					if dw_coment.GetItemStatus (lig, 'com3_html', Primary!) <> NotModified! then
						dw_coment.setItem(lig, "com3", String_To_RTF(dw_coment.getitemString(lig, "com3_html"),  v_coul_texte, v_coul_fond))
					end if
					if dw_coment.GetItemStatus (lig, 'com4_html', Primary!) <> NotModified! then
						dw_coment.setItem(lig, "com4", String_To_RTF(dw_coment.getitemString(lig, "com4_html"),  v_coul_texte, v_coul_fond))
					end if
					if dw_coment.GetItemStatus (lig, 'com5_html', Primary!) <> NotModified! then
						dw_coment.setItem(lig, "com5", String_To_RTF(dw_coment.getitemString(lig, "com5_html"),  v_coul_texte, v_coul_fond))
					end if
					if dw_coment.GetItemStatus (lig, 'com6_html', Primary!) <> NotModified! then
						dw_coment.setItem(lig, "com6", String_To_RTF(dw_coment.getitemString(lig, "com6_html"),  v_coul_texte, v_coul_fond))
					end if
				end if
		next
	end if
	
//	Messagebox("suivi modif avant update",dw_suivi.modifiedcount())

	integer update1, update2, update3
	
	update1 = dw_coment.update()
	update2 = dw_patient.update()
	update3 = dw_patient_prochain_rdv_message.update() 
	
	if update1 = 1 and update2 = 1 and update3 = 1 then
		
		if dw_suivi_modifie then 
			dw_suivi.update()
			dw_suivi_modifie = false
		end if

		commit ;
		
		// Mise en historique du type de dossier ?
		string nouveau_type_dossier 
		nouveau_type_dossier = dw_patient.getitemstring(1,"type_dossier")
		if ancien_type_dossier <> nouveau_type_dossier then
															
			// Mise à jour de l'historique des dossiers
			INSERT INTO histo_dossier (code, date_heure, type_dossier) 
			VALUES (:var_code_local, getdate(), :nouveau_type_dossier) ;
			COMMIT ;
			
			ancien_type_dossier = nouveau_type_dossier
	
		end if
		
		// Changement d'état du rendez-vous ????
		if dw_suivi.rowcount() > 0 then
			if etat_rdv_avant <> dw_suivi.getitemstring(dw_suivi.getrow(),"absent") then
				
				// Mise en mémoire de l'état du rdv
				ajout_histo_etat_rdv(dw_suivi.GetItemNumber(dw_suivi.getrow(), "code_interne"),dw_suivi.GetItemString(dw_suivi.getrow(), "absent") )
				 etat_rdv_avant = dw_suivi.getitemstring(dw_suivi.getrow(),"absent")
				 
 				// Vérification si automatisme ou non de changement de type de dossier !!!
				if verif_change_dossier_auto_rdv(var_code_local, dw_suivi.getitemstring(dw_suivi.getrow(),"type") , dw_suivi.getitemstring(dw_suivi.getrow(),"absent") ) then
					// on a effectivement changé le type de dossier 
					// on met ce type de dossier dans la salle d'attente histoire de ... et on ne tient pas compte d'une éventuelle modif de l'utilisateur
			
					// Pour mettre à jour la dw du haut
					 dw_patient.retrieve(var_code_local)
				end if
				
			end if
		end if
	
	else
		Rollback ;
		Messagebox("ATTENTION","Une erreur s'est produite dans l'enregistrement des Commentaires Cliniques.~n~n(Erreur "+ string(update1)+"/"+string(update2)+"/"+string(update3)+")")
	end if
end if


//Messagebox("suivi modif fin du clicked enregistrer",dw_suivi.modifiedcount())

end event

type dw_histo_dossier from uo_patient_histo_dossier within w_coment_maj_2010
string tag = "no resize brush"
boolean visible = false
