type cb_ajouter from uo_picturebutton_390x120 within w_coment_maj_2010
integer x = 23
integer y = 2500
integer width = 462
integer taborder = 30
string text = "&Ajouter"
string tiptext = "Ajout d~'une ligne"
string iconname = "ACTIONS_ajouter.png"
end type

event clicked;call super::clicked;string ls_f_color, ls_b_color, acte
string ligne_ajout
integer hauteur_lignes

long nouvelle_ligne

// Récupère les couleurs de fond et de texte de la palette
uo_color.uf_get_colors(ls_f_color, ls_b_color)

if saisie_modif_a_part = "A" then

	saisie_modif_a_part_a_part("A")
	
else
	if saisie_modif_a_part = "M" then
		
		saisie_modif_a_part(true)
		
		// Ajout de la ligne
		dw_ligne.reset()
		dw_ligne.insertrow(0)
		nouvelle_ligne = 1
		if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","ordre_tri","D") = "D" then
			// Décroissant => Ajout à la fin
			if dw_coment.rowcount() > 0 then
				dw_ligne.setitem(nouvelle_ligne,"ecart_semaine",  integer(daysafter( dw_coment.getitemDate( dw_coment.rowcount(), "dat") , today() ) / 7 ) )
			end if
		else
			if dw_coment.rowcount() > 0 then
				dw_ligne.setitem(nouvelle_ligne,"ecart_semaine",  integer(daysafter( dw_coment.getitemDate( 1 , "dat") , today() ) / 7 ) )
			end if
		end if
		
		dw_ligne.setitem(nouvelle_ligne,"code",var_code_local)
		dw_ligne.setitem(nouvelle_ligne,"dat",today())
		dw_ligne.setitem(nouvelle_ligne,"ordre",dw_coment.rowcount() + 1)
	
		dw_ligne.setitem(nouvelle_ligne,"coul_texte",double(ls_f_color))
		dw_ligne.setitem(nouvelle_ligne,"coul_fond",double(ls_b_color))
		
		dw_ligne.setitem(nouvelle_ligne,"user_modif",utilisateur_code)
		dw_ligne.setitem(nouvelle_ligne,"intervenant",utilisateur_code)
		
		// pour le libellé du rdv du jour
		rdv_du_jour(dw_ligne, nouvelle_ligne)

		// Hauteur de ligne fixe !!!
		hauteur_lignes = 490
		
		dw_ligne.Object.Com_html.Height.AutoSize = "No"
		dw_ligne.Object.Acte_Prevu_html.Height.AutoSize = "No"
		dw_ligne.Object.Com3_html.Height.AutoSize = "No"
		dw_ligne.Object.Com4_html.Height.AutoSize = "No"
		dw_ligne.Object.Com5_html.Height.AutoSize = "No"
		dw_ligne.Object.Com6_html.Height.AutoSize = "No"
		
		dw_ligne.Object.Com_html.Height = hauteur_lignes
		dw_ligne.Object.Acte_Prevu_html.Height = hauteur_lignes
		dw_ligne.Object.Com3_html.Height = hauteur_lignes
		dw_ligne.Object.Com4_html.Height = hauteur_lignes
		dw_ligne.Object.Com5_html.Height = hauteur_lignes
		dw_ligne.Object.Com6_html.Height = hauteur_lignes
	
		
		acte = recherche_acte_prevu()
		
		dw_ligne.setitem(nouvelle_ligne,"com_html",acte)
		
		// pour gérer le focus selon les colonnes visibles ou pas  com_html -> com3_html -> com4_html
		
		// Pour déclencher les listes déroulantes si besoin
		if  integer (dw_ligne.Object.Com3_html.visible) = 1 and profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne3_deroulante","N") = "O" then
			dw_ligne.setItem(nouvelle_ligne, "com3_html", ".")
		end if
		if integer (dw_ligne.Object.Com4_html.visible) = 1 and profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne4_deroulante","N") = "O" then
			dw_ligne.setItem(nouvelle_ligne, "com4_html", ".")
		end if
		if integer (dw_ligne.Object.Com5_html.visible) = 1 and profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne5_deroulante","N") = "O" then
			dw_ligne.setItem(nouvelle_ligne, "com5_html", ".")
		end if
		if  integer (dw_ligne.Object.Com6_html.visible) = 1 and profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne6_deroulante","N") = "O" then
			dw_ligne.setItem(nouvelle_ligne, "com6_html", ".")
		end if

		
		if integer(dw_ligne.object.com_html.visible) = 1 then
			dw_ligne.SetColumn ("com_html")
			if acte <> "" then
				dw_ligne.SelectText(1, Len(dw_coment.GetText()))
			end if
		else
			if integer(dw_ligne.object.com3_html.visible) = 1 then
				dw_ligne.SetColumn ("com3_html")
			else
				if integer(dw_ligne.object.com4_html.visible) = 1 then
					dw_ligne.SetColumn ("com4_html")
				end if
			end if
		end if
	
		dw_ligne.SetFocus()
	else
	
		// Ajout normal !
		if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","ordre_tri","D") = "D" then
			// Décroissant => Ajout à la fin
			dw_coment.InsertRow(0)
			nouvelle_ligne = dw_coment.rowcount()
			if dw_coment.rowcount() > 1 then
				dw_coment.setitem(nouvelle_ligne,"ecart_semaine",  integer(daysafter( dw_coment.getitemDate(nouvelle_ligne - 1, "dat") , today() ) / 7 ) )
			end if
		else
			// Croissant => Insertion au début
			dw_coment.InsertRow(1)
			nouvelle_ligne = 1
			if dw_coment.rowcount() > 1 then
				dw_coment.setitem(nouvelle_ligne,"ecart_semaine",  integer(daysafter( dw_coment.getitemDate(nouvelle_ligne + 1, "dat") , today() ) / 7 ) )
			end if
		end if
		
		dw_coment.ScrollToRow(nouvelle_ligne)
		dw_coment.SetRow(nouvelle_ligne)
		dw_coment.setitem(nouvelle_ligne,"code",var_code_local)
		dw_coment.setitem(nouvelle_ligne,"dat",today())
		dw_coment.setitem(nouvelle_ligne,"ordre",dw_coment.rowcount())
		dw_coment.setitem(nouvelle_ligne,"coul_texte",double(ls_f_color))
		dw_coment.setitem(nouvelle_ligne,"coul_fond",double(ls_b_color))
		
		
		
		if nom_datawindow = "dw_coment_maj_2010" then
			dw_coment.setitem(nouvelle_ligne,"user_modif",utilisateur_code)
			dw_coment.setitem(nouvelle_ligne,"intervenant",utilisateur_code)
		
			// Hauteur des lignes ! Sera géré uniquement en ajout
			hauteur_lignes = profileInt(dir_ini+inifile_orthokis,"commentaires_cliniques","hauteur_lignes",0)
			
			if hauteur_lignes <> 0 then
				// 
				dw_coment.Object.Com_html.Height.AutoSize = "No"
				dw_coment.Object.Acte_Prevu_html.Height.AutoSize = "No"
				dw_coment.Object.Com3_html.Height.AutoSize = "No"
				dw_coment.Object.Com4_html.Height.AutoSize = "No"
				dw_coment.Object.Com5_html.Height.AutoSize = "No"
				dw_coment.Object.Com6_html.Height.AutoSize = "No"
				
				dw_coment.Object.Com_html.Height = hauteur_lignes
				dw_coment.Object.Acte_Prevu_html.Height = hauteur_lignes
				dw_coment.Object.Com3_html.Height = hauteur_lignes
				dw_coment.Object.Com4_html.Height = hauteur_lignes
				dw_coment.Object.Com5_html.Height = hauteur_lignes
				dw_coment.Object.Com6_html.Height = hauteur_lignes
		
			end if
		
			
			// Liste déroualntes merdent si y a rien dans la zone 
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne3_deroulante","N") = "O"  then
				dw_coment.setitem(nouvelle_ligne,"com3_html",".")
			end if
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne4_deroulante","N") = "O"  then
				dw_coment.setitem(nouvelle_ligne,"com4_html",".")
			end if
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne5_deroulante","N") = "O"  then
				dw_coment.setitem(nouvelle_ligne,"com5_html",".")
			end if
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne6_deroulante","N") = "O"  then
				dw_coment.setitem(nouvelle_ligne,"com6_html",".")
			end if
		end if
		
		// pour le libellé du rdv du jour
		rdv_du_jour(dw_coment, nouvelle_ligne)
		
		
		// On affiche l'acte prévu précédent s'il existe dans le champ "commentaire"
		// et on le sélectionne en bleu 
		long ligne, tot
		date v_date_rdv
		integer cpt_rdv_honore = 0
		
		if nom_datawindow = "dw_coment_maj_2010" then
			// Recherche dans la ligne la plus récente
	//		if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","ordre_tri","D") = "D" then
	//			// Décroissant
	//			ligne  = dw_coment.find("dat < date('"+string(today())+"')", 999999, 1)
	//			do while ligne > 0 and cpt_rdv_honore = 0
	//				v_date_rdv = dw_coment.GetItemDate(ligne, "dat") 
	//				select isnull(count(*),0) into :cpt_rdv_honore from rdv, etat_rdv where cast (rdv.rdv as date)  = :v_date_rdv and 
	//				rdv.code = :var_code_local and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' ;
	//				if cpt_rdv_honore > 0 then 
	//					acte = dw_coment.getitemstring(ligne,"acte_prevu_html")
	//				end if
	//				ligne = ligne - 1 
	//			loop 	
	//		else
	//			// Croissant
	//			ligne  = dw_coment.find("dat < date('"+string(today())+"')", 1, 999999)
	//			if ligne > 0 then 
	//				tot = dw_coment.rowcount()
	//				do while ligne <= tot and cpt_rdv_honore = 0
	//					v_date_rdv = dw_coment.GetItemDate(ligne, "dat") 
	//					select isnull(count(*),0) into :cpt_rdv_honore from rdv, etat_rdv where cast (rdv.rdv as date)  = :v_date_rdv and 
	//					rdv.code = :var_code_local and rdv.absent = etat_rdv.code and etat_rdv.elimine_agenda <> 'O' ;
	//					if cpt_rdv_honore > 0 then 
	//						acte = dw_coment.getitemstring(ligne,"acte_prevu_html")
	//					end if
	//					ligne = ligne + 1 
	//				loop 
	//			end if
	//		end if
			
			
			acte = recherche_acte_prevu()
	
			IF acte <> ""  THEN
				dw_coment.setitem(nouvelle_ligne,"com_html",acte)
				dw_coment.SetColumn ("com_html")
			end if
		
			ligne_ajout = dw_coment.getitemstring(nouvelle_ligne,"com_html")
			if isnull(ligne_ajout) then ligne_ajout = ""
		
			dw_coment.setrow(nouvelle_ligne)
			
			// Si commentaires vierges, on met ""
			if len(trim(ligne_ajout)) = 0 then
				dw_coment.setitem(nouvelle_ligne,"com_html","")
				dw_coment.SetColumn ("com_html")
				dw_coment.SelectText(1, Len(dw_coment.GetText()))
			end if
			
			// pour gérer le focus selon les colonnes visibles ou pas  com_html -> com3_html -> com4_html
			
			if integer(dw_coment.object.com_html.visible) = 1 then
				dw_coment.SetColumn ("com_html")
			else
				if integer(dw_coment.object.com3_html.visible) = 1 then
					dw_coment.SetColumn ("com3_html")
				else
					if integer(dw_coment.object.com4_html.visible) = 1 then
						dw_coment.SetColumn ("com4_html")
					end if
				end if
			end if
				
			
			dw_coment.ScrollToRow(nouvelle_ligne)
			dw_coment.SetRow(nouvelle_ligne)
			
			// Selection du texte
			dw_coment.SelectText(1, Len(dw_coment.GetText()))
			dw_coment.Setfocus()
		end if
	
	end if
end if
end event

type cb_supprimer from uo_picturebutton_390x120 within w_coment_maj_2010
integer x = 485
integer y = 2500
integer width = 462
integer taborder = 30
string text = "&Supprimer"
string tiptext = "Suppression de la ligne courante"
string iconname = "ACTIONS_supprimer.png"
end type

event clicked;call super::clicked;
boolean v_suite

if enregistrement_automatique then
	if Messagebox("ATTENTION","Vous allez supprimer définitivement cette ligne de commentaires.~n~nConfirmez-vous ?",Question!,Yesno!, 2) = 1 then
		v_suite = true
	else
		v_suite = false
	end if
else
	v_suite = true
end if

if v_suite then
	son(7)
	dw_coment.deleterow(dw_coment.getrow())
	if enregistrement_automatique then
		cb_enregistrer.triggerevent(clicked!)
	end if
end if

dw_coment.setfocus()

end event

