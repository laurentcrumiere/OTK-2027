end type

event clicked;call super::clicked;//opensheet(w_fiche_traca,w_mdi,0,layered!)

if dw_coment.rowcount() > 0 then
	
	//On enregistre le commentaire clinique avant
	cb_enregistrer.triggerevent(clicked!)
	
	
	str_traca struct
	// On ouvre toujours pour la date du jour
	struct.date_rdv = date(today())
	struct.code_patient = dw_coment.getitemnumber(dw_coment.getrow(),"code")
	struct.code_praticien = dw_patient.getitemstring(dw_patient.getrow(),"code_praticien")
//	OpenWithParm(w_tracabilite_fiche,struct)
	guo_fenetre_modale.wf_ouvrir_param_str_traca(w_tracabilite_fiche,struct)
	
	
	// pour remettre à jour le symbole "T" en premiere colonne
	dw_coment.retrieve(var_code_local) ;
	positionnement_dw()
end if
end event

type cb_imprimer from uo_picturebutton_390x120 within w_coment_maj_2010
integer x = 1408
integer y = 2500
integer width = 238
integer taborder = 30
string text = "&Imp."
string tiptext = "Impression des Commentaires Cliniques"
end type

event clicked;call super::clicked;
// renverra 1, 2 ou 0
open(w_coment_confirmation_impression)

choose case message.doubleParm
	case 1 
		dw_liste_edition = create datastore
		if nom_datawindow = "dw_coment_maj_2010" then
			dw_liste_edition.dataobject = "dw_comment_edition_2010"
		else
			dw_liste_edition.dataobject = nom_datawindow
		end if
		dw_liste_edition.settransobject(sqlca)
		dw_liste_edition.retrieve(var_code_local)
		dw_liste_edition.print()
		ajout_histo_editions(var_code_local,"COMTEC",today(),"Impression Mise en Page")
	case 2
		
		long job
		job = PrintOpen( )
		// Each DataWindow starts printing on a new page.
		string s_nom, s_prenom, s_sexe , s_ne_le
		date d_date_naissance
		select nom, isnull(prenom, ''), date_naissance , sexe
		into :s_nom, :s_prenom, :d_date_naissance, :s_sexe
		from patient
		where code = :var_code_local ;
		
		if s_sexe = "F" then
			s_ne_le = " née le "
		else
			s_ne_le = " né le "
		end if
		
		Print(Job, "Commentaires cliniques pour : " + s_prenom + " " + s_nom + s_ne_le + string(d_date_naissance) )
		PrintDataWindow(job, dw_coment)
		PrintClose(job)


		ajout_histo_editions(var_code_local,"COMTEC",today(),"Impression brute")
end choose


	
end event

