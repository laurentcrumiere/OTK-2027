type dw_patient from datawindow within w_coment_maj_2010
string tag = "no resizeall brush"
integer x = 18
integer y = 116
integer width = 3109
integer height = 524
integer taborder = 20
string dataobject = "dw_patient_petite"
boolean livescroll = true
end type

event dberror;db_erreur(dw_patient,sqldbcode,sqlerrtext)
return 1
end event

event itemfocuschanged;if row > 0 then
	if this.getcolumnName() = "patient_prochain_rdv_tps"  then
		// Le focus entre dans la zone de Temps du Prochain RDV
		this.setitem(row, "patient_prochain_rdv_tps","E")
	end if
end if
end event

event retrieveend;
if rowcount > 0 then	
	// Mémo du type de dossier AVANT modif
	ancien_type_dossier = this.getitemstring(1,"type_dossier")
	
//	// mise à jour de la dddw du type de next rdv  
//	
//	DataWindowChild fille
//	if this.GetChild("prochain_rdv", fille) <> -1 then
//		fille.settransobject(sqlca)
//		fille.Reset()
//		fille.Retrieve(this.getitemString(1, "code_praticien"))
//	end if

	// Mise à jour de la ddw du type de rdv en fonction du praticien
	maj_dddw_type_rdv_selon_praticien(this, this.getitemString(1, "code_praticien") , "prochain_rdv")

	string somme 
	double v_du
	
	// Pas pour Ortho Worldt et Erasme
	if serial <> "87669" and serial <> "87669" then
		  SELECT "param"."somme_comment"  
			 INTO :somme  
			 FROM "param"  ;	
			 
		// Mise à jour de somme			
		IF somme = 'M' THEN
			v_du = due(var_code_local,today())
			if v_du > 0 then
				dw_patient.Modify('st_somme.text = "Doit : ' + string(v_du)+" " +symbole_euro + '"')
				dw_patient.Modify('st_somme.visible = 1')
			else
				dw_patient.Modify('st_somme.visible = 0')
			end if
		else
			dw_patient.Modify('st_somme.visible = 0')
		end if
	end if
	
	
	
	
	
	// Date de vaccination Covid
//	if getitemString(1 , "vaccine_covid_19") = "O" then
//		this.Object.vaccine_covid_19.Tooltip.enabled = true
//		this.Object.vaccine_covid_19.Tooltip.tip = "Date de vaccination : " + string(getitemDate(1 , "date_vaccine_covid_19"),"dd/mm/yyyy" )
//	else
//		this.Object.vaccine_covid_19.Tooltip.enabled = false
//	end if
	
	
end if
end event

event buttonclicked;string ls_object
double v_langue_maj
string v_flag

ls_Object = String(dwo.name)

choose case ls_Object
	case  "b_histo_dossier" 

		// Historique des changements de types de dossier
		if row > 0 then
			if 	dw_histo_dossier.visible then
				dw_histo_dossier.visible = false
			else
				dw_histo_dossier.settransobject(sqlca)
				dw_histo_dossier.var_code_local = var_code_local
				dw_histo_dossier.retrieve(var_code_local)
				dw_histo_dossier.visible = true
			end if
		end if
	case  "b_debut_traitement" 
		// Date du jour
		if isnull(this.GetItemDate(row, "date_reprise")) then
			set_today(this, "debut_traitement")
		else
			set_today(this, "date_reprise")
		end if
	case "b_corresp" 
		OpenWithParm(w_corres_fiche,this.getitemstring(this.getrow(),"code_correspondant"))
		//parent.triggerevent(resize!)
	case  "b_dentiste" 
		OpenWithParm(w_corres_fiche,this.getitemstring(this.getrow(),"code_dentiste"))
		//parent.triggerevent(resize!)
	case  "b_ecole" 
		if not isnull(this.getitemstring(this.getrow(),"ecole")) then
			OpenWithParm(w_ecole_fiche,this.getitemstring(this.getrow(),"ecole"))
		end if
	case  "b_raz_proc_rdv" 
		integer v_nul_integer
		string v_nul_char
		double v_nul_double
		setnull(v_nul_integer)
		setnull(v_nul_char)
		setnull(v_nul_double)
		this.setitem(this.getrow(),"prochain_rdv", v_nul_char )
		this.setitem(this.getrow(),"patient_prochain_rdv_nb", v_nul_integer)
		this.setitem(this.getrow(),"patient_prochain_rdv_tps", v_nul_char )
		this.setitem(this.getrow(),"prochain_rdv_t_ou_s", v_nul_char )
		this.setitem(this.getrow(),"prochain_rdv_serie", v_nul_double )

		if enregistrement_automatique and cb_enregistrer.enabled then
			cb_enregistrer.triggerevent(clicked!)
		end if

	case "b_flag1"
		// changement de langue parlée 1
		dw_click = this
		openwithparm(w_patient_maj_langue, 1 ) 
		v_langue_maj = message.doubleparm
		// La fentre
		if v_langue_maj > 0 then
			this.setitem(1, "patient_langue1", v_langue_maj )
			// Pour le mise à jour du drapeau
			select flag into :v_flag from langue where code = :v_langue_maj ;
			this.setitem(1, "flag1", v_flag )
			if enregistrement_automatique and cb_enregistrer.enabled then
				cb_enregistrer.triggerevent(clicked!)
			end if
		end if
		
	case "b_flag2"
		// changement de langue parlée 2
		dw_click = this
		openwithparm(w_patient_maj_langue, 2 ) 
		v_langue_maj = message.doubleparm
		// La fentre
		if v_langue_maj > 0 then
			this.setitem(1, "patient_langue2", v_langue_maj )
			// Pour le mise à jour du drapeau
			select flag into :v_flag from langue where code = :v_langue_maj ;
			this.setitem(1, "flag2", v_flag )
			if enregistrement_automatique and cb_enregistrer.enabled then
				cb_enregistrer.triggerevent(clicked!)
			end if
		end if

end choose

end event

event rbuttondown;string ls_object

ls_Object = String(dwo.name)

if Profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","menu_rtf","A") = "C" and  (ls_Object = "remarques" or ls_Object = "remarques_cliniques") then
	
	fxg_afficher_barre_rtf()
	
else
	// Affichage des informations des dddw
	if not information_zone_active_oui_non(this, "prochain_rdv","type_rdv","du Type du Prochain Rendez-vous","S") then
		if not information_zone_active_oui_non(this, "code_praticien","prati","du Praticien","S") then
			if not information_zone_active_oui_non(this, "code_correspondant","correspondants","du Correspondant","S") then
				if not information_zone_active_oui_non(this, "code_dentiste","correspondants","du Dentiste","S") then
					information_zone_active_oui_non(this, "type_dossier","dossier","du Type de Dossier","S") 
				end if
			end if
		end if
	end if
end if

double v_nul, v_code

// Langues parlées
If ls_Object = "b_flag1" then
	if messagebox("Confirmation","Vous allez annuler la langue parlée 1 de ce patient.~n~nConfirmez-vous ?", Question!, YesNo!, 2) = 1 then
		setnull(v_nul)
		this.Setitem(this.getrow(), "patient_langue1", v_nul)
		this.object.b_flag1.background.color =  "536870912	 patient_langue1 "
		this.object.b_flag1.color =  "12632256	 patient_langue1 "
		if enregistrement_automatique and cb_enregistrer.enabled then
			cb_enregistrer.triggerevent(clicked!)
		end if
	end if
end if


If ls_Object = "b_flag2" then
	if messagebox("Confirmation","Vous allez annuler la langue parlée 2 de ce patient.~n~nConfirmez-vous ?", Question!, YesNo!, 2) = 1 then
		setnull(v_nul)
		this.Setitem(this.getrow(), "patient_langue2", v_nul)
		this.object.b_flag2.background.color =  "536870912	 patient_langue2 "
		this.object.b_flag2.color =  "12632256	patient_langue2 "
		if enregistrement_automatique and cb_enregistrer.enabled then
			cb_enregistrer.triggerevent(clicked!)
		end if

	end if
end if


return 1
end event

event itemchanged;

this.accepttext()

// Si on n'a rien dans le choix de la prochaine série de rdv, on met la valeur par défaut
if isnull(this.getitemstring(row, "prochain_rdv_t_ou_s")) then
	if len(trim(this.getitemstring(row,"prochain_rdv_serie"))) > 0 then
		this.Setitem(row, "prochain_rdv_t_ou_s", "S")
	else
		this.Setitem(row, "prochain_rdv_t_ou_s", "T")
	end if
end if

if this.getitemstring(row, "prochain_rdv_t_ou_s") = "T"  then

		if dwo.type = "column" and dwo.name = 'prochain_rdv' then
			// recherche des éléments par défaut
			string v_proc_rdv, v_unite_proc_rdv
			integer v_nb_proc_rdv
			
			
			v_proc_rdv = getitemString(row, "prochain_rdv") 
			select unite_proc_rdv, nb_proc_rdv into :v_unite_proc_rdv, :v_nb_proc_rdv from type_rdv where code = :v_proc_rdv ;
			
			if not isnull(v_unite_proc_rdv) then 
				this.Setitem(row, "patient_prochain_rdv_tps", v_unite_proc_rdv)
			end if
			if not isnull(v_nb_proc_rdv) then 
				this.Setitem(row, "patient_prochain_rdv_nb", v_nb_proc_rdv)
			end if
			
		end if


end if



if enregistrement_automatique and cb_enregistrer.enabled then
	cb_enregistrer.triggerevent(clicked!)
end if



end event

type uo_color from u_color_bar within w_coment_maj_2010
string tag = "no resize"
integer x = 3927
integer y = 2260
integer width = 709
integer height = 228
boolean bringtotop = true
boolean border = true
long backcolor = 79741120
borderstyle borderstyle = styleraised!
end type

event rbuttondown;call super::rbuttondown;this.setfocus()

//Right_button_click(user defined) script for uo_color
//inherited from u_color_bar

string	ls_rc 
long ll_color
int li_xloc,li_yloc
string ls_f_color, ls_b_color
li_xloc = PointerX( )
li_yloc = PointerY( )
ll_color = uo_color.uf_get_rgb(li_xloc, li_yloc)
uo_color.uf_set_background(ll_color)
uo_color.uf_get_colors(ls_f_color, ls_b_color)


/// dans la liste
if mode_saisie_modif_a_part then
	dw_ligne.setitem(1,"coul_fond",double(ls_b_color))
	dw_ligne.accepttext()
else
	dw_coment.setitem(dw_coment.getrow(),"coul_fond",double(ls_b_color))
	dw_coment.accepttext()
end if



	



end event

on uo_color.destroy
call u_color_bar::destroy
end on

event ue_lbuttondown;call super::ue_lbuttondown;this.setfocus()



// Couleur de texte
string	ls_rc 
long ll_color
int li_xloc, li_yloc
string ls_f_color, ls_b_color
li_xloc = PointerX( )
li_yloc = PointerY( )
ll_color = uo_color.uf_get_rgb(li_xloc, li_yloc)
uo_color.uf_set_foreground(ll_color)
uo_color.uf_get_colors(ls_f_color, ls_b_color)



// ATTENTION - TESTS DU RICHTEXT EDIT -----------


// dans la liste
if mode_saisie_modif_a_part then
	dw_ligne.setitem(1,"coul_texte",double(ls_f_color))
	dw_ligne.accepttext()
	dw_ligne.setfocus()
else
	dw_coment.setitem(dw_coment.getrow(),"coul_texte",double(ls_f_color))
	dw_coment.accepttext()
	dw_coment.setfocus()
end if


//// Couleur dans le richtext
//dw_coment.SetRichTextColor (  double(ls_f_color) )
//dw_coment.accepttext()
//dw_coment.setfocus()
//

end event

