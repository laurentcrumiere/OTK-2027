type pb_acquisition_radio from picturebutton within w_coment_maj_2010
string tag = "no resizeall"
boolean visible = false
integer x = 4306
integer y = 2088
integer width = 123
integer height = 112
integer taborder = 140
boolean bringtotop = true
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
string picturename = "lc_radio.png"
string disabledname = "lc_radio.png"
alignment htextalign = left!
string powertiptext = "Acquisition d~'une radio numérique à l~'aide d~'un lien logiciel radio / Utilisation logiciel radio (option)"
end type

event rbuttondown;

if planmeca then
	// Planmeca
	uo_planmeca.cb_utiliser.triggerevent(clicked!)
else
	// DIGORA/SCANORA ou INSTRUMENTARIUM
	if digora or instrumentarium or dtx then
		if uo_digora_scanora_cliniview.type_lien = "D" then
			// Digora
			uo_digora_scanora_cliniview.cb_modifier.triggerevent(clicked!)
		else
			// Scanora ou Instrumentarium
			uo_digora_scanora_cliniview.cb_lancer_scanora_cliniview.triggerevent(clicked!)	
		end if
	else
		// VATECH - OWANDY
		IF vatech or owandy then
			uo_radios_2015.cb_ajouter.triggerevent(clicked!)
		else
			// TROPHY - KODAK - CARESTREAM
			if trophy then
				uo_trophy.cb_ajouter.triggerevent(clicked!)
			else
				// VIXWIN
				if vixwin then
					uo_vixwin.cb_ajouter.triggerevent(clicked!)
				else
					// SIDXIS
					if sidexis then
						uo_sidexis.cb_ajouter.triggerevent(clicked!)
					else
						// MEDIADENT
						if mediadent then
							uo_mediadent.cb_ajouter.triggerevent(clicked!)
						else
							// MYRAY
							if myray then
								uo_myray.cb_utiliser.triggerevent(clicked!)
							else
								// DURRDENTAL
								if DURRDENTAL then
									uo_durrdental.cb_ajouter.triggerevent(clicked!)
								end if
							end if
						end if
					end if
				end if
			end if
		end if
	end if
	
end if





end event

event clicked;if instrumentarium or dtx then
	fxg_importer_radio(var_code_local, uo_digora_scanora_cliniview.mode_vdds,uo_digora_scanora_cliniview.nom_lien_vdds )
else
	if Myray then
		if uo_myray.mode_vdds then
			fxg_importer_radio(var_code_local, uo_myray.mode_vdds,uo_myray.nom_lien_vdds ) 
		else
			 fxg_importer_radio(var_code_local, false, "") 
		end if
	else
		if Mediadent then
			if uo_Mediadent.mode_vdds then
				fxg_importer_radio(var_code_local, uo_Mediadent.mode_vdds,uo_Mediadent.nom_lien_vdds ) 
			else
				 fxg_importer_radio(var_code_local, false, "") 
			end if
		else
			if  DURRDENTAL then
				if uo_durrdental.mode_vdds then
					fxg_importer_radio(var_code_local, uo_durrdental.mode_vdds,uo_durrdental.nom_lien_vdds ) 
				else
					fxg_importer_radio(var_code_local, false, "")
				end if
			else
				fxg_importer_radio(var_code_local, false, "") 
			end if
		end if
	end if
end if



end event

