type dw_diagnostic from datawindow within w_coment_maj_2010
string tag = "no resizeall brush"
boolean visible = false
integer x = 18
integer y = 540
integer width = 4599
integer height = 832
integer taborder = 50
boolean bringtotop = true
string title = "none"
string dataobject = "dw_diag_html"
boolean vscrollbar = true
boolean livescroll = true
end type

event rbuttondown;string nom
String nom_colonne

nom_colonne = this.getColumnName() 

if this.dataobject = "dw_diag" or this.dataobject = "dw_diag_2024" then

	
	// Si le curseur est dans le champ "Plan de traitement"
	// Alors on affiche la datawindow pour pouvoir choisir un nouveau plan de ttt
	// Sinon on affiche la datawindow pour pouvoir choisir un nouveau diagnostic
	//       si le curseur est dans le champ "Diagnostic"
	
	IF nom_colonne = "plan_traitement" THEN
		type_aide = "P"
		afficher_aide_saisie(xpos, ypos)
	ELSE
		IF nom_colonne = "traitement_effectue" THEN
			type_aide = "D"
			afficher_aide_saisie(xpos, ypos)
		END IF
	END IF
else
	
	IF nom_colonne = "plan_traitement_html" or nom_colonne = "traitement_effectue_html"  THEN
		IF nom_colonne = "plan_traitement_html" then 
			type_aide = "P"
		else
			type_aide = "D"
		end if
		afficher_aide_saisie(xpos, ypos)
			
	ELSE
		

	if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","plans_mutiples","N") = "O" then
		// plan multiples, on va activer des filtres !
		choose case nom_colonne  
			case "patient_traitement_effectue_html" 
				type_aide = "DS"
				afficher_aide_saisie(xpos, ypos)
			case "patient_diag_dentaire_html" 
				type_aide = "DD"
				afficher_aide_saisie(xpos, ypos)
			case "patient_diag_fonctionnel_html" 
				type_aide = "DF"
				afficher_aide_saisie(xpos, ypos)
			case "patient_diag_alveolaire_html"
				type_aide = "DA"
				afficher_aide_saisie(xpos, ypos)

			case "patient_plan_traitement_html"
				type_aide = "P"
				afficher_aide_saisie(xpos, ypos)
				
			case "patient_plan_complement_html"
				type_aide = "P"
				afficher_aide_saisie(xpos, ypos)
			end choose
		end if
	END IF
	
end if

//// On place la dw rendue visible
//if dw_diag.visible then
//	dw_diag.x = xpos  
//	dw_diag.y = ypos
//end if
//
//if dw_plan.visible then
//	dw_plan.x = xpos
//	dw_plan.y = ypos
//end if
//
end event

event itemfocuschanged;
if this.dataobject = "dw_diag" or this.dataobject = "dw_diag_2024" then
	if getcolumn() = 2 or getcolumn() = 3   then
		// Police des zones rtf
		police_rtf_par_defaut(this)
	end if
end if
end event

event itemchanged;if enregistrement_automatique and cb_enregistrer.enabled then
	cb_enregistrer.triggerevent(clicked!)
end if
end event

event doubleclicked;// Ouverture de la fenetre diag
cb_diag.triggerevent(clicked!)
end event

event buttonclicked;string	ls_Object
string	ls_win

ls_Object = String(dwo.name)




choose case ls_Object
		
	case "b_schema"
		if row > 0 then
			param_win[1] = "E"
			openWithParm(w_schema, GetItemString(1, "patient_extraction"))

			// recup de la valeur retournée
			string v_extraction 
			v_extraction = message.StringParm
			if v_extraction <> "-1" then
				SetItem(1, "patient_extraction", v_extraction)
				// Mise à jour automatique
				if enregistrement_automatique and cb_enregistrer.enabled then
					cb_enregistrer.triggerevent(clicked!)
				end if
			end if
		end if
		
	case "b_schema_dents_soins"
		if row > 0 then
			param_win[1] = "S"
			openWithParm(w_schema, GetItemString(1, "dents_soins"))

			// recup de la valeur retournée
			string v_dents_soins 
			v_dents_soins = message.StringParm
			if v_dents_soins <> "-1" then
				SetItem(1, "dents_soins", v_dents_soins)
			end if
		end if
		
end choose
end event

event dberror;db_erreur(dw_diagnostic,sqldbcode,sqlerrtext)
return 1
end event

