type lb_liste_acte from listbox within w_coment_maj_2010
boolean visible = false
integer x = 37
integer y = 120
integer width = 2574
integer height = 424
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long textcolor = 33554432
long backcolor = 16777215
boolean vscrollbar = true
boolean sorted = false
borderstyle borderstyle = stylelowered!
end type

event doubleclicked;// Ajout d'un acte prévu prédéfini
// Si la ligne est sélectionnée, si on n'a pas rentré d'acte pour cette ligne
// sinon on a des messages pour avertir l'utilisateur

string acte

lb_liste_acte.visible = false

IF dw_coment.getRow() <>  0 THEN
	
	if saisie_modif_a_part = "M" then
		if not mode_saisie_modif_a_part then
			cb_ajouter.triggerevent(clicked!)
		end if
		
		if serial = "87008" then
			// Spécial MALINS
			acte = dw_coment.getitemstring( dw_coment.getrow(), "com4_html") 
		else
			acte = dw_coment.getitemstring( dw_coment.getrow(), "acte_prevu_html") 
		end if
	
		IF acte = "" OR IsNull (acte) THEN
			
			if serial = "87008" then
				// Spécial MALINS
				dw_ligne.setitem(dw_ligne.rowcount(),"com_html"," ")
				dw_ligne.setitem(dw_ligne.getrow(),"com4_html",mid(lb_liste_acte.selecteditem(),7,60))
			else
				dw_ligne.setitem(dw_ligne.getrow(),"acte_prevu_html",mid(lb_liste_acte.selecteditem(),7,60))
			end if
		
			
			if enregistrement_automatique then
				cb_enregistrer.triggerevent(clicked!)
			end if
			dw_ligne.SetFocus()
		end if

	else
		
		
		acte = dw_coment.getitemstring( dw_coment.getrow(), "acte_prevu_html") 
		IF acte = "" OR IsNull (acte) THEN
			dw_coment.setitem(dw_coment.rowcount(),"acte_prevu_html",mid(lb_liste_acte.selecteditem(),7,60))
			dw_coment.SetFocus()
		ELSE
			MessageBox("ATTENTION !","L'acte prévu existe  déjà ! " + "~r" + "~n" + acte)
		END IF	
	end if
ELSE			
	MessageBox("ATTENTION !","Vous n'avez pas sélectionné la ligne pour insérer votre acte prévu ou il n'existe pas de commentaire associé ! " )	
END IF	




end event

event rbuttondown;lb_liste_acte.visible = false
end event

