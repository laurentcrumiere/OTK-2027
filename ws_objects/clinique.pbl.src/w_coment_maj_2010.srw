event resize;
// resize_automatique est passé en paramètre à l'ouverture de la fenêtre

long v_hauteur_de_ligne
long ll_largeur_dw_patient_initiale, ll_moitie

try 
	
	trace("==== DEBUT RESIZE w_coment_maj_2010 ====")
	
	trace(" resize_automatique =  " + string(resize_automatique))


	if not b_premier_resize then 
		
		//messagebox("TRACE","Resise w_coment_maj")
	
		this.SetRedraw ( false )
		
		integer i
		double ratio_gb
		
		
		uo_1.retaille(this)
		
		
		if not isvalid(uo_traitement) then
			// première ouverture => faut créer l'UO et le positionner
			OpenUserObject(uo_traitement, 18  * uo_1.ratiow , 2084  * uo_1.ratioh )
			uo_traitement.width =3584
			uo_traitement.height = 164  
			uo_traitement.maj(var_code_local)
			uo_traitement.tag = "no resize hauteur"
		end if
		
		
//		 Spécial Hopital Erasme : Pas de cadres en haut 
		if SERIAL = "87669" then
			dw_suivi.visible = false
			dw_patient.visible = false
			dw_qualite.visible = false
			dw_patient_prochain_rdv_message.visible = false
			
			st_erasme_age.visible = true
			st_erasme_du.visible = true
			
			st_erasme_age.y = st_code.y
			st_erasme_age.x = st_code.x + st_code.width + 50

			st_erasme_du.y = st_erasme_age.y
			st_erasme_du.x = st_erasme_age.x + st_erasme_age.width + 50
			
		else
			
			if  isvalid(uoi[9]) then
				uoi[9].width = 629
			end if
			
			// redimmensionnement du cadre patient selon remarques
			if this.width > 5000 then
				
				if profilestring(dir_ini+inifile_orthokis,"admini","zone_remarque_commentaires","N") = "O" then 
					dw_patient.width = 5109
				end if 
			
				// on élargit dw_patient au maximum
				ll_largeur_dw_patient_initiale = dw_patient.width
				dw_patient.width = this.width - dw_suivi.width - 830 
				
				if ll_largeur_dw_patient_initiale < dw_patient.width then 
					// on élargit chacune des zones remarques de la moitié de la largeur supplémentaire
					ll_moitie = (long(dw_patient.width) - long(ll_largeur_dw_patient_initiale) ) / 2
					
					// Zones texte
					dw_patient.object.remarques_cliniques_html.width = long(dw_patient.object.remarques_cliniques_html.width) + ll_moitie
					dw_patient.object.remarques_html.width = long(dw_patient.object.remarques_html.width) + ll_moitie
					dw_patient.object.remarques_html.x = long(dw_patient.object.remarques_html.x) + ll_moitie
					dw_patient.object.t_remarques_administratives.x = long(dw_patient.object.t_remarques_administratives.x) + ll_moitie
					
					// zones RTF
					dw_patient.object.remarques_cliniques.width = dw_patient.object.remarques_cliniques_html.width
					dw_patient.object.remarques.width = dw_patient.object.remarques_html.width
					dw_patient.object.remarques.x = dw_patient.object.remarques_html.x

					
					
				end if
					
				
			end if

			//ole_photo_arakis002.width = uoi[9].width

		end if
		
		
		uo_icones.y = cb_ajouter.y - uo_icones.height - 25
		uo_color.y = cb_ajouter.y - uo_color.height - 25

		
		// repositionnement des photos ... uniquement en horizontale
	
		if imagerie_2013  and isvalid(uoi[9])  then
			// Photo d'identité 2013
			uoi[9].x = this.width - uoi[9].width - 10
		end if
			
		
			
// La barre s'auto dimensionne			
//		uo_traitement.width = this.width - this.x - 100
		
		uo_color.x = this.width - uo_color.width - 100
		
		if avec_diag then
			if SERIAL = "87669" then
				// Spécial Hopital Erasme
				dw_diagnostic.y = dw_patient.y 
			else
				dw_diagnostic.y = dw_patient.y + dw_patient.height + 20
			end if 
			
			
			dw_coment.y = dw_diagnostic.y + dw_diagnostic.height + 20
			dw_coment.height = uo_traitement.y - 20 - dw_coment.y
			dw_diagnostic.width = dw_coment.width
			
			
//			// Pour les plans normaux
//			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","plans_mutiples","N") = "N" then
//				string rc
//				long v_width
//				v_width = dw_diagnostic.width * 0.4
//				v_width = dw_diagnostic.width - 750
//				rc = dw_diagnostic.modify("gb_1.width = "+string(v_width ))
//			end if

						
		else
			//dw_diagnostic.visible = false
			dw_coment.y = dw_patient.y + dw_patient.height + 20
			dw_coment.height = uo_traitement.y - 20 - dw_coment.y
		end if
				
			
		if v_nb_cadres_photos > 0 then
			
				integer dispo // espace dispo entre les cadres

				// Retaillage des images de droites
				for i = 1 to v_nb_cadres_photos
					uoi[i].width = uoi[9].width * 0.8
					uoi[i].x = this.width - uoi[i].width -100
				next
				
				// faut réduire la largeur des commentaires
				dw_coment.width = uoi[1].x - 20 - dw_coment.x
				
				// Si affichage de la zone diag, on en tient compte
				if avec_diag then
					dw_diagnostic.width = dw_coment.width
					// / positionnement des photos 
					if SERIAL  = "87669" then
						uoi[1].y = dw_coment.y
					else
						uoi[1].y = dw_diagnostic.y
						//uoi[1].y = uoi[9].y +  uoi[9].height + 20
					end if
				else
					// positionnement des photos
					uoi[1].y = dw_coment.y
					//uoi[1].y = uoi[9].y +  uoi[9].height + 20
				end if
					
				// On accroche la 1 et la 4
				//uoi[4].y = dw_coment.y + dw_coment.height - uoi[4].height
				integer v_hauteur_cadres_photos
				v_hauteur_cadres_photos =  ((dw_coment.y +  dw_coment.height) - uoi[1].y - v_nb_cadres_photos * 5) / v_nb_cadres_photos 
				uoi[1].height = v_hauteur_cadres_photos - uoi[1].marge_hauteur
				uoi[1].resize()

				for i = 2 to v_nb_cadres_photos
					uoi[i].height = v_hauteur_cadres_photos - uoi[i].marge_hauteur
					uoi[i].resize()
					uoi[i].y = uoi[i - 1].y + uoi[1].height + 5
				next



		else
			dw_coment.width = this.width - this.x - 10
			dw_diagnostic.width = dw_coment.width
		end if
		
		
		dw_qualite.x = dw_patient.x + dw_patient.width + 18
		dw_qualite.y = dw_patient.y + dw_patient.height - dw_qualite.height
		
		dw_patient_prochain_rdv_message.x = dw_qualite.x
		dw_patient_prochain_rdv_message.height = dw_patient.height - dw_qualite.height - 10
		dw_patient_prochain_rdv_message.y = dw_qualite.y
		dw_patient_prochain_rdv_message.width = dw_qualite.width
		dw_patient_prochain_rdv_message.height = dw_qualite.height
	 
		dw_suivi.x = dw_qualite.x
		dw_suivi.y = dw_patient.y
		
		
		if table_commentaires_predefinis then
		
			dw_coment.height = dw_coment.height - 100
			uo_traitement.y = uo_traitement.y - 100
			
			uo_color2.x = uo_color.x
			uo_color2.y = uo_color.y
			
			uo_icones.x = uo_color2.x - uo_icones.width -30
			
			pb_aide.x = uo_icones.x - pb_aide.width - 30
			//pb_historique.x = pb_aide.x - pb_historique.width - 30
			
			uo_color.x = cb_ajouter.x
			
			if v_nb_cadres_photos > 0 then
				
				
				long largeur_photo_maxi 
				
				largeur_photo_maxi = uoi[1].width 
				largeur_photo_maxi = (  (pb_aide.x ) - ((uo_color.x + uo_color.width) + 10)  ) / v_nb_cadres_photos - 4
				
			
				for i = 1 to v_nb_cadres_photos
					uoi[i].y = uo_traitement.y + uo_traitement.height + 10
					// Hauteur
					uoi[i].height = cb_ajouter.y - uoi[i].y - 10 - uoi[i].marge_hauteur
					// Largeur maxi 
					if uoi[i].width > largeur_photo_maxi then
						uoi[i].width = largeur_photo_maxi
					end if
					uoi[i].x = (uo_color.x + uo_color.width) + (i - 1) * (uoi[i].width + 10) + 10
					uoi[i].resize()

				next
			end if
		
//			dw_commentaires_predefinis.x = ole_photo_arakis002.x + ole_photo_arakis002.width - dw_commentaires_predefinis.width
			dw_commentaires_predefinis.x = uoi[9].x + uoi[9].width - dw_commentaires_predefinis.width

			if avec_diag then
				dw_commentaires_predefinis.y = dw_diagnostic.y
			else
				dw_commentaires_predefinis.y = dw_coment.y
			end if
		//	dw_commentaires_predefinis.height = dw_coment.height - mle_commentaire.height - 120
			dw_commentaires_predefinis.height = mle_commentaire.y - dw_commentaires_predefinis.y - 120
			
		//	mle_commentaire.x = dw_commentaires_predefinis.x
		//	mle_commentaire.y = dw_coment.y + dw_commentaires_predefinis.height + 10
		
			
			mle_commentaire.x = dw_commentaires_predefinis.x
			mle_commentaire.width = dw_commentaires_predefinis.width
			if avec_diag then
				mle_commentaire.y = dw_diagnostic.y + dw_commentaires_predefinis.height + 10
			else
				mle_commentaire.y = dw_coment.y + dw_commentaires_predefinis.height + 10
			end if
			
		//	cb_ajouter_predefini.y = mle_commentaire.y + mle_commentaire.height + 10 
			cb_ajouter_predefini.y = mle_commentaire.y + mle_commentaire.height + 10 
		
			
			cb_ajouter_prevu.y = cb_ajouter_predefini.y
			cb_annuler_predefini.y = cb_ajouter_predefini.y
		
		//	cb_ajouter_predefini.x = mle_commentaire.x
			cb_ajouter_predefini.x = mle_commentaire.x
			cb_ajouter_prevu.x = cb_ajouter_predefini.x + cb_ajouter_predefini.width + 30
			cb_annuler_predefini.x = cb_ajouter_prevu.x + cb_ajouter_prevu.width + 30
			
			if dw_commentaires_predefinis.visible then
				// en mode saisie à part dans une autre fenetre, on enlève la table_commentaires_predefinis
				dw_coment.width = dw_commentaires_predefinis.x - 20 - dw_coment.x
			else
				//dw_coment.width = dw_coment.width + this.width - 200 
				dw_coment.width = this.width -  100 
			end if
			dw_diagnostic.width = dw_coment.width
			
		end if
		
//		// Ajustement de la taille de la photo d'identité pour éviter superpo sur petits écrans
//		if ole_photo_arakis002.x < dw_suivi.x + dw_suivi.width + 10 then
//			ole_photo_arakis002.x = dw_suivi.x + dw_suivi.width + 10
//			ole_photo_arakis002.width = this.width - ole_photo_arakis002.x - 100
//		end if
		
	
		// Spécial Erasme then
		if serial = "87669" then
			
			uoi[9].x =  uoi[1].x
			uoi[9].height =  uoi[1].height
			uoi[9].width =  uoi[1].width
			uoi[9].y =  dw_diagnostic.y
			uoi[9].resize()

		else
	
			if uoi[9].x < dw_suivi.x + dw_suivi.width + 10 then
				if uoi[9].visible then
					uoi[9].x = dw_suivi.x + dw_suivi.width + 10
					uoi[9].width = this.width - uoi[9].x - 100
					uoi[9].resize()

				end if
			end if
			
			if uoi[9].visible then
				// Ajustement de la taille de la photo d'identité pour éviter superpo sur listes du dessous
				long limite_basse		
				if avec_diag then
					limite_basse = dw_diagnostic.y
				else
					limite_basse = dw_coment.y
				end if
				if uoi[9].y + uoi[9].height > limite_basse - 10 then
					uoi[9].height =  limite_basse - 10 - uoi[9].y - uoi[9].marge_hauteur
					uoi[9].resize()

				end if
			end if
		
			if table_commentaires_predefinis then
				pb_acquisition_radio.x = uo_color2.x - boutons_width 
			else
				pb_acquisition_radio.x = uo_color.x - boutons_width
			end if
		end if
		
		if table_commentaires_predefinis then
			pb_acquisition_radio.x = uo_color2.x - boutons_width - 100
		else
			pb_acquisition_radio.x = uo_color.x - boutons_width - 100
		end if

		pb_acquisition_radio.y = uo_color.y - boutons_height - 10
		
		pb_moulage.x = pb_acquisition_radio.x - boutons_width - 10
		pb_moulage.y = pb_acquisition_radio.y

		
		
		long x_max 
		
		x_max =  pb_acquisition_radio.x +  boutons_width + 10
		
		// selon les modules ... 
		if INVISALIGN then
			uo_invisalign.x = x_max
			uo_invisalign.y = pb_acquisition_radio.y
			x_max =  uo_invisalign.x +  boutons_width + 10
			uo_invisalign.SetPosition (ToTop! )
		end if

		if INSIGNIA then
			uo_insignia.x = x_max
			uo_insignia.y = pb_acquisition_radio.y
			x_max = uo_insignia.x +  boutons_width + 10
			uo_insignia.SetPosition (ToTop! )
		end if
		
		if TRIDIM then
			uo_tridim.x = x_max
			uo_tridim.y = pb_acquisition_radio.y
			x_max = uo_tridim.x +  boutons_width + 10
			uo_tridim.SetPosition (ToTop! )
		end if

		if KITVIEW then
			uo_kitview.x = x_max
			x_max = uo_kitview.x +  boutons_width + 10
			uo_kitview.y = pb_acquisition_radio.y
			uo_kitview.SetPosition (ToTop! )
		end if
			
		
		if ORTHOCONCEPT then
			uo_orthoconcept.x = x_max
			x_max = uo_orthoconcept.x +  boutons_width + 10
			uo_orthoconcept.y = pb_acquisition_radio.y
			uo_orthoconcept.SetPosition (ToTop! )
		end if
		
		if ORTHOMOOV then
			uo_orthomoov.x = x_max
			x_max = uo_orthomoov.x +  boutons_width + 10
			uo_orthomoov.y = pb_acquisition_radio.y
			uo_orthomoov.SetPosition (ToTop! )
		end if
		
		if MON_ORTHODONTISTE or TEA then
			uo_mon_orthodontiste.x = x_max
			x_max =	uo_mon_orthodontiste.x +  boutons_width + 10
			uo_mon_orthodontiste.y = pb_acquisition_radio.y
		end if
		
		if DENTAL_MONITORING then
			pb_dental_monitoring.x = x_max
			x_max =	pb_dental_monitoring.x +  boutons_width + 10
			pb_dental_monitoring.y = pb_acquisition_radio.y
		end if
		
		// Urls pero à la suite
		
		uo_url1.x = x_max
		x_max =	uo_url1.x +  uo_url1.width + 10
		uo_url1.y = pb_acquisition_radio.y

		uo_url2.x = x_max
		x_max =	uo_url2.x +  uo_url2.width + 10
		uo_url2.y = pb_acquisition_radio.y
		
		// Spécial Busson Floriant
//		if SERIAL = "87728" then
//			uo_lien_onyx.init(var_code_local)
//			uo_lien_onyx.x = x_max
//			x_max =	uo_lien_onyx.x +  uo_lien_onyx.width + 10
//			uo_lien_onyx.y = pb_acquisition_radio.y
//			uo_lien_onyx.visible = true
//			uo_lien_onyx.width = uo_orthomoov.width
//			uo_lien_onyx.height = uo_orthomoov.height
//		end if
//
		
		pb_aide.x = uo_icones.x - pb_aide.width - 10
		pb_aide.y = uo_icones.y + 60
		pb_aide.visible = true
		

		
		if avec_diag then
			dw_diagnostic.visible = true
			
			integer largeur_de_base
			integer largeur_supplementaire , bonus

			// Elargissement des zones si possibles
			choose case dw_diagnostic.dataobject
				case "dw_diag", "dw_diag_html"
					largeur_de_base = 5015
					largeur_supplementaire = dw_diagnostic.width - largeur_de_base
					
					if largeur_supplementaire > 0 then 
						bonus = largeur_supplementaire / 2

						// déplacement zones de droite
						dw_diagnostic.object.t_duree.x = long(dw_diagnostic.object.t_duree.x) + bonus * 2 
						dw_diagnostic.object.patient_duree_traitement.x = long(dw_diagnostic.object.patient_duree_traitement.x) + bonus * 2
						dw_diagnostic.object.t_dents_soins.x = long(dw_diagnostic.object.t_dents_soins.x) + bonus * 2
						dw_diagnostic.object.dents_soins.x = long(dw_diagnostic.object.dents_soins.x) + bonus * 2
						dw_diagnostic.object.b_schema_dents_soins.x = long(dw_diagnostic.object.b_schema_dents_soins.x) + bonus * 2
						dw_diagnostic.object.plan_imprime.x = long(dw_diagnostic.object.plan_imprime.x) + bonus * 2
						dw_diagnostic.object.t_extractions.x = long(dw_diagnostic.object.t_extractions.x) + bonus * 2
						dw_diagnostic.object.patient_extraction.x = long(dw_diagnostic.object.patient_extraction.x) + bonus * 2
						dw_diagnostic.object.b_schema.x = long(dw_diagnostic.object.b_schema.x) + bonus * 2
						dw_diagnostic.object.duree_traitement_unite.x = long(dw_diagnostic.object.duree_traitement_unite.x) + bonus * 2
				
					// Déplacement et/ou élargissement des cadres principaux
						dw_diagnostic.object.plan_traitement_t.x = long(dw_diagnostic.object.plan_traitement_t.x) + bonus
						
						if dw_diagnostic.dataobject = "dw_diag" then 
							dw_diagnostic.object.plan_traitement.x = long(dw_diagnostic.object.plan_traitement.x) + bonus 
							dw_diagnostic.object.plan_traitement.width = long(dw_diagnostic.object.plan_traitement.width) + bonus 
							dw_diagnostic.object.traitement_effectue.width = long(dw_diagnostic.object.traitement_effectue.width) + bonus 
						else
							dw_diagnostic.object.plan_traitement_html.x = long(dw_diagnostic.object.plan_traitement_html.x) + bonus 
							dw_diagnostic.object.plan_traitement_html.width = long(dw_diagnostic.object.plan_traitement_html.width) + bonus 
							dw_diagnostic.object.traitement_effectue_html.width = long(dw_diagnostic.object.traitement_effectue_html.width ) + bonus 
						end if 
					end if
					
					
				case "dw_diag_bis"
			
					largeur_de_base = 5900
					largeur_supplementaire = dw_diagnostic.width - largeur_de_base
					
					if largeur_supplementaire > 0 then 
						
						bonus = largeur_supplementaire / 3


						// déplacement zones de droite
						dw_diagnostic.object.t_duree.x = long(dw_diagnostic.object.t_duree.x) + bonus * 3
						dw_diagnostic.object.patient_duree_traitement.x = long(dw_diagnostic.object.patient_duree_traitement.x) + bonus * 3
						dw_diagnostic.object.t_dents_soins.x = long(dw_diagnostic.object.t_dents_soins.x) + bonus * 3
						dw_diagnostic.object.dents_soins.x = long(dw_diagnostic.object.dents_soins.x) + bonus * 3
						dw_diagnostic.object.b_schema_dents_soins.x = long(dw_diagnostic.object.b_schema_dents_soins.x) + bonus * 3
						dw_diagnostic.object.plan_imprime.x = long(dw_diagnostic.object.plan_imprime.x) + bonus * 3
						dw_diagnostic.object.t_extractions.x = long(dw_diagnostic.object.t_extractions.x) + bonus * 3
						dw_diagnostic.object.patient_extraction.x = long(dw_diagnostic.object.patient_extraction.x) + bonus * 3
						dw_diagnostic.object.b_schema.x = long(dw_diagnostic.object.b_schema.x) + bonus * 3
						dw_diagnostic.object.duree_traitement_unite.x = long(dw_diagnostic.object.duree_traitement_unite.x) + bonus * 3
						
							// Déplacement et/ou élargissement des cadres principaux
						dw_diagnostic.object.t_diagnostic_dentaire.x = long(dw_diagnostic.object.t_diagnostic_dentaire.x) + bonus * 2 
						dw_diagnostic.object.t_diagnostic_fonctionnel.x = long(dw_diagnostic.object.t_diagnostic_fonctionnel.x) + bonus * 2
						dw_diagnostic.object.t_diagnostic_alveolaire.x = long(dw_diagnostic.object.t_diagnostic_alveolaire.x) + bonus 
						dw_diagnostic.object.t_plan_complement.x = long(dw_diagnostic.object.t_plan_complement.x) + bonus 
						
						dw_diagnostic.object.patient_diag_alveolaire_html.x = long(dw_diagnostic.object.patient_diag_alveolaire_html.x) + bonus 
						dw_diagnostic.object.patient_plan_complement_html.x = long(dw_diagnostic.object.patient_plan_complement_html.x) + bonus 
						dw_diagnostic.object.patient_diag_dentaire_html.x = long(dw_diagnostic.object.patient_diag_dentaire_html.x) + bonus * 2
						dw_diagnostic.object.patient_diag_fonctionnel_html.x = long(dw_diagnostic.object.patient_diag_fonctionnel_html.x) + bonus * 2
						
						dw_diagnostic.object.patient_diag_alveolaire_html.width = long(dw_diagnostic.object.patient_diag_alveolaire_html.width) + bonus 
						dw_diagnostic.object.patient_plan_complement_html.width = long(dw_diagnostic.object.patient_plan_complement_html.width) + bonus 
						dw_diagnostic.object.patient_diag_dentaire_html.width = long(dw_diagnostic.object.patient_diag_dentaire_html.width) + bonus 
						dw_diagnostic.object.patient_diag_fonctionnel_html.width = long(dw_diagnostic.object.patient_diag_fonctionnel_html.width) + bonus 
						dw_diagnostic.object.patient_plan_traitement_html.width = long(dw_diagnostic.object.patient_plan_traitement_html.width) + bonus 
						dw_diagnostic.object.patient_traitement_effectue_html.width = long(dw_diagnostic.object.patient_traitement_effectue_html.width) + bonus 
					end if
					
			end choose




			
			
			
		else
			dw_diagnostic.visible = false
		end if
	
		// Bouton ETUDE spécial pour OUHIOUN
		if serial = "87332" then
	//		pb_etude_ouhioun.x = uo_icones.x + uo_icones.width + 10 
			pb_etude_ouhioun.x = uo_icones.x - pb_etude_ouhioun.width - 10 
			pb_etude_ouhioun.y = uo_icones.y + 40
			pb_etude_ouhioun.visible = true
		end if
		
		
		
		// Dans le resize depuis 2012
		maj_barre_patient(var_code_local, st_couleur, st_couleur2, st_nom, st_cmu, st_code, st_praticien, p_sepa, pb_documents_a_signer, pb_questionnaires_en_attente, this, st_couleur3, st_couleur4)
		
	
		// bouton envoi email
		pb_envoi_email.x = dw_suivi.x + dw_suivi.width + 5
		pb_envoi_email.y = uoi[9].y 
			
		// courrier
		pb_courrier.x = pb_envoi_email.x 
		pb_courrier.y = pb_envoi_email.y + pb_envoi_email.height + 5

		// Commandes stock
		uo_commandes.x = pb_envoi_email.x  
		uo_commandes.y = pb_courrier.y + pb_courrier.height + 5
		
		// Message Borne
		uo_borne.x = pb_envoi_email.x  
		uo_borne.y = uo_commandes.y + uo_commandes.height + 5

		// Boutons INS
		pb_ins.x = pb_envoi_email.x  
		pb_ins.y = uo_borne.y + uo_borne.height + 5



		if saisie_modif_a_part = "M" then
			dw_ligne.width = dw_coment.width
			dw_ligne.x = dw_coment.x
			dw_ligne.y = dw_coment.y + dw_coment.height - dw_ligne.height 
		end if
		
		positionnement_dw()
		trace(" ==== FIN RESIZE w_coment_maj_2010 ====")

		this.show()
	else
		this.hide()
	end if


	b_premier_resize = false

	
	
	
	
Catch (RuntimeError er)
	
	Messagebox("ERREUR INATTENDUE","Une erreur inattendue s'est produite.~nLa fenêtre n'a pas pu s'ouvrir normalement.~n~nNous vous conseillons de fermer puis rouvrir le dossier.~n~nEléments Techniques pour ARAKIS :~n~nClasse : " + er.class +"~nRoutine : "+er.RoutineName + "~nLigne : " + string(er.line) + "~nTexte : "  + er.text )
	
	
End Try



end event

event close;call super::close;
// Mémorisation des infos dans Orthokis.ini

trace ("w_coment_maj_2010 - Début Close")

if nom_datawindow = "dw_coment_maj_2010" then
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","commentaire_visible",dw_coment.object.com_html.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","commentaire_largeur",valeur_ini_valide(dw_coment.object.com_html.width))

	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","hygiene_visible",dw_coment.object.hygiene_v10.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","hygiene_largeur",valeur_ini_valide(dw_coment.object.hygiene_v10.width))
	
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","elastique_visible",dw_coment.object.elastique_v10.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","elastique_largeur",valeur_ini_valide(dw_coment.object.elastique_v10.width))
	
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","acte_prevu_visible",dw_coment.object.acte_prevu_html.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","acte_prevu_largeur",valeur_ini_valide(dw_coment.object.acte_prevu_html.width))
	
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","type_rdv_visible",dw_coment.object.type_rdv.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","type_rdv_largeur",valeur_ini_valide(dw_coment.object.type_rdv.width))
	
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","intervenant_visible",dw_coment.object.intervenant.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","intervenant_largeur",valeur_ini_valide(dw_coment.object.intervenant.width))
	
	// Colonnes paramétrables
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","com3_visible",dw_coment.object.com3_html.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","com3_largeur",valeur_ini_valide(dw_coment.object.com3_html.width))
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","com4_visible",dw_coment.object.com4_html.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","com4_largeur",valeur_ini_valide(dw_coment.object.com4_html.width))
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","com5_visible",dw_coment.object.com5_html.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","com5_largeur",valeur_ini_valide(dw_coment.object.com5_html.width))
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","com6_visible",dw_coment.object.com6_html.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","com6_largeur",valeur_ini_valide(dw_coment.object.com6_html.width))

	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ecart_semaine_visible",dw_coment.object.ecart_semaine.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ecart_semaine_largeur",valeur_ini_valide(dw_coment.object.ecart_semaine.width))
	
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","code_praticien_rdv_visible",dw_coment.object.code_praticien_rdv.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","code_praticien_rdv_largeur",valeur_ini_valide(dw_coment.object.code_praticien_rdv.width))
	
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ponctualite_rdv_visible",dw_coment.object.ponctualite_rdv.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ponctualite_rdv_largeur",valeur_ini_valide(dw_coment.object.ponctualite_rdv.width))

	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ponctualite_cabinet_visible",dw_coment.object.ponctualite_cabinet.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ponctualite_cabinet_largeur",valeur_ini_valide(dw_coment.object.ponctualite_cabinet.width))

	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","soin_courant_visible",dw_coment.object.soin_courant.visible)
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","soin_courant_largeur",valeur_ini_valide(dw_coment.object.soin_courant.width))
	
	
	
end if

// Mémorisation de l'ordre des colonnes ...
if profilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ordre_colonnes","") = "RAZ" then
	// on vient de demander un RAZ de l'ordre des colonnes
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ordre_colonnes","")
else
	Setprofilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ordre_colonnes",of_getColumnOrder(dw_coment))
end if


//trace ("w_coment_maj_2010 - Close 2")

// Mémo table des prédéfinis
if dw_commentaires_predefinis.visible then
	fxg_dwtree_memo_state(dw_commentaires_predefinis, "coment_maj_2010_dw_commentaires_predefinis")
end if

// Verif enregisrement auto ???
if enregistrement_automatique then
	cb_enregistrer.triggerevent(clicked!)
end if

trace ("w_coment_maj_2010 - Fin Close")


end event

event activate;call super::activate;

Try 
	// positionnnement de la DataWindow
	
	trace(" ==== DEBUT ACTIVATE  w_coment_maj_2010 ====")

	
	//trace ("w_coment_maj_2010 - activate 1")
	
	if not positionnement_effectue then
		positionnement_dw()
		//trace ("w_coment_maj_2010 - activate 2")
	end if
	
	positionnement_effectue = true
	//trace ("w_coment_maj_2010 - activate 3")

	trace(" ==== FIN ACTIVATE  w_coment_maj_2010 ====")

Catch (RuntimeError er)
	
	Messagebox("ERREUR INATTENDUE","Une erreur inattendue s'est produite.~nLa fenêtre n'a pas pu s'ouvrir normalement.~n~nNous vous conseillons de fermer puis rouvrir le dossier.~n~nEléments Techniques pour ARAKIS :~n~nClasse : " + er.class +"~nRoutine : "+er.RoutineName + "~nLigne : " + string(er.line) + "~nTexte : "  + er.text )
	
	
End Try

end event

event timer;call super::timer;

if avec_temps_restant then
	
	fxg_maj_temps_restant(dw_suivi)
	
end if

//// pour remettre le bouton dispo après une tempo de 5 secondes pour éviter les doubles clics
//pb_historique.enabled = true


if avec_temps_restant and dw_suivi.rowcount() > 0 then
	timer(rafraichissement_temps_restant)
else
	timer(0)
end if

end event

event show;call super::show;// positionnnement de la DataWindow

Try 

	trace("*** Début Show event ***")

	if not positionnement_effectue then
		positionnement_dw()
	end if
	
	positionnement_effectue = true
	
	
	trace("*** Fin Show event ***")


Catch (RuntimeError er)
	
	Messagebox("ERREUR INATTENDUE","Une erreur inattendue s'est produite.~nLa fenêtre n'a pas pu s'ouvrir normalement.~n~nNous vous conseillons de fermer puis rouvrir le dossier.~n~nEléments Techniques pour ARAKIS :~n~nClasse : " + er.class +"~nRoutine : "+er.RoutineName + "~nLigne : " + string(er.line) + "~nTexte : "  + er.text )
	
	
End Try

end event

type p_fond from w_fenetre_arakis`p_fond within w_coment_maj_2010
end type

type cb_qualite from uo_picturebutton_390x120 within w_coment_maj_2010
integer x = 2597
integer y = 2500
integer width = 238
integer taborder = 30
string text = "&Qual"
string tiptext = "Informations de qualité et durée de traitement"
end type

event clicked;call super::clicked;if cb_enregistrer.enabled then
	// On méorise la DW du haut car contient des infos utilisées dans la fenetre qualité
	dw_patient.accepttext()
	dw_patient.update()
	commit ;
end if

// Pas de fenêtre modale classique pour voir en dessous
//guo_fenetre_modale.wf_ouvrir_param_nombre(w_coment_qualite_traitement, var_code_local)
OpenWithParm(w_coment_qualite_traitement, var_code_local)

// pour MAJ de le petite 
dw_qualite.retrieve(var_code_local)

// retrieve de la dw patient car infos modifiables dans le fenetres qualité !!
dw_patient.retrieve(var_code_local)

end event

