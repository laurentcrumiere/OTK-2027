			dw_ligne.object.ponctualite_cabinet.width = valeur_ini_valide(profilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","ponctualite_cabinet_largeur",dw_coment.object.ponctualite_cabinet.width))

			dw_ligne.object.soin_courant.visible = profilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","soin_courant_visible",dw_coment.object.soin_courant.visible )
			dw_ligne.object.soin_courant.width = valeur_ini_valide(profilestring(dir_ini+inifile_orthokis,"Commentaires Cliniques","soin_courant_largeur",dw_coment.object.soin_courant.width))

			// Style d'edition des colonnées 3, 4, 5, 6
			
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne3_deroulante","N") = "O"  then
				liste_deroulante("com3_html", dw_ligne)
			end if
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne4_deroulante","N") = "O"  then
				liste_deroulante("com4_html", dw_ligne)
			end if
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne5_deroulante","N") = "O"  then
				liste_deroulante("com5_html", dw_ligne)
			end if
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne6_deroulante","N") = "O"  then
				liste_deroulante("com6_html", dw_ligne)
			end if
	
		end if

	end if
	
	if saisie_modif_a_part = "A" then
		// Autre fenêtre ... on vire la table des prédéfinies
		
		dw_commentaires_predefinis.visible = false
		mle_commentaire.visible = false
		cb_ajouter_predefini.visible = false
		cb_ajouter_prevu.visible = false
		cb_annuler_predefini.visible = false
	end if

	
	// Barre d'avancement clinique
	//uo_traitement.maj(var_code_local)
	
	// Dans le resize depuis 2012
	//maj_barre_patient(var_code_local, st_couleur, st_nom, st_cmu, st_code, st_praticien, this)
	
	
	if enregistrement_automatique then
		cb_annuler.visible = false
		cb_enregistrer.visible = false
	end if
	
	// Cadres Gearbox
	if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","nb_cadres_photos","") = "" then
		// Pas encore initialisé => on regarde l'ancien paramètres pour dire 4 ou 0
		if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","quatre_photos","false") = "true" then
			SetProfilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","nb_cadres_photos","4")
		else
			SetProfilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","nb_cadres_photos","0")
		end if
	end if
	
	w_patience_locale.Wf_SetValue(80)

	v_nb_cadres_photos = integer(Profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","nb_cadres_photos","0"))

	if trace then trace ("w_coment_maj_2010 - Open 12")
	
	if v_nb_cadres_photos > 0 then
	
		// instantiation des photos
		
		// utilisation d'une DropDownListBox inivisible pour déduire les N° de cadres utilisés
		LoadDdlbPhoto ( ddlb_cadres , "" )
		
		long i 
		
		// Cadres Images
	
		for i = 1 to v_nb_cadres_photos
			// ajout des cadres avec init (maj du classname + chargement des images)
			// cependant c le RESIZE qui les positionne  

			// Recherche si un N° de cadre correspond
			v_fichier_image = choix_image_2013.trouver_image ("cadre_"+string(i)+"_commentaires_cliniques", var_code_local)
			if v_fichier_image <> "" then
				//select isnull("nom_cadre", '') into :nom_cadre from expl_media_cadres_images where nom_fichier + '.' + codage = :v_fichier_image ;
				nom_cadre = get_nom_cadre_image(v_fichier_image)
			end if			
		
			num_cadre = long(right(nom_cadre,3))
			
			if isnull(num_cadre) then
				// pas de N° de cadre dans la base ... on prend le N° du fichier ...
				num_cadre = long(gfx_fichier_sans_extension(v_fichier_image))
				if num_cadre > 0 then
					nom_cadre = "ole_photo"+string(num_cadre, "000")
					nom_cadre_humain = "Cadre clinique N°"+string(num_cadre)
				end if
			end if
			
			// Nom du fichier attendu 
			openuserobject(uoi[i], "uo_image")
			
			
			uoi[i].classname = nom_cadre

			uoi[i].nom_fichier_seul = v_fichier_image
			uoi[i].nom_cadre_ole = uoi[i].classname
			uoi[i].var_code_local = var_code_local
			uoi[i].numero_cadre = num_cadre
			uoi[i].numero_image_affichee = i
			uoi[i].w_fenetre_mere_coment_maj_2010 = this

	
			
			// recherche du nom "humain" du cadre
		
			uoi[i].nom_cadre_utilisateur = nom_cadre_humain
			
			if v_fichier_image <> "" and FileExists(dir_photos + string(var_code_local) + "\"+v_fichier_image) then 
				uoi[i].couleur_de_fond = couleur_blocage
				uoi[i].charger_image(false, false)
				uoi[i].visible = true
			else
				uoi[i].visible = false
			end if

// ----------------------------------------------------
//			openuserobject(gb[i], "gearbox")
//			gb[i].x = 3945
//			gb[i].width = 402
//			gb[i].height = 332
//			gb[i].visible = false
//			
//			nom_cadre = ""
//			
//			if not imagerie_2013 then
//				// N° du cadre est fixe !!
//				num_cadre = profileInt(dir_ini+inifile_orthokis,"commentaires_cliniques","cadre_"+string(i),0)
//				if num_cadre > 0 then
//					nom_cadre = "ole_photo"+string(num_cadre,"000")
//				else
//					nom_cadre = ""
//				end if
//			else
//				// Recherche si un N° de cadre correspond
//				v_fichier_image = choix_image_2013.trouver_image ("cadre_"+string(i)+"_commentaires_cliniques", var_code_local)
//				if v_fichier_image <> "" then
//					//select isnull("nom_cadre", '') into :nom_cadre from expl_media_cadres_images where nom_fichier + '.' + codage = :v_fichier_image ;
//					nom_cadre = get_nom_cadre_image(v_fichier_image)
//				end if
//			end if
//			if nom_cadre <> "" and i <= v_nb_cadres_photos then
//				gb[i].classname = nom_cadre
//				gb[i].visible = true
//				gb[i].y = 468  + (i - 1) * 332
//			else
//				gb[i].visible = false
//			end if
//			
//			if gb[i].visible then
//				gb[i].nom_cadre_explorateur_v12 = gb[i].classname
//				gb[i].var_num_dossier_v12 = var_code_local
//				gb[i].vignette = true
//				gb[i].fichier_photo = dir_photos + string(var_code_local) + win_delimiter + v_fichier_image
//			end if
//			
//			if fileExists(gb[i].fichier_photo ) then
//				gb[i].init_gearbox()
//			else
//				gb[i].visible = false
//			end if

		next
			
	
	end if
	
		// Photos d'identité
	v_fichier_image = choix_image_2013.trouver_image ("identite_commentaires_cliniques", var_code_local)
	
	if v_fichier_image <> "" then
		//select isnull("nom_cadre", '') into :nom_cadre from expl_media_cadres_images where nom_fichier + '.' + codage = :v_fichier_image ;
		nom_cadre = get_nom_cadre_image(v_fichier_image)
	end if			

	num_cadre = long(right(nom_cadre,3))
	
	
	// On l'ouvre mem si on l'affiche pas car on s'en servira comme repère dans le resize
	openuserobject(uoi[9], "uo_image")
	
	uoi[9].x = ole_photo_arakis002_x
	uoi[9].y = ole_photo_arakis002_y
	uoi[9].width = ole_photo_arakis002_width
	uoi[9].height = ole_photo_arakis002_height
	uoi[9].visible = false


		
	if nom_cadre <> ""  and profilestring(dir_ini+inifile_orthokis,"photos","iden_clinique","") <> "false" then
		uoi[9].classname = nom_cadre

		uoi[9].nom_fichier_seul = v_fichier_image
		uoi[9].nom_cadre_ole = uoi[9].classname
		uoi[9].var_code_local = var_code_local
		uoi[9].numero_cadre = num_cadre
		uoi[9].numero_image_affichee = 9
		uoi[9].w_fenetre_mere_coment_maj_2010 = this


		// recherche du nom "humain" du cadre
	
		uoi[9].nom_cadre_utilisateur = nom_cadre_humain
		
		if  v_fichier_image <> "" and  FileExists(dir_photos + string(var_code_local) + "\"+v_fichier_image) then 
			uoi[9].couleur_de_fond = couleur_blocage
			uoi[9].charger_image(false, false)
			uoi[9].visible = true
		else
			uoi[9].visible = false
		end if
			
	end if

//	// pour photo identité 2013 : on crée l'objet et on l'affiche ou pas selon
//	openuserobject(gb[9], "gearbox")
//	
//	
////	if imagerie_2013 then
//	
//		// gestion de la photo d'identite
//		// Recherche si un N° de cadre correspond
//		v_fichier_image = choix_image_2013.trouver_image ("identite_commentaires_cliniques", var_code_local)
//		if v_fichier_image <> "" then
//			//select isnull("nom_cadre", '') into :nom_cadre from expl_media_cadres_images where nom_fichier + '.' + codage = :v_fichier_image ;
//			nom_cadre = get_nom_cadre_image(v_fichier_image)
//		end if
//	
//		if nom_cadre <> ""  and profilestring(dir_ini+inifile_orthokis,"photos","iden_clinique","") <> "false" then
//			
//			gb[9].x = ole_photo_arakis002_x
//			gb[9].y = ole_photo_arakis002_y
//			gb[9].width = ole_photo_arakis002_width
//			gb[9].height = ole_photo_arakis002_height
//			gb[9].visible = true
//			
//			
//			gb[9].classname = nom_cadre
//			gb[9].nom_cadre_explorateur_v12 = gb[9].classname
//			gb[9].var_num_dossier_v12 = var_code_local
//			gb[9].vignette = true
//			gb[9].fichier_photo = dir_photos + string(var_code_local) + win_delimiter + v_fichier_image		
//			
//			if fileExists(gb[9].fichier_photo ) then
//				gb[9].init_gearbox()
//			else
//				gb[9].visible = false
//			end if
//		else
//			gb[9].visible = false
//		end if
////	else
////		gb[9].visible = false
////	end if
	
	// INS
	if CCVITALE then
		pb_ins.visible = true
		pb_ins.init(var_code_local)
	else
		pb_ins.visible = false
	end if

	w_patience_locale.Wf_SetValue(100)
	
	uo_1.taille(this)
	
	if trace then trace ("w_coment_maj_2010 - Open 13")
	
	
	uo_icones.maj(var_code_local, this,  parentWindow())
	if trace then trace ("w_coment_maj_2010 - icones")
	 
	
	// SPECIAL CHU DE LIEGE
	if serial = '87500' and gfx_chu_signature_plan(var_code_local) then
		dw_diagnostic.enabled = false
	end if
	
	
	
//	// Raccourci historique
//	if mdi_patient then
//		pb_historique.init(var_code_local, var_nom_local, parentWindow())
//	else
//		// Le passage de w_md_patient est inutile .. uniquement pour compatibilité
//		pb_historique.init(var_code_local, var_nom_local, w_mdi_patient)
//	end if
	
	
	// Moulages numériques ?
	if pb_moulage.init(var_code_local, "M") then 
		pb_moulage.visible = true
		pb_moulage.width = boutons_width
		pb_moulage.height = boutons_height
	end if

	
	// Document Word en raccourci : Hector en belgique 
	if belgique then
		string v_my_orthokis
		select top 1 trim(isnull(url_my_orthokis, '')) into :v_my_orthokis from param ;
		
		if v_my_orthokis <> "" then
			pb_courrier.visible = true
			pb_courrier.PowerTipText = "Prescriptions"
		else
			pb_courrier.visible = false
		end if
		
		
	else
		select isnull(chemin_document_clinique, '') into :v_chemin_document_clinique from prati, patient 
		where patient.code_praticien = prati.code and patient.code = :var_code_local ;
		
		if FileExists(v_chemin_document_clinique) then
			pb_courrier.visible = true
		else
			pb_courrier.visible = false
		end if
	end if
		

	pb_acquisition_radio.width = boutons_width
	pb_acquisition_radio.height = boutons_height
	
	
	
	// Gestion des liens radios
	//------------------------------------------------------------------------------------------------------------------------

	// PLANMECA
	if PLANMECA then
		uo_planmeca = create lien_planmeca 
		// Initialisation de la datawindow locale qui sert au lien
		uo_planmeca.dw_patient = dw_patient
		pb_acquisition_radio.visible = true
	else
		// DIGORA / SCANORA (Soredex) ou INSTRUMENTARIM ou DTX
		if DIGORA or INSTRUMENTARIUM or DTX then
			// même uo pour les 2 marques
			uo_digora_scanora_cliniview = create lien_digora_scanora_cliniview
			uo_digora_scanora_cliniview.init()
			uo_digora_scanora_cliniview.dw_fiche_ad = dw_patient
			pb_acquisition_radio.visible = true
		else
			// OWANDY / VATECH
			if OWANDY or VATECH then
				uo_radios_2015 = create lien_radios_2015 
				uo_radios_2015.var_code_local = var_code_local
				pb_acquisition_radio.visible = true
			else
				// TROPHY / KODAK / CARESTREAM
				if TROPHY then
					uo_trophy = create lien_trophy
					uo_trophy.var_code_local = var_code_local
					pb_acquisition_radio.visible = true
				else
					// VIXWIN 
					if VIXWIN then
						uo_vixwin = create lien_vixwin
						uo_vixwin.var_code_local = var_code_local
						pb_acquisition_radio.visible = true
					else
						// SIDEXIS
						if SIDEXIS then
							uo_sidexis = create lien_sidexis
							pb_acquisition_radio.visible = true
							uo_sidexis.var_code_local = var_code_local
						else
							// MEDIADENT
							if MEDIADENT then
								uo_mediadent = create lien_mediadent
								pb_acquisition_radio.visible = true
								uo_mediadent.init(w_parent_nulle)
								uo_mediadent.var_code_local = var_code_local
							else
								// MYRAY
								if MYRAY then
									uo_myray = create lien_myray
									uo_myray.init(var_code_local)
									pb_acquisition_radio.visible = true
								else
									// DURRDENTAL
									if DURRDENTAL then
										uo_durrdental = create lien_durrdental
										uo_durrdental.init(this, var_code_local)
										pb_acquisition_radio.visible = true
									end if
								end if
							end if
						end if
					end if
				end if
			end if
		end if
	end if
	
	// Gearbox qui servira au menu clc droit sur les images

	openuserobject(gb_tempo, "gearbox")
	gb_tempo.visible = false

	cb_enregistrer.setfocus()
	
	
	if trace then trace ("w_coment_maj_2010 - Open Avant Close patience")
	
	close(w_patience_locale)
	
	uo_icones.uo_confid.verif_alertes(var_code_local, 'CC')
	
	Trace ("==== FIN OUVERTURE COMMENTAIRES CLINIQUES 2010 ====")
	
	if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","creation_auto_ouverture","N") = "O" and dw_coment.find("dat = date("+string(year(today()))+","+string(month(today()))+","+string(day(today())) +")" , 1,99999 ) = 0   then
		cb_ajouter.triggerevent(clicked!)
	end if

	
Catch (RuntimeError er)
	
	Messagebox("ERREUR INATTENDUE","Une erreur inattendue s'est produite.~nLa fenêtre n'a pas pu s'ouvrir normalement.~n~nNous vous conseillons de fermer puis rouvrir le dossier.~n~nEléments Techniques pour ARAKIS :~n~nClasse : " + er.class +"~nRoutine : "+er.RoutineName + "~nLigne : " + string(er.line) + "~nTexte : "  + er.text )
	
	
End Try



end event

