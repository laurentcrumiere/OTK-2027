type dw_aide from datawindow within w_coment_maj_2010
string tag = "brush no resize all"
boolean visible = false
integer x = 539
integer y = 1160
integer width = 1605
integer height = 892
integer taborder = 50
boolean bringtotop = true
boolean titlebar = true
string title = "Aide"
string dataobject = "dw_plan_ttt_affichage"
boolean vscrollbar = true
boolean livescroll = true
borderstyle borderstyle = stylelowered!
end type

event clicked;If row > 0 Then
	This.SelectRow(0,False)
	This.SelectRow(row,True)
End If

end event

event rbuttondown;

this.visible = false

end event

event doubleclicked;string texte ,  texte_diag , texte_final
string texte_selectionne
char c = "~n"
char r = "~r"
string texte_plan

Choose case left(type_aide,1)
		
	case "M"
		// Message prochain rendez-vous

		// On remplace le message complet
		
		
		dw_patient_prochain_rdv_message.accepttext()
		
		if this.rowcount() > 0 and dw_patient_prochain_rdv_message.rowcount() > 0 then
		
			if message_rdv_sans_rtf then
				dw_patient_prochain_rdv_message.SetItem(1, "prochain_rdv_message_html", this.GetItemString(row, "message_html"))
			else
				dw_patient_prochain_rdv_message.SetItem(1, "prochain_rdv_message", this.GetItemString(row, "message"))
			end if
		end if
		
	case "P"
		// plan de traitement
		
		dw_diagnostic.accepttext()
		
		if this.rowcount() > 0 then
			
		
			if dw_diagnostic.dataobject = "dw_diag" or dw_diagnostic.dataobject = "dw_diag_2024" then
				// On travaille uniquement sur les textes bruts depuis 18.02a car ça pose trop de pb (orthosmile !!)
			
				texte = this.GetItemString(this.GetRow(),"texte_html")
				
			//	texte_plan = dw_diagnostic.GetItemString(dw_diagnostic.GetRow(),"plan_traitement")
				texte_plan = dw_diagnostic.GetItemString(dw_diagnostic.GetRow(),"texte_brut_plan_traitement")
				
				texte_selectionne = dw_diagnostic.SelectedText()
			
				if  IsNull(texte_plan) then
					 texte_plan = ""
				end if
				
				IF texte_plan = texte_selectionne or len(trim(texte_plan)) = 0 THEN
					texte_final =  this.GetItemString(this.GetRow(),"texte")
				ELSE	
					texte_final = texte_plan  + this.GetItemString(this.GetRow(),"texte_html")	
					texte_final = string_To_Rtf(texte_final, couleur_noire, couleur_blanche)
				END IF
				
			
				dw_diagnostic.SetItem(dw_diagnostic.GetRow(),"plan_traitement",texte_final)
			else
		
				long colonne_courante
				
				colonne_courante = dw_diagnostic.GetColumn()
				
				string texte_deja
			
				// On travaille uniquement sur les textes bruts depuis 18.02a car ça pose trop de pb (orthosmile !!)
			
				texte = this.GetItemString(this.GetRow(),"texte_html")
					
				texte_deja = dw_diagnostic.GetItemString(1, colonne_courante)
			
				texte_selectionne = dw_diagnostic.SelectedText()
				
				if  IsNull(texte_deja) then
					 texte_deja = ""
				end if
				
				IF texte_deja = texte_selectionne or len(trim(texte_deja)) = 0 THEN
					texte_final =  texte
				ELSE	
					texte_final = texte_deja  + texte
				END IF
				
				
				dw_diagnostic.SetItem(1,colonne_courante,texte_final)
			end if
				
		end if
		
		
	case "D"
		// Diagnostique
		dw_diagnostic.accepttext()
		
		if this.rowcount() > 0 then
		
			if dw_diagnostic.dataobject = "dw_diag" or dw_diagnostic.dataobject = "dw_diag_2024" then
				// On travaille uniquement sur les textes bruts depuis 18.02a car ça pose trop de pb (orthosmile !!)
		
				texte = this.GetItemString(this.GetRow(),"texte_html")
					
				texte_diag = dw_diagnostic.GetItemString(dw_diagnostic.GetRow(),"texte_brut_traitement_effectue")
			
				texte_selectionne = dw_diagnostic.SelectedText()
				
				if  IsNull(texte_diag) then
					 texte_diag = ""
				end if
				
				IF texte_diag = texte_selectionne or len(trim(texte_diag)) = 0 THEN
					texte_final =  this.GetItemString(this.GetRow(),"texte")
				ELSE	
					texte_final = texte_diag  + this.GetItemString(this.GetRow(),"texte_html")	
					texte_final = string_To_Rtf(texte_final, couleur_noire, couleur_blanche)
				END IF
				
				
				dw_diagnostic.SetItem(dw_diagnostic.GetRow(),"traitement_effectue",texte_final)
			else
		
	
				
				colonne_courante = dw_diagnostic.GetColumn()
				
				// On travaille uniquement sur les textes bruts depuis 18.02a car ça pose trop de pb (orthosmile !!)
			
				texte = this.GetItemString(this.GetRow(),"texte_html")
					
				texte_deja = dw_diagnostic.GetItemString(1, colonne_courante)
			
				texte_selectionne = dw_diagnostic.SelectedText()
				
				if  IsNull(texte_deja) then
					 texte_deja = ""
				end if
				
				IF texte_deja = texte_selectionne or len(trim(texte_deja)) = 0 THEN
					texte_final =  texte
				ELSE	
					texte_final = texte_deja  + texte
				END IF
				
				
				dw_diagnostic.SetItem(1,colonne_courante,texte_final)
				
				
			end if
		
		end if		
		
		
		
		
		
end choose

this.visible = FALSE


end event

