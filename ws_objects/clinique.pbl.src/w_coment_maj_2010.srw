type lb_liste from listbox within w_coment_maj_2010
boolean visible = false
integer y = 120
integer width = 2574
integer height = 424
integer textsize = -10
integer weight = 400
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Arial"
long textcolor = 33554432
long backcolor = 16777215
boolean vscrollbar = true
boolean sorted = false
borderstyle borderstyle = stylelowered!
end type

on rbuttondown;lb_liste.visible = false
end on

event doubleclicked;integer ind

lb_liste.visible = false


dw_coment.InsertRow(0)
dw_coment.ScrollToRow(dw_coment.rowcount())

ind = integer(left(lb_liste.selecteditem(),2))

dw_coment.setitem(dw_coment.rowcount(),"code",var_code)
dw_coment.setitem(dw_coment.rowcount(),"dat",today())
dw_coment.setitem(dw_coment.rowcount(),"com_html",mid(lb_liste.selecteditem(),7,60))
dw_coment.setitem(dw_coment.rowcount(),"coul_texte",tabct[ind])
dw_coment.setitem(dw_coment.rowcount(),"coul_fond",tabcf[ind])
dw_coment.setitem(dw_coment.rowcount(),"ordre",dw_coment.rowcount())
if nom_datawindow = "dw_coment_maj_2010" then
	dw_coment.setitem(dw_coment.Rowcount(),"user_modif",utilisateur_code)
	dw_coment.setitem(dw_coment.Rowcount(),"intervenant",utilisateur_code)
	rdv_du_jour(dw_coment, dw_coment.rowcount())
end if
dw_coment.scrolltorow(dw_coment.rowcount())
dw_coment.SetFocus()


end event

