public subroutine saisie_modif_a_part_a_part (string v_quoi)
public subroutine rdv_du_jour (datawindow dw, long lig)
public subroutine ajouter_commentaire_predefini (boolean b_avec_ajout)
public subroutine ajouter_acte_prevu (boolean b_avec_ajout)
public subroutine modifier_ligne ()
public subroutine afficher_aide_saisie (integer x_pos, integer y_pos)
public subroutine charger_image_gearbox (integer v_numero_cadre)
end prototypes

public subroutine apdef ();// Actes prédéfinis

integer cpt
for cpt = 1 to 20
	select acte_prevu 
	into :tabap[cpt]
	from coment_defaut 
	where numero = :cpt ;
next


// affectation des tips
pb_22.PowerTipText = tabap[1]
pb_23.PowerTipText = tabap[2]
pb_24.PowerTipText = tabap[3]
pb_25.PowerTipText = tabap[4]
pb_26.PowerTipText = tabap[5]
pb_27.PowerTipText = tabap[6]
pb_28.PowerTipText = tabap[7]
pb_29.PowerTipText = tabap[8]
pb_30.PowerTipText = tabap[9]
pb_31.PowerTipText = tabap[10]
pb_32.PowerTipText = tabap[11]
pb_33.PowerTipText = tabap[12]
pb_34.PowerTipText = tabap[13]
pb_35.PowerTipText = tabap[14]
pb_36.PowerTipText = tabap[15]
pb_37.PowerTipText = tabap[16]
pb_38.PowerTipText = tabap[17]
pb_39.PowerTipText = tabap[18]
pb_40.PowerTipText = tabap[19]
pb_41.PowerTipText = tabap[20]

end subroutine

public subroutine ajdef (integer num);if tab[num] <> "" then
	
	
	if saisie_modif_a_part = "M" then
		
		if not mode_saisie_modif_a_part then
			cb_ajouter.triggerevent(clicked!)
		end if

		if serial = "87008" then
			// Spécial MALINS
			dw_ligne.setitem(1,"com_html"," ")
			dw_ligne.setitem(1,"com3_html",tab[num])
		else
			dw_ligne.setitem(1,"com_html",tab[num])
		end if
		dw_ligne.setitem(1,"coul_texte",tabct[num])
		dw_ligne.setitem(1,"coul_fond",tabcf[num])
		dw_ligne.SetColumn("com_html")
		dw_ligne.setFocus()
	
	else
	
		long nouvelle_ligne
		
		if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","ordre_tri","D") = "D" then
			// Décroissant => Ajout à la fin
			dw_coment.InsertRow(0)
			nouvelle_ligne = dw_coment.rowcount()
		else
			// Croissant => Insertion au début
			dw_coment.InsertRow(1)
			nouvelle_ligne = 1
		end if
		
		dw_coment.ScrollToRow(nouvelle_ligne)
		dw_coment.setitem(nouvelle_ligne,"code",var_code_local)
		dw_coment.setitem(nouvelle_ligne,"dat",today())
		if serial = "87008" then
			// Spécial MALINS
			dw_coment.setitem(nouvelle_ligne,"com_html"," ")
			dw_coment.setitem(nouvelle_ligne,"com3_html",tab[num])
		else
			dw_coment.setitem(nouvelle_ligne,"com_html",tab[num])
		end if
		dw_coment.setitem(nouvelle_ligne,"coul_texte",tabct[num])
		dw_coment.setitem(nouvelle_ligne,"coul_fond",tabcf[num])
		dw_coment.setitem(nouvelle_ligne,"ordre",dw_coment.rowcount())
		
		// pour le libellé du rdv du jour
		rdv_du_jour(dw_coment, nouvelle_ligne)
		
		if nom_datawindow = "dw_coment_maj_2010" then
			dw_coment.setitem(nouvelle_ligne,"user_modif",utilisateur_code)
			dw_coment.setitem(nouvelle_ligne,"intervenant",utilisateur_code)
			
			// Liste déroualntes merdent si y a rien dans la zone 
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne3_deroulante","N") = "O"  then
				dw_coment.setitem(nouvelle_ligne,"com3_html",".")
			end if
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne4_deroulante","N") = "O"  then
				dw_coment.setitem(nouvelle_ligne,"com4_html",".")
			end if
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne5_deroulante","N") = "O"  then
				dw_coment.setitem(nouvelle_ligne,"com5_html",".")
			end if
			if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","colonne6_deroulante","N") = "O"  then
				dw_coment.setitem(nouvelle_ligne,"com6_html",".")
			end if		
			
		end if
		
		if enregistrement_automatique then
			cb_enregistrer.triggerevent(clicked!)
		end if
		
		dw_coment.scrolltorow(nouvelle_ligne)
		dw_coment.SetFocus()
	end if
else
	MessageBox("ATTENTION !","Le commentaire N°"+string(num)+" est vierge !")
end if

end subroutine

