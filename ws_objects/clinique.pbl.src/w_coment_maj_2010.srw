	end if
	
	if nom_datawindow = "dw_coment_maj_2010" then
		// Initialisation des tailles pour redimmensionnement des colonnes 
		largeur_col_coment	= long(dw_coment.Object.Com_html.Width)
		largeur_col_acte	 	= long(dw_coment.Object.Acte_Prevu_html.Width)
		largeur_col_hygiene 	= long(dw_coment.Object.Hygiene_V10.Width)
		largeur_col_elastique 	= long(dw_coment.Object.Elastique_V10.Width)
		largeur_col_type_rdv 	= long(dw_coment.Object.type_rdv.Width)
		largeur_col_intervenant 	= long(dw_coment.Object.intervenant.Width)
		largeur_com3	 = long(dw_coment.Object.com3_html.Width)
		largeur_com4 = long(dw_coment.Object.com4_html.Width)
		largeur_com5	 = long(dw_coment.Object.com5_html.Width)
		largeur_com6	 = long(dw_coment.Object.com6_html.Width)
		largeur_col_ecart_semaine	 = long(dw_coment.Object.ecart_semaine.Width)
		
		// Nom des colonnes paramètres
		select nom_colonne_com3, nom_colonne_com4, nom_colonne_com5, nom_colonne_com6 
		into :v_nom_colonne_com3, :v_nom_colonne_com4, :v_nom_colonne_com5, :v_nom_colonne_com6 
		from param where cle = 1 ;
		
		dw_coment.Object.com3_html_t.text = v_nom_colonne_com3
		dw_coment.Object.com4_html_t.text = v_nom_colonne_com4
		dw_coment.Object.com5_html_t.text = v_nom_colonne_com5
		dw_coment.Object.com6_html_t.text = v_nom_colonne_com6
		
		if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","multiligne_infobulle","O") = "N" then
			dw_coment.object.Com_html.Tooltip.enabled = 0
			dw_coment.object.Acte_Prevu_html.Tooltip.enabled = 0
			dw_coment.object.Com3_html.Tooltip.enabled = 0
			dw_coment.object.Com4_html.Tooltip.enabled = 0
			dw_coment.object.Com5_html.Tooltip.enabled = 0
			dw_coment.object.Com6_html.Tooltip.enabled = 0
		end if
		
		if saisie_modif_a_part = "M" then
