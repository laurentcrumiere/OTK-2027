		uo_kitview.init(var_code_local)
		uo_kitview.width = boutons_width
		uo_kitview.height = boutons_height
	end if
	
	// lien invisalign
	if invisalign then
		OpenUserObject(uo_invisalign, 20, 100)
		uo_invisalign.tag = "no resizeall"
		uo_invisalign.init(var_code_local)
		uo_invisalign.width = boutons_width
		uo_invisalign.height = boutons_height
	end if
	
	// lien insignia
	if insignia then
		OpenUserObject(uo_insignia, 20, 100)
		uo_insignia.tag = "no resizeall"
		uo_insignia.init(var_code_local)
		uo_insignia.width = boutons_width
		uo_insignia.height = boutons_height
	end if
	
	// lien dental monitoring
	if dental_monitoring then
		pb_dental_monitoring.visible = true
		uo_dental_monitoring = create lien_dental_monitoring
		uo_dental_monitoring.init( var_code_local )
		pb_dental_monitoring.enabled = uo_dental_monitoring.pb_lancer.enabled
	end if
	
	// Mon orthodontiste 
	uo_mon_orthodontiste.visible = MON_ORTHODONTISTE or TEA 
	if MON_ORTHODONTISTE or TEA then
		if MON_ORTHODONTISTE then
			uo_mon_orthodontiste.init(var_code_local, "PM")
		else
			uo_mon_orthodontiste.init(var_code_local, "M")
		end if
		uo_mon_orthodontiste.width = boutons_width
		uo_mon_orthodontiste.height = boutons_height
	end if

	// Message borne
	uo_borne.init(var_code_local)
	
	// Url
	uo_url1.init(var_code_local, "1")
	uo_url2.init(var_code_local, "2")
	uo_url1.width = boutons_width
	uo_url1.height = boutons_height
	uo_url2.width = boutons_width
	uo_url2.height = boutons_height

	// Spécial Busson Floriant
//	if SERIAL = "87728" then
//		uo_lien_onyx.init(var_code_local)
//	end if
//	
	w_patience_locale.Wf_SetValue(20)
	
	// Commandes Patients
	uo_commandes.init(var_code_local)
	
	// SPECIAL MALINS
	if serial = "87008" then
		dw_coment.object.elastique_v10.height.Autosize = "no"
		dw_coment.object.hygiene_v10.height.Autosize =  "no"
		dw_coment.object.acte_prevu_html.height.Autosize =  "no"
		dw_coment.object.com3_html.height.Autosize =  "no"
		dw_coment.object.com4_html.height.Autosize =  "no"
		dw_coment.object.com5_html.height.Autosize = "no"
		dw_coment.object.com6_html.height.Autosize = "no"

		dw_coment.object.elastique_v10.height = dw_coment.object.intervenant.height
		dw_coment.object.hygiene_v10.height = dw_coment.object.intervenant.height
		dw_coment.object.acte_prevu_html.height = dw_coment.object.intervenant.height
