type cb_annuler from uo_picturebutton_390x120 within w_coment_maj_2010
integer x = 3771
integer y = 2500
integer width = 462
integer taborder = 40
string text = "A&nnuler"
string iconname = "ACTIONS_annuler.png"
end type

event clicked;call super::clicked;
// Hauteur des lignes modifié en ajout ?
integer hauteur_lignes
hauteur_lignes = profileInt(dir_ini+inifile_orthokis,"commentaires_cliniques","hauteur_lignes",0)

if hauteur_lignes <> 0 then
	// 
	dw_coment.Object.Com_html.Height.AutoSize = "yes"
	dw_coment.Object.Acte_Prevu_html.Height.AutoSize = "yes"
	dw_coment.Object.Com3_html.Height.AutoSize = "yes"
	dw_coment.Object.Com4_html.Height.AutoSize = "yes"
	dw_coment.Object.Com5_html.Height.AutoSize = "yes"
	dw_coment.Object.Com6_html.Height.AutoSize = "yes"
end if
		
// Raffraichissement des images
integer i , num_cadre
string v_fichier_image, nom_cadre


if imagerie_2013 then

	if v_nb_cadres_photos > 0 then
		long v_hauteur, v_largeur
		v_hauteur = uoi[1].height
		v_largeur = uoi[1].width

		for i = 1 to v_nb_cadres_photos
			// Recherche si un N° de cadre correspond
			v_fichier_image = choix_image_2013.trouver_image ("cadre_"+string(i)+"_commentaires_cliniques", var_code_local)
			if v_fichier_image <> "" then
				nom_cadre = get_nom_cadre_image(v_fichier_image)
				num_cadre = long(right(nom_cadre,3))
				
				uoi[i].classname = nom_cadre
				uoi[i].nom_fichier_seul = v_fichier_image
				uoi[i].nom_cadre_ole = uoi[i].classname
				uoi[i].var_code_local = var_code_local
				uoi[i].numero_cadre = num_cadre
				uoi[i].numero_image_affichee = i
				uoi[i].charger_image(false, false)
				
				uoi[i].height = v_hauteur
				uoi[i].width = v_largeur

				
				uoi[i].visible = true
			else
				uoi[i].visible = false
			end if
		next
	end if
	
	
	// Identité
	v_fichier_image = choix_image_2013.trouver_image ("identite_commentaires_cliniques", var_code_local)
	if v_fichier_image <> "" then
		nom_cadre = get_nom_cadre_image(v_fichier_image)
	end if
	if nom_cadre <> ""  and profilestring(dir_ini+inifile_orthokis,"photos","iden_clinique","") <> "false" then
		nom_cadre = get_nom_cadre_image(v_fichier_image)
		num_cadre = long(right(nom_cadre,3))
		
		uoi[9].classname = nom_cadre
		uoi[9].nom_fichier_seul = v_fichier_image
		uoi[9].nom_cadre_ole = uoi[9].classname
		uoi[9].var_code_local = var_code_local
		uoi[9].numero_cadre = num_cadre
		uoi[9].numero_image_affichee = i
		uoi[9].charger_image(false, false)	
		uoi[9].visible = true
	else
		uoi[9].visible = false
	end if

end if



dw_coment.retrieve(var_code_local) 
dw_patient.retrieve(var_code_local)
dw_suivi.retrieve(v_code_interne_local)
dw_patient_prochain_rdv_message.retrieve(var_code_local)

if avec_diag then
	dw_diagnostic.retrieve(var_code_local)
end if


decimal {2} du
date	date_eche
decimal montant

	string somme
  SELECT "param"."somme_comment"  
    INTO :somme  
    FROM "param"  ;

	uo_icones.uo_due.maj(var_code_local)


// On met le détail tout le temps
IF somme = 'M' THEN
	dw_patient.SetItem(dw_patient.GetRow(),"patient_somme_due",du)
	proc_reglt(var_code_local,date_eche,montant,'P')
	dw_patient.SetItem(dw_patient.GetRow(),"patient_date_proc_reglt",date_eche)
	dw_patient.SetItem(dw_patient.GetRow(),"patient_mont_proc_reglt",montant)

	dw_patient.Modify('st_somme.visible = 1')
	dw_patient.Modify('patient_somme_due.visible = 1')
	dw_patient.Modify('st_rglt.visible = 1')
	dw_patient.Modify('patient_mont_proc_reglt.visible = 1')
	dw_patient.Modify('st_le.visible = 1')
	dw_patient.Modify('patient_date_proc_reglt.visible = 1')
	
	// Uniquement à cause de la mise à jour des sommes ...
	// Sinon, il demandera systématiquement d'enregsitrer en sortant
	dw_patient.update()
	commit ;
END IF	

// Barre d'avancement clinique
uo_traitement.maj(var_code_local)

// Commandes client
uo_commandes.init(var_code_local)

end event

