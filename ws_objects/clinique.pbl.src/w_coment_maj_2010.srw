event retrieveend;
// Mise à jour de la couleur de la qualite
maj_couleur(this)

// mise à jour des dates et couleur de respect
maj_dates(this)






end event

event rbuttondown;


if this.visible then
	this.visible = false
	dw_patient_prochain_rdv_message.visible = true
end if


end event

type dw_suivi from datawindow within w_coment_maj_2010
string tag = "no resizeall brush"
integer x = 3145
integer y = 120
integer width = 727
integer height = 328
integer taborder = 30
boolean bringtotop = true
string title = "Rendez-vous du jour"
string dataobject = "dw_rdv_clinique_maj"
boolean livescroll = true
end type

event retrieveend;

if rowcount > 0 then
	etat_rdv_avant = this.getitemString(this.getrow(),"absent")
end if

dw_suivi_modifie = false
end event

event itemchanged;// Doit-on fermer la fiche ???
string v_etat_rdv 
string v_fermeture_automatique

v_fermeture_automatique = "N"


//Messagebox("suivi modif avant itemchangd de suivi",dw_suivi.modifiedcount())

if this.rowcount() > 0 then 

	this.accepttext()
	v_etat_rdv = this.getitemstring(this.getrow(), "absent")

	select fermeture_automatique into :v_fermeture_automatique from etat_rdv where code = :v_etat_rdv ;


	// Vérification si automatisme ou non de changement de type de dossier !!!
	verif_change_dossier_auto_rdv(getitemnumber(1,"code"), getitemstring(1,"type") , getitemstring(1,"absent") ) 
	
	// vérification si automatisme ou non pour la suppression d'alertes
	verif_supprime_alertes_auto_rdv(getitemnumber(1,"code"), getitemstring(1,"type") , getitemstring(1,"absent"), getitemdatetime(1,"rdv") )

end if

dw_suivi_modifie = true

if v_fermeture_automatique = "O" then
	cb_enregistrer.triggerevent(clicked!)
	// on est en mode mdi avec une fenetre parent de type mdi_patient ...
	w_mdi_patient w_mdi_patient_instance
	w_mdi_patient_instance = parent.ParentWindow()
	w_mdi_patient_instance.fermer_mdi_patient(false)

else 
	if enregistrement_automatique and cb_enregistrer.enabled then
		cb_enregistrer.triggerevent(clicked!)
	end if
end if

//Messagebox("suivi modif fin itemchangd de suivi",dw_suivi.modifiedcount())

end event

event doubleclicked;
double db_retour
// Mise à jour du rendez-vous par défaut

st_rdv2 st_rdv

st_rdv.code_patient = var_code_local
st_rdv.code_interne_rdv = v_code_interne_local

openwithParm(w_rdv_choix, st_rdv)


// La fenêtre renvoie 0 ou le code du rdv sélectionné (o null)
db_retour = message.DoubleParm

if isnull(db_retour) then
	this.reset()
	v_code_interne_local = db_retour
else
	if db_retour <> 0 then
		v_code_interne_local = db_retour
		this.retrieve(v_code_interne_local)
	end if
end if
end event

type dw_coment from datawindow within w_coment_maj_2010
string tag = "brush "
integer x = 18
integer y = 532
integer width = 4603
integer height = 1540
integer taborder = 10
string dataobject = "dw_coment_maj_2010"
boolean hscrollbar = true
boolean vscrollbar = true
boolean livescroll = true
end type

event dberror;db_erreur_commentaires(dw_coment,sqldbcode,sqlerrtext)
return 1


end event

event rbuttondown;

// Gestion des Colonnes visibles ou pas
// UNIQUEMENT pour les commentaires cliniques normaux 

if this.dataobject = 'dw_coment_maj_2010'  then

	w_click_coment_2010 = parent
	
	// Colonnes visibles ???
	newmenu.commentaires_2010 = true
	
	if this.object.type_rdv.visible = '1' then
		newmenu.m_type_rdv.checked = true
	else
		newmenu.m_type_rdv.checked = false
	end if
	if this.object.com_html.visible = '1' then
		newmenu.m_commentaire.checked = true
	else
		newmenu.m_commentaire.checked = false
	end if
	if this.object.hygiene_v10.visible  = '1' then
		newmenu.m_hygiene.checked  = true
	else
		newmenu.m_hygiene.checked  = false
	end if
	if this.object.elastique_v10.visible = '1' then
		newmenu.m_elastique.checked  =true
	else
		newmenu.m_elastique.checked  =false
	end if
	if this.object.acte_prevu_html.visible = '1' then
		newmenu.m_acteprevu.checked  = true
	else
		newmenu.m_acteprevu.checked  = false
	end if
	if this.object.intervenant.visible = '1' then
		newmenu.m_intervenant.checked  = true
	else
		newmenu.m_intervenant.checked  = false
	end if
	if this.object.ecart_semaine.visible = '1' then
		newmenu.m_ecart_semaine.checked  = true
	else
		newmenu.m_ecart_semaine.checked  = false
	end if
	if this.object.ponctualite_rdv.visible = '1' then
		newmenu.m_ponctualite.checked  = true
	else
		newmenu.m_ponctualite.checked  = false
	end if

	if this.object.ponctualite_cabinet.visible = '1' then
		newmenu.m_ponctualite_cabinet.checked  = true
	else
		newmenu.m_ponctualite_cabinet.checked  = false
	end if

	
	// Colonnes paramétrables
	if this.object.com3_html.visible = '1' then
		newmenu.m_com3.checked  = true
	else
		newmenu.m_com3.checked  = false
	end if
	if this.object.com4_html.visible = '1' then
		newmenu.m_com4.checked  = true
	else
		newmenu.m_com4.checked  = false
	end if
	if this.object.com5_html.visible = '1' then
		newmenu.m_com5.checked  = true
	else
		newmenu.m_com5.checked  = false
	end if
	if this.object.com6_html.visible = '1' then
		newmenu.m_com6.checked  = true
	else
		newmenu.m_com6.checked  = false
	end if
	
	// variables d'instance	
	newmenu.m_com3.text = v_nom_colonne_com3
	newmenu.m_com4.text = v_nom_colonne_com4
	newmenu.m_com5.text = v_nom_colonne_com5
	newmenu.m_com6.text = v_nom_colonne_com6
	
	if this.object.soin_courant.visible = '1' then
		newmenu.m_soincourant.checked  = true
	else
		newmenu.m_soincourant.checked  = false
	end if

	newmenu.popmenu(this.PointerX(), w_mdi_2020.PointerY())

end if

end event

event itemchanged;
this.accepttext()

// que pour les commentaires standard !!
if nom_datawindow = "dw_coment_maj_2010" then

	// Mémorisation des infos de modifications
	if row > 0 then 
		fxg_set_infos_modifs(this,row)
	end if
	
end if


if enregistrement_automatique and cb_enregistrer.enabled then
	// On n'enregistre en automatique que si un texte a réellement été saisi
	if row > 0 then
		if len(trim(this.getitemstring(row,"com_html"))) > 0 then
			cb_enregistrer.triggerevent(clicked!)
		end if
	end if
end if
end event

event itemfocuschanged;//
//
//if getcolumn() = 2 then
//	// le focus arrive sur la zone commentaire !
//	
//	if row > 1 then
//		setrow(row - 1)
//	end if
//	
//	// activation d
//	this.RichTextToolbarActivation = RichTextToolbarActivationOnEdit!
//	setrow(row)
//	
//end if
end event

event retrieveend;

positionnement_dw()
end event

event doubleclicked;
// Si on double clique sur la colonne rdv c'est pour le modifier

if dwo.name = "type_rdv" and row > 0 then


	double db_retour
	string s_rdv
	// Mise à jour du rendez-vous par défaut
	
	st_rdv2 st_rdv
	
	st_rdv.code_patient = var_code_local
	st_rdv.code_interne_rdv = this.getItemNumber(row, "code_interne_rdv")
	
	openwithParm(w_rdv_choix, st_rdv)
	
	
	// La fenêtre renvoie 0 ou le code du rdv sélectionné (o null)
	db_retour = message.DoubleParm
	
	
	if db_retour <> 0 then
		
		// Mise à  jour de la ligne ...
		this.SetItem(row, "code_interne_rdv", db_retour)
		
		// Mise à jour de l'affichage 
		select left( isnull(type_rdv.symbole,'')+replicate(' ',40)      , 40) + left(  isnull(type_rdv.couleur,'')+replicate(' ',40)   , 40)  into :s_rdv   from rdv, type_rdv 
		where rdv.code_interne = :db_retour and rdv."type" = type_rdv.code ; 

		this.SetItem(row, "rdv", s_rdv)
	end if


else

	modifier_ligne()
	
end if
end event

type pb_bis from uo_picturebutton_390x120 within w_coment_maj_2010
integer x = 2834
integer y = 2500
integer width = 238
integer taborder = 40
boolean bringtotop = true
string text = "&Bis"
string tiptext = "Duplication d~'une ligne de commentaire"
end type

event clicked;call super::clicked;

// Effectue un copier / coller du rendez-vous courant à la date du jour

long lig, nouvelle_ligne

lig = dw_coment.getrow()

if lig > 0 then

	if profilestring(dir_ini+inifile_orthokis,"commentaires_cliniques","ordre_tri","D") = "D" then
		// Décroissant
		dw_coment.RowsCopy( lig, lig, Primary!, dw_coment, dw_coment.rowcount() + 1, primary!)
		nouvelle_ligne = dw_coment.rowcount()
	else
		// Croissant
		dw_coment.RowsCopy( lig, lig, Primary!, dw_coment, 1, primary!)
		nouvelle_ligne = 1
	end if

	// Actualisation des datas à la date du jour
	dw_coment.setitem(nouvelle_ligne,"dat",today())
	dw_coment.setitem(nouvelle_ligne,"ordre",dw_coment.rowcount())
	if nom_datawindow = "dw_coment_maj_2010" then
		dw_coment.setitem(nouvelle_ligne,"user_modif",utilisateur_code)
		dw_coment.setitem(nouvelle_ligne,"date_modif",today())
		dw_coment.setitem(nouvelle_ligne,"intervenant",utilisateur_code)
	end if


	// pour le libellé du rdv du jour
	rdv_du_jour(dw_coment, nouvelle_ligne)

	dw_coment.SetFocus()


	positionnement_dw()
	dw_coment.SetColumn("com_html")
end if
end event

