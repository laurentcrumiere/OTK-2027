table(column=(type=date update=yes updatewhereclause=yes name=dat dbname="coment.dat" initial="today" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com dbname="coment.com" initial=" " )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=coul_texte dbname="coment.coul_texte" initial="0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=coul_fond dbname="coment.coul_fond" initial="16777215" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=code dbname="coment.code" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=ordre dbname="coment.ordre" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=acte_prevu dbname="coment.acte_prevu" initial=" " )
 column=(type=char(100) update=yes updatewhereclause=yes name=hygiene_v10 dbname="coment.hygiene_v10" )
 column=(type=char(100) update=yes updatewhereclause=yes name=elastique_v10 dbname="coment.elastique_v10" )
 column=(type=long updatewhereclause=yes name=nb_tracabilite dbname="nb_tracabilite" )
 column=(type=char(80) updatewhereclause=yes name=rdv dbname="rdv" )
 column=(type=char(6) update=yes updatewhereclause=yes name=intervenant dbname="coment.intervenant" )
 column=(type=char(6) update=yes updatewhereclause=yes name=user_modif dbname="coment.user_modif" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=date_modif dbname="coment.date_modif" initial="today" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com_html dbname="coment.com_html" initial=" " )
 column=(type=char(30000) update=yes updatewhereclause=yes name=acte_prevu_html dbname="coment.acte_prevu_html" initial=" " )
 column=(type=char(1) updatewhereclause=yes name=photos dbname="coment.photos" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com3 dbname="coment.com3" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com4 dbname="coment.com4" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com5 dbname="coment.com5" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com6 dbname="coment.com6" )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com3_html dbname="coment.com3_html" initial=" " )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com4_html dbname="coment.com4_html" initial=" " )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com5_html dbname="coment.com5_html" initial=" " )
 column=(type=char(30000) update=yes updatewhereclause=yes name=com6_html dbname="coment.com6_html" initial=" " )
 column=(type=long updatewhereclause=yes name=nb_sterilisation dbname="nb_sterilisation" )
 column=(type=long updatewhereclause=yes name=ecart_semaine dbname="ecart_semaine" )
 column=(type=char(6) updatewhereclause=yes name=code_praticien_rdv dbname="code_praticien_rdv" )
 column=(type=char(200) updatewhereclause=yes name=commentaire_rdv dbname="commentaire_rdv" )
 column=(type=long updatewhereclause=yes name=ponctualite_rdv dbname="ponctualite_rdv" )
 column=(type=number update=yes updatewhereclause=yes name=code_interne_rdv dbname="coment.code_interne_rdv" )
 column=(type=char(132) updatewhereclause=yes name=soin_courant dbname="soin_courant" )
 column=(type=long updatewhereclause=yes name=ponctualite_cabinet dbname="ponctualite_cabinet" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coment~" ) COLUMN(NAME=~"coment.dat~") COLUMN(NAME=~"coment.com~") COLUMN(NAME=~"coment.coul_texte~") COLUMN(NAME=~"coment.coul_fond~") COLUMN(NAME=~"coment.code~") COLUMN(NAME=~"coment.ordre~") COLUMN(NAME=~"coment.acte_prevu~") COLUMN(NAME=~"coment.hygiene_v10~") COLUMN(NAME=~"coment.elastique_v10~") COMPUTE(NAME=~"(select count(*) as nb_tracabilite from fiche_tracabilite where fiche_tracabilite.code_patient = coment.code and coment.dat = fiche_tracabilite.date_rdv )~") COMPUTE(NAME=~"(select left( isnull(symbole,'')+replicate(' ',40)      , 40) + left(  isnull(type_rdv.couleur,'')+replicate(' ',40)   , 40)     as rdv from rdv, type_rdv where rdv.code_interne = code_interne_rdv  and rdv.~~~"type~~~" = type_rdv.code)~") COLUMN(NAME=~"coment.intervenant~") COLUMN(NAME=~"coment.user_modif~") COLUMN(NAME=~"coment.date_modif~") COLUMN(NAME=~"coment.com_html~") COLUMN(NAME=~"coment.acte_prevu_html~") COLUMN(NAME=~"coment.photos~") COLUMN(NAME=~"coment.com3~") COLUMN(NAME=~"coment.com4~") COLUMN(NAME=~"coment.com5~") COLUMN(NAME=~"coment.com6~") COLUMN(NAME=~"coment.com3_html~") COLUMN(NAME=~"coment.com4_html~") COLUMN(NAME=~"coment.com5_html~") COLUMN(NAME=~"coment.com6_html~") COMPUTE(NAME=~"(select count(*) as nb_sterilisation from sterilisation where sterilisation.code_patient = coment.code and coment.dat = sterilisation.date_saisie )~") COMPUTE(NAME=~"datediff (week , (select top 1 coment_pas.dat from coment as coment_pas where coment_pas.code = coment.code and coment_pas.dat < coment.dat order by coment_pas.dat desc), coment.dat) as ecart_semaine~") COMPUTE(NAME=~"(select rdv.code_praticien as code_praticien_rdv  from rdv where rdv.code_interne = code_interne_rdv )~") COMPUTE(NAME=~"(select rdv.commentaire as commentaire_rdv from rdv where rdv.code_interne = code_interne_rdv   )~") COMPUTE(NAME=~"(select datediff (minute, cast( rdv.rdv as time) , rdv.arrivee ) as ponctualite_rdv from rdv where rdv.code_interne = code_interne_rdv  )~") COLUMN(NAME=~"coment.code_interne_rdv~") COMPUTE(NAME=~"(select top 1 left(code_soins.nom, 3) + ' ' + trim(str(numero)) from code_soins, soins where dat between soins.date_demande and dateadd (month  , code_soins.duree , soins.date_demande ) and soins.code = coment.code and code_soins.code = soins.~~~"type~~~"  order by ~~~"type~~~") as soin_courant~") COMPUTE(NAME=~"(Select datediff ( minute, rdv.rdv, (select max (date_modif) as pris_en_clinique from historique_etat_rdv , etat_rdv where historique_etat_rdv.etat = etat_rdv.code and etat_rdv.ouverture_automatique = 'O' and coment.code_interne_rdv = historique_etat_rdv.code_interne)) from rdv where rdv.code_interne = coment.code_interne_rdv  ) as ponctualite_cabinet~")WHERE(    EXP1 =~"~~~"coment~~~".~~~"code~~~"~"   OP =~"=~"    EXP2 =~":numero~" ) ) ORDER(NAME=~"coment.ordre~" ASC=yes ) ARG(NAME = ~"numero~" TYPE = number) " update="coment" updatewhere=0 updatekeyinplace=no arguments=(("numero", number))  sort="dat A ordre A " )
