end type

event buttonclicked;string ls_Object, ls_selection
long lig, tot

ls_Object = String(dwo.name)

choose case ls_object
	case "b_selection" 
		// selection ou désélection de toutes les lignes
		tot = rowcount()
		
		if tot > 0 then 
			ls_selection = dw_liste.getitemstring(1, "selection")
			// on inverse 
			if ls_selection = "O" then 
				ls_selection = "N"
			else
				ls_selection = "O"
			end if
			for lig = 1 to tot
				dw_liste.setitem(lig, "selection", ls_selection)
			next
		end if
		
		
end choose
end event

