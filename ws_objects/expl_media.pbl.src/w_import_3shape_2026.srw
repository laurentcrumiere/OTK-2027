type cb_acquis from uo_picturebutton_390x120 within w_import_3shape_2026
integer x = 1070
integer y = 1404
integer width = 631
integer height = 152
integer taborder = 50
string text = "&Acquérir"
string iconname = "ACTIONS_valider.png"
end type

event clicked;call super::clicked;
open(w_patience)

string dossier_arrivee, fichier_arrivee
integer li_images_ajoutees = 0
string ls_images_ajoutees
dossier_arrivee = dir_photos + string(var_code_local)

var_suite = true

// Test de l'existence du dossier de destination
if not DirectoryExists( dossier_arrivee ) then
	// faut le créér
	if gfx_creer_rep( dossier_arrivee ) <> 1 then 
		MessageBox("ERREUR DANS LA CREATION DU DOSSIER DE DESTINATION","Impossible de créer le dossier : "+dossier_arrivee)
		var_suite = false
	end if
end if


if var_suite then
	
	
	// on parcours la liste pour acquérir les images sélectionnées 1 par 1
	long lig, tot
	string ls_mediaId, ls_url_application, ls_body
	double v_temps_traitement, v_type_image
	
	// le fichier à acquérir sera toujours le meme - temporaire
	lb_acquerir.reset()
	lb_acquerir.AddItem( gfx_extraire_nom_fichier(uo_3shape.is_file_retour_png))

	tot = dw_liste.rowcount()
	for lig = 1 to tot
		
		if dw_liste.getItemString(lig, "selection") = "O" then 
			
			// récupaérion du fichier du Cloud ...
			
			ls_mediaId = dw_liste.getItemString(lig, "id")

			ls_url_application = uo_3shape.wf_get_device_address() + "v3/media/" + ls_mediaId + "/download"
			ls_body = ""
		
			filedelete(uo_3shape.is_file_retour_png)

			if uo_3shape.lancer_commande_3shape(ls_url_application, ls_body, "GET", true, "P") = 1 then 
			
				if fileExists(uo_3shape.is_file_retour_png) then 
			
					v_temps_traitement = dw_liste.getItemNumber(lig, "temps_traitement")
					v_type_image = dw_liste.getItemNumber(lig, "type_image")
					
					if ole_acquis.importer_multiples_images( lb_acquerir, ddlb_cadre_depart, dir_ini , var_code_local,false, false, v_temps_traitement, v_type_image) = 1 then 
					
						li_images_ajoutees = li_images_ajoutees + 1
						
					end if
					
				else
					Messagebox("ATTENTION", "Erreur ligne N°" + string(lig) + "~n~nImpossible de localiser le fichier intermédiare (" +uo_3shape.is_file_retour_png + ") !")
				end if
			end if
		end if
	next

	if li_images_ajoutees > 1 then 
		ls_images_ajoutees = " images ajoutées"
	else
		ls_images_ajoutees = " image ajoutée"
	end if
	
	messagebox("ATTENTION","L'acquisition est terminée !~n~n" + String(li_images_ajoutees) + ls_images_ajoutees )
		
	
	close(w_patience)

	close(parent)
end if



end event

