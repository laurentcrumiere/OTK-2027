global type w_import_3shape_2026 from window
integer width = 3845
integer height = 1724
boolean titlebar = true
string title = "Importation d~'images 3Shape Unite"
boolean controlmenu = true
windowtype windowtype = response!
long backcolor = 67108864
string icon = "AppIcon!"
boolean center = true
ddlb_cadre_depart ddlb_cadre_depart
cb_acquis cb_acquis
ole_acquis ole_acquis
cb_3 cb_3
lb_acquerir lb_acquerir
dw_liste dw_liste
uo_3shape uo_3shape
end type
global w_import_3shape_2026 w_import_3shape_2026

type variables


double var_code_local
end variables

on w_import_3shape_2026.create
this.ddlb_cadre_depart=create ddlb_cadre_depart
this.cb_acquis=create cb_acquis
this.ole_acquis=create ole_acquis
this.cb_3=create cb_3
this.lb_acquerir=create lb_acquerir
this.dw_liste=create dw_liste
this.uo_3shape=create uo_3shape
this.Control[]={this.ddlb_cadre_depart,&
this.cb_acquis,&
this.ole_acquis,&
this.cb_3,&
this.lb_acquerir,&
this.dw_liste,&
this.uo_3shape}
end on

on w_import_3shape_2026.destroy
destroy(this.ddlb_cadre_depart)
destroy(this.cb_acquis)
destroy(this.ole_acquis)
destroy(this.cb_3)
destroy(this.lb_acquerir)
destroy(this.dw_liste)
destroy(this.uo_3shape)
end on

event open;backcolor = couleur_fond_fenetre

// patient passé en paramètre
var_code_local = message.doubleparm

string s_url_application, s_body
long lig, tot
double ld_dernier_temps_traitement 
date ld_derniere_date


if uo_3shape.ii_code_scanner  = 0 then 
	// pas encore initialiser
	uo_3shape.ii_code_scanner = uo_3shape.quel_scanner_utiliser()
	uo_3shape.is_groupe_token = "TOKEN-" + string(uo_3shape.ii_code_scanner) 
end if

if uo_3shape.ii_code_scanner > 0 then

		
		
	open(w_patience)
	
	
	dw_liste.settransobject(sqlca)
	
	// Récupération des médias du patient ...
	
	s_url_application = uo_3shape.wf_get_device_address() + "v3/patients/" + string(var_code_local) + "/media"
	s_body = ""
	
	if uo_3shape.lancer_commande_3shape(s_url_application, s_body, "GET", true, "J") = 1 then 
		
		// on remplit dans datawindows 
		
		//JSONParser ljp_json
		long ll_root, ll_media_arr, ll_count, i, ll_item, ll_files_arr, ll_first_file, ll_row
		string ls_mediaType, ls_captureDate, ls_id, ls_name
		date ld_captureDate
		
		JSONParser ljp_json
		ljp_json = Create JSONParser
		
		// 1. Charger le fichier JSON
		if ljp_json.LoadFile(uo_3shape.is_file_retour_json) <> "" then
		    MessageBox("Erreur", "Erreur lors du chargement du fichier JSON")
		    return
		end if
		
		// 2. Accéder à l'élément racine, puis au tableau "media"
		ll_root = ljp_json.GetRootItem()
		ll_media_arr = ljp_json.GetItemArray(ll_root, "media") // Le tableau principal
		ll_count = ljp_json.GetChildCount(ll_media_arr)
		
	
		dw_liste.Reset()
		
		// 3. Boucler sur les éléments du tableau "media"
		for i = 1 to ll_count
		    ll_item = ljp_json.GetChildItem(ll_media_arr, i)
		    
		    // Filtrer uniquement les "Image"
		    ls_mediaType = ljp_json.GetItemString(ll_item, "mediaType")
		    
		    if ls_mediaType = "Image" then
		        // Extraire la date de capture
		        ls_captureDate = ljp_json.GetItemString(ll_item, "captureDate")
		        ld_captureDate = date(left(ls_captureDate, 10))
				  
				  ls_id = ljp_json.GetItemString(ll_item, "id")
				  
		        // Accéder au tableau "mediaFiles"
		        ll_files_arr = ljp_json.GetItemArray(ll_item, "mediaFiles")
		        
		        // Prendre le premier fichier s'il existe
		        if ljp_json.GetChildCount(ll_files_arr) > 0 then
		            ll_first_file = ljp_json.GetChildItem(ll_files_arr, 1)
		            
		            
		            ls_name = ljp_json.GetItemString(ll_first_file, "name")
		            ls_name = right(ls_name, len(ls_name) -len("AutoGeneratedImages.Models." ))
						
		            // 4. Ajouter les données dans la DataWindow
		            ll_row = dw_liste.InsertRow(0)
		            dw_liste.SetItem(ll_row, "capture_date", ld_captureDate)
		            dw_liste.SetItem(ll_row, "id", ls_id)
		            dw_liste.SetItem(ll_row, "name", ls_name)
		        end if
		    end if
		next
		
		Destroy ljp_json
		
		// on ordonne de manière croissante
		dw_liste.sort()
		
		
		tot = dw_liste.rowcount()
		if  tot > 0 then 
			// on reparcourt la liste pour mettre temps de traitement par défaut
			ld_dernier_temps_traitement = proposition_temps_traitement(var_code_local)
		
			// on met le dernier temps sur les dernières dates	et on les sélectionne
			ld_derniere_date = dw_liste.getitemdate(tot, "capture_date")
			
			for lig = 1 to tot
				if ld_derniere_date = dw_liste.getitemdate(lig, "capture_date") then 
					dw_liste.setitem(lig, "temps_traitement", ld_dernier_temps_traitement)
					dw_liste.setitem(lig, "selection","O") 
				end if
				
				// Type d'image par défaut
				ls_name = upper(dw_liste.GetItemString(lig, "name"))
				if ls_name = "SIDEVIEW.PNG" then 
					dw_liste.SetItem(lig, "type_image", 46)
				else
					if ls_name = "UPPERJAWSCAN.PNG" then 
						dw_liste.SetItem(lig, "type_image", 40)
						else
							if ls_name = "LOWERJAWSCAN.PNG" then 
								dw_liste.SetItem(lig, "type_image", 41)
							end if
						end if
				end if
				
				
			next
			
		else
			Messagebox("ATTENTION", "Ce patient n'a aucune image à importer de 3Shape !")
		end if
		
		
	
	
		
		close(w_patience)
		
		
	else
		close(this)
	
	end if
else
	close(this)
end if
end event

