 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"type_image~" ) COLUMN(NAME=~"type_image.actif~") COLUMN(NAME=~"type_image.ordre_trie~") COLUMN(NAME=~"type_image.libelle~") COLUMN(NAME=~"type_image.code_courrier~") COLUMN(NAME=~"type_image.id~") COMPUTE(NAME=~"(select isnull(count(*),0) from type_image_mots_clefs where id_type_image  = type_image.id) as nb_mots_clefs~")WHERE(    EXP1 =~"~~~"type_image~~~".~~~"actif~~~"~"   OP =~"=~"    EXP2 =~"1~" ) ) " update="type_image" updatewhere=1 updatekeyinplace=no  sort="ordre_trie A libelle A id A " )
