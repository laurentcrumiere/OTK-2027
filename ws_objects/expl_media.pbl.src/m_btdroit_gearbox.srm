type m_envoyerparemailpiècejointe from menu within m_btdroit_gearbox
end type

event clicked;


string v_fichier_photo
double var_code_local
boolean v_suite = true

long nb_images_selectionnees, cpt
double taille_totale

nb_images_selectionnees = selectionner_images_courantes()

taille_totale = 0
for cpt = 1 to nb_images_selectionnees
	taille_totale = taille_totale +  FileLength(photo_courante[cpt])
next


if nb_images_selectionnees = 0 then
	// Email uniquement de l'image courante
	nb_images_selectionnees = 1
	photo_courante[1] = gb2.fichier_photo
else
	// Email de plusieurs images ?
	// on convertit en Mo
	taille_totale = taille_totale / 1024 / 1024
		
	// depuis 2016, on ne mets l'alerte que si > 3 Mo
	if nb_images_selectionnees > 1 and taille_totale > 3 then
		if Messagebox("ATTENTION","Vous allez envoyer "+string(nb_images_selectionnees)+" images en Pièces Jointes.~nTaille des fichiers : " + string(taille_totale , "###0.00") +" Mo~n~nConfirmez-vous ?",Question!,YesNo!,2) = 2 then 
			v_suite = false
		end if
	end if
end if

if v_suite then
	
	v_fichier_photo = photo_courante[1]
	var_code_local =  gb2.var_num_dossier 

	if len(trim(v_fichier_photo))> 0 and fileExists (v_fichier_photo) then

		open(w_patience)

		uo_email_compte		cpt_email
		uo_email_email 		email
		str_email_frm_output		frm_output
		
		
		integer id_cpt
		
//		// recherche de l'ID du cpt mail par def du prati du patient
//		SELECT cpt_mail INTO :id_cpt FROM prati, patient
//		WHERE patient.code_praticien = prati.code AND patient.code = :var_code_local ;
//		
//		if isnull(id_cpt) then
//			// pas de compte mail par defaut sur ce prati
//			// --> on choisi le premier de la liste des cpt order by ordre_tri, nom
//			select id into :id_cpt from email_comptes order by ordre_tri, nom ;
//		end if
		
		id_cpt = compte_email_a_utiliser(utilisateur_code, var_code_local)

		if id_cpt = -1 then
			
			MessageBox("ATTENTION","Vous devez définir des Comptes Emails pour chaque praticien avant d'envoyer des emails (menu 'Tables', 'Administratif').~n~nCeci ne semble pas être le cas.~n~nL'envoi de l'email ne peut avoir lieu.")
			
		else
			
			// init cpt mail et affection au mail manager
			cpt_email = create uo_email_compte
			cpt_email.charger(id_cpt)
			email_manager.set_compte(cpt_email)
			
			// Envoi unitaire
			email_manager.propos_objet = cpt_email.email_objet_defaut
			email_manager.mode_choix_adr_courant = email_manager.mode_choix_adr_unitaire
			
			
			// Fenetre de choix du destinataire
	
			// Génératon du fichier rtf pour passage en paramètre
			string is_FileName
			integer num_fichier_texte
			string fichier_texte_avec_adresses
			integer num_fichier_texte_avec_adresses
			string texte_lu
		
			is_FileName = dir_ini + "texte_email_tmp.rtf"
			num_fichier_texte = FileOpen( is_FileName, StreamMode! , Write! , LockWrite! , replace!)
			FileWrite(num_fichier_texte, cpt_email.texte_brut_defaut)
			FileClose(num_fichier_texte)
	
			
			str_patient v_patient
			v_patient.code = var_code_local
			v_patient.appelant = 'I'	// image
			
			openwithparm(w_email_choix_adr_pat, v_patient)
			
			// réception des éléments de la fenêtre précédente
			frm_output = message.PowerObjectParm
			
			if frm_output.a_adrs[1] <> '' then			// correspond au bouton annuler de la fenêtre de choix d'adresse
			
			
				if frm_output.envoi_securise then
					If Belgique then
						// envoi messagerie spéciale via myOrthokis
						// Envoi unitaire
						fxg_envoi_mail_securise_ehealth(frm_output , var_code_local, email, photo_courante)
					else
						if France then 
							fxg_envoi_mail_securise_france(frm_output , var_code_local, email, photo_courante)
						end if
					end if
				
				else
	
				
				
				
					string fichier_texte, fichier_texte_patient 
					
					fichier_texte = dir_ini + "texte_email_tmp.html"
					fichier_texte_avec_adresses = dir_ini + "texte_email_adresses_tmp.text"
					fichier_texte_patient = dir_photos + string(var_code_local) + win_delimiter + string(today(), "yyyy-mm-dd")+" "+string(now(),"hh-mm-ss") + " - Texte email.html"
					
					
					//creation et envoie email
					email = create uo_email_email
					email.set_patient(var_code_local)
					email.add_destinataire_a(frm_output.a_adrs[1], false)
					email.set_from(cpt_email.my_alias,cpt_email.my_adr)
					email_manager.propos_objet = frm_output.objet 
					email.set_sujet(email_manager.propos_objet)
					email.set_body_html(fichier_texte)		
					if frm_output.cc then 
						email.set_cc(cpt_email.my_alias, cpt_email.my_adr)
					end if
					if frm_output.cci then 
						email.set_cci(cpt_email.my_alias, cpt_email.my_adr)
					end if
																
					// On envoie les fichiers en tant que Pièce jointe !!!
					for cpt = 1 to nb_images_selectionnees
						email.add_fichier_joint(photo_courante[cpt])
					next
												
					// On ajoute les éventuelles PJ supplémentares ... 
					for cpt = 1 to upperbound(frm_output.pj_supplementaires[])
						email.add_fichier_joint(frm_output.pj_supplementaires[cpt])
					next

					if email_manager.envoyer_email(email.get_email()) then
								
						// Mise en historique de l'envoi de l'email
						
						// On génère un fichier texte contenant la liste des destinataires ... meme nom que le fichier en PJ avec .dest comme extension
						int ret
						email.generer_fichier_adresses(fichier_texte_avec_adresses, fichier_texte_patient, frm_output)
		//				num_fichier_texte_avec_adresses = FileOpen(fichier_texte_avec_adresses, LineMode! , Write! , LockWrite! , replace!)
		//				FileWrite(num_fichier_texte_avec_adresses, frm_output.a_adrs[1])
		//				FileClose(num_fichier_texte_avec_adresses)
						
						
						// Copy du fichier pour mémo
						FileCopy(fichier_texte, fichier_texte_patient)
		//				FileCopy(fichier_texte_avec_adresses, fichier_texte_patient + ".dest" )
						
						string v_code_interne_historique_editions
						
						v_code_interne_historique_editions = fxg_enregcourrierhisto ( var_code_local , "EMAIPJ" , today() , "Envoi email fichier : " + gfx_extraire_nom_fichier(v_fichier_photo) , fichier_texte_patient , 'E', 'N' ,'N', '', frm_output.categorie)
						fxg_memorisation_pieces_jointes(var_code_local, v_code_interne_historique_editions,  email.fichiers_joints , false)
						
						// Le fichier est parti
						MessageBox("INFORMATION","L'email a été correctement envoyé.")
						
					else
						MessageBox("ATTENTION","Une erreur s'est produite dans l'envoi de l'email !")
					end if
				end if
			end if
			close(w_patience)
		end if
	end if
end if
end event

