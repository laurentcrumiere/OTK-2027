event clicked;boolean	onStope


if fxg_FileExists( gb2.fichier_photo ) then
// si fichier existe déjà
	if messagebox("ATTENTION ... ", "Un fichier est déjà présent sur ce cadre photo. ~n~nVoulez-vous vraiment le remplacer ?", Exclamation!, YesNo!) = 2 then
		// si on ne souhaite pas le remplacer
		onStope = true
	end if
end if

if not onStope then
	gb2.coller()
end if

end event

type m_déplacervers from menu within m_btdroit_gearbox
end type

event clicked;
// Depuis 2012 ... on peut sélectionner plusieurs images à déplacer SI ON EST DANS LA FENETRE IMAGERIE

string vide = ""

string chemin_fichier, nom_fichier
string libelle_defaut

boolean deplacer = true

string chemin_fichier_source
string chemin_fichier_destination, cadre_destination_depart
long numero_cadre_destination
string chemindossier

// Fichier Word en dur
string fichier_doc 
integer tot_selection, cpt_courante

// On recherche les images courantes
tot_selection = selectionner_images_courantes()

// on se sert de la variable global var_suite pour dire qu'on a sélectionné ou pas plusiers images à déplacer
if tot_selection = 1 then
	// rien de coché ou pas page imagerie => que la photo sélectionnée
	photo_courante[1] = gb2.fichier_photo
	Date_Image_Courante[1] = string( gb2.date_image )
	var_suite = false
else
	var_suite = true
end if

// paramètres en retour dans PARAM_WIN  1 et 2
//ouvre la fenétre de déplacement
openwithparm(w_deplacer_vers,gb2)


if len(trim(param_win[1])) > 0 and  len(trim(param_win[1])) > 0 then
	// retour de paramètres => on traite
	
	chemin_fichier_destination = param_win[2]
	cadre_destination_depart = param_win[1]		// Contient ole_photoxxx
	
	if not var_suite then
		// Déplacement d'un seul fichier 
		
		if fxg_FileExists(chemin_fichier_destination) then
			// le fichier de destination existe dejà
			if MessageBox("ATTENTION","Le cadre de destination contient déjà une photo.~n~nVoulez-vous la remplacer ?", Question!,YesNo!, 2) = 1 then 
				gb2.image_supprimer(gb2.var_num_dossier, chemin_fichier_destination) 
			else
				// déplacement annulée ...
				deplacer = false
			end if
		end if
	else
		// Déplacement de plusieurs fichiers			
		if MessageBox("ATTENTION","Vous avez sélection "+string(tot_selection)+" images à déplacer.~n~nLors du déplacement, si besoin, elle remplaceront des images éventuellement présentes dans les cadres de destination.~n~nConfirmez-vous ?", Question!,YesNo!, 2) = 2 then 
			// déplacement annulée ...
			deplacer = false
		end if
	end if
end if
	
if deplacer then
	
	boolean operation_ok = false
	date data_acquis_fichier_source
	
	// Dossier photo du patient
	chemin_fichier_source = trim(photo_courante[1])
	chemindossier = gfx_extraire_path_fichier(chemin_fichier_source)

	for cpt_courante = 1 to tot_selection
	
		// on copie (<=> acquis du fichier source en destination)

		chemin_fichier_source = trim(photo_courante[cpt_courante])
		
		numero_cadre_destination = long(right(cadre_destination_depart, 3)) + cpt_courante - 1
		chemin_fichier_destination = chemindossier + profilestring(dir_photos + inifile_photo, section, "ole_photo" + num_nom_photo(numero_cadre_destination),"")
		
		if gb2.charger_image(chemin_fichier_source) then 
			// recup date acquis
			data_acquis_fichier_source = gb2.image_info_persist_get(gb2.var_num_dossier, chemin_fichier_source)
			if gb2.importer_une_image( chemin_fichier_source, chemin_fichier_destination) = 1 then 
				// enreg date acquis
				if gb2.image_info_persist_set(gb2.var_num_dossier, chemin_fichier_destination, data_acquis_fichier_source) then
					// suppr du fichier source
					if gb2.image_supprimer(gb2.var_num_dossier, chemin_fichier_source) then 
						operation_ok = true
						faire_vignette_pour( chemin_fichier_destination, gb2.var_num_dossier )
					end if
				end if
			end if
		end if
	next
	
	// fin de l'opération
	if operation_ok then
		messagebox("INFORMATION","Opération terminée avec succés !")
		
		// Si on est dans l'imagerie, on raffraichit et on déselectionne tout ...
		if appel_depuis_imagerie then
			w_expl_media w2
			w2 = w1.v_fenetre_parent
			w2.tab_images.cb_raffraichir.triggerevent(clicked!)
			w2.tab_images.pb_deselectionne.triggerevent(clicked!)
		end if
		
		// Si on est dans l'imagerie, on raffraichit et on déselectionne tout ...
		if appel_depuis_imagerie_2013 then
			w2013.tab_controles.tabpage_accueil.cb_raffraichir.triggerevent(clicked!)
			w2013.tab_controles.tabpage_accueil.pb_deselectionne.triggerevent(clicked!)
		end if

	else
		messagebox("ERREUR ... ","Une erreur s'est produite. Opération annulée !", StopSign!)
	end if 
end if



end event

