event clicked;string	pass_parameters	//string contenant infos a passer par "OPEN" de la fenetre acquisition fichier
string	cl_name				//pour passer le bon param suivant photos ARAKIS ou clinique



cl_name = gb2.get_nom_cadre_ole()
cl_name = left(cl_name,len(cl_name) - 3)

pass_parameters = string(gb2.var_num_dossier) + gb2.get_nom_cadre_ole()

if cl_name = "ole_photo" then
	pass_parameters = "1" + pass_parameters
else
	pass_parameters = "2" + pass_parameters
end if

//ouvre la fenétre d'acquisition fichier
openwithparm(w_acquisition_fichier,pass_parameters)

//affiche la photo fraichement acquise
if FileExists(gb2.fichier_photo ) then
	faire_vignette_pour( gb2.fichier_photo, gb2.var_num_dossier )
	if gearbox_cliquee then
		gb2.rafraichir_var_cadre(gb2.nom_cadre_ole)
	else
		uo_image_cliquee.charger_image(true, false)
	end if
end if

	



end event

type m_acquisitionidentitekitview from menu within m_btdroit_gearbox
end type

event clicked;
long var_code_local
string nom_du_cadre
string v_fichier_photo_kitview
string vers_dossier_photo	//le rep photo\num_patient
string key						//le nom de la photo donnée par "pwophoto.INI"

boolean ok_acquis = false


var_code_local = gb2.var_num_dossier
nom_du_cadre = gb2.get_nom_cadre_ole()

lien_kitview lien_kit
lien_kit = create lien_kitview
	
lien_kit.init(var_code_local)
	
v_fichier_photo_kitview = lien_kit.getphotoidentite()

if len(trim(v_fichier_photo_kitview)) > 0 then
	
	vers_dossier_photo = dir_photos + string(var_code_local)
	if not fxg_FileExists(vers_dossier_photo) then CreateDirectory(vers_dossier_photo)
	
	key = ProfileString(dir_photos + inifile_photo, section, nom_du_cadre , "Oups!")
	if key = "Oups!" then goto Fin
	vers_dossier_photo = vers_dossier_photo + win_delimiter + key
	
	if FileExists(vers_dossier_photo) then
		if messagebox("Attention ...", "Une image est déjà présente sur ce cadre. ~nPar conséquent l'acquisition entraînera la perte de cette image ! ~n~n Confirmez-vous ?", Exclamation!, OKCancel!) = 1 then
			if fileCopy(v_fichier_photo_kitview,vers_dossier_photo, true ) = 1 then
				ok_acquis = true
			else
				goto erreur
			end if 
		end if
	else
	//if ole_previsu.acquis_fichier_photo(path_fichier_image,vers_dossier_photo,ole_previsu) <> 1 then goto erreur
		if fileCopy(v_fichier_photo_kitview,vers_dossier_photo, true ) = 1 then
			ok_acquis = true
		else
			goto erreur
		end if
	end if
else
		messagebox("Attention !","Ce patient n'a pas de photo d'identité dans Kitview")

end if
goto Fin



Erreur:
	messagebox("Attention !","Une erreur est survenue dans l'acquisition de la Photo")

Fin:
	if ok_acquis then
		gb2.rafraichir_var_cadre(gb2.nom_cadre_ole)
	end if
	//on sort directement après l'acquisition



end event

