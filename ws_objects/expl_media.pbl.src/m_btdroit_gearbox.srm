type m_sauvegardersous from menu within m_btdroit_gearbox
end type

event clicked;
String	ls_File, ls_Path
string v_format
integer lc

lc = GetFileSaveName ( "Enregistrer l'image sous ...",   ls_path, ls_file, "jpg",  "Fichiers Jpeg (*.jpg*),*.jpg,Fichiers Bmp (*.bmp),*.bmp,Fichiers Tiff (*.tif),*.tif,Fichiers Png (*.png),*.png")

if lc = 1 then
	// Récupération du fichier ...
	
	if gb2.vignette then
		// Il faut recharger la VRAIE image, 
		gb2.ole_image.object.Loadimage = gb2.fichier_photo 
	end if	

	v_format = right(ls_file, 3)
	
	choose case v_format 
		case "bmp"
			gb2.ole_image.object.SaveFormat = IG_SAVE_BMP
		case "jpg"
			gb2.ole_image.object.SaveFormat = IG_SAVE_JPG
		case "tif"
			gb2.ole_image.object.SaveFormat = IG_SAVE_TIF
		case "png"
			gb2.ole_image.object.SaveFormat = IG_SAVE_PNG
	end choose

	gb2.ole_image.object.SaveImage = 	ls_Path

end if


end event

