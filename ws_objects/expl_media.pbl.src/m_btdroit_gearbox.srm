type m_copierversunautrepatient from menu within m_btdroit_gearbox
end type

event clicked;
double var_code_local, var_code_destination
string var_nom_destination, chemindossier_destination, fichier_destination, fichier_destination_complet
string v_prochain_cadre
string nom_fichier_origine

// Appel depuis l'explorateur de limagerie 2013 ?
string v_nom_fenetre_parent
v_nom_fenetre_parent = gb2.GetParent().GetParent().GetParent().className()

if left(v_nom_fenetre_parent,18) = "w_explorateur_2013" then
	w2013 = gb2.GetParent().GetParent().GetParent()

	if isValid(w2013) then
		
		integer cpt_a_copier = 0
		boolean v_suite = false
		string libelle_confirmation
		long i
		boolean erreur_de_copie = false

		cpt_a_copier = w2013.compter_images_selectionnees()

		if cpt_a_copier = 0 then
			if Messagebox("ATTENTION","Vous n'avez sélectionné aucune image.~n~nVoulez-vous sélectonner l'image cliquée ?", Question!, Yesno!, 2) = 1 then
				v_suite = true
				uo_image_cliquee.selectionne ( true )
				cpt_a_copier = 1
			end if
		else
				v_suite = true
		end if
		
		if v_suite then
			Messagebox("DOSSIER PATIENT DE DESTINATION","Vous devez indiquer à présent le dossier du patient de destination.")
		
			var_code_local = w2013.var_code_local
		
			open(w_cherche)
		
			if var_suite then
				var_code_destination = var_code
				var_nom_destination = var_nom
				
				// Confirmation
				if cpt_a_copier = 1 then
					libelle_confirmation = "Vous avez sélectionné une image.~n~nElle va être copiée "
				else
					libelle_confirmation = "Vous avez sélectionné " + string(cpt_a_copier) + " images.~n~nElles vont être copiées "
				end if
				
				if Messagebox("ATTENTION",libelle_confirmation + " dans le dossier de " + var_nom_destination + ".~n~nConfirmez-vous ?", Question!, Yesno!, 2) = 1 then
	
				open(w_patience)
				
				// Dossier de destination
				chemindossier_destination = dir_photos + string(var_code_destination)
			
				// On le crée si besoin
				if not fxg_FileExists(chemindossier_destination) then CreateDirectory(chemindossier_destination)
					chemindossier_destination = chemindossier_destination + "\"
		
					
					for i = 1 to w2013.nb_cadres_trouves
						if w2013.uoi[i].cbx_selection.checked then
							
							// pour savoir le prochain cadre "olephoto" disponible
							v_prochain_cadre = get_nom_prochain_cadre_image(var_code_destination)
							fichier_destination =  profilestring(dir_photos + inifile_photo, section, v_prochain_cadre ,"")
							fichier_destination_complet = chemindossier_destination + fichier_destination
							
							// Copie du fichier !!!
//							w2013.charger_image_gearbox(i)
//							FileCopy( 	 w2013.tab_controles.tabpage_accueil.ole_phototra.fichier_photo,  fichier_destination_complet)

							FileCopy( w2013.uoi[i].nom_fichier_complet	 ,  fichier_destination_complet)
							
							
							if FileExists( fichier_destination_complet ) then
								
								// Copie de la vignette 
								FileCopy( 	 w2013.uoi[i].nom_fichier_vignette_complet,  chemindossier_destination + "v" + fichier_destination )
								
								
								nom_fichier_origine = gfx_extraire_nom_fichier( w2013.uoi[i].nom_fichier_complet )
								// inscrition des éléments en base de données
								insert into images_infos (code, nom_fichier, date_acquis, type_image, temps_traitement, date_modif, commentaires_html) 
								select :var_code_destination, :fichier_destination, date_acquis, type_image, temps_traitement, date_modif, commentaires_html 
								from images_infos 
								where code = :var_code_local and nom_fichier = :nom_fichier_origine ;
								
								commit ;
								
							else
								Messagebox("ATTENTION","Une erreur s'est produite dans la copie.~n~nFichier source : " + w2013.tab_controles.tabpage_accueil.ole_phototra.fichier_photo +"~nFichier cible : " +fichier_destination_complet)
								erreur_de_copie = true
							end if
						end if
		
					next

					close(w_patience)
					
					if not erreur_de_copie then
						if Messagebox("INFORMATION","La copie a été réalisée avec succès.~n~nSouhaitez-vous ouvrir l'imagerie de "+ var_nom_destination + " pour vérifier ?", Question!, YesNo!, 1) = 1 then
							m_orthokis_2020.ouvrir_mdi(12)
						end if
					end if
				end if
			end if
		end if
	end if
end if

end event

