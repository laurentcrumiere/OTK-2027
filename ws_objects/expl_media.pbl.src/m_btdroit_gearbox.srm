type m_régénérertouteslesvignettesdupatient from menu within m_btdroit_gearbox
end type

event clicked;if not imagerie_2013 then
	Messagebox("ATTENTION","Cette fonctionnalité n'est disponible qu'en Imagerie 2013.")
else
	

	if left(gb2.GetParent().className(), 12) = "w_coment_maj" then
		Messagebox("ATTENTION","Cette fonctionnalité n'est disponible qu'à partir du module Imagerie.")
	
	else
	
		
		open(w_patience)
		
		
		// Vignettes pour les fichiers du patient
		DECLARE cur cursor for SELECT nom_fichier 
		from images_infos 
		Where code = :gb2.var_num_dossier ;
		
		string tab_liste_fichier[]
		long lig, tot	
		
		// On construit la liste des fichiers dans un tableau car faire_vignette met à jour la base de données => ça pine avec un curseur
		
		string v_nom_fichier
		
		open cur ;
		
		fetch cur into :v_nom_fichier ;
		lig = 0
		do while sqlca.sqlcode = 0 
			lig = lig + 1
			tab_liste_fichier[lig] = v_nom_fichier
			fetch cur into :v_nom_fichier ;
		loop
		close cur ;
		
		
		tot = lig
		for lig = 1 to tot
			v_nom_fichier = dir_photos + string(gb2.var_num_dossier) + win_delimiter + tab_liste_fichier[lig]
			if FileExists(v_nom_fichier ) then 
				faire_vignette_pour( v_nom_fichier, gb2.var_num_dossier )
			end if
		next
		
		
		// Appel depuis l'explorateur de limagerie 2013 ?
		
		string v_nom_fenetre_parent
		v_nom_fenetre_parent = gb2.GetParent().GetParent().GetParent().className()
		
		if left(v_nom_fenetre_parent,18) = "w_explorateur_2013" then
			w2013 = gb2.GetParent().GetParent().GetParent()
		
			if isValid(w2013) then
				w2013.tab_controles.tabpage_accueil.cb_raffraichir.triggerevent(clicked!)
			end if
		end if
		
		close(w_patience)
	end if
end if
end event

