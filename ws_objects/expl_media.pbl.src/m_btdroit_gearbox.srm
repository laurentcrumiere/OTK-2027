event clicked;uo_lien_sidexis	uo_sidexis
string		fichier_a_importer


uo_sidexis = create uo_lien_sidexis

if uo_sidexis.ajout_et_selection_radio(gb2.var_num_dossier) = 1 then
// si SIDEXIS arrive à ouvrir le dossier patient + se positionner sur les choix des radios
	if messagebox( "Import " + uo_sidexis.get_nom_soft_radio() + " ...", "Une fois la radio sélectionnée sous " + uo_sidexis.get_nom_soft_radio() + ", ~ncliquez sur ~n~n* 'OK' pour finaliser l'opération d'import, ~n~n* 'Annuler' pour annuler l'opération.", Exclamation!, OKCancel! ) = 1 then
		// si on poursui l'import
		// on recup un chemin complet de fichier exporté par SIDEXIS
		fichier_a_importer = uo_sidexis.get_path_fichier_a_importer()
	end if
end if

destroy uo_sidexis

if fichier_a_importer <> "" then
// si chemin non vide
	gb2.visible = false
	
	// Mémorisation du nom de fichier destinataire dans Orthokis
	string fichier_dans_orthokis
	fichier_dans_orthokis = gb2.fichier_photo
	
	// on charge la photo ds imagear afin de la traiter
	gb2.charger_image(fichier_a_importer)
//	if gb2.importer_une_image( fichier_a_importer, gb2.fichier_photo) = 1 then
	if gb2.importer_une_image( fichier_a_importer, fichier_dans_orthokis) = 1 then
		DeleteFileA( fichier_a_importer )
	end if
	
	//affiche la photo fraichement acquise
	if FileExists(gb2.fichier_photo ) then 
		faire_vignette_pour( gb2.fichier_photo, gb2.var_num_dossier )
		gb2.rafraichir_var_cadre(gb2.nom_cadre_ole)
	end if
	
	
	//rafraichir_expl_media( )
	
	gb2.visible = true
end if

end event

