// on est sur une gearbox => on parle des mots clefs généraux !!
if gearbox_cliquee then
	// on doit passer en paramètre le N° de la photos
	
	long numero_cadre
	
	numero_cadre = long(right(gb2.nom_cadre_ole, 3))
	
	OpenWithParm(w_affectations_mots_clefs_gear, numero_cadre)
	
	// Si le nom du cadre image a été modifié la fenêtre renvoie 1
	// => Faut raffraichir l'image 
	
	if Message.DoubleParm = 1 then
		gb2.init_gearbox()
	end if
else
	// On est sur une cadre image 2013 .. => 
	OpenWithParm(w_affectations_type_temps_image, uo_image_cliquee)
	uo_image_cliquee.maj_type_temps()
end if





end event

