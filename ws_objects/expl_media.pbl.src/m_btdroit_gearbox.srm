uo_image uo_image_cliquee

boolean gearbox_cliquee = true		// vaudra true si on a cliquée d'un uo_gearbox, false si clic d'un uo_image

// Pour la sélection des images courantes
string photo_courante[], date_image_courante[], commentaire_image_courante[]
constant integer nb_photos_courantes_maxi = 20

// On determine la nature de la fenêtre appelante ... sera utilisée notamment dans le fonction sélectionner_images_dourantes
w_diagnos_maj_miniatures w1
w_explorateur_2013 w2013

boolean appel_depuis_imagerie = false
boolean appel_depuis_imagerie_2013 = false

end variables

