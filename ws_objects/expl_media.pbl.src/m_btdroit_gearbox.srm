type m_tridim from menu within m_btdroit_gearbox
end type

event clicked;

// Permet d'envoyer l'image courante dans TriDim ....

// Au passage, ça crée le patient s'il n'existe pas ... si le user le souhaite


double var_code_local 


// récup des infos du patients

// récup des infos de la dw
string v_nom, v_prenom, v_sexe
date v_date_naissance
double v_numero_dossier
long id_patient_tridim

string v_fichier 

v_fichier = gfx_extraire_nom_fichier (gb2.fichier_photo)

var_code_local = gb2.var_num_dossier

select nom, prenom, sexe, date_naissance, numero_dossier 
into :v_nom, :v_prenom, :v_sexe, :v_date_naissance, :v_numero_dossier
from patient where code = :var_code_local ;

lien_triDim ObjetTridim_local

ObjetTridim_local = create lien_triDim

if ObjetTridim_local.connection_Tridim() = 1  then

	if ObjetTridim_local.Delaire_ou_Tridim = "D" then
		ObjetTridim_local.DelaireObject.minimize()
	end if 
		
	// quel type de radio
	OpenWithParm(w_delaire_type_image, ObjetTridim_local.Delaire_ou_Tridim )
	
	string type_radio
	// renvoie le type de radio ...
	type_radio = Message.StringParm
	
	//messagebox("type_radio", type_radio)
	
		
	if ObjetTridim_local.Ouvrir_patient_tridim(var_code_local, "I") = 1 then
		// le patient a été si besoin ajouté !!!
		
		date v_date_photo
		
		select date_acquis into :v_date_photo from images_infos where code = :var_code_local and nom_fichier =  :v_fichier ;
		
		if ObjetTridim_local.delaire_ou_tridim = "T" then
			// importation de la radio ..
			id_patient_tridim = ObjetTridim_local.TridimObject.PatientCourant.Id
			choose case type_radio
				case '11'
					ObjetTridim_local.TridimObject.ImportPhoto(id_patient_tridim, 11, gb2.fichier_photo, string(v_date_photo))
				case '12'
					ObjetTridim_local.TridimObject.ImportPhoto(id_patient_tridim, 12, gb2.fichier_photo, string(v_date_photo))
				case '13'
					ObjetTridim_local.TridimObject.ImportPhoto(id_patient_tridim, 13, gb2.fichier_photo, string(v_date_photo))
				case '14'
					ObjetTridim_local.TridimObject.ImportPhoto(id_patient_tridim, 14, gb2.fichier_photo, string(v_date_photo))
			end choose
		else
			// logicel Delaire Elements
			string a
			a = ObjetTridim_local.DelaireObject.Version()
			
			if ObjetTridim_local.DelaireObject.Version() >= "1.1.5337.17172" then
				string numRadioExt = ""
				
				string t1, t2, t3, t4, t5, t6
				t1 = string(var_code_local)
				t2 = gb2.fichier_photo
				t3 = type_radio
				t4 =  string(v_date_photo, "mm/dd/yyyy")
				t5 = numRadioExt
				//ObjetTridim_local.DelaireObject.ImportImagePatientEx(string(var_code_local), gb2.fichier_photo, type_radio, string(v_date_photo, "mm/dd/yyyy"), numRadioExt) 
				t6 = string(ObjetTridim_local.DelaireObject.ImportImagePatientEx(string(var_code_local), gb2.fichier_photo, type_radio, string(v_date_photo, "mm/dd/yyyy"), numRadioExt) )
			else
				ObjetTridim_local.DelaireObject.ImportImagePatientEx(string(var_code_local), gb2.fichier_photo, type_radio, string(v_date_photo, "mm/dd/yyyy")) 
			end if

		end if
		ObjetTridim_local.activer_tridim()
	end if
end if
	 
end event

