type m_acquerir from menu within m_btdroit_gearbox
end type

event clicked;string		chemindossier
security_attributes		sa

	
// init spécif
gb2.ole_image.object.ScanShowUI = true

// lance l'IU TWAIN de l'appareil
gb2.ole_image.object.ScanAcquire = True

// si bien récup un flux de données
if gb2.ole_image.object.ErrCount <> 0 Then goto Erreur

// création chemin photo patient
chemindossier = dir_photos + string(gb2.var_num_dossier)
if fxg_FileExists(chemindossier) then 
	// le rep photo patient existe déjà --> on essaye de suppr l'image de ce cadre si présente
	gb2.image_supprimer(gb2.var_num_dossier, gb2.fichier_photo)
else
	CreateDirectory(chemindossier)
end if

// config du format de destination
if gb2.config_format_de_save(gb2.fichier_photo) <> 1 then goto Erreur

// sauvegarde du fichier
gb2.ole_image.object.SaveImage = gb2.fichier_photo

if utilisation_distante then
	fxg_ajout_acquis_distante ( gb2.var_num_dossier, gb2.fichier_photo ) 
end if


if gearbox_cliquee then 
	// on a cliqué sur une gear box

	// charge le fichier pour s'assurer que tout est ok
	if FileExists(gb2.fichier_photo ) then gb2.charger_image(gb2.fichier_photo)
	rafraichir_expl_media( )
else
	uo_image_cliquee.charger_image(true, false)
end if







goto Fin
Erreur:
	messagebox("Attention !","Une erreur est survenue dans l'acquisition de votre Image")
Fin:
end event

