type m_odrade from menu within m_btdroit_gearbox
end type

event clicked;
// utile pour initialiser les photos imagerie 2013
uo_choix_image_2013 choix_image_2013
choix_image_2013 = create uo_choix_image_2013


constant string reg_path = "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\Odrade.exe"

double 	version_base_odrade
string 	dir_odrade 			// Répertoire d'installation de Odrade
string 	exe_odrade 			// Fichier Odrade.exe
string 	fichier_param		// Fichier paramètres
string 	argument

boolean v_suite

string v_source, v_engine

long 		num_file				// pour écrire dans le fichier paramètre

double var_code_local, v_numero_dossier
string v_nom_patient, v_prenom_patient, v_sexe
date v_date_naissance


//récup le rép d'install d'ODRADE et y ajoute odrade.exe
RegistryGet(reg_path,"path",dir_odrade)
fichier_param = dir_odrade +"\import.txt"
exe_odrade = dir_odrade +"\Odrade.exe"


// voici la syntaxe des arguments a passer en param à l'ouverture d'Odrade
// --> LIEN#Nom_fichier_param#
// Attention, LIEN doit être en MAJUSCULES

// Ecriture dans un fichier pour passer les pramètres à ODRADE
num_file = fileopen(fichier_param,linemode!,write!,LockWrite!,replace!)
FileWrite(num_file,"'Fichier de liaison ORTHOkis <-> Odrade")
FileWrite(num_file,"")

long v_code_utilisateur_odrade 
string v_mdp_odrade, v_nom_utilisateur_odrade
long v_analyse_odrade


// code du patient
var_code_local = gb2.var_num_dossier


// Récupération des infos de l'utilisateur
select isnull(user_odrade,-1), isnull(mdp_odrade,''), isnull(analyse_odrade,-1)  
into :v_code_utilisateur_odrade, :v_mdp_odrade, :v_analyse_odrade 
from utilisateurs where code = :utilisateur_code ;

// si l'utilisateur Odrade n'est pas renseigné, on ouvre la fenêtre de configuration
do while v_code_utilisateur_odrade = -1 
	
	MessageBox("ATTENTION","Vous n'avez pas définit d'utilisateur ODRADE pour votre profil.~n~nVous allez devoir en configurer un !")
	
	openWithParm(w_utilisateur_fiche_odrade, utilisateur_code)

	// Récupération des infos de l'utilisateur
	select isnull(user_odrade,-1), isnull(mdp_odrade,''), isnull(analyse_odrade,-1)  
	into :v_code_utilisateur_odrade, :v_mdp_odrade, :v_analyse_odrade 
	from utilisateurs where code = :utilisateur_code ;

loop


if imagerie_2013 then
	
	double v_temps, v_type
	string v_nom_fichier_seul
	date v_date_image
	
	// recherche si l'image a un temps de traitement 
	v_nom_fichier_seul = gfx_extraire_nom_fichier(gb2.fichier_photo )
	select isnull(temps_traitement,0), isnull(type_image,0), date_acquis into :v_temps, :v_type , :v_date_image from images_infos where nom_fichier = :v_nom_fichier_seul and code = :var_code_local ;
	
	if not v_temps > 0 then
		Messagebox("ATTENTION","Cette image n'a pas d'Etape de traitement.~n~nVous devez en affecter une pour faire un tracé avec Odrade.")
		FileClose(num_file)
		v_suite = false
	else
		if not v_type > 0 then
			Messagebox("ATTENTION","Cette image n'a pas de Type d'image.~n~nVous devez en affecter un pour faire un tracé avec Odrade.")
			FileClose(num_file)
			v_suite = false
		else
			v_suite = true
		end if
	end if
else
	v_suite = true
end if

if v_suite then

	
	// recherche du nom du user dans Odrade
	if connexion_base_odrade() = 1 then 
	
	
		// Verification de la version de Odrade
		
		select max( cast (texte as double))  into :version_base_odrade  from messages where code_message = 8000 using t_odrade ;
		
		if version_base_odrade >= 5 then
		
			v_suite = true
			
			if imagerie_2013 then
				if version_base_odrade < 6.1 then
					if MessageBox("ATTENTION","Vous utilisez atuellement l'imagerie 2013 d'Orthokis. Celle-ci est pleinement fonctionnelle avec Odrade 2012 à partir de la version 6.1 (or vous être actuellement en version "+string(version_base_odrade)+".~n~nVous allez tout de même accéder à l'analyse d'Odrade mais, si vous avez paramétré l'importation automatique de tracé ou de mesures, celle-ci ne sera pas effectuée.~n~nVous devriez faire une mise à jour d'Odrade.~n~nSouhaitez-vous poursuivre ?",Question!,Yesno!,2) = 2 then
						v_suite = false
						deconnexion_base_odrade()
					end if
				end if
			end if
		
			if v_suite then
				
				// recherche du nom du user dans Odrade
		
				select nom into :v_nom_utilisateur_odrade 
				from utilisateurs where code_utilisateur = :v_code_utilisateur_odrade using t_odrade ;
				deconnexion_base_odrade()
			
				if Utilisation_distante then
					v_source = "Orthokis_local"
				else
					v_source = "Orthokis"
				end if
				
				v_engine = fxg_get_infos_sybase("name")
				
				FileWrite(num_file,"[DATABASE]")
				FileWrite(num_file,"Source=" + v_source)
				FileWrite(num_file,"EngineName=" + v_engine)
				if imagerie_2013 then
					FileWrite(num_file,"Imagerie_2013=1")
				else
					FileWrite(num_file,"Imagerie_2013=0")
				end if
				FileWrite(num_file,"")
		
		
				FileWrite(num_file,"[USER]")
				FileWrite(num_file,"IdSoft=ORTHOKIS")
				FileWrite(num_file,"IdUserOdr=" + string(v_nom_utilisateur_odrade))
				FileWrite(num_file,"MdpUserOdr=" + v_mdp_odrade)
				FileWrite(num_file,"")
				
				// Récupération des infos du patient
				
				select nom, prenom, numero_dossier, date_naissance, sexe
				into :v_nom_patient, :v_prenom_patient, :v_numero_dossier, :v_date_naissance, :v_sexe 
				from patient 
				where code = :var_code_local ;
				
				if not isnull(v_date_naissance) then
				
					// recupération des param généraux
					string v_odrade_import_trace, v_odrade_import_tableau, v_odrade_fermer, v_odrade_import_impression
					integer v_odrade_cadre_import_trace, v_odrade_cadre_import_tableau, v_odrade_cadre_import_impression
					long v_odrade_export_trace_hauteur, v_odrade_export_trace_largeur
					
					string cadre_import_impression, fichier_cadre_import_impression, v_imprimer_resume, v_rep_photo_patient
		
		
					// Le select est coupé en 2 car ça pine sinon ... va comprendre Charles !!!
					select odrade_import_trace, odrade_import_tableau, odrade_cadre_import_trace, odrade_cadre_import_tableau, odrade_fermer 
					into :v_odrade_import_trace, :v_odrade_import_tableau, :v_odrade_cadre_import_trace, :v_odrade_cadre_import_tableau, :v_odrade_fermer 
					from param ;
		
					select odrade_export_trace_hauteur, odrade_export_trace_largeur, odrade_import_impression, odrade_cadre_import_impression , odrade_imprimer_resume
					into :v_odrade_export_trace_hauteur, :v_odrade_export_trace_largeur , :v_odrade_import_impression, :v_odrade_cadre_import_impression, :v_imprimer_resume 
					from param ;
									
					// Recherche si photo d'identité pour le patient ou pas pour l'envoyer
					
					// Nom du fichier configuré pour la photo d'identité des commentaires cliniques
					string fichier_identite_clinique, fichier_identite_clinique_nom, fichier_identite_clinique_complet
					string fichier_identite_clinique_date
					date date_image
					
					
					v_rep_photo_patient = dir_photos + string(var_code_local) + win_delimiter
					
					if Imagerie_2013 then
						fichier_identite_clinique = choix_image_2013.trouver_image ("identite_commentaires_cliniques", var_code_local)
						
						if len(trim(fichier_identite_clinique)) > 0 then 
							fichier_identite_clinique_complet = v_rep_photo_patient + fichier_identite_clinique
							
							long v_temps_id, v_type_id
							date v_date_id
							string v_lib1, v_lib2
							select isnull(temps_traitement,0), isnull(type_image,0), date_acquis into :v_temps_id, :v_type_id , :v_date_id 
							from images_infos where nom_fichier = :v_nom_fichier_seul and code = :var_code_local ;
							
							select isnull(libelle,'') into :v_lib1 from temps_traitement where id = :v_temps_id ;
							select isnull(libelle,'') into :v_lib2 from type_image where id = :v_type_id ;
		
							fichier_identite_clinique_nom = v_lib2 + " - " + v_lib1 
							fichier_identite_clinique_date = string(v_date_id)
						else
							fichier_identite_clinique_complet = ""
							fichier_identite_clinique_nom= ""
							fichier_identite_clinique_date = ""
						end if
							
					else
						fichier_identite_clinique = profilestring( dir_photos + inifile_photo, "ARAKIS", "ole_photo_arakis002","")
						fichier_identite_clinique_complet = gb2.rep_photo_patient + fichier_identite_clinique
					
		
						select odrade_import_trace, odrade_import_tableau, odrade_cadre_import_trace, odrade_cadre_import_tableau, odrade_fermer 
						into :v_odrade_import_trace, :v_odrade_import_tableau, :v_odrade_cadre_import_trace, :v_odrade_cadre_import_tableau, :v_odrade_fermer 
						from param ;
						
						if FileExists(fichier_identite_clinique_complet) then
							fichier_identite_clinique_nom = profilestring( dir_photos + inifile_photo, "ARAKIS", "ole_nom_photo_arakis002","")
						
							Select date_acquis into :date_image from images_infos 
							where code = :var_code_local and nom_fichier = :fichier_identite_clinique ;
						
							if isnull(date_image) then
								fichier_identite_clinique_date = ""
							else
								fichier_identite_clinique_date = string(date_image)
							end if
						else
							fichier_identite_clinique_complet=""
							fichier_identite_clinique_nom = ""
							fichier_identite_clinique_date = ""
						end if
						
					end if
					
					
					FileWrite(num_file,"[PATIENT]")
					FileWrite(num_file,"Nom=" + v_nom_patient )
					FileWrite(num_file,"Prénom=" + v_prenom_patient )
					FileWrite(num_file,"CodeInterne=" + string(var_code_local) )
					FileWrite(num_file,"NumDossier=" + string(v_numero_dossier))
					FileWrite(num_file,"DateNaissance=" + string(v_date_naissance))
					FileWrite(num_file,"Sexe=" + v_sexe)
					FileWrite(num_file,"PhotoId=" + fichier_identite_clinique_complet)
					FileWrite(num_file,"PhotoIdDate=" + fichier_identite_clinique_date)
					FileWrite(num_file,"PhotoIdNom=" + fichier_identite_clinique_nom)
					FileWrite(num_file,"")
					
					
					
					FileWrite(num_file,"[IMAGE]")
					FileWrite(num_file,"CheminImage=" + gb2.fichier_photo )
					
					if imagerie_2013 then
						string v_lib 
						select isnull(libelle,'') into :v_lib from type_image where id = :v_type ;
						FileWrite(num_file,"NomImage=" + v_lib )
						FileWrite(num_file,"DateImage=" + string(v_date_image) )
						FileWrite(num_file,"TypeImage=RADIO")
						select isnull(libelle,'') into :v_lib from temps_traitement where id = :v_temps ;
						FileWrite(num_file,"TempsTraitement=" + v_lib )
						FileWrite(num_file,"CodeTypeImage="+string(v_type))
						FileWrite(num_file,"CodeTempsTraitement="+string(v_temps))
					else
						FileWrite(num_file,"CadreImage=" + gb2.nom_cadre_ole )
						FileWrite(num_file,"NomImage=" + gb2.popup_help )
						if string(gb2.date_image) <> '01/01/1900' then
							FileWrite(num_file,"DateImage=" + string(gb2.date_image) )
						else
							FileWrite(num_file,"DateImage=")
						end if
						FileWrite(num_file,"TypeImage=RADIO")
					end if
					FileWrite(num_file,"")
					
					
					// pour les information d'exportation d'Odrade
					string cadre_import_trace, cadre_import_tableau
					string fichier_cadre_import_trace, fichier_cadre_import_tableau
					long num_cadre_depart
					string v_insert_tableau, v_insert_trace, v_insert_impression
					
					num_cadre_depart = long(right(gb2.nom_cadre_ole,3))
					
					if imagerie_2013 then
						if v_odrade_import_trace = "O" then
							fichier_cadre_import_trace = v_rep_photo_patient + "ODR"+string(num_cadre_depart)+"T.jpg"
							//v_insert_trace = "insert into images_infos (code, nom_fichier, date_acquis, type_image, temps_traitement) values ("+string(var_code_local)+",'"+ "ODR"+string(num_cadre_depart)+"T.jpg"+"', ' " +string(today(),"yyyy-mm-dd")+"', 51 ,"+string(v_temps)+") ;"  
						else
							fichier_cadre_import_trace = ""
						end if
						if v_odrade_import_tableau = "O" then
							fichier_cadre_import_tableau = v_rep_photo_patient + "ODR"+string(num_cadre_depart)+"M.jpg"
							//v_insert_tableau = "insert into images_infos (code, nom_fichier, date_acquis, type_image, temps_traitement) values ("+string(var_code_local)+",'"+ "ODR"+string(num_cadre_depart)+"M.jpg"+"', ' " +string(today(),"yyyy-mm-dd")+"', 50 ,"+string(v_temps)+") ;"  
						else
							fichier_cadre_import_tableau = ""
							//v_insert_tableau = ""
						end if
						
						if v_odrade_import_impression = "O" then
							fichier_cadre_import_impression =  v_rep_photo_patient + "ODR"+string(num_cadre_depart)+"I.jpg"
							//v_insert_impression = "insert into images_infos (code, nom_fichier, date_acquis, type_image, temps_traitement) values ("+string(var_code_local)+",'"+ "ODR"+string(num_cadre_depart)+"I.jpg"+"', ' " +string(today(),"yyyy-mm-dd")+"', 52 ,"+string(v_temps)+") ;"  
						else
							fichier_cadre_import_impression = ""
							//v_insert_impression = ""
						end if					
					else
						
						if v_odrade_import_trace = "O" then
							cadre_import_trace = "ole_photo" + string(num_cadre_depart + v_odrade_cadre_import_trace, "000")
							fichier_cadre_import_trace = v_rep_photo_patient  + profilestring( dir_photos + inifile_photo, "ARAKIS", cadre_import_trace ,"")
						else
							cadre_import_trace = ""
							fichier_cadre_import_trace = ""
						end if
						
						if v_odrade_import_tableau = "O" then
							cadre_import_tableau = "ole_photo" + string(num_cadre_depart + v_odrade_cadre_import_tableau, "000")
							fichier_cadre_import_tableau = v_rep_photo_patient + profilestring( dir_photos + inifile_photo, "ARAKIS", cadre_import_tableau ,"")
						else
							cadre_import_tableau = ""
							fichier_cadre_import_tableau = ""
						end if
						
						if v_odrade_import_impression = "O" then
							cadre_import_impression = "ole_photo" + string(num_cadre_depart + v_odrade_cadre_import_impression, "000")
							fichier_cadre_import_impression = v_rep_photo_patient + profilestring( dir_photos + inifile_photo, "ARAKIS", cadre_import_impression ,"")
						else
							cadre_import_impression = ""
							fichier_cadre_import_impression = ""
						end if
					end if
					
					FileWrite(num_file,"[ANALYSE]")
					if v_analyse_odrade = -3 then
						if v_sexe = "M" then
							// Analyse 1 si c'est un garçon
							v_analyse_odrade = -1
						else
							// Analyse 2 si c'est une fille ou autre
							v_analyse_odrade = -2
						end if
					end if
					FileWrite(num_file,"CodeAnalyse=" + string(v_analyse_odrade) )
					FileWrite(num_file,"ExportTrace=" + fichier_cadre_import_trace )
					FileWrite(num_file,"ExportTraceH="+ string ( v_odrade_export_trace_hauteur))
					FileWrite(num_file,"ExportTraceL=" + string( v_odrade_export_trace_largeur ))
					FileWrite(num_file,"ExportMesures=" + fichier_cadre_import_tableau)
					FileWrite(num_file,"ExportImpression=" + fichier_cadre_import_impression)
					
	//				// Insert pour l'imagerie_2013
	//				if Imagerie_2013 then
	//					FileWrite(num_file,"InsertExportTrace = " +v_insert_trace )
	//					FileWrite(num_file,"InsertExportMesures = "+ v_insert_tableau)
	//					FileWrite(num_file,"InsertExportImpression = "+ v_insert_impression)
	//				end if
					
					// Imprimer Résumé
					string imprimerresume
					if v_imprimer_resume = 'O' then
						imprimerresume = "1"
					else
						imprimerresume = "0"
					end if
					FileWrite(num_file,"ImprimerImpression="+imprimerresume )
					FileWrite(num_file,"")
					
					// Fermeture d'Odrade
					string fermeture
					if v_odrade_fermer = 'O' then
						fermeture = "1"
					else
						fermeture = "0"
					end if
					
					
					FileWrite(num_file,"[OPTIONS]")
					FileWrite(num_file,"FermerOdrade="+fermeture )
					FileWrite(num_file,"")
					
					
					FileClose(num_file)
					
					
					// Lancement effectif d'Odrade
						
					//construit la ligne d'arguments
					argument = "LIENS#" + fichier_param + "#"
					
					string ligne_commande
					ligne_commande = exe_odrade + ' "' + argument + '"'
					
					//lance odrade
						
					if run(ligne_commande) <> 1 then
						MessageBox("ATTENTION !","Impossible de lancer le logiciel Odrade !~n~nVeuillez vérifier son installation.")
						FileClose(num_file)
					end if
				else
					Messagebox("ATTENTION !","Vous devez renseigner une date de naissance pour le patient avant de faire un tracé dans Odrade.")
					FileClose(num_file)
				end if
			end if
		else
			Messagebox("ATTENTION !","Vous ne pouvez utiliser cette fonctionnalité qu'à partir d'Odrade 2010 (version 5).~nOr, vous êtes en version "+string(version_base_odrade)+"~n~nVeuillez mettre votre logiciel Odrade à jour.")
			FileClose(num_file)
		end if
	end if
end if

end event

