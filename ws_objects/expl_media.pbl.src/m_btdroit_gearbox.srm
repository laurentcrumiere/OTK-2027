public function integer gearpopmenu (integer x, integer y, gearbox gbox);string	sl, lstr_path_prg

// UTILISEE LORSQUE CLIC DROIT SUR UNE GEARBOX ... ATTENTION .... Y A LA COPIE POUR LE CLIC DROIT SUR UNE AUTRE IMAGE  !!


	
	gb2 = gbox	// on en garde une occurence 
	
	// pour le "ouvrir avec ..."
	sl = profilestring(dir_ini + inifile_orthokis, "photos", "nom_editer_avec01", "")
	lstr_path_prg = ProfileString(dir_ini + inifile_orthokis, "photos", "editer_avec01", "")
	if lstr_path_prg = "" then
	// si aucun prg de retouche indiqué -> enable false
		this.m_editer_avec.text = this.m_editer_avec.tag
		this.m_editer_avec.enabled = false
	else
	// un prg de retouche est indiqué -> on rajoute la description à l'entrée du menu
		this.m_editer_avec.text = this.m_editer_avec.tag + "[" + sl + "]"
	end if
	
	// selon date sur photo visible
	m_modifierdateacquisition.visible = not gb2.em_date_acquis.visible
	
	
	// Vérification si lien Odrade et Odrade installé pour faire un tracé avec Odrade
	if ODR and ODRADE then
		m_odrade.enabled = true
	else
		m_odrade.enabled = false
	end if

	// Si lien Odrade on peut envoyer la radio vers Odrade, mais pas en autonome
	if odr and not utilisation_distante then
		m_envoyeruneradiodansodrade.enabled 	= true
	else
		m_envoyeruneradiodansodrade.enabled 	= false
	end if

	
	// Vérification si lien Tridim
	if TRIDIM then
		this.m_tridim.visible = true
	else
		this.m_tridim.visible = false
	end if
	
	if Not FileExists(gb2.fichier_photo) then
		// si fichier photo n'existe pas encore
		this.m_supprimerimage.enabled 			= false
		this.m_déplacervers.enabled 				= false
		this.m_sauvegardersous.enabled			= false
		this.m_editer_avec.enabled 					= false
		this.m_imprimerlimage.enabled 			= false
		this.m_utiliseruneresentationpowerpoint.enabled 			= false
		this.m_copierimage.enabled 				= false
		this.m_editer.enabled 						= false
		this.m_modifierdateacquisition.enabled 	= false
		this.m_informationssurlimage.enabled 	= false
		this.m_exportmultiples.enabled 			= false
		this.m_ouvriravecxdraw.enabled			= false
		this.m_odrade.enabled						= false
		this.m_tridim.enabled 						= false
		this.m_imprimerimage.enabled 			= false
		m_envoyerparemailpiècejointe.enabled 	= false
		m_régénérerlavignette.enabled 			= false
		m_composite.enabled 						= false
		m_restaurerlimageoriginale.enabled 		= false
end if
	
	

	// Restriction selon imagerie 2013
	if imagerie_2013 then
		
		
		this.m_acquisitionliendimaxisplanmeca.visible		= false	
		this.m_acquisitionliendigorasoredex.visible			= false	
		this.m_acquisitionlientrophy.visible						= false
		this.m_acquisitionlienvixwin32gendex.visible			= false
		this.m_acquisitionliensidexissirona.visible			= false
		this.m_acquisitionlienmediadentmorita.visible		= false
		this.m_acquisitionliendbswindurrdental.visible		= false
		this.m_acquisitioncliniviewinstrumentarium.visible	= false
		this.m_acquisitionidentitekitview.visible				= false
		this.m_acquisitionlienmyray.visible						= false
		
		this.m_acquerir.visible									= false
		this.m_acquisitionfichier.visible						= false
		this.m_-0.visible											= false
		this.m_selection_matos.visible							= false
		this.m_acquisitionidentitekitview.visible				= false
		this.m_-1.visible											= false
		this.m_collerimage.visible								= false
		this.m_déplacervers.visible								= false
		this.m_10.visible											= false
		this.m_modifierdateacquisition.visible					= false
		this.m_affecterlesmotsclefs.visible						= false
		
		
	else
		// restriction selon modules optionnels
		this.m_acquisitionliendimaxisplanmeca.visible		= PLANMECA	
		this.m_acquisitionliendigorasoredex.visible			= DIGORA	
		this.m_acquisitionlientrophy.visible						= trophy
		this.m_acquisitionlienvixwin32gendex.visible			= VIXWIN
		this.m_acquisitionliensidexissirona.visible			= SIDEXIS
		this.m_acquisitionlienmediadentmorita.visible		= MEDIADENT
		this.m_acquisitionliendbswindurrdental.visible		= DURRDENTAL
		this.m_acquisitioncliniviewinstrumentarium.visible	= INSTRUMENTARIUM
		this.m_acquisitionidentitekitview.visible				= KITVIEW
		this.m_acquisitionlienmyray.visible						= MYRAY
	end if	

	// Appel depuis l'explorateur de limagerie 2013 ?
	string v_nom_fenetre_parent = ""
	if isvalid(gb2.GetParent()) then
		v_nom_fenetre_parent = gb2.GetParent().className()
		if isvalid(gb2.GetParent().GetParent()) then
			v_nom_fenetre_parent = GetParent().GetParent().className()
		end if
	end if
	

	// Certaines fonctions sont désactivées si appel depuis les pages cliniques
	if left(v_nom_fenetre_parent,9) = "w_diagnos" then
		m_envoyerparemailpiècejointe.enabled 	= false
		m_copierversunautrepatient.enabled = false
		m_envoyeruneradiodansodrade.enabled 	= false
		m_composite.enabled 						= false
		m_restaurerlimageoriginale.enabled 		= false
		m_régénérertouteslesvignettesdupatient.enabled = false
		m_etalonnerlaradioavecxdraw.enabled = false
		m_imprimerimage.enabled = false
	end if

	// Certaines fonctions sont désactivées si appel depuis la fiche administrative
	if left(v_nom_fenetre_parent,13) = "w_patient_maj" then
		m_envoyerparemailpiècejointe.enabled 	= false
		m_copierversunautrepatient.enabled = false
		m_envoyeruneradiodansodrade.enabled 	= false
		m_composite.enabled 						= false
		m_restaurerlimageoriginale.enabled 		= false
		m_régénérertouteslesvignettesdupatient.enabled = false
		m_etalonnerlaradioavecxdraw.enabled = false
		this.m_imprimerlimage.enabled 			= false
		this.m_utiliseruneresentationpowerpoint.enabled 			= false
	end if


	// Nom des composites ...
	string v1, v2, v3, v4
	
	select top 1 nom_composite_1 ,  nom_composite_2 ,  nom_composite_3 ,  nom_composite_4 
	into :v1, :v2, :v3, :v4 
	from param ;
	
	this.m_composite.m_composite1.text = v1
	this.m_composite.m_composite2.text = v2
	this.m_composite.m_composite3.text = v3
	this.m_composite.m_composite4.text = v4
	
	
	// on affiche le menu en popup
	this.popmenu(x,y)

//end if


// pas de gestion d'erreur
return 1
end function

public function integer rafraichir_expl_media ();// fx qui rafraichit les thumbnails pour module expl_media
// return 1 si ok
//		-1 si pb

int		returnval = -1

if isvalid( w_expl_media ) then
//	if w_expl_media.tab_types.control[1].rafraichir_miniature_standard( ) = 1 then returnval = 1
//	uo_expl_media_tabpage_images
	returnval = 1
else
	returnval = 1
end if

return returnval
end function

public function integer uo_imagepopmenu (integer x, integer y, uo_image uoi);string	sl, lstr_path_prg

// UTILISEE PAR LE CLIC DROIT SUR UNE UO_IMAGE

// Cadre image qui vient d'être cliqué !!
uo_image_cliquee = uoi

// pour le "ouvrir avec ..."
sl = profilestring(dir_ini + inifile_orthokis, "photos", "nom_editer_avec01", "")
lstr_path_prg = ProfileString(dir_ini + inifile_orthokis, "photos", "editer_avec01", "")
if lstr_path_prg = "" then
	// si aucun prg de retouche indiqué -> enable false
	m_editer_avec.text = m_editer_avec.tag
	m_editer_avec.enabled = false
else
	// un prg de retouche est indiqué -> on rajoute la description à l'entrée du menu
	m_editer_avec.text = m_editer_avec.tag + "[" + sl + "]"
end if

// selon date sur photo visible
//m_modifierdateacquisition.visible = not gb2.em_date_acquis.visible


// Vérification si lien Odrade et Odrade installé pour faire un tracé avec Odrade
if ODR and ODRADE then
	m_odrade.enabled = true
else
	m_odrade.enabled = false
end if

// Si lien Odrade on peut envoyer la radio vers Odrade, mais pas en autonome
if odr and not utilisation_distante then
	m_envoyeruneradiodansodrade.enabled 	= true
else
	m_envoyeruneradiodansodrade.enabled 	= false
end if


// Vérification si lien Tridim
if TRIDIM then
	m_tridim.visible = true
else
	m_tridim.visible = false
end if


if Not FileExists(uo_image_cliquee.nom_fichier_complet) then
	// si fichier photo n'existe pas encore
	m_supprimerimage.enabled 			= false
	m_déplacervers.enabled 				= false
	m_sauvegardersous.enabled			= false
	m_editer_avec.enabled 					= false
	m_imprimerlimage.enabled 			= false
	m_utiliseruneresentationpowerpoint.enabled 			= false
	m_copierimage.enabled 				= false
	m_editer.enabled 						= false
	m_editeur2021.enabled 						= false
	m_modifierdateacquisition.enabled 	= false
	m_informationssurlimage.enabled 	= false
	m_exportmultiples.enabled 			= false
	m_ouvriravecxdraw.enabled			= false
	m_odrade.enabled						= false
	m_envoyeruneradiodansodrade.enabled 	= false
	m_tridim.enabled 						= false
	m_envoyerparemailpiècejointe.enabled 	= false
	m_régénérerlavignette.enabled 			= false
	m_envoyeruneradiodansodrade.enabled 	= false
	m_composite.enabled 						= false
	m_restaurerlimageoriginale.enabled 		= false
	m_régénérertouteslesvignettesdupatient.enabled = false
	m_etalonnerlaradioavecxdraw.enabled = false
	m_copierversunautrepatient.enabled = false
end if

	
m_acquisitionfichier.visible		= false	
m_acquisitionliendimaxisplanmeca.visible		= false	
m_acquisitionliendigorasoredex.visible			= false	
m_acquisitionlientrophy.visible						= false
m_acquisitionlienvixwin32gendex.visible			= false
m_acquisitionliensidexissirona.visible			= false
m_acquisitionlienmediadentmorita.visible		= false
m_acquisitionliendbswindurrdental.visible		= false
m_acquisitioncliniviewinstrumentarium.visible	= false
m_acquisitionidentitekitview.visible	= false

m_selection_matos.visible	= false
m_acquerir.visible	= false
m_-0.visible	= false
m_-1.visible	= false

// uniquement sur le menu Image
m_etalonnerlaradioavecxdraw.visible = true
m_copierversunautrepatient.visible = true

//m_copierimage.visible	= false
m_collerimage.visible	= false
m_déplacervers.visible	= false
//m_10.visible	= false

m_modifierdateacquisition.visible	= false
m_affecterlesmotsclefs.visible	= false


// Appel depuis l'explorateur de limagerie 2013 ?
string v_nom_fenetre_parent

	if isvalid(gb2.GetParent()) then
		v_nom_fenetre_parent = gb2.GetParent().className()
		if isvalid(gb2.GetParent().GetParent()) then
			v_nom_fenetre_parent = gb2.GetParent().GetParent().className()
			if isvalid(gb2.GetParent().GetParent()) then
				v_nom_fenetre_parent = gb2.GetParent().GetParent().className()
				if isvalid(gb2.GetParent().GetParent().GetParent()) then
					v_nom_fenetre_parent = gb2.GetParent().GetParent().GetParent().className()
				end if
			end if
		end if
	end if

	string a 
	a = left(v_nom_fenetre_parent,9)
	
// Certaines fonctions sont désactivées si appel depuis les pages cliniques
if left(v_nom_fenetre_parent,9) = "w_diagnos" then
	m_envoyerparemailpiècejointe.enabled 	= false
	m_copierversunautrepatient.enabled = false
	m_envoyeruneradiodansodrade.enabled 	= false
	m_composite.enabled 						= false
	m_restaurerlimageoriginale.enabled 		= false
	m_régénérertouteslesvignettesdupatient.enabled = false
	m_etalonnerlaradioavecxdraw.enabled = false
end if

// Nom des composites ...
string v1, v2, v3, v4

select top 1 nom_composite_1 ,  nom_composite_2 ,  nom_composite_3 ,  nom_composite_4 
into :v1, :v2, :v3, :v4 
from param ;

this.m_composite.m_composite1.text = v1
this.m_composite.m_composite2.text = v2
this.m_composite.m_composite3.text = v3
this.m_composite.m_composite4.text = v4



// on affiche le menu en popup
popmenu(x,y)

// pas de gestion d'erreur
return 1
end function

public function integer selectionner_images_courantes ();// Fonction qui remplit 2 tableaux (instances)
//	photo_courante[cpt_courante]			=  nom complet des fichiers des photos sélectionnées
//	Date_Image_Courante[cpt_courante] = dates


// Depuis 2012 ... on peut sélectionner plusieurs images à déplacer SI ON EST DANS LA FENETRE IMAGERIE

constant string crlf = char(10)
constant string crlf2 = char(13)


string vide = ""

string chemin_fichier, nom_fichier
string libelle_defaut

boolean deplacer = true

string chemin_fichier_source
string chemin_fichier_destination, cadre_destination_depart
long numero_cadre_destination
string chemindossier

// Fichier Word en dur
string fichier_doc 

// On écrit les 2 champs spéciaux pour le courriers
integer cpt_courante, cpt_miniatures, tot_selection

for cpt_courante = 1 to nb_photos_courantes_maxi
	photo_courante[cpt_courante]			= ""
	Date_Image_Courante[cpt_courante] = ""
	Commentaire_Image_Courante[cpt_courante] = ""
next



// pour savoir les sélectionnées
cpt_courante = 1

// Appel depuis l'imagerie AVANT 2013 ?
if not imagerie_2013 then 
	if gb2.GetParent().className() = "w_diagnos_maj_miniatures" then
		w1 = gb2.GetParent()
	
		if isValid(w1) then
			appel_depuis_imagerie = true
			// recherche des cochées
			// recherche si images cochées
			for cpt_miniatures = 1 to w1.nb_cadres
				if w1.gb[cpt_miniatures].cbx_selection.checked then
					if cpt_courante <= nb_photos_courantes then
						photo_courante[cpt_courante]			= w1.gb[cpt_miniatures].fichier_photo
						Date_Image_Courante[cpt_courante] = string(w1.gb[cpt_miniatures].date_image)
						Commentaire_image_courante[cpt_courante]	= w1.gb[cpt_miniatures].commentaire_image_html
						cpt_courante = cpt_courante+ 1
					end if
				end if
			next
		end if
	end if
		
	if cpt_courante = 1 then
		// aucune image cochée => on prend l'image sur laquelle on est
		photo_courante[cpt_courante]			= gb2.fichier_photo
		Date_Image_Courante[cpt_courante] = string(gb2.date_image)
		cpt_courante = cpt_courante+ 1
	end if


else
	// Appel depuis l'explorateur de limagerie 2013 ?

	string v_nom_fenetre_parent, v_nom_fichier_court
	
	string v1, v2
	
	v1 = gb2.GetParent().className()
	V2 = uo_image_cliquee.GetParent().className()
	
	if left(gb2.GetParent().className(), 12) = "w_coment_maj" then
		
//		// On est dans les commentaires cliniques ...  prend l'image sur laquelle on est (une gearbox)
//		photo_courante[cpt_courante]			= gb2.fichier_photo
//		Date_Image_Courante[cpt_courante] = string(gb2.date_image)
//		
//		 v_nom_fichier_court = gfx_extraire_nom_fichier(gb2.fichier_photo)
//		 
//		// Sur une GB on n'a pas le commentaire => recherche en base 
//		select commentaires_html into :commentaire_image_courante[cpt_courante] from images_infos 
//		where nom_fichier = :v_nom_fichier_court and code = :gb2.var_num_dossier ;	


		// le tableau est vide si on appelle depuis les commentaires cliniques 
		photo_courante[cpt_courante] = uo_image_cliquee.nom_fichier_complet
		Date_Image_Courante[cpt_courante] = string(uo_image_cliquee.date_image)

		// Traitement des saut de lignes ... pour Word
		string s_commentaire_image
		s_commentaire_image =  gfx_tout_remplacer(uo_image_cliquee.commentaire_image_html, crlf, crlf_parse)
		s_commentaire_image =  gfx_tout_remplacer(s_commentaire_image, crlf2, "")
		Commentaire_image_courante[cpt_courante] = s_commentaire_image
			

	else	
	
		v_nom_fenetre_parent = gb2.GetParent().GetParent().GetParent().className()
	
		if left(v_nom_fenetre_parent,18) = "w_explorateur_2013" then
			w2013 = gb2.GetParent().GetParent().GetParent()
		
			if isValid(w2013) then
				appel_depuis_imagerie_2013 = true
				// recherche des cochées
				// recherche si images cochées
				
				
				long nb_images, lig
				// pour prendre les photos selon le bon ordre !!
			
				nb_images = w2013.dw_tri.rowcount()
			
				for lig = 1 to nb_images
					cpt_miniatures = w2013.dw_tri.GetItemNumber(lig, "index")
					if w2013.uoi[cpt_miniatures].cbx_selection.checked then
						if cpt_courante <= nb_photos_courantes then
							photo_courante[cpt_courante]			= w2013.uoi[cpt_miniatures].nom_fichier_complet
							Date_Image_Courante[cpt_courante] = string(w2013.uoi[cpt_miniatures].date_image)
							Commentaire_image_courante[cpt_courante]	= w2013.uoi[cpt_miniatures].commentaire_image_html
							cpt_courante = cpt_courante+ 1
						end if
					end if
				next
			end if
		end if
	
		if cpt_courante = 1 then
			// aucune image cochée => on prend l'image sur laquelle on est
			photo_courante[cpt_courante]			= uo_image_cliquee.nom_fichier_complet
			Date_Image_Courante[cpt_courante] = string(uo_image_cliquee.date_image)
			commentaire_image_courante[cpt_courante]	= uo_image_cliquee.commentaire_image_html
			cpt_courante = cpt_courante + 1
		end if
	end if
end if

// renvoie le nombre d'images sélectionnées
return cpt_courante - 1




end function

public subroutine ouvrir_composite (integer numero_composite);

// Recherche si X-Draw est bien dans le dossier d'installation d'Orthokis
// Le lance pour
// - ouvrir un composite (N° de 1 à 4)
// - ouvir l'éditeur de composite (N° 5)
// - étalonner une ration (N°0)

string fichier_exe_xdraw , commande
string rep_x-draw, reg_path

reg_path = "HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\APP Paths\X-DRAW.EXE"

RegistryGet(reg_path,"path",rep_x-draw)

if numero_composite = 5 then
	fichier_exe_xdraw = rep_x-draw+  "\Editeur2Composites.exe"
else
	fichier_exe_xdraw = rep_x-draw+  "\x-draw.exe"
end if

if fileexists(fichier_exe_xdraw) then
	
	// Récupération du type d'image
	string v_nom_fichier_seul
	long v_temps_traitement
	v_nom_fichier_seul = gfx_extraire_nom_fichier(gb2.fichier_photo)
	
	select temps_traitement into :v_temps_traitement from images_infos where code = :gb2.var_num_dossier and nom_fichier = :v_nom_fichier_seul ;
	
	if isnull(v_temps_traitement) then 
		MessageBox("ATTENTION !","Cette image n'a pas d'Etape de Traitement.~n~nL'action ne peut se poursuivre.")
	else
		// on lance
		commande = fichier_exe_xdraw + " ORTHOKIS#"+dir_photos+"#"+string(gb2.var_num_dossier)+"#"+string(v_temps_traitement)+"#"+string(numero_composite)+"#"
		runwait(commande, 1)
		faire_vignette_pour( gb2.fichier_photo, gb2.var_num_dossier )
		gb2.rafraichir_var_cadre(gb2.nom_cadre_ole)
	end if
else
	Messagebox("Erreur","Le logiciel X-Draw n'est pas installé sur ce micro-ordinateur.~nVous ne pouvez donc pas utiliser cette fonction.")
end if

end subroutine

public subroutine utiliser_office (string type_soft, double numero);

// fonction qui mémorise les images courantes et qui lance l'interface de choix de la mise en plage ou de la présentation
// puis qui lance Word ou Powerpoint

// type_soft vaut 
// - W pour Word 
// - P pour powerpoint si appel depuis Imagerie
// - S si appel depuis soins (pour échéancier)
// - F si appel depuis soins pour Feuille de Soins 2014
// - C si appel depuis la comparaison intelligente
// - E si appel depuis Erasme (envoi de fichier vers Médical Viewer)
// - A si appel depuis soins pour Attestation de Soins Belges
// - FF si appel depuis Facture pour Facture France
// - SN si appel depuis soins (pour échéancier) pour faire une signature numérique
// - SL si appel depuis soins (pour échéancier) pour faire une signature en ligne
// - J si appel depuis soins pour Justificatif de Soins Belges
// - R si appel depuis soins pour reçu de paiement

// Numéro = numéro du document (facture pour 'FF')

constant string crlf = char(10)
constant string crlf2 = char(13)

w_patience w_patience_locale

boolean v_suite

uo_lien_word		wrd
uo_lien_powerpoint ppt

string v_vide = ""

string chemin_fichier, nom_fichier
string libelle_defaut
integer cpt_courante

str_image_impression img

// Fichier Word en dur
string fichier_doc 

// pour facture Word
double v_id_facture_word
string nom_fichier_facture, v_publication_portail, v_publication_correspondant

// pour reçu
double v_id_recu_word
string nom_fichier_recu 

if type_soft = "J" then
	// Pour justificatif belgique, on force Facture en PDF pour lien avec Word
	Setprofilestring(dir_ini+inifile_orthokis,"admini","facture_pdf","O") 
end if


if type_soft <> "S" and type_soft <> "F" and type_soft <> "C" and type_soft <> "E" and type_soft <> "A" and type_soft <> "FF" and type_soft <> "J" and type_soft <> "R" then
	// Appel depuis imagerie
	selectionner_images_courantes()
end if

if type_soft <> "F" and type_soft <> "E" and type_soft <> "A" and type_soft <> "FF" and type_soft <> "J" and type_soft <> "R"   then 
	
	// fentre de recherche du document Word
	openWithParm( w_img_imprimer , type_soft)

	// La fenêtre renvoie 
	// - le nom du fichier WORD qui servira ... 
	// - le service Word à faire
	
	img = message.PowerObjectParm 
else
	if type_soft = "F" then
		img.fichier_word = dir_ini + fxg_nom_fichier_fs2014_doc_ou_docx()
		img.service_word = Service_MajEtImprime
	else
		if type_soft = "E" then
			img.fichier_word = dir_courriers + "Pages_Cliniques_MedicalViewer.doc"
			//img.service_word = Service_MajEtVisualise
			img.service_word = Service_MajEtSauve
		else
			if type_soft = "A" then
				img.fichier_word = dir_ini + nom_fichier_attestation
				img.service_word = Service_MajEtImprime
			else
				if type_soft = "FF" or  type_soft = "J"  then
					// recherche du nom du fichier Word pour la facture France ou Justififcatif Belgique
			
					select max(id_facture_word) into :v_id_facture_word from param ;
					zerodb(v_id_facture_word)
			
				  SELECT trim(nom_document) + '.' + trim(extension)  , "copie_pdf", "copie_pdf_correspondant"
					 INTO :nom_fichier_facture, :v_publication_portail, :v_publication_correspondant
					 FROM "courriers_word"  
					WHERE "courriers_word"."id" = :v_id_facture_word    ;
					
					img.fichier_word = dir_courriers + nom_fichier_facture
					
					if profilestring(dir_ini+inifile_orthokis,"admini","facture_pdf","N") = "O" then 
						// Si la facture est en PDF on génère de suite 
						img.service_word = Service_MajEtFacture
					else
						// Si la facture n'est pas en PDF, ou l'ouvre et on s'arrête  .... MAIS CA NE MARCHE PAS !
						img.service_word = Service_MajEtVisualise
					end if
				else
					if type_soft = "R"  then
						// recherche du nom du fichier Word pour le reçu 
				
						select max(id_recu_word) into :v_id_recu_word from param ;
						zerodb(v_id_recu_word)
				
					  SELECT trim(nom_document) + '.' + trim(extension)  , "copie_pdf", "copie_pdf_correspondant"
						 INTO :nom_fichier_recu, :v_publication_portail, :v_publication_correspondant
						 FROM "courriers_word"  
						WHERE "courriers_word"."id" = :v_id_recu_word    ;
						
						img.fichier_word = dir_courriers + nom_fichier_recu
						if profilestring(dir_ini+inifile_orthokis,"admini","recu_pdf","N") = "O" then 
							img.service_word = Service_MajEtFacture
						else
							img.service_word = Service_MajEtImprime
						end if
					end if
					
				end if
			end if
			
		end if
	end if
	
end if
	

if isvalid(img) then
	
	
	fichier_doc = img.fichier_word 
	
	
	// Si retour de chaine vide, c'est que soucis avant 
	if len(trim(fichier_doc)) > 0 then
		
		if type_soft <> "S" and type_soft <> "F"  and type_soft <> "C" and type_soft <> "E" and type_soft <> "A"  and type_soft <> "FF" and type_soft <> "J"  and type_soft <> "R"   then
			// Inscription des infos des l'image en cours 
			
			for cpt_courante = 1 to nb_photos_courantes_maxi
				SetProfileString(dir_ini+inifile_orthokis,"PHOTOS","Photo_Courante"+string(cpt_courante),photo_courante[cpt_courante])
				SetProfileString(dir_ini+inifile_orthokis,"PHOTOS","Date_Image_Courante"+string(cpt_courante),Date_Image_Courante[cpt_courante])
				
				// Traitement des saut de lignes ... pour Word
				Commentaire_Image_Courante[cpt_courante] =  gfx_tout_remplacer(Commentaire_Image_Courante[cpt_courante], crlf, crlf_parse)
				Commentaire_Image_Courante[cpt_courante] =  gfx_tout_remplacer(Commentaire_Image_Courante[cpt_courante], crlf2, "")
				SetProfileString(dir_ini+inifile_orthokis,"PHOTOS","Commentaire_Image_Courante"+string(cpt_courante),Commentaire_Image_Courante[cpt_courante])
			next
			
			
		end if
		
		// fichier Word à utiliser ...
		chemin_fichier 	= 	gfx_extraire_path_fichier(fichier_doc)
		nom_fichier 		= 	gfx_extraire_nom_fichier(fichier_doc)
	
		// On va utiliser les fonctions Word avec patient courant 
		// => on récup le code du patient sur lequel on est (pas forcément le patient courant !)
		// on permute les codes qu'on repermutera ensuite
		
		double var_code_courant_sauvegarde, var_code_patient_actuel
		
		var_code_courant_sauvegarde = var_code 
		
		if type_soft <> "S" and type_soft <> "F" and type_soft <> "C"  and type_soft <> "E" and type_soft <> "A" AND type_soft <> "FF" and type_soft <> "J" and type_soft <> "R"    then
			var_code_patient_actuel = gb2.var_num_dossier
			var_code = var_code_patient_actuel
		end if	
		

		
		if type_soft = "W" or type_soft = "S" or type_soft = "F"  or type_soft = "C" or type_soft = "E" or type_soft = "A"  or type_soft = "FF" or type_soft = "J" or type_soft = "R"   then
			

			// Spéciale pour signature en ligne
			if img.service_word = Service_SigneEnLigne then
				w_courriers_word_invisible w_cw
				open( w_cw)
				w_cw.hide()
				w_cw.signature_en_ligne(true, true, false, chemin_fichier, nom_fichier ) 
				close(w_cw)
			else
				
				// Récupération du fichier pour mise dans le dossier du patient
				string v_fichier_depart_complet
				v_fichier_depart_complet = fxg_get_nom_fic_document_orthokis_pdf()
				
				v_suite = true
				
				if (type_soft = "FF"  and ( profilestring(dir_ini+inifile_orthokis,"admini","facture_pdf","N") = "O" or Profilestring(dir_ini+inifile_orthokis,"admini","envoi_email_direct","N") = "O") ) or  type_soft = "J"  then 
					// facture France imprimée en PDF .. on supprime le fichier temporaire avant pour éviter les ménage .. si pas possible ... on sort
					if FileExists(v_fichier_depart_complet) then
						if not FileDelete(v_fichier_depart_complet) then 
							v_suite = false
							if type_soft = "FF"  then 
								MessageBox("ATTENTION","Impossible de générer la facture en PDF !~n~nUn Fichier intermédiaire est probablement ouvert (visualisation de la facture).~n~nMerci de le fermer et recommencer l'opération !")
							else
								MessageBox("ATTENTION","Impossible de générer le justificatif en PDF !~n~nUn Fichier intermédiaire est probablement ouvert (visualisation du justificatif).~n~nMerci de le fermer et recommencer l'opération !")
							end if
						end if
					end if
			
				end if	

				
				if type_soft = "R"  and profilestring(dir_ini+inifile_orthokis,"admini","recu_pdf","N") = "O"  then 
					// reçu imprimé en PDF .. on supprime le fichier temporaire avant pour éviter les ménage .. si pas possible ... on sort
					if FileExists(v_fichier_depart_complet) then
						if not FileDelete(v_fichier_depart_complet) then 
							v_suite = false
							MessageBox("ATTENTION","Impossible de générer le reçu en PDF !~n~nUn Fichier intermédiaire est probablement ouvert (visualisation du reçu).~n~nMerci de le fermer et recommencer l'opération !")
						end if
					end if
			
				end if	
				
				
				if v_suite then 
					
					// Services Word classiques ... 
					wrd = create uo_lien_word
					
					open(w_patience_locale)
					if wrd.traiter_avec_word(img.service_word, chemin_fichier, nom_fichier, true) <> 1 then
						close(w_patience_locale)
						// si pb sur le job WORD : msg d'erreur
						messagebox("ERREUR","Un problème est survenu durant l'exécution, ~nImpossible de poursuivre !",StopSign!)
					else
						close(w_patience_locale)
						if type_soft = "FF" or type_soft = "J" or type_soft = "R" then
							
							double var_code_local
									
							//select top 1 soins.code into :var_code_local from soins where soins.numero_facture = :numero ;
							var_code_local	= w_click_soins_reg.var_code_local
							
							// Fin du traitement avec Word ... la facture / reçu est imprimée ou si PDF, dans fichier temporaire
							if  (type_soft = "FF" and ( Profilestring(dir_ini+inifile_orthokis,"admini","envoi_email_direct","N") = "O" or profilestring(dir_ini+inifile_orthokis,"admini","facture_pdf","N") = "O")) or  (type_soft = "R" and profilestring(dir_ini+inifile_orthokis,"admini","recu_pdf","N") = "O")   or type_soft = "J"  then 
								string rep_phot_patient, v_fichier_destination,v_fichier_destination_complet
								rep_phot_patient = dir_photos + string( var_code_local )
								
								if not fileexists( rep_phot_patient ) then gfx_creer_rep( rep_phot_patient )
								
								choose case  type_soft 
									case "FF" 
									v_fichier_destination =  string(today(), "yyyy-mm-dd")+" "+string(now(), "hh-mm-ss")+ " - Facture_" + string(numero) + ".pdf"
									case "J"
										v_fichier_destination =  string(today(), "yyyy-mm-dd")+" "+string(now(), "hh-mm-ss")+ " - Justificatif Soins.pdf"
									case "R"
										v_fichier_destination =  string(today(), "yyyy-mm-dd")+" "+string(now(), "hh-mm-ss")+ " - Reçu.pdf"
								end choose
								
								v_fichier_destination_complet = rep_phot_patient + win_delimiter + v_fichier_destination
							
								
								// Petite tempo le temps que le fichier PDF soit généré
								integer  cpt_attente = 0
								do while not FileExists(v_fichier_destination_complet) and cpt_attente < 5 
									sleep(1000)
									cpt_attente = cpt_attente + 1
								loop 
								
								trace("Mémorisation du fichier " + v_fichier_depart_complet +"    ->     " + v_fichier_destination_complet )
								
								if FileCopy( v_fichier_depart_complet ,v_fichier_destination_complet ) = 1 then
									string v_libelle
									string v_publication
									
									choose case  type_soft 
										case "FF" 
											v_libelle = "Facture N°"+string(numero)+" (Document PDF)" 
										case "J"
											v_libelle = "Justificatif de soins " +" (Document PDF)" 
										case "R"
											v_libelle = "Montant : " + param_win[3] +" € (Document PDF)" 
									end choose
									
									integer categorie_nulle
									setnull(categorie_nulle)
									
									if type_soft = "FF" and profilestring(dir_ini+inifile_orthokis,"admini","factures_pub_mon_ortho","N") = "O" then
										v_publication  = "O"
									else
										v_publication = "N"
									end if
									
									if type_soft = "R" then
										fxg_enregcourrierhisto ( var_code_local, "RECREG" , today() ,v_libelle , v_fichier_destination_complet , 'E', v_publication, v_publication_correspondant , '', categorie_nulle)							
									else
										fxg_enregcourrierhisto ( var_code_local, "NOTHON" , today() ,v_libelle , v_fichier_destination_complet , 'E', v_publication, v_publication_correspondant , '', categorie_nulle)
									end if
									
									// Les justificatifs n'ont pas à être envoyé par mail de manière unitaire
									if type_soft = "J" then 
										// On mémorise l'info dans les soins 
										long lig, tot
										double v_cle 
										tot = w_click_soins_reg.dw_soins.rowcount() 
										for lig = 1 to tot
											if w_click_soins_reg.dw_soins.getItemString(lig, "fse")  = "O" then
												v_cle = w_click_soins_reg.dw_soins.getItemNumber(lig, "cle")
												update soins set fse_edite = 'J', date_fs = getdate() 
												where code = :var_code_local and cle = :v_cle ;
												commit ;
											end if
										next 
										w_click_soins_reg.cb_rafraichir.triggerevent(clicked!)
									else
										string v_libelle_question 
										if type_soft = "FF" then
											v_libelle_question = "cette facture"
										else
											v_libelle_question = "ce reçu"
										end if
										if Messagebox("QUESTION","Souhaitez-vous envoyer " + v_libelle_question + " par email ?", Question!, YesNo!, 1) = 1 then
											// on enchaine par l'envoi de l'email
											long ligtot
											m_btdroit_historique		Menu
											Menu = CREATE m_btdroit_historique
											
											// pas la même fenêtre mais héritage !
											if BELGIQUE and type_soft <> "R" then
												
												// Par sécurité en reprend le code de la fênetre Administrative, clic droits dans les documents !
												w_attestation_impression.dw_courriers.retrieve(var_code_local, "E")
												w_attestation_impression.dw_courriers.setfilter("historique_editions_nom_courrier = '" + v_fichier_destination + "'" )
												w_attestation_impression.dw_courriers.filter()
												ligtot = w_attestation_impression.dw_courriers.rowcount()
												if  ligtot > 0 then
													w_attestation_impression.dw_courriers.SetItem(1, "Selection", 'O')					
													Menu.dw_locale = w_attestation_impression.dw_courriers
													Menu.var_code_local = w_attestation_impression.var_code_local
													
													Menu.m_envoyerparemailpiècejointe.TriggerEvent(clicked!)
													
												end if
												
													
											else
												
												if type_soft = "FF"  then
													// Par sécurité en reprend le code de la fênetre Administrative, clic droits dans les documents !
													w_facture_impression.dw_courriers.retrieve(var_code_local, "E")
													w_facture_impression.dw_courriers.setfilter("historique_editions_nom_courrier = '" + v_fichier_destination + "'" )
													w_facture_impression.dw_courriers.filter()
													ligtot = w_facture_impression.dw_courriers.rowcount()
													if  ligtot > 0 then
														w_facture_impression.dw_courriers.SetItem(1, "Selection", 'O')					
														Menu.dw_locale = w_facture_impression.dw_courriers
														Menu.var_code_local = w_facture_impression.var_code_local
														
														Menu.m_envoyerparemailpiècejointe.TriggerEvent(clicked!)
														
													end if
												else
													if type_soft = "R" then
														// Reçu
														w_click_soins_reg.dw_courriers.settransobject(sqlca)
														w_click_soins_reg.dw_courriers.retrieve(var_code_local, "E")
														w_click_soins_reg.dw_courriers.setfilter("historique_editions_nom_courrier = '" + v_fichier_destination + "'" )
														w_click_soins_reg.dw_courriers.filter()
														ligtot = w_click_soins_reg.dw_courriers.rowcount()
														if  ligtot > 0 then
															w_click_soins_reg.dw_courriers.SetItem(1, "Selection", 'O')					
															Menu.dw_locale = w_click_soins_reg.dw_courriers
															Menu.var_code_local = w_click_soins_reg.var_code_local
															
															Menu.m_envoyerparemailpiècejointe.TriggerEvent(clicked!)
															
														end if
														
													end if
												end if
											end if
										end if
		
									end if
								else
									Messagebox("ATTENTION", "Erreur dans la mémorisation du fichier PDF !")
								end if
							end if
						end if
					end if
				end if
			end if
		else
			ppt = create uo_lien_powerpoint
			// Powerpoint
			string v_nom_fichier_complet
			string v_dossier
			
			v_nom_fichier_complet = chemin_fichier + nom_fichier
			
			// Mise à jour des autres variables pour passage de paramètre par le Orthokis.ini
			
			long v_numero_dossier_local
			string v_nom_local
			
			select numero_dossier, trim(nom)+isnull(' '+trim(prenom),'')  into :v_numero_dossier_local, :v_nom_local
			from patient where code = :var_code ;
			
			// On écrit le passage de paramètres à Powerpoint
			Setprofilestring(dir_ini+inifile_orthokis,"Macros","CodDef", string(var_code))
			Setprofilestring(dir_ini+inifile_orthokis,"Macros","DosDef", string(v_numero_dossier_local))
			Setprofilestring(dir_ini+inifile_orthokis,"Macros","NomDef", v_nom_local)
			Setprofilestring(dir_ini+inifile_orthokis,"Macros","Utilisateur", utilisateur_code)
			
			// Par sécurité ... quoiqu'on fasse dans Power Point .. on crée le dossier des phoos
			v_dossier = dir_photos + string(var_code)
		
			// si fichier photo du patient n'existe pas encore
			if not fxg_FileExists(v_dossier) then CreateDirectory(v_dossier)

			if img.service_word = Service_MajEtVisualise then
				// Juste aperçu
				ppt.routine_powerpoint(2,v_nom_fichier_complet, var_code )
			else
				// Diaporama
				ppt.routine_powerpoint(3,v_nom_fichier_complet, var_code)
			end if
				
		end if
		
		var_code = var_code_courant_sauvegarde
		
	end if
end if

end subroutine

